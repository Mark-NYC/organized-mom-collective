---
/**
 * /fall-cleaning-checklist — a free room-by-room fall decluttering and deep-clean checklist, ticked off on
 * screen (src/components/site/SeasonalChecklist.astro; rooms in src/data/seasonal-cleaning.ts).
 * Ticks save in this browser (`omc:fall-cleaning:v1`).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import SeasonalChecklist from '../components/site/SeasonalChecklist.astro';
import { fallRooms } from '../data/seasonal-cleaning';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Fall Cleaning Checklist', item: new URL(routes.fallCleaning, site).href },
    ],
  },
];
---


<PublicLayout
  title="Free Fall Cleaning Checklist, Room by Room"
  description="A free fall cleaning and decluttering checklist for busy families: eight rooms, short sections, tick off tasks on screen and watch your progress."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="sc-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free fall cleaning checklist</p>
      <h1 id="sc-h" class="serif-hero mt-3">Fall Reset, One Room at a Time.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        Eight rooms, two short lists each: put summer away, then get the house ready for cozy months and the holidays. Pick one room for a Saturday morning,
        hand the kids their own room’s list, and tick things off as you go. Your progress saves in this browser.
      </p>
    </div>
  </section>

  <SeasonalChecklist rooms={fallRooms} storageKey="omc:fall-cleaning:v1">
    <p slot="footnote" class="sc-footnote">
      Want the rest of the year handled too? The <a href={routes.companion} class="text-link">cleaning companion</a> that comes with the
      {' '}<a href={routes.calendar} data-cta="fall-cleaning" class="text-link">Family Wall Calendar</a> gives you one small reset a day.
      Come spring, there’s a <a href={routes.springCleaning} class="text-link">spring checklist</a> too.
    </p>
  </SeasonalChecklist>
</PublicLayout>

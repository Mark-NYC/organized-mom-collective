---
/**
 * /companion — the public explanation of the cleaning companion (the app at /app).
 * "Cleaning Companion" in the site header and footer lands here. Like the homepage, one main action
 * (Get the Calendar); calendar owners get a quiet link to open the companion.
 * Everything about the routine is read from src/data/cleaning.ts, never retyped.
 * Calendar owners open the app from here; the QR entry (/start) stays for the printed code only.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import PhoneShot from '../components/site/PhoneShot.astro';
import ShopButton from '../components/site/ShopButton.astro';
import HandUnderline from '../components/site/HandUnderline.astro';
import { ZoneTag, TimeMark, shortTime } from '../components/marks';
import { dailyEssentials, monthlyDeepClean, weekend, weeklySchedule } from '../data/cleaning';
import { monthColors } from '../theme';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const week = [
  ...weeklySchedule.map((d) => ({ day: d.dayLabel, zone: d.zone, icon: d.icon, time: shortTime(d.minutes) })),
  ...weekend.days.map((d) => ({ day: d.dayLabel, zone: d.zone, icon: weekend.icon, time: 'Optional' })),
];
/** "15 minutes" → "15-minute" */
const resetLength = dailyEssentials.minutes.replace(/ minutes?$/, '-minute');
const projects = monthlyDeepClean.map((m) => ({ month: m.name, title: m.title, color: monthColors[m.month].hex }));

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Cleaning Companion', item: new URL(routes.companion, site).href },
    ],
  },
];

const wrap = 'mx-auto max-w-6xl px-5 sm:px-8';
---

<PublicLayout
  fullTitle="Simple Daily Cleaning Routine Companion · Organized Mom"
  description={`How the free cleaning companion works with the family wall calendar: a ${resetLength} Daily Reset, one zone a day, and a monthly home project.`}
  width="full"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section aria-labelledby="hero-h" class="bg-cream public-panel public-intro">
    <div class:list={[wrap, 'grid items-center gap-10 py-10 sm:py-14 md:grid-cols-[1.3fr_1fr] md:py-16']}>
      <div>
        <p class="label text-warm-soft">The cleaning companion</p>
        <h1 id="hero-h" class="serif-hero mt-3 sm:text-[2.9rem] lg:text-[3.2rem]">Clear Jobs for a <HandUnderline>Shared Home.</HandUnderline></h1>
        <p class="lede mt-4 max-w-xl text-warm-ink">
          The cleaning companion works alongside your printed calendar. It shows today’s tasks so whoever owns the zone can follow the list. Split the reset together and let the rest
          wait. It comes free with every {BRAND_NAME} calendar: no subscription, no account, nothing to install.
        </p>
        <div class="mt-7">
          <ShopButton label="Get the Calendar" to="product" cta="companion-hero" class="min-h-14 w-full px-8 sm:w-auto" />
        </div>
        <p class="mt-4 text-center text-[0.95rem] text-warm-soft sm:text-left">
          Already have the calendar? <a href={routes.today} class="text-link text-warm-ink">Open the companion</a>
        </p>
      </div>
      <PhoneShot
        name="today"
        alt="The companion's Today screen: Wednesday's zone, Entry/Bathroom, with the Daily Reset checklist partly ticked off."
      />
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" aria-labelledby="how-h" class:list={[wrap, 'scroll-mt-4 py-14 sm:py-20']}>
    <div class="max-w-2xl">
      <h2 id="how-h" class="serif-title">Small Steps, on a Steady Rhythm.</h2>
      <p class="lede mt-4">A daily reset, one zone and an optional monthly project. Agree on owners once, rather than having Mom assign every step.</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-12 md:grid-cols-3 md:gap-10">
      <div class="border-t border-warm-rule pt-5">
        <p class="label text-warm-soft">Every day</p>
        <h3 class="mt-2 font-serif text-[1.45rem] leading-snug text-warm-ink">{dailyEssentials.title}</h3>
        <p class="mt-2 text-[1rem] leading-relaxed text-warm-soft">
          The same {dailyEssentials.tasks.length} quick tasks every day, about {dailyEssentials.minutes}. It starts fresh each morning, so
          yesterday never carries over. Kids can make their own beds or pick up their things; adults can own the dishes or counters.
        </p>
        <ul class="mt-4 space-y-1.5 text-[0.97rem]">
          {
            dailyEssentials.tasks.map((t) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class="mt-[0.35rem] size-3 shrink-0 rounded-[2px] border border-ink" />
                {t.label}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="border-t border-warm-rule pt-5">
        <p class="label text-warm-soft">Every week</p>
        <h3 class="mt-2 font-serif text-[1.45rem] leading-snug text-warm-ink">One zone a day</h3>
        <p class="mt-2 text-[1rem] leading-relaxed text-warm-soft">
          The same zones printed on your calendar. Monday to Thursday each take 10–15 minutes, so by Thursday the whole house has had a turn.
          Friday to Sunday are optional.
        </p>
        <ul class="mt-4 space-y-2">
          {
            week.map((d) => (
              <li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                <span class="flex min-w-0 items-center gap-3">
                  <span class="w-9 shrink-0 text-[0.7rem] font-bold tracking-[0.14em] uppercase">{d.day.slice(0, 3)}</span>
                  <ZoneTag icon={d.icon} label={d.zone} size="sm" />
                </span>
                <TimeMark>{d.time}</TimeMark>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="border-t border-warm-rule pt-5">
        <p class="label text-warm-soft">Every month</p>
        <h3 class="mt-2 font-serif text-[1.45rem] leading-snug text-warm-ink">One home project</h3>
        <p class="mt-2 text-[1rem] leading-relaxed text-warm-soft">
          A deeper project each month, split into a few small tasks. Do one on a weekend when you can. There’s no need to finish.
        </p>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-[0.92rem]">
          {
            projects.map((p) => (
              <li class="border-t-[3px] pt-1.5" style={`border-top-color: ${p.color}`}>
                <span class="block text-[0.62rem] font-semibold tracking-[0.16em] text-warm-soft uppercase">{p.month}</span>
                <span class="leading-snug font-semibold">{p.title}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Progress -->
  <section aria-labelledby="progress-h" class="bg-sage-wash public-panel">
    <div class:list={[wrap, 'grid items-center gap-10 py-14 sm:py-20 md:grid-cols-[1fr_1.2fr]']}>
      <PhoneShot
        name="week"
        alt="The companion's Week screen: each day's cleaning zone from Monday's Living Room to Sunday's Catch-Up / Reset, with progress for the days so far."
        class="md:order-first"
      />
      <div>
        <h2 id="progress-h" class="serif-title">See Your Week at a Glance.</h2>
        <p class="lede mt-4">
          Tick tasks off as you go. The Week view shows every day’s zone and how far you’ve gotten, and a missed day is simply a missed day.
          Nothing piles up.
        </p>
        <ul class="mt-6 border-t border-warm-rule">
          <li class="border-b border-warm-rule py-3 text-[1rem] leading-snug">
            <strong class="font-bold">Saved on your phone.</strong> Progress stays in your phone’s browser. Checkmarks aren’t shared between phones. Use the wall calendar for shared responsibilities.
          </li>
          <li class="border-b border-warm-rule py-3 text-[1rem] leading-snug">
            <strong class="font-bold">Works on a weak signal.</strong> After your first visit it opens even when you’re offline.
          </li>
          <li class="border-b border-warm-rule py-3 text-[1rem] leading-snug">
            <strong class="font-bold">One tap away.</strong> Add it to your Home Screen and it opens like an app.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Get started -->
  <section id="get-started" aria-labelledby="start-h" class:list={[wrap, 'scroll-mt-4 py-14 sm:py-20']}>
    <h2 id="start-h" class="serif-title">Ready When You Are.</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="flex flex-col rounded-[10px] bg-paper p-6 shadow-[0_20px_40px_-32px_rgba(77,69,68,0.5)] ring-1 ring-warm-rule sm:p-8">
        <h3 class="font-serif text-[1.5rem] leading-snug text-warm-ink">Have the calendar?</h3>
        <p class="mt-2 text-[1rem] leading-relaxed text-warm-soft">
          Scan the QR code printed on your calendar with your phone’s camera. The companion opens on today, ready to go.
        </p>
        <div class="mt-auto pt-6">
          <a href={routes.today} class="btn-secondary min-h-14 w-full border-warm-button px-8 text-warm-ink hover:bg-warm-button sm:w-auto">Open the Companion</a>
        </div>
      </div>
      <div class="flex flex-col rounded-[10px] bg-cream p-6 sm:p-8">
        <h3 class="font-serif text-[1.5rem] leading-snug text-warm-ink">Don’t have it yet?</h3>
        <p class="mt-2 text-[1rem] leading-relaxed text-warm-soft">
          The companion comes free with the 2027 Family Wall Calendar &amp; Organizer, a weekly wall calendar with every day’s cleaning zone
          printed on it.
        </p>
        <div class="mt-auto pt-6">
          <ShopButton label="Get the Calendar" to="product" cta="companion-start" class="min-h-14 w-full px-8 sm:w-auto" />
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

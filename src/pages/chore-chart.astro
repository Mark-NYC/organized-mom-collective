---
/**
 * /chore-chart — a free chore chart by age: pick an age group, get starter daily and weekly chores plus
 * three rewards, edit anything on the chart, then download it as a PNG (US Letter landscape).
 * The chart itself (markup, styles, behavior) is src/components/site/ChoreChart.astro with chore-chart.ts,
 * shared with the Organized Family Club's /club/tools/chore-chart. Saves in this browser (`omc:chore-chart:v1`).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import ChoreChart from '../components/site/ChoreChart.astro';
import OriginalChoreChart from '../components/site/OriginalChoreChart.astro';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Chore Chart by Age', item: new URL(routes.choreChart, site).href },
    ],
  },
];
---

<PublicLayout
  title="Free Picture Chore Chart by Age"
  description="A free picture chore chart by age: start with chores that fit your child, add illustrated jobs to every day or one day a week, edit anything, then print."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="chore-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free chore chart</p>
      <h1 id="chore-h" class="serif-hero mt-3">A Chore Chart That Fits Their Age.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        Add their name, choose their age, and start with jobs they can actually own, plus three rewards to work toward. Add illustrated
        chores to every day or to one day of the week, change anything on the chart, then download it to print and hang where everyone sees it. The chart does the reminding, so you don’t have to.
      </p>
    </div>
  </section>

  <div class="cc-version-shell" data-cc-version-shell data-version="new">
    <div class="cc-version-notice" data-chart-modern>
      <span>Looking for the chore chart you saw on Pinterest?</span>
      <a href="?version=original">Use the original chore chart →</a>
    </div>
    <div class="cc-version-notice" data-chart-original>
      <span>You're using the original chore chart.</span>
      <a href="/chore-chart/">Try the new chore chart →</a>
    </div>
    <div data-chart-modern>
      <ChoreChart storageKey="omc:chore-chart:v1">
        <p slot="footnote" class="cc-footnote">
          Make a matching <a href={routes.routineChart} class="text-link">picture routine chart</a>, or pair it with the weekly
          {' '}<a href={routes.planner} class="text-link">Planner</a> or the
          {' '}<a href={routes.calendar} data-cta="chore-chart" class="text-link">Family Wall Calendar</a>
        </p>
      </ChoreChart>
    </div>
    <div data-chart-original>
      <OriginalChoreChart storageKey="omc:chore-chart:v1">
        <p slot="footnote" class="cc-footnote">
          Make a matching <a href={routes.routineChart} class="text-link">picture routine chart</a>, or pair it with the weekly
          {' '}<a href={routes.planner} class="text-link">Planner</a> or the
          {' '}<a href={routes.calendar} data-cta="chore-chart" class="text-link">Family Wall Calendar</a>
        </p>
      </OriginalChoreChart>
    </div>
  </div>
  <style>
    .cc-version-shell[data-version="new"] [data-chart-original],
    .cc-version-shell[data-version="original"] [data-chart-modern] { display:none!important; }
    .cc-version-notice{display:flex;align-items:center;justify-content:center;gap:8px 16px;flex-wrap:wrap;text-align:center;padding:13px 18px;background:#FBF7F1;color:#77736F;font-size:13px}
    .cc-version-notice a{color:#545454;text-underline-offset:3px;text-decoration:underline;font-weight:600}
  </style>
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-cc-version-shell]');
      if (root) root.setAttribute('data-version', new URLSearchParams(window.location.search).get('version') === 'original' ? 'original' : 'new');
    })();
  </script>
</PublicLayout>

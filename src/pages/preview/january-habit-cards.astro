---
/** Unlisted, noindex September product review. Uses the same actual printable as the member tool. */
import PublicLayout from '../../layouts/PublicLayout.astro';
import JanuaryHabitCards from '../../components/club/JanuaryHabitCards.astro';
import ClubPrototypeNav from '../../components/club/ClubPrototypeNav';
---
<PublicLayout
  fullTitle="September Habit Cards Preview | Organized Family Club"
  description="Unlisted September family habit card prototype."
  indexable={false}
  chrome={false}
  width="full"
  tracking={false}
>
  <ClubPrototypeNav client:only="react" month="september" />
  <main id="club-month-content" class="mx-auto w-full py-8">
    <JanuaryHabitCards storageKey="omc:preview:september-habit-cards:v2" />
  </main>
</PublicLayout>

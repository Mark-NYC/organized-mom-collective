---
import PublicLayout from '../layouts/PublicLayout.astro';
import FamilyResponsibilityBuilder from '../components/site/FamilyResponsibilityBuilder.astro';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';
const site=Astro.site!;
const jsonLd=[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:BRAND_NAME,item:site.href},
  {'@type':'ListItem',position:2,name:'Family Responsibility Chart Builder',item:new URL(routes.familyResponsibilityBuilder,site).href}
]}];
---
<PublicLayout title="Free Family Responsibility Chart Builder | Organized Mom Collective"
  description="Build a free printable family responsibility chart. Add parents and kids, assign household jobs with illustrated icons, and download your personalized family ownership chart."
  width="full" jsonLd={jsonLd}>
  <section aria-labelledby="frb-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free family responsibility chart</p>
      <h1 id="frb-h" class="serif-hero mt-3">Mom Shouldn't Have to Manage Everything.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        When everyone knows what they own, Mom doesn't have to keep the whole family's to-do list in her head.
        Give each person a few clear responsibilities, see what's unassigned, and download one beautiful printable for your home.
      </p>
    </div>
  </section>
  <FamilyResponsibilityBuilder />
  <div class="bg-cream text-center px-5 py-10">
    <p class="text-warm-ink">Need a chart just for one child? <a href={routes.choreChart} class="text-link">Try the Chore Chart by Age</a>.
    For daily sequences, <a href={routes.routineChart} class="text-link">make a Picture Routine Chart</a>.</p>
    <p class="text-warm-ink mt-3">Want support putting family ownership into practice? <a href={routes.clubJoin} class="text-link">See the Organized Family Club</a>.</p>
  </div>
</PublicLayout>

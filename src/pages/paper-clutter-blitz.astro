---
/**
 * /paper-clutter-blitz — a free three-day paper clutter blitz with a countdown timer per day (15, 10, 5 minutes)
 * and badges. Uses FP-03's two pockets ("Needs attention", "Ready to go") so the site teaches one paper system.
 * Rebuilt from the old Paper Clutter Blitz, whose timers and buttons had no script. Rendered by
 * src/components/site/SeasonalChecklist.astro; days in src/data/seasonal-cleaning.ts. Saves `omc:paper-blitz:v1`.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import SeasonalChecklist from '../components/site/SeasonalChecklist.astro';
import { paperBlitzDays } from '../data/seasonal-cleaning';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Paper Clutter Blitz', item: new URL(routes.paperBlitz, site).href },
    ],
  },
];
---


<PublicLayout
  title="Paper Clutter Blitz: Clear the Counter in 15 Minutes"
  description="A free three-day paper clutter blitz for busy families: clear the counter in 15 minutes, give papers a home, then keep it clear in 5 minutes a day. Timers included."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="sc-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free paper clutter blitz</p>
      <h1 id="sc-h" class="serif-hero mt-3">Clear the Counter in 15 Minutes.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        School forms, flyers, mail and artwork, on every flat surface. Three short days with a timer: clear the counter today, give papers a home
        tomorrow, then a five-minute habit that keeps it clear. Agree on who checks new papers and handles deadlines. When the timer stops, you stop. Your progress saves in this browser.
      </p>
    </div>
  </section>

  <SeasonalChecklist rooms={paperBlitzDays} storageKey="omc:paper-blitz:v1">
    <p slot="footnote" class="sc-footnote">
      The two pockets are the heart of a <a href={routes.article('home-command-center')} class="text-link">home command center</a>; set one up with
      {' '}the free <a href={routes.commandCenterSetup} class="text-link">setup sheet</a>. Dates from the pile go on the
      {' '}<a href={routes.calendar} data-cta="paper-blitz" class="text-link">Family Wall Calendar</a>.
    </p>
  </SeasonalChecklist>
</PublicLayout>

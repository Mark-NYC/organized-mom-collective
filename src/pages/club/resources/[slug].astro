---
/**
 * /club/resources/<slug>: a member's personalized month (src/data/club/resources.ts). The printable is the same
 * component as the month's public sample preview, given a member storage key; it starts hidden and shows only after
 * the database confirms her entitlement and hands it her household (ClubResourceAccess). The static HTML holds no
 * family data. Noindex, no tracking; a "not available" notice unless PUBLIC_CLUB_ENABLED.
 */
import ClubLayout from '../../../layouts/ClubLayout.astro';
import ClubResourceAccess from '../../../components/club/ClubResourceAccess';
import NovemberOwnershipPrintable from '../../../components/club/NovemberOwnershipPrintable.astro';
import DecemberMissionPrototype from '../../../components/club/DecemberMissionPrototype.astro';
import JanuaryHabitCards from '../../../components/club/JanuaryHabitCards.astro';
import FebruaryConnectionCards from '../../../components/club/FebruaryConnectionCards.astro';
import MarchSpringPrep from '../../../components/club/MarchSpringPrep.astro';
import AprilDinnerPlan from '../../../components/club/AprilDinnerPlan.astro';
import MaySummerRhythm from '../../../components/club/MaySummerRhythm.astro';
import JuneSnackStation from '../../../components/club/JuneSnackStation.astro';
import JulyActivityBoard from '../../../components/club/JulyActivityBoard.astro';
import AugustSchoolRoutines from '../../../components/club/AugustSchoolRoutines.astro';
import SeptemberSundayReset from '../../../components/club/SeptemberSundayReset.astro';
import OctoberDailyReset from '../../../components/club/OctoberDailyReset.astro';
import { clubResources, memberStorageKey, type ClubResource } from '../../../data/club/resources';
import { clubEnabled, CLUB_NAME } from '../../../data/club/config';
import { memberPlanHref } from '../../../lib/club/plan/account';

export function getStaticPaths() {
  return clubResources.map((r) => ({ params: { slug: r.slug }, props: { resource: r } }));
}

const { resource } = Astro.props as { resource: ClubResource };
const key = memberStorageKey(resource.slug);
const c = resource.component;
const enabled = clubEnabled();
// Members open every month except November on its app page (memberPlanHref); this older copy still drew earlier
// printables for some months (January's Habit Cards, September's Sunday Reset). Old emails and bookmarks land here,
// so forward them, keeping the query (?fulfillment, ?welcome). docs/product/UNIFIED_FAMILY_ARCHITECTURE.md §6b.
// Not January 2027: two families saved Habit Cards on this copy (production, read 2026-11-18), and forwarding would
// hide their work. It stays until the owner decides how to carry it over.
const KEEP = new Set(['2027-01-fresh-start-together']);
const forward = memberPlanHref(resource.slug);
const forwards = !KEEP.has(resource.slug) && forward !== `/club/resources/${resource.slug}`;
---
<ClubLayout title={resource.title}>
  {/* Member page: inside Organized Family (app header, four tabs, Club bar), like every /club page; bare for ?fulfillment, hidden chrome in ?thumb previews. */}
  {forwards && <script is:inline define:vars={{ forward }}>location.replace(forward + location.search + location.hash);</script>}
  {enabled ? (
    <>
      <ClubResourceAccess client:only="react" slug={resource.slug} />
      <div id="club-month-content" hidden>
        {c === 'november' && <NovemberOwnershipPrintable storageKey={key} />}
        {c === 'december' && <DecemberMissionPrototype />}
        {c === 'january' && (
          <>
            {/* Two earlier January tools, kept so families keep what they saved (owner, 2026-11-18): Habit Cards on
                this copy, and the retired Weekly Meeting (its saves stay under its own key; viewing and printing only). */}
            <nav class="mx-auto mb-4 flex max-w-3xl justify-center gap-6 border-b border-warm-rule" aria-label="Earlier January plans" data-earlier-switch hidden>
              <button type="button" class="min-h-[46px] border-b-2 border-transparent px-1 text-[0.75rem] font-semibold uppercase tracking-[0.16em]" data-earlier-show="habit-cards">Habit Cards</button>
              <button type="button" class="min-h-[46px] border-b-2 border-transparent px-1 text-[0.75rem] font-semibold uppercase tracking-[0.16em]" data-earlier-show="weekly-meeting">Weekly Meeting</button>
            </nav>
            <div data-earlier-tool="habit-cards"><JanuaryHabitCards storageKey={key} /></div>
            <div data-earlier-tool="weekly-meeting" hidden><SeptemberSundayReset storageKey="omc:club:january-weekly-meeting:v1" /></div>
          </>
        )}
        {c === 'february' && <FebruaryConnectionCards storageKey={key} />}
        {c === 'march' && <MarchSpringPrep storageKey={key} />}
        {c === 'april' && <AprilDinnerPlan storageKey={key} />}
        {c === 'may' && <MaySummerRhythm storageKey={key} />}
        {c === 'june' && <JuneSnackStation storageKey={key} />}
        {c === 'july' && <JulyActivityBoard storageKey={key} />}
        {c === 'august' && <AugustSchoolRoutines storageKey={key} />}
        {c === 'september' && <SeptemberSundayReset storageKey={key} />}
        {c === 'october' && <OctoberDailyReset storageKey={key} />}
      </div>
    </>
  ) : (
    <main class="mx-auto max-w-xl px-4 py-24 sm:px-8"><h1 class="font-serif text-[1.8rem] leading-tight">This page isn’t available.</h1></main>
  )}
</ClubLayout>
<script>
// January's earlier tools (above): which ones this family saved, from the saved version itself (ClubResourceAccess
// sends its keys), never from what a tool writes into the tab.
const WEEKLY = 'omc:club:january-weekly-meeting:v1';
const tools = document.querySelectorAll<HTMLElement>('[data-earlier-tool]');
const sw = document.querySelector<HTMLElement>('[data-earlier-switch]');
if (tools.length && sw) {
  const show = (id: string) => {
    tools.forEach((t) => { t.hidden = t.dataset.earlierTool !== id; });
    sw.querySelectorAll<HTMLButtonElement>('[data-earlier-show]').forEach((b) => {
      const on = b.dataset.earlierShow === id;
      b.setAttribute('aria-pressed', String(on));
      b.style.borderBottomColor = on ? 'var(--color-warm-button, #4a3f3e)' : 'transparent';
    });
  };
  sw.querySelectorAll<HTMLButtonElement>('[data-earlier-show]').forEach((b) => b.addEventListener('click', () => show(b.dataset.earlierShow!)));
  window.addEventListener('omc:club-saved-keys', (e: Event) => {
    const keys = (e as CustomEvent<string[]>).detail ?? [];
    const weekly = keys.includes(WEEKLY);
    const cards = keys.some((k) => k.startsWith('omc:club:member:'));
    sw.hidden = !(weekly && cards);
    if (weekly && !cards) show('weekly-meeting');
    else show('habit-cards');
  });
}
</script>

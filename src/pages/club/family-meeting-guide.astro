import MeetingGuideSheet from '../../components/club/MeetingGuideSheet.astro';
import MeetingGuideStep from '../../components/club/MeetingGuideStep';
---
<ClubLayout title="Family Meeting guide">
  <MeetingGuideStep client:only="react" />
  <MeetingGuideSheet />
</ClubLayout>

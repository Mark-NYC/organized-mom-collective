---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { BRAND_NAME } from '../../config';
import clubHeroUrl from '../../../assets/icons/ofc/hero-family-pointing.jpeg?url';
const monthIcons = import.meta.glob('../../../assets/icons/ofc/month-icons/*-OFC-icon.png', { eager: true, query: '?url', import: 'default' });
const months = [{"month":"January","title":"Mornings Without the Nagging","responsibility":"Following routines","how":"A ready-made morning or evening plan shows each person what to do next.","url":"/club/january-preview/"},{"month":"February","title":"Connection You Don't Have to Plan","responsibility":"Initiating connection","how":"Four simple invitations help kids take the lead in spending time together.","url":"/club/february-preview/"},{"month":"March","title":"Cleaning Without Managing Everyone","responsibility":"Finishing a job","how":"Each person gets a clear cleaning job, supplies, steps, and a definition of done.","url":"/club/march-preview/"},{"month":"April","title":"Dinner Isn't All on You","responsibility":"Sharing meal ownership","how":"A prepared dinner plan gives family members roles from gathering ingredients through cleanup.","url":"/club/april-preview/"},{"month":"May","title":"Summer Days Without Constant Questions","responsibility":"Managing their day","how":"A flexible daily rhythm and activity menu help kids choose what comes next.","url":"/club/may-preview/"},{"month":"June","title":"Less Screen-Time Negotiating","responsibility":"Respecting shared boundaries","how":"Clear expectations for screens, responsibilities, and free time help everyone follow the same plan.","url":"/club/june-preview/"},{"month":"July","title":"No More Packing for Everyone","responsibility":"Preparing independently","how":"Personal packing lists show each person what to pack, check, and put away.","url":"/club/july-preview/"},{"month":"August","title":"Back to School Without the Scramble","responsibility":"Taking initiative","how":"A personalized countdown gives everyone their own school-ready responsibilities.","url":"/club/august-preview/"},{"month":"September","title":"Stop Being the Family's Calendar","responsibility":"Planning together","how":"A short weekly family meeting helps everyone know the schedule and own their commitments.","url":"/club/september-preview/"},{"month":"October","title":"Get Ahead of the Last-Minute Scramble","responsibility":"Noticing what is needed","how":"Seasonal checks assign family members the job of spotting and handling needs early.","url":"/club/october-preview/"},{"month":"November","title":"Stop Being Everyone's Reminder","responsibility":"Owning a whole responsibility","how":"Each ready family member gets a job with a clear owner, timing, and finish line.","url":"/club/november-preview/"},{"month":"December","title":"Christmas Without Doing It All","responsibility":"Contributing to family traditions","how":"A prepared holiday plan shares the work of gifts, traditions, and celebrations.","url":"/club/december-preview/"}].map(m => ({...m, icon: monthIcons[`../../../assets/icons/ofc/month-icons/${m.month}-OFC-icon.png`]}));

const faqs = [
 ['Will this work with young kids?', 'We suggest jobs based on each child’s age. Younger children may need help at first. That’s okay: the goal is to build independence over time.'],
 ['What if our family has a different schedule?', 'Your plan begins with recommendations informed by your household. You can review and adjust before printing.'],
 ['Do I need a printer?', 'No. The plan is designed to arrive printed in the mail.'],
 ['Is this another app I need to manage?', 'No. The printed plan is the main product. The digital version is available when you want to review or adjust it.'],
 ['Do I need your wall calendar?', 'No. The Club stands on its own. The calendar helps everyone see the schedule; the Club helps everyone share responsibility.'],
 ['Can I subscribe or cancel right now?', 'Enrollment is not open yet. We are testing print fulfillment and billing. Pricing and cancellation terms will be confirmed before sign-up. You can ask about early access.']
];
---
<PublicLayout fullTitle={`Organized Family Club · ${BRAND_NAME}`} description="Help your kids take responsibility without another job for Mom. Try a personalized family Daily Reset in seconds." indexable={false} chrome={false} width="full" tracking={false}>
<div class="club">

<main>
<section class="hero home-style-inset" id="start"><div class="club-float-surface"><div class="hero-inner">
 <div class="hero-copy"><p class="eyebrow">ORGANIZED FAMILY CLUB · MONTHLY MAIL FOR YOUR FAMILY</p>
 <h1>Ready for a family that <em>takes more responsibility?</em></h1>
 <p class="product-definition">Stop being the one who remembers, plans, and reminds everyone. Every month, get <strong>one personalized family plan, printed and mailed to your door,</strong> that helps your kids and family share the load.</p>
 <p class="supporting">No planning from scratch. No printing. Just a practical place to start.</p>
 <div class="hero-actions"><a class="primary" href="#demo">Show Me My Family's Plan →</a><a class="hero-secondary" href="#what-arrives">See what arrives</a></div>
 <p class="hero-trust">Personalized for your household · One printed tool each month · Digital version included</p></div>
 <figure class="hero-photo"><img src={clubHeroUrl} alt="Family gathered around a kitchen table looking together at a printed family plan" width="1200" height="900" loading="eager" fetchpriority="high" /></figure>
</div></div></section>
<section class="pain container"><p class="eyebrow">SOUND FAMILIAR?</p><h2>You love taking care of your family. <em>You just don't want to manage every little thing.</em></h2>
<div class="pain-questions"><p>Who remembers what goes in the backpacks?</p><p>Who figures out dinner?</p><p>Who reminds everyone to clean up?</p><p>Who knows what happens next?</p></div>
<p class="pain-finish">Even when everyone wants to help, you're still the one keeping it all moving. <strong>What if your family could start taking more responsibility themselves?</strong> Not perfectly. Not overnight. One little piece at a time.</p></section>
<section class="what-arrives home-style-inset" id="what-arrives"><div class="club-offer-surface"><div class="container tangible"><div><p class="eyebrow">MEET ORGANIZED FAMILY CLUB</p><h2>One less thing for Mom to manage. <em>Every month.</em></h2>
<p>Each month tackles one everyday family challenge, from hectic mornings and dinners to summer routines and getting ready for school.</p><p>We prepare the plan around your family, put names and responsibilities right on the page, and mail the finished tool to your door.</p>
<p class="tangible-bold">They get a clear plan to follow. You get a little less to carry.</p><a class="primary" href="#demo">See What We'd Make for My Family →</a></div>
<div class="print-showcase"><div class="print-paper"><small>ORGANIZED FAMILY CLUB · SAMPLE</small><img src={months[4].icon} alt="" width="82" height="82" loading="lazy"/><h3>Our Summer Day</h3><p>A little structure. Plenty of freedom.</p><div class="print-line"><b>8:00</b><span>Morning Start</span></div><div class="print-line"><b>9:00</b><span>Move &amp; Play</span></div><div class="print-line"><b>10:30</b><span>Create &amp; Explore</span></div><div class="print-line"><b>12:00</b><span>Lunch &amp; Reset</span></div><div class="print-line"><b>1:00</b><span>Quiet Time</span></div><div class="print-line"><b>2:00</b><span>Free Afternoon</span></div><footer>Check the rhythm before asking Mom.</footer></div><p class="showcase-caption">Illustrative excerpt of May's Summer Day Rhythm. Actual mailed plans are personalized.</p></div>
</div></div></section>
<section class="comparison container"><p class="eyebrow">NOT ANOTHER JOB FOR MOM</p><h2>This isn't another printable <em>you have to figure out.</em></h2><div class="compare-grid"><article><h3>Typical family printables</h3><ul><li>You download and print.</li><li>You decide who does what.</li><li>You fill in the assignments.</li><li>You explain the system.</li><li>You keep reminding everyone.</li></ul></article><article class="compare-good"><h3>Organized Family Club</h3><ul><li>We prepare a plan for your household.</li><li>We recommend age-appropriate jobs.</li><li>Names and assignments are already on the page.</li><li>We print it and mail it to you.</li><li>Your family has something clear to follow.</li></ul></article></div><p class="comparison-end">Less work setting it up. More help putting it into practice.</p></section>
<section class="features container"><p class="eyebrow">WHAT COMES IN THE MAIL</p><h2>One beautiful tool. <em>Ready to use.</em></h2><div class="feature-grid"><article><span>01</span><h3>A finished family plan</h3><p>One real problem with practical steps and clear responsibilities worked out in advance.</p></article><article><span>02</span><h3>Personal touches</h3><p>Your family's names, ages, and household needs shape the recommendations.</p></article><article><span>03</span><h3>A note from Megan</h3><p>Warm encouragement and a simple way to introduce the plan.</p></article><article><span>04</span><h3>A digital copy</h3><p>Review your plan, make a few changes when needed, and access it again later.</p></article></div></section>
<section class="month-stories home-style-inset" id="months"><div class="club-float-surface story-shell"><div class="container"><p class="eyebrow">HERE'S WHAT IT LOOKS LIKE IN REAL LIFE</p><h2>Different family challenges. <em>One ready-made plan each month.</em></h2><div class="story-grid">
{[months[3],months[4],months[10]].map(m=><article class="story-card"><img src={m.icon} alt="" loading="lazy" width="90" height="90"/><p class="story-month">{m.month}</p><h3>{m.title}</h3><p>{m.how}</p><a href={m.url}>See the actual tool →</a></article>)}
</div><details class="all-months"><summary>Explore all 12 monthly tools <span>+</span></summary><div class="month-grid">{months.map(m=><a href={m.url}><img src={m.icon} alt="" width="54" height="54" loading="lazy"/><div><small>{m.month}</small><b>{m.title}</b><span>Preview →</span></div></a>)}</div></details></div></div></section>
<section class="club-demo" id="demo"><div class="club-demo-inner"><div class="club-demo-heading"><p class="eyebrow">SEE IT FOR YOUR OWN FAMILY</p><h2>See what we'd create <em>for your family.</em></h2><p>Give us a few first names and ages. We'll show you a sample Daily Reset with responsibilities already suggested for your household.</p><p class="demo-disclaimer">This is a free interactive example, not an actual monthly mailing. No payment or account needed.</p></div>
<form id="family-form" class="form" autocomplete="off"><p class="form-kicker">YOUR FREE PERSONALIZED EXAMPLE</p><h2>Let's make your family's plan.</h2><p>First names and children's ages are all we need for this sample.</p><div class="name-fields"><label>Mom's first name<input name="mom" id="mom" placeholder="Megan" maxlength="40" required /></label><label>Dad's first name<input name="dad" id="dad" placeholder="Mark" maxlength="40" required /></label></div><div class="children-head"><strong>Your kids</strong><span>First names only</span></div><div id="children-fields"></div><button type="button" class="add" id="add-child">+ Add a child</button><button type="submit" class="primary form-submit">Create My Family's Preview →</button><small>No sign-in. Your details stay in this browser.</small></form></div></section>
<section class="result" id="result" hidden aria-live="polite"><div class="container result-layout"><div><p class="eyebrow">YOUR FAMILY'S PREVIEW IS READY</p><h2>This is what done-for-you can look like.</h2><p>Everyone has a part. Nobody has to guess. Your monthly Club tools would tackle different challenges using the same personalized approach.</p><div class="result-actions"><a href="#offer" class="primary">Explore the Club →</a><button class="text-button" id="edit-family" type="button">Edit family details</button><button class="text-button" type="button" id="clear-family">Clear my details</button></div></div><div class="result-card"><span>YOUR FAMILY'S DAILY RESET</span><h3>Made for your household.</h3><p>A free example using names and age-appropriate responsibilities.</p><button type="button" class="primary" id="open-preview">View your family's plan →</button></div></div></section>
<dialog id="club-preview-modal" class="club-preview-modal" aria-labelledby="club-modal-title"><div class="modal-top"><div><span class="eyebrow">YOUR FAMILY'S PLAN</span><h2 id="club-modal-title">Your Daily Reset is ready.</h2></div><button type="button" id="close-preview" class="modal-close" aria-label="Close preview">×</button></div><p class="modal-intro">A sample cleanup plan, prepared using your family's names and ages. Actual Club mailings feature different monthly tools.</p><div class="modal-paper"><div class="paper-top"><small>ORGANIZED FAMILY CLUB · FAMILY DEMO</small><span>✳</span></div><h3>Our Family's <em>Daily Reset</em></h3><p>A few minutes together. A fresh start tomorrow.</p><div class="sheet-section-label">EVERYONE HAS A PART</div><div id="modal-assignments" class="sheet-assignments"></div><div class="modal-paper-end">NOTICE THE MOMENT · DO MY PART · FINISH THE JOB</div></div><p class="modal-note">This is a personalized sample, not a physical product order.</p><div class="modal-actions"><a href="#offer" id="modal-club" class="primary">Get Monthly Plans Delivered →</a><button type="button" id="modal-more" class="text-button">I'd like to learn more first</button></div></dialog>
<section class="how container" id="how"><p class="eyebrow">THREE SIMPLE STEPS</p><h2>We do the preparation. <em>Your family gets started.</em></h2><div class="step-grid"><article><b>1</b><h3>Tell us about your family.</h3><p>A few household details help us make practical recommendations.</p></article><article><b>2</b><h3>We prepare your plan.</h3><p>Each month focuses on one everyday challenge. Review and adjust it if you want.</p></article><article><b>3</b><h3>Find it in your mailbox.</h3><p>It's printed and ready to put on the fridge and talk through together.</p></article></div><p class="how-note">No elaborate setup. No new app everyone has to learn.</p></section>
<section class="founder home-style-inset"><div class="club-offer-surface"><div class="container founder-layout"><img src="/images/site/mark-megan-family-story-1200.webp" alt="Megan and her family" loading="lazy" width="460" height="460"/><div><p class="eyebrow">FROM OUR FAMILY TO YOURS</p><h2>Created by a family <em>who gets it.</em></h2><p>Hi, I'm Megan. I know how much it takes to keep a family running, and how easy it is to become the person everyone depends on for the next reminder, answer, or instruction.</p><p>We created Organized Family Club to help put simple, practical tools in your family's hands, not to give you more to do.</p><p>One month. One small change. One more thing you don't have to carry alone.</p><strong>Megan</strong></div></div></div></section>
<section class="proof container"><p class="eyebrow">FROM AN ORGANIZED MOM COLLECTIVE CUSTOMER</p><blockquote>“This calendar is life changing. Quite literally!”</blockquote><p>Raquel · 5-star Etsy review of our wall calendar</p><small>This is a review of our wall calendar, not an Organized Family Club membership.</small></section>
<section class="offer-band home-style-inset" id="offer"><div class="club-offer-surface"><div class="container offer-layout"><div class="offer-copy"><p class="eyebrow">ONE FAMILY. ONE MONTHLY PROBLEM. ONE READY-TO-USE PLAN.</p><h2>The whole family gets involved. <em>Mom gets some breathing room.</em></h2><p>The planned subscription brings a new personalized printed family tool to your mailbox each month, with a digital copy and a note from Megan.</p><div class="offer-details"><span>✓ Personalized responsibilities</span><span>✓ One printed tool delivered monthly</span><span>✓ Digital access to review and reuse</span><span>✓ No giant workbooks or complicated setup</span></div></div><div class="price-card"><p class="eyebrow">ORGANIZED FAMILY CLUB</p><h3>One simple monthly delivery.</h3><div class="price">$6.39 <span>/ month</span></div><p class="annual">or $59 per year</p><p class="fineprint">Proposed pricing. Enrollment isn't open yet while printing, fulfillment, and billing are tested.</p><a class="primary" href="/support">Ask About Early Access →</a><small>No payment required to ask.</small></div></div></div></section>
<section class="faq" id="faq"><div class="container faq-layout"><div><p class="eyebrow">GOOD QUESTIONS</p><h2>A few things you might be wondering.</h2></div><div class="faq-items">{faqs.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></div></section>
<section class="closing home-style-inset"><div class="club-close-surface"><div class="container"><p class="eyebrow">ORGANIZED FAMILY CLUB</p><h2>You don't have to <em>do it all yourself.</em></h2><p>We'll make the plan. We'll print it. We'll send it. Your family gets to take it from there.</p><a href="#demo" class="primary">Show Me My Family's Plan →</a><p class="closing-caption">One family. One monthly problem. One ready-to-use plan.</p></div></div></section>
</main><footer class="footer"><a href="/">Organized Mom Collective</a><span>© {new Date().getFullYear()} Organized Mom Collective</span><a href="/support">Support</a></footer></div>
<script is:inline>
 const form = document.querySelector('#family-form');
 const childrenFields = document.querySelector('#children-fields');
 const addButton = document.querySelector('#add-child');
 const result = document.querySelector('#result');
 const modal = document.querySelector('#club-preview-modal');
 const modalAssignments = document.querySelector('#modal-assignments');
 const KEY = 'ofc-club-sales-demo-v1';
 const safe = value => String(value || '').trim().slice(0,40);
 const escapeHtml = value => safe(value).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const jobs = age => age <= 3 ? 'Put a few toys in the basket (with help)' : age <= 5 ? 'Toys and books back in their places' : age <= 8 ? 'Put shoes, backpack, and belongings away' : age <= 11 ? 'Clear dishes and reset personal things' : age <= 14 ? 'Tidy the entryway and personal space' : 'Help reset the kitchen and shared spaces';
 function addChild(name='',age='7') {
   if(childrenFields.children.length >= 8) return;
   const row = document.createElement('div'); row.className='child-row';
   row.innerHTML = '<label><span class="sr-only">Child name</span><input name="child-name" required maxlength="40" placeholder="Child’s name"></label><label><span class="sr-only">Child age</span><select name="child-age">'+Array.from({length:18},(_,i)=>'<option value="'+(i+1)+'">Age '+(i+1)+'</option>').join('')+'</select></label><button type="button" class="remove" aria-label="Remove child">×</button>';
   row.querySelector('input').value=name; row.querySelector('select').value=age;
   row.querySelector('button').addEventListener('click',()=>{if(childrenFields.children.length>1)row.remove();addButton.disabled=childrenFields.children.length>=8});
   childrenFields.append(row);addButton.disabled=childrenFields.children.length>=8;
 }
 function getData(){return {mom:safe(form.elements.namedItem('mom').value),dad:safe(form.elements.namedItem('dad').value),children:[...childrenFields.querySelectorAll('.child-row')].map(row=>({name:safe(row.querySelector('input').value),age:Number(row.querySelector('select').value)}))}}
 function showPlan(data,scroll=false){
   const people=[...data.children.map(c=>({name:c.name,task:jobs(c.age)})),{name:data.dad,task:'Clear and wipe the dinner table'},{name:data.mom,task:'Help everyone get ready for tomorrow'}];
   modalAssignments.innerHTML=people.map(p=>'<div class="assignment"><span class="tick"></span><div><b>'+escapeHtml(p.name)+'</b><p>'+escapeHtml(p.task)+'</p></div></div>').join('');
   result.hidden=false;
   try{localStorage.setItem(KEY,JSON.stringify(data))}catch{}
   if(scroll && typeof modal.showModal==='function')modal.showModal();
 }
 addButton.addEventListener('click',()=>addChild());
 form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;showPlan(getData(),true)});
 document.querySelector('#open-preview').addEventListener('click',()=>modal.showModal());
 document.querySelector('#close-preview').addEventListener('click',()=>modal.close());
 document.querySelector('#modal-more').addEventListener('click',()=>{modal.close();document.querySelector('#how').scrollIntoView({behavior:'smooth'})});
 document.querySelector('#modal-club').addEventListener('click',()=>modal.close());
 modal.addEventListener('click',e=>{if(e.target===modal)modal.close()});
 document.querySelector('#edit-family').addEventListener('click',()=>form.scrollIntoView({behavior:'smooth',block:'center'}));
 document.querySelector('#clear-family').addEventListener('click',()=>{try{localStorage.removeItem(KEY)}catch{};form.reset();childrenFields.replaceChildren();addChild();addChild('','5');result.hidden=true;modalAssignments.replaceChildren();form.scrollIntoView({behavior:'smooth'})});
 let saved=null;try{saved=JSON.parse(localStorage.getItem(KEY)||'null')}catch{}
 if(saved&&typeof saved.mom==='string'&&typeof saved.dad==='string'&&Array.isArray(saved.children)&&saved.children.length&&saved.children.length<=8){form.elements.namedItem('mom').value=safe(saved.mom);form.elements.namedItem('dad').value=safe(saved.dad);saved.children.forEach(c=>addChild(safe(c.name),String(Math.max(1,Math.min(18,Number(c.age)||7)))));if(saved.mom&&saved.dad&&saved.children.every(c=>c.name))showPlan(saved)}else{addChild();addChild('','5')}
</script>
<style>
.club{--forest:#254d3c;--sage:#547964;--cream:#fbf8f1;--ink:#303831;--muted:#66716a;--line:#d9dfd7;color:var(--ink);font-family:'Montserrat Variable',Montserrat,sans-serif;line-height:1.55;background:#fff}

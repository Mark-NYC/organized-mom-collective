/* Homepage-inspired floating gray surfaces (#f1f2f2) and inset white framing. */
.club .home-style-inset{background:#fff;padding:28px clamp(16px,2.4vw,36px) 46px}
.club .club-float-surface,.club .club-offer-surface,.club .club-close-surface{max-width:1504px;margin-inline:auto;background:#f1f2f2;position:relative;isolation:isolate;overflow:hidden}
.club .hero{background:#fff}
.club .hero-inner{max-width:none;padding:clamp(32px,4.2vw,70px);gap:clamp(30px,4.5vw,78px)}
.club .hero-photo img{box-shadow:none;aspect-ratio:4/3}
.club .hero-photo figcaption{padding-bottom:8px}
.club .form{background:#fff;border:1px solid #e0e1df;box-shadow:0 20px 45px -38px rgba(77,69,68,.45);border-radius:4px}
.club .offer-band{background:#fff}
.club .club-offer-surface{padding:clamp(36px,5vw,80px) clamp(22px,4vw,64px)}
.club .offer-layout{max-width:1250px}
.club .price-card{box-shadow:0 22px 45px -37px rgba(77,69,68,.42);background:#fff;border-color:#e2e2df;border-radius:4px}
.club .closing{background:white}
.club .club-close-surface{padding:clamp(40px,5vw,88px) 24px;background:#f1f2f2}

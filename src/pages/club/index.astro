---
import PublicLayout from '../../layouts/PublicLayout.astro';
import JuneSnackStation from '../../components/club/JuneSnackStation.astro';
import { BRAND_NAME } from '../../config';
import { monthColors } from '../../theme';
import clubHeroUrl from '../../../assets/icons/ofc/hero-family-pointing.jpeg?url';
import clubBadgeUrl from '../../../assets/icons/ofc/OFC-logo.webp?url';
import summerDayExampleUrl from '../../../assets/icons/ofc/our-summer-day.webp?url';
import routineClubExampleUrl from '../../../assets/icons/ofc/routine-club-example.jpg?url';
const monthIcons = import.meta.glob('../../../assets/icons/ofc/month-icons/*-OFC-icon.png', { eager: true, query: '?url', import: 'default' });
const months = [{"month":"January","title":"Mornings Without the Nagging","responsibility":"Following routines","how":"A ready-made morning or evening plan shows each person what to do next.","url":"/club/january-preview/"},{"month":"February","title":"Laundry That Isn't All on You","responsibility":"Caring for their own things","how":"A picture laundry guide for each child, matched to their age: My Clothes, My Job or I Can Do My Own Laundry.","url":"/app/club/february/"},{"month":"March","title":"Chores Without Chasing Everyone","responsibility":"Finishing a job","how":"Each person gets a clear cleaning job, supplies, steps, and a definition of done.","url":"/club/march-preview/"},{"month":"April","title":"Dinner Isn't All on You","responsibility":"Sharing meal ownership","how":"A prepared dinner plan gives family members roles from gathering ingredients through cleanup.","url":"/club/april-preview/"},{"month":"May","title":"Summer Days Without Constant Questions","responsibility":"Managing their day","how":"A flexible daily rhythm and activity menu help kids choose what comes next.","url":"/club/may-preview/"},{"month":"June","title":"Snack Time Without Calling Mom","responsibility":"Respecting shared boundaries","how":"Clear expectations for screens, responsibilities, and free time help everyone follow the same plan.","url":"/club/june-preview/"},{"month":"July","title":"Less ‘I’m Bored.’ More Independent Play.","responsibility":"Preparing independently","how":"Personal packing lists show each person what to pack, check, and put away.","url":"/club/july-preview/"},{"month":"August","title":"Back to School Without the Scramble","responsibility":"Taking initiative","how":"A personalized countdown gives everyone their own school-ready responsibilities.","url":"/club/august-preview/"},{"month":"September","title":"Stop Being the Family's Calendar","responsibility":"Planning together","how":"A Sunday Reset around the wall calendar, plus a monthly activity calendar that shows everyone's recurring activities.","url":"/club/september-preview/"},{"month":"October","title":"Less Asking. More Doing.","responsibility":"Caring for shared spaces","how":"A daily reset with one familiar cue, picture jobs and a clear finish line kids can recognize.","url":"/club/october-preview/"},{"month":"November","title":"Stop Being Everyone's Reminder","responsibility":"Owning a whole responsibility","how":"Each ready family member gets a job with a clear owner, timing, and finish line.","url":"/club/november-preview/"},{"month":"December","title":"Raise Kids Who Love to Give","responsibility":"Being a blessing to others","how":"Two cards give kids space to draw a picture, write a poem, or share a letter, then send it to someone like a grandparent or teacher.","url":"/club/december-preview/"}].map(m => ({...m, icon: monthIcons[`../../../assets/icons/ofc/month-icons/${m.month}-OFC-icon.png`]}));

const kitImages = import.meta.glob('../../../assets/icons/ofc/monthly-kits/*.webp', { eager: true, query: '?url', import: 'default' });
const kitPreviews = [
 ['January', 'January', 'Personalized habit cards'],
 ['February', 'February', 'Family laundry guides'],
 ['March', 'March', 'Family chore charts'],
 ['April', 'April', 'Dinner responsibilities'],
 ['May', 'May', 'Summer day rhythm'],
 ['June', 'June', 'Independent snack choices'],
 ['July', 'July', 'Ideas for independent play'],
 ['August', 'July (2)', 'School-day rhythm'],
 ['September', 'September', 'Family calendar and weekly reset'],
 ['October', 'October', 'Daily family reset'],
 ['December', 'December', 'Two kindness cards for drawings, poems, or letters'],
].map(([month, file, description]) => ({ month, description, title: months.find(m => m.month === month)!.title, color: monthColors.find(m => m.name === month)!.hex, image: kitImages[`../../../assets/icons/ofc/monthly-kits/${file}.webp`] as string }));

const kitDetails: Record<string, { relief: string; example: string }> = {
 January: { relief: "You shouldn't have to repeat the same reminders every morning and night. Small habit cards put one clear next step right where your family needs it.", example: "For example: one child puts their bowl by the sink after breakfast; another packs their bag after getting dressed." },
 February: { relief: "Laundry doesn't have to begin and end with you. Picture guides give kids a clear part of the process they can learn to handle themselves.", example: "For example: your younger child sorts clothes; an older child follows the steps to run a load." },
 March: { relief: "Spend less time chasing people through their chores. A shared chart makes assignments visible, while the cleaning plan explains the steps and what finished looks like.", example: "For example: your 5-year-old puts toys in a basket; your 10-year-old clears and wipes the table." },
 April: { relief: "Dinner takes more than cooking. This plan shares the preparation and cleanup so you aren't the only person thinking through what needs doing.", example: "For example: one child sets out napkins; an older child prepares a simple side. Everyone sees their part." },
 May: { relief: "When school structure disappears, you shouldn't have to invent the next activity all day. A flexible summer rhythm gives kids a familiar plan to check.", example: "For example: younger kids get a supported play block; older kids choose an activity they can start themselves." },
 June: { relief: "Fewer calls of 'Mom, can I have a snack?' A simple picture guide helps kids choose and prepare snacks they can manage.", example: "For example: a younger child chooses a ready-to-eat snack; an older child follows simple preparation steps." },
 July: { relief: "You don't have to come up with something every time someone says 'I'm bored.' An activity menu gives kids practical ideas to choose and start.", example: "For example: building blocks for one child, a drawing project for another. Ideas they can actually start." },
 August: { relief: "School days run more smoothly when everyone can see what comes next. A clear school-day rhythm helps you spend less time directing every transition.", example: "For example: one child follows picture steps to get ready; another checks their bag and school supplies." },
 September: { relief: "You shouldn't have to keep the whole family's week in your head. A shared calendar and weekly reset give everyone a place to see the plan and prepare together.", example: "For example: each child sees their own activities and what they need to get ready for the week." },
 October: { relief: "A short daily reset gives everyone a clear way to help care for home. Familiar cues and picture jobs mean less explaining the same tasks over and over.", example: "For example: one child puts toys away; another resets the table. Each has a clear job and finish line." },
 December: { relief: "You want your kids to experience the joy of giving, not just receiving. Two cards give them space to draw a picture, write a poem, or share a letter, then send a little encouragement to someone like a grandparent or teacher.", example: "For example: your younger child draws a picture for Grandma; your older child writes a poem for a teacher. Two simple ways to practice being a blessing." },
};

const faqs = [
 ['Will this work with young kids?', 'We suggest jobs based on each child’s age. Younger children may need help at first. That’s okay: the goal is to build independence over time.'],
 ['What if our family has a different schedule?', 'Your plan begins with recommendations informed by your household. You can review and adjust before printing.'],
 ['Do I need a printer?', 'No. The plan is designed to arrive printed in the mail.'],
 ['Is this another app I need to manage?', 'No. The printed plan is the main product. The digital version is available when you want to review or adjust it.'],
 ['Do I need your wall calendar?', 'No. The Club stands on its own. The calendar helps everyone see the schedule; the Club helps everyone share responsibility.'],
 ['Can I subscribe or cancel right now?', 'Enrollment is not open yet. We are testing print fulfillment and billing. Pricing and cancellation terms will be confirmed before sign-up. You can ask about early access.']
];
---
<PublicLayout fullTitle={`Organized Family Club · ${BRAND_NAME}`} description="Help your kids take responsibility without another job for Mom. Try a personalized family Daily Reset in seconds." indexable={false} chrome={false} width="full" tracking={false}>
<div class="club">

<main>
<section class="hero home-style-inset" id="start"><div class="club-float-surface"><div class="hero-inner">
 <div class="hero-copy"><p class="eyebrow">MOMS WITH SCHOOL-AGED KIDS</p>
 <h1>Your family shouldn't depend<span class="mobile-headline-break"></span> on you <em>for everything.</em></h1>
 <p class="product-definition"><strong>Personalized Printed Tools mailed to you</strong> get everyone building routines and taking responsibility, with less for you to figure out.</p>
 <p class="supporting">Get one family plan personalized with your family’s names and ages, printed and mailed to your door every month.</p>
 <p class="hero-pricing">$6.39/month or $59/year · U.S. shipping included</p>
 <div class="hero-actions"><a class="primary" href="#demo">Show Me My Family's Plan <span class="lime-arrow" aria-hidden="true">→</span></a><a class="hero-secondary" href="#what-arrives">See what arrives</a></div>
 <div class="hero-rating"><img src="data:image/png;base64," alt="4.9 out of 5 stars, 113 Organized Mom Collective reviews" width="350" height="35" loading="eager" /><span>Organized Mom Collective reviews</span></div>
 <p class="hero-trust">Personalized for your household · One printed tool each month · Digital version included</p></div>
 <figure class="hero-photo"><img src={clubHeroUrl} alt="Family gathered around a kitchen table looking together at a printed family plan" width="1200" height="900" loading="eager" fetchpriority="high" /></figure>
 <div class="hero-seam-badge" aria-hidden="true"><img src={clubBadgeUrl} alt="" width="120" height="120" loading="eager" /></div>
</div></div></section>
<section class="kit-gallery container" aria-labelledby="kit-gallery-title">
 <p class="eyebrow">A LOOK INSIDE THE CLUB</p>
 <h2 id="kit-gallery-title">Less for you to manage. <em>One month at a time.</em></h2>
 <p class="kit-gallery-intro">From daily habits and laundry to summer days and school routines, each month brings a personalized tool to help your family share the load.</p>
 <div class="kit-gallery-grid">{kitPreviews.map(kit => <figure class="kit-gallery-item">
  <button class="kit-gallery-open" type="button" data-kit-open={kit.month} aria-label={`View ${kit.month}: ${kit.title}`} aria-haspopup="dialog"><span class="kit-gallery-zoom" aria-hidden="true">View preview +</span></button>
  <figcaption><span class="kit-gallery-month" style={{ backgroundColor: kit.color }}>{kit.month}</span><h3>{kit.title}</h3></figcaption>
  <img src={kit.image} alt={`${kit.month}: ${kit.description}, Organized Family Club printed tool preview`} width="1080" height="1080" loading="lazy" decoding="async" />
 </figure>)}</div>
 <p class="kit-gallery-note">Examples of the monthly tools. Your family receives one personalized plan each month.</p>
</section>
{kitPreviews.map(kit => <dialog class="kit-fullscreen" id={`kit-preview-${kit.month}`} aria-labelledby={`kit-title-${kit.month}`}>
 <button class="kit-fullscreen-close" type="button" aria-label="Close resource preview">×</button>
 <div class="kit-fullscreen-content">
  <p class="kit-fullscreen-month" style={{ backgroundColor: kit.color }}>{kit.month}</p>
  <h2 id={`kit-title-${kit.month}`}>{kit.title}</h2>
  <img class="kit-fullscreen-image" src={kit.image} alt={`${kit.month}: ${kit.description}`} width="1080" height="1080" loading="lazy" decoding="async" />
  <div class="kit-fullscreen-copy"><p>{kitDetails[kit.month].relief}</p>
   <section class="kit-personal" style={{ '--kit-tint': `${kit.color}40`, '--kit-accent': kit.color }} aria-labelledby={`kit-personal-title-${kit.month}`}>
    <p class="kit-personal-example">{kitDetails[kit.month].example}</p>
    <h3 id={`kit-personal-title-${kit.month}`}>Made for your family.<br/><span>Less planning for you.</span></h3>
    <dl class="kit-personal-benefits">
     <div><dt>Their names</dt><dd>{kit.month === 'December' ? "Cards personalized with your children’s names make giving feel like their own project." : "Everyone sees their own part."}</dd></div>
     <div><dt>Their abilities</dt><dd>{kit.month === 'December' ? "Draw, write a poem, or share a letter, according to their ages and abilities." : "Steps fit their ages and what they can handle."}</dd></div>
     <div><dt>{kit.month === 'December' ? 'Your values' : 'Your needs'}</dt><dd>{kit.month === 'December' ? "A ready-to-use way to help your kids notice and encourage others." : "The plan fits the routine you need help with."}</dd></div>
    </dl>
    <p class="kit-personal-caption">Illustrative example. Your plan is prepared for your household.</p>
   </section>
  </div>
 </div>
</dialog>)}
<script>
 const previews = document.querySelectorAll<HTMLDialogElement>('.kit-fullscreen');
 let previousOverflow = '';
 document.querySelectorAll<HTMLButtonElement>('[data-kit-open]').forEach(button => {
  button.addEventListener('click', () => {
   const dialog = document.getElementById(`kit-preview-${button.dataset.kitOpen}`) as HTMLDialogElement | null;
   if (!dialog) return;
   previousOverflow = document.body.style.overflow;
   document.body.style.overflow = 'hidden';
   dialog.showModal();
   dialog.scrollTop = 0;
  });
 });
 previews.forEach(dialog => {
  dialog.querySelector('button')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => { document.body.style.overflow = previousOverflow; });
 });
</script>
<section class="pain container"><p class="eyebrow">SOUND FAMILIAR?</p><h2>You love taking care of your family. <em>You just don't want to manage every little thing.</em></h2>
<div class="pain-questions"><p>Who remembers what goes in the backpacks?</p><p>Who figures out dinner?</p><p>Who reminds everyone to clean up?</p><p>Who knows what happens next?</p></div>
<p class="pain-finish">Even when everyone wants to help, you're still the one keeping it all moving. <strong>What if your family could start taking more responsibility themselves?</strong> Not perfectly. Not overnight. One little piece at a time.</p></section>
<section class="what-arrives home-style-inset" id="what-arrives"><div class="club-offer-surface"><div class="container tangible"><div><p class="eyebrow">MEET ORGANIZED FAMILY CLUB</p><h2>One less thing for Mom to manage. <em>Every month.</em></h2>
<p>Each month tackles one everyday family challenge, from hectic mornings and dinners to summer routines and getting ready for school.</p><p>We prepare the plan around your family, put names and responsibilities right on the page, and mail the finished tool to your door.</p>
<p class="tangible-bold">They get a clear plan to follow. You get a little less to carry.</p><a class="primary" href="#demo">See What We'd Make for My Family →</a></div>
<div class="print-showcase"><img class="summer-day-example" src={summerDayExampleUrl} alt="Our Summer Day, an example of the printed family summer rhythm plan" loading="lazy" decoding="async" /><p class="showcase-caption">Example of May’s Summer Day Rhythm. Your family’s mailed plan is personalized.</p></div>
</div></div></section>
<section class="comparison container" id="what-changes"><p class="eyebrow">THE DIFFERENCE IS WHO CARRIES THE PLAN</p><h2>Less directing from Mom. <em>More doing from everyone else.</em></h2><p class="ownership-intro">Think of a typical school morning. The goal isn't another checklist for Mom to manage. It's a clear plan the family can use without asking her what comes next.</p><div class="compare-grid ownership-grid"><article><p class="ownership-label">WITHOUT A SHARED PLAN</p><h3>Mom is the reminder system.</h3><ul><li>Mom notices the backpack isn't ready.</li><li>Mom tells someone to get dressed.</li><li>Mom remembers what still needs to be packed.</li><li>Mom checks whether everything got done.</li></ul><p class="ownership-foot">The work isn't just doing things. It's keeping track of everything.</p></article><article class="compare-good"><p class="ownership-label">WITH A CLUB ROUTINE TO FOLLOW</p><h3>The plan does more of the reminding.</h3><ul><li>Each person sees their own next step.</li><li>Kids can check the routine before asking.</li><li>Responsibilities are named in advance.</li><li>The family has one shared reference point.</li></ul><p class="ownership-foot">The aim: Mom can support the routine instead of narrating every step.</p></article></div><p class="ownership-caption">An illustration of how the tools are designed to work, not a measured customer result. <a href="/club/january-preview/">See the actual January morning routine →</a></p></section>
<section class="features container"><p class="eyebrow">WHAT COMES IN THE MAIL</p><h2>One beautiful tool. <em>Ready to use.</em></h2><div class="features-layout"><figure class="features-image"><img src={routineClubExampleUrl} alt="Example of an Organized Family Club personalized family routine tool" loading="lazy" decoding="async" /></figure><div class="feature-grid"><article><span>01</span><h3>A finished family plan</h3><p>One real problem with practical steps and clear responsibilities worked out in advance.</p></article><article><span>02</span><h3>Personal touches</h3><p>Your family's names, ages, and household needs shape the recommendations.</p></article><article><span>03</span><h3>A note from Megan</h3><p>Warm encouragement and a simple way to introduce the plan.</p></article><article><span>04</span><h3>A digital copy</h3><p>Review your plan, make a few changes when needed, and access it again later.</p></article></div></div></section>
<section class="month-stories home-style-inset" id="months"><div class="club-float-surface story-shell"><div class="container"><p class="eyebrow">SEE THE RESPONSIBILITY SHIFT</p><h2>Small, practical changes. <em>Less depending on Mom.</em></h2><p class="story-intro">These are real examples of the tools we're preparing, with the everyday behavior each is designed to help your family practice.</p><div class="story-grid">
<article class="story-card"><div class="story-top"><img src={months[0].icon} alt="" loading="lazy" width="90" height="90"/><span class="ready-label">VIEW REAL TOOL</span></div><p class="story-month">JANUARY · MORNINGS</p><h3>From “Get your backpack!” to checking their own routine.</h3><p>A personalized morning or evening plan shows each child what comes next, so Mom isn't the only one who knows the sequence.</p><a href="/club/january-preview/">Inspect January's plan →</a></article>
<article class="story-card"><div class="story-top"><img src={months[2].icon} alt="" loading="lazy" width="90" height="90"/><span class="ready-label">VIEW REAL TOOL</span></div><p class="story-month">MARCH · CLEANING</p><h3>From “Clean your room!” to a job they can finish.</h3><p>Steps, supplies, and what “done” means are written out. Kids have a clearer way to complete the job without Mom explaining it again.</p><a href="/club/march-preview/">Inspect March's plan →</a></article>
<article class="story-card"><div class="story-top"><img src={months[4].icon} alt="" loading="lazy" width="90" height="90"/><span class="ready-label">VIEW REAL TOOL</span></div><p class="story-month">MAY · SUMMER DAYS</p><h3>From “What do I do now?” to checking the day's rhythm.</h3><p>Flexible daily anchors and activity choices give kids a next step to look at instead of asking Mom to invent the day's schedule.</p><a href="/club/may-preview/">Inspect May's plan →</a></article>
</div><details class="all-months"><summary>Explore all 12 monthly tools <span>+</span></summary><div class="month-grid">{months.map(m=><a href={m.url}><img src={m.icon} alt="" width="54" height="54" loading="lazy"/><div><small>{m.month}</small><b>{m.title}</b><span>Preview →</span></div></a>)}</div></details></div></div></section>
<section class="club-demo" id="demo"><div class="club-demo-inner"><div class="club-demo-heading"><p class="eyebrow">SEE IT FOR YOUR OWN FAMILY</p><h2>The plan is <span class="lime-highlight">already made.</span> <em>The guesswork is already gone.</em></h2><p>See how a Club tool works. Try June's prepared snack station and change the food choices to fit your household.</p><p class="demo-disclaimer">Names and ages are optional. The snack sample is free to explore; no payment or account needed.</p></div>
<form id="family-form" class="form" autocomplete="off"><p class="form-kicker">YOUR FREE INTERACTIVE EXAMPLE</p><h2>Try a plan made for real family life.</h2><p>Enter as much or as little as you'd like. Anything you leave empty stays blank in the sample.</p><div class="name-fields"><label>Mom's first name<input name="mom" id="mom" placeholder="Enter name" autocomplete="off" maxlength="40" /></label><label>Dad's first name<input name="dad" id="dad" placeholder="Enter name" autocomplete="off" maxlength="40" /></label></div><div class="children-head"><strong>Your kids</strong><span>Tap a field to edit</span></div><div id="children-fields"></div><button type="button" class="add" id="add-child">+ Add a child</button><button type="submit" class="primary form-submit">Show Me the Snack Plan <span class="lime-arrow" aria-hidden="true">→</span></button><small>No sign-in. Your details stay in this browser.</small></form></div></section>
<section class="result" id="result" hidden aria-live="polite"><div class="container result-layout"><div><p class="eyebrow">YOUR FAMILY'S PREVIEW IS READY</p><h2>Your family's snack station is ready to explore.</h2><p>Try changing the illustrated snack choices in June's example tool. Each month, the Club prepares a different family plan designed to make everyday responsibilities clearer.</p><div class="result-actions"><a href="#offer" class="primary">Explore the Club →</a><button class="text-button" id="edit-family" type="button">Edit family details</button><button class="text-button" type="button" id="clear-family">Clear my details</button></div></div><div class="result-card"><span>INTERACTIVE JUNE SAMPLE</span><h3>Snacks your kids can choose.</h3><p>Explore the prepared snack station and change the options to fit your household.</p><button type="button" class="primary" id="open-preview">View your family's plan →</button></div></div></section>
<dialog id="club-preview-modal" class="club-preview-modal" aria-labelledby="club-modal-title">
 <div class="preview-page-shell">
  <header class="preview-page-header"><span>ORGANIZED FAMILY CLUB <span aria-hidden="true">·</span> INTERACTIVE SAMPLE</span><button type="button" id="close-preview" class="modal-close" aria-label="Close preview">×</button></header>
  <div class="preview-page-content preview-snack-layout">
   <div class="preview-deliverable preview-snack-deliverable">
    <p class="eyebrow">JUNE SAMPLE · TRY IT FOR YOUR FAMILY</p>
    <JuneSnackStation storageKey="omc:club:landing-snack-demo:v1" />
    <div id="modal-assignments" hidden aria-hidden="true"></div>
    <p class="preview-snack-safety">Review the foods for allergies, choking risks, and your children's ages before using any snack plan. Supervise younger children.</p>
    <p class="modal-note">Interactive demonstration of a June Club tool. This is not a physical order.</p>
   </div>
   <div class="preview-offer">
    <p class="eyebrow">ONE LESS DECISION FOR MOM</p>
    <h2 id="club-modal-title">The snacks are handled. <em>By the kids.</em></h2>
    <p class="preview-lead">Imagine your children checking their own approved snack options instead of asking you what they can eat all afternoon.</p>
    <div class="preview-offer-divider"></div>
    <p class="eyebrow">GIVE IT A TRY</p>
    <h3>See the choices. Swap out foods. Make it work for your kitchen.</h3>
    <p>The snack station on the left is the actual interactive June prototype. Choose foods that fit your household and see the fridge-ready plan change.</p>
    <p>Every month, Organized Family Club prepares one different family tool to help everyone take more responsibility — personalized, printed, and mailed to your door.</p>
    <p class="preview-offer-note">June's snack plan is an example, not what every monthly delivery contains. Enrollment isn't open yet.</p>
    <div class="modal-actions"><a href="#offer" id="modal-club" class="primary">Explore the Monthly Club <span class="lime-arrow" aria-hidden="true">→</span></a><button type="button" id="modal-more" class="text-button">Learn how the Club works</button></div>
    <p class="preview-enrollment">No payment or account required to try this sample.</p>
   </div>
  </div>
 </div>
</dialog>
<section class="how container" id="how"><p class="eyebrow">THREE SIMPLE STEPS</p><h2>We do the preparation. <em>Your family gets started.</em></h2><div class="step-grid"><article><b>1</b><h3>Tell us about your family.</h3><p>A few household details help us make practical recommendations.</p></article><article><b>2</b><h3>We prepare your plan.</h3><p>Each month focuses on one everyday challenge. Review and adjust it if you want.</p></article><article><b>3</b><h3>Find it in your mailbox.</h3><p>It's printed and ready to put on the fridge and talk through together.</p></article></div><p class="how-note">No elaborate setup. No new app everyone has to learn.</p></section>
<section class="founder home-style-inset"><div class="club-offer-surface"><div class="container founder-layout"><img src="/images/site/mark-megan-family-story-1200.webp" alt="Megan and her family" loading="lazy" width="460" height="460"/><div><p class="eyebrow">FROM OUR FAMILY TO YOURS</p><h2>Created by a family <em>who gets it.</em></h2><p>Hi, I'm Megan. I know how much it takes to keep a family running, and how easy it is to become the person everyone depends on for the next reminder, answer, or instruction.</p><p>We created Organized Family Club to help put simple, practical tools in your family's hands, not to give you more to do.</p><p>One month. One small change. One more thing you don't have to carry alone.</p><strong>Megan</strong></div></div></div></section>
<section class="proof container"><p class="eyebrow">REAL TOOLS. REAL CUSTOMER TRUST. HONEST EVIDENCE.</p><h2>Don't just take our word for <em>the preparation.</em></h2><div class="evidence-grid"><article><span class="evidence-number">01 · THE ACTUAL TOOLS</span><h3>Look inside the monthly plans.</h3><p>January, March, and May show how we turn a recurring family problem into visible steps and responsibilities.</p><a href="#months">Explore the real examples →</a></article><article><span class="evidence-number">02 · YOUR OWN SAMPLE</span><h3>See your family's names on a plan.</h3><p>Try a free personalized Daily Reset to see how roles can be assigned before a tool reaches the fridge.</p><a href="#demo">Create a free family preview →</a></article><article><span class="evidence-number">03 · OUR EXISTING BRAND</span><h3>A customer on our wall calendar:</h3><blockquote>“This calendar is life changing. Quite literally!”</blockquote><p>Raquel · 5-star Etsy review</p><small>This review concerns our wall calendar, not Club membership.</small></article></div><p class="evidence-disclosure">Organized Family Club is being tested. We haven't yet established measured reductions in reminders or Mom's workload. Those outcomes need to come from families using the Club in real homes.</p></section>
<section class="offer-band home-style-inset" id="offer"><div class="club-offer-surface"><div class="container offer-layout"><div class="offer-copy"><p class="eyebrow">ONE FAMILY. ONE MONTHLY PROBLEM. ONE READY-TO-USE PLAN.</p><h2>The whole family gets involved. <em>Mom gets some breathing room.</em></h2><p>The planned subscription brings a new personalized printed family tool to your mailbox each month, with a digital copy and a note from Megan.</p><div class="offer-details"><span><i class="lime-check" aria-hidden="true">✓</i> Personalized responsibilities</span><span><i class="lime-check" aria-hidden="true">✓</i> One printed tool delivered monthly</span><span><i class="lime-check" aria-hidden="true">✓</i> Digital access to review and reuse</span><span><i class="lime-check" aria-hidden="true">✓</i> No giant workbooks or complicated setup</span></div></div><div class="price-card"><p class="eyebrow">ORGANIZED FAMILY CLUB</p><h3>One simple monthly delivery.</h3><div class="price">$6.39 <span>/ month</span></div><p class="annual">or $59 per year</p><p class="fineprint">Proposed pricing. Enrollment isn't open yet while printing, fulfillment, and billing are tested.</p><a class="primary" href="/support">Ask About Early Access →</a><small>No payment required to ask.</small></div></div></div></section>
<section class="faq" id="faq"><div class="container faq-layout"><div><p class="eyebrow">GOOD QUESTIONS</p><h2>A few things you might be wondering.</h2></div><div class="faq-items">{faqs.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></div></section>
<section class="closing home-style-inset"><div class="club-close-surface"><div class="container"><p class="eyebrow">ORGANIZED FAMILY CLUB</p><h2>You don't have to <em>do it all yourself.</em></h2><p>We'll make the plan. We'll print it. We'll send it. Your family gets to take it from there.</p><a href="#demo" class="primary">Show Me My Family's Plan →</a><p class="closing-caption">One family. One monthly problem. One ready-to-use plan.</p></div></div></section>
</main><footer class="footer"><a href="/">Organized Mom Collective</a><span>© {new Date().getFullYear()} Organized Mom Collective</span><a href="/support">Support</a></footer></div>
<script is:inline>
 const form = document.querySelector('#family-form');
 const childrenFields = document.querySelector('#children-fields');
 const addButton = document.querySelector('#add-child');
 const result = document.querySelector('#result');
 const modal = document.querySelector('#club-preview-modal');
 const modalAssignments = document.querySelector('#modal-assignments');
 const KEY = 'ofc-club-sales-demo-v1';
 const safe = value => String(value || '').trim().slice(0,40);
 const escapeHtml = value => safe(value).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const jobs = age => age <= 3 ? 'Put a few toys in the basket (with help)' : age <= 5 ? 'Toys and books back in their places' : age <= 8 ? 'Put shoes, backpack, and belongings away' : age <= 11 ? 'Clear dishes and reset personal things' : age <= 14 ? 'Tidy the entryway and personal space' : 'Help reset the kitchen and shared spaces';
 function addChild(name='',age='') {
   if(childrenFields.children.length >= 8) return;
   const row = document.createElement('div'); row.className='child-row';
   row.innerHTML = `<label class="child-name-field"><span>Child's first name</span><input type="text" name="child-name" maxlength="40" placeholder="Enter child's name" autocomplete="off"></label><label class="child-age-field"><span>Age</span><select name="child-age" aria-label="Select child's age"><option value="">Select age</option>${Array.from({length:18},(_,i)=>`<option value="${i+1}">${i+1} years</option>`).join('')}</select></label><button type="button" class="remove" aria-label="Remove child" title="Remove child">×</button>`;
   row.querySelector('input').value=name; row.querySelector('select').value=age;
   row.querySelector('button').addEventListener('click',()=>{if(childrenFields.children.length>1)row.remove();addButton.disabled=childrenFields.children.length>=8});
   childrenFields.append(row);addButton.disabled=childrenFields.children.length>=8;
 }
 function getData(){return {mom:safe(form.elements.namedItem('mom').value),dad:safe(form.elements.namedItem('dad').value),children:[...childrenFields.querySelectorAll('.child-row')].map(row=>({name:safe(row.querySelector('input').value),age:row.querySelector('select').value===''?null:Number(row.querySelector('select').value)}))}}
 function showPlan(data,scroll=false){
   const people=[...data.children.map(c=>({name:c.name||'',task:c.age==null||c.age===''?'':jobs(Number(c.age))})),{name:data.dad||'',task:'Clear and wipe the dinner table'},{name:data.mom||'',task:'Help everyone get ready for tomorrow'}];
   modalAssignments.innerHTML=people.map(p=>'<div class="assignment"><span class="tick"></span><div><b>'+escapeHtml(p.name)+'</b><p>'+escapeHtml(p.task)+'</p></div></div>').join('');
   result.hidden=false;
   const householdDetail={household:{id:'landing-demo',children:data.children.map(c=>({name:c.name,age:c.age}))},sample:'landing'};
   window.__ofcPreviewHousehold=householdDetail;
   window.dispatchEvent(new CustomEvent('omc:club-preview-household',{detail:householdDetail}));
   try{localStorage.setItem(KEY,JSON.stringify(data))}catch{}
   if(scroll && typeof modal.showModal==='function'){modal.showModal();requestAnimationFrame(()=>window.dispatchEvent(new Event('resize')))}
 }
 addButton.addEventListener('click',()=>addChild());
 form.addEventListener('submit',event=>{event.preventDefault();showPlan(getData(),true)});
 document.querySelector('#open-preview').addEventListener('click',()=>{modal.showModal();requestAnimationFrame(()=>window.dispatchEvent(new Event('resize')))});
 document.querySelector('#close-preview').addEventListener('click',()=>modal.close());
 document.querySelector('#modal-more').addEventListener('click',()=>{modal.close();document.querySelector('#how').scrollIntoView({behavior:'smooth'})});
 document.querySelector('#modal-club').addEventListener('click',()=>modal.close());
 modal.addEventListener('click',e=>{if(e.target===modal)modal.close()});
 document.querySelector('#edit-family').addEventListener('click',()=>form.scrollIntoView({behavior:'smooth',block:'center'}));
 document.querySelector('#clear-family').addEventListener('click',()=>{try{localStorage.removeItem(KEY)}catch{};form.reset();childrenFields.replaceChildren();addChild();addChild();result.hidden=true;modalAssignments.replaceChildren();form.scrollIntoView({behavior:'smooth'})});
 let saved=null;try{saved=JSON.parse(localStorage.getItem(KEY)||'null')}catch{}
 if(saved&&typeof saved.mom==='string'&&typeof saved.dad==='string'&&Array.isArray(saved.children)&&saved.children.length&&saved.children.length<=8){form.elements.namedItem('mom').value=safe(saved.mom);form.elements.namedItem('dad').value=safe(saved.dad);saved.children.forEach(c=>addChild(safe(c.name),c.age==null||c.age===''?'':String(Math.max(1,Math.min(18,Number(c.age)||1)))));if(saved.mom||saved.dad||saved.children.some(c=>c.name||c.age!=null&&c.age!==''))showPlan(saved)}else{addChild();addChild()}
</script>

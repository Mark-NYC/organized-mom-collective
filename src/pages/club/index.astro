.ofc-family{max-width:1160px;margin:0 auto;padding:110px 25px;display:grid;grid-template-columns:.8fr 1fr;gap:clamp(35px,6vw,95px);align-items:center}.ofc-family img{width:100%;aspect-ratio:1;object-fit:cover}.ofc-family h2{margin:17px 0 28px}.ofc-family p:not(.ofc-eyebrow){margin-bottom:16px}

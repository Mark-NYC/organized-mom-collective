.club .club-demo .form h2{font-size:1.5rem}
.club .club-demo .form .form-submit{min-height:50px}
.club .benefits{padding-top:72px;padding-bottom:90px}
.club .benefits h2{max-width:750px;font-size:clamp(2rem,3vw,3.1rem)}

---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { BRAND_NAME } from '../../config';
const perks = [
  {number:'01', title:'We choose a practical focus', body:'One area of family life to improve, from shared chores to more time together. No searching for the next system.'},
  {number:'02', title:'We prepare the resources', body:'A personalized generator and ready-to-use printable pages mean you don’t have to start with an empty chart.'},
  {number:'03', title:'You start it together', body:'A simple family activity gives everyone a place to begin and a responsibility to own.'}
];
const steps = [
  ['Open your letter', 'See what your family is working on this month.'],
  ['Make your plan', 'Tell the generator about your household. Start with a plan made for your family, not a blank page.'],
  ['Start together', 'Gather the family, agree on the next step, and give everyone a real part to own.']
];
const questions = [
  ['How is the Club different from the wall calendar?', 'The calendar gives you one place for schedules and shared plans. The Club gives your family a prepared monthly improvement plan, a personalized tool and guidance for putting it into practice.'],
  ['What do I receive each month?', 'The planned membership includes a mailed personal letter and field guide, one family challenge, and a digital kit with a personalized generator and supporting printable pages.'],
  ['Do I have to create the plans myself?', 'No. The featured generator creates a starting plan from your family’s details. You can review and adjust it together instead of building from scratch.'],
  ['Do I need to own the wall calendar?', 'Not at all. The Club works on its own, and it also complements the calendar.'],
  ['Do I have to print everything?', 'The mailer comes in the mail. The digital kit is designed to use on screen and includes printable pages if paper works better for your home.'],
  ['What if we miss a month?', 'Start with what helps your family now. There is no expectation to overhaul your home or finish every activity.'],
  ['When will the first letter arrive?', 'Enrollment and mailing cutoff dates will be published before subscriptions open.'],
  ['Can I cancel?', 'Pricing, cancellation and billing terms will be shown before you subscribe. The Club is not yet available to purchase.']
];
const check = 'M5 12l4 4L19 6';
---
<PublicLayout
  fullTitle={`Organized Family Club · ${BRAND_NAME}`}
  description="A better-running family, without figuring it all out yourself. Organized Family Club brings ready-to-use personalized plans, a family challenge and a monthly letter."
  indexable={false}
  chrome={false}
  width="full"
>
  <div class="club">
    <header class="club-header">
      <a href="/" aria-label="Organized Mom Collective home"><img src="/brand/omc-badge.png" alt="" width="56" height="56" /></a>
      <a href="#monthly" class="club-header-link" data-cta="club-nav-preview">What’s inside <span aria-hidden="true">↗</span></a>
    </header>
    <section class="club-hero" aria-labelledby="club-hero-title">
      <div class="club-hero-copy">
        <p class="club-eyebrow">The Organized Family Club</p>
        <h1 id="club-hero-title">A better-running family. <em>Without figuring it all out yourself.</em></h1>
        <p class="club-lede">Every month, get a ready-to-use family plan, personalized tools, and a simple challenge to help everyone work better together.</p>
        <p>Less researching, planning and reminding. More shared ownership, one month at a time.</p>
        <div class="club-hero-action">
          <a href="#monthly" class="club-button" data-cta="club-hero-kits">See what’s inside <span aria-hidden="true">→</span></a>
          <p><strong>$5/month planned</strong> · Enrollment not yet open</p>
        </div>
      </div>
      <div class="club-hero-art" aria-label="Illustration showing ready-to-use family planning sheets and a mailed letter">
        <div class="club-envelope-back"></div>
        <div class="club-paper club-paper-rear"><span>FAMILY PLAN</span><div></div><div></div><div></div></div>
        <div class="club-paper club-paper-front"><small>ORGANIZED FAMILY CLUB</small><strong>Your family’s plan, ready to go.</strong><p>One small improvement. Everyone has a part.</p><span>WITH LOVE, MARK &amp; MEGAN</span></div>
        <div class="club-envelope-front"></div>
      </div>
    </section>
    <section class="club-narrow club-problem" aria-labelledby="club-problem-title">
      <p class="club-eyebrow">The invisible extra job</p>
      <h2 id="club-problem-title">You’re managing the family. And the system that’s supposed to help manage the family.</h2>
      <p>The chore charts. The routines. The checklists saved from Pinterest.</p>
      <p>Someone still has to find the ideas, make the plans, explain how they work and remind everyone to follow through.</p>
      <p>And somehow, that someone is usually you.</p>
      <p class="club-serif-note">You shouldn’t have to build another system just to get everyone helping.</p>
    </section>
    <section class="club-photo-story" aria-label="A family sharing everyday responsibilities">
      <figure class="club-photo-story-image">
        <img src="/images/club/club-dad-kids-breakfast.webp" width="1200" height="800" loading="lazy" decoding="async" alt="A father preparing breakfast while his two children sit with him at the kitchen counter" />
      </figure>
      <div class="club-photo-story-copy">
        <p class="club-eyebrow">A different kind of family organization</p>
        <h2>It works better when everyone has a part.</h2>
        <p>We want kids to learn how to contribute, and parents to share the planning and follow-through. Not another set of reminders for Mom to carry.</p>
      </div>
    </section>
    <section class="club-surface club-contrast" aria-labelledby="club-contrast-title">
      <div class="club-center">
        <p class="club-eyebrow">Less setup for Mom. More ownership for everyone.</p>
        <h2 id="club-contrast-title">We help with the planning. Your family shares the doing.</h2>
        <p>Each month, we choose one part of family life to improve and prepare the tools to help you start together.</p>
      </div>
      <div class="club-included club-promise">
        {perks.map((perk) => <article class="club-included-item"><span class="club-number">{perk.number}</span><h3>{perk.title}</h3><p>{perk.body}</p></article>)}
      </div>
      <figure class="club-team-photo"><img src="/images/club/club-dad-daughter-dishes.webp" width="1200" height="800" loading="lazy" decoding="async" alt="A father and daughter washing dishes together at the kitchen sink" /></figure>
    </section>
    <section class="club-section" id="monthly" aria-labelledby="club-monthly-title">
      <div class="club-center">
        <p class="club-eyebrow">Ready-to-use monthly kits</p>
        <h2 id="club-monthly-title">A fresh family improvement, ready to go each month.</h2>
        <p>Different challenges. The same idea: we do much of the setup so your family can get started together.</p>
      </div>
      <div class="club-kit-grid">
        <article class="club-kit">
          <div class="club-kit-preview"><span>NOVEMBER</span><strong>Share the load</strong><p>Our family’s ownership plan</p><div class="club-preview-line">Daily care <span>✓</span></div><div class="club-preview-line">Room jobs <span>✓</span></div><div class="club-preview-line">Helping at home <span>✓</span></div></div>
          <div class="club-kit-copy"><p class="club-eyebrow">Family ownership</p><h3>Share the Load</h3><p>Turn the household to-do list into a responsibility plan with jobs matched to family members’ ages and abilities.</p><p class="club-kit-result"><strong>Ready-to-use result:</strong> A personalized ownership plan that everyone can review together.</p></div>
        </article>
        <article class="club-kit">
          <div class="club-kit-preview club-kit-preview-blush"><span>FEBRUARY</span><strong>Better together</strong><p>Our family connection plan</p><div class="club-preview-line">Together time <span>♡</span></div><div class="club-preview-line">One-on-one ideas <span>♡</span></div><div class="club-preview-line">Weekly rhythm <span>♡</span></div></div>
          <div class="club-kit-copy"><p class="club-eyebrow">Family connection</p><h3>Better Together</h3><p>Find age-appropriate ways to spend meaningful time together without planning everything from scratch.</p><p class="club-kit-result"><strong>Ready-to-use result:</strong> A connection plan with family activities and simple weekly rhythms.</p></div>
        </article>
        <article class="club-kit">
          <div class="club-kit-preview club-kit-preview-blue"><span>MARCH</span><strong>Spring clean as a team</strong><p>Our room-by-room plan</p><div class="club-preview-line">Kitchen <span>✓</span></div><div class="club-preview-line">Bedrooms <span>✓</span></div><div class="club-preview-line">Living spaces <span>✓</span></div></div>
          <div class="club-kit-copy"><p class="club-eyebrow">Shared home care</p><h3>Spring Clean as a Team</h3><p>Divide spring cleaning into age-appropriate jobs and short, manageable sessions.</p><p class="club-kit-result"><strong>Ready-to-use result:</strong> A room-by-room plan with clear assignments for the family.</p></div>
        </article>
      </div>
      <p class="club-footnote club-kit-disclaimer">These are conceptual previews of planned kits, not screenshots of finished personalized output. Final contents may change before launch.</p>
    </section>
    <section class="club-surface club-example club-mailer" aria-labelledby="club-example-title">
      <div class="club-example-copy">
        <p class="club-eyebrow">A personal touch, delivered</p>
        <h2 id="club-example-title">Something good in the mail. Something useful for your family.</h2>
        <p>The digital kit does the preparation. The letter helps your family put the plan into practice.</p>
        <div class="club-rule-list">
          <p><strong>A personal letter</strong><span>Encouragement from Mark and Megan and a clear focus for the month.</span></p>
          <p><strong>A family field guide</strong><span>A practical starting point, without another long book or course to work through.</span></p>
          <p><strong>A family activity</strong><span>A simple way to gather everyone and take the first step together.</span></p>
          <p><strong>Access to your kit</strong><span>A QR code to your personalized digital resources and printable pages.</span></p>
        </div>
      </div>
      <div class="club-sample-sheet club-letter-preview" aria-label="Illustrative layout of the monthly letter, not a final printed product">
        <p class="club-eyebrow">ORGANIZED FAMILY CLUB</p>
        <h3>Dear family,</h3>
        <p>One small change this month can make home feel a little easier for everyone.</p>
        <p>Start with a conversation. Choose one job to share, and make sure everyone knows what belongs to them.</p>
        <p class="club-letter-signature">With love,<br />Mark &amp; Megan</p>
        <div class="club-sample-bottom">YOUR MONTHLY LETTER + FAMILY FIELD GUIDE</div>
      </div>
    </section>
    <section class="club-section" aria-labelledby="club-how-title">
      <div class="club-center"><p class="club-eyebrow">How it works</p><h2 id="club-how-title">Open it. Make it yours. Do it together.</h2><p>Start with the plan we’ve prepared. Make it fit your household, then let the family take part.</p></div>
      <div class="club-steps">{steps.map(([title,body],i)=><div class="club-step"><span>{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{body}</p></div>)}</div>
    </section>
    <figure class="club-rhythm-photo">
      <img src="/images/club/club-family-folding-laundry.webp" width="1500" height="1000" loading="lazy" decoding="async" alt="A mother and young child folding laundry side by side on a wooden floor" />
      <figcaption>Small things become shared habits when everyone knows their part.</figcaption>
    </figure>
    <section class="club-surface club-calendar" aria-labelledby="club-calendar-title">
      <img src="/images/site/calendar-cutout-720.webp" width="720" height="1058" loading="lazy" alt="Organized Mom Collective weekly wall calendar for schedules, meals and household jobs" />
      <div>
        <p class="club-eyebrow">Two different ways to help your family</p>
        <h2 id="club-calendar-title">The calendar shows the plan. The Club helps you build better ways of doing life together.</h2>
        <p><strong>The Wall Calendar</strong> gives everyone one place to see schedules, meals and responsibilities for the week.</p>
        <p><strong>The Monthly Club</strong> gives you prepared tools, personalized plans and guidance for improving one part of family life at a time.</p>
        <p>You don’t need a calendar to join. If you already have one, the Club is a natural next step.</p>
        <a class="club-text-link" href="/calendar" data-cta="club-calendar">See the wall calendar <span aria-hidden="true">→</span></a>
      </div>
    </section>
    <section class="club-section club-story" aria-labelledby="club-story-title">
      <div class="club-story-photo"><img src="/images/site/mark-megan-family-story-1200.webp" width="1200" height="1200" loading="lazy" alt="Mark and Megan with their family outdoors" /></div>
      <div><p class="club-eyebrow">From our family to yours</p><h2 id="club-story-title">We started building these tools because our own family needed them.</h2>
        <p>We didn’t start with a perfectly organized home. Too much of the planning, remembering and managing was landing on Megan, and we needed something to change.</p>
        <p>Mark loves building systems. Megan helps make sure they work for real family life. Together, we began creating tools so the plan doesn’t have to live in one person’s head.</p>
        <p>We wanted the Club to do more than hand Mom another project. We want to help prepare the next step and invite the whole family into it.</p>
        <p><strong>Organized moms raise organized families.</strong> That’s the heart behind it.</p>
        <a class="club-text-link" href="/our-story" data-cta="club-story">Read our story <span aria-hidden="true">→</span></a>
      </div>
    </section>
    <section class="club-surface club-reassurance" aria-labelledby="club-reassurance-title"><div class="club-center"><p class="club-eyebrow">Built for real weeks</p><h2 id="club-reassurance-title">Prepared for you. Started together.</h2></div><div class="club-benefits"><div><h3>One focus at a time</h3><p>Skip the giant overhaul.</p></div><div><h3>No blank-page setup</h3><p>Make a plan from your family’s details.</p></div><div><h3>Real ownership</h3><p>Everyone learns their part.</p></div><div><h3>Room to start small</h3><p>Use what helps this month.</p></div></div></section>
    <section class="club-narrow club-faq" aria-labelledby="club-faq-title"><p class="club-eyebrow">Good questions</p><h2 id="club-faq-title">Before you join</h2><div>{questions.map(([q,a],i)=><details open={i===0}><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
    <section class="club-final" id="join" aria-labelledby="club-final-title"><p class="club-eyebrow">Organized Family Club</p><h2 id="club-final-title">Less time figuring it all out. More time making it work together.</h2><p>A fresh family plan, with the preparation already done.</p><div class="club-final-offer"><p class="club-price">$5 <span>/ month · planned price</span></p><ul>{['A personalized, ready-to-use monthly kit','A simple family challenge','A thoughtful letter delivered by mail'].map(item=><li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={check}/></svg>{item}</li>)}</ul><p class="club-notice">Enrollment isn’t open yet. We’re finishing the printed mailer, subscription billing and member access before taking payments.</p><a class="club-button" href="/resources" data-cta="club-final-resources">Explore our free resources <span aria-hidden="true">→</span></a></div></section>
    <footer class="club-footer"><a href="/">Organized Mom Collective</a><span>© {new Date().getFullYear()} Organized Mom Collective</span><a href="/support">Questions? Contact us</a></footer>
  </div>
  <style>
    .club{--ink:#545454;--sage:#e7ece5;--ivory:#FBF7F1;--rule:#dfded8;color:var(--ink);font-family:Montserrat,Arial,sans-serif;line-height:1.65}
    .club h1,.club h2,.club h3,.club-serif-note,.club-paper strong,.club-sample-sheet h3{font-family:Georgia,serif;font-weight:400;line-height:1.16;letter-spacing:-.025em}
    .club h1{font-size:clamp(2.4rem,4.3vw,4.6rem)}.club h2{font-size:clamp(2rem,3.2vw,3.25rem)}.club h3{font-size:1.5rem}.club p{margin:0}.club p+p{margin-top:1rem}.club-eyebrow{font-size:.73rem!important;text-transform:uppercase;letter-spacing:.17em;font-weight:700}.club-header{max-width:1440px;margin:auto;padding:18px clamp(20px,4vw,60px);display:flex;align-items:center;justify-content:space-between}.club-header img{width:52px;height:52px;object-fit:contain}.club-header-link,.club-text-link{color:var(--ink);font-weight:700;text-decoration:underline;text-underline-offset:5px}.club-hero,.club-surface{margin:0 clamp(16px,2.4vw,36px);background:#f1f2f2}.club-hero{min-height:630px;display:grid;grid-template-columns:1fr 1fr;align-items:center;overflow:hidden}.club-hero-copy{max-width:720px;padding:clamp(36px,5.5vw,90px);z-index:1}.club-hero h1{margin:20px 0 24px}.club-hero h1 em{font-style:normal;color:#667e69}.club-lede{font-size:1.25rem;line-height:1.5;font-weight:600;margin-bottom:14px!important}.club-hero-action{margin-top:30px}.club-hero-action p{font-size:.82rem;margin-top:13px}.club-button{display:inline-flex;align-items:center;justify-content:center;gap:20px;min-height:55px;padding:14px 26px;background:#545454;color:white;text-decoration:none;font-weight:700;font-size:.94rem;transition:background .2s}.club-button:hover{background:#344b3b;color:white}.club-hero-art{min-height:560px;position:relative;background:#e7ece5;display:flex;justify-content:center;align-items:center;overflow:hidden}.club-envelope-back{position:absolute;width:70%;height:43%;top:42%;background:#e9e0d0;transform:rotate(-9deg);box-shadow:12px 22px 28px #6662}.club-envelope-front{position:absolute;width:74%;height:28%;top:61%;background:linear-gradient(150deg,#eee5d8 50%,#d5c5b8 50%);transform:rotate(-9deg);box-shadow:7px 15px 19px #6662}.club-paper{position:absolute;background:#fffefa;width:57%;height:63%;top:15%;padding:28px;box-shadow:7px 15px 25px #6662}.club-paper-front{transform:rotate(5deg);display:flex;flex-direction:column;gap:20px}.club-paper-front small,.club-paper-front span{font-size:clamp(.55rem,1vw,.77rem);letter-spacing:.1em}.club-paper-front strong{font-size:clamp(1.25rem,2.2vw,2.5rem)}.club-paper-front p{font-family:Georgia,serif;font-size:clamp(.85rem,1.25vw,1.2rem)}.club-paper-front span{margin-top:auto}.club-paper-rear{transform:translate(-12%,-8%) rotate(-14deg);background:#d4dfc4}.club-paper-rear span{font-size:.7rem;letter-spacing:.16em}.club-paper-rear div{height:1px;background:#929e88;margin-top:28px}.club-narrow{max-width:780px;margin:auto;padding:110px 24px}.club-problem h2,.club-faq h2{margin:16px 0 30px}.club-problem>p:not(.club-eyebrow){font-size:1.13rem;line-height:1.8}.club-serif-note{font-size:1.6rem!important;margin-top:35px!important;color:#657f66}.club-center{text-align:center;max-width:780px;margin:0 auto 50px}.club-center h2{margin:15px 0 18px}.club-center>p:last-child{font-size:1.06rem}.club-contrast,.club-example,.club-calendar,.club-reassurance{padding:clamp(42px,6vw,94px)}.club-comparison{display:grid;grid-template-columns:1fr 1fr;gap:18px;max-width:950px;margin:auto}.club-comparison>div{padding:36px;background:#fff}.club-comparison>div:last-child{background:#e7ece5}.club-comparison ul{padding-left:20px;margin:22px 0 0}.club-comparison li{padding:7px 0}.club-section{padding:110px 24px;max-width:1100px;margin:auto}.club-included{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.club-included-item{border-top:2px solid #d5c5b8;padding-top:22px}.club-number{font-size:.78rem;font-weight:700;color:#718775}.club-included h3{margin:14px 0}.club-example{display:grid;grid-template-columns:1fr .82fr;align-items:center;gap:clamp(30px,6vw,100px);background:#fbf7f1}.club-example h2{margin:14px 0 22px}.club-rule-list{margin:28px 0}.club-rule-list p{border-top:1px solid var(--rule);padding:15px 0;display:grid;grid-template-columns:130px 1fr;gap:16px;font-size:.94rem}.club-rule-list p:last-child{border-bottom:1px solid var(--rule)}.club-footnote{font-size:.8rem;color:#777}.club-sample-sheet{background:#fff;box-shadow:12px 18px 35px #6552;padding:clamp(25px,4vw,55px);transform:rotate(2deg)}.club-sample-sheet h3{font-size:2.2rem;margin:24px 0 12px}.club-sample-sheet>p:nth-of-type(2){font-size:.9rem;margin-bottom:26px}.club-sample-row{display:flex;gap:16px;padding:18px 0;border-top:1px solid var(--rule)}.club-sample-row>span{font-size:1.3rem;color:#768e75}.club-sample-row div{display:grid}.club-sample-row small{color:#777}.club-sample-bottom{border-top:1px solid var(--rule);margin-top:20px;padding-top:18px;font-size:.65rem;letter-spacing:.13em}.club-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:25px}.club-step{border-top:1px solid var(--rule);padding-top:24px}.club-step span{font-size:1.15rem;color:#718775}.club-step h3{font-size:1.35rem;margin:18px 0 10px}.club-calendar{display:grid;grid-template-columns:.65fr 1fr;gap:clamp(35px,7vw,130px);align-items:center;background:#e7ece5}.club-calendar img{max-height:480px;width:100%;object-fit:contain}.club-calendar h2{margin:16px 0 25px}.club-calendar .club-text-link,.club-story .club-text-link{display:inline-block;margin-top:20px}.club-story{display:grid;grid-template-columns:.85fr 1fr;gap:clamp(30px,6vw,90px);align-items:center}.club-story-photo img{width:100%;height:auto;aspect-ratio:1;object-fit:cover}.club-story h2{margin:16px 0 24px}.club-benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:30px}.club-benefits>div{border-top:1px solid #a9baaa;padding-top:20px}.club-benefits h3{font-size:1.25rem;margin-bottom:12px}.club-faq details{border-bottom:1px solid var(--rule)}.club-faq summary{cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 0;font-weight:650;list-style:none}.club-faq summary::-webkit-details-marker{display:none}.club-faq details[open] summary span{transform:rotate(45deg)}.club-faq details p{padding:0 30px 24px 0}.club-final{margin:0 clamp(16px,2.4vw,36px);background:#e7ece5;text-align:center;padding:95px 24px}.club-final>h2{max-width:830px;margin:18px auto 23px}.club-final-offer{max-width:470px;margin:44px auto 0;background:white;padding:35px;text-align:left}.club-price{font-size:3rem;font-family:Georgia,serif}.club-price span{font:400 .85rem Montserrat,Arial,sans-serif}.club-final-offer ul{list-style:none;padding:0;margin:20px 0}.club-final-offer li{display:flex;gap:10px;align-items:center;padding:7px 0}.club-final-offer li svg{width:20px;height:20px;color:#657f66;flex-shrink:0}.club-notice{font-size:.86rem;line-height:1.6;margin:20px 0!important}.club-final-offer .club-button{width:100%;text-align:center}.club-footer{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:35px clamp(20px,4vw,60px);font-size:.82rem}.club-footer a{color:inherit}
    @media(max-width:800px){.club-hero{grid-template-columns:1fr}.club-hero-copy{padding:45px 28px}.club-hero-art{min-height:390px}.club-paper{padding:22px}.club-paper-front{gap:12px}.club-hero-action .club-button{width:100%}.club-comparison,.club-example,.club-calendar,.club-story{grid-template-columns:1fr}.club-included,.club-steps{grid-template-columns:1fr 1fr}.club-benefits{grid-template-columns:1fr 1fr}.club-example,.club-calendar,.club-reassurance{padding:44px 24px}.club-story-photo{max-width:520px}.club-calendar img{max-height:320px}.club-narrow,.club-section{padding-top:75px;padding-bottom:75px}}
    @media(max-width:520px){.club h1{font-size:2.45rem}.club h2{font-size:2.15rem}.club-included,.club-steps{grid-template-columns:1fr}.club-included{gap:22px}.club-comparison>div{padding:25px}.club-comparison{grid-template-columns:1fr}.club-rule-list p{grid-template-columns:1fr;gap:4px}.club-benefits{grid-template-columns:1fr 1fr;gap:18px}.club-benefits h3{font-size:1.1rem}.club-final-offer{padding:24px}.club-footer{flex-direction:column}.club-sample-sheet{transform:none}}
    .club-photo-story{max-width:1100px;margin:0 auto 95px;padding:0 24px;display:grid;grid-template-columns:1.12fr .88fr;gap:clamp(30px,5vw,75px);align-items:center}
    .club-photo-story-image,.club-team-photo,.club-rhythm-photo{margin:0;overflow:hidden}
    .club-photo-story-image img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;object-position:center}

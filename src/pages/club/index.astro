.club .lime-arrow{color:var(--club-lime);font-weight:800;margin-left:3px}
.club .lime-check{
 display:inline-flex;align-items:center;justify-content:center;
 width:22px;height:22px;margin-right:7px;
 border-radius:50%;background:var(--club-lime);
 color:#34513d;font-style:normal;font-weight:800;line-height:1;
 vertical-align:middle;
}
.club .lime-highlight{
 background:linear-gradient(transparent 68%,var(--club-lime) 68%,var(--club-lime) 87%,transparent 87%);
 box-decoration-break:clone;-webkit-box-decoration-break:clone;
}

/* A stronger lime focal point, with restrained product labels. */
.club .hero-actions .primary{
 background:var(--club-lime);
 color:#303831!important;
}
.club .hero-actions .primary:hover,
.club .hero-actions .primary:focus-visible{background:#a9e991;color:#303831!important}
.club .hero-actions .primary .lime-arrow{color:#303831}
.club .story-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.club .ready-label{
 flex-shrink:0;display:inline-block;
 padding:5px 8px;
 background:var(--club-lime);
 color:#34513d;
 font-size:.59rem;
 font-weight:800;
 letter-spacing:.06em;
 line-height:1.2;
 border-radius:3px;
}

/* Dusty-rose editorial accents: warmer than forest green, without changing
   printable artwork, primary actions, or the Club's fresh-lime signals. */
.club{--club-rose:#b77b82;--club-rose-ink:#955b63}
.club .eyebrow,
.club .story-month,
.club .feature-grid article > span,
.club .story-card a{color:var(--club-rose-ink)}
.club .hero h1 em,
.club .pain h2 em,
.club .tangible h2 em,
.club .club-demo-heading h2 em,
.club .offer-copy h2 em{color:var(--club-rose-ink)}
.club .feature-grid article,
.club .step-grid article{border-top-color:var(--club-rose)}
.club .story-card{border-top:3px solid var(--club-rose)}
.club .hero-rating{display:flex;flex-wrap:wrap;align-items:center;gap:8px 13px;margin-top:14px}
.club .hero-rating img{width:clamp(130px,12.67vw,159px);height:auto;display:block}
.club .hero-rating span{font-size:.69rem;color:#6e6461}
@media(max-width:700px){.club .hero .hero-rating{order:3;margin:14px 0 0;justify-content:center}.club .hero .hero-rating img{width:140px}.club .hero .hero-rating span{font-size:.67rem}.club .hero .supporting{order:4}}
.club .summer-day-example{display:block;width:100%;height:auto;max-width:500px;margin-inline:auto;object-fit:contain;filter:drop-shadow(0 14px 25px rgba(77,69,68,.12))}

/* What comes in the mail: tangible product image + four benefits in a 2x2 grid. */
.club .features{background:#fff}
.club .features-layout{
 display:grid;

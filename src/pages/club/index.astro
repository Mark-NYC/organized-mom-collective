kground:#fff;border:1px solid #cbd5cc;border-radius:9px;padding:12px 11px;font:inherit;font-size:.92rem;color:var(--ink)}.form input:focus,.form select:focus{outline:2px solid #7da88b;outline-offset:1px}.children-head{display:flex;justify-content:space-between;align-items:center;margin:17px 0 7px;font-size:.85rem}.children-head span{font-size:.74rem;color:var(--muted)}.child-row{display:grid;grid-template-columns:1fr 112px 28px;align-items:end;gap:10px;margin-bottom:8px}.child-row .remove{border:0;background:none;font-size:1.5rem;line-height:44px;cursor:pointer;color:#66736a}.add,.text-button{border:0;background:none;padding:5px 0;color:var(--forest);font-size:.83rem;font-weight:750;cursor:pointer}.add:disabled{opacity:.4}.primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:15px 24px;border:0;border-radius:10px;background:var(--forest);color:#fff!important;text-align:center;text-decoration:none;font-size:.93rem;font-weight:800;cursor:pointer;transition:background .15s}.primary:hover{background:#163b2c}.form-submit{width:100%;margin-top:17px}.form small,.price-card small{display:block;margin-top:10px;text-align:center;color:var(--muted);font-size:.72rem}.demo-side{padding-top:30px;position:relative}.sample-stamp{text-align:center;letter-spacing:.17em;color:var(--sage);font-size:.69rem;font-weight:750;margin-bottom:20px}.sheet-outer{background:#e5e7db;border-radius:22px;padding:27px;box-shadow:0 24px 50px rgba(51,66,49,.09);transform:rotate(1deg)}.sheet{background:#fffefa;box-shadow:0 8px 20px rgba(45,45,35,.09);border:1px solid #e8e0d1;padding:clamp(20px,3.3vw,46px);min-height:600px}.paper-top{display:flex;justify-content:space-between;color:var(--sage);font-size:.65rem;letter-spacing:.1em;font-weight:750}.paper-top span{font-size:1.5rem}.sheet h2{font-family:Georgia,serif;font-size:clamp(2.2rem,3.5vw,3.8rem);margin:35px 0 12px;color:#324e3d}.sheet h2 em{color:#7e9878}.sheet-lede{font-family:Georgia,serif;font-size:1.02rem;color:#69
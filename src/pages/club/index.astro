---
/**
 * Organized Family Club marketing /club homepage.
 * Current physical-first $5/mo strategy (Oct 24 2026). Enrollment is not live.
 * Monthly physical prototype previews are separate unlisted routes with the shared
 * Kits / Family sample-profile navigation.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import { BRAND_NAME } from '../../config';
import { monthColors } from '../../theme';

const ready = [
  {
    month: 'November', year: '2026', number: '01', color: monthColors[10].hex,
    eyebrow: 'SHARE THE LOAD', title: 'Our Family Ownership Plan',
    description: 'A prepared handoff for real responsibilities. Each person knows what they own, when it happens and what finished looks like.',
    outcome: 'Fewer jobs that Mom has to plan, assign and follow up on.',
    url: '/club/worksheet-generator/', link: 'Explore the November plan',
    kind: 'ownership',
  },
  {
    month: 'December', year: '2026', number: '02', color: monthColors[11].hex,
    eyebrow: 'KIDS TAKE THE LEAD', title: 'Your Christmas Mission',
    description: 'A kindness mission addressed to the kids, with two ready-to-use Christmas cards. They choose someone to encourage and take the lead.',
    outcome: 'A meaningful family moment Mom doesn’t need to invent.',
    url: '/club/december-preview/', link: 'Explore the December mission',
    kind: 'christmas',
  },
  {
    month: 'January', year: '2027', number: '03', color: monthColors[0].hex,
    eyebrow: 'LESS REMINDING', title: 'Our Family Habit Cards',
    description: 'Simple, individual cues that connect a new responsibility to something your child already does. Put the card where the next action happens.',
    outcome: 'More independence without another chart for Mom to manage.',
    url: '/preview/january-habit-cards', link: 'Explore the January cards',
    kind: 'habits',
  },
] as const;

const upcoming = [
  ['February','Family Connection Made Easy','A realistic way to make room for meaningful time together.'],
  ['March','Spring Cleaning as a Family','One manageable project, with age-appropriate parts for everyone.'],
  ['April','Dinner Isn’t Just Mom’s Job','Clear ownership of preparation, meals and cleanup.'],
  ['May','Our Family Summer Rhythm','A repeatable day rhythm kids can follow when school structure disappears.'],
  ['June','My Family’s Snack Station','A picture-led snack station lets kids choose approved snacks and clean up without Mom managing every request.'],
  ['July','What Can I Do Right Now?','Three tiers of specific ideas kids can choose and start independently.'],
  ['August','Back-to-School Readiness','A shared plan for getting ready without Mom carrying every detail.'],
  ['September','The Family Weekly Rhythm','A simple way everyone stays on the same page.'],
  ['October','A Home That Runs Together','Revisit the systems that help everyone own their part.'],
] as const;

const faqs = [
  ['What exactly comes in the mail?', 'The planned subscription includes one personalized family organization tool printed on a premium 8.5 × 11 sheet, plus a short note from Megan integrated into the mailing. Each month tackles a different everyday challenge. Exact print specifications are still being tested.'],
  ['Will I have to build the tool myself?', 'That is the problem we want to eliminate. The goal is to prepare the tool from your family information before mailing. You can review it and make small changes when needed. The early prototypes still demonstrate parts of that process; automated personalization is being validated.'],
  ['What happens online?', 'The digital companion lets you see the month’s tool and, where supported, adjust or reprint it. The printable is the product—not another online program to complete.'],
  ['How does this differ from the wall calendar?', 'The wall calendar shows schedules, meals and the week’s plan. The Club offers one ready-to-use tool each month to help the family share responsibility for making that plan happen. You can use either on its own.'],
  ['Do I have to start in November or complete the months in order?', 'No. Each month is meant to be useful on its own. There are no lessons to catch up on and no required progress tracking.'],
  ['Can I sign up now?', 'Not yet. We are testing the printed product, mail fulfillment and subscription economics before opening enrollment. The $5 monthly price is planned, not an active checkout offer.'],
] as const;
---
<PublicLayout
  fullTitle={`Organized Family Club · ${BRAND_NAME}`}
  description="One useful personalized family organization tool, prepared for your household and delivered to your mailbox each month. Planned at $5/month."
  indexable={false}
  chrome={false}
  width="full"
  tracking={false}
>
<div class="ofc">
  <header class="ofc-nav">
    <a href="/" aria-label="Organized Mom Collective home" class="ofc-logo"><img src="/brand/omc-badge.png" alt="" width="52" height="52" /><span>Organized Family Club</span></a>
    <nav aria-label="Page navigation"><a href="#months">The months</a><a href="#how">How it works</a><a href="#faq">Questions</a><a href="/club/dashboard" class="ofc-member-link">Member kits ↗</a></nav>
  </header>

  <section class="ofc-hero" aria-labelledby="ofc-heading">
    <div class="ofc-hero-copy">
      <p class="ofc-eyebrow">THE ORGANIZED FAMILY CLUB · A NEW MONTHLY MAIL SUBSCRIPTION</p>
      <h1 id="ofc-heading">Less for Mom to manage. <em>More for the family to own.</em></h1>
      <p class="ofc-lead">One useful tool for your family, prepared for you and delivered to your door every month.</p>
      <p>No big binders. No homework. No new system for you to run. Just one thoughtfully prepared resource that helps everyone play a part.</p>
      <div class="ofc-hero-cta">
        <a href="#months" class="ofc-button">See the first three months <span aria-hidden="true">→</span></a>
        <p><strong>$5 / month planned</strong><span> · Enrollment not yet open</span></p>
      </div>
    </div>
    <div class="ofc-hero-art" aria-label="Illustration of a flat envelope holding personalized family planning pages">
      <div class="ofc-postmark">ONE FAMILY. ONE USEFUL TOOL.</div>
      <div class="ofc-mail-back"></div>
      <div class="ofc-paper ofc-paper-back"><span>JANUARY · OUR FAMILY HABITS</span><i></i><i></i><i></i></div>
      <div class="ofc-paper ofc-paper-front"><small>ORGANIZED FAMILY CLUB · NOVEMBER</small><strong>Our family.<br /><em>Our team.</em></strong><div class="ofc-paper-line">ONE JOB · ONE OWNER</div><div class="ofc-paper-line">A READY-TO-USE PLAN</div><div class="ofc-paper-line">MADE FOR YOUR FAMILY</div><span>PREPARED FOR YOU</span></div>
      <div class="ofc-envelope"><span>GOOD THINGS COME IN THE MAIL.</span></div>
    </div>
  </section>

  <section class="ofc-intro" aria-labelledby="ofc-problem">
    <p class="ofc-eyebrow">A DIFFERENT KIND OF FAMILY ORGANIZATION</p>
    <h2 id="ofc-problem">Mom shouldn’t have to manage the <em>organization system itself.</em></h2>
    <p>Finding the charts, writing the instructions, assigning the jobs, remembering to remind everyone—it all becomes one more responsibility.</p>
    <p>We prepare something useful before it ever reaches your door. Your family can start with a plan instead of asking Mom to create one.</p>
  </section>

  <section class="ofc-months" id="months" aria-labelledby="ofc-months-heading">
    <div class="ofc-section-head">
      <p class="ofc-eyebrow">THE FIRST THREE MONTHS</p>
      <h2 id="ofc-months-heading">Different challenges. <em>One simple idea.</em></h2>
      <p>Each month solves a real problem with one practical printed tool. These three designs are available to explore while we test the subscription.</p>
    </div>
    <div class="ofc-month-grid">
      {ready.map((m) => (
        <article class="ofc-month" style={`--month-color:${m.color}`}>
          <div class="ofc-month-art">
            <div class="ofc-month-art-meta"><span>{m.month.toUpperCase()} {m.year}</span><span>ORGANIZED FAMILY CLUB</span></div>
            {m.kind === 'ownership' ? (
              <div class="ofc-art-sheet ofc-art-ownership">
                <p>OUR FAMILY <em>OWNERSHIP PLAN</em></p>
                <div><strong>ONE WHOLE JOB</strong><span>ONE CLEAR OWNER</span></div>
                <div><strong>WHEN IT HAPPENS</strong><span>WHAT FINISHED MEANS</span></div>
                <div><strong>EVERYONE HAS A PART</strong><span>WITHOUT MORE REMINDING</span></div>
              </div>
            ) : m.kind === 'christmas' ? (
              <div class="ofc-art-sheet ofc-art-christmas">
                <p>YOUR CHRISTMAS <em>MISSION</em></p>
                <ol><li>Choose someone to surprise</li><li>Make a card</li><li>Deliver your kindness</li></ol>
                <div class="ofc-christmas-note">A little Christmas kindness ♡</div>
              </div>
            ) : (
              <div class="ofc-art-sheet ofc-art-habits">
                <p>OUR FAMILY <em>HABITS</em></p>
                <div class="ofc-mini-card"><span>WHEN THIS HAPPENS</span><strong>After breakfast…</strong><span>HERE’S WHAT I DO NEXT</span><strong>I put my dishes away.</strong></div>
                <div class="ofc-mini-card"><span>WHEN THIS HAPPENS</span><strong>After I get dressed…</strong><span>HERE’S WHAT I DO NEXT</span><strong>I put my pajamas away.</strong></div>
              </div>
            )}
            <div class="ofc-art-caption">ILLUSTRATIVE PRODUCT PREVIEW</div>
          </div>
          <div class="ofc-month-copy">
            <p class="ofc-month-eyebrow">{m.eyebrow}</p>
            <h3>{m.title}</h3>
            <p>{m.description}</p>
            <p class="ofc-outcome">{m.outcome}</p>
            <a href={m.url} class="ofc-text-link" data-cta={`club-preview-${m.kind}`}>{m.link} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
    <p class="ofc-disclaimer">Explore the working previews using sample households. They are product prototypes, not evidence that an order has been mailed or a subscription is available.</p>
  </section>

  <section class="ofc-method" id="how" aria-labelledby="ofc-how-heading">
    <div class="ofc-method-copy">
      <p class="ofc-eyebrow">A PHYSICAL TOOL FIRST</p>
      <h2 id="ofc-how-heading">Prepared for your family. <em>Already done.</em></h2>
      <div class="ofc-method-steps">
        <div><span>01</span><div><h3>Tell us about your family once.</h3><p>Names, children’s ages, and a few details that actually make the tools more useful.</p></div></div>
        <div><span>02</span><div><h3>We prepare one useful tool.</h3><p>A clear, practical resource for that month’s real-life challenge—not a blank worksheet to finish yourself.</p></div></div>
        <div><span>03</span><div><h3>It arrives ready to use.</h3><p>The planned subscription brings one premium printed tool to your mailbox, with a short note from Megan.</p></div></div>
        <div><span>04</span><div><h3>Adjust it only when you want.</h3><p>Your digital version can help you make small changes or reprint. It isn’t another assignment.</p></div></div>
      </div>
      <p class="ofc-testing">We’re currently validating the printing, personalization and mailing process. Fully automated production is the goal, not a capability we’re claiming is live today.</p>
    </div>
    <figure class="ofc-method-photo"><img src="/images/club/club-dad-son-dishes.webp" alt="A father helping his young son wash dishes together at the kitchen sink" loading="lazy" width="1200" height="800" /><figcaption>A home where everyone knows the plan and plays a part.</figcaption></figure>
  </section>

  <section class="ofc-next" aria-labelledby="ofc-next-heading">
    <div class="ofc-section-head"><p class="ofc-eyebrow">A LOOK AT WHAT’S AHEAD</p><h2 id="ofc-next-heading">One small improvement <em>each month.</em></h2><p>No catch-up. No coursework. Join in any month and use what helps your family right now.</p></div>
    <div class="ofc-next-grid">{upcoming.map(([month,title,description],i)=><div class="ofc-next-item"><span>{String(i+4).padStart(2,'0')} · {month}</span><div><h3>{title}</h3><p>{description}</p>{month === "February" && <a href="/club/february-preview/" class="ofc-text-link">Preview February’s connection cards →</a>}{month === "March" && <a href="/club/march-preview/" class="ofc-text-link">Preview March’s spring prep plan →</a>}{month === "April" && <a href="/club/april-preview/" class="ofc-text-link">Preview April’s dinner captain plan →</a>}{month === "May" && <a href="/club/may-preview/" class="ofc-text-link">Preview May’s illustrated summer rhythm →</a>}{month === "June" && <a href="/club/june-preview/" class="ofc-text-link">Preview June’s snack station →</a>}{month === "July" && <a href="/club/july-preview/" class="ofc-text-link">Preview July’s activity board →</a>}</div></div>)}</div>
    <p class="ofc-disclaimer">Future topics are a working roadmap, not finalized mailer designs. We’ll refine them based on what actually helps families.</p>
  </section>

  <section class="ofc-calendar" aria-labelledby="ofc-calendar-heading">
    <img src="/images/site/calendar-cutout-720.webp" width="720" height="1058" loading="lazy" alt="Organized Mom Collective weekly wall calendar" />
    <div><p class="ofc-eyebrow">TWO PLACES. ONE FAMILY SYSTEM.</p><h2 id="ofc-calendar-heading">The calendar shows the plan. <em>The Club helps the family own it.</em></h2><p><strong>The wall calendar</strong> helps everyone see the week—appointments, meals, and family plans.</p><p><strong>The Club</strong> helps everyone share the doing with a ready-to-use, personalized resource each month.</p><p>They work beautifully together. Neither requires the other.</p><a href="/calendar" class="ofc-text-link">Explore the wall calendar →</a></div>
  </section>

  <section class="ofc-family" aria-labelledby="ofc-family-heading">
    <img src="/images/site/mark-megan-family-story-1200.webp" width="1200" height="1200" alt="The Organized Mom Collective founding family outdoors" loading="lazy" />
    <div><p class="ofc-eyebrow">FROM OUR FAMILY TO YOURS</p><h2 id="ofc-family-heading">More hands helping. <em>Less to carry.</em></h2><p>We started making family organization tools because the work of remembering, planning, and following up kept falling on one person.</p><p>Mark builds the systems. Megan makes sure they are realistic for busy families. Our aim is to make the next helpful step ready before Mom needs to figure it out.</p><p><strong>Organized moms raise organized families.</strong> Not because they do it all, but because everyone learns to carry their part.</p><a href="/our-story" class="ofc-text-link">Read our story →</a></div>
  </section>

  <section class="ofc-faq" id="faq" aria-labelledby="ofc-faq-heading"><p class="ofc-eyebrow">GOOD QUESTIONS</p><h2 id="ofc-faq-heading">Before you join</h2><div>{faqs.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>

  <section class="ofc-close" aria-labelledby="ofc-close-heading">
    <p class="ofc-eyebrow">ORGANIZED FAMILY CLUB</p>
    <h2 id="ofc-close-heading">One useful tool. <em>Every month.</em></h2>
    <p class="ofc-close-lead">Prepared for your family and delivered to your door.</p>
    <p class="ofc-price">$5 <span>/ month · planned</span></p>
    <p class="ofc-notice">Enrollment isn’t open yet. We’re validating print quality, personalized fulfillment, billing, and the final mailing cost before taking subscriptions.</p>
    <div class="ofc-close-actions"><a href="#months" class="ofc-button">Explore the working monthly designs →</a><a class="ofc-text-link" href="/support">Ask us a question →</a></div>
  </section>

  <footer class="ofc-footer"><a href="/">Organized Mom Collective</a><span>© {new Date().getFullYear()} Organized Mom Collective</span><a href="/support">Support</a></footer>
</div>
<style>
.ofc{--ink:#454545;--soft:#686868;--line:#d8d9d6;color:var(--ink);font-family:'Montserrat Variable',Montserrat,Arial,sans-serif;line-height:1.6}
.ofc *{box-sizing:border-box}.ofc p{margin:0}.ofc a{color:inherit}.ofc h1,.ofc h2,.ofc h3{font-family:Georgia,serif;font-weight:400;letter-spacing:-.025em;line-height:1.12;margin:0}
.ofc h1{font-size:clamp(2.5rem,5vw,5.1rem)}.ofc h2{font-size:clamp(2.1rem,3.65vw,3.85rem)}.ofc h3{font-size:clamp(1.45rem,2vw,1.9rem)}.ofc h1 em,.ofc h2 em{font-weight:700;font-style:italic;color:#527468}
.ofc-eyebrow{font-size:.69rem;font-weight:700;letter-spacing:.17em;line-height:1.4}.ofc-text-link{text-decoration:underline;text-underline-offset:5px;font-size:.92rem;font-weight:650}.ofc-text-link:hover{color:#527468}
.ofc-nav{max-width:1450px;margin:auto;padding:18px clamp(20px,4vw,58px);display:flex;align-items:center;justify-content:space-between;gap:20px}.ofc-logo{display:flex;gap:13px;align-items:center;text-decoration:none;font-family:Georgia,serif;font-size:1.12rem}.ofc-logo img{width:47px;height:47px;object-fit:contain}.ofc-nav nav{display:flex;align-items:center;gap:23px;flex-wrap:wrap}.ofc-nav nav a{font-size:.81rem;text-decoration:none}.ofc-nav nav a:hover{text-decoration:underline}.ofc-member-link{border-bottom:1px solid var(--ink);padding-bottom:3px}
.ofc-hero{margin:0 clamp(14px,2.5vw,36px);min-height:645px;display:grid;grid-template-columns:1fr 1fr;background:#f1f2f2;overflow:hidden}.ofc-hero-copy{padding:clamp(38px,5.2vw,84px);align-self:center;max-width:780px}.ofc-hero h1{margin:18px 0 25px}.ofc-lead{font-family:Georgia,serif;font-size:clamp(1.24rem,1.65vw,1.65rem);line-height:1.4!important;margin:0 0 19px!important;color:#343434}.ofc-hero-copy>p:not(.ofc-eyebrow):not(.ofc-lead){font-size:1rem}.ofc-hero-cta{margin-top:32px;display:flex;align-items:center;gap:20px;flex-wrap:wrap}.ofc-hero-cta p{font-size:.82rem}.ofc-hero-cta span{color:#676767}
.ofc-button{display:inline-flex;justify-content:center;align-items:center;gap:16px;min-height:52px;background:#454545;color:#fff!important;text-decoration:none;padding:14px 24px;font-size:.83rem;font-weight:700;letter-spacing:.025em}.ofc-button:hover{background:#303030}
.ofc-hero-art{position:relative;min-height:580px;background:#e7ece5;display:grid;place-items:center;overflow:hidden}.ofc-postmark{position:absolute;top:25px;left:30px;font-size:.63rem;letter-spacing:.16em;font-weight:700}.ofc-mail-back{width:72%;height:50%;background:#dfd1bc;position:absolute;top:39%;transform:rotate(-8deg);box-shadow:10px 17px 30px #41414124}.ofc-paper{position:absolute;width:57%;height:67%;top:13%;background:#fff;padding:clamp(18px,3vw,38px);box-shadow:7px 16px 28px #0003;display:flex;flex-direction:column;gap:14px}.ofc-paper-back{background:#cddde1;transform:translate(-12%,-5%) rotate(-12deg)}.ofc-paper-back span,.ofc-paper-front small,.ofc-paper-front>span{font-size:clamp(.55rem,.75vw,.76rem);letter-spacing:.13em}.ofc-paper-back i{display:block;height:1px;background:#849baa;margin-top:23px}.ofc-paper-front{transform:rotate(3deg)}.ofc-paper-front strong{font:400 clamp(1.15rem,2.3vw,2.5rem)/1.1 Georgia,serif;margin:13px 0}.ofc-paper-front strong em{color:#527468}.ofc-paper-line{border-top:1px solid #c7d1ca;padding:12px 0 0;font-size:clamp(.45rem,.7vw,.65rem);letter-spacing:.13em}.ofc-paper-front>span{margin-top:auto}.ofc-envelope{position:absolute;bottom:7%;left:15%;height:24%;width:73%;background:#f3e9d8;transform:rotate(-8deg);box-shadow:9px 16px 21px #0002;display:flex;align-items:end;padding:20px;font-size:.65rem;letter-spacing:.12em;font-weight:700}
.ofc-intro{max-width:800px;margin:auto;padding:105px 25px}.ofc-intro h2{margin:17px 0 28px}.ofc-intro>p:not(.ofc-eyebrow){font-size:1.1rem;line-height:1.8;margin-bottom:15px}.ofc-section-head{max-width:830px;margin:0 auto 48px;text-align:center}.ofc-section-head h2{margin:15px 0 22px}.ofc-section-head>p:last-child{font-size:1.07rem;line-height:1.8}
.ofc-months{max-width:1360px;margin:auto;padding:55px 25px 115px;scroll-margin-top:25px}.ofc-month-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.ofc-month{border:1px solid #dcdcdc;min-width:0;background:#fff;display:flex;flex-direction:column}.ofc-month-art{height:410px;position:relative;background:var(--month-color);padding:24px;overflow:hidden}.ofc-month-art-meta{display:flex;justify-content:space-between;gap:10px;font-size:.62rem;font-weight:700;letter-spacing:.13em}.ofc-art-sheet{position:absolute;top:83px;left:12%;width:76%;height:310px;background:#fff;box-shadow:7px 12px 25px #0002;padding:28px;transform:rotate(-2deg)}.ofc-art-sheet>p{font:400 1.35rem/1.18 Georgia,serif;margin-bottom:26px}.ofc-art-sheet>p em{display:block;font-weight:700;color:#527468}.ofc-art-ownership>div{border-top:1px solid #d7cbbf;display:flex;flex-direction:column;padding:11px 0;gap:5px;font-size:.55rem;letter-spacing:.09em}.ofc-art-ownership>div span{font-size:.5rem}.ofc-art-christmas ol{padding:0 0 0 20px;font:13px/2 Georgia,serif}.ofc-christmas-note{border-top:1px solid #cbdad1;padding-top:20px;margin-top:24px;font:italic 1rem Georgia,serif;color:#527468}.ofc-art-habits{display:flex;flex-direction:column;gap:9px;padding:22px}.ofc-art-habits>p{font-size:1rem;margin:0 0 5px}.ofc-mini-card{display:flex;flex-direction:column;gap:6px;background:#eff5f7;padding:12px 15px;border:1px dashed #a6bfc9}.ofc-mini-card>span{font-size:.48rem;letter-spacing:.1em}.ofc-mini-card>strong{font:italic 1rem Georgia,serif;color:#527384}.ofc-art-caption{position:absolute;bottom:9px;right:22px;font-size:.52rem;letter-spacing:.14em}
.ofc-month-copy{padding:27px 25px 30px;display:flex;flex-direction:column;flex:1}.ofc-month-eyebrow{font-size:.65rem;letter-spacing:.13em;font-weight:700;color:#527468}.ofc-month-copy h3{margin:14px 0 16px}.ofc-month-copy>p:not(.ofc-month-eyebrow){font-size:.93rem;line-height:1.7}.ofc-outcome{margin-top:15px!important;border-top:1px solid #ddd;padding-top:13px;font-family:Georgia,serif;font-style:italic;color:#527468}.ofc-month-copy a{margin-top:auto;padding-top:25px;align-self:flex-start}.ofc-disclaimer{text-align:center;color:#656565;font-size:.79rem;line-height:1.55;max-width:790px;margin:27px auto 0!important}
.ofc-method{margin:0 clamp(14px,2.5vw,36px);padding:clamp(36px,5vw,75px);background:#f7f7f5;display:grid;grid-template-columns:1fr .85fr;gap:clamp(30px,5vw,100px);align-items:center}.ofc-method h2{margin:17px 0 35px}.ofc-method-steps>div{border-top:1px solid #ccc;display:grid;grid-template-columns:45px 1fr;gap:18px;padding:20px 0}.ofc-method-steps>div>span{font:700 italic 1.5rem Georgia,serif;color:#527468}.ofc-method-steps h3{font-size:1.3rem;margin:0 0 8px}.ofc-method-steps p{font-size:.93rem}.ofc-testing{border-top:1px solid #ccc;margin-top:12px!important;padding-top:19px;color:#656565;font-size:.8rem}.ofc-method-photo{margin:0}.ofc-method-photo img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover}.ofc-method-photo figcaption{font:italic 1.2rem Georgia,serif;color:#527468;margin-top:18px}
.ofc-next{max-width:1180px;margin:auto;padding:115px 25px}.ofc-next-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:28px;row-gap:22px}.ofc-next-item{border-top:1px solid #c9d4cf;padding:17px 0;display:grid;gap:9px}.ofc-next-item>span{font-size:.66rem;letter-spacing:.13em;font-weight:700;color:#527468}.ofc-next-item h3{font-size:1.32rem;margin-bottom:8px}.ofc-next-item p{font-size:.85rem;color:#656565}.ofc-next-item a{display:inline-block;margin-top:11px;font-size:.79rem}
.ofc-calendar{margin:0 clamp(14px,2.5vw,36px);padding:clamp(45px,6vw,90px);background:#e7ece5;display:grid;grid-template-columns:.65fr 1fr;gap:clamp(35px,6vw,100px);align-items:center}.ofc-calendar img{width:100%;max-height:500px;object-fit:contain}.ofc-calendar h2{margin:18px 0 30px}.ofc-calendar p:not(.ofc-eyebrow){margin-bottom:15px;font-size:1rem}

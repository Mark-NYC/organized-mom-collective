.ofc h1{font-size:clamp(2.5rem,5vw,5.1rem)}.ofc h2{font-size:clamp(2.1rem,3.65vw,3.85rem)}.ofc h3{font-size:clamp(1.45rem,2vw,1.9rem)}.ofc h1 em,.ofc h2 em{font-weight:700;font-style:italic;color:#527468}

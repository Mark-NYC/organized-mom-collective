.ofc-close{text-align:center;margin:0 clamp(14px,2.5vw,36px);padding:80px 24px;background:#cddde1}.ofc-close h2{margin:15px 0 20px}.ofc-close-lead{font-family:Georgia,serif;font-size:1.35rem}.ofc-price{font:400 3.2rem Georgia,serif;margin:25px 0 7px!important}.ofc-price span{font:400 .9rem Montserrat,Arial,sans-serif}.ofc-notice{font-size:.86rem;line-height:1.7;max-width:580px;margin:0 auto 25px!important}.ofc-close-actions{display:flex;gap:22px;align-items:center;justify-content:center;flex-wrap:wrap}

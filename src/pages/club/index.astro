---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { BRAND_NAME } from '../../config';
const monthIcons = import.meta.glob('../../../assets/icons/ofc/month-icons/*-OFC-icon.png', { eager: true, query: '?url', import: 'default' });
const months = [{"month":"January","title":"Mornings Without the Nagging","responsibility":"Following routines","how":"A ready-made morning or evening plan shows each person what to do next.","url":"/club/january-preview/"},{"month":"February","title":"Connection You Don't Have to Plan","responsibility":"Initiating connection","how":"Four simple invitations help kids take the lead in spending time together.","url":"/club/february-preview/"},{"month":"March","title":"Cleaning Without Managing Everyone","responsibility":"Finishing a job","how":"Each person gets a clear cleaning job, supplies, steps, and a definition of done.","url":"/club/march-preview/"},{"month":"April","title":"Dinner Isn't All on You","responsibility":"Sharing meal ownership","how":"A prepared dinner plan gives family members roles from gathering ingredients through cleanup.","url":"/club/april-preview/"},{"month":"May","title":"Summer Days Without Constant Questions","responsibility":"Managing their day","how":"A flexible daily rhythm and activity menu help kids choose what comes next.","url":"/club/may-preview/"},{"month":"June","title":"Less Screen-Time Negotiating","responsibility":"Respecting shared boundaries","how":"Clear expectations for screens, responsibilities, and free time help everyone follow the same plan.","url":"/club/june-preview/"},{"month":"July","title":"No More Packing for Everyone","responsibility":"Preparing independently","how":"Personal packing lists show each person what to pack, check, and put away.","url":"/club/july-preview/"},{"month":"August","title":"Back to School Without the Scramble","responsibility":"Taking initiative","how":"A personalized countdown gives everyone their own school-ready responsibilities.","url":"/club/august-preview/"},{"month":"September","title":"Stop Being the Family's Calendar","responsibility":"Planning together","how":"A short weekly family meeting helps everyone know the schedule and own their commitments.","url":"/club/september-preview/"},{"month":"October","title":"Get Ahead of the Last-Minute Scramble","responsibility":"Noticing what is needed","how":"Seasonal checks assign family members the job of spotting and handling needs early.","url":"/club/october-preview/"},{"month":"November","title":"Stop Being Everyone's Reminder","responsibility":"Owning a whole responsibility","how":"Each ready family member gets a job with a clear owner, timing, and finish line.","url":"/club/november-preview/"},{"month":"December","title":"Christmas Without Doing It All","responsibility":"Contributing to family traditions","how":"A prepared holiday plan shares the work of gifts, traditions, and celebrations.","url":"/club/december-preview/"}].map(m => ({...m, icon: monthIcons[`../../../assets/icons/ofc/month-icons/${m.month}-OFC-icon.png`]}));

const faqs = [
 ['Will this be another job for me?', 'No new system to design. We suggest the plan, the assignments, and the next steps. You will introduce the tool to your family, but you do not have to build it yourself.'],
 ['What comes in the mail?', 'The planned membership includes one personalized 8.5 × 11 family tool per month, with a short note from Megan and a digital version. Printing and mailing are still being tested.'],
 ['Is this the actual Club product?', 'This Daily Reset is a free interactive example of how we can prepare a family plan for you. The monthly Club tools are separate resources, and the example is not a promised mailing.'],
 ['What ages does this work for?', 'Assignments adjust by age, from small jobs younger children can do with help to more independent responsibilities for older children.'],
 ['Do I need to own your wall calendar?', 'No. The Club works on its own. The calendar helps you see the schedule; the Club helps everyone take responsibility.'],
 ['Can I subscribe now?', 'Enrollment is not open yet. We are testing the printed product, fulfillment, and billing. You can ask about early access.']
];
---
<PublicLayout fullTitle={`Organized Family Club · ${BRAND_NAME}`} description="Help your kids take responsibility without another job for Mom. Try a personalized family Daily Reset in seconds." indexable={false} chrome={false} width="full" tracking={false}>
<div class="club">
<header class="topbar">
 <a class="brand" href="/"><img src="/brand/omc-badge.png" alt="" width="46" height="46" /><span>Organized Family Club</span></a>
 <nav aria-label="Club navigation"><a href="#how">How it works</a><a href="#months">Monthly tools</a><a href="#faq">Questions</a><a class="member" href="/club/dashboard">Member access ↗</a></nav>
</header>
<main>
<section class="hero" id="start">
 <div class="hero-inner">
  <div class="hero-copy">
   <p class="eyebrow">ORGANIZED FAMILY CLUB · MADE FOR YOUR FAMILY</p>
   <h1>Raise kids who take responsibility. <em>Without another job for Mom.</em></h1>
   <p class="promise">We make the plan. Your family makes it happen.</p>
   <p class="supporting">Don't take our word for it. Tell us who's in your family, and see a personalized Daily Reset come together in seconds. No homework, no account.</p>
   <form id="family-form" class="form" autocomplete="off">
    <h2>Let's make your family's plan.</h2>
    <p>Just names and ages. We'll take it from there.</p>
    <div class="name-fields">
     <label>Mom's first name<input name="mom" id="mom" placeholder="Megan" maxlength="40" required /></label>
     <label>Dad's first name<input name="dad" id="dad" placeholder="Mark" maxlength="40" required /></label>
    </div>
    <div class="children-head"><strong>Your kids</strong><span>First names only</span></div>
    <div id="children-fields"></div>
    <button type="button" class="add" id="add-child">+ Add a child</button>
    <button type="submit" class="primary form-submit">Make My Family's Plan <span aria-hidden="true">→</span></button>
    <small>No sign-in. Your family's details stay in this browser.</small>
   </form>
  </div>
  <aside class="demo-side">
   <div class="sample-stamp">A LITTLE MORE OWNERSHIP, EVERY DAY</div>
   <div class="sheet-outer"><div class="sheet" id="hero-sheet">
    <div class="paper-top"><small>ORGANIZED FAMILY CLUB · FAMILY DEMO</small><span>✳</span></div>
    <h2 id="sheet-heading">Our Family's<br/><em>Daily Reset</em></h2>
    <p class="sheet-lede">A few minutes together. A fresh start tomorrow.</p>
    <div class="sheet-rule"></div>
    <div class="sheet-section-label">EVERYONE HAS A PART</div>
    <div id="sheet-assignments" class="sheet-assignments">
      <div class="assignment"><span class="tick"></span><div><b>Emma, 8</b><p>Backpack and shoes in their places</p></div></div>
      <div class="assignment"><span class="tick"></span><div><b>Leo, 5</b><p>Toys and books back on the shelf</p></div></div>
      <div class="assignment"><span class="tick"></span><div><b>Dad</b><p>Clear and wipe the dinner table</p></div></div>
      <div class="assignment"><span class="tick"></span><div><b>Mom</b><p>Get tomorrow's essentials ready</p></div></div>
    </div>
    <div class="sheet-footer">A RESET WE DO TOGETHER <span>♡</span></div>
   </div></div>
   <p class="sample-note" id="sample-label">Example preview. Enter your family to see your own plan.</p>
  </aside>
 </div>
</section>
<section class="result" id="result" hidden aria-live="polite">
 <div class="container result-layout">
  <div><p class="eyebrow">YOUR FAMILY'S PLAN IS READY</p><h2>See? You didn't have to plan a thing.</h2><p>Everyone has a part. Nobody has to guess. That's the kind of preparation we want to do for your family every month.</p><p class="result-emphasis">One useful tool. Already thought through. Already made for your family.</p><div class="result-actions"><a href="#offer" class="primary">See How the Club Works →</a><button class="text-button" id="edit-family" type="button">Edit family details</button><button class="text-button" type="button" id="clear-family">Clear my details</button></div></div>
  <div class="result-card"><span>WHAT YOU JUST EXPERIENCED</span><h3>Mom gives us her family.<br/>We do the thinking.</h3><p>This is a free example, not the mailed September tool. Each month of the Club brings a different ready-made family resource.</p></div>
 </div>
</section>
<section class="benefits container" id="how">
 <p class="eyebrow">A HOME THAT WORKS TOGETHER</p><h2>Less reminding. <em>More taking responsibility.</em></h2>
 <div class="benefit-grid">
  <article><span class="benefit-number">01</span><h3>Raise capable kids.</h3><p>Give your children practical ways to notice what needs doing and follow through.</p></article>
  <article><span class="benefit-number">02</span><h3>Skip the planning.</h3><p>We prepare the assignments, structure, and next steps. You don't start with a blank page.</p></article>
  <article><span class="benefit-number">03</span><h3>Open it. Use it.</h3><p>One personal, practical family tool prepared for your home every month.</p></article>
 </div>
</section>
<section class="offer-band" id="offer"><div class="container offer-layout">
 <div class="offer-copy"><p class="eyebrow">ONE TOOL. ONE REAL FAMILY CHALLENGE. EVERY MONTH.</p><h2>What if someone made a plan like this <em>for your family every month?</em></h2><p>The Organized Family Club prepares a new family tool for you, personalizes it for your household, and plans to deliver it to your mailbox.</p><div class="offer-details"><span>✓ Personalized for your family</span><span>✓ Printed and mailed to your home</span><span>✓ A digital version to review or reprint</span></div></div>
 <div class="price-card"><p class="eyebrow">ORGANIZED FAMILY CLUB</p><h3>Make responsibility a family habit.</h3><div class="price">$6.39 <span>/ month</span></div><p class="annual">or $59 per year</p><p class="fineprint">Proposed pricing. Enrollment is not yet open while printing, fulfillment, and billing are tested.</p><a class="primary" href="/support">Ask About Early Access →</a><small>No payment required to ask about early access.</small></div>
 </div></section>
<section class="months container" id="months"><div class="section-intro"><p class="eyebrow">MORE THAN A CHORE CHART</p><h2>One useful family win. <em>Month after month.</em></h2><p>Different challenges. The same simple idea: everyone takes a little more ownership, and Mom doesn't have to figure it all out.</p></div>
 <div class="month-feature-grid">{[months[0], months[2], months[3]].map(m => <a class="month-feature" href={m.url}><img src={m.icon} alt="" loading="lazy" width="100" height="100"/><span>{m.month}</span><h3>{m.title}</h3><p>{m.how}</p><strong>See the tool →</strong></a>)}</div>
 <details class="all-months"><summary>Explore all 12 monthly tools <span>+</span></summary><div class="month-grid">{months.map(m => <a href={m.url}><img src={m.icon} alt="" loading="lazy" width="54" height="54"/><div><small>{m.month}</small><b>{m.title}</b><span>Preview →</span></div></a>)}</div></details>
 <p class="caption">The Daily Reset above is a free demo. Club monthly content and sample previews are separate. Mail fulfillment is still being tested.</p>
</section>
<section class="proof container"><div class="proof-quote"><p class="eyebrow">FROM AN ORGANIZED MOM COLLECTIVE CUSTOMER</p><blockquote>“This calendar is life changing. Quite literally!”</blockquote><p>Raquel · 5-star Etsy review of our wall calendar</p><small>This review is for the wall calendar, not the Family Club.</small></div><div class="proof-about"><img src="/images/site/mark-megan-family-story-1200.webp" alt="Mark and Megan with their family" loading="lazy" width="250" height="250"/><div><p class="eyebrow">FROM OUR FAMILY TO YOURS</p><h2>We believe a family works better <em>when everyone pitches in.</em></h2><p>That's why we created the Club. Not another system for Mom to manage, but practical help making the whole family part of the plan.</p><p><strong>Mark &amp; Megan</strong></p></div></div></section>
<section class="faq" id="faq"><div class="container faq-layout"><div><p class="eyebrow">GOOD QUESTIONS</p><h2>Before you join.</h2></div><div class="faq-items">{faqs.map(([question,answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></div></section>
<section class="closing"><div class="container"><p class="eyebrow">ORGANIZED FAMILY CLUB</p><h2>You don't have to raise responsible kids <em>all by yourself.</em></h2><p>We make the plan. Your family makes it happen.</p><a href="/support" class="primary">Ask About Early Access →</a></div></section>
</main>
<footer class="footer"><a href="/">Organized Mom Collective</a><span>© {new Date().getFullYear()} Organized Mom Collective</span><a href="/support">Support</a></footer>
</div>
<script is:inline>
 const form = document.querySelector('#family-form');
 const childrenFields = document.querySelector('#children-fields');
 const addButton = document.querySelector('#add-child');
 const sheetHeading = document.querySelector('#sheet-heading');
 const assignments = document.querySelector('#sheet-assignments');
 const result = document.querySelector('#result');
 const sampleLabel = document.querySelector('#sample-label');
 const KEY = 'ofc-club-sales-demo-v1';
 const safe = value => String(value || '').trim().slice(0,40);
 const escapeHtml = value => safe(value).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const jobs = age => age <= 3 ? 'Put a few toys in the basket (with help)' : age <= 5 ? 'Toys and books back in their places' : age <= 8 ? 'Put shoes, backpack, and belongings away' : age <= 11 ? 'Clear dishes and reset personal things' : age <= 14 ? 'Tidy the entryway and personal space' : 'Help reset the kitchen and shared spaces';
 function addChild(name='',age='7') {
   if(childrenFields.children.length >= 8) return;
   const row = document.createElement('div'); row.className='child-row';
   row.innerHTML = '<label><span class="sr-only">Child name</span><input name="child-name" required maxlength="40" placeholder="Child’s name"></label><label><span class="sr-only">Child age</span><select name="child-age">'+Array.from({length:18},(_,i)=>'<option value="'+(i+1)+'">Age '+(i+1)+'</option>').join('')+'</select></label><button type="button" class="remove" aria-label="Remove child">×</button>';
   row.querySelector('input').value=name; row.querySelector('select').value=age;
   row.querySelector('button').addEventListener('click',()=>{if(childrenFields.children.length>1)row.remove();addButton.disabled=childrenFields.children.length>=8});
   childrenFields.append(row);addButton.disabled=childrenFields.children.length>=8;
 }
 function getData(){return {mom:safe(form.elements.namedItem('mom').value),dad:safe(form.elements.namedItem('dad').value),children:[...childrenFields.querySelectorAll('.child-row')].map(row=>({name:safe(row.querySelector('input').value),age:Number(row.querySelector('select').value)}))}}
 function showPlan(data,scroll=false){
   sheetHeading.innerHTML='Our Family’s<br/><em>Daily Reset</em>';
   const people=[...data.children.map(c=>({name:c.name,task:jobs(c.age)})),{name:data.dad,task:'Clear and wipe the dinner table'},{name:data.mom,task:'Help everyone get ready for tomorrow'}];
   assignments.innerHTML=people.map(p=>'<div class="assignment"><span class="tick"></span><div><b>'+escapeHtml(p.name)+'</b><p>'+escapeHtml(p.task)+'</p></div></div>').join('');
   sampleLabel.textContent='Your personalized example. Actual Club monthly mailings are separate.';
   result.hidden=false;
   try{localStorage.setItem(KEY,JSON.stringify(data))}catch{}
   if(scroll)result.scrollIntoView({behavior:'smooth',block:'start'});
 }
 addButton.addEventListener('click',()=>addChild());
 form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;showPlan(getData(),true)});
 document.querySelector('#edit-family').addEventListener('click',()=>form.scrollIntoView({behavior:'smooth',block:'center'}));
 document.querySelector('#clear-family').addEventListener('click',()=>{try{localStorage.removeItem(KEY)}catch{};form.reset();childrenFields.replaceChildren();addChild();addChild('','5');result.hidden=true;assignments.innerHTML='';sampleLabel.textContent='Example preview. Enter your family to see your own plan.';form.scrollIntoView({behavior:'smooth'})});
 let saved=null;try{saved=JSON.parse(localStorage.getItem(KEY)||'null')}catch{}
 if(saved&&typeof saved.mom==='string'&&typeof saved.dad==='string'&&Array.isArray(saved.children)&&saved.children.length&&saved.children.length<=8){form.elements.namedItem('mom').value=safe(saved.mom);form.elements.namedItem('dad').value=safe(saved.dad);saved.children.forEach(c=>addChild(safe(c.name),String(Math.max(1,Math.min(18,Number(c.age)||7)))));if(saved.mom&&saved.dad&&saved.children.every(c=>c.name))showPlan(saved)}else{addChild();addChild('','5')}
</script>
<style>
.club{--forest:#254d3c;--sage:#547964;--cream:#fbf8f1;--ink:#303831;--muted:#66716a;--line:#d9dfd7;color:var(--ink);font-family:'Montserrat Variable',Montserrat,sans-serif;line-height:1.55;background:#fff}
.club *{box-sizing:border-box}.club h1,.club h2,.club h3,.club blockquote{font-family:Georgia,serif;line-height:1.12;letter-spacing:-.025em;font-weight:400;margin:0}.club h1{font-size:clamp(2.5rem,4.1vw,4.9rem)}.club h2{font-size:clamp(2rem,3vw,3.5rem)}.club h3{font-size:1.55rem}.club h1 em,.club h2 em{font-weight:600;color:var(--sage)}.club p{margin:0}.club a{color:inherit}.container{max-width:1200px;margin:0 auto;padding-left:24px;padding-right:24px}.eyebrow{font-size:.72rem;letter-spacing:.16em;font-weight:750;color:var(--sage);margin-bottom:14px!important}.topbar{max-width:1360px;margin:auto;padding:18px 30px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;font-weight:800;text-decoration:none;color:var(--forest)!important}.brand img{object-fit:contain}.topbar nav{display:flex;align-items:center;gap:24px}.topbar nav a{font-size:.8rem;font-weight:650;text-decoration:none}.topbar nav a:hover{text-decoration:underline}.topbar nav .member{color:var(--forest)}.hero{background:linear-gradient(125deg,#fff 30%,#f6f6ee 100%);padding:65px 24px 75px}.hero-inner{max-width:1260px;margin:auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);align-items:start;gap:clamp(32px,6vw,90px)}.hero-copy{max-width:610px}.promise{font-family:Georgia,serif;font-size:clamp(1.2rem,2vw,1.65rem);font-weight:600;margin:20px 0 8px!important;color:var(--forest)}.supporting{font-size:1.02rem;color:var(--muted);max-width:540px}.form{margin-top:27px;background:#fff;border:1px solid #dde4dc;border-radius:18px;padding:25px;box-shadow:0 14px 35px rgba(44,68,51,.08)}.form h2{font-family:Georgia,serif;font-size:1.7rem}.form>p{color:var(--muted);font-size:.89rem;margin:7px 0 17px!important}.name-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.form label{font-size:.79rem;font-weight:700;display:block}.form input,.form select{margin-top:6px;display:block;width:100%;min-width:0;bac
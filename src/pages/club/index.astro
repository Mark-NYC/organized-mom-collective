/* Conversion layout: one promise, one clear product definition, one primary CTA. */
.club .hero-inner{display:grid;grid-template-columns:minmax(0,.91fr) minmax(0,1.09fr);align-items:center;min-height:540px;padding:clamp(30px,5vw,80px);gap:clamp(32px,5vw,86px)}
.club .hero-copy{max-width:615px}
.club .hero h1{font-size:clamp(2.8rem,4.45vw,5.4rem);line-height:1.065;margin:14px 0 20px}
.club .hero .product-definition{font-size:clamp(1.1rem,1.55vw,1.38rem);line-height:1.56;max-width:560px;margin:0 0 18px!important;font-weight:450}
.club .hero .promise{font-size:1.16rem;line-height:1.45;font-weight:650;margin:0 0 14px!important}
.club .hero .supporting{font-size:.98rem;line-height:1.65;margin:0!important;color:#6e6461}
.club .hero-photo-wrap{align-self:stretch;display:flex;align-items:center;min-width:0}
.club .hero-photo{width:100%;margin:0}.club .hero-photo img{width:100%;height:auto;max-height:650px;aspect-ratio:4/3;object-fit:cover;object-position:center;display:block}
.club .hero-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:26px}
.club .hero-actions .primary{min-height:52px;padding:14px 24px;display:inline-flex;align-items:center;justify-content:center}
.club .hero-secondary{font-size:.86rem;font-weight:700;color:#4d4544;text-decoration:underline;text-underline-offset:4px}
.club .hero-trust{font-size:.72rem;line-height:1.5;color:#6e6461;margin:17px 0 0!important}
.club .club-demo{padding:88px 24px;background:#fff;scroll-margin-top:24px}
.club .club-demo-inner{max-width:1060px;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(36px,7vw,110px);align-items:center}
.club .club-demo-heading h2{font:400 clamp(2.1rem,3.4vw,3.6rem)/1.11 Georgia,serif;margin:12px 0 20px;letter-spacing:-.025em}
.club .club-demo-heading h2 em{color:#71846e}
.club .club-demo-heading>p{font-size:1.05rem;line-height:1.7}
.club .club-demo-heading .demo-disclaimer{font-size:.78rem;color:#6e6461;margin-top:18px}
.club .club-demo .form{margin:0!important;padding:clamp(24px,3vw,38px);box-shadow:0 18px 44px -33px rgba(77,69,68,.4);background:#f1f2f2;border:0;border-radius:4px}

---
/**
 * /club/kits/<slug>: one page per kit in src/data/club/kits (a new month is a new config file). The page holds no
 * family data; the island loads it (src/lib/club/store.ts) and the database decides access. Noindex, not linked;
 * behind PUBLIC_CLUB_ENABLED.
 */
import { monthPageName } from '../../../data/club/month-pages';
import ClubLayout from '../../../layouts/ClubLayout.astro';
import KitPage from '../../../components/club/KitPage';
import { kits } from '../../../data/club/kits';
import { memberPlanHref } from '../../../lib/club/plan/account';
import { routes } from '../../../routes';
import ClubMonthAccess from '../../../components/club/ClubMonthAccess';
import NovemberOwnershipPrototype from '../../../components/club/NovemberOwnershipPrototype.astro';
import DecemberMissionPrototype from '../../../components/club/DecemberMissionPrototype.astro';
import JanuaryHabitCards from '../../../components/club/JanuaryHabitCards.astro';
import FebruaryConnectionCards from '../../../components/club/FebruaryConnectionCards.astro';
import MarchSpringPrep from '../../../components/club/MarchSpringPrep.astro';
import AprilDinnerPlan from '../../../components/club/AprilDinnerPlan.astro';
import MaySummerRhythm from '../../../components/club/MaySummerRhythm.astro';
import JuneSnackStation from '../../../components/club/JuneSnackStation.astro';
import JulyActivityBoard from '../../../components/club/JulyActivityBoard.astro';
import AugustSchoolRoutines from '../../../components/club/AugustSchoolRoutines.astro';

export function getStaticPaths() {
  return kits.map((k) => ({ params: { slug: k.slug }, props: { slug: k.slug, theme: k.theme, kitMonth: k.month } }));
}

const { slug, theme, kitMonth } = Astro.props;
// The tab title names the month as its page does (src/data/club/month-pages.ts); the kit registry's theme is a fallback.
const title = monthPageName(kitMonth) ?? theme;
// Where the mailed QR code lands: the month's own member page when it has one (every month in the app's year except
// November, whose tool is this page). The older per-month copies below stay only for months without one.
const plan = memberPlanHref(slug);
const planHref = plan.startsWith(`${routes.appClub}/`) ? plan : null;

const month = slug === "2026-11-family-ownership" ? "november" : slug === "2027-01-fresh-start-together" ? "january" : slug === "2026-12-christmas-mission" ? "december" : slug === "2027-02-better-together" ? "february" : slug === "2027-03-spring-clean-together" ? "march" : slug === "2027-04-everybody-helps-at-mealtime" ? "april" : slug === "2027-05-finish-the-school-year" ? "may" : slug === "2027-06-summer-with-a-plan" ? "june" : slug === "2027-07-ready-to-go" ? "july" : slug === "2027-08-school-year" ? "august" : null;
---

<ClubLayout title={title}>
  {planHref ? (
    <ClubMonthAccess client:only="react" slug={slug} planHref={planHref} />
  ) : month ? (
    <>
      <ClubMonthAccess client:only="react" slug={slug} />
      <div id="club-month-content" hidden>
        {month === 'november' ? <NovemberOwnershipPrototype /> :
         month === 'december' ? <DecemberMissionPrototype /> :
         month === 'january' ? <JanuaryHabitCards storageKey="omc:club:january-habit-cards:v2" /> :
         month === "february" ? <FebruaryConnectionCards storageKey="omc:club:february-connection:v1" /> :
         month === "march" ? <MarchSpringPrep storageKey="omc:club:march-spring-prep:v1" /> :
         month === "april" ? <AprilDinnerPlan storageKey="omc:club:april-dinner:v1" /> :
         month === "may" ? <MaySummerRhythm storageKey="omc:club:may-summer-rhythm:v1" /> :
         month === "june" ? <JuneSnackStation storageKey="omc:club:june-snack-station:v1" /> :
         month === "july" ? <JulyActivityBoard storageKey="omc:club:july-activities:v1" /> :
         <AugustSchoolRoutines storageKey="omc:club:august-school-routines:v1" />}
      </div>
    </>
  ) : <KitPage client:only="react" slug={slug} />}
</ClubLayout>

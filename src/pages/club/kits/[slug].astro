---
/**
 * /club/kits/<slug>: one page per kit in src/data/club/kits (a new month is a new config file). The page holds no
 * family data; the island loads it (src/lib/club/store.ts) and the database decides access. Noindex, not linked;
 * behind PUBLIC_CLUB_ENABLED.
 */
import ClubLayout from '../../../layouts/ClubLayout.astro';
import KitPage from '../../../components/club/KitPage';
import { kits } from '../../../data/club/kits';
import ClubMonthAccess from '../../../components/club/ClubMonthAccess';
import NovemberOwnershipPrototype from '../../../components/club/NovemberOwnershipPrototype.astro';
import DecemberMissionPrototype from '../../../components/club/DecemberMissionPrototype.astro';
import JanuaryHabitCards from '../../../components/club/JanuaryHabitCards.astro';
import FebruaryConnectionCards from '../../../components/club/FebruaryConnectionCards.astro';
import MarchSpringPrep from '../../../components/club/MarchSpringPrep.astro';
import AprilDinnerPlan from '../../../components/club/AprilDinnerPlan.astro';
import MaySummerRhythm from '../../../components/club/MaySummerRhythm.astro';
import JuneSnackStation from '../../../components/club/JuneSnackStation.astro';

export function getStaticPaths() {
  return kits.map((k) => ({ params: { slug: k.slug }, props: { slug: k.slug, theme: k.theme } }));
}

const { slug, theme } = Astro.props;
const month = slug === "2026-11-family-ownership" ? "november" : slug === "2027-01-fresh-start-together" ? "january" : slug === "2026-12-christmas-mission" ? "december" : slug === "2027-02-better-together" ? "february" : slug === "2027-03-spring-clean-together" ? "march" : slug === "2027-04-everybody-helps-at-mealtime" ? "april" : slug === "2027-05-finish-the-school-year" ? "may" : slug === "2027-06-summer-with-a-plan" ? "june" : null;
---

<ClubLayout title={theme}>
  {month ? (
    <>
      <ClubMonthAccess client:only="react" slug={slug} />
      <div id="club-month-content" hidden>
        {month === 'november' ? <NovemberOwnershipPrototype /> :
         month === 'december' ? <DecemberMissionPrototype /> :
         month === 'january' ? <JanuaryHabitCards storageKey="omc:club:january-habit-cards:v2" /> :
         month === "february" ? <FebruaryConnectionCards storageKey="omc:club:february-connection:v1" /> :
         month === "march" ? <MarchSpringPrep storageKey="omc:club:march-spring-prep:v1" /> :
         month === "april" ? <AprilDinnerPlan storageKey="omc:club:april-dinner:v1" /> :
         month === "may" ? <MaySummerRhythm storageKey="omc:club:may-summer-rhythm:v1" /> :
         <JuneSnackStation storageKey="omc:club:june-snack-station:v1" />}
      </div>
    </>
  ) : <KitPage client:only="react" slug={slug} />}
</ClubLayout>

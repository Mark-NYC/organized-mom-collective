---
/** November concept comparison: activity calendar and earlier ownership plan.
 * The public /try-the-calendar/ tool is intentionally unchanged.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import ClubPrototypeNav from '../../components/club/ClubPrototypeNav';
import NovemberOwnershipPrintable from '../../components/club/NovemberOwnershipPrintable.astro';
import NovemberActivityCalendar from '../../components/club/NovemberActivityCalendar.astro';
---
<PublicLayout fullTitle="November Family Activity Guide | Organized Family Club" description="November Club family activity preview." indexable={false} chrome={false} width="full" tracking={false}>
 <ClubPrototypeNav client:only="react" month="november" />
 <main id="club-month-content">
  <div class="nov-tabs" role="tablist" aria-label="November preview versions">
   <button type="button" id="nov-tab-activities" role="tab" aria-selected="true" aria-controls="nov-panel-activities" tabindex="0">Activity calendar <span>NEW</span></button>
   <button type="button" id="nov-tab-plan" role="tab" aria-selected="false" aria-controls="nov-panel-plan" tabindex="-1">Ownership plan <span>EARLIER VERSION</span></button>
  </div>
  <section id="nov-panel-activities" role="tabpanel" aria-labelledby="nov-tab-activities"><NovemberActivityCalendar /></section>
  <section id="nov-panel-plan" role="tabpanel" aria-labelledby="nov-tab-plan" hidden><NovemberOwnershipPrintable /></section>
 </main>
</PublicLayout>
<style is:global>
 #club-month-content .nov-tabs{display:flex;gap:7px;align-items:stretch;background:#faf9f7;border-bottom:1px solid #dce5da;padding:12px 20px;position:relative;z-index:30}
 #club-month-content .nov-tabs button{cursor:pointer;min-height:46px;background:#fff;border:1px solid #d5dfd5;border-radius:5px;padding:10px 18px;font:700 13px Montserrat,Arial,sans-serif;color:#607462}
 #club-month-content .nov-tabs button[aria-selected="true"]{background:#5f7767;color:white;border-color:#5f7767}
 #club-month-content .nov-tabs button span{font:700 9px Montserrat,Arial,sans-serif;letter-spacing:.08em;opacity:.75;margin-left:6px}
 #club-month-content [role="tabpanel"][hidden]{display:none!important}
 @media(max-width:600px){#club-month-content .nov-tabs{padding:10px;gap:6px}#club-month-content .nov-tabs button{flex:1;padding:9px 5px;font-size:12px}#club-month-content .nov-tabs button span{display:block;margin:4px 0 0;font-size:8px}}
 @media(min-width:1101px){
  html:has(#nov-panel-plan[hidden] .nvp),body:has(#nov-panel-plan[hidden] .nvp){height:auto!important;overflow:auto!important}
  #club-month-content:has(#nov-panel-plan[hidden] .nvp){position:relative!important;top:auto!important;bottom:auto!important;height:auto!important;overflow:visible!important}
  #club-month-content:has(#nov-panel-plan:not([hidden]) .nvp){top:var(--adc-nav-height,118px);bottom:0}
  #club-month-content:has(#nov-panel-plan:not([hidden]) .nvp) .nov-tabs{height:62px}
  #club-month-content:has(#nov-panel-plan:not([hidden]) .nvp) #nov-panel-plan{height:calc(100% - 62px)}
 }
 @media print{body:has(.nac-printing) #nov-panel-plan{display:none!important}body:has(.nac-printing) .nov-tabs{display:none!important}}
</style>
<script>
 const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('.nov-tabs [role="tab"]'));
 const select=(id:string)=>{
  for(const tab of tabs){
   const active=tab.id===id;
   tab.setAttribute('aria-selected',String(active));
   tab.tabIndex=active?0:-1;
   const panel=document.getElementById(tab.getAttribute('aria-controls')||'');
   if(panel)panel.hidden=!active;
  }
  window.dispatchEvent(new Event('resize'));
 };
 tabs.forEach((tab,i)=>{
  tab.addEventListener('click',()=>select(tab.id));
  tab.addEventListener('keydown',e=>{
   if(e.key!=='ArrowRight'&&e.key!=='ArrowLeft')return;
   e.preventDefault();const next=tabs[(i+(e.key==='ArrowRight'?1:tabs.length-1))%tabs.length];select(next.id);next.focus();
  });
 });
</script>

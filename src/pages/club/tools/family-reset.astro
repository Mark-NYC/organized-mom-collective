---
/**
 * /club/tools/family-reset: the Family Weekly Reset Builder (a site tool: FamilyResetBuilder.astro and
 * family-reset-builder.ts), inside the Club. Opened from the September kit (src/lib/tool-handoff.ts) with the family's
 * first names, children's ages, the account holder and the meeting day she wrote, and its own saved guide per family.
 * Works the same with no handoff, for anyone. Club layout: noindex, no trackers, no site navigation. Behind
 * PUBLIC_CLUB_ENABLED.
 */
import ClubLayout from '../../../layouts/ClubLayout.astro';
import ClubToolBar from '../../../components/club/ClubToolBar';
import FamilyResetBuilder from '../../../components/site/FamilyResetBuilder.astro';
import { CLUB_NAME } from '../../../data/club/config';
---

<ClubLayout title="Family Weekly Reset Builder">
  <ClubToolBar client:only="react" tool="family-reset" />
  <section id="club-tool-host" class="w-full pb-20 pt-4">
    <FamilyResetBuilder storageKey="omc:club:family-reset:v1" handoff brand={CLUB_NAME} />
  </section>
</ClubLayout>

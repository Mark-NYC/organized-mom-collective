---
/**
 * /club/tools/traditions-picker: the Family Christmas Traditions Picker (a site tool: TraditionsPicker.astro and
 * traditions-picker.ts), inside the Club. Opened from the December kit (src/lib/tool-handoff.ts) with the children's
 * ages and the family's name, and its own saved picks per family. Works the same with no handoff, for anyone.
 * Club layout: noindex, no trackers, no site navigation. Behind PUBLIC_CLUB_ENABLED like every /club page.
 */
import ClubLayout from '../../../layouts/ClubLayout.astro';
import ClubToolBar from '../../../components/club/ClubToolBar';
import TraditionsPicker from '../../../components/site/TraditionsPicker.astro';
import { CLUB_NAME } from '../../../data/club/config';
---

<ClubLayout title="Christmas Traditions">
  <ClubToolBar client:only="react" tool="traditions-picker" />
  <section id="club-tool-host" class="w-full pb-20 pt-4">
    <TraditionsPicker storageKey="omc:club:traditions-picker:v1" handoff brand={CLUB_NAME} />
  </section>
</ClubLayout>

---
/**
 * /club/tools/routine-chart: the site's routine chart (the same component as /routine-chart: RoutineChart.astro and
 * routine-chart.ts), inside the Club. Opened from a kit for one child (src/lib/tool-handoff.ts): their own saved
 * chart, their name in the title, age-suited jobs first. Club layout: noindex, no trackers, no site navigation.
 * Behind PUBLIC_CLUB_ENABLED like every /club page.
 */
import ClubLayout from '../../../layouts/ClubLayout.astro';
import ClubToolBar from '../../../components/club/ClubToolBar';
import RoutineChart from '../../../components/site/RoutineChart.astro';
import { CLUB_NAME } from '../../../data/club/config';
---

<ClubLayout title="Routine Chart">
  <ClubToolBar client:only="react" tool="routine-chart" title="Routine chart" />
  <section id="club-tool-host" class="mx-auto w-full max-w-6xl px-4 pb-20 pt-4 sm:px-8">
    <RoutineChart storageKey="omc:club:routine-chart:v1" handoff brand={CLUB_NAME} />
    <p class="mx-auto mt-6 max-w-[816px] text-[0.92rem] text-warm-soft">Tip: put the chart in a clear sleeve and use a dry-erase marker to reuse it each week.</p>
  </section>
</ClubLayout>

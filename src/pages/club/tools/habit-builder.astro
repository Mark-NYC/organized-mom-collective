---
/**
 * /club/tools/habit-builder: the Family Habit Builder (a site tool: HabitBuilder.astro and habit-builder.ts), inside
 * the Club. Opened from the January kit (src/lib/tool-handoff.ts) with the family's first names, its one thing and
 * start day, and its own saved habit per family. Works the same with no handoff, for anyone.
 * Club layout: noindex, no trackers, no site navigation. Behind PUBLIC_CLUB_ENABLED like every /club page.
 */
import ClubLayout from '../../../layouts/ClubLayout.astro';
import JanuaryHabitCards from '../../../components/club/JanuaryHabitCards.astro';
---

<ClubLayout title="January Habit Cards">
  
  <section id="club-tool-host" class="w-full pb-20 pt-4">
    <JanuaryHabitCards storageKey="omc:club:january-habit-cards:v2" />
  </section>
</ClubLayout>

---
/**
 * /screen-time-contract — the free screen time tool: the original earn-it contract (jobs first, then activities that
 * earn screen time) and a family agreement (when, how much, before screens, where devices go, how it ends, what
 * grown-ups agree to). The tool itself is src/components/site/ScreenTimeContract.astro, shared with the Club's
 * /club/tools/screen-time; this page opens in the earn-it format, as it always has. Saves in this browser
 * (`omc:screen-time:v1`).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import ScreenTimeContract from '../components/site/ScreenTimeContract.astro';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Screen Time Contract', item: new URL(routes.screenTime, site).href },
    ],
  },
];
---

<PublicLayout
  title="Free Screen Time Contract for Kids"
  description="A free screen time contract for kids: jobs first, then activities that earn screen time. Edit it together, then download it to print and sign."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="st-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free screen time contract</p>
      <h1 id="st-h" class="serif-hero mt-3">Screen Time They Earn, Not Argue For.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        Jobs come first. Then every stretch of reading, playing outside or helping out earns screen time. Fill it in together, download it,
        sign it and hang it up. The written agreement gives everyone a reference. Review it together when it needs adjusting.
        Prefer a simple family agreement instead? Switch to it above the sheet.
      </p>
    </div>
  </section>

  <ScreenTimeContract storageKey="omc:screen-time:v1">
    <p slot="footnote" class="st-footnote">
      More free tools: the <a href={routes.choreChart} class="text-link">Chore Chart by Age</a>, the
      {' '}<a href={routes.backToSchool} class="text-link">Back to School Checklist</a> and the
      {' '}<a href={routes.calendar} data-cta="screen-time" class="text-link">Family Wall Calendar</a>
    </p>
  </ScreenTimeContract>
</PublicLayout>

---
import PublicLayout from '../../layouts/PublicLayout.astro';
import FamilyChaosQuiz from '../../components/quizzes/FamilyChaosQuiz';
import { Wordmark } from '../../components/marks';

const title = 'What’s Really Causing the Chaos in Your Home?';
const description = 'Take this free 7-question family organization quiz. Find your biggest home routine bottleneck and get a personalized 3-day action plan with a free practical guide.';
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: new URL('/quizzes/family-chaos', Astro.site!).href,
}];
---
<PublicLayout title={title} description={description} width="full" chrome={false} jsonLd={jsonLd}>
  <div class="min-h-screen bg-white">
    <header class="border-b border-[#e7ddd4] bg-[#FBF7F1] px-5 py-4 sm:py-5">
      <div class="mx-auto flex max-w-[800px] items-center justify-center">
        <a href="/" aria-label="Organized Mom Collective home" class="inline-flex min-h-11 items-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#545454]">
          <Wordmark badge="size-8 sm:size-9" />
        </a>
      </div>
    </header>
    <div class="px-4 py-8 sm:px-8 sm:py-14">
      <FamilyChaosQuiz client:load />
      <div class="mx-auto mt-10 max-w-[760px] text-center text-[#545454]">
        <p class="text-sm leading-relaxed">Seven simple questions. Four possible starting points. One small change to try this week.</p>
        <p class="mt-3 text-xs text-[#77716b]">This quiz offers practical family organization ideas, not a clinical or psychological assessment.</p>
      </div>
    </div>
    <footer class="mt-12 border-t border-[#e7ddd4] px-5 py-7 text-center text-xs text-[#77716b] sm:mt-16">
      <p>© {new Date().getFullYear()} Organized Mom Collective <span aria-hidden="true">·</span> <a href="/privacy" class="underline underline-offset-4 hover:text-[#545454]">Privacy Policy</a></p>
    </footer>
  </div>
  <style is:global>
    @media print {
      header, footer, nav, [data-countdown-bar] { display: none !important; }
      main { padding: 0 !important; }
      body { background: white !important; }
      button { display: none !important; }
      section { box-shadow: none !important; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
    }
  </style>
</PublicLayout>

---
/**
 * /back-to-school-checklist — a free four-page back-to-school checklist (the last page a dated countdown from the first day of school) people tick and edit on screen, then
 * download as PNGs, one page or all four (src/components/site/ChecklistPages.astro).
 * Saves in this browser (`omc:back-to-school:v1`).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import ChecklistPages from '../components/site/ChecklistPages.astro';
import { blanks, type ChecklistPage } from '../lib/checklist-pages';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const pages: ChecklistPage[] = [
  {
    info: [
      { field: 'family', label: 'Family', placeholder: 'Family name' },
      { field: 'year', label: 'School year', placeholder: '2026–2027' },
      { field: 'child', label: 'Child & grade', placeholder: 'Name – grade' },
    ],
    sections: [
      {
        title: 'Daily Essentials',
        groups: [
          { title: 'Bags & Containers', cols: 2, items: ['Backpack', 'Lunch box', 'Water bottle', 'Pencil case'] },
          {
            title: 'Must-Have Items',
            variant: 'priority',
            cols: 1,
            items: ['Emergency contact card in backpack', 'Everything labeled with your child’s name', 'Spare clothes (for younger kids)'],
          },
        ],
      },
      {
        title: 'School Supplies',
        groups: [
          {
            title: 'Writing & Drawing',
            cols: 3,
            items: ['Pencils (#2)', 'Erasers', 'Sharpener', 'Pens (blue/black)', 'Colored pencils', 'Markers', 'Crayons', 'Highlighters', ''],
          },
          { title: 'Paper & Organization', cols: 3, items: ['Notebooks', 'Binders', 'Folders', 'Loose-leaf paper', 'Index cards', 'Sticky notes'] },
          { title: 'Tools & Supplies', cols: 3, items: ['Glue sticks', 'Scissors', 'Ruler', 'Calculator', 'Stapler', 'Tape'] },
        ],
      },
    ],
  },
  {
    sections: [
      {
        title: 'Clothing & Shoes',
        groups: [
          {
            title: 'School Clothes',
            cols: 2,
            items: ['School uniforms', 'Everyday school clothes', 'PE/gym clothes', 'Dress shoes', 'Sneakers', 'Socks & underwear'],
          },
          { title: 'Clothing Notes & Sizes', notes: 'Current sizes, what’s needed, uniform rules…' },
        ],
      },
      {
        title: 'Health & Safety',
        groups: [
          {
            title: 'Medical',
            cols: 1,
            items: [
              'Annual physical done',
              'Immunizations up to date',
              'School medical forms turned in',
              'Medication plan with the school nurse',
              'Allergy information given to school',
            ],
          },
        ],
      },
      {
        title: 'Home Organization',
        groups: [
          {
            title: 'Set Up at Home',
            cols: 2,
            items: ['Family calendar set up', 'Homework spot ready', 'Drop zone by the door', 'Lunch packing station', 'Closet sorted', 'Labels ready'],
          },
          {
            title: 'Routines',
            cols: 1,
            items: ['Morning routine planned', 'Evening prep routine planned', 'First week’s meals planned', 'Snacks & lunch items stocked'],
          },
        ],
      },
    ],
  },
  {
    sections: [
      {
        title: 'First Day Prep',
        groups: [
          {
            title: 'Getting Ready to Go',
            cols: 1,
            items: ['School tour or orientation', 'Met the teacher', 'Read a back-to-school book together', 'First day photo props ready', 'Sleep schedule adjusted'],
          },
        ],
      },
      {
        title: 'Your School’s List',
        groups: [
          { title: 'School-Specific Items', cols: 1, items: blanks(4) },
          { title: 'Notes', notes: 'Supply list extras, contacts, important dates…' },
        ],
      },
    ],
  },
  {
    info: [{ field: 'start', label: 'First day of school', placeholder: '', type: 'date' }],
    sections: [
      {
        title: 'Countdown to Day One',
        groupCols: 2,
        groups: [
          { title: '2 months before', due: 60, items: ['Book school & sports physicals', 'Turn in the physical forms', 'Sign up for fall sports & activities'] },
          { title: '6 weeks before', due: 42, items: ['Sort fall clothes, donate outgrown', 'School dates & days off on the calendar', 'Practices & games on the calendar'] },
          { title: '1 month before', due: 30, items: ['Buy clothes, shoes & uniforms', 'Buy the school supply list', 'Check summer reading & math packets'] },
          { title: '3 weeks before', due: 21, items: ['Check & clean backpacks', 'Check & clean lunch boxes', ''] },
          { title: '2 weeks before', due: 14, items: ['Start the school bedtime', 'Line up pickup help or a sitter', 'Book haircuts'] },
          { title: '1 week before', due: 7, items: ['Lunch & snack shopping list', 'Label everything', 'Stock homework supplies at home'] },
          { title: 'The night before', due: 1, items: ['Pack lunches & snacks', 'Pack backpacks', 'Lay out first-day clothes', 'Set alarms'] },
          { title: 'The first day', due: 0, items: ['First-day photo', 'Enjoy it (bring tissues)', '', ''] },
        ],
      },
      {
        title: 'Notes',
        groups: [{ title: 'Teacher, bus, pickup times', notes: 'Teacher names, bus number, pickup plan, school phone…' }],
      },
    ],
  },
];

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Back to School Checklist', item: new URL(routes.backToSchool, site).href },
    ],
  },
];
---

<PublicLayout
  title="Free Back to School Checklist"
  description="A free back-to-school checklist: supplies, clothes, health forms, routines and a dated countdown from the first day of school. Tick it off, edit any item, then download it to print."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="bts-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free back-to-school checklist</p>
      <h1 id="bts-h" class="serif-hero mt-3">Back to School, Out of Your Head.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        Supplies, clothes, forms and routines, plus a countdown: enter the first day of school and every step gets a date. Agree on owners for supplies, forms and first-day prep. Write names beside the jobs, adapt the school’s list,
        then print it. What you change stays saved in this browser until you reset it.
      </p>
    </div>
  </section>

  <ChecklistPages title="Back to School Checklist" pages={pages} storageKey="omc:back-to-school:v1" filename="back-to-school-checklist">
    <p slot="footnote" class="ck-footnote">
      More free tools: the <a href={routes.choreChart} class="text-link">Chore Chart by Age</a>, the weekly
      {' '}<a href={routes.planner} class="text-link">Planner</a> and the
      {' '}<a href={routes.calendar} data-cta="back-to-school" class="text-link">Family Wall Calendar</a>
    </p>
  </ChecklistPages>
</PublicLayout>

---
/**
 * /back-to-school-checklist — a free three-page back-to-school checklist people tick and edit on screen, then
 * download as PNGs (US Letter portrait, 8.5 × 11 in at 96 px/in, drawn at 2×), one page or all three.
 * Every item is an editable text field with a checkbox. Everything autosaves in this browser
 * (`omc:back-to-school:v1`); Reset puts the starter items back. Autosave and export: src/lib/printable.ts.
 * Classes are prefixed `bts-` so they never collide with the site's own.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

interface Group {
  title: string;
  cols?: 1 | 2 | 3;
  /** Starter items; an empty string is a blank line to write in. */
  items?: string[];
  variant?: 'priority' | 'timeline';
  /** A lined notes box instead of items. */
  notes?: string;
}
interface Section {
  title: string;
  groups: Group[];
}

const blanks = (n: number) => Array.from({ length: n }, () => '');

const pages: { info?: boolean; sections: Section[] }[] = [
  {
    info: true,
    sections: [
      {
        title: 'Daily Essentials',
        groups: [
          { title: 'Bags & Containers', cols: 2, items: ['Backpack', 'Lunch box', 'Water bottle', 'Pencil case'] },
          {
            title: 'Must-Have Items',
            variant: 'priority',
            cols: 1,
            items: ['Emergency contact card in backpack', 'Everything labeled with your child’s name', 'Spare clothes (for younger kids)'],
          },
        ],
      },
      {
        title: 'School Supplies',
        groups: [
          {
            title: 'Writing & Drawing',
            cols: 3,
            items: ['Pencils (#2)', 'Erasers', 'Sharpener', 'Pens (blue/black)', 'Colored pencils', 'Markers', 'Crayons', 'Highlighters', ''],
          },
          { title: 'Paper & Organization', cols: 3, items: ['Notebooks', 'Binders', 'Folders', 'Loose-leaf paper', 'Index cards', 'Sticky notes'] },
          { title: 'Tools & Supplies', cols: 3, items: ['Glue sticks', 'Scissors', 'Ruler', 'Calculator', 'Stapler', 'Tape'] },
        ],
      },
    ],
  },
  {
    sections: [
      {
        title: 'Clothing & Shoes',
        groups: [
          {
            title: 'School Clothes',
            cols: 2,
            items: ['School uniforms', 'Everyday school clothes', 'PE/gym clothes', 'Dress shoes', 'Sneakers', 'Socks & underwear'],
          },
          { title: 'Clothing Notes & Sizes', notes: 'Current sizes, what’s needed, uniform rules…' },
        ],
      },
      {
        title: 'Health & Safety',
        groups: [
          {
            title: 'Medical',
            cols: 1,
            items: [
              'Annual physical done',
              'Immunizations up to date',
              'School medical forms turned in',
              'Medication plan with the school nurse',
              'Allergy information given to school',
            ],
          },
        ],
      },
      {
        title: 'Home Organization',
        groups: [
          {
            title: 'Set Up at Home',
            cols: 2,
            items: ['Family calendar set up', 'Homework spot ready', 'Drop zone by the door', 'Lunch packing station', 'Closet sorted', 'Labels ready'],
          },
          {
            title: 'Routines',
            cols: 1,
            items: ['Morning routine planned', 'Evening prep routine planned', 'First week’s meals planned', 'Snacks & lunch items stocked'],
          },
        ],
      },
    ],
  },
  {
    sections: [
      {
        title: 'First Day Prep',
        groups: [
          {
            title: 'Getting Ready to Go',
            cols: 1,
            items: ['School tour or orientation', 'Met the teacher', 'Read a back-to-school book together', 'First day photo props ready', 'Sleep schedule adjusted'],
          },
          {
            title: 'Timeline',
            variant: 'timeline',
            cols: 1,
            items: [
              '2 months before: sort closets, see what’s needed',
              '1 month before: shop for clothes and shoes',
              '3 weeks before: check and clean backpacks & lunch boxes',
              '2 weeks before: shop for supplies',
              '1 week before: label everything, final prep',
            ],
          },
        ],
      },
      {
        title: 'Your School’s List',
        groups: [
          { title: 'School-Specific Items', cols: 1, items: blanks(4) },
          { title: 'Notes', notes: 'Supply list extras, contacts, important dates…' },
        ],
      },
    ],
  },
];

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Back to School Checklist', item: new URL(routes.backToSchool, site).href },
    ],
  },
];
---

<PublicLayout
  title="Free Back to School Checklist"
  description="A free back-to-school checklist: supplies, clothes, health forms, routines and a timeline. Tick it off on screen, edit any item, then download all three pages to print."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="bts-h" class="bg-cream">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free back-to-school checklist</p>
      <h1 id="bts-h" class="serif-hero mt-3">Back to School, Out of Your Head.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        Supplies, clothes, forms, routines and a timeline, all on three pages. Tick things off, change any item to match your school’s list,
        then download to print. What you change stays saved in this browser until you reset it.
      </p>
    </div>
  </section>

  <div class="bts-container">
    <div class="bts-actions">
      <button type="button" class="bts-btn bts-btn-primary" data-bts-download-all>Download all 3 pages</button>
      <button type="button" class="bts-btn" data-bts-reset>Reset checklist</button>
    </div>

    <div id="back-to-school" class="bts-pages">
      {
        pages.map((page, p) => (
          <div class="bts-page-wrap">
            <div class="bts-page-bar">
              <span>Page {p + 1} of {pages.length}</span>
              <button type="button" class="bts-btn bts-btn-small" data-bts-download={p}>
                Download page {p + 1}
              </button>
            </div>
            <div class="bts-page" data-bts-page={p}>
              <div class="bts-head">
                <div class="bts-kicker">Page {p + 1}</div>
                <div class="bts-title">Back to School Checklist</div>
              </div>

              {page.info && (
                <div class="bts-info">
                  <label>
                    <span>Family</span>
                    <input type="text" data-field="family" placeholder="Family name" />
                  </label>
                  <label>
                    <span>School year</span>
                    <input type="text" data-field="year" placeholder="2026–2027" />
                  </label>
                  <label>
                    <span>Child & grade</span>
                    <input type="text" data-field="child" placeholder="Name – grade" />
                  </label>
                </div>
              )}

              {page.sections.map((section, s) => (
                <section class="bts-section">
                  <h2 class="bts-section-title">{section.title}</h2>
                  {section.groups.map((group, g) => {
                    const id = `p${p}-s${s}-g${g}`;
                    return (
                      <div class:list={['bts-group', group.variant && `bts-${group.variant}`]}>
                        <div class="bts-group-title">{group.title}</div>
                        {group.notes ? (
                          <textarea class="bts-notes" data-field={`${id}-notes`} placeholder={group.notes} aria-label={group.title} />
                        ) : (
                          <ul class={`bts-items bts-cols-${group.cols ?? 1}`}>
                            {group.items!.map((item, i) => (
                              <li class="bts-item">
                                <input type="checkbox" data-field={`${id}-${i}-done`} aria-label={item ? `Done: ${item}` : `Done: ${group.title} item ${i + 1}`} />
                                <input
                                  type="text"
                                  data-field={`${id}-${i}`}
                                  value={item}
                                  placeholder={item ? undefined : 'Add an item'}
                                  aria-label={`${group.title} item ${i + 1}`}
                                />
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    );
                  })}
                </section>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <p class="bts-footnote">
      More free tools: the <a href={routes.choreChart} class="text-link">Chore Chart by Age</a>, the weekly
      <a href={routes.planner} class="text-link">Planner</a> and the
      <a href={routes.calendar} data-cta="back-to-school" class="text-link">Family Wall Calendar</a>
    </p>
  </div>
</PublicLayout>

<style is:global>
  .bts-container {
    --bts-ink: var(--color-warm-ink);
    --bts-soft: var(--color-warm-soft);
    --bts-rule: var(--color-warm-rule);
    --bts-rose: var(--color-rose);
    --bts-rose-deep: var(--color-rose-deep);
    --bts-rose-wash: var(--color-rose-wash);
    --bts-sage: var(--color-sage);
    --bts-sage-wash: var(--color-sage-wash);
    background-color: var(--color-ivory);
    padding: 28px 20px 56px;
    color: var(--bts-ink);
  }
  .bts-container *,
  .bts-container *::before,
  .bts-container *::after {
    box-sizing: border-box;
  }

  .bts-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0 auto 24px;
  }
  .bts-btn {
    min-height: 48px;
    padding: 0 24px;
    border: 1px solid var(--color-warm-button);
    border-radius: 3px;
    background: #fff;
    color: var(--color-warm-button);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .bts-btn:hover {
    background: var(--bts-rose-wash);
  }
  .bts-btn-primary {
    background: var(--color-warm-button);
    color: #fff;
  }
  .bts-btn-primary:hover {
    background: #362e2d;
  }
  .bts-btn-small {
    min-height: 40px;
    padding: 0 16px;
    font-size: 0.68rem;
  }
  .bts-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .bts-page-wrap {
    width: 816px;
    max-width: 100%;
    margin: 0 auto 36px;
  }
  .bts-page-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bts-soft);
  }

  /* One page: US Letter portrait (8.5 × 11 in at 96 px/in). */
  .bts-page {
    width: 816px;
    max-width: 100%;
    min-height: 1056px;
    padding: 34px 40px;
    background: var(--color-ivory);
    border: 1px solid var(--bts-rule);
    border-radius: 6px;
    box-shadow: 0 6px 24px rgba(77, 69, 68, 0.08);
    font-family: var(--font-serif);
  }
  .bts-head {
    text-align: center;
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 2px solid var(--bts-rose);
  }
  .bts-kicker {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bts-soft);
  }
  .bts-title {
    font-size: 34px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .bts-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 8px;
  }
  .bts-info label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bts-soft);
  }
  .bts-info input {
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--bts-rule);
    border-radius: 3px;
    background: #fff;
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--bts-ink);
  }
  .bts-section {
    padding-top: 14px;
  }
  .bts-section + .bts-section {
    margin-top: 6px;
    border-top: 1px solid var(--bts-rule);
  }
  .bts-section-title {
    margin-bottom: 8px;
    font-size: 21px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--bts-ink);
  }
  .bts-group {
    margin-bottom: 12px;
  }
  .bts-group-title {
    display: inline-block;
    margin-bottom: 6px;
    padding: 4px 10px;
    border-radius: 3px;
    background: var(--bts-rose-wash);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bts-rose-deep);
  }
  .bts-priority,
  .bts-timeline {
    padding: 12px 14px;
    border-radius: 6px;
  }
  .bts-priority {
    border: 1px dashed var(--bts-rose);
    background: #fff;
  }
  .bts-timeline {
    border: 1px solid var(--bts-sage);
    background: var(--bts-sage-wash);
  }
  .bts-timeline .bts-group-title {
    background: #fff;
    color: #5d6b55;
  }
  .bts-items {
    display: grid;
    gap: 2px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bts-cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .bts-cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .bts-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 28px;
  }
  .bts-item input[type='checkbox'] {
    flex: none;
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--bts-rose-deep);
    cursor: pointer;
  }
  .bts-item input[type='text'] {
    flex: 1;
    min-width: 0;
    height: 26px;
    padding: 0 2px;
    border: none;
    border-bottom: 1px solid var(--bts-rule);
    background: transparent;
    font-family: var(--font-serif);
    font-size: 14px;
    color: var(--bts-ink);
  }
  .bts-item input[type='text']:focus,
  .bts-info input:focus,
  .bts-notes:focus {
    outline: none;
    border-color: var(--bts-rose);
    background-color: var(--bts-rose-wash);
  }
  .bts-item input[type='text']::placeholder,
  .bts-info input::placeholder,
  .bts-notes::placeholder {
    color: #c4b8b2;
  }
  .bts-notes {
    display: block;
    width: 100%;
    height: 86px;
    padding: 0 10px;
    border: 1px solid var(--bts-rule);
    border-radius: 3px;
    background-color: #fff;
    background-image: linear-gradient(transparent 27px, var(--bts-rule) 27px, var(--bts-rule) 28px);
    background-size: 100% 28px;
    background-attachment: local;
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 28px;
    color: var(--bts-ink);
    resize: vertical;
  }
  .bts-exporting .bts-notes {
    resize: none;
  }
  .bts-footnote {
    margin: 12px auto 0;
    text-align: center;
    font-size: 0.95rem;
    line-height: 2;
    color: var(--bts-soft);
  }

  /* Phones and small tablets: single columns, no fixed page height. The PNGs are always the Letter layout. */
  @media (max-width: 768px) {
    .bts-container:not(.bts-exporting) .bts-page {
      min-height: 0;
      padding: 20px 14px;
    }
    .bts-container:not(.bts-exporting) .bts-title {
      font-size: 26px;
    }
    .bts-container:not(.bts-exporting) .bts-info,
    .bts-container:not(.bts-exporting) .bts-items {
      grid-template-columns: 1fr;
    }
    .bts-container:not(.bts-exporting) .bts-item {
      min-height: 36px;
    }
    .bts-container:not(.bts-exporting) .bts-item input[type='checkbox'] {
      width: 20px;
      height: 20px;
    }
    .bts-container:not(.bts-exporting) .bts-item input[type='text'] {
      height: 32px;
      font-size: 15px;
    }
  }
</style>

<script>
  import { autosave, downloadPng, fieldsIn } from '../lib/printable';

  const root = document.getElementById('back-to-school')!;
  const host = root.closest<HTMLElement>('.bts-container')!;
  const pages = Array.from(root.querySelectorAll<HTMLElement>('[data-bts-page]'));
  const save = autosave(root, 'omc:back-to-school:v1');

  // Reset puts the starter items back (their value attribute) rather than blanking them.
  document.querySelector('[data-bts-reset]')!.addEventListener('click', () => {
    if (!confirm('Reset the checklist? Your ticks, notes and changes will be cleared.')) return;
    for (const el of fieldsIn(root)) {
      if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = false;
      else el.value = el.defaultValue;
    }
    save();
  });

  // The PNG would print placeholder hints as if they'd been filled in: drop them while capturing.
  const download = async (p: number, button: HTMLButtonElement) => {
    const hinted = Array.from(pages[p].querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[placeholder]'));
    const hints = hinted.map((el) => el.placeholder);
    hinted.forEach((el) => el.removeAttribute('placeholder'));
    try {
      await capture(p, button);
    } finally {
      hinted.forEach((el, i) => (el.placeholder = hints[i]));
    }
  };

  const capture = (p: number, button: HTMLButtonElement) =>
    downloadPng(pages[p], {
      filename: `back-to-school-checklist-page-${p + 1}.png`,
      width: 816,
      height: 1056,
      layoutHost: host,
      exportClass: 'bts-exporting',
      button,
    });

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-bts-download]')) {
    button.addEventListener('click', () => download(Number(button.dataset.btsDownload), button));
  }

  const all = document.querySelector<HTMLButtonElement>('[data-bts-download-all]')!;
  all.addEventListener('click', async () => {
    for (let p = 0; p < pages.length; p++) await download(p, all);
  });
</script>

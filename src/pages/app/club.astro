---
import Layout from '../../layouts/AppLayout.astro';
import '../../styles/family-app-brand.css';
import AppKitLibrary from '../../components/AppKitLibrary';

---
<Layout title="Club" description="Monthly family tools and kit previews.">
<div class="family-brand mx-auto max-w-4xl">
<!-- Signed-out visitors (and accounts without a membership) see the preview; a member sees her own Club (AppKitLibrary hides this and draws hers). -->
<div id="club-preview-intro">
<header class="ofc-club-intro"><p class="label text-[#71866c]">ORGANIZED FAMILY CLUB</p><h1 class="family-title mt-4">One small win <em class="ofc-rose-emphasis">each month.</em></h1><p class="family-lede mt-4">Practical, prepared tools that help everyone share the work. This is a preview library, not an active membership.</p></header>
<h2 class="family-panel-title mt-9">12 months. 12 things you shouldn’t have to carry alone.</h2><p class="mt-2 text-sm text-warm-soft">Every month helps your family own one more part of everyday life. Preview each personalized tool below.</p>
</div>
<section><AppKitLibrary client:only="react" /></section>
</div>
<style is:global>
/* Club landing palette accents. Calendar month cards retain their own canonical colors. */
.family-brand .ofc-club-intro{background:#eaf2eb;border:1px solid #dde4dc;border-radius:18px;padding:clamp(20px,3vw,32px)}
.family-brand .ofc-rose-emphasis{background:linear-gradient(transparent 73%,#f3d9de 73%,#f3d9de 93%,transparent 93%);-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-inline:.05em}
@media(max-width:639px){.family-brand .ofc-club-intro{padding:20px;border-radius:14px}}

.ofc-app-month-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:24px}
.family-brand .ofc-app-month{display:block!important;min-width:0;overflow:hidden;background:#fff;border:1px solid #dadfd7;border-radius:12px}
.family-brand .ofc-app-month-header{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:148px;padding:22px 20px}
.ofc-app-month-header-text{min-width:0;flex:1}
.ofc-app-month-name{text-transform:uppercase;font-size:11px;font-weight:750;letter-spacing:.12em;color:#354f42;margin:0}
.ofc-app-month-header h3{font-family:Georgia,serif;font-size:1.35rem;line-height:1.2;margin:9px 0 0;color:#303d35}
.ofc-app-month-icon{width:92px;height:92px;display:grid;place-items:center;flex:0 0 92px;background:transparent;border:0}
.family-brand .ofc-app-month-icon img{display:block;background:transparent;width:88px;height:88px;object-fit:contain;mix-blend-mode:multiply}
.family-brand .ofc-app-month-detail{display:block;width:100%;padding:19px 20px 20px;min-width:0}
.ofc-app-month-detail p{font-size:13px;line-height:1.55;color:#555f57;margin:0 0 8px}
.ofc-app-month-detail strong{color:#315d49}
.ofc-app-month-detail a{display:inline-block;margin-top:9px;font-size:13px;font-weight:700;color:#315d49;text-decoration:underline;text-underline-offset:3px}
.ofc-app-month-detail a.ofc-app-month-meeting{display:block;width:max-content;min-height:44px;padding-top:12px;margin-top:0}
@media(max-width:780px){.ofc-app-month-grid{grid-template-columns:1fr}}
/* A member's Club: her Welcome Kit, her months marked as hers, her account. */
.family-brand .ofc-member-kit{background:#fff;border:1px solid #dadfd7;border-radius:12px;padding:20px;margin-top:20px}
.family-brand .ofc-member-kit ul{margin:10px 0 0;padding-left:18px;font-size:14px;line-height:1.6;color:#3d463f}
.family-brand .ofc-member-kit .ofc-kit-status{font-size:14px;color:#555f57;margin:10px 0 0}
.family-brand .ofc-member-cta{display:inline-flex;align-items:center;min-height:44px;margin-top:14px;padding:0 20px;border-radius:24px;background:#545454;color:#fff;font-size:13px;font-weight:700;text-decoration:none}
.family-brand .ofc-app-month-tag{display:inline-block;margin:0 0 8px;padding:3px 9px;border-radius:999px;background:#eef3ea;color:#315d49;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.family-brand .ofc-club-nav-wrap{margin:-8px 0 18px;border:1px solid #dde4dc;border-radius:12px;overflow:hidden}
.family-brand .ofc-club-nav-wrap header{border-bottom:0}
.family-brand .ofc-family-people{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 0;padding:0;list-style:none}
.family-brand .ofc-family-people li{padding:4px 12px;border-radius:999px;background:#fff;border:1px solid #dde4dc;font-size:14px;color:#303d35}
.family-brand .ofc-family-people li span{color:#71866c}
.family-brand .ofc-home-link,.family-brand .ofc-member-kit .ofc-kit-status a{display:inline-block;margin-top:12px;font-size:14px;font-weight:700;color:#315d49;text-decoration:underline;text-underline-offset:3px}
.family-brand .ofc-member-kit .ofc-kit-status a{margin-top:0}
.family-brand #months{scroll-margin-top:24px}
.family-brand .ofc-member-account{margin-top:28px;font-size:14px;color:#555f57}
.family-brand .ofc-member-account a{color:#315d49;font-weight:700;text-decoration:underline;text-underline-offset:3px}
@media(max-width:430px){.ofc-app-month-header{min-height:124px;padding:16px 14px;gap:9px}.ofc-app-month-icon{width:72px;height:72px;flex-basis:72px}.ofc-app-month-icon img{width:70px;height:70px}.ofc-app-month-header h3{font-size:1.2rem}.ofc-app-month-detail{padding:14px}}
</style>
</Layout>

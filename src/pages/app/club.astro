---
import Layout from '../../layouts/AppLayout.astro';
import '../../styles/family-app-brand.css';
import AppKitLibrary from '../../components/AppKitLibrary';

---
<Layout title="Club" description="Monthly family tools and kit previews.">
<div class="family-brand mx-auto max-w-4xl">
<header><p class="label text-[#71866c]">ORGANIZED FAMILY CLUB</p><h1 class="family-title mt-4">One small win <em>each month.</em></h1><p class="family-lede mt-4">Practical, prepared tools that help everyone share the work. This is a preview library, not an active membership.</p></header>
<section class="mt-9"><h2 class="family-panel-title">12 months. 12 things you shouldn’t have to carry alone.</h2><p class="mt-2 text-sm text-warm-soft">Every month helps your family own one more part of everyday life. Preview each personalized tool below.</p><AppKitLibrary client:only="react" /></section>
</div>
<style is:global>
.ofc-app-month-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:24px}
.ofc-app-month{display:grid;grid-template-columns:86px minmax(0,1fr);gap:16px;align-items:start;padding:20px;background:#fff;border:1px solid #dadfd7;border-radius:12px;min-width:0}
.ofc-app-month-icon{width:86px;height:86px;display:grid;place-items:center;background:#f3f5ef;border-radius:8px}
.ofc-app-month-icon img{width:76px;height:76px;object-fit:contain}
.ofc-app-month-detail{min-width:0}
.ofc-app-month-name{text-transform:uppercase;font-size:11px;font-weight:750;letter-spacing:.12em;color:#527468}
.ofc-app-month-detail h3{font-family:Georgia,serif;font-size:1.35rem;line-height:1.2;margin:7px 0 14px;color:#353d36}
.ofc-app-month-detail p:not(.ofc-app-month-name){font-size:13px;line-height:1.55;color:#555f57;margin:0 0 8px}
.ofc-app-month-detail strong{color:#315d49}
.ofc-app-month-detail a{display:inline-block;margin-top:9px;font-size:13px;font-weight:700;color:#315d49;text-decoration:underline;text-underline-offset:3px}
@media(max-width:780px){.ofc-app-month-grid{grid-template-columns:1fr}}
@media(max-width:430px){.ofc-app-month{grid-template-columns:68px minmax(0,1fr);gap:12px;padding:14px}.ofc-app-month-icon{width:68px;height:68px}.ofc-app-month-icon img{width:60px;height:60px}.ofc-app-month-detail h3{font-size:1.2rem}}
</style>
</Layout>
---
import Layout from '../../layouts/AppLayout.astro';
import '../../styles/family-app-brand.css';
import AppKitLibrary from '../../components/AppKitLibrary';

---
<Layout title="Club" description="Monthly family tools and kit previews.">
<div class="family-brand mx-auto max-w-4xl">
<header><p class="label text-[#71866c]">ORGANIZED FAMILY CLUB</p><h1 class="family-title mt-4">One small win <em>each month.</em></h1><p class="family-lede mt-4">Practical, prepared tools that help everyone share the work. This is a preview library, not an active membership.</p></header>
<section class="mt-9"><h2 class="family-panel-title">12 months. 12 things you shouldn’t have to carry alone.</h2><p class="mt-2 text-sm text-warm-soft">Every month helps your family own one more part of everyday life. Preview each personalized tool below.</p><AppKitLibrary client:only="react" /></section>
</div>
<style is:global>
/* Scoped to the Club library to avoid changing the other app tabs. */
.family-brand .ofc-app-month-grid{
  display:grid!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:18px;
  margin-top:24px;
}
.family-brand .ofc-app-month{
  display:flex!important;
  flex-direction:column!important;
  min-width:0!important;
  overflow:hidden;
  background:#fffdfa!important;
  border:1px solid #e5e3dc!important;
  border-radius:18px!important;
  box-shadow:0 3px 12px rgba(47,63,52,.035);
}
.family-brand .ofc-app-month-header{
  display:flex!important;
  flex-direction:row!important;
  width:100%!important;
  flex:none!important;
  align-items:center!important;
  justify-content:space-between!important;
  min-width:0!important;
  gap:14px!important;
  padding:22px!important;
  min-height:154px!important;
  background:#e5f1e9!important;
}
.family-brand .ofc-app-month:nth-child(4n+2) .ofc-app-month-header{background:#f7e9ec!important}
.family-brand .ofc-app-month:nth-child(4n+3) .ofc-app-month-header{background:#f2efe4!important}
.family-brand .ofc-app-month:nth-child(4n+4) .ofc-app-month-header{background:#e8eef0!important}
.family-brand .ofc-app-month-header-text{flex:1 1 0!important;min-width:0!important;width:auto!important}
.family-brand .ofc-app-month-name{
  display:block;
  margin:0!important;
  font-size:11px!important;
  line-height:1.4!important;
  text-transform:uppercase;
  font-weight:750;
  letter-spacing:.14em;
  color:#476c5b;
}
.family-brand .ofc-app-month:nth-child(4n+2) .ofc-app-month-name{color:#92616c}
.family-brand .ofc-app-month-header h3{
  font-family:Georgia,serif!important;
  font-size:clamp(1.2rem,2.2vw,1.5rem)!important;
  line-height:1.19!important;
  font-weight:400!important;
  color:#443f3d!important;
  margin:9px 0 0!important;
  overflow-wrap:normal!important;
}
.family-brand .ofc-app-month-icon{
  display:grid!important;
  flex:0 0 82px!important;
  width:82px!important;
  height:82px!important;
  place-items:center;
  background:rgba(255,255,255,.65)!important;
  border-radius:50%!important;
}
.family-brand .ofc-app-month-icon img{
  display:block;
  width:72px!important;
  height:72px!important;
  object-fit:contain;
  background:transparent!important;
  mix-blend-mode:multiply;
}
.family-brand .ofc-app-month-detail{
  display:flex!important;
  flex-direction:column!important;
  flex:1 1 auto!important;
  width:100%!important;
  min-width:0!important;
  padding:20px 22px 22px!important;
  background:transparent!important;
}
.family-brand .ofc-app-month-detail p{
  margin:0 0 10px!important;
  font-size:14px!important;
  line-height:1.55!important;
  color:#625f5b!important;
}
.family-brand .ofc-app-month-detail strong{color:#315d49}
.family-brand .ofc-app-month-detail a{
  display:flex!important;
  align-items:center;
  justify-content:center;
  text-align:center;
  margin-top:auto!important;
  padding:12px 14px!important;
  min-height:44px;
  background:#315d49!important;
  border-radius:8px;
  color:#fff!important;
  font-size:13px!important;
  font-weight:700!important;
  text-decoration:none!important;
}
.family-brand .ofc-app-month-detail a:hover{background:#254a39!important}
@media(max-width:780px){
  .family-brand .ofc-app-month-grid{grid-template-columns:1fr!important;gap:14px}
}
@media(max-width:639px){
  .family-brand .family-title{font-size:clamp(2rem,8vw,2.6rem)!important;line-height:1.1}
  .family-brand .family-lede{font-size:.99rem!important;line-height:1.55!important}
  .family-brand .ofc-app-month-header{
    min-height:0!important;
    padding:18px!important;
    gap:14px!important;
  }
  .family-brand .ofc-app-month-header h3{font-size:1.4rem!important}
  .family-brand .ofc-app-month-icon{flex:0 0 76px!important;width:76px!important;height:76px!important}
  .family-brand .ofc-app-month-icon img{width:66px!important;height:66px!important}
  .family-brand .ofc-app-month-detail{padding:17px 18px 18px!important}
  .family-brand .ofc-app-month-detail p{font-size:14px!important}
}
@media(max-width:350px){
  .family-brand .ofc-app-month-header h3{font-size:1.22rem!important}
  .family-brand .ofc-app-month-icon{flex-basis:62px!important;width:62px!important;height:62px!important}
  .family-brand .ofc-app-month-icon img{width:56px!important;height:56px!important}
}
</style>
</Layout>
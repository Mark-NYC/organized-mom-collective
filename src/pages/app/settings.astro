---
import Layout from '../../layouts/AppLayout.astro';
import SettingsApp from '../../components/SettingsApp';
import { SUPPORT_EMAIL } from '../../data/support';
import { calendarPath } from '../../lib/companion';
const support = calendarPath(Astro.url.pathname) ? `mailto:${SUPPORT_EMAIL}` : '/support';
---

<Layout title="Settings">
  <div class="max-w-xl">
    <h1 class="page-title">Settings</h1>
    <p class="mt-3 text-muted">Your progress is saved on this device only. Checkmarks aren’t shared with other phones.</p>
    <div class="mt-10">
      <SettingsApp client:only="react">
        <div slot="fallback" class="h-60"></div>
      </SettingsApp>
    </div>
    {calendarPath(Astro.url.pathname) && (
      <section aria-labelledby="calendar-setup-h" class="mt-8 border-t border-rule pt-7">
        <h2 id="calendar-setup-h" class="font-serif text-[1.4rem] text-ink">Set up your calendar together</h2>
        <p class="mt-2 text-soft">Want to revisit the family meeting, colors, or where to hang your calendar? You can repeat the walkthrough anytime without losing your cleaning progress.</p>
        <a href="/app/calendar?setup=1" class="btn-secondary mt-4">Review calendar setup</a>
      </section>
    )}
    <section aria-labelledby="help-h" class="mt-6 border-t border-rule pt-8">
      <h2 id="help-h" class="label">Help &amp; Support</h2>
      <p class="mt-3 text-soft">Questions about the cleaning companion, your calendar or your order? We’re happy to help.</p>
      <a href={support} class="btn-secondary mt-4">Get help</a>
    </section>
  </div>
</Layout>

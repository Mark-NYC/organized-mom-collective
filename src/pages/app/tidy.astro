---
/**
 * /app/tidy — the Week page's old address. Kept so earlier links, bookmarks and
 * Home Screen shortcuts still work; it forwards to /app/week, keeping any
 * ?query and #hash (e.g. #monthly-focus).
 *
 * Same pattern as /start: location.replace (so Back doesn't bounce through here),
 * with a meta refresh and a plain link as fallbacks. It sits under /app, so the
 * service worker saves it too and the redirect works offline.
 */
import { routes } from '../../routes';

const WEEK = routes.week;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Week · Organized Mom</title>
    <link rel="canonical" href={WEEK} />
    <script is:inline define:vars={{ WEEK }}>
      location.replace(WEEK + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${WEEK}`} />
  </head>
  <body style="font-family: system-ui, sans-serif; color: #545454; padding: 2rem;">
    <a href={WEEK}>Open your week</a>
  </body>
</html>

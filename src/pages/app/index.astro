---
import Layout from '../../layouts/AppLayout.astro';
import '../../styles/family-app-brand.css';
import HomeStatus from '../../components/HomeStatus';
import { dailyEssentials, weeklySchedule } from '../../data/cleaning';
const now = new Date();
const today = new Intl.DateTimeFormat('en-US',{weekday:'long',month:'long',day:'numeric'}).format(now);
const zone = weeklySchedule.find(d => Number(d.day) === now.getDay());
---
<Layout title="Home" description="Your family, your rhythm, one place.">
  <div class="family-brand mx-auto max-w-4xl space-y-9">
    <header><p class="label text-[#71866c]">YOUR FAMILY HOME · {today}</p><h1 class="family-title mt-4">A little more calm <em class="text-[#71866c]">today.</em></h1><p class="family-lede mt-4">One place for the plan, the daily reset, and your family's tools.</p></header>
    <section class="family-feature" aria-label="Today's cleaning"><div class="flex items-center justify-between gap-3"><p class="label text-[#5c7357]">TODAY'S RESET</p><span class="family-preview-pill">10–15 minutes</span></div><h2 class="family-panel-title mt-5">{zone?.zone ?? 'A fresh start for home'}</h2><p class="mt-2 text-[0.95rem] leading-relaxed text-warm-soft">Your {dailyEssentials.tasks.length} daily essentials and today's cleaning zone. Your existing checkmarks are ready whenever you are.</p><HomeStatus client:only="react" />
<a href="/app/cleaning" class="family-action mt-6">Open today's cleaning <span aria-hidden="true" class="ml-2">→</span></a></section>
    <div class="family-card-grid">
      <a href="/app/club" class="family-panel block transition-colors hover:bg-[#f8f8f6]"><p class="label text-[#71866c]">FAMILY CLUB</p><h2 class="family-panel-title mt-4">Good things, done together.</h2><p class="mt-2 text-sm leading-relaxed text-warm-soft">Explore your monthly family kits, including the October Sunday Reset preview.</p><span class="family-link mt-5">Explore Club →</span></a>
      <a href="/app/account" class="family-panel block transition-colors hover:bg-[#f8f8f6]"><p class="label text-[#71866c]">YOUR FAMILY</p><h2 class="family-panel-title mt-4">Everyone has a part.</h2><p class="mt-2 text-sm leading-relaxed text-warm-soft">See how your family's details will connect with prepared monthly tools.</p><span class="family-link mt-5">View family →</span></a>
    </div>
  </div>
</Layout>
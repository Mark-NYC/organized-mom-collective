---
/**
 * Today (/app): the family dashboard, the same on the website and in the iPhone app (docs/ios/APP_DESIGN_SYSTEM.md).
 * Everything date-based renders on the device (TodayDashboard), never at build time. The Inbox is planned
 * (src/data/app/features.ts) and not shown.
 */
import Layout from '../../layouts/AppLayout.astro';
import { TodayDate } from '../../components/app/TodayOverview';
import TodayDashboard from '../../components/app/TodayDashboard';
---
<Layout title="Today" description="Today's plans, cleaning and this week's Family Meeting, in one place.">
  <div class="family-brand of-page">
    <header class="mb-6 sm:mb-8">
      <p class="of-eyebrow">Today · <TodayDate client:only="react" /></p>
      <h1 class="of-page-title mt-3">A little more calm <em>today.</em></h1>
    </header>
    <TodayDashboard client:only="react"><div slot="fallback" class="of-tile h-40" aria-busy="true"></div></TodayDashboard>
  </div>
</Layout>

---
/**
 * /app/family: the Family tab (website and iPhone app; docs/ios/OMC_APP_ROADMAP.md, docs/ios/APP_DESIGN_SYSTEM.md). Our
 * Family Meeting first (the Club's existing four-part, ten-minute meeting; its guide and monthly pages are unchanged),
 * then the family, who does what, sharing with the other grown-up and the Family Meeting Club. Account is the profile
 * icon in the header.
 */
import Layout from '../../../layouts/AppLayout.astro';
import FamilyHub from '../../../components/family/FamilyHub';
---
<Layout title="Family" description="Our Family Meeting, the family, and who does what.">
  <div class="family-brand of-page max-w-4xl" data-family-hub>
    <header>
      <p class="of-eyebrow">Family</p>
      <h1 class="of-page-title mt-3">A home where everyone <em>plays a part.</em></h1>
    </header>
    <FamilyHub client:only="react"><div slot="fallback" class="of-tile mt-6 h-72" aria-busy="true"></div></FamilyHub>
  </div>
</Layout>

---
import Layout from '../../layouts/AppLayout.astro';
import TodayApp from '../../components/TodayApp';
import CleaningParts from '../../components/app/CleaningParts';
---
<Layout title="Cleaning" description="Your existing Daily Reset and cleaning companion.">
  <div class="mx-auto max-w-3xl">
    <div class="mb-7"><p class="label text-[#71866c]">CLEANING COMPANION</p><p class="mt-2 text-sm text-warm-soft">Same daily rhythm. <span data-device-only>Your saved progress stays on this device.</span></p></div>
    <TodayApp client:only="react"><div slot="fallback" class="h-96" aria-busy="true"></div></TodayApp>
    <CleaningParts client:only="react" />
  </div>
</Layout>
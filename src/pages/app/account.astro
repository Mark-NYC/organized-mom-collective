---
/**
 * Account (/app/account, the profile icon): the family, sharing, membership, sign-in and account deletion, the same on
 * the website and in the iPhone app (billing links on the website only: FamilySummary.tsx). docs/ios/APP_DESIGN_SYSTEM.md.
 */
import Layout from '../../layouts/AppLayout.astro';
import FamilySummary from '../../components/FamilySummary';
import { Chevron, Icon } from '../../components/app/ui';
---
<Layout title="Account" description="Your family, who shares it, your membership and your sign-in.">
  <div class="family-brand of-page max-w-3xl">
    <header>
      <p class="of-eyebrow">Organized Family · Account</p>
      <h1 class="of-page-title mt-3">The people <em>behind the plan.</em></h1>
      <p class="of-page-lede">Your family, who shares it with you, and your sign-in.</p>
    </header>
    <FamilySummary client:only="react" />
    <p class="of-group-title">Settings</p>
    <nav class="of-list" aria-label="Settings">
      <a href="/app/settings" class="of-list-item"><span class="of-icon-box of-icon-box--sage"><Icon name="check" /></span><span class="min-w-0 flex-1"><span class="block font-semibold">Cleaning preferences</span><span class="block text-[0.8rem] text-warm-soft">Reset checklists, the welcome screen</span></span><Chevron /></a>
      <a href="/support" class="of-list-item"><span class="of-icon-box"><Icon name="help" /></span><span class="min-w-0 flex-1"><span class="block font-semibold">Help &amp; support</span><span class="block text-[0.8rem] text-warm-soft">Questions about the calendar, cleaning or your family's plans? We're here.</span></span><Chevron /></a>
    </nav>
  </div>
</Layout>

---
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
---
<AppLayout title="February · Kids Laundry Ownership">
<div class="laundry-page family-brand" data-laundry-app>
  <aside class="laundry-rail">
    <a href="/app/club/" class="laundry-back">← Back to Club</a>
    <p class="laundry-kicker">FEBRUARY · KIT PREVIEW</p>
    <h1>My Laundry,<br/><em>My Job.</em></h1>
    <p class="laundry-intro">A simple handoff for the clothes your kids wear. Everyone knows their part, and Mom doesn't have to chase the laundry.</p>
    <section class="laundry-controls" aria-label="Customize February plan">
      <p class="laundry-kicker">YOUR FAMILY'S PREPARED PLAN</p>
      <label>Family name<input data-family maxlength="36" value="Rivera" /></label>
      <div class="laundry-child"><label>Child 1<input data-name="0" maxlength="24" value="Sofia" /></label><label>Ownership level<select data-level="0"><option value="helper">Laundry helper</option><option value="clothes" selected>Clothes owner</option><option value="apprentice">Laundry apprentice</option><option value="full">Laundry owner</option></select></label></div>
      <div class="laundry-child"><label>Child 2<input data-name="1" maxlength="24" value="Mateo" /></label><label>Ownership level<select data-level="1"><option value="helper">Laundry helper</option><option value="clothes" selected>Clothes owner</option><option value="apprentice">Laundry apprentice</option><option value="full">Laundry owner</option></select></label></div>
      <label>Laundry day<select data-day><option>Saturday</option><option>Sunday</option><option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option><option>As needed</option></select></label>
      <label>Machine operator<input data-operator maxlength="28" value="Dad" /></label>
      <p class="laundry-hint">Suggested levels are starting points. Choose what each child can safely do. Adults supervise machine use until a child is trained.</p>
    </section>
    <div class="laundry-actions"><button type="button" class="laundry-main" data-print>Download and print</button><button type="button" data-reset>Restore sample plan</button></div>
    <p class="laundry-disclaimer">Prototype preview only. Changes are saved in this browser, not submitted for mailing or approval.</p>
  </aside>
  <main class="laundry-preview" aria-label="February two-sided printable preview">
    <div class="laundry-preview-head"><span>Your February printable</span><span>Front + back · Letter size</span></div>
    <div class="laundry-paper-stack">
      <article class="laundry-paper" aria-label="Front of February printable">
        <header class="paper-header"><span>ORGANIZED FAMILY CLUB · FEBRUARY</span><span>01 / FRONT</span></header>
        <div class="paper-top"><div><span class="paper-eyebrow">THE <b data-family-print>RIVERA</b> FAMILY</span><h2>My Laundry,<br/><em>My Job.</em></h2><p>Everybody wears clothes. Everybody can help care for them.</p></div><div class="icon-placeholder hero-icon">LAUNDRY<br/>BASKET<br/>ICON</div></div>
        <div class="paper-rule"></div><h3 class="paper-section-title">Here's what each of us owns.</h3>
        <div data-print-children>
          <section class="ownership-card"><div class="ownership-icon icon-placeholder">SHIRT<br/>ICON</div><div><h3>Sofia <span>· Clothes owner</span></h3><ol><li>Put dirty clothes in my hamper.</li><li>Bring my hamper on laundry day.</li><li>Put clean clothes into my drawers.</li></ol></div></section>
          <section class="ownership-card"><div class="ownership-icon icon-placeholder">SHIRT<br/>ICON</div><div><h3>Mateo <span>· Clothes owner</span></h3><ol><li>Put dirty clothes in my hamper.</li><li>Bring my hamper on laundry day.</li><li>Put clean clothes into my drawers.</li></ol></div></section>
        </div>
        <div class="operator"><div class="icon-placeholder operator-icon">WASHER<br/>ICON</div><p><strong><span data-operator-print>Dad</span> owns the machines.</strong><br/>Wash and dry the loads on <span data-day-print>Saturday</span>. Help kids learn safely.</p></div>
        <div class="paper-callout"><span>OUR FAMILY LAUNDRY RULE</span><strong>Dirty clothes in. Clean clothes away.</strong><p>The job isn't finished until the clothes are put away.</p></div>
        <footer class="paper-footer"><span>ORGANIZED FAMILY CLUB</span><span>OUR LAUNDRY PLAN · FEBRUARY</span></footer>
      </article>
      <article class="laundry-paper laundry-back-paper" aria-label="Back of February printable">
        <header class="paper-header"><span>ORGANIZED FAMILY CLUB · FEBRUARY</span><span>02 / BACK</span></header>
        <div class="back-intro"><span class="paper-eyebrow">FOLLOW THE CLOTHES</span><h2>From hamper <em>to drawer.</em></h2><p>One simple path. The whole family can follow it.</p></div>
        <div class="laundry-steps">
          <div class="laundry-step"><div class="icon-placeholder">HAMPER<br/>ICON</div><div><span>01</span><h3>Collect</h3><p>Dirty clothes belong in the hamper.</p></div></div>
          <div class="laundry-step"><div class="icon-placeholder">WASHER<br/>ICON</div><div><span>02</span><h3>Wash</h3><p>The machine operator starts the load.</p></div></div>
          <div class="laundry-step"><div class="icon-placeholder">DRYER<br/>ICON</div><div><span>03</span><h3>Dry</h3><p>Move clothes to the dryer or drying rack.</p></div></div>
          <div class="laundry-step"><div class="icon-placeholder">FOLDED<br/>SHIRT ICON</div><div><span>04</span><h3>Fold or hang</h3><p>Get each item ready to put away.</p></div></div>
          <div class="laundry-step"><div class="icon-placeholder">DRESSER<br/>ICON</div><div><span>05</span><h3>Put away</h3><p>Clothes return to drawers or closets.</p></div></div>
        </div>
        <div class="megan-note"><span>A NOTE FROM MEGAN</span><p>Start small. Show your kids what done looks like, then give them room to own it. A little practice now means fewer reminders later.</p><strong>You've got this, Megan</strong></div>
        <footer class="paper-footer"><span>ORGANIZED FAMILY CLUB</span><span>MY LAUNDRY, MY JOB · FEBRUARY</span></footer>
      </article>
    </div>
  </main>
</div>
</AppLayout>
<style is:global>
.laundry-page{--ink:#49403d;--soft:#827b72;--sage:#55735d;--rule:#ddd9d0;--rose:#9a6876;font-family:var(--font-sans,Arial,sans-serif);color:var(--ink);background:#fffdfa;min-height:100vh}
.laundry-rail{padding:32px 22px 48px;background:#fffdfa}
.laundry-back{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);text-decoration:underline;text-underline-offset:6px;margin-bottom:30px}
.laundry-kicker{font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:var(--soft)}
.laundry-rail h1{font:400 43px/1.1 var(--font-serif,Georgia,serif);letter-spacing:-.025em;margin:15px 0}.laundry-rail h1 em,.laundry-paper h2 em{color:var(--rose);font-weight:400}
.laundry-intro{font-size:14px;line-height:1.75;color:var(--soft);margin-bottom:28px}
.laundry-controls{border-top:1px solid var(--rule);padding-top:20px}.laundry-controls .laundry-kicker{margin:0 0 18px}
.laundry-controls label{display:block;font-size:12px;font-weight:700;margin:15px 0;color:var(--ink)}
.laundry-controls input,.laundry-controls select{display:block;width:100%;min-height:43px;border:1px solid #d7d3cc;background:#fff;border-radius:3px;padding:10px;font:400 14px var(--font-sans,Arial,sans-serif);margin-top:7px;color:var(--ink)}
.laundry-child{border-top:1px solid #eae6e0;margin-top:18px;padding-top:3px}.laundry-hint,.laundry-disclaimer{font-size:12px;line-height:1.65;color:var(--soft)}
.laundry-actions{display:grid;gap:9px;margin:22px 0}.laundry-actions button{min-height:48px;border:1px solid var(--ink);border-radius:3px;padding:12px 14px;font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.laundry-actions .laundry-main{background:#514541;color:white}
.laundry-preview{background:#ebeae6;padding:28px 16px 80px;min-width:0}.laundry-preview-head{display:flex;justify-content:space-between;gap:10px;font-size:11px;color:#716e68;max-width:820px;margin:0 auto 18px}
.laundry-paper-stack{display:flex;flex-direction:column;align-items:center;gap:26px}.laundry-paper{width:816px;height:1056px;flex:none;position:relative;overflow:hidden;background:#fffefa;box-shadow:0 10px 34px #3d383122;padding:52px 59px 46px;font-family:var(--font-sans,Arial,sans-serif);color:#514b45}
.paper-header,.paper-footer{display:flex;justify-content:space-between;align-items:center;font-size:10px;letter-spacing:.16em;font-weight:700;color:#7b8175}.paper-header{border-bottom:1px solid #d5d9cf;padding-bottom:16px}.paper-footer{position:absolute;bottom:36px;left:59px;right:59px;border-top:1px solid #d5d9cf;padding-top:14px;font-size:9px}
.paper-top{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-top:42px}.paper-eyebrow{font-size:11px;letter-spacing:.16em;color:#71806f;font-weight:700}.paper-top h2,.back-intro h2{font:400 53px/1.05 var(--font-serif,Georgia,serif);letter-spacing:-.03em;margin:15px 0}.paper-top p,.back-intro p{font-size:14px;color:#80766e;line-height:1.65;max-width:380px}
.icon-placeholder{border:1.5px dashed #adada4;background:#f7f5f0;color:#98948c;display:flex;align-items:center;justify-content:center;text-align:center;font-size:10px;line-height:1.35;letter-spacing:.06em;font-weight:700;flex:none}
.hero-icon{width:150px;height:150px;border-radius:50%}.paper-rule{border-top:1px solid #d8d7d0;margin:34px 0 24px}.paper-section-title{font:400 24px var(--font-serif,Georgia,serif);margin-bottom:20px}
.ownership-card{display:flex;gap:20px;border:1px solid #e2e1d8;background:#faf9f5;padding:23px;margin-bottom:16px;min-height:180px}.ownership-icon{width:86px;height:86px;border-radius:50%}.ownership-card h3{font:400 26px var(--font-serif,Georgia,serif);margin:0 0 11px}.ownership-card h3 span{font:500 12px var(--font-sans,Arial,sans-serif);color:#777f72}.ownership-card ol{padding-left:18px;margin:0}.ownership-card li{font-size:13px;line-height:1.7}
.operator{display:flex;align-items:center;gap:18px;margin:23px 0}.operator-icon{height:68px;width:68px}.operator p{font-size:13px;line-height:1.7;margin:0}.paper-callout{background:#e5eee5;padding:22px 25px;margin-top:20px}.paper-callout span,.megan-note span{display:block;color:#57715e;font-size:10px;letter-spacing:.16em;font-weight:800;margin-bottom:8px}.paper-callout strong{font:400 23px var(--font-serif,Georgia,serif)}.paper-callout p{font-size:12px;margin:6px 0 0}
.back-intro{margin:43px 0 29px}.back-intro h2{font-size:48px}.laundry-steps{display:grid;gap:10px}.laundry-step{display:grid;grid-template-columns:94px 35px 1fr;align-items:center;gap:20px;border-bottom:1px solid #e1e0da;padding:10px 0}.laundry-step .icon-placeholder{width:88px;height:88px}.laundry-step span{font:400 27px var(--font-serif,Georgia,serif);color:#8b9a89}.laundry-step h3{font:400 22px var(--font-serif,Georgia,serif);margin:0 0 5px}.laundry-step p{font-size:12px;color:#7c736b;margin:0}.megan-note{background:#f6edef;padding:22px 27px;margin-top:30px}.megan-note span{color:#9a6876}.megan-note p{font:italic 17px/1.55 var(--font-serif,Georgia,serif);margin:5px 0 9px}.megan-note strong{font:400 15px var(--font-serif,Georgia,serif)}
@media(min-width:1100px){html:has(.laundry-page),body:has(.laundry-page){height:100%;overflow:hidden}body:has(.laundry-page) #main{max-width:none!important;width:100%;height:calc(100dvh - 64px);min-height:0;overflow:hidden;padding:0!important;margin:0!important}.laundry-page{height:100%;min-height:0;display:grid;grid-template-columns:minmax(310px,375px) minmax(0,1fr);overflow:hidden}.laundry-rail{height:100%;overflow-y:auto;border-right:1px solid #dedbd2;padding:clamp(36px,5vh,56px) clamp(24px,2.6vw,42px) 40px}.laundry-preview{height:100%;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;padding:clamp(32px,4vw,58px) 24px 90px}.laundry-preview-head{max-width:816px}}
@media screen and (max-width:1099px){.laundry-paper-stack{transform-origin:top center}.laundry-preview{overflow:hidden}.laundry-paper{transform-origin:top center;margin-bottom:0}}
@media print{@page{size:letter;margin:0}html,body{margin:0!important;padding:0!important;background:#fff!important}.laundry-page{display:block!important;background:white!important}.laundry-rail,.laundry-preview-head,body:has(.laundry-page) [data-chrome]{display:none!important}.laundry-preview{display:block!important;background:#fff!important;overflow:visible!important;padding:0!important;margin:0!important;height:auto!important}.laundry-paper-stack{display:block!important;transform:none!important}.laundry-paper{width:8.5in!important;height:11in!important;padding:52px 59px 46px!important;transform:none!important;box-shadow:none!important;margin:0!important;break-after:page;page-break-after:always}.laundry-paper:last-child{break-after:auto;page-break-after:auto}}
</style>
<script>
type Level='helper'|'clothes'|'apprentice'|'full';
type State={family:string;children:{name:string;level:Level}[];day:string;operator:string};
const root=document.querySelector<HTMLElement>('[data-laundry-app]');
if(root){
 const defaults:State={family:'Rivera',children:[{name:'Sofia',level:'clothes'},{name:'Mateo',level:'clothes'}],day:'Saturday',operator:'Dad'};
 const key='omc:club:february-laundry:v1';
 const q=<T extends HTMLElement>(s:string)=>root.querySelector<T>(s)!;
 let state:State=structuredClone(defaults);
 try{const raw=localStorage.getItem(key);if(raw){const parsed=JSON.parse(raw);if(parsed?.children?.length===2)state={...defaults,...parsed}}}catch{}
 const steps:Record<Level,string[]>={helper:['Put dirty clothes in my hamper.','Match socks with a grown-up.','Put away my simple clothes.'],clothes:['Put dirty clothes in my hamper.','Bring my hamper on laundry day.','Put clean clothes into my drawers.'],apprentice:['Collect and sort my dirty clothes.','Help a grown-up start the machines.','Fold or hang and put away my clothes.'],full:['Check if my clothes need washing.','Wash and dry safely after training.','Fold, hang, and put everything away.']};
 const levels:Record<Level,string>={helper:'Laundry helper',clothes:'Clothes owner',apprentice:'Laundry apprentice',full:'Laundry owner'};
 const update=()=>{q<HTMLInputElement>('[data-family]').value=state.family;q<HTMLElement>('[data-family-print]').textContent=state.family.toUpperCase();q<HTMLElement>('[data-operator-print]').textContent=state.operator;q<HTMLElement>('[data-day-print]').textContent=state.day;q<HTMLInputElement>('[data-operator]').value=state.operator;q<HTMLSelectElement>('[data-day]').value=state.day;
  const cards=q<HTMLElement>('[data-print-children]');cards.replaceChildren();
  state.children.forEach((c,i)=>{q<HTMLInputElement>(`[data-name="${i}"]`).value=c.name;q<HTMLSelectElement>(`[data-level="${i}"]`).value=c.level;const section=document.createElement('section');section.className='ownership-card';const icon=document.createElement('div');icon.className='ownership-icon icon-placeholder';icon.textContent='SHIRT ICON';const info=document.createElement('div');const h=document.createElement('h3');h.append(document.createTextNode(c.name+' '));const sub=document.createElement('span');sub.textContent='· '+levels[c.level];h.append(sub);const list=document.createElement('ol');steps[c.level].forEach(s=>{const li=document.createElement('li');li.textContent=s;list.append(li)});info.append(h,list);section.append(icon,info);cards.append(section)});
  try{localStorage.setItem(key,JSON.stringify(state))}catch{}
 };
 q<HTMLInputElement>('[data-family]').addEventListener('input',e=>{state.family=(e.currentTarget as HTMLInputElement).value;update()});
 q<HTMLInputElement>('[data-operator]').addEventListener('input',e=>{state.operator=(e.currentTarget as HTMLInputElement).value;update()});
 q<HTMLSelectElement>('[data-day]').addEventListener('change',e=>{state.day=(e.currentTarget as HTMLSelectElement).value;update()});
 [0,1].forEach(i=>{q<HTMLInputElement>(`[data-name="${i}"]`).addEventListener('input',e=>{state.children[i].name=(e.currentTarget as HTMLInputElement).value;update()});q<HTMLSelectElement>(`[data-level="${i}"]`).addEventListener('change',e=>{state.children[i].level=(e.currentTarget as HTMLSelectElement).value as Level;update()})});
 q<HTMLButtonElement>('[data-reset]').addEventListener('click',()=>{state=structuredClone(defaults);update()});
 q<HTMLButtonElement>('[data-print]').addEventListener('click',()=>window.print());
 const resize=()=>{if(window.innerWidth>=1100){root.querySelectorAll<HTMLElement>('.laundry-paper').forEach(p=>{p.style.transform='';p.style.marginBottom='' });return}const w=q<HTMLElement>('.laundry-preview').clientWidth-32;const s=Math.min(1,w/816);root.querySelectorAll<HTMLElement>('.laundry-paper').forEach(p=>{p.style.transform=`scale(${s})`;p.style.marginBottom=`${1056*(s-1)}px`});};
 update();resize();window.addEventListener('resize',resize);
 window.addEventListener('beforeprint',()=>root.querySelectorAll<HTMLElement>('.laundry-paper').forEach(p=>{p.style.transform='';p.style.marginBottom=''}));window.addEventListener('afterprint',resize);
}
</script>

---
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import FebruaryConnectionCards from '../../../components/club/FebruaryConnectionCards.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find(k => k.month === '2027-02');
if (!kit) throw new Error('February kit missing');
const deadline = clubEditingDeadline(kit.month);
---
<AppLayout title="February Connection Cards">
 <div class="feb-app family-brand" data-slug={kit.slug} data-deadline={deadline} data-state="loading">
  <div class="feb-gate" data-gate role="status">Preparing your family’s invitations…</div>
  <div class="feb-content" hidden>
   <div class="feb-mobile">
    <header><a class="feb-back" href="/app/club/">← Back to Club</a><p class="feb-kicker">FEBRUARY · ORGANIZED FAMILY CLUB</p><h1>More connection. <em>Less coordinating.</em></h1><p data-family></p><span class="feb-sample" data-sample hidden>Sample family</span></header>
    <div class="feb-status"><strong data-review>Preview only · Review is optional</strong><p data-window></p></div>
    <button class="feb-proof-link" type="button" data-show-proof><span><strong>Your printable</strong><small>Four invitations on one page</small></span><span>View →</span></button>
    <section><h2>Four little invitations</h2><p>Give each card to the person named. They can invite someone to spend time together.</p><div class="feb-list" data-cards></div></section>
    <button type="button" class="feb-reset" data-reset-mobile>Restore suggested cards</button><p class="feb-note">Preview only. Changes stay in this browser tab and aren’t saved to your account. Mailing and approval aren’t active yet.</p>
    <div class="feb-actions"><button class="feb-primary" type="button" data-review-button>Mark as reviewed</button><button class="feb-print" type="button" data-print-app aria-label="Print or save as PDF">Print</button></div>
   </div>
   <aside class="feb-desktop-rail" aria-label="February kit controls">
    <header class="feb-desktop-header"><a class="feb-desktop-back" href="/app/club/">← Back to Club</a><p class="feb-desktop-kicker">FEBRUARY · KIT PREVIEW</p><h1>More connection. <em>Less coordinating.</em></h1></header>
    <section class="feb-desktop-deadline" aria-label="Editing deadline"><p class="feb-desktop-kicker">YOUR EDITING WINDOW</p><p data-desktop-window>Checking deadline…</p></section>
    <div class="feb-desktop-actions"><button type="button" data-desktop-edit>Make changes</button><button type="button" data-desktop-review>Mark as reviewed</button><button type="button" class="feb-desktop-print" data-print-app>Download and print</button></div>
    <p class="feb-desktop-source" data-desktop-family></p><p class="feb-desktop-source" data-desktop-review-note>Preview only. Review does not save, submit or mail anything.</p>
    <div class="feb-desktop-instructions"><p>Four personal invitations, prepared for your family. Print the page, cut out the cards, and let everyone invite someone to spend time together.</p><p>Change the names or ideas to fit your family. Kids can give an invitation themselves.</p><button type="button" data-desktop-reset>Restore suggested cards</button></div>
   </aside>
   <div class="feb-proof" data-proof><div class="feb-proof-bar"><button type="button" data-close-proof>← Back</button><strong>Your printable</strong><button type="button" data-print-app>Print</button></div><FebruaryConnectionCards storageKey="omc:club:february-mobile:v1" managed={true} /></div>
  </div>
  <dialog class="feb-dialog" data-dialog aria-labelledby="feb-dialog-title"><form method="dialog"><div class="feb-dialog-head"><h2 id="feb-dialog-title">Edit invitation</h2><button type="submit" aria-label="Close">×</button></div></form><p>Changes appear on your printable as you type.</p><div data-fields></div><button type="button" class="feb-done" data-done>Done</button></dialog>
 </div>
</AppLayout>
<style is:global>
.feb-app{color:#4d4544;max-width:680px;margin:auto}.feb-app[ data-state="loading"] .feb-content{display:none}.feb-gate{padding:30px 0}.feb-gate h2{font:28px Georgia,serif}.feb-gate a,.feb-gate button{display:inline-block;margin-top:14px;text-decoration:underline}.feb-mobile h1{font:400 clamp(32px,8vw,42px)/1.1 var(--font-serif);margin:10px 0}.feb-mobile h1 em{color:#9b6477}.feb-back{display:inline-block;padding:10px 0;color:#536e4e}.feb-kicker{font-size:11px;letter-spacing:.15em;font-weight:700;color:#756d67}.feb-sample{display:inline-block;border:1px solid #dedbd2;padding:3px 8px;font-size:12px}.feb-status{border-block:1px solid #dedbd2;margin:20px 0 16px;padding:14px 0;font-size:14px}.feb-status p{margin:4px 0 0;color:#756d67}.feb-proof-link{width:100%;display:flex;align-items:center;justify-content:space-between;text-align:left;border:1px solid #e2d7d9;background:#fbf6f6;padding:18px;min-height:74px}.feb-proof-link small{display:block;margin-top:4px;color:#756d67}.feb-mobile section{margin:28px 0}.feb-mobile h2{font:27px var(--font-serif);margin:0 0 8px}.feb-mobile section>p,.feb-note{font-size:13px;line-height:1.6;color:#756d67}.feb-list{border-top:1px solid #dedbd2;margin-top:16px}.feb-card{display:block;width:100%;text-align:left;border:0;border-bottom:1px solid #dedbd2;background:transparent;padding:16px 4px;min-height:70px}.feb-card strong,.feb-card span{display:block}.feb-card strong{font:20px var(--font-serif)}.feb-card span{font-size:13px;color:#756d67;margin-top:4px}.feb-card:disabled{opacity:1}.feb-actions{position:fixed;z-index:35;bottom:calc(60px + env(safe-area-inset-bottom));left:0;right:0;display:flex;gap:8px;padding:10px max(20px,calc((100vw - 640px)/2));background:#fffdfa;border-top:1px solid #dedbd2}.feb-actions button,.feb-done{min-height:48px;padding:0 20px}.feb-primary,.feb-done{background:#536e4e;color:white;flex:1}.feb-print{border:1px solid #536e4e;background:white}.feb-reset{min-height:44px;text-decoration:underline;text-underline-offset:3px;color:#536e4e}.feb-note{margin:0 0 85px}.feb-proof{display:none}.feb-app.proof-open .feb-proof{display:block;position:fixed;inset:0;background:#f1f0ec;z-index:80;overflow:auto}.feb-proof-bar{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;background:#fff;padding:10px 18px}.feb-proof-bar button{min-height:44px}.feb-proof .fbc-intro,.feb-proof .fbc-editor-pane,.feb-proof .fbc-floating-edit{display:none!important}.feb-proof .fbc{padding:20px}.feb-proof .fbc-workspace{display:block!important}.feb-proof .fbc-scroll{padding:0}.feb-dialog{border:0;margin:auto auto 0;max-width:640px;width:100%;max-height:90dvh;padding:22px;background:#fffdfa;overflow:auto}.feb-dialog::backdrop{background:#0008}.feb-dialog-head{display:flex;justify-content:space-between;align-items:center}.feb-dialog-head h2{font:26px Georgia,serif}.feb-dialog-head button{font-size:30px;min-width:44px;min-height:44px}.feb-dialog label{display:block;font-size:12px;font-weight:700;margin:15px 0}.feb-dialog input,.feb-dialog textarea{display:block;width:100%;padding:11px;border:1px solid #bcbcbc;background:#fff;margin-top:6px;min-height:44px;font-size:16px}.feb-done{width:100%;margin-top:12px}.feb-app button:focus-visible,.feb-app input:focus-visible,.feb-app textarea:focus-visible{outline:2px solid #905d70;outline-offset:2px}
/* Match October's desktop workspace: independent control rail and printable pane. */
.feb-desktop-rail{display:none}
@media screen and (min-width:1100px){
 html:has(.feb-app),body:has(.feb-app){height:100%;overflow:hidden}
 body:has(.feb-app) #main{position:relative;width:100%;max-width:none;height:calc(100dvh - 64px);min-height:0;margin:0;padding:0;overflow:hidden}
 .feb-app{width:100%;height:100%;max-width:none;margin:0;overflow:hidden;background:var(--color-ivory)}
 .feb-content:not([hidden]){display:grid;grid-template-columns:minmax(310px,375px) minmax(0,1fr);width:100%;height:100%;min-height:0}
 .feb-mobile{display:none}
 .feb-desktop-rail{display:block;min-width:0;height:100%;overflow-y:auto;overscroll-behavior:contain;background:var(--color-ivory);border-right:1px solid var(--color-warm-rule);padding:clamp(40px,6vh,70px) clamp(22px,2.7vw,42px) 40px;scrollbar-width:thin}
 .feb-desktop-header{padding-bottom:30px;margin-bottom:28px;border-bottom:1px solid var(--color-warm-rule)}
 .feb-desktop-back{display:inline-flex;align-items:center;min-height:44px;margin-bottom:14px;color:var(--color-warm-ink);font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;text-decoration:underline;text-decoration-color:var(--color-warm-rule);text-underline-offset:6px}
 .feb-desktop-kicker{font-size:.7rem;letter-spacing:.2em;font-weight:600;color:var(--color-warm-soft)}
 .feb-desktop-header h1{font:400 clamp(34px,3vw,42px)/1.12 var(--font-serif);letter-spacing:-.02em;margin:18px 0 19px;color:var(--color-warm-ink)}
 .feb-desktop-deadline{margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--color-warm-rule);font-size:.83rem;line-height:1.6;color:var(--color-warm-soft)}
 .feb-desktop-deadline .feb-desktop-kicker{margin-bottom:10px}
 .feb-desktop-actions{display:flex;flex-direction:column;gap:12px}
 .feb-desktop-actions button{min-height:48px;padding:12px 20px;border:1px solid var(--color-warm-ink);border-radius:3px;background:transparent;color:var(--color-warm-ink);font:600 .75rem var(--font-sans);letter-spacing:.13em;text-transform:uppercase}
 .feb-desktop-actions [data-desktop-review]{background:var(--color-warm-button);border-color:var(--color-warm-button);color:white}
 .feb-desktop-actions .feb-desktop-print{align-self:flex-start;width:auto;min-height:44px;padding:5px 8px;border:0;text-decoration:underline;text-underline-offset:6px;text-decoration-color:var(--color-warm-rule)}
 .feb-desktop-source,.feb-desktop-instructions{color:var(--color-warm-soft);font-size:.78rem;line-height:1.65}
 .feb-desktop-source{margin-top:14px}.feb-desktop-instructions{border-top:1px solid var(--color-warm-rule);margin-top:24px;padding-top:20px}.feb-desktop-instructions p+p{margin-top:12px}.feb-desktop-instructions button{min-height:44px;margin-top:12px;text-decoration:underline;text-underline-offset:4px}
 .feb-proof{display:block;min-width:0;height:100%;overflow-y:auto;overflow-x:hidden;overscroll-behavior-y:contain;scrollbar-gutter:stable;background:#f1f2f2;padding:clamp(32px,4vw,62px) clamp(28px,5vw,82px) 84px;scrollbar-color:#b7b7b2 transparent}
 .feb-proof-bar{display:none}.feb-proof .fbc{padding:0;max-width:none;margin:0}.feb-proof .fbc-intro,.feb-proof .fbc-floating-edit,.feb-proof .fbc-editor-pane> :not(.fbc-dialog){display:none!important}
 .feb-proof .fbc-workspace{display:block!important}.feb-proof .fbc-editor-pane{display:contents!important}.feb-proof .fbc-preview-pane{width:100%;min-width:0}.feb-proof .fbc-scroll{display:flex;justify-content:center;padding:0;overflow:visible!important;height:auto!important}
 .feb-proof .fbc-paper{box-shadow:0 8px 28px rgba(61,56,52,.09)}
 .feb-proof .fbc-dialog{z-index:100}
}
@media print{.feb-mobile,.feb-desktop-rail,.feb-proof-bar,.feb-gate,.feb-dialog,body:has(.feb-app) [data-chrome]{display:none!important}.feb-app.proof-open .feb-proof,.feb-proof{display:block!important;position:static!important;overflow:visible!important}.feb-content{display:block!important}}
</style>
<script>
import { clubAccountsEnabled } from '../../../data/club/config';
import { getSession } from '../../../lib/account';
import { loadKitHousehold } from '../../../lib/club/kit-household';
import { accountStore, clubHref, sampleStore } from '../../../lib/club/store';
import { routes } from '../../../routes';
import type { Household } from '../../../lib/club/profile';
type Card={owner:string;recipient:string;headline:string;invite:string;idea:string};
const app=document.querySelector<HTMLElement>('.feb-app');
if(app){
 const root=app.querySelector<HTMLElement>('.fbc')!;const content=app.querySelector<HTMLElement>('.feb-content')!;const gate=app.querySelector<HTMLElement>('[data-gate]')!;const dialog=app.querySelector<HTMLDialogElement>('[data-dialog]')!;
 const now=Date.now();const locked=now>Date.parse(app.dataset.deadline!);let cards:Card[]=[];let suggested:Card[]=[];let key='';let fingerprint='';let reviewed=false;
 const defaults=(h:Household):Card[]=>{
  const all=h.members.filter(m=>!m.archived&&m.firstName.trim());const children=all.filter(m=>m.kind==='child');const adults=all.filter(m=>m.kind==='adult');const parents=adults.filter(m=>m.role==='parent'||m.role==='partner');
  const ideas=[['Game night?','will you play a game with me tonight?',"I'll get the game ready!"],['Just us two','will you read a book with me after dinner?',"I'll pick the book!"],['I picked you!','want to build something with me this weekend?','You choose what we build.'],["Let's have fun!",'will you make a blanket fort with me?',"I'll bring the blankets!"]];
  return ideas.map(([headline,body,idea],i)=>{const sender=(i<2?children[i%Math.max(children.length,1)]??adults[0]:adults[(i-2)%Math.max(adults.length,1)]??children[0]);const target=(i<2?parents[(i===0&&parents.length>1)?1:0]:children[(i-2)%Math.max(children.length,1)]);const recipient=(target&&target.id!==sender?.id?target:all.find(m=>m.id!==sender?.id));const idx=parents.findIndex(m=>m.id===recipient?.id);const to=sender?.kind==='child'&&idx>=0&&idx<2?(idx===0?'Mom':'Dad'):(recipient?.firstName??'');return {owner:sender?.firstName??'',recipient:to,headline,invite:to?`${to}, ${body}`:body[0].toUpperCase()+body.slice(1),idea};});
 };
 const clone=(x:Card[])=>x.map(v=>({...v}));
 const paint=()=>{root.dispatchEvent(new CustomEvent('fbc-set',{detail:clone(cards)}));const list=app.querySelector<HTMLElement>('[data-cards]')!;list.replaceChildren();cards.forEach((card,i)=>{const b=document.createElement('button');b.type='button';b.className='feb-card';b.disabled=locked;b.setAttribute('aria-label',`${locked?'Invitation':'Edit invitation'} ${i+1}: ${card.headline}`);const title=document.createElement('strong');title.textContent=card.headline;const line=document.createElement('span');line.textContent=`${card.owner||'Choose a sender'} → ${card.recipient||'Choose a recipient'}${locked?'':' · Edit'}`;b.append(title,line);b.addEventListener('click',()=>open(i));list.append(b)});};
 const save=()=>{try{sessionStorage.setItem(key,JSON.stringify({fingerprint,cards}))}catch{} reviewed=false;app.querySelector<HTMLElement>('[data-review]')!.textContent='Preview only · Review is optional';app.querySelector<HTMLElement>('[data-review-button]')!.textContent='Mark as reviewed';app.querySelector<HTMLElement>('[data-desktop-review]')!.textContent='Mark as reviewed';app.querySelector<HTMLElement>('[data-desktop-review-note]')!.textContent='Preview only. Review does not save, submit or mail anything.';};
 const open=(i:number)=>{const fields=app.querySelector<HTMLElement>('[data-fields]')!;fields.replaceChildren();app.querySelector<HTMLElement>('#feb-dialog-title')!.textContent=`Edit invitation ${i+1}`;for(const [field,label,max] of [['owner','From',32],['recipient','To',32],['headline','Invitation title',44],['invite','Personal invitation',88],['idea','A little extra note',180]] as const){const l=document.createElement('label');l.textContent=label;const el=field==='idea'?document.createElement('textarea'):document.createElement('input');el.maxLength=max;el.value=cards[i][field];el.addEventListener('input',()=>{const before=cards[i].recipient;cards[i][field]=el.value;if(field==='recipient'&&before&&cards[i].invite.startsWith(before+','))cards[i].invite=el.value+cards[i].invite.slice(before.length);save();paint();if(field==='recipient'){const invite=fields.querySelector<HTMLTextAreaElement|HTMLInputElement>('[data-name="invite"]');if(invite)invite.value=cards[i].invite}});el.dataset.name=field;l.append(el);fields.append(l)}dialog.showModal();};
 app.querySelector('[data-desktop-edit]')?.addEventListener('click',()=>root.querySelector<HTMLButtonElement>('[data-fbc-open]')?.click());
 app.querySelector('[data-desktop-reset]')?.addEventListener('click',()=>root.querySelector<HTMLButtonElement>('[data-reset]')?.click());
 app.querySelector('[data-desktop-review]')?.addEventListener('click',()=>app.querySelector<HTMLButtonElement>('[data-review-button]')?.click());
 app.querySelector('[data-reset-mobile]')?.addEventListener('click',()=>root.querySelector<HTMLButtonElement>('[data-reset]')?.click());
 app.querySelector('[data-done]')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
 root.addEventListener('fbc-change',(e:Event)=>{cards=clone((e as CustomEvent<{cards:Card[]}>).detail.cards);save();paint()});
 app.querySelector('[data-review-button]')?.addEventListener('click',()=>{reviewed=!reviewed;app.querySelector<HTMLElement>('[data-review]')!.textContent=reviewed?'Reviewed on this screen · No mailing submitted':'Preview only · Review is optional';app.querySelector<HTMLElement>('[data-review-button]')!.textContent=reviewed?'Undo review':'Mark as reviewed';app.querySelector<HTMLElement>('[data-desktop-review]')!.textContent=reviewed?'Undo review':'Mark as reviewed';app.querySelector<HTMLElement>('[data-desktop-review-note]')!.textContent=reviewed?'Reviewed on this screen. Nothing was saved, submitted or mailed.':'Preview only. Review does not save, submit or mail anything.'});
 let opener:HTMLElement|null=null;const proof=(open:boolean)=>{app.classList.toggle('proof-open',open);document.querySelectorAll<HTMLElement>('.feb-app .feb-mobile, body > header[data-chrome], nav[data-chrome]').forEach(el=>el.inert=open);if(open){opener=document.activeElement as HTMLElement;app.querySelector<HTMLButtonElement>('[data-close-proof]')?.focus()}else opener?.focus();window.dispatchEvent(new Event('resize'))};
 app.querySelector('[data-show-proof]')?.addEventListener('click',()=>proof(true));app.querySelector('[data-close-proof]')?.addEventListener('click',()=>proof(false));window.addEventListener('keydown',e=>{if(e.key==='Escape'&&app.classList.contains('proof-open'))proof(false)});app.querySelectorAll('[data-print-app]').forEach(b=>b.addEventListener('click',()=>{(document.activeElement as HTMLElement)?.blur();window.print()}));
 loadKitHousehold(app.dataset.slug!,location.search,{accountsEnabled:clubAccountsEnabled,hasSession:async()=>Boolean(await getSession()),accountStore,sampleStore}).then(result=>{
  if(result.status!=='ready'){const sample='sample' in result?result.sample:null;const messages={empty:['Add your family first','Add family members to prepare your invitations.',clubHref(routes.clubFamily,sample)],denied:['February isn’t open for your account','This kit is not available to your account.',clubHref(routes.clubDashboard,sample)],'signed-out':['Sign in to see your invitations','Sign in to see your family’s cards.',routes.clubDashboard],error:['We couldn’t load your invitations','Check your connection and try again.','']} as const;const [title,description,href]=messages[result.status];gate.replaceChildren();const h=document.createElement('h2');h.textContent=title;const p=document.createElement('p');p.textContent=description;const a=document.createElement(href?'a':'button');a.textContent=href?'Continue':'Try again';if(a instanceof HTMLAnchorElement)a.href=href;else a.addEventListener('click',()=>location.reload());gate.append(h,p,a);app.dataset.state=result.status;return}
  suggested=defaults(result.household);cards=clone(suggested);fingerprint=result.household.members.filter(m=>!m.archived).map(m=>`${m.id}:${m.firstName}:${m.kind}:${m.role}`).join('|');key='omc:club:february-mobile:v1:'+encodeURIComponent((result.sample?'sample:'+result.sample:'account:')+result.household.id);try{const data=JSON.parse(sessionStorage.getItem(key)??'null');if(data?.fingerprint===fingerprint&&Array.isArray(data.cards)&&data.cards.length===4&&data.cards.every((c:Card)=>['owner','recipient','headline','invite','idea'].every(k=>typeof c[k as keyof Card]==='string')))cards=clone(data.cards)}catch{}
  root.addEventListener('fbc-reset',()=>{if(window.confirm('Restore all four suggested cards? Your changes to these cards will be removed.')){cards=clone(suggested);save();paint()}});app.querySelector<HTMLElement>('[data-family]')!.textContent=result.source==='sample'?result.sampleLabel:'Prepared for '+(result.household.displayName??'your family');app.querySelector<HTMLElement>('[data-sample]')!.hidden=result.source!=='sample';app.querySelector<HTMLElement>('[data-window]')!.textContent=locked?'Editing window closed. You can still print.':'Edit until '+new Intl.DateTimeFormat('en-US',{dateStyle:'long',timeZone:'America/New_York'}).format(new Date(app.dataset.deadline!))+' at 11:59 p.m. ET.';app.querySelector<HTMLElement>('[data-desktop-family]')!.textContent=(result.source==='sample'?result.sampleLabel:'Prepared for '+(result.household.displayName??'your family'))+'. Changes stay in this browser tab.';app.querySelector<HTMLElement>('[data-desktop-window]')!.textContent=app.querySelector<HTMLElement>('[data-window]')!.textContent;if(locked){(app.querySelector<HTMLButtonElement>('[data-desktop-edit]')!).disabled=true;(app.querySelector<HTMLButtonElement>('[data-desktop-reset]')!).disabled=true;(app.querySelector<HTMLButtonElement>('[data-reset-mobile]')!).hidden=true;root.querySelectorAll<HTMLElement>('[contenteditable]').forEach(e=>e.removeAttribute('contenteditable'));root.querySelectorAll<HTMLButtonElement>('[data-fbc-open],[data-reset]').forEach(e=>e.disabled=true)}paint();gate.hidden=true;content.hidden=false;app.dataset.state='ready';window.dispatchEvent(new Event('resize'));
 });
}
</script>

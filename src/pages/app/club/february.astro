---
/** February Club kit in the app, on the shared Club plan shell (src/components/club/plan/,
 * docs/club/PLAN_ARCHITECTURE.md). Desktop (>= 1100px): the shared October-style rail (ClubPlanDesktop) with each
 * child's laundry level, laundry days and machine operator, beside the guides at actual size. Below 1100px: the shared
 * plan screen with February's sections (FebruaryPlanMobile). The guides, their artwork and their editor live in
 * FebruaryLaundryGuides; the rules in src/lib/club/engines/february-laundry.ts. */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import FebruaryLaundryGuides from '../../../components/club/FebruaryLaundryGuides.astro';
import FebruaryPlanMobile from '../../../components/club/FebruaryPlanMobile.astro';
import ClubPlanDesktop from '../../../components/club/plan/ClubPlanDesktop.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-02');
if (!kit) throw new Error('February kit missing');
const deadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:club:february-laundry-app:v1';
---
<AppLayout title="February · Kids Laundry Ownership">
  <ClubPlanShell class="feb-plan family-brand" kitSlug={kit.slug} month="February" storageKey={storageKey}>
    <ClubPlanDesktop slot="desktop" deadline={deadline} kicker="February · Kit preview" instructions={[
      'A guide for every skill level in your household. Children sharing a level share one printable.',
      'Age suggests a starting point. Change a child’s level if their readiness is different. Machine operation requires training and supervision as appropriate.',
    ]}>
      <Fragment slot="title">My Laundry, <em>My Job.</em></Fragment>
      <div class="cpd-details">
        <section class="cpd-block" aria-labelledby="feb-d-kids">
          <p class="cpd-label" id="feb-d-kids">Each child’s level</p>
          <dl class="cpd-rows" data-feb-d-kids></dl>
        </section>
        <section class="cpd-block" aria-labelledby="feb-d-routine">
          <p class="cpd-label" id="feb-d-routine">Laundry routine</p>
          <dl class="cpd-rows" data-feb-d-routine></dl>
          <p data-feb-d-guides></p>
          <button type="button" class="cpd-link" data-feb-d-open>Change levels, days or operator</button>
          <button type="button" class="cpd-link" data-feb-d-restore hidden>Restore suggested plan</button>
          <p class="cpd-hint" data-feb-d-restored role="status" tabindex="-1"></p>
        </section>
      </div>
    </ClubPlanDesktop>
    <div class="feb-proof" slot="printable" data-plan-proof-body>
      <div class="feb-scroll" data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <FebruaryLaundryGuides storageKey={storageKey} />
      </div>
    </div>
    <FebruaryPlanMobile slot="mobile" deadline={deadline} />
  </ClubPlanShell>
</AppLayout>
<script>
import { LEVEL_INFO, planChanged, restoreSuggested, type LaundryPlan, type LaundryState } from '../../../lib/club/engines/february-laundry';
import { mountPlanDesktop } from '../../../lib/club/plan/desktop';
import { el } from '../../../lib/club/plan/dom';

const root = document.querySelector<HTMLElement>('.feb-plan');
const host = root?.querySelector<HTMLElement & { clubPlan?: LaundryPlan }>('[data-lg]');
if (root && host) {
  const plan = () => host.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const restored = q('[data-feb-d-restored]');
  const row = (dt: string, dd: string) => el('div', {}, el('dt', {}, dt), el('dd', {}, dd));
  let undo: LaundryState | null = null;
  mountPlanDesktop<LaundryState>({
    root,
    host,
    approvalKey: 'omc:preview:february-laundry:approval',
    edit: () => plan().openEditor(),
    lock: (on) => plan().setLocked(on),
    render: (_r, locked) => {
      const v = plan().view();
      q('[data-feb-d-kids]').replaceChildren(...(v.kids.length ? v.kids.map((k) => row(`${k.name}${k.age === null ? '' : ` (${k.age})`}`, LEVEL_INFO[k.level].guide)) : [row('Children', 'None yet')]));
      q('[data-feb-d-routine]').replaceChildren(row('Laundry days', v.daysLine), row('Machine operator', v.operator === 'grown-up' ? 'Any grown-up' : v.operatorName));
      q('[data-feb-d-guides]').textContent = v.guides.length === 2 ? 'Two guides print, one for each readiness group.' : v.guides.length ? 'One guide prints for the whole family.' : '';
      q<HTMLButtonElement>('[data-feb-d-open]').disabled = locked;
      q('[data-feb-d-restore]').hidden = locked || !planChanged(plan().state(), plan().members());
    },
  });
  q('[data-feb-d-open]').addEventListener('click', () => plan().openEditor());
  q('[data-feb-d-restore]').addEventListener('click', () => {
    undo = structuredClone(plan().state());
    plan().update((s) => restoreSuggested(s));
    const u = el('button', { type: 'button', class: 'cpd-undo' }, 'Undo');
    u.addEventListener('click', () => { if (undo) plan().replace(undo); undo = null; restored.textContent = 'Changes put back.'; });
    restored.replaceChildren('Suggested plan restored. ', u);
    restored.focus();
  });
}
</script>

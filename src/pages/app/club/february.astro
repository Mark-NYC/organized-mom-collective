---
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import { kits } from '../../../data/club/kits';
const kit = kits.find(k => k.month === '2027-02');
if (!kit) throw new Error('February kit missing');
---
<AppLayout title="February · Kids Laundry Ownership">
<div class="laundry-page family-brand club-plan" data-laundry-app data-plan-state="loading" data-kit-slug={kit.slug} data-plan-month="February">
  <div data-plan-gate class="laundry-gate">Preparing your family's laundry plan…</div>
  <aside class="laundry-rail">
    <a href="/app/club/" class="laundry-back">← Back to Club</a>
    <p class="laundry-kicker">FEBRUARY · KIT PREVIEW</p>
    <h1>My Laundry,<br/><em>My Job.</em></h1>
    <p class="laundry-intro">A guide for every skill level in your household. Children sharing a level share one printable.</p>
    <section class="laundry-controls">
      <p class="laundry-kicker">YOUR FAMILY'S PREPARED PLAN</p>
      <p class="laundry-hint" data-family-summary>Loading family profile…</p>
      <div data-child-controls></div>
      <label>Laundry day<select data-day><option>Saturday</option><option>Sunday</option><option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option><option>As needed</option></select></label>
      <label>Machine operator<select data-operator></select></label>
      <p class="laundry-hint">Age suggests a starting point. Change a child's level if their readiness is different. Machine operation requires training and supervision as appropriate.</p>
    </section>
    <p class="laundry-hint" data-guide-summary></p>
    <div class="laundry-actions"><button class="laundry-main" type="button" data-print>Download and print</button><button type="button" data-reset>Restore suggested plan</button></div>
    <p class="laundry-disclaimer">Preview only. Edits stay in this browser tab; approval and mailing are not active.</p>
  </aside>
  <main class="laundry-preview" aria-label="Personalized February printable preview">
    <div class="laundry-preview-head"><span>Your February printable</span><span data-page-count>Preparing pages…</span></div>
    <div class="laundry-paper-stack" data-pages></div>
  </main>
</div>
</AppLayout><style is:global>
.laundry-page{--ink:#49403d;--soft:#827b72;--sage:#55735d;--rule:#ddd9d0;--rose:#9a6876;font-family:var(--font-sans,Arial,sans-serif);color:var(--ink);background:#fffdfa;min-height:100vh}
.laundry-rail{padding:32px 22px 48px;background:#fffdfa}
.laundry-back{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);text-decoration:underline;text-underline-offset:6px;margin-bottom:30px}
.laundry-kicker{font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:var(--soft)}
.laundry-rail h1{font:400 43px/1.1 var(--font-serif,Georgia,serif);letter-spacing:-.025em;margin:15px 0}.laundry-rail h1 em,.laundry-paper h2 em{color:var(--rose);font-weight:400}
.laundry-intro{font-size:14px;line-height:1.75;color:var(--soft);margin-bottom:28px}
.laundry-controls{border-top:1px solid var(--rule);padding-top:20px}.laundry-controls .laundry-kicker{margin:0 0 18px}
.laundry-controls label{display:block;font-size:12px;font-weight:700;margin:15px 0;color:var(--ink)}
.laundry-controls input,.laundry-controls select{display:block;width:100%;min-height:43px;border:1px solid #d7d3cc;background:#fff;border-radius:3px;padding:10px;font:400 14px var(--font-sans,Arial,sans-serif);margin-top:7px;color:var(--ink)}
.laundry-child{border-top:1px solid #eae6e0;margin-top:18px;padding-top:3px}.laundry-hint,.laundry-disclaimer{font-size:12px;line-height:1.65;color:var(--soft)}
.laundry-actions{display:grid;gap:9px;margin:22px 0}.laundry-actions button{min-height:48px;border:1px solid var(--ink);border-radius:3px;padding:12px 14px;font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.laundry-actions .laundry-main{background:#514541;color:white}
.laundry-preview{background:#ebeae6;padding:28px 16px 80px;min-width:0}.laundry-preview-head{display:flex;justify-content:space-between;gap:10px;font-size:11px;color:#716e68;max-width:820px;margin:0 auto 18px}
.laundry-paper-stack{display:flex;flex-direction:column;align-items:center;gap:26px}.laundry-paper{width:816px;height:1056px;flex:none;position:relative;overflow:hidden;background:#fffefa;box-shadow:0 10px 34px #3d383122;padding:52px 59px 46px;font-family:var(--font-sans,Arial,sans-serif);color:#514b45}
.paper-header,.paper-footer{display:flex;justify-content:space-between;align-items:center;font-size:10px;letter-spacing:.16em;font-weight:700;color:#7b8175}.paper-header{border-bottom:1px solid #d5d9cf;padding-bottom:16px}.paper-footer{position:absolute;bottom:36px;left:59px;right:59px;border-top:1px solid #d5d9cf;padding-top:14px;font-size:9px}
.paper-top{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-top:42px}.paper-eyebrow{font-size:11px;letter-spacing:.16em;color:#71806f;font-weight:700}.paper-top h2,.back-intro h2{font:400 53px/1.05 var(--font-serif,Georgia,serif);letter-spacing:-.03em;margin:15px 0}.paper-top p,.back-intro p{font-size:14px;color:#80766e;line-height:1.65;max-width:380px}
.icon-placeholder{border:1.5px dashed #adada4;background:#f7f5f0;color:#98948c;display:flex;align-items:center;justify-content:center;text-align:center;font-size:10px;line-height:1.35;letter-spacing:.06em;font-weight:700;flex:none}
.hero-icon{width:150px;height:150px;border-radius:50%}.paper-rule{border-top:1px solid #d8d7d0;margin:34px 0 24px}.paper-section-title{font:400 24px var(--font-serif,Georgia,serif);margin-bottom:20px}
.ownership-card{display:flex;gap:20px;border:1px solid #e2e1d8;background:#faf9f5;padding:23px;margin-bottom:16px;min-height:180px}.ownership-icon{width:86px;height:86px;border-radius:50%}.ownership-card h3{font:400 26px var(--font-serif,Georgia,serif);margin:0 0 11px}.ownership-card h3 span{font:500 12px var(--font-sans,Arial,sans-serif);color:#777f72}.ownership-card ol{padding-left:18px;margin:0}.ownership-card li{font-size:13px;line-height:1.7}
.operator{display:flex;align-items:center;gap:18px;margin:23px 0}.operator-icon{height:68px;width:68px}.operator p{font-size:13px;line-height:1.7;margin:0}.paper-callout{background:#e5eee5;padding:22px 25px;margin-top:20px}.paper-callout span,.megan-note span{display:block;color:#57715e;font-size:10px;letter-spacing:.16em;font-weight:800;margin-bottom:8px}.paper-callout strong{font:400 23px var(--font-serif,Georgia,serif)}.paper-callout p{font-size:12px;margin:6px 0 0}
.back-intro{margin:43px 0 29px}.back-intro h2{font-size:48px}.laundry-steps{display:grid;gap:10px}.laundry-step{display:grid;grid-template-columns:94px 35px 1fr;align-items:center;gap:20px;border-bottom:1px solid #e1e0da;padding:10px 0}.laundry-step .icon-placeholder{width:88px;height:88px}.laundry-step span{font:400 27px var(--font-serif,Georgia,serif);color:#8b9a89}.laundry-step h3{font:400 22px var(--font-serif,Georgia,serif);margin:0 0 5px}.laundry-step p{font-size:12px;color:#7c736b;margin:0}.megan-note{background:#f6edef;padding:22px 27px;margin-top:30px}.megan-note span{color:#9a6876}.megan-note p{font:italic 17px/1.55 var(--font-serif,Georgia,serif);margin:5px 0 9px}.megan-note strong{font:400 15px var(--font-serif,Georgia,serif)}
@media(min-width:1100px){html:has(.laundry-page),body:has(.laundry-page){height:100%;overflow:hidden}body:has(.laundry-page) #main{max-width:none!important;width:100%;height:calc(100dvh - 64px);min-height:0;overflow:hidden;padding:0!important;margin:0!important}.laundry-page{height:100%;min-height:0;display:grid;grid-template-columns:minmax(310px,375px) minmax(0,1fr);overflow:hidden}.laundry-rail{height:100%;overflow-y:auto;border-right:1px solid #dedbd2;padding:clamp(36px,5vh,56px) clamp(24px,2.6vw,42px) 40px}.laundry-preview{height:100%;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;padding:clamp(32px,4vw,58px) 24px 90px}.laundry-preview-head{max-width:816px}}
@media screen and (max-width:1099px){.laundry-paper-stack{transform-origin:top center}.laundry-preview{overflow:hidden}.laundry-paper{transform-origin:top center;margin-bottom:0}}
@media print{@page{size:letter;margin:0}html,body{margin:0!important;padding:0!important;background:#fff!important}.laundry-page{display:block!important;background:white!important}.laundry-rail,.laundry-preview-head,body:has(.laundry-page) [data-chrome]{display:none!important}.laundry-preview{display:block!important;background:#fff!important;overflow:visible!important;padding:0!important;margin:0!important;height:auto!important}.laundry-paper-stack{display:block!important;transform:none!important}.laundry-paper{width:8.5in!important;height:11in!important;padding:52px 59px 46px!important;transform:none!important;box-shadow:none!important;margin:0!important;break-after:page;page-break-after:always}.laundry-paper:last-child{break-after:auto;page-break-after:auto}}

.laundry-page[data-plan-state="loading"] .laundry-rail,.laundry-page[data-plan-state="loading"] .laundry-preview,
.laundry-page:not([data-plan-state="ready"]):not([data-plan-state="loading"]) .laundry-rail,.laundry-page:not([data-plan-state="ready"]):not([data-plan-state="loading"]) .laundry-preview{display:none!important}
.laundry-page[data-plan-state="ready"] [data-plan-gate]{display:none}
.laundry-gate{padding:50px;max-width:550px;font-size:16px;line-height:1.7}
.laundry-child{padding-bottom:8px}
.laundry-child .laundry-age{color:#81796f;font-size:11px;font-weight:400}
.laundry-paper .paper-top{margin-top:26px}
.laundry-paper .paper-top h2{font-size:44px}
.laundry-paper .ownership-card{min-height:0;margin-bottom:11px;padding:16px 20px}
.laundry-paper .ownership-card ol{padding-left:18px}
.laundry-paper .paper-callout{margin-top:16px}
.laundry-page .laundry-instructions{margin:30px 0 22px;display:grid;gap:10px}
.laundry-page .laundry-instruction{display:grid;grid-template-columns:70px 1fr;gap:16px;align-items:center;border-bottom:1px solid #e0ded7;padding:8px 0}
.laundry-page .laundry-instruction .icon-placeholder{width:62px;height:62px}
.laundry-page .laundry-instruction h3{font:400 19px var(--font-serif,Georgia,serif);margin:0 0 3px}
.laundry-page .laundry-instruction p{font-size:12px;line-height:1.45;margin:0;color:#777269}
.laundry-page .laundry-instruction small{font-size:10px;color:#6a826d;letter-spacing:.13em}
.laundry-page .laundry-paper .megan-note{margin-top:22px;padding:16px 20px}
.laundry-page .laundry-paper .megan-note p{font-size:14px}
@media print{.laundry-page .laundry-paper{break-after:page!important;page-break-after:always!important}.laundry-page .laundry-paper:last-child{break-after:auto!important;page-break-after:auto!important}}
.laundry-older-paper .paper-top{margin-top:17px}.laundry-older-paper .paper-top h2{font-size:38px;margin:8px 0}.laundry-older-paper .paper-top p{font-size:12px;line-height:1.4}.laundry-older-paper .hero-icon{width:105px;height:105px}.laundry-older-paper .paper-rule{margin:18px 0 12px}.laundry-older-paper .paper-section-title{font-size:21px;margin-bottom:6px}.laundry-older-paper .laundry-instructions{gap:2px;margin:12px 0}.laundry-older-paper .laundry-instruction{grid-template-columns:52px 1fr;gap:11px;padding:5px 0}.laundry-older-paper .laundry-instruction .icon-placeholder{width:48px;height:48px;font-size:8px}.laundry-older-paper .laundry-instruction h3{font-size:16px;margin-bottom:0}.laundry-older-paper .laundry-instruction p{font-size:10px;line-height:1.35}.laundry-older-paper .laundry-instruction small{font-size:8px}.laundry-older-paper .paper-callout{margin-top:11px;padding:12px 16px}.laundry-older-paper .paper-callout strong{font-size:18px}.laundry-older-paper .megan-note{margin-top:11px;padding:11px 15px}.laundry-older-paper .megan-note p{font-size:12px;line-height:1.3}
</style><script>
import { clubAccountsEnabled } from '../../../data/club/config';
import { getSession } from '../../../lib/account';
import { loadKitHousehold } from '../../../lib/club/kit-household';
import { accountStore, sampleStore, clubHref } from '../../../lib/club/store';
import { ageInMonth } from '../../../lib/club/profile';
import type { Household } from '../../../lib/club/profile';
type Level='young'|'older';
type Kid={id:string;name:string;age:number;level:Level};
type State={children:Kid[];day:string;operator:string};
const root=document.querySelector<HTMLElement>('[data-laundry-app]');
if(root){
 const q=<T extends HTMLElement>(s:string)=>root.querySelector<T>(s)!;
 const key='omc:club:february-laundry:v2';
 let suggested:State|null=null;
 let state:State|null=null;
 let label='Our';
 const element=(tag:string,cls?:string,value?:string)=>{const el=document.createElement(tag);if(cls)el.className=cls;if(value!==undefined)el.textContent=value;return el};
 const icon=(name:string,cls='')=>element('div','icon-placeholder '+cls,name.toUpperCase()+' ICON');
 const steps={
  young:[
   ['Hamper','Put worn clothes in your hamper, not on the floor.'],
   ['Gather','Bring the hamper to the laundry spot on laundry day.'],
   ['Sort','Help separate clothes when a grown-up asks.'],
   ['Put away','Put your own clean clothes in their drawers or closet.']
  ],
  older:[
   ['Check pockets','Empty pockets and check clothing care labels.'],
   ['Sort','Separate items by care instructions and colors as needed.'],
   ['Load washer','Add clothes without overfilling the washer.'],
   ['Detergent','Use the right amount of the family detergent. Ask before handling concentrated products.'],
   ['Choose cycle','Follow garment labels and the machine instructions. Ask about unfamiliar settings.'],
   ['Transfer','Move clothes promptly. Check lint filter before using a dryer.'],
   ['Dry','Use the right setting or hang delicate items to dry.'],
   ['Fold and put away','Fold or hang everything and return it to its place.']
  ]
 };
 const createPage=(level:Level,children:Kid[])=>{
  const paper=element('article','laundry-paper '+(level==='older'?'laundry-older-paper':'laundry-young-paper'));
  paper.setAttribute('aria-label',level==='young'?'Younger kids laundry guide':'Older kids laundry guide');
  const header=element('header','paper-header');header.append(element('span','', 'ORGANIZED FAMILY CLUB · FEBRUARY'),element('span','',level==='young'?'MY CLOTHES':'MY LAUNDRY'));paper.append(header);
  const top=element('div','paper-top');const head=element('div');head.append(element('span','paper-eyebrow',label.toUpperCase()+' FAMILY'));
  const h2=element('h2');h2.append(document.createTextNode(level==='young'?'My Clothes, ':'I Can Do '));const em=element('em','',level==='young'?'My Job.':'My Laundry.');h2.append(em);head.append(h2);
  head.append(element('p','',level==='young'?'Care for what you wear. Every day.':'From dirty clothes to clean drawers. Follow the steps and ask for help when needed.'));
  top.append(head,icon(level==='young'?'laundry hamper':'washing machine','hero-icon'));paper.append(top);
  const rule=element('div','paper-rule');paper.append(rule);
  const names=element('h3','paper-section-title',children.map(c=>c.name).join(' · '));paper.append(names);
  const sub=element('p','',level==='young'?'Your jobs, every laundry day:':'Your laundry checklist:');sub.style.fontSize='13px';paper.append(sub);
  const list=element('div','laundry-instructions');
  steps[level].forEach(([name,desc],i)=>{const row=element('div','laundry-instruction');row.append(icon(name));const info=element('div');info.append(element('small','',String(i+1).padStart(2,'0')),element('h3','',name),element('p','',desc));row.append(info);list.append(row)});
  paper.append(list);
  const call=element('div','paper-callout');call.append(element('span','',level==='young'?'YOUR FINISH LINE':'DONE MEANS DONE'),element('strong','',level==='young'?'Clean clothes go home.':'Washed. Dried. Put away.'),element('p','',level==='young'?'Grown-ups handle the machines until you are ready.':'Only operate machines after training. Ask an adult about anything unfamiliar.'));paper.append(call);
  const note=element('div','megan-note');note.append(element('span','','A NOTE FROM MEGAN'),element('p','',level==='young'?'Even small jobs count. When everyone cares for their clothes, the whole family has less to manage.':'Learning to handle your own laundry takes practice. Keep the steps nearby until they become second nature.'));paper.append(note);
  const foot=element('footer','paper-footer');foot.append(element('span','','ORGANIZED FAMILY CLUB'),element('span','','FEBRUARY · LAUNDRY OWNERSHIP'));paper.append(foot);
  return paper;
 };
 const save=()=>{if(!state)return;try{sessionStorage.setItem(key,JSON.stringify({familyId:householdId,profileVersion,edits:state}))}catch{}};
 let householdId='',profileVersion=0;
 const render=()=>{
  if(!state)return;
  const controls=q<HTMLElement>('[data-child-controls]');controls.replaceChildren();
  state.children.forEach(k=>{const wrapper=element('div','laundry-child');const l=element('label');l.append(document.createTextNode(k.name+' '));l.append(element('span','laundry-age','Age '+k.age));const sel=document.createElement('select');sel.setAttribute('aria-label',k.name+' laundry level');
   for(const [value,title] of [['young','My clothes, my responsibility'],['older','I can do my own laundry']]){const o=document.createElement('option');o.value=value;o.textContent=title;sel.append(o)}
   sel.value=k.level;sel.addEventListener('change',()=>{k.level=sel.value as Level;save();render()});l.append(sel);wrapper.append(l);controls.append(wrapper)});
  q<HTMLSelectElement>('[data-day]').value=state.day;
  const op=q<HTMLSelectElement>('[data-operator]');op.value=state.operator;
  const levels:Level[]=['young','older'];const used=levels.filter(l=>state!.children.some(k=>k.level===l));
  const pages=q<HTMLElement>('[data-pages]');pages.replaceChildren(...used.map(l=>createPage(l,state!.children.filter(k=>k.level===l))));
  q<HTMLElement>('[data-page-count]').textContent=used.length+' '+(used.length===1?'page':'pages')+' · Letter size';
  q<HTMLElement>('[data-guide-summary]').textContent=used.length===1?'One guide for '+state.children.length+' '+(state.children.length===1?'child':'children')+'.':'Two guides, one for each readiness group. No duplicate pages.';
  resize();
 };
 const resize=()=>{if(window.innerWidth>=1100){root.querySelectorAll<HTMLElement>('.laundry-paper').forEach(p=>{p.style.transform='';p.style.marginBottom=''});return}const w=q<HTMLElement>('.laundry-preview').clientWidth-32;const s=Math.min(1,w/816);root.querySelectorAll<HTMLElement>('.laundry-paper').forEach(p=>{p.style.transform='scale('+s+')';p.style.marginBottom=(1056*(s-1))+'px'})};
 const showError=(title:string,message:string,url:string='/app/club/')=>{root.dataset.planState='error';const gate=q<HTMLElement>('[data-plan-gate]');gate.replaceChildren(element('h2','',title),element('p','',message));const link=element('a','', 'Back to Club');(link as HTMLAnchorElement).href=url;gate.append(link)};
 const loaded=await loadKitHousehold(root.dataset.kitSlug??'',location.search,{accountsEnabled:clubAccountsEnabled,hasSession:async()=>Boolean(await getSession()),accountStore,sampleStore});
 if(loaded.status!=='ready'){showError(loaded.status==='signed-out'?'Sign in to view February':loaded.status==='empty'?'Add your family first':'February plan unavailable',loaded.status==='signed-out'?'Your plan is prepared using your saved family profile.':'A household profile and February access are required.');}
 else {
  const h:Household=loaded.household;householdId=h.id;profileVersion=h.profileVersion;
  label=(h.displayName||loaded.sampleLabel.replace(/^Sample:\s*/,'')||'Our').replace(/\s+family$/i,'');
  const kids=h.members.filter(m=>m.kind==='child'&&!m.archived&&m.firstName.trim()).map(m=>{const age=m.birthYear?ageInMonth(m.birthYear,m.birthMonth,'2027-02'):0;return{id:m.id,name:m.firstName,age,level:(age>=9?'older':'young') as Level}});
  if(!kids.length){showError('No children in this household','Add children to your profile to prepare their laundry guides.');}
  else {
   const adults=h.members.filter(m=>m.kind==='adult'&&!m.archived);const operator=adults.find(m=>!m.isAccountHolder)?.firstName||adults[0]?.firstName||'Adult';
   const op=q<HTMLSelectElement>('[data-operator]');adults.forEach(a=>{const o=document.createElement('option');o.value=a.firstName;o.textContent=a.firstName;op.append(o)});
   suggested={children:kids,day:'Saturday',operator};state=structuredClone(suggested);
   try{const saved=JSON.parse(sessionStorage.getItem(key)||'null');if(saved?.familyId===h.id&&saved.profileVersion===h.profileVersion){const edits=saved.edits as State;state.day=edits.day||'Saturday';state.operator=adults.some(a=>a.firstName===edits.operator)?edits.operator:operator;state.children.forEach(k=>{const match=edits.children?.find(c=>c.id===k.id);if(match&&(match.level==='young'||match.level==='older'))k.level=match.level})}}catch{}
   q<HTMLElement>('[data-family-summary]').textContent=label+' family · '+kids.length+' '+(kids.length===1?'child':'children')+(loaded.source==='sample'?' · Sample preview':'');
   q<HTMLSelectElement>('[data-day]').addEventListener('change',e=>{state!.day=(e.currentTarget as HTMLSelectElement).value;save();render()});
   op.addEventListener('change',()=>{state!.operator=op.value;save();render()});
   q<HTMLButtonElement>('[data-reset]').addEventListener('click',()=>{state=structuredClone(suggested!);save();render()});
   q<HTMLButtonElement>('[data-print]').addEventListener('click',()=>window.print());
   root.dataset.planState='ready';render();window.addEventListener('resize',resize);
   window.addEventListener('beforeprint',()=>root.querySelectorAll<HTMLElement>('.laundry-paper').forEach(p=>{p.style.transform='';p.style.marginBottom=''}));window.addEventListener('afterprint',resize);
  }
 }
}
</script>
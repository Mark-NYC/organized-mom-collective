---
/** February Club kit in the app, on the shared Club plan shell (src/components/club/plan/,
 * docs/club/PLAN_ARCHITECTURE.md). Desktop (>= 1100px): the shared October-style rail (ClubPlanDesktop) with the four
 * invitations, beside the one-page printable. Below 1100px: the shared plan screen with February's cards
 * (FebruaryPlanMobile). The printable, its editor and its rules live in FebruaryConnectionCards and
 * src/lib/club/engines/february-connection-cards.ts. */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import FebruaryConnectionCards from '../../../components/club/FebruaryConnectionCards.astro';
import FebruaryPlanMobile from '../../../components/club/FebruaryPlanMobile.astro';
import ClubPlanDesktop from '../../../components/club/plan/ClubPlanDesktop.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-02');
if (!kit) throw new Error('February 2027 kit missing from the registry');
const deadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:club:february-app:v1';
---
<AppLayout title="February Connection Cards">
  <ClubPlanShell class="feb-plan family-brand" kitSlug={kit.slug} month="February" storageKey={storageKey}>
    <ClubPlanDesktop slot="desktop" deadline={deadline} kicker="February · Kit preview" instructions={[
      'Print the page, cut along the dotted lines and give each card to the person who sends it.',
      'Kids can hand over their invitation themselves. No scheduling or reminders from Mom.',
    ]}>
      <Fragment slot="title">More connection. <em>Less coordinating.</em></Fragment>
      <div class="cpd-details">
        <section class="cpd-block" aria-labelledby="feb-d-cards">
          <p class="cpd-label" id="feb-d-cards">Four invitations</p>
          <ol class="feb-d-list" data-feb-cards></ol>
          <p>Or click any wording on the sheet with a pencil to change it.</p>
          <button type="button" class="cpd-link" data-feb-restore hidden>Restore all four suggested cards</button>
          <p class="cpd-hint" data-feb-restore-hint hidden>Puts back the prepared people and wording on every card.</p>
          <p class="cpd-hint" data-feb-restored role="status" tabindex="-1"></p>
        </section>
      </div>
    </ClubPlanDesktop>
    <div class="feb-proof" slot="printable" data-plan-proof-body>
      <div class="feb-scroll" data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <FebruaryConnectionCards storageKey={storageKey} planMode={true} />
      </div>
    </div>
    <FebruaryPlanMobile slot="mobile" deadline={deadline} />
  </ClubPlanShell>
</AppLayout>
<style is:global>
.feb-d-list{list-style:none;margin:4px 0 0;padding:0;display:grid}
.feb-d-list button{display:grid;gap:1px;width:100%;min-height:44px;padding:7px 0;border:0;border-bottom:1px solid var(--color-warm-rule);background:none;text-align:left;cursor:pointer;color:var(--color-warm-ink)}
.feb-d-list li:last-child button{border-bottom:0}
.feb-d-list button:disabled{cursor:default}
.feb-d-list strong{font-size:.88rem;font-weight:600}
.feb-d-list span{font-size:.78rem;color:var(--color-warm-soft)}
.feb-d-list button:hover:not(:disabled) strong{text-decoration:underline;text-underline-offset:3px}
</style>
<script>
import { cardChanged, restoreAll, type FebPlan, type FebState } from '../../../lib/club/engines/february-connection-cards';
import { mountPlanDesktop } from '../../../lib/club/plan/desktop';
import { el } from '../../../lib/club/plan/dom';

const root = document.querySelector<HTMLElement>('.feb-plan');
const fbc = root?.querySelector<HTMLElement & { clubPlan?: FebPlan }>('.fbc');
if (root && fbc) {
  const plan = () => fbc.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const restored = q('[data-feb-restored]');
  let undo: FebState | null = null;

  mountPlanDesktop<FebState>({
    root,
    host: fbc,
    approvalKey: 'omc:preview:february-connection-cards:approval',
    edit: () => plan().openEditor(0),
    lock: (on) => plan().setLocked(on),
    render: (_r, locked) => {
      const s = plan().state();
      q('[data-feb-cards]').replaceChildren(...plan().view().map((c, i) => {
        const b = el('button', { type: 'button', disabled: locked }, el('strong', {}, c.headline), el('span', {}, `${c.owner} → ${c.recipient}`));
        b.setAttribute('aria-label', `Invitation ${i + 1}: ${c.headline}, from ${c.owner} to ${c.recipient}.${locked ? '' : ' Edit'}`);
        b.addEventListener('click', () => plan().openEditor(i));
        return el('li', {}, b);
      }));
      const changed = !locked && s.cards.some((_, i) => cardChanged(s, i, plan().members()));
      q('[data-feb-restore]').hidden = !changed;
      q('[data-feb-restore-hint]').hidden = !changed;
    },
  });

  q('[data-feb-restore]').addEventListener('click', () => {
    undo = structuredClone(plan().state());
    plan().update((s) => restoreAll(s, plan().members()));
    const b = el('button', { type: 'button', class: 'cpd-undo' }, 'Undo');
    b.addEventListener('click', () => { if (undo) plan().replace(undo); undo = null; restored.textContent = 'Changes put back.'; });
    restored.replaceChildren('All four cards restored. ', b);
    restored.focus();
  });
}
</script>

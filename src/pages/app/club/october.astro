---
/** October Club kit in the app, on the shared Club plan shell (src/components/club/plan/,
 * docs/club/PLAN_ARCHITECTURE.md). Desktop (>= 1100px): the shared rail (ClubPlanDesktop, which is October's
 * layout) and the scrolling document proof. Below 1100px: the shared plan screen with October's sections (OctoberPlanMobile). The printable,
 * its editor and its rules live in OctoberSundayReset and src/lib/club/engines/october-sunday-reset.ts. */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import OctoberSundayReset from '../../../components/club/OctoberSundayReset.astro';
import OctoberPlanMobile from '../../../components/club/OctoberPlanMobile.astro';
import ClubPlanDesktop from '../../../components/club/plan/ClubPlanDesktop.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-10');
if (!kit) throw new Error('October 2027 kit missing from the registry');
const editDeadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:preview:october-sunday-reset:v2';
---
<AppLayout title="October Sunday Reset">
  <ClubPlanShell class="club-mobile-kit family-brand" kitSlug={kit.slug} month="October" sides={['front', 'back']} storageKey={storageKey}>
    <ClubPlanDesktop slot="desktop" deadline={editDeadline} kicker="October · Kit preview" instructions={[
      'Keep this two-sided sheet beside your family wall calendar. Each Sunday, take 10–15 minutes to look at the week ahead, prepare what you need, and give everyone a part.',
      'The back is a one-time fall example to try together. Review the prepared roles, change anything that doesn’t fit, and use the front again each Sunday.',
    ]}>
      <Fragment slot="title">Our Family <em>Sunday Reset</em></Fragment>
    </ClubPlanDesktop>
    <div class="kit-viewer-wrap" slot="printable" data-plan-proof-body>
      <div class="kit-artwork" data-kit-viewer data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <OctoberSundayReset storageKey={storageKey} />
      </div>
    </div>
    <OctoberPlanMobile slot="mobile" deadline={editDeadline} />
  </ClubPlanShell>
</AppLayout>
<style is:global>
/* October's printable inside the plan page: its own intro, editor panel and tabs give way to the shared rail and
   plan screen. The rail, the column layout and the scrolling preview are ClubPlanDesktop's. */
.club-mobile-kit .osr{padding:0!important;max-width:none!important}
.club-mobile-kit .osr-intro,.club-mobile-kit .osr-editor,.club-mobile-kit .osr-tabs,.club-mobile-kit .osr-floating-edit{display:none!important}
.club-mobile-kit .osr-layout{display:block!important}
.club-mobile-kit .osr-preview{width:100%!important;padding:0!important;margin:0!important;min-width:0!important}
.club-mobile-kit .osr-stage{width:100%!important;max-width:none!important;overflow:hidden}
.club-mobile-kit .osr-pages{display:block!important;width:100%!important}
.club-mobile-kit .osr-paper{max-width:none}
.club-mobile-kit [data-osr-panel="calendar"]{display:none!important}
.club-mobile-kit .osr-dialog{z-index:100}

/* Desktop: the January-style document viewer, centered letter-sized pages at proportional scale. */
@media screen and (min-width:1100px){
  .club-mobile-kit .osr,.club-mobile-kit .osr-layout,.club-mobile-kit .osr-preview,
  .club-mobile-kit #osr-panel-reset{width:100%;min-width:0}
  .club-mobile-kit .osr-preview,
  .club-mobile-kit #osr-panel-reset,
  .club-mobile-kit .osr-stage,
  .club-mobile-kit .osr-layout{
    height:auto!important;
    max-height:none!important;
    overflow:visible!important;
    min-height:0!important;
  }
  .club-mobile-kit .osr-stage{
    width:100%!important;
    max-width:816px!important;
    margin:0 auto!important;
  }
  .club-mobile-kit .osr-pages{
    display:flex!important;
    width:100%!important;
    flex-direction:column!important;
    align-items:center!important;
    gap:28px!important;
  }
  .club-mobile-kit .osr-document-frame{
    flex:none!important;
    position:relative!important;
    max-width:100%;
    margin:0 auto!important;
    background:#fff;
    box-shadow:0 12px 32px #0002;
    overflow:visible;
  }
  .club-mobile-kit .osr-document-frame .osr-paper{
    position:absolute!important;
    top:0!important;
    left:0!important;
    margin:0!important;
    transform:scale(var(--osr-scale,1))!important;
    transform-origin:top left!important;
    box-shadow:none!important;
  }
}
</style>
<script>
import type { OsrPlan, PlanState } from '../../../lib/club/engines/october-sunday-reset';
import { mountPlanDesktop } from '../../../lib/club/plan/desktop';

const kit = document.querySelector<HTMLElement>('.club-mobile-kit');
const osr = kit?.querySelector<HTMLElement & { clubPlan?: OsrPlan }>('.osr');
if (kit && osr) {
  mountPlanDesktop<PlanState>({
    root: kit,
    host: osr,
    approvalKey: 'omc:preview:october-sunday-reset:approval',
    edit: () => osr.clubPlan?.openEditor(),
    lock: (on) => osr.clubPlan?.setLocked(on),
  });
}
</script>

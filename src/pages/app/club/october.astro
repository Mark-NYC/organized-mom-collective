---
/** Mobile-first Club kit experience. Desktop October proof remains unchanged. */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import OctoberSundayReset from '../../../components/club/OctoberSundayReset.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
const editDeadline = clubEditingDeadline('2027-10');
---
<AppLayout title="October Sunday Reset">
  <div class="club-mobile-kit family-brand">
    <div class="kit-desktop-rail">
    <header class="kit-header">
      <a href="/app/club" class="kit-back">← Back to Club</a>
      <p class="kit-eyebrow">OCTOBER · KIT PREVIEW</p>
      <h1>Our Family <em>Sunday Reset</em></h1>
    </header>
    <section class="kit-deadline" data-edit-deadline={editDeadline} aria-label="Editing deadline"><p class="kit-deadline-eyebrow">YOUR EDITING WINDOW</p><p data-deadline-status role="status">Checking deadline…</p><div class="kit-countdown" data-countdown hidden role="timer"><span><strong data-days>–</strong><small>Days</small></span><span><strong data-hours>–</strong><small>Hours</small></span><span><strong data-minutes>–</strong><small>Minutes</small></span></div><p class="kit-deadline-detail" data-deadline-detail></p></section>
    <div class="kit-action-bar">
      <button type="button" class="kit-edit" data-kit-edit>Make changes</button>
      <button type="button" class="kit-approve" data-kit-approve>Approve preview</button>
      <button type="button" class="kit-download-link" data-kit-download aria-label="Download and print" title="Download and print"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v7H6zM18 12h.01"/></svg><span class="kit-download-label">Download And Print</span></button>
    </div>
    <div class="kit-approval-message"><p data-approval-note role="status">Prototype only. Approval does not submit, purchase, or mail anything.</p></div>
    <div class="kit-instructions"><p>Keep this two-sided sheet beside your family wall calendar. Each Sunday, take 10–15 minutes to look at the week ahead, prepare what you need, and give everyone a part.</p><p>The back is a one-time fall example to try together. Review the prepared roles, change anything that doesn’t fit, and use the front again each Sunday.</p></div>
    </div>
    <div class="kit-page-switch" role="group" aria-label="Printable side">
      <button type="button" data-side="front" aria-pressed="true">Front</button>
      <button type="button" data-side="back" aria-pressed="false">Back</button>
    </div>
    <div class="kit-viewer-wrap">
    <button class="kit-enlarge" type="button" data-kit-enlarge aria-label="Expand printable preview" title="Expand preview">⛶</button>
    <div class="kit-artwork" data-kit-viewer>
      <OctoberSundayReset storageKey="omc:preview:october-sunday-reset:v2" />
    </div>
    </div>
    <button class="kit-viewer-close" type="button" data-kit-close hidden aria-label="Close expanded preview">Close preview ×</button>

  </div>
</AppLayout>
<style is:global>
/* Scope all presentation overrides to this customer-facing route. Do not modify the desktop proof. */
.club-mobile-kit{max-width:820px;margin:0 auto;color:#4d4544}
.kit-header{max-width:700px;margin:0 auto 22px}
.kit-back{display:inline-flex;align-items:center;min-height:44px;color:#536e4e;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:4px;margin-bottom:14px}
.kit-eyebrow{font-size:11px;font-weight:700;color:#71866c;letter-spacing:.15em}
.kit-header h1{font:400 clamp(30px,6vw,43px)/1.15 Georgia,serif;margin:11px 0 8px}
.kit-header h1 em{color:#71866c}
.kit-subtitle{font-size:14px;line-height:1.6;color:#6e6461}
.kit-page-switch{display:grid;grid-template-columns:1fr 1fr;gap:7px;max-width:500px;margin:0 auto 16px}
.kit-page-switch button{min-height:46px;border:1px solid #d5dfd2;border-radius:3px;color:var(--color-warm-ink);font-weight:600;font-size:12px;letter-spacing:.12em;text-transform:uppercase}
.kit-page-switch button[aria-pressed="true"]{background:var(--color-warm-button);color:white;border-color:var(--color-warm-button)}
.club-mobile-kit .kit-artwork{min-width:0;background:#f1f2f2;border-radius:0;padding:12px;overflow:hidden}
.club-mobile-kit .osr{padding:0!important;max-width:none!important}
.club-mobile-kit .osr-intro,.club-mobile-kit .osr-editor,.club-mobile-kit .osr-tabs,.club-mobile-kit .osr-floating-edit{display:none!important}
.club-mobile-kit .osr-layout{display:block!important}
.club-mobile-kit .osr-preview{width:100%!important;padding:0!important;margin:0!important;min-width:0!important}
.club-mobile-kit .osr-stage{width:100%!important;max-width:none!important;overflow:hidden}
.club-mobile-kit .osr-pages{display:block!important;width:100%!important}
.club-mobile-kit .osr-paper{max-width:none}
.club-mobile-kit[data-kit-side="front"] .osr-back,.club-mobile-kit[data-kit-side="back"] .osr-front{display:none!important}
.club-mobile-kit [data-osr-panel="calendar"]{display:none!important}
.club-mobile-kit .osr-dialog{z-index:100}
.kit-action-bar{max-width:500px;margin:18px auto 0;display:grid;gap:10px}
.kit-action-bar button{min-height:51px;border-radius:12px;font-size:14px;font-weight:700}
.kit-edit{color:#536e4e;border:1px solid #9aab8f;background:white}
.kit-approve{color:white;background:#536e4e}
.kit-action-bar p{font-size:11px;color:#6e6461;line-height:1.5;text-align:center;padding:0 8px}
@media(min-width:768px){.club-mobile-kit .kit-artwork{padding:22px}.kit-action-bar{grid-template-columns:1fr 1fr}.kit-action-bar p{grid-column:1/-1}}
@media print{.kit-header,.kit-page-switch,.kit-action-bar{display:none!important}.club-mobile-kit .kit-artwork{padding:0;background:white}.club-mobile-kit .osr-back{display:block!important}}

/* Desktop: familiar fixed left controls, independently scrolling right printable proof. */
@media(min-width:1100px){
  body:has(.club-mobile-kit) #main{max-width:1560px;padding-left:clamp(20px,3vw,54px);padding-right:clamp(20px,3vw,54px)}
  .club-mobile-kit{max-width:none;display:grid;grid-template-columns:minmax(290px,345px) minmax(0,1fr);align-items:start;gap:clamp(24px,3.7vw,60px)}
  .club-mobile-kit .kit-desktop-rail{position:sticky;top:22px;align-self:start;max-height:calc(100vh - 44px);overflow-y:auto;overscroll-behavior:contain;padding:12px 8px 24px 0;scrollbar-width:thin}
  .club-mobile-kit .kit-header{margin:0 0 28px}
  .club-mobile-kit .kit-header h1{font-size:39px}
  .club-mobile-kit .kit-page-switch{display:none}
  .club-mobile-kit .kit-artwork{padding:24px;min-width:0;overflow:visible}
  .club-mobile-kit .osr-stage{overflow:visible}
  .club-mobile-kit .osr-pages{display:flex!important;flex-direction:column;gap:22px}
  .club-mobile-kit[data-kit-side="front"] .osr-back,.club-mobile-kit[data-kit-side="back"] .osr-front{display:block!important}
  .club-mobile-kit .kit-action-bar{display:flex;flex-direction:column;max-width:none;margin:0;gap:13px}
  .club-mobile-kit .kit-action-bar p{text-align:left;padding:0}
}
/* Desktop workspace: full-bleed preview surface, with wheel / trackpad scrolling
   handled by the right pane instead of the document. Nav remains 64px high. */
@media (min-width:1100px) {
  html:has(.club-mobile-kit),body:has(.club-mobile-kit){height:100%;overflow:hidden}
  body:has(.club-mobile-kit) #main{
    position:relative;width:100%;max-width:none;height:calc(100dvh - 64px);
    min-height:0;margin:0;padding:0;overflow:hidden
  }
  .club-mobile-kit{
    width:100%;height:100%;min-height:0;grid-template-columns:minmax(310px,375px) minmax(0,1fr);
    gap:0;overflow:hidden;background:#f0eee9
  }
  .club-mobile-kit .kit-desktop-rail{
    position:relative;top:auto;height:100%;max-height:none;overflow-y:auto;
    background:#fffdfa;border-right:1px solid #dedbd2;
    padding:clamp(26px,4vh,48px) clamp(22px,2.7vw,42px) 40px;
    scrollbar-width:thin
  }
  .club-mobile-kit .kit-artwork{
    height:100%;min-height:0;overflow-y:auto;overflow-x:hidden;
    overscroll-behavior-y:contain;scrollbar-gutter:stable;
    border-radius:0;background:#eae8e2;
    padding:clamp(25px,4vw,56px) clamp(22px,5vw,78px) 70px;
    scrollbar-color:#b7b7ad transparent
  }
  .club-mobile-kit .osr,.club-mobile-kit .osr-layout,.club-mobile-kit .osr-preview,
  .club-mobile-kit #osr-panel-reset{width:100%;min-width:0}
  .club-mobile-kit .osr-pages{align-items:center;width:100%!important;gap:28px!important}
  .club-mobile-kit .osr-document-frame{
    position:relative;display:block;flex:none;max-width:100%;
    background:#fff;box-shadow:0 8px 28px rgba(61,56,52,.12);
  }
  .club-mobile-kit .osr-document-frame .osr-paper{
    position:absolute;top:0;left:0;margin:0!important;
    box-shadow:none!important;
  }
  .club-mobile-kit .osr-stage{width:100%;max-width:none;margin:0 auto}

  .club-mobile-kit .osr-paper{box-shadow:0 12px 34px rgba(50,47,38,.12)}
}

/* Brand alignment: use the same type, palette, rules and editorial restraint
   as the homepage and docs/editorial/BLOG_EDITORIAL_STYLE.md.
   Limit adjustments to the Club workspace; printed page art is untouched. */
.club-mobile-kit{
  --kit-ink:var(--color-warm-ink);
  --kit-soft:var(--color-warm-soft);
  --kit-rule:var(--color-warm-rule);
  --kit-sage:var(--color-sage);
  font-family:var(--font-sans);
  color:var(--kit-ink);
}
.club-mobile-kit .kit-header h1{
  font-family:var(--font-serif);
  font-weight:400;
  letter-spacing:-.02em;
  color:var(--kit-ink);
}
.club-mobile-kit .kit-header h1 em{color:var(--kit-ink)}
.club-mobile-kit .kit-eyebrow{
  font-size:.7rem;letter-spacing:.2em;font-weight:600;
  color:var(--kit-soft);
}
.club-mobile-kit .kit-subtitle{
  color:var(--kit-soft);font-size:1rem;line-height:1.7;
}
.club-mobile-kit .kit-back{
  color:var(--kit-ink);font-size:.7rem;font-weight:600;
  letter-spacing:.14em;text-transform:uppercase;
  text-decoration-color:var(--kit-rule);
  text-underline-offset:6px;
}
.club-mobile-kit .kit-action-bar button{
  border-radius:3px;min-height:48px;padding:12px 20px;
  font-family:var(--font-sans);font-size:.75rem;
  font-weight:600;letter-spacing:.13em;text-transform:uppercase;
}
.club-mobile-kit .kit-edit{
  color:var(--kit-ink);background:transparent;border:1px solid var(--kit-ink);
}
.club-mobile-kit .kit-edit:hover{background:var(--kit-ink);color:white}
.club-mobile-kit .kit-approve{background:var(--color-warm-button);color:white;border:1px solid var(--color-warm-button)}
.club-mobile-kit .kit-approve:hover{background:#3a302f}
.club-mobile-kit .kit-action-bar p{
  font-size:.78rem;color:var(--kit-soft);line-height:1.65;
}
@media (min-width:1100px){
  .club-mobile-kit{background:var(--color-ivory)}
  .club-mobile-kit .kit-desktop-rail{
    background:var(--color-ivory);border-right:1px solid var(--kit-rule);
    padding-top:clamp(40px,6vh,70px);
  }
  .club-mobile-kit .kit-header{
    padding-bottom:30px;margin-bottom:28px;border-bottom:1px solid var(--kit-rule);
  }
  .club-mobile-kit .kit-header h1{
    font-size:clamp(34px,3vw,42px);line-height:1.12;margin-top:18px;margin-bottom:19px;
  }
  .club-mobile-kit .kit-artwork{
    background:#f1f2f2;
    padding:clamp(32px,4vw,62px) clamp(28px,5vw,82px) 84px;
    scrollbar-color:#b7b7b2 transparent;
  }
  .club-mobile-kit .osr-paper{box-shadow:0 8px 28px rgba(61,56,52,.09)}
  .club-mobile-kit .kit-action-bar{gap:12px}
}

.club-mobile-kit .kit-action-bar .kit-download-link{
  display:inline-flex;align-self:center;align-items:center;justify-content:center;
  width:auto;min-height:44px;padding:5px 8px;
  border:0;border-radius:0;background:transparent;
  color:var(--color-warm-ink);font:600 .75rem var(--font-sans);
  letter-spacing:.13em;text-transform:uppercase;
  text-decoration:underline;text-underline-offset:6px;text-decoration-color:var(--color-warm-rule);
}
.club-mobile-kit .kit-action-bar .kit-download-link:hover{text-decoration-color:currentColor}
.club-mobile-kit .kit-action-bar .kit-download-link:focus-visible{outline:2px solid currentColor;outline-offset:3px}
@media(min-width:1100px){.club-mobile-kit .kit-action-bar .kit-download-link{align-self:flex-start}}
.club-mobile-kit .kit-instructions{display:grid;gap:11px;margin-top:18px;color:var(--color-warm-soft);font-size:.9rem;line-height:1.7}
.club-mobile-kit .kit-deadline{margin:0 0 20px;padding-bottom:20px;border-bottom:1px solid var(--color-warm-rule);color:var(--color-warm-soft);font-size:.83rem}
.club-mobile-kit .kit-deadline-eyebrow{letter-spacing:.16em;font-weight:600;font-size:.68rem;margin-bottom:10px}
.club-mobile-kit .kit-countdown{display:flex;gap:20px;margin:12px 0}
.club-mobile-kit .kit-countdown[hidden]{display:none}
.club-mobile-kit .kit-countdown span{display:flex;flex-direction:column}
.club-mobile-kit .kit-countdown strong{font:400 1.65rem var(--font-serif);font-variant-numeric:tabular-nums;color:var(--color-warm-ink)}
.club-mobile-kit .kit-countdown small{font-size:.66rem;letter-spacing:.1em;text-transform:uppercase}
.club-mobile-kit .kit-deadline-detail{font-size:.74rem;line-height:1.5}
@media(max-width:1099px){.club-mobile-kit .kit-deadline{order:3;width:100%;margin-top:18px;padding:16px 0;border-top:1px solid var(--color-warm-rule);border-bottom:0}.club-mobile-kit .kit-action-bar{order:4!important}}
/* Keep the timer and primary actions near the top; usage notes come last. */
@media(min-width:1100px){
 .club-mobile-kit .kit-header{margin-bottom:20px;padding-bottom:20px}
 .club-mobile-kit .kit-header h1{margin-bottom:0}
 .club-mobile-kit .kit-deadline{margin-bottom:18px;padding-bottom:16px}
 .club-mobile-kit .kit-instructions{margin-top:28px;padding-top:20px;border-top:1px solid var(--color-warm-rule);font-size:.84rem;line-height:1.65}
}
@media(max-width:1099px){.club-mobile-kit .kit-instructions{order:5;width:100%;margin-top:24px;padding-top:20px;border-top:1px solid var(--color-warm-rule)}}
/* On phones, keep preview-first: controls below the artwork. */
@media(max-width:1099px){
  .club-mobile-kit{display:flex;flex-direction:column}
  .club-mobile-kit .kit-desktop-rail{display:contents}
  .club-mobile-kit .kit-header{order:0;width:100%}
  .club-mobile-kit .kit-page-switch{order:1;width:100%}
  .club-mobile-kit .kit-artwork{order:2;width:100%}
  .club-mobile-kit .kit-action-bar{order:3;width:100%}
}

/* Match the January Habit Cards document viewer: a single neutral scroll
   surface, centered letter-sized paper, proportional page fit, natural scroll.
   Only the October app desktop preview is affected. */
@media screen and (min-width:1100px){
  .club-mobile-kit .kit-artwork{
    background:#f5f3f2!important;
    padding:16px clamp(18px,3vw,45px) 38px!important;
    overflow-y:auto!important;
    overflow-x:hidden!important;
    height:100%!important;
    min-height:0!important;
    overscroll-behavior:contain;
    scrollbar-gutter:auto;
  }
  .club-mobile-kit .osr-preview,
  .club-mobile-kit #osr-panel-reset,
  .club-mobile-kit .osr-stage,
  .club-mobile-kit .osr-layout{
    height:auto!important;
    max-height:none!important;
    overflow:visible!important;
    min-height:0!important;
  }
  .club-mobile-kit .osr-stage{
    width:100%!important;
    max-width:816px!important;
    margin:0 auto!important;
  }
  .club-mobile-kit .osr-pages{
    display:flex!important;
    width:100%!important;
    flex-direction:column!important;
    align-items:center!important;
    gap:28px!important;
  }
  .club-mobile-kit .osr-document-frame{
    flex:none!important;
    position:relative!important;
    max-width:100%;
    margin:0 auto!important;
    background:#fff;
    box-shadow:0 12px 32px #0002;
    overflow:visible;
  }
  .club-mobile-kit .osr-document-frame .osr-paper{
    position:absolute!important;
    top:0!important;
    left:0!important;
    margin:0!important;
    transform:scale(var(--osr-scale,1))!important;
    transform-origin:top left!important;
    box-shadow:none!important;
  }
}
@media print{
  .club-mobile-kit .osr-document-frame{
    width:8.5in!important;
    height:11in!important;
    max-width:none!important;
    box-shadow:none!important;
    overflow:visible!important;
  }
}

/* Compact mobile document viewer and accessible fixed actions.
   Applies only to this kit page; desktop January-style viewer is untouched. */
.kit-enlarge,.kit-viewer-close{display:none}
@media (max-width:1099px){
  .club-mobile-kit .kit-header{padding-bottom:0;margin-bottom:8px}
  .club-mobile-kit .kit-header h1{font-size:clamp(26px,6vw,33px);margin:7px 0 5px}
  .club-mobile-kit .kit-page-switch{order:2;max-width:none;margin:8px 0 0}
  .club-mobile-kit .kit-enlarge{display:block;order:3;align-self:flex-end;min-height:38px;padding:5px 8px;color:var(--color-warm-ink);font-size:.72rem;font-weight:600;letter-spacing:.07em}
  .club-mobile-kit .kit-artwork{order:4;height:clamp(250px,41dvh,430px);overflow-y:auto;overflow-x:hidden;padding:12px 10px;background:#f1f2f2;overscroll-behavior:contain;scrollbar-width:thin}
  .club-mobile-kit .osr-stage{overflow:visible!important}
  .club-mobile-kit .kit-deadline{order:1;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin:8px 0 4px!important;padding:11px 12px!important;background:#f1f2f2;border:0!important}
  .club-mobile-kit .kit-deadline-eyebrow{margin:0;font-size:.66rem}
  .club-mobile-kit .kit-deadline [data-deadline-status]{font-size:.72rem}
  .club-mobile-kit .kit-countdown{gap:10px;margin:0}
  .club-mobile-kit .kit-countdown span{flex-direction:row;align-items:baseline;gap:3px}
  .club-mobile-kit .kit-countdown strong{font:600 .88rem var(--font-sans)}
  .club-mobile-kit .kit-countdown small{font-size:.6rem}
  .club-mobile-kit .kit-deadline-detail{width:100%;font-size:.67rem;margin:0}
  .club-mobile-kit .kit-action-bar{order:5!important;position:sticky;bottom:calc(64px + env(safe-area-inset-bottom));z-index:35;background:#fffdfa;border-top:1px solid var(--color-warm-rule);margin:0 -20px;padding:9px 20px;grid-template-columns:1fr 1fr;gap:7px;box-shadow:0 -6px 16px #0000000c}
  .club-mobile-kit .kit-action-bar .kit-edit,.club-mobile-kit .kit-action-bar .kit-approve{min-height:44px;padding:8px;font-size:.65rem;letter-spacing:.09em}
  .club-mobile-kit .kit-action-bar .kit-download-link{grid-column:1/-1;justify-self:center;min-height:31px;padding:1px 8px;font-size:.65rem}
  .club-mobile-kit .kit-action-bar [data-approval-note]{grid-column:1/-1;text-align:center;font-size:.64rem;line-height:1.3}
  .club-mobile-kit .kit-instructions{order:6!important;padding-bottom:16px}
  .club-mobile-kit .kit-viewer-close{display:none}
  .club-mobile-kit.kit-expanded .kit-artwork{position:fixed;inset:58px 0 calc(64px + env(safe-area-inset-bottom));width:100vw;height:auto;z-index:61;overflow-y:auto;padding:20px 12px 75px}
  .club-mobile-kit.kit-expanded .kit-viewer-close{display:block;position:fixed;top:11px;right:12px;z-index:63;background:#4a3f3e;color:white;padding:9px 15px;min-height:42px;font-size:.8rem}
  .club-mobile-kit.kit-expanded::before{content:"";position:fixed;inset:0;z-index:60;background:#fffdfa}
}
@media(max-width:1099px) and (max-height:700px){
 .club-mobile-kit .kit-artwork{height:35dvh;min-height:220px}
}
@media print{
 .kit-enlarge,.kit-viewer-close{display:none!important}
 .club-mobile-kit .kit-artwork{position:static!important;height:auto!important;overflow:visible!important}
}

/* Mobile review, simplified: title → one-line navigation/countdown → document → actions. */
@media screen and (max-width:1099px){
  .club-mobile-kit{
    display:grid!important;
    grid-template-columns:minmax(0,1fr) auto;
    column-gap:8px;row-gap:10px;
    align-content:start;
    padding-bottom:calc(92px + env(safe-area-inset-bottom,0px));
  }
  .club-mobile-kit .kit-desktop-rail{display:contents!important}
  .club-mobile-kit .kit-header{grid-column:1/-1;order:0!important;margin:0 0 3px!important}
  .club-mobile-kit .kit-header h1{margin:6px 0!important;font-size:clamp(26px,6.7vw,34px)!important}
  .club-mobile-kit .kit-page-switch{grid-column:1;order:1!important;display:flex;gap:4px;width:auto;max-width:none;margin:0!important;align-self:center}
  .club-mobile-kit .kit-page-switch button{min-height:40px;padding:8px 13px;flex:none;font-size:.68rem;letter-spacing:.08em}
  .club-mobile-kit .kit-deadline{
    grid-column:2;order:2!important;
    display:flex!important;align-items:center;justify-content:flex-end;gap:0;
    margin:0!important;padding:0!important;background:transparent!important;
    border:0!important;min-width:0;width:auto!important;
  }
  .club-mobile-kit .kit-deadline-eyebrow,
  .club-mobile-kit .kit-deadline [data-deadline-status],
  .club-mobile-kit .kit-deadline-detail{display:none!important}
  .club-mobile-kit .kit-countdown{display:flex;gap:5px;margin:0!important;align-items:baseline;white-space:nowrap}
  .club-mobile-kit .kit-countdown[hidden]{display:none!important}
  .club-mobile-kit .kit-countdown span{display:flex;gap:2px;flex-direction:row;align-items:baseline}

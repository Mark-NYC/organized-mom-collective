---
/** October Club kit in the app, on the shared Club plan shell (src/components/club/plan/,
 * docs/club/PLAN_ARCHITECTURE.md): the Daily Reset ("Less asking. More doing."), moved from September in Oct 2026;
 * the Sunday Reset that was here is now September's. Desktop (>= 1100px): the shared rail (ClubPlanDesktop) beside
 * the two-sided printable. Below 1100px: the shared plan screen with October's sections (OctoberPlanMobile). The
 * printable, its editor and its rules live in OctoberDailyReset and src/lib/club/engines/daily-reset.ts. */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import OctoberDailyReset from '../../../components/club/OctoberDailyReset.astro';
import OctoberPlanMobile from '../../../components/club/OctoberPlanMobile.astro';
import ClubPlanDesktop from '../../../components/club/plan/ClubPlanDesktop.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-10');
if (!kit) throw new Error('October 2027 kit missing from the registry');
const deadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:club:october-daily-reset:v1';
---
<AppLayout title="October Daily Reset">
  <ClubPlanShell class="oct-plan family-brand" kitSlug={kit.slug} month="October" sides={['front', 'back']} storageKey={storageKey}>
    <ClubPlanDesktop slot="desktop" deadline={deadline} kicker="October · Kit preview" instructions={[
      'Mom shouldn’t have to notice every mess, start every cleanup, and check every job. This prepared reset gives children a recognizable cue and a clear finish line so they can gradually take responsibility for one space.',
      'Practice together once, then let kids check the pictures. Adults may still need to help younger children begin. The back is for you: how to remind, help start, and let them finish.',
    ]}>
      <Fragment slot="title">Less asking. <em>More doing.</em></Fragment>
      <div class="cpd-details">
        <section class="cpd-block" aria-labelledby="oct-d-reset">
          <p class="cpd-label" id="oct-d-reset">Our Daily Reset</p>
          <dl class="cpd-rows" data-oct-d-rows></dl>
          <button type="button" class="cpd-link" data-oct-d-open>Change the cue, area or jobs</button>
          <p>Or click any line on the sheet with a pencil to retype it.</p>
          <button type="button" class="cpd-link" data-oct-d-restore hidden>Restore prepared plan</button>
          <p class="cpd-hint" data-oct-d-restored role="status" tabindex="-1"></p>
        </section>
      </div>
    </ClubPlanDesktop>
    <div class="oct-proof" slot="printable" data-plan-proof-body>
      <div class="oct-scroll" data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <OctoberDailyReset storageKey={storageKey} planMode={true} />
      </div>
    </div>
    <OctoberPlanMobile slot="mobile" deadline={deadline} />
  </ClubPlanShell>
</AppLayout>
<script>
import { planChanged, restorePlan, type ResetPlan, type ResetState } from '../../../lib/club/engines/daily-reset';
import { mountPlanDesktop } from '../../../lib/club/plan/desktop';
import { el } from '../../../lib/club/plan/dom';

const root = document.querySelector<HTMLElement>('.oct-plan');
const host = root?.querySelector<HTMLElement & { clubPlan?: ResetPlan }>('.srr');
if (root && host) {
  const plan = () => host.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const restored = q('[data-oct-d-restored]');
  const row = (dt: string, dd: string) => el('div', {}, el('dt', {}, dt), el('dd', {}, dd));
  let undo: ResetState | null = null;
  mountPlanDesktop<ResetState>({
    root,
    host,
    approvalKey: 'omc:preview:october-daily-reset:approval',
    edit: () => plan().openEditor(),
    lock: (on) => plan().setLocked(on),
    render: (_r, locked) => {
      const v = plan().view();
      q('[data-oct-d-rows]').replaceChildren(row('When', v.cue), row('Where', v.summary.area), ...v.jobs.map((j, i) => row(`Job ${i + 1}`, `${j.label} · ${j.person}`)));
      q<HTMLButtonElement>('[data-oct-d-open]').disabled = locked;
      q('[data-oct-d-restore]').hidden = locked || !planChanged(plan().state(), plan().members());
    },
  });
  q('[data-oct-d-open]').addEventListener('click', () => plan().openEditor());
  q('[data-oct-d-restore]').addEventListener('click', () => {
    undo = structuredClone(plan().state());
    plan().update((s) => restorePlan(s, plan().members()));
    const u = el('button', { type: 'button', class: 'cpd-undo' }, 'Undo');
    u.addEventListener('click', () => { if (undo) plan().replace(undo); undo = null; restored.textContent = 'Changes put back.'; });
    restored.replaceChildren('Plan restored. ', u);
    restored.focus();
  });
}
</script>

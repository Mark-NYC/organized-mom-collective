<script>
const kit=document.querySelector<HTMLElement>('.club-mobile-kit');
if(kit){
  const show=(side:'front'|'back')=>{
    kit.dataset.kitSide=side;
    kit.querySelectorAll<HTMLButtonElement>('[data-side]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.side===side)));
    window.dispatchEvent(new Event('resize'));
  };
  kit.querySelectorAll<HTMLButtonElement>('[data-side]').forEach(b=>b.addEventListener('click',()=>show(b.dataset.side==='back'?'back':'front')));
  show('front');
  const expand=kit.querySelector<HTMLButtonElement>('[data-kit-enlarge]');
  const close=kit.querySelector<HTMLButtonElement>('[data-kit-close]');
  const toggle=(open:boolean)=>{
    kit.classList.toggle('kit-expanded',open);
    if(close)close.hidden=!open;
    document.body.style.overflow=open?'hidden':'';
    window.dispatchEvent(new Event('resize'));
    if(open)close?.focus();else expand?.focus();
  };
  expand?.addEventListener('click',()=>toggle(true));
  close?.addEventListener('click',()=>toggle(false));
  window.addEventListener('keydown',event=>{if(event.key==='Escape'&&kit.classList.contains('kit-expanded'))toggle(false)});
  window.addEventListener('pagehide',()=>{document.body.style.overflow=''}, {once:true});
  const section=kit.querySelector<HTMLElement>('[data-edit-deadline]');
  if(section){
    const raw=section.dataset.editDeadline ?? '';
    const valid=/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(?::[0-9]{2})?(?:Z|[+-][0-9]{2}:[0-9]{2})$/.test(raw);
    const deadline=valid?Date.parse(raw):NaN;
    const status=section.querySelector<HTMLElement>('[data-deadline-status]');
    const detail=section.querySelector<HTMLElement>('[data-deadline-detail]');
    const box=section.querySelector<HTMLElement>('[data-countdown]');
    const update=()=>{
      if(!Number.isFinite(deadline)){
        if(status)status.textContent='Editing cutoff not scheduled yet.';
        if(detail)detail.textContent='PDF sending is not active in this preview.';
        if(box)box.hidden=true;
        return;
      }
      const minutes=Math.max(0,Math.ceil((deadline-Date.now())/60000));
      if(!minutes){
        if(status)status.textContent='Scheduled editing window ended.';
        if(detail)detail.textContent='PDF sending and automatic edit locking are not yet active.';
        if(box)box.hidden=true;
        return;
      }
      if(status)status.textContent='Time left to make changes';
      if(box)box.hidden=false;
      const values={'[data-days]':Math.floor(minutes/1440),'[data-hours]':Math.floor(minutes%1440/60),'[data-minutes]':minutes%60};
      Object.entries(values).forEach(([selector,value])=>{const el=section.querySelector<HTMLElement>(selector);if(el)el.textContent=String(value).padStart(2,'0');});
      if(detail)detail.textContent='Cutoff: '+new Intl.DateTimeFormat('en-US',{dateStyle:'medium',timeStyle:'short',timeZone:'America/New_York'}).format(deadline)+' ET. Preview only; no PDF is sent.';
    };
    update();
    const interval=window.setInterval(update,15000);
    window.addEventListener('pagehide',()=>window.clearInterval(interval),{once:true});
  }
  kit.querySelector<HTMLButtonElement>('[data-kit-edit]')?.addEventListener('click',()=>kit.querySelector<HTMLButtonElement>('[data-open-editor]')?.click());
  kit.querySelector<HTMLButtonElement>('[data-kit-download]')?.addEventListener('click',()=>{
    (document.activeElement as HTMLElement | null)?.blur();
    // Reuse the existing two-sided printable and native Print / Save as PDF dialog.
    kit.querySelector<HTMLButtonElement>('[data-osr-print]')?.click();
  });
  kit.querySelector<HTMLButtonElement>('[data-kit-approve]')?.addEventListener('click',()=>{
    const note=kit.querySelector<HTMLElement>('[data-approval-note]');
    if(note)note.textContent='Preview acknowledged on this screen only. Nothing was submitted or scheduled for mailing.';
  });
}
</script>
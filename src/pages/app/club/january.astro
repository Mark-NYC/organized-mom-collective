---
/** January Club kit in the app, on the shared Club plan shell (src/components/club/plan/,
 * docs/club/PLAN_ARCHITECTURE.md): Our Family Focus, the family's one-page shared focus, habit ideas and Words of the Week for January
 * (docs/club/PERSONALIZATION.md). The guide is January's resource, so the page has no separate
 * Monthly Tool / Family Meeting switch. Desktop (>= 1100px): the shared rail and the two-page document. Below
 * 1100px: the shared plan screen with the guide's sections.
 */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import MeetingGuidePrintable from '../../../components/club/MeetingGuidePrintable.astro';
import MeetingGuideMobile from '../../../components/club/MeetingGuideMobile.astro';
import ClubPlanDesktop from '../../../components/club/plan/ClubPlanDesktop.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-01');
if (!kit) throw new Error('January 2027 kit missing from the registry');
const editDeadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:club:january-family-meeting:v1';
---
<AppLayout title="Our Family Focus">
  <ClubPlanShell class="club-mobile-kit family-brand" kitSlug={kit.slug} month="January" storageKey={storageKey} meeting={false}>
    <ClubPlanDesktop slot="desktop" deadline={editDeadline} kicker="January · Kit preview" instructions={[
      'One page for January: your family’s shared focus, a small habit or two worth trying, and four Words of the Week for the calendar.',
      'Bring it to your Family Meeting. Talk it over, choose what to try, and add it to the wall calendar. Nothing here is assigned: your family decides.',
      'Make changes to keep, reword or skip each idea. Skipped ideas come off the printed page. Names, ages and colors come from your family page.',
    ]}>
      <Fragment slot="title">Our Family <em>Focus</em></Fragment>
    </ClubPlanDesktop>
    <div class="kit-viewer-wrap" slot="printable" data-plan-proof-body>
      <div class="kit-artwork" data-kit-viewer data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <MeetingGuidePrintable month={kit.month} />
      </div>
    </div>
    <MeetingGuideMobile slot="mobile" deadline={editDeadline} kicker="January · Organized Family Club" approvalKey="omc:preview:january-family-meeting:approval">
      <Fragment slot="title">Our Family <em>Focus</em></Fragment>
    </MeetingGuideMobile>
  </ClubPlanShell>
</AppLayout>
<script>
import type { GuidePlan } from '../../../lib/club/meeting-guide/printable';
import { mountPlanDesktop } from '../../../lib/club/plan/desktop';

const root = document.querySelector<HTMLElement>('.club-mobile-kit');
const host = root?.querySelector<HTMLElement & { clubPlan?: GuidePlan }>('[data-meeting-guide]');
if (root && host) {
  mountPlanDesktop({
    root,
    host,
    approvalKey: 'omc:preview:january-family-meeting:approval',
    edit: () => host.clubPlan?.openEditor(),
    lock: (on) => host.clubPlan?.setLocked(on),
  });
}
</script>

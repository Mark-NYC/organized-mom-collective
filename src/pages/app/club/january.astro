---
/** January Club kit in the app, on the shared Club plan shell (src/components/club/plan/,
 * docs/club/PLAN_ARCHITECTURE.md). Desktop (>= 1100px): January's own two-panel view from JanuaryHabitCards
 * (its #club-month-content layout), with one line saying whose family it is. Below 1100px: the shared plan screen
 * with January's habit cards (JanuaryPlanMobile). Both read the printable's state (january-habit-cards.ts). */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import JanuaryHabitCards from '../../../components/club/JanuaryHabitCards.astro';
import JanuaryPlanMobile from '../../../components/club/JanuaryPlanMobile.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-01');
if (!kit) throw new Error('January 2027 kit missing from the registry');
const editDeadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:preview:january-habit-cards:v3';
---
<AppLayout title="January Family Habit Cards">
  <ClubPlanShell class="jan-plan family-brand" kitSlug={kit.slug} month="January" storageKey={storageKey}>
    <p class="jan-desk-note" slot="desktop" data-plan-source></p>
    <div class="jan-proof-body" slot="printable" data-plan-proof-body>
      <div id="club-month-content" data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <JanuaryHabitCards storageKey={storageKey} />
      </div>
    </div>
    <JanuaryPlanMobile slot="mobile" deadline={editDeadline} />
  </ClubPlanShell>
</AppLayout>
<style is:global>
/* Desktop: January's own view fills the screen under the app header and this note (--adc-nav-height). */
.jan-desk-note{display:none}
@media screen and (min-width:1100px){
  .jan-desk-note{display:block;position:fixed;left:0;right:0;top:var(--jan-note-top,64px);z-index:5;margin:0;padding:8px clamp(17px,2vw,26px);background:#fdf6e6;border-bottom:1px solid #e8d9b8;color:var(--color-warm-ink);font-size:.82rem;line-height:1.4}
}
/* Below 1100px January's printable only appears in the full-screen proof: no editor panel, no extra padding.
   JanuaryHabitCards forces its config panel visible with an id-level !important, so hiding it needs the same. */
@media screen and (max-width:1099px){
  .jan-plan #club-month-content .jhc-config{display:none!important}
  .jan-plan #club-month-content .jhc{padding:0}
  .jan-plan #club-month-content .jhc-workspace{display:block}
  .jan-plan #club-month-content .jhc-preview-panel{padding:0;background:transparent}
}
</style>
<script>
import { onPlanFamily } from '../../../lib/club/plan/family';

const root = document.querySelector<HTMLElement>('.jan-plan');
if (root) {
  onPlanFamily(root, (result) => {
    const note = root.querySelector<HTMLElement>('[data-plan-source]');
    if (note) note.textContent = (result.source === 'sample'
      ? `Sample family: ${result.sampleLabel.replace('Sample: ', '')}, made up for this preview.`
      : `Prepared for ${result.household.displayName ?? 'your family'}.`)
      + ' Changes stay in this browser tab. Nothing is saved to an account or mailed yet.';
  });
  // January's desktop view is fixed below the app header and the note; keep it measured.
  const header = document.querySelector<HTMLElement>('body > header[data-chrome]');
  const note = root.querySelector<HTMLElement>('.jan-desk-note');
  const place = () => {
    const top = header?.getBoundingClientRect().bottom ?? 64;
    root.style.setProperty('--jan-note-top', `${top}px`);
    document.documentElement.style.setProperty('--adc-nav-height', `${top + (note?.offsetHeight ?? 0)}px`);
  };
  place();
  window.addEventListener('resize', place);
  if (note && typeof ResizeObserver !== 'undefined') new ResizeObserver(place).observe(note);
}
</script>

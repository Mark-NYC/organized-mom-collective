---
/** March Club kit in the app, on the shared Club plan shell (src/components/club/plan/,
 * docs/club/PLAN_ARCHITECTURE.md): Our Family Rhythm, one Letter page for the whole family (Spring Prep, March's
 * earlier resource, is its second tab at /app/club/march/spring-prep). Desktop (>= 1100px): the shared Family Rhythm
 * rail (FamilyRhythmDesktop, also the Welcome resource's) beside the sheet. Below 1100px: the shared plan screen with
 * the reference view (MarchPlanMobile). The sheet and its editor live in MarchFamilyRhythm; the rules in
 * src/lib/club/engines/family-rhythm.ts. The storage and approval keys are the ones the earlier chore charts used, so
 * saved plans carry over (migrated). */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import '../../../styles/club-marks.css';
import MarchFamilyRhythm from '../../../components/club/MarchFamilyRhythm.astro';
import MarchPlanMobile from '../../../components/club/MarchPlanMobile.astro';
import MarchTabs from '../../../components/club/MarchTabs.astro';
import FamilyRhythmDesktop from '../../../components/club/FamilyRhythmDesktop.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-03');
if (!kit) throw new Error('March kit missing');
const deadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:club:march-chore-charts:v2';
---
<AppLayout title="March Family Rhythm">
  <ClubPlanShell class="mch-plan family-brand" kitSlug={kit.slug} month="March" storageKey={storageKey}>
    <FamilyRhythmDesktop slot="desktop" deadline={deadline} kicker="March · Kit preview" instructions={[
      'Two moments your family already shares each day, and everyone’s part in them. When the moment comes, each person knows their job, so nobody has to be the reminder.',
      'One or two new habits are marked for the family to practice; the rest is what you already do. Hang it where everyone passes.',
    ]} />
    <div class="mch-proof" slot="printable" data-plan-proof-body>
      <div class="mch-scroll" data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <div class="mch-tabs-desktop"><MarchTabs current="rhythm" /></div>
        <MarchFamilyRhythm storageKey={storageKey} />
      </div>
    </div>
    <MarchPlanMobile slot="mobile" deadline={deadline} />
  </ClubPlanShell>
</AppLayout>

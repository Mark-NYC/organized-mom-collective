---
/** March Club kit in the app, on the shared Club plan shell (src/components/club/plan/,
 * docs/club/PLAN_ARCHITECTURE.md): the family chore charts, one per child (Spring Prep, March's earlier resource, is
 * its second tab at /app/club/march/spring-prep). Desktop (>= 1100px): the shared rail (ClubPlanDesktop) beside the
 * charts. Below 1100px: the shared plan screen with March's sections (MarchPlanMobile). The charts and their editor
 * live in MarchChoreCharts; the rules in src/lib/club/engines/march-chore-charts.ts. */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import MarchChoreCharts from '../../../components/club/MarchChoreCharts.astro';
import MarchPlanMobile from '../../../components/club/MarchPlanMobile.astro';
import MarchTabs from '../../../components/club/MarchTabs.astro';
import ClubPlanDesktop from '../../../components/club/plan/ClubPlanDesktop.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-03');
if (!kit) throw new Error('March kit missing');
const deadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:club:march-chore-charts:v1';
---
<AppLayout title="March Family Chore Charts">
  <ClubPlanShell class="mch-plan family-brand" kitSlug={kit.slug} month="March" storageKey={storageKey}>
    <ClubPlanDesktop slot="desktop" deadline={deadline} kicker="March · Kit preview" instructions={[
      'One chart for each child, prepared for their age: daily jobs, one job a day that matches your wall calendar’s cleaning zone, family jobs they take turns with, and a growth level on every job.',
      'Hang each chart where it gets seen. As a job moves from Learning it to I own it, change the level and print a fresh copy.',
    ]}>
      <Fragment slot="title">Our Family <em>Chore Charts</em></Fragment>
      <div class="cpd-details">
        <section class="cpd-block" aria-labelledby="mch-d-kids">
          <p class="cpd-label" id="mch-d-kids">The charts</p>
          <dl class="cpd-rows" data-mch-d-kids></dl>
          <button type="button" class="cpd-link" data-mch-d-open>Change jobs, levels and turns</button>
          <button type="button" class="cpd-link" data-mch-d-restore hidden>Restore the prepared charts</button>
          <p class="cpd-hint" data-mch-d-restored role="status" tabindex="-1"></p>
        </section>
      </div>
    </ClubPlanDesktop>
    <div class="mch-proof" slot="printable" data-plan-proof-body>
      <div class="mch-scroll" data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <div class="mch-tabs-desktop"><MarchTabs current="charts" /></div>
        <MarchChoreCharts storageKey={storageKey} />
      </div>
    </div>
    <MarchPlanMobile slot="mobile" deadline={deadline} />
  </ClubPlanShell>
</AppLayout>
<style is:global>
.mch-tabs-desktop{display:none}
@media screen and (min-width:1100px){.mch-tabs-desktop{display:block}}
</style>
<script>
import { restoreAll, planChanged, type ChorePlan, type ChoreState } from '../../../lib/club/engines/march-chore-charts';
import { mountPlanDesktop } from '../../../lib/club/plan/desktop';
import { el } from '../../../lib/club/plan/dom';

const root = document.querySelector<HTMLElement>('.mch-plan');
const host = root?.querySelector<HTMLElement & { clubPlan?: ChorePlan }>('[data-mcc]');
if (root && host) {
  const plan = () => host.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const restored = q('[data-mch-d-restored]');
  let undo: ChoreState | null = null;
  mountPlanDesktop<ChoreState>({
    root,
    host,
    approvalKey: 'omc:preview:march-chore-charts:approval',
    edit: () => plan().openEditor(),
    lock: (on) => plan().setLocked(on),
    render: (_r, locked) => {
      const v = plan().view();
      const rows = v.charts.map((c) => {
        const b = el('button', { type: 'button', class: 'cpd-link', disabled: locked }, `${c.name} (${c.age})`);
        b.addEventListener('click', () => plan().openEditor(c.id));
        return el('div', {}, el('dt', {}, b), el('dd', {}, `${c.daily.length} daily · ${c.weekly.filter((w) => w.job).length} weekly${c.turns.length ? ` · ${c.turns.length} shared` : ''}`));
      });
      q('[data-mch-d-kids]').replaceChildren(...(rows.length ? rows : [el('div', {}, el('dt', {}, 'Children'), el('dd', {}, 'None yet'))]));
      q<HTMLButtonElement>('[data-mch-d-open]').disabled = locked;
      q('[data-mch-d-restore]').hidden = locked || !planChanged(plan().state());
    },
  });
  q('[data-mch-d-open]').addEventListener('click', () => plan().openEditor());
  q('[data-mch-d-restore]').addEventListener('click', () => {
    undo = structuredClone(plan().state());
    plan().update((s) => restoreAll(s));
    const u = el('button', { type: 'button', class: 'cpd-undo' }, 'Undo');
    u.addEventListener('click', () => { if (undo) plan().replace(undo); undo = null; restored.textContent = 'Changes put back.'; });
    restored.replaceChildren('Charts restored. ', u);
    restored.focus();
  });
}
</script>

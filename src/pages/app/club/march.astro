---
/** March Club kit in the app, on the shared Club plan shell (src/components/club/plan/,
 * docs/club/PLAN_ARCHITECTURE.md). Desktop (>= 1100px): the shared October-style rail (ClubPlanDesktop) with the five
 * jobs and their owners, beside the one-page printable. Below 1100px: the shared plan screen with March's jobs
 * (MarchPlanMobile). The printable, its owner editor and its rules live in MarchSpringPrep and
 * src/lib/club/engines/march-spring-prep.ts. */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import MarchSpringPrep from '../../../components/club/MarchSpringPrep.astro';
import MarchPlanMobile from '../../../components/club/MarchPlanMobile.astro';
import ClubPlanDesktop from '../../../components/club/plan/ClubPlanDesktop.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-03');
if (!kit) throw new Error('March 2027 kit missing from the registry');
const deadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:club:march-app:v1';
---
<AppLayout title="March Spring Prep">
  <ClubPlanShell class="mar-plan family-brand" kitSlug={kit.slug} month="March" storageKey={storageKey}>
    <ClubPlanDesktop slot="desktop" deadline={deadline} kicker="March · Kit preview" instructions={[
      'Mom shouldn’t have to plan every spring-cleaning job, explain every step, and check that it’s finished. We’ve prepared five optional jobs with age-appropriate owners, supplies, and clear finish lines.',
      'Each owner gathers supplies, does the job, and checks their own work. No deadlines and no tracking: pick a job when it fits, or skip it.',
    ]}>
      <Fragment slot="title">Our Family <em>Spring Prep</em></Fragment>
      <div class="cpd-details">
        <section class="cpd-block" aria-labelledby="mar-d-jobs">
          <p class="cpd-label" id="mar-d-jobs">Who owns each job</p>
          <dl class="cpd-rows" data-mar-jobs></dl>
          <button type="button" class="cpd-link" data-mar-open>Change owners</button>
          <button type="button" class="cpd-link" data-mar-restore="owners" hidden>Restore suggested owners</button>
          <p class="cpd-hint" data-mar-restore-hint="owners" hidden>Puts the suggested people back on every job. Your wording stays.</p>
        </section>
        <section class="cpd-block" aria-labelledby="mar-d-words">
          <p class="cpd-label" id="mar-d-words">Words on the printable</p>
          <p>Click any job step on the sheet with a pencil to change it.</p>
          <button type="button" class="cpd-link" data-mar-restore="words" hidden>Restore original wording</button>
          <p class="cpd-hint" data-mar-restore-hint="words" hidden>Puts back the original job steps. Owners stay.</p>
          <p class="cpd-hint" data-mar-restored role="status" tabindex="-1"></p>
        </section>
      </div>
    </ClubPlanDesktop>
    <div class="mar-proof" slot="printable" data-plan-proof-body>
      <div class="mar-scroll" data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <MarchSpringPrep storageKey={storageKey} planMode={true} />
      </div>
    </div>
    <MarchPlanMobile slot="mobile" deadline={deadline} />
  </ClubPlanShell>
</AppLayout>
<script>
import { ownersChanged, restoreOwners, restoreWording, wordingChanged, type MarPlan, type MarState } from '../../../lib/club/engines/march-spring-prep';
import { mountPlanDesktop } from '../../../lib/club/plan/desktop';
import { el } from '../../../lib/club/plan/dom';

const root = document.querySelector<HTMLElement>('.mar-plan');
const msc = root?.querySelector<HTMLElement & { clubPlan?: MarPlan }>('.msc');
if (root && msc) {
  const plan = () => msc.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const restored = q('[data-mar-restored]');
  let undo: MarState | null = null;

  mountPlanDesktop<MarState>({
    root,
    host: msc,
    approvalKey: 'omc:preview:march-spring-prep:approval',
    edit: () => plan().openEditor(),
    lock: (on) => plan().setLocked(on),
    render: (_r, locked) => {
      const s = plan().state();
      q('[data-mar-jobs]').replaceChildren(...plan().view().tasks.map((t) => el('div', {}, el('dt', {}, t.title), el('dd', {}, t.owner))));
      q<HTMLButtonElement>('[data-mar-open]').disabled = locked;
      for (const [which, changed] of [['owners', ownersChanged(s)], ['words', wordingChanged(s)]] as const) {
        q(`[data-mar-restore="${which}"]`).hidden = locked || !changed;
        q(`[data-mar-restore-hint="${which}"]`).hidden = locked || !changed;
      }
    },
  });

  q('[data-mar-open]').addEventListener('click', () => plan().openEditor());
  root.querySelectorAll<HTMLButtonElement>('[data-mar-restore]').forEach((b) => b.addEventListener('click', () => {
    undo = structuredClone(plan().state());
    const owners = b.dataset.marRestore === 'owners';
    plan().update((s) => (owners ? restoreOwners(s, plan().members()) : restoreWording(s)));
    const u = el('button', { type: 'button', class: 'cpd-undo' }, 'Undo');
    u.addEventListener('click', () => { if (undo) plan().replace(undo); undo = null; restored.textContent = 'Changes put back.'; });
    restored.replaceChildren(owners ? 'Suggested owners restored. ' : 'Original wording restored. ', u);
    restored.focus();
  }));
}
</script>

---
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import MaySummerRhythm from '../../../components/club/MaySummerRhythm.astro';
import MayPlanMobile from '../../../components/club/MayPlanMobile.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit=kits.find(k=>k.month==='2027-05');
if(!kit) throw new Error('May kit missing');
const deadline=clubEditingDeadline(kit.month);
const storageKey='omc:club:may-app:v1';
---
<AppLayout title="May Summer Day Rhythm">
 <ClubPlanShell class="may-plan family-brand" kitSlug={kit.slug} month="May" storageKey={storageKey}>
  <aside class="may-rail" slot="desktop">
   <header class="may-header"><a class="may-back" href="/app/club">← Back to Club</a>
    <p class="may-kicker">May · Kit Preview</p><h1>Our <em>Summer Day</em></h1>
   </header>
   <section class="may-deadline" data-deadline={deadline} aria-label="Editing deadline">
    <p class="may-deadline-title">Your editing window</p><p data-deadline-status>Checking deadline…</p>
    <div class="may-countdown" data-countdown hidden role="timer"><span><strong data-days>–</strong><small>Days</small></span><span><strong data-hours>–</strong><small>Hours</small></span><span><strong data-minutes>–</strong><small>Minutes</small></span></div>
    <p data-deadline-detail></p>
   </section>
   <div class="may-actions"><button type="button" data-may-edit>Make changes</button><button type="button" data-may-approve>Approve preview</button><button type="button" data-plan-print>Download and print</button></div>
   <div class="may-note"><p data-plan-source></p><p data-approval-note role="status">Preview only: approving doesn’t save, submit or mail anything. Mailing isn’t active yet.</p></div>
   <div class="may-instructions"><p>A reusable rhythm for the refrigerator, with flexible anchors your kids can check for themselves.</p><p>Review the prepared day and change the activities or times to fit your family. Plans can change; the rhythm is a guide.</p></div>
  </aside>
  <div class="may-proof" slot="printable" data-plan-proof-body>
   <div class="may-scroll" data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
    <MaySummerRhythm storageKey={storageKey} planMode={true}/>
   </div>
  </div>
  <MayPlanMobile slot="mobile" deadline={deadline}/>
 </ClubPlanShell>
</AppLayout>
<style is:global>
.may-rail{display:none}.may-plan .msr{padding:0;max-width:none}.may-plan .msr-intro,.may-plan .msr-editor,.may-plan .msr-floating-edit{display:none!important}.may-plan .msr-layout{display:block}.may-plan .msr-preview{padding:0}.may-plan .msr-dialog{z-index:100}.may-plan .msr-stage{margin:auto}
@media screen and (min-width:1100px){
 html:has(.may-plan),body:has(.may-plan){height:100%;overflow:hidden}
 body:has(.may-plan) #main{width:100%;max-width:none;height:calc(100dvh - 64px);min-height:0;margin:0;padding:0;overflow:hidden}
 .may-plan{display:grid;grid-template-columns:minmax(310px,375px) minmax(0,1fr);height:100%;min-height:0;background:var(--color-ivory);overflow:hidden}
 .may-plan .may-rail{display:block;overflow-y:auto;min-height:0;background:var(--color-ivory);border-right:1px solid var(--color-warm-rule);padding:clamp(40px,6vh,70px) clamp(22px,2.7vw,42px) 40px}
 .may-header{padding-bottom:30px;margin-bottom:28px;border-bottom:1px solid var(--color-warm-rule)}
 .may-back{color:var(--color-warm-ink);font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;text-decoration-color:var(--color-warm-rule);text-underline-offset:6px}
 .may-kicker{margin-top:30px;font-size:.7rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--color-warm-soft)}
 .may-rail h1{font:400 clamp(34px,3vw,42px)/1.12 var(--font-serif);letter-spacing:-.02em;color:var(--color-warm-ink);margin:18px 0 19px}.may-rail h1 em{color:inherit}
 .may-deadline{margin:0 0 20px;padding-bottom:20px;border-bottom:1px solid var(--color-warm-rule);color:var(--color-warm-soft);font-size:.83rem}.may-deadline-title{letter-spacing:.16em;text-transform:uppercase;font-weight:600;font-size:.68rem;margin-bottom:10px}
 .may-countdown{display:flex;gap:20px;margin:12px 0}.may-countdown[hidden]{display:none}.may-countdown span{display:flex;flex-direction:column}.may-countdown strong{font:400 1.65rem var(--font-serif);font-variant-numeric:tabular-nums;color:var(--color-warm-ink)}.may-countdown small{font-size:.66rem;letter-spacing:.1em;text-transform:uppercase}.may-deadline [data-deadline-detail]{font-size:.74rem;line-height:1.5}
 .may-actions{display:flex;flex-direction:column;gap:12px}.may-actions button{min-height:48px;padding:12px 20px;border:1px solid var(--color-warm-ink);border-radius:3px;background:transparent;color:var(--color-warm-ink);font:600 .75rem var(--font-sans);letter-spacing:.13em;text-transform:uppercase;cursor:pointer}.may-actions [data-may-approve]{background:var(--color-warm-button);color:#fff;border-color:var(--color-warm-button)}.may-actions [data-plan-print]{align-self:flex-start;border:0;padding:5px 8px;min-height:44px;text-decoration:underline;text-decoration-color:var(--color-warm-rule);text-underline-offset:6px}
 .may-note{font-size:.78rem;line-height:1.65;color:var(--color-warm-soft);margin-top:12px}.may-instructions{display:grid;gap:11px;margin-top:28px;border-top:1px solid var(--color-warm-rule);padding-top:22px;color:var(--color-warm-soft);font-size:.9rem;line-height:1.7}
 .may-plan .may-proof{height:100%;min-width:0;overflow:hidden}.may-plan .may-scroll{height:100%;overflow:auto;background:#f1f2f2;padding:clamp(32px,4vw,62px) clamp(28px,5vw,82px) 84px;overscroll-behavior:contain}
}
@media print{.may-rail{display:none!important}}
</style>
<script>
import { editingWindow } from '../../../lib/club/edition-status';
import { onPlanFamily } from '../../../lib/club/plan/family';
const root=document.querySelector<HTMLElement>('.may-plan');
if(root){
 onPlanFamily(root,result=>{const n=root.querySelector<HTMLElement>('[data-plan-source]');if(n)n.textContent=result.source==='sample' ? `Sample family: ${result.sampleLabel.replace('Sample: ','')}.` : `Prepared for ${result.household.displayName ?? 'your family'}.`});
 const deadlineNode=root.querySelector<HTMLElement>('[data-deadline]');
 const windowState=editingWindow(deadlineNode?.dataset.deadline ?? '',new Date());
 if(deadlineNode){
  const update=()=>{const ms=Date.parse(deadlineNode.dataset.deadline ?? '')-Date.now();const mins=Math.max(0,Math.ceil(ms/60000));const box=deadlineNode.querySelector<HTMLElement>('[data-countdown]');const status=deadlineNode.querySelector<HTMLElement>('[data-deadline-status]');const detail=deadlineNode.querySelector<HTMLElement>('[data-deadline-detail]');
   if(status)status.textContent=mins?'Time left to make changes':'Scheduled editing window ended.';
   if(box)box.hidden=!mins;
   for(const [selector,value] of Object.entries({'[data-days]':Math.floor(mins/1440),'[data-hours]':Math.floor(mins%1440/60),'[data-minutes]':mins%60})){const el=deadlineNode.querySelector<HTMLElement>(selector);if(el)el.textContent=String(value).padStart(2,'0')}
   if(detail)detail.textContent=`Cutoff: ${new Intl.DateTimeFormat('en-US',{dateStyle:'medium',timeStyle:'short',timeZone:'America/New_York'}).format(Date.parse(deadlineNode.dataset.deadline ?? ''))} ET. Preview only; no PDF is sent.`;
  };update();const timer=window.setInterval(update,15000);window.addEventListener('pagehide',()=>window.clearInterval(timer),{once:true});
 }
 if(windowState.phase==='closed'){
  const edit=root.querySelector<HTMLButtonElement>('[data-may-edit]');if(edit){edit.disabled=true;edit.textContent='Editing window closed'}
  root.querySelectorAll<HTMLElement>('.msr [contenteditable]').forEach(el=>el.setAttribute('contenteditable','false'));
  root.querySelectorAll<HTMLElement>('.msr [data-time], .msr [data-move-up], .msr [data-move-down], .msr [data-remove]').forEach(el=>{el.style.pointerEvents='none';el.setAttribute('tabindex','-1')});
 }
 root.querySelector('[data-may-approve]')?.addEventListener('click',()=>{const note=root.querySelector<HTMLElement>('[data-approval-note]');if(note)note.textContent='Marked as reviewed on this screen only. Nothing was saved, submitted or mailed.'});
 root.querySelector('[data-may-edit]')?.addEventListener('click',()=>root.querySelector<HTMLButtonElement>('.msr [data-open-editor]')?.click());
}
</script>

---
/** May Club kit in the app, on the shared Club plan shell (src/components/club/plan/,
 * docs/club/PLAN_ARCHITECTURE.md). Desktop (>= 1100px): the shared October-style rail (ClubPlanDesktop) with the day's
 * rhythm, beside the one-page printable. Below 1100px: the shared plan screen with May's rows (MayPlanMobile).
 * The printable, its editor and its rules live in MaySummerRhythm and src/lib/club/engines/may-summer-rhythm.ts. */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import MaySummerRhythm from '../../../components/club/MaySummerRhythm.astro';
import MayPlanMobile from '../../../components/club/MayPlanMobile.astro';
import ClubPlanDesktop from '../../../components/club/plan/ClubPlanDesktop.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-05');
if (!kit) throw new Error('May 2027 kit missing from the registry');
const deadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:club:may-app:v1';
---
<AppLayout title="May Summer Day Rhythm">
  <ClubPlanShell class="may-plan family-brand" kitSlug={kit.slug} month="May" storageKey={storageKey}>
    <ClubPlanDesktop slot="desktop" deadline={deadline} kicker="May · Kit preview" instructions={[
      'A reusable rhythm for the refrigerator, with flexible anchors your kids can check for themselves.',
      'Review the prepared day and change the activities or times to fit your family. Plans can change; the rhythm is a guide.',
    ]}>
      <Fragment slot="title">Our <em>Summer Day</em></Fragment>
      <div class="cpd-details">
        <section class="cpd-block" aria-labelledby="may-d-day">
          <p class="cpd-label" id="may-d-day">Your summer day</p>
          <dl class="cpd-rows" data-may-d-rows></dl>
          <button type="button" class="cpd-link" data-may-d-open>Change the day</button>
          <p>Or click a block’s name, activities or time on the sheet to change it.</p>
        </section>
      </div>
    </ClubPlanDesktop>
    <div class="may-proof" slot="printable" data-plan-proof-body>
      <div class="may-scroll" data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <MaySummerRhythm storageKey={storageKey} planMode={true} />
      </div>
    </div>
    <MayPlanMobile slot="mobile" deadline={deadline} />
  </ClubPlanShell>
</AppLayout>
<style is:global>
.may-plan .msr-dialog{z-index:100}
</style>
<script>
import type { MayPlan, MayState } from '../../../lib/club/engines/may-summer-rhythm';
import { mountPlanDesktop } from '../../../lib/club/plan/desktop';
import { el } from '../../../lib/club/plan/dom';

const root = document.querySelector<HTMLElement>('.may-plan');
const msr = root?.querySelector<HTMLElement & { clubPlan?: MayPlan }>('.msr');
if (root && msr) {
  const plan = () => msr.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const clock = (t: string) => (t ? new Date(`2000-01-01T${t}`).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : 'Any time');
  mountPlanDesktop<MayState>({
    root,
    host: msr,
    approvalKey: 'omc:preview:may-summer-rhythm:approval',
    edit: () => plan().openEditor(),
    lock: (on) => plan().setLocked(on),
    render: (r, locked) => {
      q('[data-may-d-rows]').replaceChildren(...r.state().rows.map((row) => el('div', {}, el('dt', {}, row.title), el('dd', {}, clock(row.time)))));
      q<HTMLButtonElement>('[data-may-d-open]').disabled = locked;
    },
  });
  q('[data-may-d-open]').addEventListener('click', () => plan().openEditor());
}
</script>

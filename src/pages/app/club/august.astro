---
/** August Club kit in the app, Back to School Without the Scramble, on the shared Club plan shell
 * (src/components/club/plan/, docs/club/PLAN_ARCHITECTURE.md) and the shared personalization foundation
 * (docs/club/PERSONALIZATION_FOUNDATION.md). Desktop (>= 1100px): the shared rail (ClubPlanDesktop) with the family
 * plan and each child's routine, beside the sheets: the family plan, then a routine per school-aged child. Below
 * 1100px: the shared plan screen with August's sections (AugustPlanMobile). The printable, its editors and its rules
 * live in AugustSchoolRoutines and src/lib/club/engines/august-school-routines.ts. */
import AppLayout from '../../../layouts/AppLayout.astro';
import '../../../styles/family-app-brand.css';
import AugustSchoolRoutines from '../../../components/club/AugustSchoolRoutines.astro';
import AugustPlanMobile from '../../../components/club/AugustPlanMobile.astro';
import ClubPlanDesktop from '../../../components/club/plan/ClubPlanDesktop.astro';
import ClubPlanShell from '../../../components/club/plan/ClubPlanShell.astro';
import { clubEditingDeadline } from '../../../lib/club/deadline';
import { kits } from '../../../data/club/kits';
const kit = kits.find((k) => k.month === '2027-08');
if (!kit) throw new Error('August 2027 kit missing from the registry');
const deadline = clubEditingDeadline(kit.month);
const storageKey = 'omc:club:august-app:v1';
---
<AppLayout title="Back to School Without the Scramble">
  <ClubPlanShell class="aug-plan family-brand" kitSlug={kit.slug} month="August" storageKey={storageKey}>
    <ClubPlanDesktop slot="desktop" deadline={deadline} kicker="August · Kit preview" instructions={[
      'Your family’s back-to-school plan: who does what before the first day, the night before, on school mornings and after school, prepared from your family page with every child’s own part and the grown-up jobs shared between the grown-ups.',
      'Then two charts for the whole family to see: a Morning Routine timed to be out the door on time, and an After-School Routine. Each step has a time, a trigger (the everyday moment that starts it), or both; a step only some children do names them.',
    ]}>
      <Fragment slot="title">Back to School <em>Without the Scramble</em></Fragment>
      <div class="cpd-details">
        <section class="cpd-block" aria-labelledby="aug-d-plan" data-aug-d-plan-block>
          <p class="cpd-label" id="aug-d-plan">Our back-to-school plan</p>
          <dl class="cpd-rows" data-aug-d-plan></dl>
          <button type="button" class="cpd-link" data-aug-d-plan-open>Change who does what</button>
        </section>
        <section class="cpd-block" aria-labelledby="aug-d-routine">
          <p class="cpd-label" id="aug-d-routine">Our routine charts</p>
          <dl class="cpd-rows" data-aug-d-rows></dl>
          <button type="button" class="cpd-link" data-aug-d-open>Edit steps, times and triggers</button>
          <p>Or click a step, a time or the line under the title on the chart to change it.</p>
          <button type="button" class="cpd-link" data-aug-d-restore hidden>Restore the prepared charts</button>
          <p class="cpd-hint" data-aug-d-hint hidden></p>
          <p class="cpd-hint" data-aug-d-restored role="status" tabindex="-1"></p>
        </section>
      </div>
    </ClubPlanDesktop>
    <div class="aug-proof" slot="printable" data-plan-proof-body>
      <div class="aug-scroll" data-plan-proof-scroll tabindex="0" role="region" aria-label="Printable preview">
        <AugustSchoolRoutines storageKey={storageKey} planMode={true} />
      </div>
    </div>
    <AugustPlanMobile slot="mobile" deadline={deadline} />
  </ClubPlanShell>
</AppLayout>
<style is:global>
.aug-plan .asr-dialog{z-index:100}
.aug-plan [data-aug-d-plan-block][hidden]{display:none}
</style>
<script>
import { restoreRoutine, routineChanged, type AugPlan, type AugState } from '../../../lib/club/engines/august-school-routines';
import { mountPlanDesktop } from '../../../lib/club/plan/desktop';
import { el } from '../../../lib/club/plan/dom';

const root = document.querySelector<HTMLElement>('.aug-plan');
const asr = root?.querySelector<HTMLElement & { clubPlan?: AugPlan }>('.asr');
if (root && asr) {
  const plan = () => asr.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const restored = q('[data-aug-d-restored]');
  const row = (dt: string, dd: string) => el('div', {}, el('dt', {}, dt), el('dd', {}, dd));
  let undo: AugState | null = null;
  mountPlanDesktop<AugState>({
    root,
    host: asr,
    approvalKey: 'omc:preview:august-school-routines:approval',
    edit: () => (plan().view().plan.active ? plan().openPlanEditor() : plan().openEditor()),
    lock: (on) => plan().setLocked(on),
    render: (_r, locked) => {
      const v = plan().view();
      q('[data-aug-d-plan-block]').hidden = !v.plan.active;
      q('[data-aug-d-plan]').replaceChildren(row('Out the door', v.plan.leaveClock),
        ...v.plan.sections.map((sec) => { const on = sec.tasks.filter((t) => !t.skipped); return row(sec.title, `${on.length} ${on.length === 1 ? 'job' : 'jobs'}`); }));
      q<HTMLButtonElement>('[data-aug-d-plan-open]').disabled = locked;
      q('[data-aug-d-rows]').replaceChildren(...v.charts.map((c) => {
        const b = el('button', { type: 'button', class: 'cpd-link', disabled: locked }, c.title);
        b.addEventListener('click', () => plan().openEditor(c.group));
        const timed = c.steps.filter((x) => x.time);
        const when = timed.length ? `${timed[0].clock!.join(' ')} to ${timed.at(-1)!.clock!.join(' ')}` : 'triggers only';
        return el('div', {}, el('dt', {}, b), el('dd', {}, `${c.steps.length} steps, ${when}${c.issues.length ? ` · ${c.issues.length} to check` : ''}`));
      }), ...(v.sampleTimes ? [row('Times', 'Sample times: add when school starts on your family page')] : []));
      q<HTMLButtonElement>('[data-aug-d-open]').disabled = locked;
      const changed = !locked && routineChanged(plan().state(), plan().members());
      q('[data-aug-d-restore]').hidden = !changed;
      const hint = q('[data-aug-d-hint]');
      hint.hidden = !changed;
      hint.textContent = 'Puts back the prepared steps, times, triggers and wording on both charts.';
    },
  });
  q('[data-aug-d-open]').addEventListener('click', () => plan().openEditor());
  q('[data-aug-d-plan-open]').addEventListener('click', () => plan().openPlanEditor());
  q('[data-aug-d-restore]').addEventListener('click', () => {
    undo = structuredClone(plan().state());
    plan().update((s) => restoreRoutine(s, plan().members()));
    const u = el('button', { type: 'button', class: 'cpd-undo' }, 'Undo');
    u.addEventListener('click', () => { if (undo) plan().replace(undo); undo = null; restored.textContent = 'Changes put back.'; });
    restored.replaceChildren('Charts restored. ', u);
    restored.focus();
  });
}
</script>

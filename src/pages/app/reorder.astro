---
import Layout from '../../layouts/AppLayout.astro';
import { BRAND_NAME, REORDER_URL } from '../../config';
import { monthColors } from '../../theme';

const months = monthColors.map((m) => ({ short: m.name.slice(0, 3), hex: m.hex }));
---

<Layout title="Reorder" description={`Order your next six-month ${BRAND_NAME} family calendar.`}>
  <div class="max-w-xl">
    <p class="label text-muted">Reorder</p>
    <h1 class="page-title mt-3">Ready for your next calendar?</h1>
    <p class="mt-3 text-[1.0625rem] leading-relaxed">
      Keep your family planning system going with your next six-month {BRAND_NAME} calendar.
    </p>

    <!-- The next six months, in their printed colors -->
    <div class="mt-10 border border-rule-strong" aria-hidden="true">
      <div id="next-six" class="grid grid-cols-6">
        {
          months.slice(0, 6).map((m) => (
            <span class="border-r border-rule last:border-r-0">
              <span class="block h-7" style={`background-color:${m.hex}`} />
              <span class="block px-1 pt-1.5 pb-6 text-center text-[0.6rem] font-semibold tracking-[0.14em] uppercase">{m.short}</span>
            </span>
          ))
        }
      </div>
    </div>
    <p class="label mt-2.5 text-center text-muted">Six months · one wall</p>

    <a href={REORDER_URL} class="btn-primary mt-10 w-full sm:w-auto" rel="noopener">Order My Next Calendar</a>

    <section aria-labelledby="when-h" class="mt-14 border-t border-rule-strong pt-5">
      <h2 id="when-h" class="label">When to reorder</h2>
      <p class="mt-2 text-[1.0625rem] leading-relaxed">
        About a month before your last page, so the new one arrives before the old one runs out. Your cleaning checklist
        here keeps working either way.
      </p>
    </section>
  </div>

  <script is:inline define:vars={{ months }}>
    // Start the strip at next month.
    const start = new Date().getMonth() + 1;
    const cells = document.querySelectorAll('#next-six > span');
    cells.forEach((cell, i) => {
      const m = months[(start + i) % 12];
      cell.children[0].style.backgroundColor = m.hex;
      cell.children[1].textContent = m.short;
    });
  </script>
</Layout>

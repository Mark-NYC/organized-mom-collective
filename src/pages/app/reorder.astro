---
import Layout from '../../layouts/AppLayout.astro';
import { BEST_VALUE_ID, BRAND_NAME, CALENDAR_OPTIONS } from '../../config';
import { etsyListingUrl, formatPrice, formatSpan, savingsVersus } from '../../lib/reorder';

const smallest = CALENDAR_OPTIONS.reduce((a, b) => (b.weeks < a.weeks ? b : a));
const options = CALENDAR_OPTIONS.map((o) => {
  const sets = o.weeks / smallest.weeks;
  return {
    ...o,
    url: etsyListingUrl(o.etsyUrl),
    shortName: o.name.replace(/ Calendar$/, ''),
    priceLabel: formatPrice(o.price),
    bestValue: o.id === BEST_VALUE_ID,
    save: o.id === smallest.id || sets !== 2 ? 0 : savingsVersus(o, smallest),
    setsWeeks: sets === 2 ? smallest.weeks : 0,
    editions: o.editions.map((e) => ({ label: e.label, span: formatSpan(e.start, e.end) })),
  };
  // Recommended option first, so on phones it's the first one she sees.
}).sort((a, b) => Number(b.bestValue) - Number(a.bestValue));

// Flag missing listings in the build output so they don't go unnoticed.
for (const o of options) {
  if (!o.url) console.warn(`[reorder] No valid Etsy listing URL for "${o.name}" — its button is disabled. Set etsyUrl in src/config.ts.`);
}

/** Etsy listing photos, resized to 640/960/1280 (originals in design/etsy-listing/). */
const photo = (name: string) => ({
  src: `/images/reorder/${name}-960.webp`,
  srcset: [640, 960, 1280].map((w) => `/images/reorder/${name}-${w}.webp ${w}w`).join(', '),
});
const half = '(min-width: 768px) 464px, calc(100vw - 2.5rem)';

const benefits = [
  { title: 'Everyone’s schedule in one place.', body: 'School runs, practices and plans on one wall the whole family can see.' },
  { title: 'Meals and groceries, planned together.', body: 'Write the week’s dinners and the grocery list sits right beside them.' },
  { title: 'Cleaning that’s easier to keep up with.', body: 'One small zone printed on each day, so the house never gets away from you.' },
  { title: 'Room for what matters most.', body: 'Space every week for family priorities, prayer and gratitude.' },
];

const reassurance = [
  'A physical 11 × 17-inch wall calendar',
  'Digital cleaning companion included',
  'Secure checkout through Etsy',
  'Your cleaning progress stays in the app',
];
---

<Layout title="Reorder" description={`Get your next ${BRAND_NAME} family wall calendar on Etsy.`}>
  <style is:global>
    @media (prefers-reduced-motion: no-preference) {
      html:has(#buy) {
        scroll-behavior: smooth;
      }
    }
  </style>

  <!-- 1. Hero -->
  <section aria-labelledby="hero-h" class="md:grid md:grid-cols-2 md:items-center md:gap-12">
    <div>
      <p class="label text-muted">Your next calendar</p>
      <h1 id="hero-h" class="page-title mt-3 text-balance">One less thing to keep in your head.</h1>
      <p class="mt-3 text-[1.0625rem] leading-relaxed">Keep your family’s schedules, meals, cleaning, and priorities together in one place.</p>
      <a href="#buy" class="btn-primary mt-6 w-full sm:w-auto">Get Your Next Calendar</a>
    </div>
    <figure class="-mx-5 mt-7 aspect-square overflow-hidden bg-band sm:mx-0 sm:border sm:border-rule md:mt-0">
      <img
        {...photo('calendar-in-use')}
        sizes="(min-width: 768px) 464px, 100vw"
        width="2000"
        height="2000"
        fetchpriority="high"
        decoding="async"
        alt={`A hand writing in the ${BRAND_NAME} wall calendar on a kitchen counter, its week filled with school runs, a meal plan, a grocery list and to-dos.`}
        class="block h-full w-full"
      />
    </figure>
  </section>

  <!-- 2. The product -->
  <section aria-labelledby="week-h" class="mt-14 border-t border-rule-strong pt-8 md:grid md:grid-cols-2 md:gap-12">
    <div>
      <h2 id="week-h" class="text-[1.6rem] leading-tight font-bold sm:text-[1.9rem]">Your week, all in one place.</h2>
      <ul class="mt-5 border-t border-rule">
        {
          benefits.map((b) => (
            <li class="border-b border-rule py-3.5">
              <p class="text-[1.0625rem] leading-snug font-bold">{b.title}</p>
              <p class="mt-1 text-[1rem] leading-snug">{b.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <figure class="mt-7 aspect-square overflow-hidden border border-rule bg-band md:order-first md:mt-0">
      <img
        {...photo('calendar-features')}
        sizes={half}
        width="2000"
        height="2000"
        loading="lazy"
        decoding="async"
        alt="A filled-in week on the calendar with its sections labeled: daily schedule, daily cleaning zone, self-care, word of the week, family and friends, prayer and gratitude, meal plan, grocery list and to-do list."
        class="block h-full w-full"
      />
    </figure>
  </section>

  <!-- 3. Wall + pocket -->
  <section aria-labelledby="pocket-h" class="mt-14 border-t border-rule-strong pt-8 md:grid md:grid-cols-2 md:items-center md:gap-12">
    <div>
      <h2 id="pocket-h" class="text-[1.6rem] leading-tight font-bold text-balance sm:text-[1.9rem]">
        A plan on your wall. A little help in your pocket.
      </h2>
      <dl class="mt-5 grid grid-cols-2 gap-x-4 border-t border-rule pt-4">
        <div>
          <dt class="label">On the wall</dt>
          <dd class="mt-1.5 text-[1rem] leading-snug">Your weekly plan, with a cleaning zone printed on every day.</dd>
        </div>
        <div class="border-l border-rule pl-4">
          <dt class="label">In your pocket</dt>
          <dd class="mt-1.5 text-[1rem] leading-snug">That zone as a short checklist. Tap each task as you go.</dd>
        </div>
      </dl>
      <p class="mt-5 border-l-[3px] border-month py-1 pl-3.5 text-[1rem] leading-relaxed">
        <strong class="font-semibold">Included with every calendar, at no extra cost.</strong> It’s this app, the one you’re using now.
      </p>
    </div>
    <figure class="mt-7 aspect-square overflow-hidden border border-rule bg-band md:mt-0">
      <img
        {...photo('calendar-and-app')}
        sizes={half}
        width="2000"
        height="2000"
        loading="lazy"
        decoding="async"
        alt="The Entry/Bathroom zone printed on the calendar, linked to the same zone on a phone as a checklist: clear entry clutter, wipe counters, wipe sink, clean toilet and more."
        class="block h-full w-full"
      />
    </figure>
  </section>

  <!-- 4. Buy -->
  <section id="buy" aria-labelledby="buy-h" class="mt-14 scroll-mt-4 border-t border-rule-strong pt-8">
    <h2 id="buy-h" class="text-[1.6rem] leading-tight font-bold sm:text-center sm:text-[1.9rem]">Keep the good rhythm going.</h2>
    <p class="mt-2 text-[1rem] text-muted sm:text-center">Same calendar, same system. Pick how far ahead you want to plan.</p>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2 sm:gap-6">
      {
        options.map((o) => (
          <li
            class:list={[
              'flex flex-col rounded-[3px] bg-paper p-5',
              o.bestValue ? 'border-2 border-ink' : 'border border-rule-strong',
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-[1.15rem] leading-tight font-bold">{o.name}</h3>
              {o.bestValue && (
                <span class="shrink-0 bg-month px-2 py-1.5 text-[0.6rem] leading-none font-bold tracking-[0.18em] uppercase">Best value</span>
              )}
            </div>
            <p class="mt-3 flex items-baseline gap-2.5">
              <span class="text-[2.25rem] leading-none font-bold tracking-[-0.01em]">{o.priceLabel}</span>
              <span class="text-[1rem] font-semibold text-muted">{o.weeks} weeks</span>
            </p>
            {o.save > 0 && (
              <p class="mt-2.5 text-[0.95rem] leading-snug font-semibold">
                Save {formatPrice(o.save)} compared with buying two half-year calendars.
              </p>
            )}
            <ul class="mt-4 space-y-2 border-t border-rule pt-3.5">
              {o.editions.map((e) => (
                <li>
                  <p class="text-[0.95rem] font-semibold">{e.label}</p>
                  <p class="text-[0.9rem] text-muted">{e.span}</p>
                </li>
              ))}
            </ul>
            {o.setsWeeks > 0 && <p class="mt-2.5 text-[0.9rem] text-muted">Ships as two {o.setsWeeks}-week sets.</p>}
            <div class="mt-auto pt-5">
              {o.url ? (
                <a
                  href={o.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Buy the ${o.name} on Etsy, ${o.priceLabel} (opens Etsy)`}
                  class:list={['w-full gap-2', o.bestValue ? 'btn-primary' : 'btn-secondary min-h-12 text-[0.75rem] tracking-[0.18em]']}
                >
                  Buy on Etsy <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <p class="flex min-h-12 items-center justify-center rounded-[3px] border border-dashed border-rule-strong px-2 text-center text-[0.66rem] font-semibold tracking-[0.16em] text-muted uppercase">
                  {o.shortName} coming soon to Etsy
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <!-- 5. Reassurance. The guarantee matches the Etsy listing wording; the shop honors it. -->
    <p class="mt-5 border-l-[3px] border-month py-1 pl-3.5 text-[1rem] leading-relaxed">
      <strong class="font-semibold">Arrives damaged or misprinted?</strong> We’ll make it right.
    </p>
    <ul class="mt-5 grid gap-x-6 gap-y-2.5 text-[0.95rem] leading-snug sm:grid-cols-2" aria-label="What you get">
      {
        reassurance.map((r) => (
          <li class="flex gap-2.5">
            <span aria-hidden="true" class="font-bold text-muted">✓</span>
            {r}
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-[0.85rem] leading-relaxed text-muted">
      A new calendar doesn’t reset anything here. Your checkmarks and settings stay saved on this phone.
    </p>
  </section>

  <!-- 6. Closing -->
  <section aria-labelledby="close-h" class="mt-14 border-t border-rule-strong pt-8 md:grid md:grid-cols-2 md:items-center md:gap-12">
    <figure class="aspect-square overflow-hidden border border-rule bg-band">
      <img
        {...photo('baking-with-calendar')}
        sizes={half}
        width="2000"
        height="2000"
        loading="lazy"
        decoding="async"
        alt="A mother and daughter baking chocolate chip cookies, with the family calendar on the counter beside them."
        class="block h-full w-full"
      />
    </figure>
    <div class="mt-7 md:mt-0">
      <h2 id="close-h" class="text-[1.6rem] leading-tight font-bold text-balance sm:text-[1.9rem]">A little more order. A lot more room for life.</h2>
      <a href="#buy" class="btn-primary mt-6 w-full sm:w-auto">Choose Your Calendar</a>
    </div>
  </section>
</Layout>

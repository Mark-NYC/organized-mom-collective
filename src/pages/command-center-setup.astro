---
/**
 * /command-center-setup — a free one-page home command center setup sheet that follows FP-03
 * (/resources/home-command-center): a spot the family passes, the calendar and a pen, two paper pockets
 * ("Needs attention", "Ready to go"), who does what, and the small wins that show it's working.
 * Not the parked Family Command Center kit (/family-sanity-saver-starter-kit): don't link or name it here.
 * Edited on screen, downloaded as a PNG (src/components/site/ChecklistPages.astro). Saves in this browser
 * (`omc:command-center:v1`).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import ChecklistPages from '../components/site/ChecklistPages.astro';
import type { ChecklistPage } from '../lib/checklist-pages';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const pages: ChecklistPage[] = [
  {
    sections: [
      {
        title: 'Set It Up',
        groupCols: 2,
        groups: [
          { title: 'Pick the spot', variant: 'step', step: 1, items: ['Somewhere everyone passes on the way out', 'Kitchen wall', 'Side of the fridge', 'Entryway or mudroom'] },
          { title: 'Calendar & pen', variant: 'step', step: 2, items: ['Calendar at adult eye level', 'Pen that stays there', 'This week: times, places, who drives', 'This week’s meals'] },
          { title: 'Two paper pockets', variant: 'step', step: 3, items: ['“Needs attention” pocket', '“Ready to go” pocket', 'Signed forms move to “Ready to go”', 'Ready papers in bags before bed'] },
          { title: 'Close by', variant: 'step', step: 4, items: ['A hook or bowl for keys', 'A spot for backpacks below or beside', '', ''] },
        ],
      },
      {
        title: 'Who Does What',
        groupCols: 2,
        groups: [
          { title: 'Family roles', variant: 'timeline', items: ['Morning lead:', 'Dinner boss:', 'Trash hero:', 'Laundry checker:'] },
          { title: 'Keep it moving', variant: 'timeline', items: ['Checks the pockets after dinner:', 'Weekly reset day & time:', 'Encourager in chief:', ''] },
        ],
      },
      {
        title: 'It’s Working When…',
        groups: [
          {
            title: 'Small wins',
            variant: 'priority',
            cols: 2,
            items: ['Everyone knew the plan without asking', 'Fewer “where’s my…?” mornings', 'Forms went back signed, on time', 'Someone helped without a reminder', 'Dinner happened when planned', ''],
          },
        ],
      },
    ],
  },
];

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Command Center Setup', item: new URL(routes.commandCenterSetup, site).href },
    ],
  },
];
---

<PublicLayout
  title="Free Home Command Center Setup Sheet"
  description="A free command center setup sheet: pick a spot your family passes, hang the calendar with a pen, add two paper pockets and decide who does what. Edit it and print it."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="ccs-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free command center setup</p>
      <h1 id="ccs-h" class="serif-hero mt-3">One Spot Where the Week Lives.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        A calendar, a pen and two paper pockets where your family already passes, plus who does what so it isn’t all on you. Tick it off as
        you set it up, fill in the names, then print it and post it right there.
      </p>
    </div>
  </section>

  <ChecklistPages title="Command Center Setup" pages={pages} storageKey="omc:command-center:v1" filename="command-center-setup">
    <p slot="footnote" class="ck-footnote">
      The why behind each step: <a href={routes.article('home-command-center')} class="text-link">How to Set Up a Home Command Center</a>.
      {' '}Want the calendar for it? See the <a href={routes.calendar} data-cta="command-center-setup" class="text-link">Family Wall Calendar</a>
    </p>
  </ChecklistPages>
</PublicLayout>

---
import PublicLayout from '../layouts/PublicLayout.astro';
import { routes } from '../routes';
import { freeTools } from '../data/free-tools';
import { imageAttrs } from '../data/images';
import { toolEmailGateEnabled } from '../lib/tool-email';
const popularPaths = [routes.mentalLoad, routes.mealPlanner, routes.laundrySystem, routes.tryCalendar, routes.lunchSnackStation];
const groups = [
  { id: 'everyone', title: 'Get everyone involved', intro: 'Whole jobs and small routines the family can own.', paths: [routes.mentalLoad, routes.lunchSnackStation, routes.screenTime, routes.gratitudeTracker, routes.decemberCountdown] },
  { id: 'planning', title: 'Plan the week', intro: 'Put the details where everyone can find them, with a person beside each job.', paths: [routes.mealPlanner, routes.tryCalendar, routes.pantry, routes.homeschoolRhythm, routes.backToSchool, routes.travelChecklist, routes.commandCenterSetup, routes.fallPantry, routes.thanksgivingPlan, routes.holidayGifts] },
  { id: 'home', title: 'Keep the house moving', intro: 'Clear jobs, clear owners and a smaller version for hard weeks.', paths: [routes.laundrySystem, routes.closetReset, routes.paperBlitz, routes.springCleaning, routes.fallCleaning, routes.newYearDeclutter] },
];
const benefits: Record<string, string> = {
  [routes.mentalLoad]: 'Hand one whole job to someone else',
  [routes.lunchSnackStation]: 'Help kids make their own lunches',
  [routes.screenTime]: 'Agree on screen time together',
  [routes.gratitudeTracker]: 'Make gratitude a family habit',
  [routes.decemberCountdown]: 'Make December fun without adding more work',
  [routes.mealPlanner]: 'Take the guesswork out of dinner',
  [routes.tryCalendar]: 'See where everyone needs to be',
  [routes.pantry]: 'Stop buying what you already have',
  [routes.homeschoolRhythm]: 'Find a rhythm that fits your school days',
  [routes.backToSchool]: 'Get ready for the first school day',
  [routes.travelChecklist]: 'Pack for everyone without the scramble',
  [routes.commandCenterSetup]: 'Give family papers and plans a home',
  [routes.fallPantry]: 'Find what you need before the cold days arrive',
  [routes.thanksgivingPlan]: 'Know when to thaw and cook the turkey',
  [routes.holidayGifts]: 'Keep gifts and spending in one place',
  [routes.laundrySystem]: 'Make laundry a shared family job',
  [routes.closetReset]: 'Start with one shelf, not the whole closet',
  [routes.paperBlitz]: 'Clear that paper pile in 15 minutes',
  [routes.springCleaning]: 'Reset one room at a time',
  [routes.fallCleaning]: 'Get the house ready for colder days',
  [routes.newYearDeclutter]: 'Make progress one small area at a time',
};
const seasonalTools = [
  { months: [8, 9, 10], paths: [routes.fallCleaning, routes.thanksgivingPlan, routes.holidayGifts] },
  { months: [11], paths: [routes.decemberCountdown, routes.holidayGifts, routes.gratitudeTracker] },
  { months: [0, 1], paths: [routes.newYearDeclutter, routes.mentalLoad, routes.laundrySystem] },
  { months: [2, 3, 4], paths: [routes.springCleaning, routes.closetReset, routes.mentalLoad] },
  { months: [5, 6, 7], paths: [routes.travelChecklist, routes.lunchSnackStation, routes.tryCalendar] },
];
const site = Astro.site!;
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Free family tools', url: new URL(routes.freeTools, site).href, hasPart: freeTools.map(tool => ({ '@type': 'WebPage', name: tool.name, url: new URL(tool.href, site).href })) }];
---
<PublicLayout title="Free Family Tools: Planners, Charts & Checklists" description="Free family planners, chore charts, routine generators and home checklists. Customize the tools online, then download or use the checklist on screen." jsonLd={jsonLd} width="full">
  <div class="tools-page">
    <header class="tools-intro">
      <p class="tools-intro-eyebrow">FREE TOOLS &amp; RESOURCES</p>
      <h1>A little help for the everyday.</h1>
      <p>Simple tools to make family life easier—and get everyone helping.</p>
      {toolEmailGateEnabled && <p class="tools-access">The chore chart asks for your email on your first download. No account needed.</p>}
    </header>
    <section class="tools-seasonal" data-seasonal-tools aria-labelledby="tools-seasonal-heading" hidden>
      <div class="tools-seasonal-head"><h2 id="tools-seasonal-heading" class="tools-section-title">Helpful this season</h2></div>
      <div class="tools-seasonal-links">
        {seasonalTools.flatMap(group => group.months.map(month => ({month, paths:group.paths}))).map(({month,paths}) => (
          <div data-seasonal-month={month} hidden>
            {paths.map(path => {
              const tool = freeTools.find(item => item.href === path)!;
              return <a href={path} class="tools-season-button"><svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c-4 3-7 6-7 11a7 7 0 0 0 14 0c0-5-3-8-7-11Z"/><path d="M12 9v10m-4-5 4 3 4-3"/></svg><strong>{tool.name}</strong></a>;
            })}
          </div>
        ))}
      </div>
    </section>
    <section class="tools-library" aria-labelledby="tools-library-heading">
      <h2 id="tools-library-heading" class="tools-section-title">Explore all free tools</h2>
      <p class="tools-section-subtitle">Find practical help for the kids, meals and home.</p>
      <div class="tools-library-controls">
        <label class="tools-search-label" for="tools-search">Search free tools</label>
        <input id="tools-search" type="search" placeholder="Search tools" autocomplete="off" />
        <nav class="tools-filter-nav" aria-label="Filter free tools">
          <button type="button" data-tools-filter="popular" aria-pressed="true">Popular</button><button type="button" data-tools-filter="all" aria-pressed="false">All tools</button>
          <button type="button" data-tools-filter="everyone" aria-pressed="false">Kids &amp; routines</button>
          <button type="button" data-tools-filter="planning" aria-pressed="false">Meals &amp; planning</button>
          <button type="button" data-tools-filter="home" aria-pressed="false">Home</button>
        </nav>
      </div>
      <p class="tools-empty" data-tools-empty hidden>No tools match that search. Try another word or category.</p>
    </section>
    {groups.map(group => (
      <section id={group.id} data-tools-group={group.id} class="tools-group" aria-labelledby={`${group.id}-title`}>
        <h2 id={`${group.id}-title`} class="tools-section-title">{group.title}</h2>
        <p class="tools-group-intro">{group.intro}</p>
        <div class="tools-list">
          {group.paths.map(path => freeTools.find(tool => tool.href === path)!).map(tool => (
            <a href={tool.href} class="tools-list-item" data-tool-popular={popularPaths.includes(tool.href) ? 'true' : 'false'} data-tool-search={`${benefits[tool.href] || tool.name} ${tool.name} ${tool.summary}`.toLowerCase()}>
              <span><h3>{benefits[tool.href] || tool.name}</h3><p>{tool.summary}</p><small class="tools-original-name">{tool.name}</small></span><span class="tools-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    ))}
    <aside class="tools-calendar" aria-labelledby="tools-calendar-title">
      <img {...imageAttrs('hc-01-wall-calendar')} alt="The Organized Mom Collective family wall calendar hanging on a wall." loading="lazy" decoding="async" />
      <div><h2 id="tools-calendar-title">Put the whole week where everyone can see it.</h2><p>Family plans, meals, groceries and to-dos on one weekly wall calendar.</p><a href={routes.calendar} class="tools-action" data-cta="tools-calendar">See the family wall calendar →</a></div>
    </aside>
  </div>
</PublicLayout>
<script>
  import { toolEvent } from '../lib/tool-engagement';
  document.querySelectorAll<HTMLAnchorElement>('.tools-page a[href^="/"]').forEach(link => {
    link.addEventListener('click', () => {
      const target = link.getAttribute('href') || '';
      if (target.startsWith('/#') || target.startsWith('#')) return;
      toolEvent('tool_related_click', target.replace(/^\//, '').split(/[?#]/)[0] || 'home', 'tools-directory');
    });
  });
  const search = document.querySelector<HTMLInputElement>('#tools-search');
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tools-filter]'));
  const toolGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-tools-group]'));
  const empty = document.querySelector<HTMLElement>('[data-tools-empty]');
  let activeFilter = 'popular';
  function filterTools() {
    const query = search?.value.trim().toLocaleLowerCase() || '';
    let visibleTotal = 0;
    for (const group of toolGroups) {
      const groupMatches = activeFilter === 'all' || activeFilter === 'popular' || activeFilter === group.dataset.toolsGroup;
      let groupVisible = 0;
      group.querySelectorAll<HTMLElement>('[data-tool-search]').forEach(item => {
        const found = groupMatches && (activeFilter !== 'popular' || item.dataset.toolPopular === 'true' || Boolean(query)) && (item.dataset.toolSearch || '').includes(query);
        item.hidden = !found;
        if (found) groupVisible++;
      });
      group.hidden = groupVisible === 0;
      visibleTotal += groupVisible;
    }
    if (empty) empty.hidden = visibleTotal > 0;
    filterButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.toolsFilter === activeFilter)));
  }
  filterTools();
  search?.addEventListener('input',filterTools);
  filterButtons.forEach(button => button.addEventListener('click', () => {
    activeFilter = button.dataset.toolsFilter || 'all';
    filterTools();
  }));
  // Browser date keeps seasonal suggestions current without relying on build/deploy timing.
  const seasonal = document.querySelector<HTMLElement>('[data-seasonal-tools]');
  const month = new Date().getMonth();
  const matching = seasonal?.querySelector<HTMLElement>(`[data-seasonal-month="${month}"]`);
  if (seasonal && matching) {
    matching.hidden = false;
    seasonal.hidden = false;
  }
</script>
<style>
.tools-page { max-width: 1120px; margin: 0 auto; padding: 40px 20px 64px; color: var(--color-warm-ink); }
.tools-intro { margin: -40px -20px 34px; padding: 48px 28px 38px; background: var(--color-ivory); color: var(--color-warm-ink); border-bottom: 1px solid var(--color-warm-rule); }
.tools-intro h1 { font-family: var(--font-serif); font-size: clamp(2rem, 4.2vw, 3.4rem); line-height: 1.1; letter-spacing: -.025em; max-width: 900px; }
.tools-intro > p { font-size: 1rem; line-height: 1.65; margin-top: 14px; max-width: 660px; }
.tools-intro .tools-access { font-size: .85rem; color: var(--color-warm-soft); }
.tools-choose-label { font-size: .85rem !important; margin-top: 24px !important; font-weight: 600; }
.tools-paths { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:12px; }
.tools-paths a { color:#453F3C; background:#F6EEE8; border-radius:10px; padding:16px; min-height:110px; display:flex; flex-direction:column; gap:5px; text-decoration:none; }
.tools-paths a:nth-child(2) { background:#E6EEE8; }
.tools-paths a:nth-child(3) { background:#F7EBD9; }
.tools-paths a > span { font-size:1.5rem; line-height:1; }
.tools-paths strong { font-family:var(--font-serif); font-size:1.05rem; }
.tools-paths small { font-size:.75rem; }
.tools-eyebrow { font-size:.65rem !important; font-weight:700; letter-spacing:.1em; color:var(--color-warm-soft); }
.tools-feature-copy .tools-eyebrow { margin-top:14px; }
.tools-seasonal { margin:24px 0 34px; padding:0; }
.tools-seasonal-head { margin-bottom:14px; }
.tools-seasonal-links > div:not([hidden]) { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.tools-seasonal-links a { display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; gap:8px; min-height:104px; padding:18px; border-radius:14px; background:#F2E5D9; color:#76634E; text-decoration:none; transition:transform .15s ease,filter .15s ease; }
.tools-seasonal-links a:nth-child(2) { background:#F5E4E5; }
.tools-seasonal-links a:nth-child(3) { background:#E5EEE7; }
.tools-seasonal-links a:hover { transform:translateY(-2px); filter:brightness(.98); }
.tools-seasonal-links a:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
.tools-seasonal-links strong { font-family:var(--font-sans); font-size:1rem; font-weight:600; color:#302C29; }
.tools-seasonal-links span,.tools-original-name { font-size:.75rem; color:var(--color-warm-soft); }
.tools-original-name { display:block; margin-top:8px; }
.tools-jumps { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 20px; }
.tools-jumps a { display: inline-flex; gap: 4px; align-items: center; min-height: 44px; font-size: .85rem; text-decoration: underline; text-underline-offset: 5px; }
.tools-section-title { font-family: var(--font-serif); font-size: clamp(1.55rem, 3vw, 2rem); line-height: 1.2; }
.tools-featured { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin-top: 20px; }
.tools-feature { min-width: 0; display:flex; flex-direction:column; border:1px solid var(--color-warm-rule); border-radius:12px; overflow:hidden; background:#fff; }
.tools-preview { display: flex; align-items: center; justify-content: center; height: 210px; overflow: hidden; background: #f3eee8; border-radius: 4px; }
.tools-preview img { width: 100%; height: 100%; object-fit: contain; }
.tools-feature-copy { padding:0 16px 16px; display:flex; flex-direction:column; flex:1; }\n.tools-feature h3 { font-family: var(--font-serif); font-size: 1.35rem; margin-top: 16px; line-height: 1.2; }
.tools-feature p { font-size: .9rem; line-height: 1.55; margin-top: 8px; }
.tools-feature-copy .tools-action { display:flex; justify-content:center; align-items:center; background:var(--color-warm-button); color:white; border-radius:7px; padding:10px 14px; margin-top:auto; text-decoration:none; text-align:center; }\n.tools-action { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: .88rem; font-weight: 600; text-decoration: underline; text-underline-offset: 5px; }
.tools-example-link { display: block; width: fit-content; min-height: 44px; padding: 10px 0; font-size: .8rem; color: var(--color-warm-soft); text-decoration: underline; text-underline-offset: 4px; }
.tools-planner-example { width: 90%; max-width: 300px; padding: 15px; background: white; border: 1px solid #d8d0c9; font-family: var(--font-serif); }
.tools-example-title { display: block; font-size: 22px; margin-bottom: 10px; }
.tools-example-days { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); font-size: 10px; }
.tools-example-days > span { border: 1px solid #d8d0c9; padding: 4px; background: #e6eeea; }
.tools-example-days i { display: block; height: 35px; margin-top: 4px; background: #fff; }
.tools-example-list { display: grid; grid-template-columns: 1.3fr 1fr; gap: 8px; font-size: 12px; margin-top: 10px; }
.tools-example-list b { font-size: 10px; font-weight: 400; }
.tools-planner-example small { display: block; margin-top: 8px; color: #6a5e57; font-size: 9px; }
.tools-group { scroll-margin-top: 24px; margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--color-warm-rule); }
.tools-group-intro { font-size: .9rem; margin-top: 8px; color: var(--color-warm-soft); }
.tools-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 32px; margin-top: 16px; }
.tools-list-item[hidden], .tools-group[hidden], .tools-empty[hidden] { display:none !important; }\n.tools-list-item { display: flex; align-items: center; justify-content: space-between; gap: 14px; min-width: 0; padding: 16px 0; border-bottom: 1px solid var(--color-warm-rule); }
.tools-list-item h3 { font-family: var(--font-serif); font-size: 1.13rem; line-height: 1.25; }
.tools-list-item p { font-size: .86rem; line-height: 1.5; margin-top: 5px; color: var(--color-warm-soft); }
.tools-arrow { flex: none; font-size: 22px; }
.tools-list-item:hover h3, .tools-feature h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
.tools-intro a:focus-visible { outline: 2px solid var(--color-warm-ink); outline-offset: 5px; }
.tools-page a:focus-visible { outline: 2px solid var(--color-warm-ink); outline-offset: 5px; }
.tools-calendar { display: grid; grid-template-columns: 170px minmax(0,1fr); gap: 28px; align-items: center; border-top: 1px solid var(--color-warm-rule); margin-top: 44px; padding-top: 28px; }
.tools-calendar img { width: 100%; height: 170px; object-fit: contain; }
.tools-calendar h2 { font-family: var(--font-serif); font-size: 1.65rem; line-height: 1.2; }
.tools-calendar p { font-size: .9rem; line-height: 1.5; margin-top: 10px; }

.tools-intro-eyebrow { letter-spacing:.13em; text-transform:uppercase; font-weight:700; font-size:.72rem !important; margin:0 0 14px !important; }
.tools-section-subtitle { margin-top:8px; font-size:.91rem; color:var(--color-warm-soft); line-height:1.45; }
.tools-library { padding-top:28px; border-top:1px solid var(--color-warm-rule); margin-top:38px; }
.tools-library-controls { margin-top:20px; }
.tools-search-label { display:block; font-size:.8rem; font-weight:600; margin-bottom:7px; }
.tools-library input[type="search"] { display:block; width:100%; max-width:440px; min-height:48px; border:1px solid var(--color-warm-rule); border-radius:10px; background:white; padding:10px 14px; font-size:1rem; color:var(--color-warm-ink); }
.tools-filter-nav { display:flex; gap:8px; flex-wrap:wrap; margin-top:14px; }
.tools-filter-nav button { border:1px solid var(--color-warm-rule); background:#f7f3ee; color:var(--color-warm-ink); padding:9px 14px; min-height:44px; border-radius:999px; cursor:pointer; }
.tools-filter-nav button[aria-pressed="true"] { background:var(--color-warm-button); color:white; border-color:var(--color-warm-button); }
.tools-empty { padding:24px 0; color:var(--color-warm-soft); }
@media (max-width: 767px) {
 .tools-page { padding-top: 28px; }
 .tools-intro { margin-top: -28px; padding: 28px 20px 24px; }
 .tools-paths { grid-template-columns:1fr; gap:8px; }
 .tools-paths a { display:grid; grid-template-columns:32px minmax(0,1fr); align-items:center; column-gap:10px; }
 .tools-paths a > span { grid-row:span 2; }
 .tools-paths a small { grid-column:2; }
 .tools-paths a { min-height:0; padding:12px 14px; }
 .tools-seasonal-links > div:not([hidden]) { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
 .tools-seasonal-links a { min-height:100px; padding:12px 8px; }
 .tools-seasonal-links strong { font-size:.88rem; }
 .tools-featured { grid-template-columns: 1fr; gap: 20px; }
 .tools-feature { display: grid; grid-template-columns: 110px minmax(0,1fr); align-items:stretch; gap: 0; padding:0; border:1px solid var(--color-warm-rule); border-radius:12px; }\n .tools-feature-copy { padding:12px; min-width:0; }\n .tools-feature-copy .tools-action { margin-top:12px; font-size:.79rem; }
 .tools-preview { height:100%; min-height:174px; border-radius:0; }
 .tools-feature h3 { margin-top: 0; font-size: 1.2rem; }
 .tools-feature p { font-size: .85rem; }
 .tools-example-link { padding-top: 0; min-height: 44px; }
 .tools-planner-example { padding: 6px; width: 95%; }
 .tools-example-title { font-size: 14px; }
 .tools-example-days { font-size: 6px; }
 .tools-example-days > span { padding: 1px; }
 .tools-example-list { grid-template-columns: 1fr; font-size: 9px; }
 .tools-example-list b { font-size: 8px; }
 .tools-list { grid-template-columns: 1fr; }
 .tools-group { margin-top: 30px; padding-top: 22px; }
 .tools-calendar { grid-template-columns: 95px minmax(0,1fr); gap: 16px; }
 .tools-calendar img { height: 140px; }
 .tools-calendar h2 { font-size: 1.35rem; }
}
@media (max-width: 360px) { .tools-feature { grid-template-columns: 90px minmax(0,1fr); gap: 12px; } }
</style>

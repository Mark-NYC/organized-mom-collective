---
import PublicLayout from '../layouts/PublicLayout.astro';
import ToolResource from '../components/site/ToolResource.astro';
import { routes } from '../routes';
import { freeTools } from '../data/free-tools';
import { directoryTools, popularPaths, seasonalSelections } from '../data/tools-directory';
import { imageAttrs } from '../data/images';
import { toolEmailGateEnabled } from '../lib/tool-email';
import { monthColor } from '../theme';

const initialMonth = new Date().getMonth();
const paths = [...popularPaths, ...freeTools.map(tool => tool.href).filter(path => !popularPaths.includes(path))];
for (const tool of freeTools) {
  if (!directoryTools[tool.href]) throw new Error(`Missing directory presentation: ${tool.href}`);
}
const filters = [
  ['popular', 'Popular'], ['all', 'All tools'], ['everyone', 'Kids & routines'], ['planning', 'Meals & planning'], ['home', 'Home'],
];
const jsonLd = [{ '@context':'https://schema.org', '@type':'CollectionPage', name:'Free family planners, charts & checklists', url:new URL(routes.freeTools, Astro.site!).href, hasPart:freeTools.map(tool => ({ '@type':'WebPage', name:tool.name, url:new URL(tool.href, Astro.site!).href })) }];
---
<PublicLayout title="Free Family Planners, Charts & Checklists" description="Free planners, chore charts and family checklists. See the sheets, choose what you need, and make a plan your family can use." jsonLd={jsonLd} width="full">
  <div class="resource-directory" style={{ '--resource-accent':monthColor(initialMonth) }} data-resource-directory>
    <header class="directory-intro">
      <h1>Free planners, charts<br class="desktop-break" /> &amp; checklists.</h1>
      <p>Make a plan your family can see and use.</p>
    </header>

    <section class="directory-seasonal" aria-labelledby="seasonal-heading" data-seasonal-section>
      <div class="directory-section-heading"><span aria-hidden="true"></span><h2 id="seasonal-heading">Helpful this season</h2><span aria-hidden="true"></span></div>
      {seasonalSelections.map(selection => (
        <div class="seasonal-selection" data-seasonal-months={selection.months.join(',')} hidden={!selection.months.includes(initialMonth)}>
          {selection.paths.map((href,index) => <ToolResource href={href} resource={directoryTools[href]} seasonal priority={index===0} />)}
        </div>
      ))}
    </section>

    <section class="directory-library" aria-labelledby="library-heading">
      <h2 id="library-heading" class="sr-only">Browse free resources</h2>
      <div class="directory-controls">
        <nav class="directory-filters" aria-label="Filter resources">
          {filters.map(([value,label]) => <button type="button" data-resource-filter={value} aria-pressed={value==='popular'?'true':'false'}>{label}</button>)}
        </nav>
        <div class="directory-search">
          <label for="resource-search" class="sr-only">Search free resources</label>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
          <input id="resource-search" type="search" placeholder="Find a resource" autocomplete="off" />
        </div>
      </div>
      <p class="sr-only" data-resource-count role="status" aria-live="polite">6 resources shown.</p>
      <div class="directory-grid" id="resource-grid">
        {paths.map(href => <ToolResource href={href} resource={directoryTools[href]} popular={popularPaths.includes(href)} />)}
      </div>
      <div class="directory-empty" data-resource-empty hidden>
        <h3>Nothing here yet for that search.</h3><p>Try a different word, or browse all the resources.</p>
        <button type="button" data-resource-reset>Show all resources</button>
      </div>
      <noscript><style>.resource-directory [data-resource-item][hidden] { display:flex !important; } .directory-controls { display:none; }</style><p>All resources are shown below when JavaScript is off.</p></noscript>
    </section>

    <aside class="directory-calendar" aria-labelledby="calendar-heading">
      <img {...imageAttrs('hc-01-wall-calendar')} sizes="(min-width:768px) 320px, 80vw" alt="The Organized Mom Collective weekly family wall calendar with sections for plans, meals and groceries." loading="lazy" decoding="async" />
      <div>
        <h2 id="calendar-heading">Give the whole family<br /> one place to check.</h2>
        <p>A weekly wall calendar for family plans, meals, groceries and shared jobs, with the cleaning companion website included.</p>
        <a href={routes.calendar} class="directory-calendar-action" data-cta="tools-calendar">See the family wall calendar</a>
      </div>
    </aside>
    {toolEmailGateEnabled && <p class="directory-access">The chore chart asks for your email on the first download. No account needed.</p>}
  </div>
</PublicLayout>

<script>
  import { monthColor } from '../theme';
  import { toolEvent } from '../lib/tool-engagement';
  const root = document.querySelector<HTMLElement>('[data-resource-directory]');
  if (root) {
    const search = root.querySelector<HTMLInputElement>('#resource-search');
    const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-resource-filter]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-resource-item]'));
    const empty = root.querySelector<HTMLElement>('[data-resource-empty]');
    const count = root.querySelector<HTMLElement>('[data-resource-count]');
    let active = 'popular';
    function renderResources() {
      const query = search?.value.trim().toLocaleLowerCase() || '';
      let total = 0;
      for (const item of items) {
        const categoryMatches = active === 'all' || active === 'popular' || item.dataset.resourceCategory === active;
        const popularMatches = active !== 'popular' || Boolean(query) || item.dataset.resourcePopular === 'true';
        item.hidden = !(categoryMatches && popularMatches && (item.dataset.resourceSearch || '').includes(query));
        if (!item.hidden) total++;
      }
      filters.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.resourceFilter === active)));
      if (empty) empty.hidden = total > 0;
      if (count) count.textContent = `${total} resource${total===1?'':'s'} shown.`;
    }
    filters.forEach(button => button.addEventListener('click', () => { active = button.dataset.resourceFilter || 'all'; renderResources(); }));
    search?.addEventListener('input',renderResources);
    root.querySelector('[data-resource-reset]')?.addEventListener('click', () => { if (search) search.value=''; active='all'; renderResources(); search?.focus(); });
    function syncSeason() {
      const month = new Date().getMonth();
      root?.style.setProperty('--resource-accent',monthColor(month));
      root?.querySelectorAll<HTMLElement>('[data-seasonal-months]').forEach(selection => { selection.hidden = !selection.dataset.seasonalMonths?.split(',').includes(String(month)); });
    }
    syncSeason(); renderResources();
    document.addEventListener('visibilitychange', () => { if (!document.hidden) syncSeason(); });
    root.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach(link => link.addEventListener('click', () => {
      const target = (link.getAttribute('href') || '').replace(/^\//,'').split(/[?#]/)[0];
      if (target) toolEvent('tool_related_click',target,'tools-directory');
    }));
  }
</script>

<style>
  .resource-directory { max-width:1100px; margin:0 auto; padding:0 28px 72px; font-family:var(--font-sans); color:#414641; background:#fff; }
  .directory-intro { text-align:center; max-width:760px; margin:0 auto; padding:54px 0 43px; }
  .directory-intro h1 { font-family:var(--font-sans); font-size:clamp(2rem,4.2vw,2.8rem); font-weight:700; line-height:1.17; letter-spacing:-.04em; margin:0; }
  .directory-intro p { margin:18px 0 0; font-size:1rem; line-height:1.65; color:#606660; }
  .directory-section-heading { display:flex; align-items:center; gap:24px; margin-bottom:24px; }
  .directory-section-heading > span { height:1px; flex:1; background:#d9dfd9; }
  .directory-section-heading h2 { font-family:var(--font-sans); font-size:1.25rem; font-weight:700; letter-spacing:-.025em; text-align:center; }
  .seasonal-selection { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:32px; }
  .seasonal-selection[hidden] { display:none !important; }
  .directory-library { padding-top:44px; }
  .directory-controls { display:flex; justify-content:space-between; align-items:center; gap:24px; padding:0 0 16px; border-bottom:1px solid #d9dfd9; }
  .directory-filters { display:flex; flex-wrap:wrap; align-items:center; gap:0 21px; }
  .directory-filters button { position:relative; appearance:none; border:0; border-radius:0; padding:13px 0; min-height:46px; background:none; color:#626862; font-family:inherit; font-size:.8rem; font-weight:500; line-height:1.4; cursor:pointer; }
  .directory-filters button[aria-pressed="true"] { color:#343a34; font-weight:700; }
  .directory-filters button[aria-pressed="true"]::after { content:''; position:absolute; left:0; right:0; bottom:3px; height:3px; background:var(--resource-accent); }
  .directory-filters button:hover { color:#343a34; }
  .directory-filters button:focus-visible, .directory-empty button:focus-visible, .directory-calendar-action:focus-visible { outline:2px solid #414641; outline-offset:4px; }
  .directory-search { position:relative; width:220px; flex:none; color:#626862; }
  .directory-search svg { position:absolute; left:12px; top:50%; transform:translateY(-50%); pointer-events:none; }
  .directory-search input { box-sizing:border-box; width:100%; min-height:46px; padding:10px 12px 10px 38px; border:1px solid #cfd5cf; border-radius:0; background:white; font-family:inherit; font-size:.8rem; color:#414641; }
  .directory-search input:focus-visible { outline:2px solid #414641; outline-offset:2px; }
  .directory-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); column-gap:32px; row-gap:48px; margin-top:28px; }
  .directory-empty { text-align:center; padding:56px 20px; }
  .directory-empty[hidden] { display:none; }
  .directory-empty h3 { font-family:inherit; font-size:1.1rem; font-weight:700; }
  .directory-empty p { margin-top:10px; font-size:.9rem; color:#606660; }
  .directory-empty button { display:inline-block; min-height:44px; background:none; border:0; text-decoration:underline; text-underline-offset:5px; font:inherit; font-size:.85rem; margin-top:12px; cursor:pointer; }
  .directory-calendar { display:grid; grid-template-columns:320px minmax(0,1fr); align-items:center; gap:58px; margin-top:64px; border-top:1px solid #d9dfd9; padding:48px 36px 0; }
  .directory-calendar img { display:block; width:100%; height:280px; object-fit:contain; }
  .directory-calendar h2 { font-family:var(--font-sans); font-size:clamp(1.45rem,2.6vw,1.9rem); font-weight:700; line-height:1.27; letter-spacing:-.035em; }
  .directory-calendar p { margin-top:18px; font-size:.9rem; line-height:1.8; color:#606660; max-width:440px; }
  .directory-calendar-action { display:inline-flex; align-items:center; justify-content:center; margin-top:24px; padding:13px 19px; min-height:46px; background:var(--resource-accent); color:#343a34; font-size:.8rem; font-weight:600; text-decoration:none; border-radius:0; }
  .directory-calendar-action:hover { text-decoration:underline; text-underline-offset:4px; }
  .directory-access { margin:44px auto 0; max-width:650px; text-align:center; font-size:.75rem; line-height:1.7; color:#606660; }
  @media (min-width:640px) and (max-width:959px) {
    .directory-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .directory-controls { flex-wrap:wrap; }
    .directory-filters { flex:1 1 100%; justify-content:center; }
    .directory-search { width:100%; max-width:400px; margin:auto; }
    .directory-calendar { grid-template-columns:240px minmax(0,1fr); padding-inline:0; gap:32px; }
  }
  @media (max-width:639px) {
    .resource-directory { padding:0 22px 48px; }
    .directory-intro { padding:36px 0 32px; }
    .directory-intro h1 { font-size:2rem; }
    .desktop-break { display:none; }
    .directory-intro p { font-size:.9rem; margin-top:16px; }
    .directory-section-heading { gap:14px; margin-bottom:22px; }
    .directory-section-heading h2 { font-size:1.05rem; }
    .seasonal-selection { grid-template-columns:1fr; gap:18px; }
    .directory-library { padding-top:32px; }
    .directory-controls { flex-direction:column-reverse; align-items:stretch; gap:16px; padding-bottom:10px; }
    .directory-search { width:100%; }
    .directory-filters { gap:0 17px; }
    .directory-filters button { font-size:.72rem; }
    .directory-grid { grid-template-columns:1fr; margin-top:26px; row-gap:38px; }
    .directory-calendar { grid-template-columns:1fr; gap:22px; padding:34px 0 0; margin-top:48px; text-align:center; }
    .directory-calendar img { width:240px; height:230px; margin:auto; }
    .directory-calendar h2 { font-size:1.5rem; }
    .directory-calendar p { margin:16px auto 0; }
  }
</style>

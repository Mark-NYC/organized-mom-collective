---
/**
 * /mental-load-worksheet — a free one-page mental load worksheet, the companion to IF-02 (how-to-share-the-mental-load):
 * a brain dump, a four-way sort (hand it over, write it down once, let it go, only me), one whole job handed over with
 * what goes with it, the finish line, where the reminders move and a check-in two weeks out, then the check-in itself.
 * Job chips fill the handoff with the article's examples. Rebuilt from the old Mental Load Management Tool (three tabs,
 * 1–10 self-ratings, goal and reflection prompts, nothing saved). Follows docs/brand/TOOL-OUTPUT-DESIGN.md: Kalam
 * headings, highlighter swipes, three palettes from src/data/tool-palettes.ts saved with the sheet. Downloads as a PNG
 * (US Letter portrait). Autosave and export: src/lib/printable.ts (`omc:mental-load:v1`). Classes prefixed `ml-`.
 */
import '@fontsource/kalam/latin-700.css';
import PublicLayout from '../layouts/PublicLayout.astro';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';
import { toolPalettes, defaultToolPalette } from '../data/tool-palettes';

const sorts = [
  { id: 'hand', title: 'Hand it over', hint: 'A whole job someone else can own', accent: 1 },
  { id: 'write', title: 'Write it down once', hint: 'On the calendar, where everyone sees it', accent: 2 },
  { id: 'drop', title: 'Let it go', hint: 'Nobody will miss it', accent: 3 },
  { id: 'mine', title: 'Only me', hint: 'Keep it, on purpose', accent: 0 },
];
const jobs: Record<string, string> = {
  'School lunches': 'Check supplies, add missing food to the list, pack, bags out the door, wash the containers',
  Laundry: 'Notice the pile, wash, dry, fold, put away',
  'School-paper pocket': 'Check forms, note deadlines on the calendar, sign and return them',
  'Trash & recycling': 'Know pickup day, gather the bins, take them out, bring them back',
  'Pet care': 'Food stocked, feed, water, walks, vet dates on the calendar',
};

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Mental Load Worksheet', item: new URL(routes.mentalLoad, site).href },
    ],
  },
];
---

<PublicLayout
  title="Free Mental Load Worksheet: Brain Dump, Sort, Hand It Over"
  description="A free printable mental load worksheet: get everything out of your head, sort it, and hand one whole job to someone else, including the remembering. With a two-week check-in."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="ml-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free mental load worksheet</p>
      <h1 id="ml-h" class="serif-hero mt-3">Get It Out of Your Head. Then Hand Some of It Over.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        Write down everything you’re keeping track of. Sort it. Then hand one whole job to someone else, the remembering included, and
        check in after two weeks.
        {' '}<a href={routes.article('how-to-share-the-mental-load')} class="text-link">How to hand over a whole job</a>
      </p>
    </div>
  </section>

  <div class="ml-container">
    <fieldset class="ml-palette-picker">
      <legend>Choose your colors</legend>
      <div class="ml-palette-options">
        {
          Object.entries(toolPalettes).map(([id, palette]) => (
            <button type="button" class="ml-palette-option" data-ml-palette={id} aria-pressed={id === defaultToolPalette}>
              <span class="ml-swatches" aria-hidden="true">
                {palette.colors.map((color) => (
                  <span style={{ backgroundColor: color }} />
                ))}
              </span>
              <span>{palette.label}</span>
            </button>
          ))
        }
      </div>
    </fieldset>

    <div class="ml-jobs">
      <span class="ml-jobs-label">Jobs that hand over well</span>
      {
        Object.entries(jobs).map(([job, parts]) => (
          <button type="button" class="ml-chip" data-ml-job={job} data-ml-parts={parts}>
            {job}
          </button>
        ))
      }
    </div>

    <div class="ml-actions">
      <button type="button" class="ml-btn ml-btn-primary" data-ml-download>Download PNG</button>
      <button type="button" class="ml-btn" data-ml-clear>Clear</button>
    </div>

    <div class="ml-sheet" id="mental-load-worksheet">
      <input type="hidden" data-field="palette" value={defaultToolPalette} />
      <div class="ml-head">
        <div class="ml-title">Get It Out of Your Head</div>
        <div class="ml-kicker">Mental load worksheet</div>
      </div>

      <section class="ml-block">
        <h2 class="ml-h ml-swipe-1">1. Brain dump</h2>
        <p class="ml-hint">Everything you’re keeping track of: appointments, forms, birthdays, what’s running low, who needs what.</p>
        <div class="ml-dumps">
          <textarea class="ml-lined ml-dump" data-field="dump" aria-label="Brain dump"></textarea>
          <textarea class="ml-lined ml-dump" data-field="dump-2" aria-label="Brain dump, continued"></textarea>
        </div>
      </section>

      <section class="ml-block">
        <h2 class="ml-h ml-swipe-2">2. Sort it</h2>
        <div class="ml-sorts">
          {
            sorts.map((s) => (
              <div class={`ml-sort ml-accent-${s.accent}`}>
                <div class="ml-sort-title">{s.title}</div>
                <div class="ml-sort-hint">{s.hint}</div>
                {[0, 1, 2].map((i) => (
                  <input type="text" data-field={`${s.id}-${i}`} aria-label={`${s.title} ${i + 1}`} />
                ))}
              </div>
            ))
          }
        </div>
      </section>

      <section class="ml-block">
        <h2 class="ml-h ml-swipe-3">3. Hand over one whole job</h2>
        <div class="ml-handoff">
          <label class="ml-line"><span>The job</span><input type="text" data-field="job" data-ml-job-field placeholder="School lunches" /></label>
          <label class="ml-line"><span>New owner</span><input type="text" data-field="owner" placeholder="Dad" /></label>
          <label class="ml-line ml-wide"><span>What goes with it</span><textarea rows="2" data-field="parts" data-ml-parts-field></textarea></label>
          <label class="ml-line ml-wide"><span>Done means</span><input type="text" data-field="done" placeholder="Lunches packed and in the bags by 7:30" /></label>
          <label class="ml-line"><span>Reminders move to</span><input type="text" data-field="reminders" placeholder="His phone + the calendar" /></label>
          <label class="ml-line"><span>Check in on</span><input type="date" data-field="checkin" data-ml-checkin /></label>
        </div>
      </section>

      <section class="ml-block ml-check">
        <h2 class="ml-h ml-swipe-1">4. Two weeks later</h2>
        <div class="ml-handoff">
          <label class="ml-line"><span>What got missed</span><input type="text" data-field="missed" /></label>
          <label class="ml-line"><span>What we’ll change</span><input type="text" data-field="change" /></label>
          <label class="ml-line ml-wide"><span>Next job to hand over</span><input type="text" data-field="next" /></label>
        </div>
      </section>

      <div class="ml-foot">{BRAND_NAME}</div>
    </div>

    <p class="ml-footnote">
      Keep shared dates and papers in <a href={routes.article('home-command-center')} class="text-link">one household spot</a>. For the kids,
      {' '}the free <a href={routes.choreChart} class="text-link">Chore Chart by Age</a>. The
      {' '}<a href={routes.calendar} data-cta="mental-load-worksheet" class="text-link">Family Wall Calendar</a> has room to write the owner
      {' '}beside every task.
    </p>
  </div>
</PublicLayout>

<style is:global>
  .ml-container {
    --ml-ink: #4d4544;
    --ml-soft: #8a7f7b;
    --ml-rule: #e6ddd8;
    background: var(--color-ivory);
    padding: 28px 20px 56px;
    color: var(--ml-ink);
  }
  .ml-container *,
  .ml-container *::before,
  .ml-container *::after {
    box-sizing: border-box;
  }
  .ml-palette-picker {
    max-width: 816px;
    margin: 0 auto 16px;
    padding: 0;
    border: 0;
    text-align: center;
  }
  .ml-palette-picker legend {
    float: none;
    width: 100%;
    margin-bottom: 10px;
    font-size: 0.85rem;
    color: var(--ml-soft);
  }
  .ml-palette-options {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ml-palette-option {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 10px 14px;
    border: 1px solid var(--ml-rule);
    border-radius: 10px;
    background: #fff;
    color: var(--ml-ink);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .ml-palette-option[aria-pressed='true'] {
    padding: 9px 13px;
    border: 2px solid var(--ml-ink);
    background: var(--color-ivory);
  }
  .ml-palette-option:focus-visible,
  .ml-chip:focus-visible,
  .ml-btn:focus-visible {
    outline: 2px solid var(--ml-ink);
    outline-offset: 3px;
  }
  .ml-swatches {
    display: flex;
    gap: 3px;
  }
  .ml-swatches span {
    width: 15px;
    height: 15px;
    border: 1px solid #b8ada6;
    border-radius: 50%;
  }
  .ml-jobs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    max-width: 816px;
    margin: 0 auto 16px;
  }
  .ml-jobs-label {
    margin-right: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ml-soft);
  }
  .ml-chip {
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--ml-rule);
    border-radius: 999px;
    background: #fff;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--ml-ink);
    cursor: pointer;
  }
  .ml-chip:hover {
    border-color: var(--ml-ink);
  }
  .ml-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 0 auto 20px;
  }
  .ml-btn {
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid var(--color-warm-button);
    border-radius: 3px;
    background: #fff;
    color: var(--color-warm-button);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .ml-btn-primary {
    background: var(--color-warm-button);
    color: #fff;
  }
  .ml-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  /* The sheet: US Letter portrait (8.5 × 11 in at 96 px/in). Accents come from the chosen palette. */
  .ml-sheet {
    --ml-accent-1: #efebe7;
    --ml-accent-2: #e6eeea;
    --ml-accent-3: #f6f1e7;
    display: flex;
    flex-direction: column;
    width: 816px;
    max-width: 100%;
    min-height: 1056px;
    margin: 0 auto;
    padding: 30px 40px 18px;
    background: #fff;
    border: 1px solid var(--ml-rule);
    border-radius: 6px;
    box-shadow: 0 6px 24px rgba(77, 69, 68, 0.08);
    font-family: var(--font-sans);
    color: var(--ml-ink);
  }
  .ml-head {
    text-align: center;
  }
  .ml-title {
    font-family: 'Kalam', var(--font-serif);
    font-size: 40px;
    line-height: 1.1;
  }
  .ml-kicker {
    margin-top: 2px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ml-soft);
  }
  .ml-block {
    margin-top: 10px;
  }
  .ml-h {
    display: inline-block;
    padding: 0 6px;
    font-family: 'Kalam', var(--font-serif);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
  }
  .ml-swipe-1 {
    background: linear-gradient(transparent 30%, var(--ml-accent-1) 30%, var(--ml-accent-1) 88%, transparent 88%);
  }
  .ml-swipe-2 {
    background: linear-gradient(transparent 30%, var(--ml-accent-2) 30%, var(--ml-accent-2) 88%, transparent 88%);
  }
  .ml-swipe-3 {
    background: linear-gradient(transparent 30%, var(--ml-accent-3) 30%, var(--ml-accent-3) 88%, transparent 88%);
  }
  .ml-hint {
    margin: 2px 0 6px;
    font-family: var(--font-serif);
    font-size: 13px;
    font-style: italic;
    color: var(--ml-soft);
  }
  .ml-lined {
    display: block;
    width: 100%;
    padding: 0 12px;
    border: 2px solid var(--ml-accent-1);
    border-radius: 14px;
    resize: none;
    background-color: #fff;
    background-image: linear-gradient(transparent 25px, var(--ml-rule) 25px, var(--ml-rule) 26px);
    background-size: 100% 26px;
    background-position: 0 6px;
    background-attachment: local;
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 26px;
    color: var(--ml-ink);
  }
  .ml-dumps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .ml-dump {
    height: 146px;
    padding-top: 6px;
    overflow: hidden;
  }
  .ml-sorts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 6px;
  }
  .ml-sort {
    padding: 8px 14px 6px;
    border: 2px solid var(--ml-rule);
    border-radius: 14px;
  }
  .ml-accent-1 {
    border-color: var(--ml-accent-1);
  }
  .ml-accent-2 {
    border-color: var(--ml-accent-2);
  }
  .ml-accent-3 {
    border-color: var(--ml-accent-3);
  }
  .ml-sort-title {
    font-family: 'Kalam', var(--font-serif);
    font-size: 19px;
    line-height: 1.2;
  }
  .ml-sort-hint {
    font-family: var(--font-serif);
    font-size: 12px;
    font-style: italic;
    color: var(--ml-soft);
  }
  .ml-sort input,
  .ml-line input,
  .ml-line textarea {
    display: block;
    width: 100%;
    min-width: 0;
    border: none;
    border-bottom: 1px solid var(--ml-rule);
    background: transparent;
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ml-ink);
  }
  .ml-sort input {
    height: 27px;
  }
  .ml-handoff {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 20px;
    margin-top: 4px;
  }
  .ml-line {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ml-soft);
  }
  .ml-line > span {
    flex: none;
  }
  .ml-line input {
    height: 28px;
  }
  .ml-line textarea {
    resize: none;
    overflow: hidden;
    padding: 4px 0;
    line-height: 1.35;
  }
  .ml-wide {
    grid-column: 1 / -1;
  }
  .ml-container input::placeholder,
  .ml-container textarea::placeholder {
    color: #c4b8b2;
  }
  .ml-container input:focus,
  .ml-container textarea:focus {
    outline: none;
    background-color: #fdfaf8;
  }
  .ml-check {
    padding: 8px 14px 10px;
    border: 2px dashed var(--ml-accent-1);
    border-radius: 14px;
  }
  .ml-check .ml-h {
    margin-left: -6px;
  }
  .ml-foot {
    margin-top: auto;
    padding-top: 12px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
    color: #b3a7a1;
  }
  .ml-footnote {
    max-width: 816px;
    margin: 28px auto 0;
    text-align: center;
    font-size: 0.95rem;
    line-height: 2;
    color: var(--color-warm-soft);
  }

  /* Phones: one column. The PNG is always the Letter layout. */
  @media (max-width: 768px) {
    .ml-container:not(.ml-exporting) .ml-sheet {
      min-height: 0;
      padding: 20px 12px 12px;
    }
    .ml-container:not(.ml-exporting) .ml-title {
      font-size: 30px;
    }
    .ml-container:not(.ml-exporting) .ml-dumps,
    .ml-container:not(.ml-exporting) .ml-sorts,
    .ml-container:not(.ml-exporting) .ml-handoff {
      grid-template-columns: 1fr;
    }
    .ml-container:not(.ml-exporting) .ml-line {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
  }
</style>

<script>
  import { toolPalettes, resolveToolPalette } from '../data/tool-palettes';
  import { autosave, downloadPng, fieldsIn } from '../lib/printable';

  const sheet = document.getElementById('mental-load-worksheet')!;
  const host = sheet.closest<HTMLElement>('.ml-container')!;
  const field = (name: string) => sheet.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-field="${name}"]`)!;

  const paletteField = field('palette');
  const paletteButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-ml-palette]'));
  const renderPalette = () => {
    const id = resolveToolPalette(paletteField.value);
    paletteField.value = id;
    toolPalettes[id].colors.forEach((color, i) => sheet.style.setProperty(`--ml-accent-${i + 1}`, color));
    paletteButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mlPalette === id)));
  };

  const save = autosave(sheet, 'omc:mental-load:v1', renderPalette);
  for (const b of paletteButtons) {
    b.addEventListener('click', () => {
      paletteField.value = b.dataset.mlPalette!;
      renderPalette();
      save();
    });
  }

  // A handoff gets a check-in two weeks out, unless one is already set.
  const checkin = field('checkin') as HTMLInputElement;
  const setCheckin = () => {
    if (checkin.value || !field('job').value.trim()) return;
    const d = new Date();
    d.setDate(d.getDate() + 14);
    checkin.value = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  };
  field('job').addEventListener('change', () => {
    setCheckin();
    save();
  });

  for (const chip of document.querySelectorAll<HTMLButtonElement>('[data-ml-job]')) {
    chip.addEventListener('click', () => {
      const job = field('job');
      const parts = field('parts');
      if ((job.value.trim() || parts.value.trim()) && !confirm(`Replace the job on the sheet with ${chip.dataset.mlJob}?`)) return;
      job.value = chip.dataset.mlJob!;
      parts.value = chip.dataset.mlParts!;
      setCheckin();
      save();
      job.closest('.ml-block')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }

  document.querySelector('[data-ml-clear]')!.addEventListener('click', () => {
    if (!confirm('Clear the worksheet? Your colors stay.')) return;
    const palette = paletteField.value;
    for (const el of fieldsIn(sheet)) el.value = '';
    paletteField.value = palette;
    renderPalette();
    save();
  });

  const button = document.querySelector<HTMLButtonElement>('[data-ml-download]')!;
  button.addEventListener('click', async () => {
    // Placeholder hints would print as if they'd been filled in: drop them while capturing.
    const hinted = Array.from(sheet.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[placeholder]'));
    const hints = hinted.map((el) => el.placeholder);
    hinted.forEach((el) => el.removeAttribute('placeholder'));
    try {
      await downloadPng(sheet, { filename: 'mental-load-worksheet.png', width: 816, height: 1056, layoutHost: host, exportClass: 'ml-exporting', button });
    } finally {
      hinted.forEach((el, i) => (el.placeholder = hints[i]));
    }
  });
</script>

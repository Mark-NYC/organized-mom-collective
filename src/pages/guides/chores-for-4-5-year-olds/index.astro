---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import KidsChoresMiniGuide from '../../../components/guides/KidsChoresMiniGuide.astro';
import {findMiniGuide} from '../../../../scripts/lib/kids-chores-mini-guides.mjs';
const slug='chores-for-4-5-year-olds';
const guide=findMiniGuide(slug)!;
---
<PublicLayout title={guide.title+' | Free One-Page Printable'} description={guide.teaser} width="full" ogType="article">
<KidsChoresMiniGuide slug={slug}/>
<!-- Full-bleed responsive lifestyle photography, after the guide introduction.
     The image files must be uploaded to public/images/guides/ before this change is merged. -->
<section aria-label="Chores for 4–5-year-olds printable in a real home" class="w-full overflow-hidden">
  <picture>
    <source media="(min-width: 640px)" srcset="/images/guides/chores-for-4-5-year-olds-lifestyle-desktop.webp" />
    <img
      src="/images/guides/chores-for-4-5-year-olds-lifestyle-mobile.webp"
      alt="A printed chores chart for 4–5-year-olds on a wooden kitchen table"
      width="1024"
      height="1024"
      loading="lazy"
      decoding="async"
      class="block h-auto w-full"
    />
  </picture>
</section>
</PublicLayout>

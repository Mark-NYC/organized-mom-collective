---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import GuidePdfPreview from '../../../components/guides/GuidePdfPreview.astro';
import GuidePageGallery from '../../../components/guides/GuidePageGallery.astro';
import {habits,weekly,roles,issues} from '../../../../scripts/lib/living-room-guide-content.mjs';
const pdf='/downloads/family-living-room-reset.pdf';
const images=[1,2,3,4].map(n=>`/images/guides/living-room-guide-page-${n}.webp`);
const art=(name:string)=>`/assets/icons/ofc/guides/living-room/${name}.png`;
const setups=[
 {icon:'toys',title:'Toys and games',place:'One or two reachable baskets or shelves, grouped by what the kids actually use.',tip:'Do not buy a dozen bins. Keep fewer toys out at one time.'},
 {icon:'books',title:'Books and papers',place:'A reachable shelf for books and a separate family inbox for papers.',tip:'Adults check the inbox; do not expect kids to judge deadlines.'},
 {icon:'blanket',title:'Cushions and blankets',place:'A blanket basket by the sofa; cushions return to the seat.',tip:'Keep only the throws you use regularly in the shared room.'},
 {icon:'basket',title:'Odds and ends',place:'Give remotes, games, chargers and other regular items their own obvious spots.',tip:'Empty temporary catch-all baskets during the weekly family reset.'}
];
---
<PublicLayout title="Family Living Room Reset: Five-Minute Routine and Shared Jobs" description="A free family living room reset guide with five illustrated evening habits, six weekly jobs, age-appropriate responsibilities, troubleshooting and a four-page printable PDF." width="full" ogType="article">
<div class="omc-guide text-[#545454]">
<section class="px-5 py-9 sm:px-8 sm:py-14"><div class="mx-auto max-w-5xl">
<nav aria-label="Breadcrumb" class="text-sm font-medium"><a href="/guides" class="underline underline-offset-4">Guides</a><span aria-hidden="true" class="mx-2">/</span>Family Living Room Reset</nav>
<header class="mx-auto mt-9 max-w-[52rem] text-center">
 <p class="eyebrow">SHARED SPACES · FAMILY RESPONSIBILITY</p>
 <h1 class="mt-3 font-serif text-[clamp(2.4rem,6vw,4.25rem)] leading-[1.09] tracking-tight">A living room everyone helps keep ready.</h1>
 <p class="mx-auto mt-5 max-w-[42rem] text-[1.05rem] leading-[1.8] sm:text-lg">Toys on the floor. Blankets everywhere. Another cup on the coffee table. Here's a five-minute routine that helps the whole family reset the space, without Mom picking up after everyone.</p>
 <p class="mt-5 text-xs text-[#777]">Free practical guide · Four-page illustrated printable · Easy to start today</p>
</header>
<div class="mt-10 grid items-center gap-8 border-t-[5px] border-[#CDDDE1] bg-[#FBF7F1] p-6 sm:p-10 md:grid-cols-[1.15fr_.85fr]">
 <div><p class="eyebrow">FREE PRINTABLE · FOUR US LETTER PAGES</p><h2 class="mt-3 font-serif text-3xl leading-tight">The Family Living Room Reset</h2>
 <p class="mt-4 max-w-lg text-sm leading-[1.8] sm:text-base">Five illustrated reset steps, six weekly care jobs, a write-in family responsibility plan, and fixes for the clutter that keeps coming back.</p>
 <ul class="mt-5 space-y-2 text-sm leading-relaxed"><li>✓ A five-minute routine everyone can learn</li><li>✓ Clear jobs with a visible finish line</li><li>✓ One family plan, not constant reminders</li></ul>
 <a href={pdf} download="OMC-Family-Living-Room-Reset.pdf" class="btn-primary mt-7">Download the free PDF</a>
 <p class="mt-2 text-xs text-[#6f6a65]">Four pages · Email requested on first download · Marketing optional</p></div>
 <div class="py-5"><GuidePdfPreview pdf={pdf} images={images} title="The Family Living Room Reset"/></div>
</div>
<nav aria-label="On this page" class="mt-8 border-t border-[#ded8d2] pt-5"><p class="label mb-3 text-[#6f6a65]">IN THIS GUIDE</p>
<div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-3">
<a class="guide-anchor" href="#daily">Five-minute reset</a><a class="guide-anchor" href="#homes">Give everything a home</a><a class="guide-anchor" href="#weekly">Weekly care</a><a class="guide-anchor" href="#problems">Troubleshooting</a><a class="guide-anchor max-sm:col-span-2" href="#family">Family ownership</a></div></nav>
</div></section>
<section id="daily" class="px-5 py-16 sm:px-8 sm:py-20"><div class="mx-auto max-w-5xl">
<p class="eyebrow">01 · THE EVERYDAY RESET</p><h2 class="section-heading">Five minutes. Five jobs. One shared room.</h2>
<p class="section-lede">Start at the same natural moment each evening, such as before bedtime or turning off the TV. This isn't a deep clean. It's everyone putting their own things back where they belong.</p>
<div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
{habits.map(([icon,title,detail,done],i)=><article class="border-t-[5px] border-[#CDDDE1] bg-[#FBF7F1] p-6"><div class="flex items-center gap-4"><img src={art(icon)} alt="" loading="lazy" width="70" height="70" class="size-[70px] object-contain"/><span class="font-serif text-3xl text-[#6f6a65]">{String(i+1).padStart(2,'0')}</span></div><h3 class="mt-3 font-serif text-2xl">{title}</h3><p class="mt-3 text-sm leading-[1.8]">{detail}</p><p class="mt-4 border-t border-[#d8d1cb] pt-3 text-sm"><strong>Done:</strong> {done}</p></article>)}
</div>
<div class="mt-8 bg-[#CDDDE1]/35 p-6 text-sm leading-[1.8]"><strong>What finished looks like:</strong> The family can sit, play and walk through the room without moving yesterday's mess. Not spotless, simply ready to use.</div>
</div></section>
<section id="homes" class="bg-[#D4DFC4]/20 px-5 py-16 sm:px-8 sm:py-20"><div class="mx-auto max-w-5xl">
<p class="eyebrow">02 · MAKE THE RESET EASY</p><h2 class="section-heading">Everything needs a place that makes sense.</h2>
<p class="section-lede">If a child can't reach the basket or a game has no home, repeated reminders won't fix it. Use what you already have, reduce what's left out and put storage where people actually use it.</p>
<div class="mt-9 grid gap-4 md:grid-cols-2">{setups.map(item=><article class="grid gap-4 border-t-[5px] border-[#D4DFC4] bg-white p-6 sm:grid-cols-[72px_1fr]"><img src={art(item.icon)} alt="" width="70" height="70" loading="lazy" class="size-[70px] object-contain"/><div><h3 class="font-serif text-2xl">{item.title}</h3><p class="mt-3 text-sm leading-[1.8]"><strong>Home:</strong> {item.place}</p><p class="mt-2 text-sm leading-[1.8]"><strong>Make it work:</strong> {item.tip}</p></div></article>)}</div>
<aside class="mt-8 border-l-4 border-[#F1D8A8] bg-white p-6 text-sm leading-[1.8]"><strong>Keep the room safe:</strong> Leave walkways and exits clear. Anchor unstable shelves, keep heavy items low, and let adults handle cleaning chemicals, cords and electronics. Never spray cleaner directly on a remote or device.</aside>
</div></section>
<section id="weekly" class="px-5 py-16 sm:px-8 sm:py-20"><div class="mx-auto max-w-5xl">
<p class="eyebrow">03 · WEEKLY CARE</p><h2 class="section-heading">Six small jobs prevent the bigger mess.</h2>
<p class="section-lede">A daily reset makes the living room usable. Pick one weekly moment to care for the space a little more deeply, with tasks matched to each person's abilities.</p>
<div class="mt-9 grid gap-4 md:grid-cols-2">{weekly.map(([icon,title,detail])=><article class="grid gap-4 border-t-[5px] border-[#F1D8A8] bg-[#FBF7F1] p-6 sm:grid-cols-[72px_1fr]"><img src={art(icon)} alt="" width="62" height="62" loading="lazy" class="size-[62px] object-contain"/><div><h3 class="font-serif text-xl">{title}</h3><p class="mt-3 text-sm leading-[1.8]">{detail}</p></div></article>)}</div>
<p class="mt-7 text-sm leading-[1.8]">A family doesn't need to finish all six jobs in one day. Assign two or three that matter most, then build from there. Adults choose safe cleaning methods and supervise vacuuming when appropriate.</p>
</div></section>
<section id="problems" class="bg-[#E8D2D6]/20 px-5 py-16 sm:px-8 sm:py-20"><div class="mx-auto max-w-5xl">
<p class="eyebrow">04 · WHEN CLUTTER RETURNS</p><h2 class="section-heading">Fix the setup, not the people.</h2>
<p class="section-lede">If the room gets messy in the same way every day, make the right action easier. A small storage or timing change usually helps more than another reminder.</p>
<div class="mt-8 space-y-3">{issues.map(([icon,symptom,fix])=><article class="grid gap-4 border-l-4 border-[#E8D2D6] bg-white p-5 md:grid-cols-[1fr_1.3fr]"><div class="flex items-center gap-3"><img src={art(icon)} alt="" width="50" height="50" loading="lazy" class="size-[50px] shrink-0 object-contain"/><h3 class="font-serif text-xl">{symptom}</h3></div><div><p class="eyebrow">WHAT TO CHANGE</p><p class="mt-2 text-sm leading-[1.7]">{fix}</p></div></article>)}</div>
</div></section>
<section id="family" class="px-5 py-16 sm:px-8 sm:py-20"><div class="mx-auto max-w-5xl">
<p class="eyebrow">05 · SHARE THE RESPONSIBILITY</p><h2 class="section-heading">Everyone uses it. Everyone owns a piece.</h2><p class="section-lede">Teach one job at a time. Younger kids can own a toy bin; older kids can handle a full reset. Ages are starting points, not hard requirements. Match tasks to skills and supervision.</p>
<div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{roles.map(([icon,age,detail])=><article class="border-t-[5px] border-[#F1D8A8] bg-[#FBF7F1] p-5"><img src={art(icon)} alt="" width="65" height="65" loading="lazy" class="mb-3 size-16 object-contain"/><span class="eyebrow">{age}</span><p class="mt-3 text-sm leading-[1.8]">{detail}</p></article>)}</div>
<div class="mt-10 grid gap-6 bg-[#CDDDE1]/35 p-7 sm:p-9 md:grid-cols-2"><div><p class="eyebrow">AT THE NEXT FAMILY MEETING</p><h3 class="mt-3 font-serif text-3xl">Choose owners, not helpers.</h3><p class="mt-3 text-sm leading-[1.8]">Use the write-in sheet on page three. Decide which two jobs the family can practice this week before taking on the whole routine.</p></div><ol class="space-y-4 text-sm leading-[1.8]"><li><strong>1. Notice:</strong> What makes the room feel messy fastest?</li><li><strong>2. Assign:</strong> Who owns toys, books, blankets, dishes and shared surfaces?</li><li><strong>3. Practice:</strong> What does a finished room look like?</li><li><strong>4. Review:</strong> What's one small change that would make tomorrow easier?</li></ol></div>
<div class="mt-12 border border-[#ded8d2] bg-white p-7 sm:p-9"><p class="eyebrow">PREVIEW ALL FOUR PAGES</p><h3 class="mt-3 font-serif text-3xl">A printable the family can actually use.</h3><p class="mt-3 mb-7 text-sm leading-[1.8]">The five-minute reset, weekly care jobs, write-in family ownership and fixes for recurring clutter. Print the pages that help most.</p><GuidePageGallery images={images} title="The Family Living Room Reset"/>
<div class="mt-8 text-center"><a href={pdf} download="OMC-Family-Living-Room-Reset.pdf" class="btn-primary">Download the free PDF</a><p class="mt-2 text-xs">Four US Letter pages · Email requested for first download</p></div></div>
<div class="mt-10 grid gap-6 border-t border-[#ded8d2] pt-8 sm:grid-cols-2"><div><h3 class="font-serif text-2xl">Want a routine kids can follow themselves?</h3><p class="mt-3 text-sm leading-[1.8]">Use our free picture Routine Chart Builder for the steps your family chooses.</p><a href="/routine-chart/" class="mt-4 inline-flex min-h-11 items-center font-semibold underline underline-offset-4">Build a free Routine Chart</a></div><div><h3 class="font-serif text-2xl">Give everyone a responsibility by name.</h3><p class="mt-3 text-sm leading-[1.8]">Personalize an ownership chart for your family.</p><a href="/family-responsibility-builder" class="mt-4 inline-flex min-h-11 items-center font-semibold underline underline-offset-4">Open the Responsibility Builder</a></div></div>
<div class="mt-7 grid gap-5 sm:grid-cols-2"><a href="/guides/family-bedroom-reset/" class="font-semibold underline underline-offset-4">More help: Kids' Bedroom Reset</a><a href="/guides/family-kitchen-reset/" class="font-semibold underline underline-offset-4">More help: Family Kitchen Reset</a></div>
<div class="mt-10 bg-[#FBF7F1] p-6"><h3 class="font-serif text-2xl">Want personalized tools mailed to your family?</h3><p class="mt-3 text-sm leading-[1.8]">Organized Family Club sends printed resources and simple guidance to help the whole family take responsibility.</p><a href="/club-2" class="mt-4 inline-flex min-h-11 items-center font-semibold underline underline-offset-4">See how the Club works</a></div>
</div></section></div>
<style>
.omc-guide{font-family:Montserrat,Arial,sans-serif}.omc-guide section[id]{scroll-margin-top:110px}
.omc-guide .eyebrow{font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
.omc-guide .section-heading{max-width:800px;margin-top:14px;font-family:Georgia,serif;font-size:clamp(2rem,4.6vw,3.15rem);line-height:1.16;letter-spacing:-.025em}
.omc-guide .section-lede{max-width:700px;margin-top:16px;font-size:1.06rem;line-height:1.8}
.omc-guide .guide-anchor{display:flex;align-items:center;justify-content:center;min-height:48px;padding:10px 13px;background:#fff;border:1px solid #d8d1cb;border-radius:3px;color:#545454;font-size:14px;font-weight:650;line-height:1.25;text-align:center;text-decoration:none}
.omc-guide .guide-anchor:hover{background:#CDDDE1}.omc-guide .guide-anchor:focus-visible{outline:2px solid #545454;outline-offset:2px}
@media(min-width:640px){.omc-guide .guide-anchor{min-height:44px;padding:9px 14px;font-size:13px}}
</style>
</PublicLayout>

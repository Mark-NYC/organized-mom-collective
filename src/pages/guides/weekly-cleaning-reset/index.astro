---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { dailyEssentials, weeklySchedule, weekend } from '../../../data/cleaning';

const dayGroups = [weeklySchedule.slice(0,2), weeklySchedule.slice(2,4)];
const printPdf = '/downloads/weekly-cleaning-reset-one-page.pdf';
---
<PublicLayout
  title="Weekly Cleaning Reset: Free Illustrated Family Cleaning Guide"
  description="Print the complete weekly cleaning routine with original Organized Mom Collective icons: a 15-minute Daily Reset, Monday to Thursday cleaning zones, and Friday through Sunday plans."
  width="full"
  ogType="article"
>
  <main class="cleaning-guide text-[#545454]">
    <section class="web-only bg-[#FBF7F1] px-5 py-10 sm:px-8 sm:py-16">
      <div class="mx-auto max-w-5xl">
        <nav aria-label="Breadcrumb" class="text-sm"><a href="/guides/" class="underline underline-offset-4">Practical Guides</a><span class="mx-2">/</span>Weekly Cleaning Reset</nav>
        <div class="mt-9 grid items-center gap-9 md:grid-cols-[1.15fr_.85fr]">
          <div>
            <p class="eyebrow">FREE CLEANING GUIDE · ORIGINAL ILLUSTRATIONS</p>
            <h1 class="mt-4 font-serif text-[clamp(2.45rem,6vw,4.2rem)] leading-[1.1]">One small reset. One zone a day. A home everyone helps care for.</h1>
            <p class="mt-5 max-w-xl text-base leading-[1.85]">A realistic cleaning rhythm for the whole family. Five small things every day, a different room Monday through Thursday, and flexible plans for Friday, Saturday and Sunday.</p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href={printPdf} download="OMC-Weekly-Cleaning-Reset.pdf" class="inline-flex min-h-12 items-center justify-center bg-[#545454] px-6 py-3 text-sm font-bold text-white">Download the illustrated PDF</a>
              <a href={printPdf} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center justify-center border border-[#545454] bg-white px-6 py-3 text-sm font-bold">Open print-ready PDF</a>
            </div>
            <p class="mt-3 text-xs text-[#68615c]">US Letter · One page · No signup · Reprint each week</p>
          </div>
          <div class="border border-[#d5c5b8] bg-white p-7">
            <img src={dailyEssentials.icon} alt="Original hand-drawn Daily Reset illustration" width="150" height="150" class="mx-auto h-32 w-32 object-contain" />
            <p class="mt-4 text-center font-serif text-3xl">Your cleaning week</p>
            <div class="mt-5 grid grid-cols-4 gap-3">
              {weeklySchedule.map(d => <div class="text-center"><img src={d.icon} alt="" width="70" height="70" class="mx-auto h-14 w-14 object-contain" /><span class="mt-1 block text-xs font-semibold">{d.shortLabel}</span></div>)}
            </div>
            <p class="mt-5 border-t border-[#d5c5b8] pt-4 text-center text-sm">One shared plan, with our actual calendar icons.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="web-only px-5 py-11 sm:px-8 sm:py-16">
      <div class="mx-auto max-w-5xl">
        <h2 class="font-serif text-3xl">How to make the reset work</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          <div class="border-t-4 border-[#CDDDE1] bg-[#FBF7F1] p-5"><h3 class="font-serif text-xl">1. Share the five basics</h3><p class="mt-2 text-sm leading-relaxed">Make beds, handle dishes, clear counters, pick up living areas and wipe spills. Assign family members the parts they can safely own.</p></div>
          <div class="border-t-4 border-[#D4DFC4] bg-[#FBF7F1] p-5"><h3 class="font-serif text-xl">2. Do today's zone</h3><p class="mt-2 text-sm leading-relaxed">Monday through Thursday, use the checklist or stop when the timer ends. Name an owner and don't silently take the job back.</p></div>
          <div class="border-t-4 border-[#F1D8A8] bg-[#FBF7F1] p-5"><h3 class="font-serif text-xl">3. Keep weekends flexible</h3><p class="mt-2 text-sm leading-relaxed">Friday is deep cleaning, Saturday is a home project, and Sunday is catch-up or reset. Skip what doesn't fit. Never stack missed zones.</p></div>
        </div>
        <p class="mt-6 text-sm leading-relaxed">The checklist below reads from the same cleaning schedule as our <a class="underline underline-offset-4" href="/app/calendar/">cleaning companion</a>. It stays in sync when the core tasks change. The monthly home project changes by month; find its detailed tasks in the companion app.</p>
      </div>
    </section>

    <section class="print-sheets bg-[#edeae6] px-3 py-9 sm:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="web-only mb-5 flex items-center justify-between gap-3">
          <h2 class="font-serif text-2xl">One-page printable checklist</h2>
          <a href={printPdf} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center border border-[#545454] bg-white px-5 py-3 text-sm font-bold">Open one-page PDF</a>
        </div>
<!-- The PDF is the print source of truth: opening it avoids browser-specific CSS page breaks. -->
        <div class="single-sheet bg-white">
          <header><p class="overline">ORGANIZED MOM COLLECTIVE · YOUR FAMILY CLEANING PLAN</p><h2>Our Weekly Cleaning Reset</h2><p>15-minute Daily Reset + one zone each weekday + a flexible weekend</p></header>
          <section class="one-daily">
            <div class="one-heading"><img src={dailyEssentials.icon} alt="" width="34" height="34"/><div><strong>{dailyEssentials.title}</strong><span>EVERY DAY · {dailyEssentials.minutes}</span></div></div>
            <div class="one-daily-grid"><ul>{dailyEssentials.tasks.map(t=><li><span class="one-check"></span>{t.label}</li>)}</ul><div class="one-tracker"><span>DAILY CHECKOFF</span><div>{['M','T','W','T','F','S','S'].map(d=><label>{d}<span class="one-check"></span></label>)}</div></div></div>
          </section>
          <div class="one-zone-grid">
            {weeklySchedule.map(d=><section class="one-zone">
              <div class="one-heading"><img src={d.icon} alt="" width="32" height="32"/><div><span>{d.dayLabel.toUpperCase()} · {d.minutes}</span><strong>{d.zone}</strong></div></div>
              <ul>{d.tasks.map(t=><li><span class="one-check"></span>{t.label}</li>)}</ul>
              <p class="one-owner">OWNER: <span></span></p>
            </section>)}
          </div>
          <section class="one-weekend"><p class="overline">FRIDAY THROUGH SUNDAY · FLEXIBLE</p><div>{weekend.days.map((d,i)=><article><img src={weekend.icon} alt="" width="26" height="26"/><span><strong>{d.dayLabel}: {d.zone}</strong><small>{['Choose one deeper cleaning task','Do one task from the monthly home project','Catch up on one zone, reset, or rest'][i]}</small></span><span class="one-check"></span></article>)}</div></section>
          <footer>Missed a zone? Don't stack it. The monthly project checklist lives in the cleaning companion. · organizedmomcollective.com</footer>
        </div>
      </div>
    </section>
    <section class="web-only px-5 py-12 sm:px-8"><div class="mx-auto max-w-5xl border-t border-[#d5c5b8] pt-7">
      <h2 class="font-serif text-2xl">Keep this where everyone can see it.</h2>
      <p class="mt-3 max-w-2xl leading-relaxed">Print a fresh checklist each week, write the owner's name beside each zone, and bring it to your family meeting. The <a href="/calendar/" class="underline underline-offset-4">family wall calendar</a> keeps the plan visible, while the <a href="/app/calendar/" class="underline underline-offset-4">cleaning companion</a> has the live checklists and monthly project tasks.</p>
      <a href="/resources/weekly-cleaning-schedule-for-busy-moms/" class="mt-5 inline-flex min-h-11 items-center font-semibold underline underline-offset-4">Read the weekly cleaning schedule article</a>
    </div></section>
  </main>
</PublicLayout>

<style is:global>
.cleaning-guide{font-family:Montserrat,Arial,sans-serif}
.cleaning-guide .eyebrow,.cleaning-guide .overline{font-size:10px;font-weight:700;letter-spacing:.1em}
.cleaning-guide .single-sheet{box-sizing:border-box;width:100%;max-width:816px;min-height:1056px;margin:auto;padding:40px 38px 28px;color:#545454;box-shadow:0 3px 16px #0001}
.cleaning-guide .single-sheet header{border-bottom:2px solid #545454;padding-bottom:9px}
.cleaning-guide .single-sheet header h2{font:normal 30px/1.15 Georgia,serif;margin:5px 0}
.cleaning-guide .single-sheet header>p:last-child{font-size:11px}
.cleaning-guide .one-daily{margin-top:12px;border:1px solid #D5C5B8}
.cleaning-guide .one-heading{display:flex;align-items:center;gap:9px;padding:6px 8px;background:#FBF7F1}
.cleaning-guide .one-heading img{object-fit:contain;flex-shrink:0}
.cleaning-guide .one-heading div{display:flex;flex-direction:column;gap:2px}
.cleaning-guide .one-heading strong{font:normal 17px Georgia,serif}
.cleaning-guide .one-heading span{font-size:10px;font-weight:700}
.cleaning-guide .one-daily .one-heading{background:#CDDDE1}
.cleaning-guide .one-daily-grid{padding:9px;display:grid;grid-template-columns:1fr 190px;gap:10px}
.cleaning-guide .one-daily-grid ul{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.cleaning-guide .one-check{width:12px;height:12px;border:1px solid #545454;display:inline-block;flex-shrink:0}
.cleaning-guide .single-sheet li{display:flex;align-items:flex-start;gap:8px;font-size:11px;line-height:1.4}
.cleaning-guide .one-tracker>span{font-size:8px;font-weight:700}
.cleaning-guide .one-tracker>div{display:flex;justify-content:space-between;margin-top:4px}
.cleaning-guide .one-tracker label{font-size:10px;font-weight:700;display:flex;flex-direction:column;gap:4px;align-items:center}
.cleaning-guide .one-zone-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:11px}
.cleaning-guide .one-zone{min-width:0;border:1px solid #D5C5B8;display:flex;flex-direction:column;min-height:281px}
.cleaning-guide .one-zone ul{padding:9px 11px;display:flex;flex-direction:column;gap:12px;flex:1}
.cleaning-guide .one-owner{margin:0 11px 8px;font-size:9px;font-weight:700;display:flex;gap:5px;align-items:center}
.cleaning-guide .one-owner span{flex:1;border-bottom:1px solid #545454;height:9px}
.cleaning-guide .one-weekend{border:1px solid #D5C5B8;margin-top:11px}
.cleaning-guide .one-weekend>.overline{background:#CDDDE1;padding:8px 10px}
.cleaning-guide .one-weekend>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}
.cleaning-guide .one-weekend article{display:flex;align-items:center;gap:6px;padding:9px 6px}
.cleaning-guide .one-weekend article+article{border-left:1px solid #D5C5B8}
.cleaning-guide .one-weekend article>img{object-fit:contain;flex-shrink:0}
.cleaning-guide .one-weekend article>span:nth-child(2){flex:1}
.cleaning-guide .one-weekend article strong{display:block;font:normal 13px Georgia,serif}
.cleaning-guide .one-weekend article small{display:block;font-size:9.5px;margin-top:4px;line-height:1.3}
.cleaning-guide .single-sheet footer{margin-top:10px;border-top:1px solid #D5C5B8;padding-top:7px;font-size:9px}
@page{size:letter;margin:0}
@media print{
body{background:white!important}
.cleaning-guide .web-only,body>header,body>footer,nav,dialog{display:none!important}
.cleaning-guide .print-sheets{background:white!important;padding:0!important;margin:0!important}
.cleaning-guide .print-sheets>div{max-width:none!important}
.cleaning-guide .single-sheet{width:8.5in!important;max-width:none!important;height:11in!important;min-height:0!important;margin:0!important;padding:31px 33px 20px!important;box-shadow:none!important;break-inside:avoid;page-break-inside:avoid;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.cleaning-guide .one-zone{min-height:281px}
}
@media screen and (max-width:650px){
.cleaning-guide .single-sheet{padding:18px 12px;min-height:0}
.cleaning-guide .one-daily-grid{grid-template-columns:1fr}
.cleaning-guide .one-zone-grid{grid-template-columns:1fr}
.cleaning-guide .one-zone{min-height:0}
.cleaning-guide .one-weekend>div{grid-template-columns:1fr}
.cleaning-guide .one-weekend article+article{border-left:0;border-top:1px solid #D5C5B8}
}
</style>
---
/**
 * Dedicated guide library. Guides are complete, repeatable home systems,
 * separate from personalized free generators (/tools) and editorial articles (/resources).
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import GuideDirectoryCard from '../../components/guides/GuideDirectoryCard.astro';
import { guides, guideUrl } from '../../data/guides/guide-directory';
import { routes } from '../../routes';

const featured = guides[0];
const more = guides.slice(1);
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Practical Family Guides | Organized Mom Collective',
  description: 'Step-by-step systems for sharing household work, building routines and making home life easier.',
  url: new URL('/guides', Astro.site!).href,
  hasPart: guides.map(guide => ({
    '@type': 'WebPage', name: guide.title,
    url: new URL(guideUrl(guide), Astro.site!).href,
  })),
}];
---
<PublicLayout
  title="Practical Guides for a More Organized Home"
  description="Free step-by-step family guides with realistic routines, clear responsibilities and ready-to-use printable PDFs. Start with the Family Laundry System, Kitchen Reset and Bathroom Reset."
  width="full"
  jsonLd={jsonLd}
>
  <div class="text-[#545454]">
    <header class="border-b border-[#e7ddd4] bg-[#FBF7F1] px-5 py-14 sm:px-8 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <p class="label text-[#6f6a65]">ORGANIZED MOM COLLECTIVE · PRACTICAL GUIDES</p>
        <h1 class="mt-5 max-w-[780px] font-serif text-[clamp(2.4rem,6vw,4.25rem)] leading-[1.1] tracking-tight">A home that works better for everyone.</h1>
        <p class="mt-6 max-w-[660px] text-[1rem] leading-[1.85] text-[#5c5550] sm:text-[1.12rem]">Realistic systems for the everyday things that keep falling on Mom. Each guide walks through what to do, how to share the work, and how to keep it going.</p>
        <div class="mt-7 flex flex-wrap gap-3 text-[0.82rem] font-semibold text-[#5c5550]">
          <span class="border-l-[3px] border-[#CDDDE1] bg-white px-3 py-2">Step-by-step directions</span>
          <span class="border-l-[3px] border-[#D4DFC4] bg-white px-3 py-2">Clear jobs for the family</span>
          <span class="border-l-[3px] border-[#F1D8A8] bg-white px-3 py-2">Free printable resources</span>
        </div>
      </div>
    </header>

    <section class="px-5 py-14 sm:px-8 sm:py-20" aria-labelledby="featured-guide">
      <div class="mx-auto max-w-5xl">
        <div class="mb-7 flex flex-wrap items-end justify-between gap-3 border-b border-[#ded8d2] pb-4">
          <div>
            <p class="label text-[#6f6a65]">START HERE</p>
            <h2 id="featured-guide" class="mt-3 font-serif text-3xl sm:text-[2.2rem]">The latest practical guide</h2>
          </div>
          <span class="text-[0.8rem] text-[#6f6a65]">{guides.length} {guides.length===1?'guide':'guides'} available</span>
        </div>
        {featured && <GuideDirectoryCard guide={featured} featured />}
      </div>
    </section>

    {more.length > 0 && (
      <section aria-labelledby="all-guides" class="bg-[#FBF7F1] px-5 py-14 sm:px-8 sm:py-20">
        <div class="mx-auto max-w-5xl">
          <p class="label text-[#6f6a65]">BROWSE BY NEED</p>
          <h2 id="all-guides" class="mt-3 font-serif text-3xl">More ways to share the work.</h2>
          <ul class="mt-8 grid gap-6 md:grid-cols-2">
            {more.map(guide=><li><GuideDirectoryCard guide={guide}/></li>)}
          </ul>
        </div>
      </section>
    )}

    <section aria-labelledby="choose-h" class="px-5 py-14 sm:px-8 sm:py-20">
      <div class="mx-auto max-w-5xl border-t border-[#ded8d2] pt-10">
        <p class="label text-[#6f6a65]">LOOKING FOR SOMETHING ELSE?</p>
        <h2 id="choose-h" class="mt-3 font-serif text-3xl sm:text-[2.2rem]">The right kind of help for today.</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <a href={routes.freeTools} class="group block border-t-[5px] border-[#D4DFC4] bg-[#FBF7F1] p-6 transition-colors hover:bg-[#f1f4ec] sm:p-7">
            <p class="label text-[#6f6a65]">PERSONALIZE IT</p>
            <h3 class="mt-3 font-serif text-2xl">Free Tools</h3>
            <p class="mt-3 max-w-md text-sm leading-[1.8]">Build routine charts, responsibility charts and planners for your own family, then print them.</p>
            <span class="mt-5 inline-flex min-h-11 items-center text-[0.8rem] font-bold underline underline-offset-4">Explore free tools <span aria-hidden="true" class="ml-2">→</span></span>
          </a>
          <a href={routes.resources} class="group block border-t-[5px] border-[#E8D2D6] bg-[#FBF7F1] p-6 transition-colors hover:bg-[#f9f0ef] sm:p-7">
            <p class="label text-[#6f6a65]">GET IDEAS</p>
            <h3 class="mt-3 font-serif text-2xl">Articles & Ideas</h3>
            <p class="mt-3 max-w-md text-sm leading-[1.8]">Find everyday organizing advice, practical solutions and home inspiration.</p>
            <span class="mt-5 inline-flex min-h-11 items-center text-[0.8rem] font-bold underline underline-offset-4">Browse articles <span aria-hidden="true" class="ml-2">→</span></span>
          </a>
        </div>
      </div>
    </section>
  </div>
</PublicLayout>

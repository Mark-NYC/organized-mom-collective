---
import PublicLayout from '../layouts/PublicLayout.astro';
const pairings = [
 {id:'heirloom',name:'Heirloom',script:'4',secondary:'12',scriptName:'Great Vibes',secondaryName:'Libre Baskerville'},
 {id:'airy',name:'Airy',script:'7',secondary:'16',scriptName:'Allura',secondaryName:'Cormorant Garamond'},
 {id:'romantic',name:'Romantic',script:'9',secondary:'17',scriptName:'Parisienne',secondaryName:'Lora'},
 {id:'welcoming',name:'Welcoming',script:'3',secondary:'12',scriptName:'Dancing Script',secondaryName:'Libre Baskerville'},
];
---
<PublicLayout title="Personalized Family Values Canvas | Organized Mom Collective" description="Create a beautiful personalized family values canvas with your family's name and six meaningful values." width="full">
<main class="bg-paper text-warm-ink">
<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:py-20">
<p class="label text-warm-soft">PERSONALIZED WALL ART · ORGANIZED MOM COLLECTIVE</p>
<h1 class="mt-4 max-w-3xl font-serif text-[clamp(2.5rem,5vw,4.4rem)] leading-tight">Your family. Your values. Beautifully displayed.</h1>
<p class="mt-4 max-w-2xl text-lg leading-8 text-warm-soft">Choose six values that tell your family's story. See them come to life in a timeless canvas design made for your home.</p>
<div class="mt-10 grid gap-10 lg:grid-cols-[1.12fr_.88fr] lg:items-start">
<div>
<div class="values-room relative mx-auto w-full overflow-hidden">
<img src="/images/shop/family-values-room.webp" width="896" height="1200" alt="Light oak frame on an ivory wall above an oak console" class="block h-auto w-full" fetchpriority="high" />
<svg id="canvas-preview" class="reference-canvas" viewBox="0 0 480 630" role="img" aria-label="Live preview of your personalized family values art">
<text id="preview-name" x="240" y="87" text-anchor="middle" class="reference-script">Anderson</text>
<text id="preview-heading" x="240" y="120" text-anchor="middle" class="reference-caps">FAMILY VALUES</text>
<path id="preview-top-rule" d="M215 143H265" stroke="#666"/>
<g id="preview-values" text-anchor="middle"></g>
<text id="preview-established" x="240" y="575" text-anchor="middle" class="reference-caps">THIS IS WHO WE ARE</text>
</svg>
</div>
<p class="mt-4 text-center text-xs text-warm-soft">Room mockup for illustration. Final proportions follow your selected print size; frame and finish are not yet confirmed.</p>
</div>
<div class="rounded-lg border border-warm-rule bg-white p-6 sm:p-8">
<p class="label text-warm-soft">MAKE IT YOURS</p>
<h2 class="mt-3 font-serif text-3xl">Create your family canvas</h2>
<p class="mt-3 text-sm leading-6 text-warm-soft">Start with our suggestions or choose your own words. Your preview updates as you type.</p>
<form id="values-form" class="mt-7 space-y-5">
<div><label for="family-name" class="mb-2 block text-sm font-semibold">Family name</label><input id="family-name" name="familyName" maxlength="40" value="Anderson" required class="w-full rounded-md border border-warm-rule bg-paper px-4 py-3 focus:outline-2 focus:outline-[#8ca69a]" /></div>
<fieldset><legend class="mb-3 text-sm font-semibold">Your six family values</legend><div class="grid gap-3 sm:grid-cols-2">
{[['Love','We make room for each other'],['Honesty','We tell the truth, even when it’s hard'],['Gratitude','We notice the good and say thank you'],['Kindness','We look for ways to help'],['Grace','We forgive and try again'],['Joy','We make time to laugh together']].map(([v,desc],i)=><div class="sm:col-span-2 grid gap-2 sm:grid-cols-2"><div><label class="mb-1 block text-xs text-warm-soft" for={`value-${i}`}>Value {i+1}</label><input id={`value-${i}`} name="value" maxlength="22" value={v} required class="w-full rounded-md border border-warm-rule bg-paper px-3 py-3 focus:outline-2 focus:outline-[#8ca69a]"/></div><div><label class="mb-1 block text-xs text-warm-soft" for={`desc-${i}`}>Short meaning</label><input id={`desc-${i}`} name="description" maxlength="52" value={desc} required class="w-full rounded-md border border-warm-rule bg-paper px-3 py-3 focus:outline-2 focus:outline-[#8ca69a]"/></div></div>)}
</div></fieldset>
<fieldset class="border-t border-warm-rule pt-5"><legend class="mb-3 text-sm font-semibold">Choose your style</legend>
<p class="mb-4 text-xs leading-5 text-warm-soft">Four thoughtfully paired styles. Choose the one that feels like your family.</p>
<div id="pairing-options" class="grid grid-cols-1 gap-3 min-[380px]:grid-cols-2">
{pairings.map(pair=><label class="cursor-pointer rounded-md border border-warm-rule px-3 py-4 text-center has-[:checked]:border-warm-ink has-[:checked]:bg-cream">
<span class="flex items-center justify-center gap-2 text-xs font-semibold"><input type="radio" name="fontPairing" value={pair.id} aria-label={pair.name} checked={pair.id==='heirloom'} data-name={pair.name} data-script={pair.script} data-secondary={pair.secondary} data-script-name={pair.scriptName} data-secondary-name={pair.secondaryName} class="accent-[#545454]"/>{pair.name}</span>
<span aria-hidden="true" class={`mt-3 block text-4xl leading-normal font-option-script-${pair.script}`}>Anderson</span>
<span aria-hidden="true" class={`mt-1 block text-[11px] leading-relaxed font-option-secondary-${pair.secondary}`}>We make room for each other</span>
</label>)}
</div></fieldset>
<div><label for="established" class="mb-2 block text-sm font-semibold">Year established (optional, replaces the closing line)</label><input id="established" name="established" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" value="" placeholder="e.g. 2020" class="w-full rounded-md border border-warm-rule bg-paper px-4 py-3"/></div><fieldset><legend class="mb-3 text-sm font-semibold">Canvas size</legend><div class="flex flex-wrap gap-3"><label class="cursor-pointer rounded-md border border-warm-rule px-4 py-3 text-sm"><input type="radio" name="size" value="12×16" class="mr-2 accent-[#545454]" />12 × 16 in</label><label class="cursor-pointer rounded-md border border-warm-rule px-4 py-3 text-sm"><input type="radio" name="size" value="16×20" checked class="mr-2 accent-[#545454]" />16 × 20 in</label></div></fieldset>
<div class="rounded-md bg-[#f4f1e9] p-4 text-sm leading-6 text-warm-soft"><strong class="text-warm-ink">Preview mode.</strong> Ordering will open once print specifications, pricing and Gelato fulfillment are verified. No payment is collected here.</div>
<button type="button" id="save-design" class="w-full rounded-md bg-warm-ink px-6 py-4 font-semibold text-white hover:opacity-90">Download my design details</button>
<p id="save-status" role="status" class="text-sm text-warm-soft"></p>
</form>
</div>
</div>
</section>
<section class="bg-cream px-5 py-14 sm:px-8"><div class="mx-auto max-w-5xl"><p class="label text-warm-soft">MORE THAN WALL ART</p><h2 class="mt-3 font-serif text-3xl">Choose the words together.</h2><p class="mt-4 max-w-2xl leading-7 text-warm-soft">Bring your family around the table, talk about what matters most, and pick six values you want to live out. Then give those words a place everyone can see.</p></div></section>
</main>
</PublicLayout>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Allura&family=Dancing+Script&family=Great+Vibes&family=Parisienne&family=Cormorant+Garamond&family=Libre+Baskerville&family=Lora&display=swap');
.reference-script{font-family:'Great Vibes','Brush Script MT',cursive;font-weight:400}
.reference-caps{font-family:'Libre Baskerville',serif;letter-spacing:.18em;font-weight:400;color:#353535}
.reference-canvas text{fill:#545454}.reference-canvas #preview-values .reference-caps{letter-spacing:0}.reference-value{font-weight:400;letter-spacing:0}
.reference-canvas{position:absolute;left:18.527%;top:14.417%;width:62.946%;height:61.667%;overflow:hidden}
.values-room{max-width:640px}

#values-form label:has(input:focus-visible){outline:2px solid #545454;outline-offset:3px}
.font-option-script-3{font-family:'Dancing Script',cursive}.font-option-script-4{font-family:'Great Vibes',cursive}.font-option-script-7{font-family:'Allura',cursive}.font-option-script-9{font-family:'Parisienne',cursive}
.font-option-secondary-12{font-family:'Libre Baskerville',serif}.font-option-secondary-16{font-family:'Cormorant Garamond',serif}.font-option-secondary-17{font-family:'Lora',serif}
</style>
<script>
const form=document.querySelector<HTMLFormElement>('#values-form');
const nameNode=document.querySelector<HTMLElement>('#preview-name');
const valuesNode=document.querySelector<HTMLElement>('#preview-values');
const yearNode=document.querySelector<HTMLElement>('#preview-established');
function data(){
 const fd=new FormData(form!);
 const pairing=form!.querySelector<HTMLInputElement>('input[name="fontPairing"]:checked')!;
 return {family:String(fd.get('familyName')||'').trim(),values:fd.getAll('value').map(v=>String(v).trim()),descriptions:fd.getAll('description').map(v=>String(v).trim()),established:String(fd.get('established')||'').trim(),size:String(fd.get('size')||'16×20'),pairing:pairing.dataset.name!,scriptFont:pairing.dataset.script!,secondaryFont:pairing.dataset.secondary!,scriptName:pairing.dataset.scriptName!,secondaryName:pairing.dataset.secondaryName!};
}
const svgNS='http://www.w3.org/2000/svg';
function update(){
 if(!nameNode||!valuesNode||!yearNode)return;
 const d=data();
 // Match the photographed opening; never stretch text when changing print size.
 const height=630;
 const canvas=document.querySelector('#canvas-preview')!;
 canvas.setAttribute('viewBox',`0 0 480 ${height}`);

 nameNode.textContent=d.family||'Your Family';
 nameNode.setAttribute('class','reference-script font-option-script-'+d.scriptFont);
 document.querySelectorAll('.reference-caps').forEach(el=>el.setAttribute('class','reference-caps font-option-secondary-'+d.secondaryFont));
 yearNode.textContent=d.established?'ESTABLISHED '+d.established:'THIS IS WHO WE ARE';
 yearNode.setAttribute('y',String(height-47));

 valuesNode.replaceChildren(...d.values.map((v,i)=>{
  const group=document.createElementNS(svgNS,'g');
  const y=184+i*(height-299)/5;
  const title=document.createElementNS(svgNS,'text');
  title.setAttribute('x','240');title.setAttribute('y',String(y));
  title.setAttribute('class','reference-value font-option-secondary-'+d.secondaryFont);
  title.textContent=v||'Your value';
  const desc=document.createElementNS(svgNS,'text');
  desc.setAttribute('x','240');desc.setAttribute('y',String(y+24));
  desc.setAttribute('class','reference-caps font-option-secondary-'+d.secondaryFont);
  desc.textContent=d.descriptions[i]||'Your family meaning';
  group.append(title,desc);return group;
 }));
}
function fitText(el:SVGTextElement,size:number,maxWidth:number,maxHeight=40,centerY?:number){
 el.style.fontSize=size+'px';
 const width=el.getComputedTextLength();
 if(width>maxWidth)el.style.fontSize=(size*maxWidth/width)+'px';
 const box=el.getBBox();
 if(box.height>maxHeight)el.style.fontSize=(parseFloat(el.style.fontSize)*maxHeight/box.height)+'px';
 if(centerY!==undefined){const b=el.getBBox();el.setAttribute('y',String(Number(el.getAttribute('y'))+centerY-b.y-b.height/2))}
}
function fitPreview(){
 fitText(nameNode as unknown as SVGTextElement,80,388,80,65);
 fitText(document.querySelector<SVGTextElement>('#preview-heading')!,14,360,22,120);
 fitText(yearNode as unknown as SVGTextElement,10,350);
 const titles=Array.from(document.querySelectorAll<SVGTextElement>('#preview-values .reference-value'));
 // One shared title size keeps short and long values visually balanced.
 titles.forEach(el=>fitText(el,30,374,34));
 const size=Math.min(...titles.map(el=>parseFloat(el.style.fontSize)));
 titles.forEach((el,i)=>{el.style.fontSize=size+'px';const center=184+i*(Number(document.querySelector('#canvas-preview')!.getAttribute('viewBox')!.split(' ')[3])-299)/5;const b=el.getBBox();el.setAttribute('y',String(Number(el.getAttribute('y'))+center-b.y-b.height/2))});
 document.querySelectorAll<SVGTextElement>('#preview-values .reference-caps').forEach((el,i)=>{const center=206+i*(Number(document.querySelector('#canvas-preview')!.getAttribute('viewBox')!.split(' ')[3])-299)/5;fitText(el,13,374,18,center)});
}
let layoutRevision=0;
function scheduleFit(){
 const revision=++layoutRevision;
 fitPreview();
 document.fonts.ready.then(()=>{if(revision===layoutRevision)requestAnimationFrame(fitPreview)});
}
document.fonts.addEventListener('loadingdone',scheduleFit);
form?.addEventListener('submit',event=>event.preventDefault());
form?.addEventListener('input',()=>{update();scheduleFit()});
form?.addEventListener('change',()=>{update();scheduleFit()});


document.querySelector('#save-design')?.addEventListener('click',()=>{if(!form?.reportValidity())return;const d=data();const lines=d.values.map((v,i)=>`${i+1}. ${v}: ${d.descriptions[i]}`).join('\n');const blob=new Blob([`Organized Mom Collective | Family Values Canvas\nFamily: ${d.family}\nValues:\n${lines}\nEstablished: ${d.established}\nCanvas size: ${d.size} inches\nFont pairing: ${d.pairing}\nScript font: ${d.scriptName}\nSecondary font: ${d.secondaryName}\n\nDesign details only. Not a print-ready file or order.\n`],{type:'text/plain'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='family-values-canvas-design.txt';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);const status=document.querySelector('#save-status');if(status)status.textContent='Your design details have been downloaded.'});
update();scheduleFit();
</script>

---
import PublicLayout from '../layouts/PublicLayout.astro';
---
<PublicLayout title="Personalized Family Values Canvas | Organized Mom Collective" description="Create a beautiful personalized family values canvas with your family's name and five meaningful values." width="full">
<main class="bg-paper text-warm-ink">
<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:py-20">
<p class="label text-warm-soft">PERSONALIZED WALL ART · ORGANIZED MOM COLLECTIVE</p>
<h1 class="mt-4 max-w-3xl font-serif text-[clamp(2.5rem,5vw,4.4rem)] leading-tight">Your family. Your values. Beautifully displayed.</h1>
<p class="mt-4 max-w-2xl text-lg leading-8 text-warm-soft">Choose five words that tell your family's story. See them come to life in a timeless canvas design made for your home.</p>
<div class="mt-10 grid gap-10 lg:grid-cols-[1.12fr_.88fr] lg:items-start">
<div class="rounded-lg bg-[#e9e6df] p-5 sm:p-10">
<div id="canvas-preview" class="relative mx-auto aspect-[4/5] max-w-[490px] overflow-hidden border-[10px] border-[#eee8dc] bg-[#FBF7F1] px-7 py-10 text-center shadow-xl sm:px-12 sm:py-14" aria-label="Live preview of your personalized family canvas">
<div class="pointer-events-none absolute inset-4 border border-[#bbcbb4]"></div>
<p class="relative text-[10px] font-semibold uppercase tracking-[.3em] text-[#667c70] sm:text-xs">Our family values</p>
<h2 id="preview-name" class="relative mt-8 break-words font-serif text-[clamp(1.5rem,4vw,2.65rem)] uppercase leading-tight tracking-wide text-[#393a36]">The Anderson Family</h2>
<div class="relative mx-auto my-7 flex max-w-44 items-center gap-3 text-[#8c9f83]"><span class="h-px flex-1 bg-[#c8b6a1]"></span>✦<span class="h-px flex-1 bg-[#c8b6a1]"></span></div>
<div id="preview-values" class="relative flex flex-col items-center gap-3 sm:gap-5">
<p class="font-serif text-xl uppercase tracking-wider">Kindness</p><p class="font-serif text-xl uppercase tracking-wider">Courage</p><p class="font-serif text-xl uppercase tracking-wider">Gratitude</p><p class="font-serif text-xl uppercase tracking-wider">Curiosity</p><p class="font-serif text-xl uppercase tracking-wider">Togetherness</p>
</div>
<p class="relative mt-8 text-[9px] uppercase tracking-[.2em] text-[#728274]">A family we build together</p>
</div>
<p class="mt-4 text-center text-xs text-warm-soft">Digital design preview. Actual print colors and texture may vary.</p>
</div>
<div class="rounded-lg border border-warm-rule bg-white p-6 sm:p-8">
<p class="label text-warm-soft">MAKE IT YOURS</p>
<h2 class="mt-3 font-serif text-3xl">Create your family canvas</h2>
<p class="mt-3 text-sm leading-6 text-warm-soft">Start with our suggestions or choose your own words. Your preview updates as you type.</p>
<form id="values-form" class="mt-7 space-y-5">
<div><label for="family-name" class="mb-2 block text-sm font-semibold">Family name</label><input id="family-name" name="familyName" maxlength="40" value="Anderson" required class="w-full rounded-md border border-warm-rule bg-paper px-4 py-3 focus:outline-2 focus:outline-[#8ca69a]" /></div>
<fieldset><legend class="mb-3 text-sm font-semibold">Your five family values</legend><div class="grid gap-3 sm:grid-cols-2">
{['Kindness','Courage','Gratitude','Curiosity','Togetherness'].map((v,i)=><div><label class="mb-1 block text-xs text-warm-soft" for={`value-${i}`}>Value {i+1}</label><input id={`value-${i}`} name="value" maxlength="24" value={v} required class="w-full rounded-md border border-warm-rule bg-paper px-3 py-3 focus:outline-2 focus:outline-[#8ca69a]"/></div>)}
</div></fieldset>
<fieldset><legend class="mb-3 text-sm font-semibold">Canvas size</legend><div class="flex flex-wrap gap-3"><label class="cursor-pointer rounded-md border border-warm-rule px-4 py-3 text-sm"><input type="radio" name="size" value="12×16" class="mr-2 accent-[#545454]" />12 × 16 in</label><label class="cursor-pointer rounded-md border border-warm-rule px-4 py-3 text-sm"><input type="radio" name="size" value="16×20" checked class="mr-2 accent-[#545454]" />16 × 20 in</label></div></fieldset>
<div class="rounded-md bg-[#f4f1e9] p-4 text-sm leading-6 text-warm-soft"><strong class="text-warm-ink">Preview mode.</strong> Ordering will open once print specifications, pricing and Gelato fulfillment are verified. No payment is collected here.</div>
<button type="button" id="save-design" class="w-full rounded-md bg-warm-ink px-6 py-4 font-semibold text-white hover:opacity-90">Download my design details</button>
<p id="save-status" role="status" class="text-sm text-warm-soft"></p>
</form>
</div>
</div>
</section>
<section class="bg-cream px-5 py-14 sm:px-8"><div class="mx-auto max-w-5xl"><p class="label text-warm-soft">MORE THAN WALL ART</p><h2 class="mt-3 font-serif text-3xl">Choose the words together.</h2><p class="mt-4 max-w-2xl leading-7 text-warm-soft">Bring your family around the table, talk about what matters most, and pick five values you want to live out. Then give those words a place everyone can see.</p></div></section>
</main>
</PublicLayout>
<script>
const form=document.querySelector<HTMLFormElement>('#values-form');
const nameNode=document.querySelector<HTMLElement>('#preview-name');
const valuesNode=document.querySelector<HTMLElement>('#preview-values');
function data(){const fd=new FormData(form!);return {family:String(fd.get('familyName')||'').trim(),values:fd.getAll('value').map(v=>String(v).trim()),size:String(fd.get('size')||'16×20')}}
function update(){if(!nameNode||!valuesNode)return;const d=data();nameNode.textContent=d.family?'The '+d.family+' Family':'Your Family';valuesNode.replaceChildren(...d.values.map(v=>{const p=document.createElement('p');p.className='font-serif text-[clamp(1rem,2.8vw,1.4rem)] uppercase tracking-wider text-[#393a36] break-words max-w-full';p.textContent=v||'Your value';return p}))}
form?.addEventListener('input',update);form?.addEventListener('change',update);
document.querySelector('#save-design')?.addEventListener('click',()=>{if(!form?.reportValidity())return;const d=data();const blob=new Blob([`Organized Mom Collective | Family Values Canvas\nFamily: ${d.family}\nValues:\n${d.values.map((v,i)=>`${i+1}. ${v}`).join('\n')}\nCanvas size: ${d.size} inches\n\nDesign details only. Not a print-ready file or order.\n`],{type:'text/plain'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='family-values-canvas-design.txt';a.click();URL.revokeObjectURL(url);const status=document.querySelector('#save-status');if(status)status.textContent='Your design details have been downloaded.'});
update();
</script>
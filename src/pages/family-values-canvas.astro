---
import PublicLayout from '../layouts/PublicLayout.astro';
---
<PublicLayout title="Personalized Family Values Canvas | Organized Mom Collective" description="Create a beautiful personalized family values canvas with your family's name and five meaningful values." width="full">
<main class="bg-paper text-warm-ink">
<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:py-20">
<p class="label text-warm-soft">PERSONALIZED WALL ART · ORGANIZED MOM COLLECTIVE</p>
<h1 class="mt-4 max-w-3xl font-serif text-[clamp(2.5rem,5vw,4.4rem)] leading-tight">Your family. Your values. Beautifully displayed.</h1>
<p class="mt-4 max-w-2xl text-lg leading-8 text-warm-soft">Choose six values that tell your family's story. See them come to life in a timeless canvas design made for your home.</p>
<div class="mt-10 grid gap-10 lg:grid-cols-[1.12fr_.88fr] lg:items-start">
<div class="rounded-lg bg-[#e9e6df] p-5 sm:p-10">
<div id="canvas-preview" class="reference-canvas relative mx-auto aspect-[3/4] max-w-[490px] overflow-hidden border-[12px] border-[#70482d] bg-[#fffefa] px-6 py-8 text-center shadow-xl sm:px-10 sm:py-10" aria-label="Live preview of your personalized family values art">
<div class="pointer-events-none absolute inset-[7px] border-[5px] border-[#261c17]"></div>
<div class="relative flex h-full flex-col justify-between py-3">
<div>
<h2 id="preview-name" class="reference-script break-words text-[clamp(2.5rem,7vw,4.3rem)] leading-[.95] text-[#333333]">Anderson</h2>
<p class="reference-caps mt-3 text-[clamp(.72rem,2.4vw,1.3rem)]">FAMILY VALUES</p>
<div class="mx-auto mt-4 h-px w-full bg-[#666]"></div>
</div>
<div id="preview-values" class="flex min-h-0 flex-1 flex-col justify-evenly py-3"></div>
<div>
<div class="mx-auto mb-3 h-px w-full bg-[#666]"></div>
<p id="preview-established" class="reference-caps text-[clamp(.55rem,1.5vw,.85rem)]">ESTABLISHED 2020</p>
</div>
</div>
</div>
<p class="mt-4 text-center text-xs text-warm-soft">Digital design preview. Actual print colors and texture may vary.</p>
</div>
<div class="rounded-lg border border-warm-rule bg-white p-6 sm:p-8">
<p class="label text-warm-soft">MAKE IT YOURS</p>
<h2 class="mt-3 font-serif text-3xl">Create your family canvas</h2>
<p class="mt-3 text-sm leading-6 text-warm-soft">Start with our suggestions or choose your own words. Your preview updates as you type.</p>
<form id="values-form" class="mt-7 space-y-5">
<div><label for="family-name" class="mb-2 block text-sm font-semibold">Family name</label><input id="family-name" name="familyName" maxlength="40" value="Anderson" required class="w-full rounded-md border border-warm-rule bg-paper px-4 py-3 focus:outline-2 focus:outline-[#8ca69a]" /></div>
<fieldset><legend class="mb-3 text-sm font-semibold">Your six family values</legend><div class="grid gap-3 sm:grid-cols-2">
{[['Love','Love one another'],['Honesty','Speak the truth with kindness'],['Gratitude','Give thanks in all things'],['Kindness','Show care in what we do'],['Grace','Choose forgiveness'],['Joy','Find reasons to celebrate']].map(([v,desc],i)=><div class="sm:col-span-2 grid gap-2 sm:grid-cols-2"><div><label class="mb-1 block text-xs text-warm-soft" for={`value-${i}`}>Value {i+1}</label><input id={`value-${i}`} name="value" maxlength="22" value={v} required class="w-full rounded-md border border-warm-rule bg-paper px-3 py-3 focus:outline-2 focus:outline-[#8ca69a]"/></div><div><label class="mb-1 block text-xs text-warm-soft" for={`desc-${i}`}>Short meaning</label><input id={`desc-${i}`} name="description" maxlength="52" value={desc} required class="w-full rounded-md border border-warm-rule bg-paper px-3 py-3 focus:outline-2 focus:outline-[#8ca69a]"/></div></div>)}
</div></fieldset>
<fieldset class="border-t border-warm-rule pt-5"><legend class="mb-3 text-sm font-semibold">Choose your fonts</legend><p class="mb-4 text-xs leading-5 text-warm-soft">Font styles are visual approximations of the numbered examples. Exact original fonts have not been identified.</p>
<div class="grid gap-5">
<div><p class="mb-2 text-xs font-semibold uppercase tracking-widest text-warm-soft">Script fonts · Family name and values</p><div id="script-options" class="grid grid-cols-2 gap-2 sm:grid-cols-3">
{Array.from({length:10},(_,i)=><label class="cursor-pointer rounded-md border border-warm-rule p-2 text-center has-[:checked]:border-warm-ink has-[:checked]:bg-cream"><input type="radio" name="scriptFont" value={String(i+1)} checked={i===0} class="sr-only"/><span class="block text-[11px] text-warm-soft">Style {i+1}</span><span class={`block text-[clamp(1.15rem,2.4vw,1.7rem)] leading-tight font-option-script font-option-script-${i+1}`}>Family</span></label>)}
</div></div>
<div><p class="mb-2 text-xs font-semibold uppercase tracking-widest text-warm-soft">Secondary fonts · Descriptions</p><div id="secondary-options" class="grid grid-cols-2 gap-2 sm:grid-cols-3">
{Array.from({length:10},(_,i)=><label class="cursor-pointer rounded-md border border-warm-rule p-2 text-center has-[:checked]:border-warm-ink has-[:checked]:bg-cream"><input type="radio" name="secondaryFont" value={String(i+11)} checked={i===3} class="sr-only"/><span class="block text-[11px] text-warm-soft">Style {i+11}</span><span class={`block text-sm font-option-secondary font-option-secondary-${i+11}`}>Our Values</span></label>)}
</div></div></div></fieldset>
<div><label for="established" class="mb-2 block text-sm font-semibold">Year established (optional)</label><input id="established" name="established" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" value="2020" placeholder="2020" class="w-full rounded-md border border-warm-rule bg-paper px-4 py-3"/></div><fieldset><legend class="mb-3 text-sm font-semibold">Canvas size</legend><div class="flex flex-wrap gap-3"><label class="cursor-pointer rounded-md border border-warm-rule px-4 py-3 text-sm"><input type="radio" name="size" value="12×16" class="mr-2 accent-[#545454]" />12 × 16 in</label><label class="cursor-pointer rounded-md border border-warm-rule px-4 py-3 text-sm"><input type="radio" name="size" value="16×20" checked class="mr-2 accent-[#545454]" />16 × 20 in</label></div></fieldset>
<div class="rounded-md bg-[#f4f1e9] p-4 text-sm leading-6 text-warm-soft"><strong class="text-warm-ink">Preview mode.</strong> Ordering will open once print specifications, pricing and Gelato fulfillment are verified. No payment is collected here.</div>
<button type="button" id="save-design" class="w-full rounded-md bg-warm-ink px-6 py-4 font-semibold text-white hover:opacity-90">Download my design details</button>
<p id="save-status" role="status" class="text-sm text-warm-soft"></p>
</form>
</div>
</div>
</section>
<section class="bg-cream px-5 py-14 sm:px-8"><div class="mx-auto max-w-5xl"><p class="label text-warm-soft">MORE THAN WALL ART</p><h2 class="mt-3 font-serif text-3xl">Choose the words together.</h2><p class="mt-4 max-w-2xl leading-7 text-warm-soft">Bring your family around the table, talk about what matters most, and pick six values you want to live out. Then give those words a place everyone can see.</p></div></section>
</main>
</PublicLayout>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Allura&family=Alex+Brush&family=Caveat:wght@400;600&family=Courgette&family=Dancing+Script:wght@400;600&family=Great+Vibes&family=Kaushan+Script&family=Marck+Script&family=Parisienne&family=Sacramento&family=Amatic+SC&family=Josefin+Sans:wght@400;700&family=Oswald:wght@400;700&family=Playfair+Display&family=Roboto+Slab&family=Special+Elite&family=Libre+Baskerville&family=Barlow+Condensed:wght@400;700&family=Raleway:wght@400;700&display=swap');
.reference-script{font-family:'Allura','Brush Script MT',cursive;font-weight:400}
.reference-caps{font-family:'Montserrat Variable',Montserrat,sans-serif;letter-spacing:.18em;font-weight:400;color:#353535}
.reference-canvas{box-shadow:inset 0 0 0 2px #a17c55,0 15px 35px #342a2226}

.font-option-script-1{font-family:'Kaushan Script',cursive}.font-option-script-2{font-family:'Sacramento',cursive}.font-option-script-3{font-family:'Dancing Script',cursive}.font-option-script-4{font-family:'Great Vibes',cursive}.font-option-script-5{font-family:'Courgette',cursive}.font-option-script-6{font-family:'Marck Script',cursive}.font-option-script-7{font-family:'Allura',cursive}.font-option-script-8{font-family:'Alex Brush',cursive}.font-option-script-9{font-family:'Parisienne',cursive}.font-option-script-10{font-family:'Caveat',cursive;font-weight:600}
.font-option-secondary-11{font-family:'Special Elite',serif}.font-option-secondary-12{font-family:'Libre Baskerville',serif}.font-option-secondary-13{font-family:'Oswald',sans-serif;font-weight:700}.font-option-secondary-14{font-family:'Raleway',sans-serif;font-weight:400}.font-option-secondary-15{font-family:'Josefin Sans',sans-serif}.font-option-secondary-16{font-family:'Special Elite',serif}.font-option-secondary-17{font-family:'Barlow Condensed',sans-serif}.font-option-secondary-18{font-family:'Amatic SC',sans-serif}.font-option-secondary-19{font-family:'Josefin Sans',sans-serif;font-weight:400}.font-option-secondary-20{font-family:'Raleway',sans-serif;font-weight:700}
</style>
<script>
const form=document.querySelector<HTMLFormElement>('#values-form');
const nameNode=document.querySelector<HTMLElement>('#preview-name');
const valuesNode=document.querySelector<HTMLElement>('#preview-values');
const yearNode=document.querySelector<HTMLElement>('#preview-established');
function data(){const fd=new FormData(form!);return {family:String(fd.get('familyName')||'').trim(),values:fd.getAll('value').map(v=>String(v).trim()),descriptions:fd.getAll('description').map(v=>String(v).trim()),established:String(fd.get('established')||'').trim(),size:String(fd.get('size')||'16×20'),scriptFont:String(fd.get('scriptFont')||'1'),secondaryFont:String(fd.get('secondaryFont')||'14')}}
function update(){if(!nameNode||!valuesNode||!yearNode)return;const d=data();nameNode.textContent=d.family||'Your Family';nameNode.className='reference-script font-option-script-'+d.scriptFont+' break-words text-[clamp(2.5rem,7vw,4.3rem)] leading-[.95] text-[#333333]';document.querySelectorAll<HTMLElement>('.reference-caps').forEach(el=>{el.className=el.className.replace(/font-option-secondary-\d+/g,'').trim()+' font-option-secondary-'+d.secondaryFont});yearNode.textContent=d.established?'ESTABLISHED '+d.established:'';valuesNode.replaceChildren(...d.values.map((v,i)=>{const section=document.createElement('div');section.className='min-w-0';const title=document.createElement('p');title.className='reference-script font-option-script-'+d.scriptFont+' break-words text-[clamp(1.8rem,5vw,3.15rem)] leading-[.9] text-[#333]';title.textContent=v||'Your value';const desc=document.createElement('p');desc.className='reference-caps font-option-secondary-'+d.secondaryFont+' mt-1 break-words text-[clamp(.42rem,1.3vw,.7rem)] leading-snug';desc.textContent=d.descriptions[i]||'Your family meaning';section.append(title,desc);return section}))}
form?.addEventListener('input',update);form?.addEventListener('change',update);
document.querySelector('#save-design')?.addEventListener('click',()=>{if(!form?.reportValidity())return;const d=data();const lines=d.values.map((v,i)=>`${i+1}. ${v}: ${d.descriptions[i]}`).join('\n');const blob=new Blob([`Organized Mom Collective | Family Values Canvas\nFamily: ${d.family}\nValues:\n${lines}\nEstablished: ${d.established}\nCanvas size: ${d.size} inches\nScript style: ${d.scriptFont}\nSecondary style: ${d.secondaryFont}\n\nDesign details only. Not a print-ready file or order.\n`],{type:'text/plain'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='family-values-canvas-design.txt';a.click();URL.revokeObjectURL(url);const status=document.querySelector('#save-status');if(status)status.textContent='Your design details have been downloaded.'});
update();
</script>
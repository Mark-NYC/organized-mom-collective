---
/**
 * /calendar — the public product page for the family wall calendar. All purchases
 * happen on Etsy (no checkout here). Every fact on this page is verified against
 * src/config.ts, src/data/cleaning.ts or the Etsy listing images in design/etsy-listing/
 * (02 sections, 07 size and format, 08 two 26-week sets, 12 the damaged/misprinted promise).
 * Don't add shipping times, guarantees or features that aren't in those sources.
 * The Etsy review by #buy (src/data/reviews.ts) is of a previous calendar edition and
 * carries REVIEWS_DISCLAIMER; ratings stay out of the Product JSON-LD.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import CardSlider from '../components/site/CardSlider.astro';
import CalendarOptions from '../components/site/CalendarOptions.astro';
import LiveTodayPhone from '../components/site/LiveTodayPhone.astro';
import PhoneShot from '../components/site/PhoneShot.astro';
import ShopButton from '../components/site/ShopButton.astro';
import HandAsterisks from '../components/site/HandAsterisks.astro';
import { photo } from '../lib/images';
import { calendarOptions, formatPrice } from '../lib/reorder';
import { dailyEssentials } from '../data/cleaning';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';
import { ETSY_REVIEWS_URL, ETSY_SHOP_URL, REVIEWS_DISCLAIMER, review, reviewDate, shopStats } from '../data/reviews';

const PRODUCT = '2027 Family Wall Calendar & Organizer';
const options = calendarOptions();
const byWeeks = [...options].sort((a, b) => a.weeks - b.weeks);
const half = byWeeks[0];
const full = byWeeks[byWeeks.length - 1];

/** The filled-in calendar photo, shown in the photo slider. */
const inUse = photo('calendar-in-use', [640, 960, 1280], '/images/reorder');
/**
 * The photo slider under "Everything your week needs": each real listing photo with the
 * features you can see in it. Every page section appears once; copy matches the listing images.
 */
const gallery = [
  {
    ...photo('calendar-on-wall'),
    width: 1402,
    height: 1122,
    alt: 'The calendar hanging on a wall from its spiral binding, open to the first week of January 2027, before anything is written in.',
    title: 'The whole week at a glance',
    body: 'One week to a page, Monday through Sunday. A tall column for every weekday and room for Saturday and Sunday, hung where the whole family looks.',
    points: ['Daily schedule', 'One week per page'],
  },
  {
    ...inUse,
    width: 1280,
    height: 1280,
    alt: 'A hand writing in the calendar on a kitchen counter, its week filled with school runs, a meal plan, a grocery list and to-dos.',
    title: 'Dinner planned, list written',
    body: 'Write the dinners and who’s handling them, with groceries beside the plan. Put an owner and a day beside each extra job.',
    points: ['Meal plan', 'Grocery list', 'To-dos and notes'],
  },
  {
    ...photo('calendar-features', [640, 960, 1280], '/images/reorder'),
    width: 2000,
    height: 2000,
    alt: 'A filled-in week with its sections labeled: daily schedule, daily cleaning zone, self-care, word of the week, family and friends, prayer and gratitude, meal plan, grocery list and to-do list.',
    title: 'Cleaning, and the things that matter',
    body: 'Each day is printed with one area of the house and a box to tick. Self-Care Habits, Family and Friends, Grateful For and a Word of the Week round out the page.',
    points: ['Daily cleaning zone', 'Self-care', 'Grateful For'],
  },
  {
    ...photo('calendar-specs'),
    width: 2000,
    height: 2000,
    alt: 'The blank calendar page, 11 by 17 inches, beside its details: premium uncoated writing paper, Wire-O binding, built-in hanging hole, double-sided weekly pages, 26 weeks.',
    title: 'Paper that takes a pen',
    body: '11 × 17 inches on premium uncoated paper that takes a pen nicely. Double-sided weekly pages, Wire-O binding and a built-in hanging hole.',
    points: ['11 × 17 in', 'Wire-O binding'],
  },
  {
    ...photo('calendar-sets'),
    width: 2000,
    height: 2000,
    alt: 'A full year as two 26-week sets, January to June and July to December, each month in its own soft color.',
    title: 'Half a year or the whole year',
    body: `Each calendar covers ${half.weeks} weeks, and each month has its own soft color. The full year comes as two ${half.weeks}-week sets.`,
    points: [`${half.weeks} weeks`, 'A color for each month'],
  },
];

/** `icon` names a line icon in public/images/site/icons/. */
const specs: { term: string; icon: string; value: string }[] = [
  { term: 'Layout', icon: 'layout', value: '11 × 17 inches, portrait. One week per page, Monday through Sunday' },
  { term: 'Pages', icon: 'pages', value: 'Double-sided weekly pages, a soft new color each month' },
  { term: 'Paper', icon: 'paper', value: 'Premium uncoated writing paper' },
  { term: 'Binding', icon: 'binding', value: 'Wire-O, with a built-in hanging hole' },
  { term: 'Length', icon: 'length', value: `${half.weeks} weeks per calendar; the full year comes as two ${half.weeks}-week sets` },
];

const steps = [
  { title: 'Review the week together', body: 'Check schedules and dinners together. Write who owns each pickup and household job.' },
  { title: 'Agree on the zone’s owner', body: 'Each day has a printed zone. Choose who takes it, including remembering to check the list.' },
  { title: 'Scan the QR code once', body: 'The companion opens on your phone with today’s zone as a short checklist, plus a daily reset and a monthly project.' },
  { title: 'Check your own part', body: 'Each person checks the plan and follows through. Checkmarks stay on one phone. Missed days don’t stack up.' },
];

const faqs = [
  {
    q: 'How big is the calendar?',
    a: '11 × 17 inches in portrait, with one week across each page. It hangs from its Wire-O binding with a built-in hanging hole.',
  },
  {
    q: 'What’s the difference between the half-year and full-year calendar?',
    a: `The ${half.name} (${half.priceLabel}) covers ${half.weeks} weeks, and comes as ${half.editions.map((e) => e.label).join(' or ')}. The ${full.name} (${full.priceLabel}) covers the whole year and ships as two ${half.weeks}-week sets, so it costs ${formatPrice(full.save)} less than buying two half-year calendars.`,
  },
  {
    q: 'When does the 2027 calendar start?',
    a: 'The first page of the January–June calendar is the week of Monday, December 28, 2026, so you can start right after Christmas.',
  },
  {
    q: 'Is the cleaning companion a separate subscription?',
    a: 'No. The cleaning companion is included with every calendar at no extra cost. There’s no account to create and nothing to subscribe to.',
  },
  {
    q: 'How do I open the cleaning companion?',
    a: 'Scan the QR code printed on your calendar. It opens in your phone’s browser, and you can add it to your Home Screen so it opens like an app.',
  },
  {
    q: 'Where is my cleaning progress saved?',
    a: 'On your own phone, in its browser. Checkmarks aren’t shared between phones. Starting a new calendar doesn’t reset your progress.',
  },
  {
    q: 'Where do I buy it?',
    a: 'On Etsy. Checkout, payment, shipping options and delivery details are all handled there, on the listing.',
  },
  {
    q: 'What if my calendar arrives damaged or misprinted?',
    a: 'We’ll make it right. Reach out to us through Etsy with your order.',
  },
];

const site = Astro.site!;
const url = new URL(routes.calendar, site).href;
const live = options.filter((o) => o.url);
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: PRODUCT,
    description: `An 11 × 17-inch weekly family wall calendar for 2027 with a daily schedule, meal plan, grocery list, to-do list and a daily cleaning zone, plus the cleaning companion website, included.`,
    brand: { '@type': 'Brand', name: BRAND_NAME },
    url,
    image: gallery.map((g) => g.largest).map((p) => new URL(p, site).href),
    // Offers only once a real Etsy listing exists, so nothing claims to be for sale before it is.
    ...(live.length
      ? {
          offers: live.map((o) => ({
            '@type': 'Offer',
            name: o.name,
            price: o.price.toFixed(2),
            priceCurrency: 'USD',
            url: o.url,
          })),
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Family Wall Calendar', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const quality = review('quality');
const check = 'M4.5 10.5 8 14l7.5-8';

const wrap = 'mx-auto max-w-6xl px-5 sm:px-8';
---

<PublicLayout
  fullTitle="2027 Family Wall Calendar & Weekly Organizer · Organized Mom"
  description={`An 11 × 17 weekly family wall calendar for 2027: schedules, meal plan, grocery list, to-dos and a daily cleaning zone, with the cleaning companion website included. From ${half.priceLabel}.`}
  width="full"
  jsonLd={jsonLd}
>
  <style is:global>
    @media (prefers-reduced-motion: no-preference) {
      html:has(#buy) {
        scroll-behavior: smooth;
      }
    }
  </style>

  <!-- Hero -->
  <section aria-labelledby="hero-h" class="overflow-hidden bg-cream public-panel public-intro">
    <div class:list={[wrap, 'grid items-center gap-8 py-10 sm:py-14 md:grid-cols-2 md:gap-12 md:py-16']}>
      <!-- The printed calendar and the real companion (today's screen), cut out and set straight on the background -->
      <div class="relative order-last mx-auto w-full max-w-[30rem] pr-[22%] pb-6 md:max-w-none md:pr-[20%] md:pb-0 lg:pr-[22%]">
        <img
          src="/images/site/calendar-cutout-720.webp"
          srcset="/images/site/calendar-cutout-480.webp 480w, /images/site/calendar-cutout-720.webp 720w, /images/site/calendar-cutout-960.webp 960w"
          sizes="(min-width: 1152px) 420px, (min-width: 768px) 38vw, 76vw"
          width="960"
          height="1410"
          fetchpriority="high"
          decoding="async"
          alt="A page of the 2027 weekly wall calendar: a column for each day with its cleaning zone, Self-Care Habits, Word of the Week, Family and Friends, Grateful For, a meal plan, a grocery list, a to-do list and notes."
          class="block h-auto w-full"
        />
        <div class="absolute right-0 bottom-0 w-[42%] max-w-[14rem] md:-bottom-6 lg:max-w-[15rem]">
          <LiveTodayPhone />
        </div>
      </div>
      <div>
        <p class="label text-warm-soft">Weekly wall calendar · 11 × 17 in</p>
        <h1 id="hero-h" class="serif-hero mt-3 sm:text-[2.9rem] lg:text-[3.2rem]">{PRODUCT}</h1>
        <p class="lede mt-4 max-w-lg text-warm-ink">
          The family’s schedules, meals, groceries and cleaning on one page a week, where everyone can check the plan and find their responsibilities. Plus the
          cleaning companion website for your phone.
        </p>
        <p class="mt-5 text-[1rem] text-warm-ink">
          <span class="font-semibold">{half.name.replace(/ Calendar$/, '')} {half.priceLabel}</span>
          <span class="text-warm-soft" aria-hidden="true"> · </span>
          <span class="font-semibold">{full.name.replace(/ Calendar$/, '')} {full.priceLabel}</span>
          <span class="text-warm-soft"> (best value)</span>
        </p>
        <a href="#buy" data-cta="calendar-hero" class="btn-primary mt-6 min-h-14 w-full px-8 sm:w-auto">Get the Calendar</a>
        <ul class="mt-6 space-y-1.5 text-[0.95rem] text-warm-ink" aria-label="At a glance">
          {
            ['One week per page, Monday through Sunday', 'Cleaning companion included, no subscription', 'Secure checkout on Etsy'].map((t) => (
              <li class="flex gap-2.5">
                <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-[0.1rem] size-[1.1rem] shrink-0 text-rose-deep" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={check} />
                </svg>
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- What's on every page -->
  <section aria-labelledby="page-h" class:list={[wrap, 'py-14 sm:py-20']}>
    <div class="max-w-2xl">
      <h2 id="page-h" class="serif-title">The Everyday Details, Together on One Page.</h2>
      <p class="lede mt-4">
        No more juggling a planner, a meal app, a grocery list on the fridge and reminders in your head. Put the details where everyone can find them, then agree on who owns the jobs.
      </p>
    </div>
    <CardSlider items={gallery} label="Calendar photos and what’s on every page" class="mt-10" />
  </section>

  <!-- Size and format -->
  <section aria-labelledby="format-h" class="bg-cream public-panel">
    <div class:list={[wrap, 'grid gap-8 py-14 sm:py-20 md:grid-cols-[1fr_1.4fr] md:gap-14']}>
      <div>
        <h2 id="format-h" class="serif-title">Big Enough to Actually Use.</h2>
        <p class="lede mt-4">
          Real writing space for a real week, on paper that takes a pen nicely. Hang it in the kitchen, by the back door, or wherever your
          family actually looks.
        </p>
      </div>
      <dl class="border-t border-warm-rule">
        {
          specs.map((s) => (
            <div class="grid grid-cols-[9.5rem_1fr] items-center gap-4 border-b border-warm-rule py-3 sm:grid-cols-[11rem_1fr]">
              <dt class="label flex items-center gap-3 text-warm-soft">
                <span aria-hidden="true" class="grid size-10 shrink-0 place-items-center rounded-full bg-white shadow-[0_3px_10px_rgba(60,40,30,0.14)]">
                  <img src={`/images/site/icons/${s.icon}.png`} alt="" width="24" height="24" class="size-6" loading="lazy" />
                </span>
                {s.term}
              </dt>
              <dd class="text-[1rem] leading-snug text-warm-ink">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- The companion -->
  <section aria-labelledby="companion-h" class:list={[wrap, 'py-14 sm:py-20']}>
    <div class="max-w-2xl">
      <p class="label text-warm-soft">Included with every calendar</p>
      <h2 id="companion-h" class="serif-title mt-3">A Plan on Your Wall. A Little Help on Your Phone.</h2>
      <p class="lede mt-4">
        The cleaning companion is a simple website that works alongside the printed calendar. It turns each day’s cleaning zone into a short
        checklist, adds a {dailyEssentials.minutes.replace(/ minutes?$/, '-minute')} Daily Reset, and gives you one home project a month. No subscription, no account, nothing to
        install.
      </p>
    </div>
    <div class="mt-10 grid items-center gap-12 md:grid-cols-[1fr_1.1fr]">
      <div class="grid grid-cols-2 gap-4 sm:gap-6">
        <PhoneShot
          name="today"
          alt="The companion's Today screen: Wednesday's zone, Entry/Bathroom, with the Daily Reset checklist partly ticked off."
        />
        <PhoneShot
          name="week"
          alt="The companion's Week screen: each day's cleaning zone from Monday's Living Room to Sunday's Catch-Up / Reset, with progress for the days so far."
          class="mt-10"
        />
      </div>
      <div>
        <h3 class="label text-warm-soft">How they work together</h3>
        <ol class="mt-4 border-t border-warm-rule">
          {
            steps.map((s, i) => (
              <li class="flex gap-5 border-b border-warm-rule py-4">
                <span aria-hidden="true" class="w-6 shrink-0 font-serif text-[2rem] leading-none text-rose">
                  {i + 1}
                </span>
                <div>
                  <p class="text-[1.05rem] leading-snug font-bold text-warm-ink">{s.title}</p>
                  <p class="mt-1 text-[1rem] leading-relaxed text-warm-soft">{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a href={routes.companion} class="text-link mt-6 inline-block">More about the cleaning companion</a>
      </div>
    </div>
  </section>

  <!-- Options -->
  <section id="buy" aria-labelledby="buy-h" class="scroll-mt-4 bg-sage-wash public-panel">
    <div class:list={[wrap, 'py-14 sm:py-20']}>
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="buy-h" class="serif-title">Choose How Far Ahead You Want to Plan.</h2>
        <p class="lede mt-4">Same calendar. Same companion. Just choose how many weeks you want.</p>
      </div>
      <div class="mt-9">
        <CalendarOptions />
      </div>
      <p class="mx-auto mt-7 max-w-2xl text-center text-[0.95rem] leading-snug text-warm-soft">
        Both include the cleaning companion. Checkout is on Etsy. Arrives damaged or misprinted? We’ll make it right.
      </p>
      <figure class="mx-auto mt-10 max-w-xl border-t border-rule pt-8 text-center">
        <blockquote cite={ETSY_REVIEWS_URL} class="font-serif text-[1.3rem] leading-snug italic sm:text-[1.45rem]">
          <p>“{quality.quote}”</p>
        </blockquote>
        <figcaption class="mt-4 text-[0.9rem] leading-snug text-balance text-warm-soft">
          <span class="font-semibold text-ink">{quality.name}</span>, <time datetime={quality.date}>{reviewDate(quality.date)}</time> ·{' '}
          <a href={ETSY_REVIEWS_URL} target="_blank" rel="noopener noreferrer" class="underline decoration-rule underline-offset-[3px] hover:decoration-ink"
            >Read the review on Etsy<span class="sr-only"> (opens Etsy)</span></a
          >
          <span class="mt-1.5 block">
            <span aria-hidden="true">★</span>{' '}
            {shopStats.rating}/5 from {shopStats.reviews} reviews on{' '}
            <a href={ETSY_SHOP_URL} target="_blank" rel="noopener noreferrer" class="underline decoration-rule underline-offset-[3px] hover:decoration-ink"
              >our Etsy shop<span class="sr-only"> (opens Etsy)</span></a
            >.
          </span>
          <span class="mt-1.5 block">{REVIEWS_DISCLAIMER}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- FAQ -->
  <section aria-labelledby="faq-h" class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <h2 id="faq-h" class="serif-title text-center">Questions Before You Buy?</h2>
    <div class="mt-8 border-t border-warm-rule">
      {
        faqs.map((f) => (
          <details class="group border-b border-warm-rule">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 text-[1.05rem] leading-snug font-semibold text-warm-ink [&::-webkit-details-marker]:hidden">
              {f.q}
              <span aria-hidden="true" class="shrink-0 text-[1.25rem] font-normal text-warm-soft transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="pb-5 text-[1rem] leading-relaxed text-warm-soft">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Close -->
  <section aria-labelledby="close-h" class="bg-blush-wash public-panel">
    <div class="mx-auto max-w-2xl px-5 py-16 text-center sm:px-8 sm:py-20">
      <HandAsterisks class="mb-6" />
      <h2 id="close-h" class="serif-title">Less for You to Remember.<br /> A Lot More <span class="hand-highlight hand-highlight-apricot">Room for Life.</span></h2>
      <p class="lede mx-auto mt-5 max-w-lg text-warm-ink">Put the week on the wall, agree on owners and practice checking the plan without asking Mom.</p>
      <ShopButton label="Get the Calendar" cta="calendar-close" class="mt-8 min-h-14 w-full px-8 sm:w-auto" />
    </div>
  </section>
</PublicLayout>

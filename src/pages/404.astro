---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found">
  <div class="max-w-xl">
    <p class="rule-label text-muted">404</p>
    <h1 class="mt-4 font-serif text-[2.9rem] leading-[0.98] font-medium">This page isn’t here.</h1>
    <p class="mt-4 text-muted">Let’s get you back to today.</p>
    <a href="/" class="btn-primary mt-10">Go to today</a>
  </div>
</Layout>

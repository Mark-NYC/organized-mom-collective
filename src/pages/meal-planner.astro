---
/**
 * /meal-planner — a free weekly dinner planner built on FP-05's method: label each night full, short or zero by the
 * time you'll have, plan four or five dinners to fit (zero nights count), give each dinner an owner, including checking supplies, and write
 * the grocery list from the plan. The week starts on this week's Monday (editable); the night counts add up as you
 * go. Rebuilt from the old Weekly Meal Planner (28 boxes for three meals and snacks a day, nothing saved). Downloads
 * as a PNG (US Letter landscape). Autosave and export: src/lib/printable.ts (`omc:meal-planner:v1`). Classes `mp-`.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const kinds = [
  { id: 'full', label: 'Full', hint: '45+ min' },
  { id: 'short', label: 'Short', hint: '20 min' },
  { id: 'zero', label: 'Zero', hint: '0–5 min' },
];
const sample = { on: 'Soccer till 6', dinner: 'Tacos', help: 'Ava sets the table' };
const groceries = [
  { id: 'produce', title: 'Produce', lines: 5 },
  { id: 'protein', title: 'Meat & protein', lines: 4 },
  { id: 'dairy', title: 'Dairy & eggs', lines: 4 },
  { id: 'pantry', title: 'Pantry & other', lines: 5 },
];
const backups = ['Pasta + jarred sauce', 'Eggs and toast', 'Freezer pizza', ''];

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Weekly Dinner Planner', item: new URL(routes.mealPlanner, site).href },
    ],
  },
];
---

<PublicLayout
  title="Free Weekly Meal Planner for Families (Dinner Plan + Grocery List)"
  description="A free printable weekly meal planner for busy families: label each night full, short or zero, plan four or five dinners to fit, give everyone a job and write the grocery list."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="mp-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free weekly meal planner</p>
      <h1 id="mp-h" class="serif-hero mt-3">Plan the Nights Before the Food.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        Mark each night full, short or zero by how much time you’ll really have. Plan four or five dinners to fit; zero nights count. Give
        each dinner an owner, including checking supplies, then write the grocery list from the plan. About 20 minutes, once a week.
        {' '}<a href={routes.article('weekly-meal-planning-for-families')} class="text-link">How the method works</a>
      </p>
    </div>
  </section>

  <div class="mp-container">
    <div class="mp-actions">
      <button type="button" class="mp-btn mp-btn-primary" data-mp-download>Download plan</button>
      <button type="button" class="mp-btn" data-mp-next>Next week</button>
      <button type="button" class="mp-btn mp-secondary-action" data-mp-clear>Clear</button>
    </div>

    <div class="mp-sheet" id="meal-planner">
      <div class="mp-head">
        <div class="mp-title">Our Dinners This Week</div>
        <label class="mp-week">
          <span>Week of</span>
          <input type="date" data-field="week" data-mp-week aria-label="Week starting" />
        </label>
      </div>

      <div class="mp-body">
        <div>
          <table class="mp-table">
            <thead>
              <tr>
                <th scope="col" class="mp-day-col">Day</th>
                <th scope="col" class="mp-kind-col">The night</th>
                <th scope="col">What’s on</th>
                <th scope="col">Dinner</th>
                <th scope="col">Who owns what</th>
              </tr>
            </thead>
            <tbody>
              {
                days.map((day, i) => {
                  const id = day.slice(0, 3).toLowerCase();
                  return (
                    <tr data-mp-row={id}>
                      <th scope="row">
                        <span class="mp-day">{day.slice(0, 3)}</span>
                        <span class="mp-date" data-mp-date={i} />
                      </th>
                      <td>
                        <input type="hidden" data-field={`${id}-kind`} data-mp-kind />
                        <div class="mp-pills" role="group" aria-label={`${day}: kind of night`}>
                          {kinds.map((k) => (
                            <button type="button" class="mp-pill" data-mp-pick={k.id} aria-pressed="false">
                              {k.label}
                            </button>
                          ))}
                        </div>
                      </td>
                      <td><textarea rows="2" data-field={`${id}-on`} placeholder={i === 0 ? sample.on : ''} aria-label={`${day}: what’s on`} /></td>
                      <td><textarea rows="2" data-field={`${id}-dinner`} placeholder={i === 0 ? sample.dinner : ''} aria-label={`${day}: dinner`} /></td>
                      <td><textarea rows="2" data-field={`${id}-help`} placeholder={i === 0 ? sample.help : ''} aria-label={`${day}: helper’s job`} /></td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>

          <div class="mp-key">
            {
              kinds.map((k) => (
                <span>
                  <b>{k.label}</b> {k.hint}
                </span>
              ))
            }
            <span class="mp-count" data-mp-count></span>
          </div>

          <div class="mp-backups">
            <span class="mp-label">Zero-night backups in the house</span>
            <div class="mp-backup-lines">
              {backups.map((b, i) => <input type="text" data-field={`backup-${i}`} value={b} aria-label={`Backup dinner ${i + 1}`} />)}
            </div>
          </div>
        </div>

        <div class="mp-groceries">
          <div class="mp-label mp-groceries-title">Grocery list</div>
          {
            groceries.map((g) => (
              <div class="mp-group">
                <div class="mp-group-title">{g.title}</div>
                <ul>
                  {Array.from({ length: g.lines }, (_, i) => (
                    <li>
                      <input type="checkbox" data-field={`${g.id}-${i}-got`} aria-label={`${g.title} ${i + 1}: got it`} />
                      <input type="text" data-field={`${g.id}-${i}`} aria-label={`${g.title} ${i + 1}`} />
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mp-foot">{BRAND_NAME}</div>
    </div>

    <p class="mp-footnote">
      Check what you already have with the free <a href={routes.pantry} class="text-link">Pantry Inventory</a>, and let the kids pack their own
      {' '}lunches with the <a href={routes.lunchSnackStation} class="text-link">Lunch & Snack Station</a>. The
      {' '}<a href={routes.calendar} data-cta="meal-planner" class="text-link">Family Wall Calendar</a> has the meal plan and grocery list on the
      {' '}same page as the week.
    </p>
  </div>
</PublicLayout>

<style is:global>
  .mp-container {
    background: var(--color-ivory);
    padding: 28px 20px 56px;
    color: var(--color-warm-ink);
  }
  .mp-container *,
  .mp-container *::before,
  .mp-container *::after {
    box-sizing: border-box;
  }
  .mp-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0 auto 20px;
  }
  .mp-btn {
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid var(--color-warm-button);
    border-radius: 3px;
    background: #fff;
    color: var(--color-warm-button);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .mp-btn:hover {
    background: var(--color-rose-wash);
  }
  .mp-btn-primary {
    background: var(--color-warm-button);
    color: #fff;
  }
  .mp-btn-primary:hover {
    background: #362e2d;
  }
  .mp-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  /* The sheet: US Letter landscape (11 × 8.5 in at 96 px/in). */
  .mp-sheet {
    display: flex;
    flex-direction: column;
    width: 1056px;
    max-width: 100%;
    min-height: 816px;
    margin: 0 auto;
    padding: 28px 32px 16px;
    background: #fff;
    border: 1px solid var(--color-warm-rule);
    border-radius: 6px;
    box-shadow: 0 6px 24px rgba(77, 69, 68, 0.08);
    font-family: var(--font-serif);
  }
  .mp-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-rose);
  }
  .mp-title {
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .mp-week {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-warm-soft);
  }
  .mp-week input {
    border: none;
    border-bottom: 1px solid var(--color-warm-rule);
    background: transparent;
    font-family: var(--font-serif);
    font-size: 17px;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-rose-deep);
  }
  .mp-body {
    display: grid;
    grid-template-columns: 1fr 250px;
    gap: 24px;
    margin-top: 16px;
  }
  .mp-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .mp-table thead th {
    padding: 4px 6px;
    background: var(--color-warm-button);
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-align: left;
    text-transform: uppercase;
    color: #fff;
  }
  .mp-day-col {
    width: 58px;
  }
  .mp-kind-col {
    width: 150px;
  }
  .mp-table tbody th {
    padding: 0 6px;
    text-align: left;
    font-weight: 400;
  }
  .mp-day {
    display: block;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-rose-deep);
  }
  .mp-date {
    display: block;
    font-size: 13px;
    color: var(--color-warm-soft);
  }
  .mp-table td,
  .mp-table tbody th {
    height: 70px;
    border-bottom: 1px solid var(--color-warm-rule);
  }
  .mp-table td {
    padding: 0 6px;
  }
  .mp-table td + td {
    border-left: 1px solid #f1ebe7;
  }
  .mp-table textarea {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    resize: none;
    overflow: hidden;
    background: transparent;
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.3;
    font-weight: 400;
    color: var(--color-warm-ink);
  }
  .mp-container input::placeholder,
  .mp-container textarea::placeholder {
    color: #c4b8b2;
  }
  .mp-container input:focus,
  .mp-container textarea:focus {
    outline: none;
    background: var(--color-rose-wash);
  }
  .mp-pills {
    display: flex;
    gap: 4px;
  }
  .mp-pill {
    flex: 1;
    padding: 4px 0;
    border: 1px solid var(--color-warm-rule);
    border-radius: 999px;
    background: #fff;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #a99c96;
    cursor: pointer;
  }
  .mp-pill[aria-pressed='true'][data-mp-pick='full'] {
    border-color: var(--color-rose-deep);
    background: var(--color-rose-deep);
    color: #fff;
  }
  .mp-pill[aria-pressed='true'][data-mp-pick='short'] {
    border-color: var(--color-rose);
    background: var(--color-rose-wash);
    color: var(--color-rose-deep);
  }
  .mp-pill[aria-pressed='true'][data-mp-pick='zero'] {
    border-color: #9aab8f;
    background: var(--color-sage-wash);
    color: #5d6b55;
  }
  .mp-key {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
    font-size: 12px;
    color: var(--color-warm-soft);
  }
  .mp-key b {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-warm-ink);
  }
  .mp-count {
    margin-left: auto;
    font-style: italic;
    color: var(--color-rose-deep);
  }
  .mp-label {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-rose-deep);
  }
  .mp-backups {
    margin-top: 16px;
    padding: 10px 14px;
    border: 1px dashed var(--color-rose);
    border-radius: 6px;
  }
  .mp-backup-lines {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 4px;
  }
  .mp-backup-lines input {
    min-width: 0;
    border: none;
    border-bottom: 1px solid var(--color-warm-rule);
    background: transparent;
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-warm-ink);
  }
  .mp-groceries {
    padding: 10px 14px;
    border-radius: 6px;
    background: #fdfaf8;
    border: 1px solid var(--color-warm-rule);
  }
  .mp-groceries-title {
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-warm-rule);
  }
  .mp-group {
    margin-top: 8px;
  }
  .mp-group-title {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-warm-soft);
  }
  .mp-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mp-group li {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    border-bottom: 1px solid #f1ebe7;
  }
  .mp-group input[type='checkbox'] {
    flex: none;
    width: 13px;
    height: 13px;
    margin: 0;
    accent-color: var(--color-rose-deep);
    cursor: pointer;
  }
  .mp-group input[type='text'] {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-warm-ink);
  }
  .mp-foot {
    margin-top: auto;
    padding-top: 10px;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
    color: #b3a7a1;
  }
  .mp-footnote {
    max-width: 1056px;
    margin: 28px auto 0;
    text-align: center;
    font-size: 0.95rem;
    line-height: 2;
    color: var(--color-warm-soft);
  }

  /* Keep the printable unchanged; simplify only the on-screen phone controls. */
  @media (max-width: 768px) {
    .mp-actions { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .mp-actions .mp-btn { width:100%; letter-spacing:0; text-transform:none; font-size:.9rem; border-radius:12px; }
    .mp-actions .mp-secondary-action { grid-column:1 / -1; width:auto; justify-self:center; border:0; text-decoration:underline; min-height:44px; }
    .mp-container:not(.mp-exporting) .mp-table tbody tr { border:1px solid var(--color-warm-rule); border-radius:14px; padding:14px; margin-bottom:12px; background:#fff; }
    .mp-container:not(.mp-exporting) .mp-pills { gap:6px; }
    .mp-container:not(.mp-exporting) .mp-pill { min-height:44px; font-size:12px; letter-spacing:0; }
    .mp-container:not(.mp-exporting) .mp-table textarea { padding:8px 2px; font-size:16px; min-height:42px; }
  }
  /* Phones: one day per block, groceries below. The PNG is always the Letter layout. */
  @media (max-width: 768px) {
    .mp-container:not(.mp-exporting) .mp-sheet {
      min-height: 0;
      padding: 18px 12px 12px;
    }
    .mp-container:not(.mp-exporting) .mp-head {
      flex-direction: column;
    }
    .mp-container:not(.mp-exporting) .mp-title {
      font-size: 24px;
    }
    .mp-container:not(.mp-exporting) .mp-body {
      grid-template-columns: 1fr;
    }
    .mp-container:not(.mp-exporting) .mp-table thead {
      display: none;
    }
    .mp-container:not(.mp-exporting) .mp-table,
    .mp-container:not(.mp-exporting) .mp-table tbody,
    .mp-container:not(.mp-exporting) .mp-table tr,
    .mp-container:not(.mp-exporting) .mp-table th,
    .mp-container:not(.mp-exporting) .mp-table td {
      display: block;
      width: 100%;
      height: auto;
      border: none;
    }
    .mp-container:not(.mp-exporting) .mp-table tr {
      padding: 10px 0;
      border-bottom: 1px solid var(--color-warm-rule);
    }
    .mp-container:not(.mp-exporting) .mp-table td {
      padding: 4px 0;
    }
    .mp-container:not(.mp-exporting) .mp-table tbody th .mp-day,
    .mp-container:not(.mp-exporting) .mp-table tbody th .mp-date {
      display: inline;
      margin-right: 6px;
    }
    .mp-container:not(.mp-exporting) .mp-table textarea {
      border-bottom: 1px solid #f1ebe7;
    }
    .mp-container:not(.mp-exporting) .mp-backup-lines {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  import { autosave, downloadPng, fieldsIn } from '../lib/printable';
  import { toolEvent } from '../lib/tool-engagement';

  const sheet = document.getElementById('meal-planner')!;
  const host = sheet.closest<HTMLElement>('.mp-container')!;
  const weekField = sheet.querySelector<HTMLInputElement>('[data-mp-week]')!;

  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const thisMonday = () => {
    const d = new Date();
    d.setDate(d.getDate() - ((d.getDay() + 6) % 7));
    return d;
  };
  const weekStart = () => {
    const [y, m, d] = weekField.value.split('-').map(Number);
    return y ? new Date(y, m - 1, d) : thisMonday();
  };

  const showDates = () => {
    const start = weekStart();
    for (const el of sheet.querySelectorAll<HTMLElement>('[data-mp-date]')) {
      const d = new Date(start);
      d.setDate(start.getDate() + Number(el.dataset.mpDate));
      el.textContent = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }
  };

  // Night kinds live in hidden fields; the pills show them.
  const kindFields = Array.from(sheet.querySelectorAll<HTMLInputElement>('[data-mp-kind]'));
  const showKinds = () => {
    const counts: Record<string, number> = { full: 0, short: 0, zero: 0 };
    for (const field of kindFields) {
      for (const pill of field.parentElement!.querySelectorAll<HTMLButtonElement>('[data-mp-pick]')) {
        pill.setAttribute('aria-pressed', String(pill.dataset.mpPick === field.value));
      }
      if (field.value in counts) counts[field.value]++;
    }
    const labeled = counts.full + counts.short + counts.zero;
    sheet.querySelector('[data-mp-count]')!.textContent = labeled ? `${counts.full} full · ${counts.short} short · ${counts.zero} zero` : '';
  };

  const save = autosave(sheet, 'omc:meal-planner:v1', () => {
    if (!weekField.value) weekField.value = iso(thisMonday());
    showDates();
    showKinds();
  });
  weekField.addEventListener('input', showDates);

  let firstAction = false;
  for (const pill of sheet.querySelectorAll<HTMLButtonElement>('[data-mp-pick]')) {
    pill.addEventListener('click', () => {
      const field = pill.closest('td')!.querySelector<HTMLInputElement>('[data-mp-kind]')!;
      // A second tap clears it.
      field.value = field.value === pill.dataset.mpPick ? '' : pill.dataset.mpPick!;
      showKinds();
      if (!firstAction) { firstAction = true; toolEvent('tool_first_action', 'meal-planner'); }
      toolEvent('tool_start', 'meal-planner');
      save();
    });
  }

  document.querySelector('[data-mp-next]')!.addEventListener('click', () => {
    if (!confirm('Start next week? This clears the dinners, jobs and groceries and keeps your backups.')) return;
    const next = weekStart();
    next.setDate(next.getDate() + 7);
    for (const el of fieldsIn(sheet)) {
      if (el === weekField || el.dataset.field!.startsWith('backup-')) continue;
      if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = false;
      else el.value = '';
    }
    weekField.value = iso(next);
    showDates();
    showKinds();
    save();
  });

  document.querySelector('[data-mp-clear]')!.addEventListener('click', () => {
    if (!confirm('Clear the whole planner?')) return;
    for (const el of fieldsIn(sheet)) {
      if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = false;
      else el.value = el.defaultValue;
    }
    weekField.value = iso(thisMonday());
    showDates();
    showKinds();
    save();
  });

  const button = document.querySelector<HTMLButtonElement>('[data-mp-download]')!;
  button.addEventListener('click', async () => {
    toolEvent('tool_download_click', 'meal-planner');
    // Placeholder hints would print as if they'd been filled in: drop them while capturing.
    const hinted = Array.from(sheet.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[placeholder]'));
    const hints = hinted.map((el) => el.placeholder);
    hinted.forEach((el) => el.removeAttribute('placeholder'));
    try {
      await downloadPng(sheet, { filename: `dinner-plan-${iso(weekStart())}.png`, width: 1056, height: 816, layoutHost: host, exportClass: 'mp-exporting', button });
    } finally {
      hinted.forEach((el, i) => (el.placeholder = hints[i]));
    }
  });
</script>

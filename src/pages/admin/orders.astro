---
/**
 * Order management for the direct website shop (admins only). The page holds no data:
 * it signs in to Supabase, row-level security returns orders only to accounts listed in
 * shop_admins, and every change goes through the shop-admin Edge Function, which checks
 * the account again. Etsy orders are not here. Setup: supabase/SHOP.md.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import OrdersAdmin from '../../components/shop/OrdersAdmin';
---

<PublicLayout title="Orders" description="Order management for the Organized Mom Collective team." indexable={false} chrome={false} width="wide">
  <p class="label text-muted">Admin · Website orders</p>
  <h1 class="page-title mt-3">Orders</h1>
  <OrdersAdmin client:only="react" />
</PublicLayout>

---
import PublicLayout from '../layouts/PublicLayout.astro';
import { scheduler } from '../data/scheduler';
import { routes } from '../routes';

const root = '/images/products/family-schedule-calendar-2027/';
const photos = [
  { file: 'il_1588xN.8645639709_cqeg.webp', alt: 'Family Wall Calendar 2027 product overview with a monthly planning page' },
  { file: 'il_1588xN.8645639919_d7tz.webp', alt: 'Family Wall Calendar 2027 listing photo 2' },
  { file: 'il_1588xN.8645639937_c62w.webp', alt: 'Family Wall Calendar 2027 listing photo 3' },
  { file: 'il_1588xN.8645639955_8yuo.webp', alt: 'Family Wall Calendar 2027 listing photo 4' },
  { file: 'il_1588xN.8645640127_9asb.webp', alt: 'Family Wall Calendar 2027 listing photo 5' },
  { file: 'il_1588xN.8597798306_6xvw.webp', alt: 'Family Wall Calendar 2027 listing photo 6' },
  { file: 'il_1588xN.8597798356_bkbt.webp', alt: 'Family Wall Calendar 2027 listing photo 7' },
  { file: 'il_1588xN.8597798456_ezuf.webp', alt: 'Family Wall Calendar 2027 listing photo 8' },
  { file: 'il_1588xN.8597798536_syjp.webp', alt: 'Family Wall Calendar 2027 listing photo 9' },
  { file: 'il_1588xN.8623822104_7h6f.webp', alt: 'Family Wall Calendar 2027 listing photo 10' },
];
const media = [
  ...photos.map((p) => ({ kind: 'image' as const, src: root + p.file, alt: p.alt })),
  { kind: 'video' as const, src: root + 'vid_v1.mp4', alt: 'Watch the Family Wall Calendar 2027 product video' },
];
const highlights = [
  'January to December 2027',
  '11 × 16.5 in (Ledger / A3-size)',
  'Five color-coded family planning rows',
  'Monday to Sunday monthly layout',
  'To-do checklist next to each week',
  'Wire binding with hanging hook',
  'Printed on cardstock',
];
const faq = [
  { title: 'What size is it?', body: 'The printed calendar is 11 × 16.5 inches and hangs vertically.' },
  { title: 'How many months are included?', body: 'Twelve monthly planning pages, January through December 2027, plus a cover.' },
  { title: 'How does it hang?', body: 'The top wire binding includes a hanger designed for wall display.' },
];
---
<PublicLayout
  title="2027 Family Wall Calendar | Large Monthly Family Schedule"
  description="A large 2027 family wall calendar with 12 monthly pages, five color-coded planning rows and to-do checklists. See all the photos and video."
  width="full"
>
  <div class="bg-white">
    <div class="mx-auto max-w-7xl px-4 pb-16 pt-6 sm:px-8 lg:pt-10">
      <nav class="mb-5 text-sm text-warm-soft" aria-label="Breadcrumb">
        <a class="underline-offset-4 hover:underline" href={routes.shop}>Shop</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span>2027 Family Wall Calendar</span>
      </nav>

      <div class="product-grid">
        <section aria-label="Product photos and video" class="min-w-0">
          <div class="gallery-layout">
            <div class="thumbnail-strip" role="group" aria-label="Choose a product photo or video">
              {media.map((item, i) => (
                <button type="button" class="gallery-thumb" data-gallery-thumb={i} aria-label={item.kind === 'video' ? 'Play product video' : `View product image ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}>
                  {item.kind === 'image' ? (
                    <img src={item.src} alt="" loading="lazy" width="72" height="90" />
                  ) : (
                    <span class="video-thumb"><span aria-hidden="true">▶</span><span>Video</span></span>
                  )}
                </button>
              ))}
            </div>
            <div class="min-w-0">
              <div class="gallery-stage" id="scheduler-gallery" aria-live="off">
                {media.map((item, i) => (
                  <div class="gallery-slide" data-gallery-slide={i} hidden={i !== 0}>
                    {item.kind === 'image' ? (
                      <button type="button" class="gallery-zoom" data-gallery-zoom={i} aria-label={`Enlarge image ${i + 1}`}>
                        <img src={item.src} alt={item.alt} width="1588" height="1588" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
                        <span class="zoom-hint">Click to enlarge</span>
                      </button>
                    ) : (
                      <video class="product-video" data-gallery-video controls playsinline preload="metadata" aria-label="2027 calendar product video">
                        <source src={item.src} type="video/mp4" />
                        Your browser does not support this video.
                      </video>
                    )}
                  </div>
                ))}
              </div>
              <div class="mt-3 flex items-center justify-between gap-3 text-sm text-warm-soft">
                <span id="gallery-counter">1 / {media.length} photos &amp; video</span>
                <div class="flex gap-2">
                  <button type="button" class="gallery-arrow" data-gallery-previous aria-label="Previous image">‹</button>
                  <button type="button" class="gallery-arrow" data-gallery-next aria-label="Next image">›</button>
                </div>
              </div>
            </div>
          </div>
          <p class="mt-6 max-w-2xl text-sm leading-6 text-warm-soft">See the monthly layout up close, including the color-coded rows and space for everyone's commitments. Select any photo to enlarge it.</p>
        </section>

        <section class="purchase-column" aria-labelledby="product-title">
          <p class="label text-warm-soft">ORGANIZED MOM COLLECTIVE · 2027 EDITION</p>
          <h1 id="product-title" class="mt-3 font-serif text-[2rem] leading-tight text-warm-ink sm:text-[2.5rem]">Family Wall Calendar 2027</h1>
          <p class="mt-2 text-base text-warm-soft">A large monthly schedule for busy families</p>
          <p class="mt-5 font-serif text-[2rem] text-warm-ink">$30.99</p>
          <p class="mt-1 text-sm text-warm-soft">Printed calendar · Shipping calculated at checkout</p>

          <div class="mt-6 bg-white py-5">
            <p class="font-semibold text-warm-ink">Everyone's plans, in one place.</p>
            <p class="mt-2 text-sm leading-6 text-warm-soft">Give each person or activity a row. See school events, appointments, practices, and the week's to-dos without keeping it all in your head.</p>
            <a href={scheduler.buyUrl ?? routes.shop} aria-disabled={!scheduler.buyUrl} data-cta="scheduler-buy" class="mt-5 flex min-h-14 w-full items-center justify-center rounded-md bg-warm-ink px-5 text-center font-semibold text-white transition-opacity hover:opacity-90">
              {scheduler.buyUrl ? 'Add to Cart · $30.99' : 'Checkout opening soon'}
            </a>
            <p class="mt-3 text-center text-xs text-warm-soft">Secure checkout with Stripe. Delivery options shown before payment.</p>
          </div>

          <div class="mt-9 pt-3">
            <h2 class="font-serif text-2xl text-warm-ink">Highlights</h2>
            <ul class="mt-4 space-y-3">
              {highlights.map((highlight) => (
                <li class="flex gap-3 text-[0.94rem] leading-6 text-warm-ink"><span class="mt-0.5 text-sage-deep" aria-hidden="true">✓</span><span>{highlight}</span></li>
              ))}
            </ul>
          </div>
          <div class="mt-9 pt-3">
            <h2 class="font-serif text-2xl text-warm-ink">Made for a family that shares the plan</h2>
            <p class="mt-3 text-[0.94rem] leading-7 text-warm-soft">Hang it in the kitchen, hallway, or family command center. The five rows make it easy for everyone to find what belongs to them and know what's coming.</p>
          </div>
        </section>
      </div>

      <section class="mt-16 pt-12" aria-labelledby="details-title">
        <div class="grid gap-12 lg:grid-cols-[1fr_1fr]">
          <div>
            <p class="label text-warm-soft">THE DETAILS</p>
            <h2 id="details-title" class="mt-3 font-serif text-[2rem] text-warm-ink">A year your whole family can see</h2>
            <p class="mt-5 leading-7 text-warm-soft">Start January 2027 with one place to track the rhythms of everyday family life. Each month has five planning rows and to-do checklists beside the weeks, so family members can see their own responsibilities.</p>
            <p class="mt-4 leading-7 text-warm-soft">The calendar includes a cover and twelve monthly planning pages. It uses a Monday-through-Sunday layout, with the full month visible at a glance.</p>
          </div>
          <div class="space-y-3">
            {faq.map((item) => (
              <details class="rounded-md bg-[#FBF7F1] px-5 py-4">
                <summary class="cursor-pointer font-semibold text-warm-ink">{item.title}</summary>
                <p class="mt-3 text-sm leading-6 text-warm-soft">{item.body}</p>
              </details>
            ))}
            <div class="rounded-md border border-warm-rule bg-paper px-5 py-4">
              <p class="font-semibold text-warm-ink">Shipping and returns</p>
              <p class="mt-3 text-sm leading-6 text-warm-soft">Shipping options and costs are shown before payment. Review our <a class="underline underline-offset-2" href="/returns/">return policy</a> or <a class="underline underline-offset-2" href="/support/">contact us</a> with questions.</p>
            </div>
          </div>
        </div>
      </section>
      <section class="mt-16 rounded-xl bg-sage-wash px-6 py-10 text-center sm:px-12">
        <h2 class="font-serif text-[2rem] text-warm-ink">Make the family plan visible.</h2>
        <p class="mx-auto mt-3 max-w-xl text-warm-soft">Twelve monthly pages. Five planning rows. One shared place for what's next.</p>
        <a href={scheduler.buyUrl ?? routes.shop} data-cta="scheduler-bottom" class="mt-6 inline-flex min-h-14 items-center justify-center rounded-md bg-warm-ink px-8 font-semibold text-white">{scheduler.buyUrl ? 'Get the 2027 Calendar · $30.99' : 'Checkout opening soon'}</a>
        <p class="mt-5 text-sm text-warm-soft">Prefer a weekly layout with meals and cleaning? <a class="underline underline-offset-2" href={routes.calendar}>See our weekly Family Wall Calendar.</a></p>
      </section>
    </div>
  </div>

  <dialog id="calendar-lightbox" class="calendar-lightbox" aria-label="Enlarged calendar image">
    <form method="dialog" class="lightbox-close"><button type="submit" aria-label="Close enlarged image">✕</button></form>
    <img id="calendar-lightbox-image" src={photos[0].file ? root + photos[0].file : ''} alt="Enlarged calendar product image" />
  </dialog>
  <script>
    const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
    const video = document.querySelector<HTMLVideoElement>('[data-gallery-video]');
    const count = document.querySelector<HTMLElement>('#gallery-counter');
    const dialog = document.querySelector<HTMLDialogElement>('#calendar-lightbox');
    const full = document.querySelector<HTMLImageElement>('#calendar-lightbox-image');
    let current = 0;
    function show(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => { slide.hidden = i !== current; });
      thumbs.forEach((thumb, i) => {
        thumb.setAttribute('aria-pressed', String(i === current));
        if (i === current) thumb.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      });
      if (video && current !== slides.length - 1) video.pause();
      if (count) count.textContent = `${current + 1} / ${slides.length} photos & video`;
    }
    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => show(i)));
    document.querySelector('[data-gallery-previous]')?.addEventListener('click', () => show(current - 1));
    document.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1));
    document.querySelectorAll<HTMLButtonElement>('[data-gallery-zoom]').forEach((button) => button.addEventListener('click', () => {
      const img = button.querySelector('img');
      if (!dialog || !full || !img) return;
      full.src = img.src;
      full.alt = img.alt;
      dialog.showModal();
    }));
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  </script>
  <style>
    .product-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:clamp(2rem,5vw,5rem);align-items:start}
    .gallery-layout{display:grid;grid-template-columns:76px minmax(0,1fr);gap:14px;align-items:start}
    .thumbnail-strip{display:flex;flex-direction:column;gap:9px;max-height:690px;overflow-y:auto;scrollbar-width:thin}
    .gallery-thumb{width:70px;height:83px;border:0;border-radius:4px;overflow:hidden;background:#fff;flex:none;transition:opacity .15s;opacity:.72}
    .gallery-thumb[aria-pressed=true]{opacity:1}
    .gallery-thumb:focus-visible,.gallery-arrow:focus-visible,.gallery-zoom:focus-visible{outline:3px solid #545454;outline-offset:2px}
    .gallery-thumb img{width:100%;height:100%;object-fit:cover}
    .video-thumb{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;height:100%;font-size:11px;color:#545454}
    .video-thumb span:first-child{font-size:20px}
    .gallery-stage{background:#fff;border:0;border-radius:0;overflow:hidden;min-height:400px}
    .gallery-slide[hidden]{display:none!important}
    .gallery-slide{height:100%;width:100%}
    .gallery-zoom{position:relative;width:100%;display:block;background:#fff;cursor:zoom-in}
    .gallery-zoom img{width:100%;height:auto;max-height:740px;aspect-ratio:4/5;object-fit:contain}
    .zoom-hint{position:absolute;bottom:14px;right:14px;background:#fffef9e8;padding:6px 10px;font-size:12px;border-radius:6px;color:#545454}
    .product-video{width:100%;aspect-ratio:4/5;background:#191919;object-fit:contain}
    .gallery-arrow{display:grid;place-items:center;width:36px;height:36px;border:0;border-radius:50%;font-size:26px;color:#545454;background:#FBF7F1}
    .purchase-column{position:sticky;top:24px;min-width:0}
    .calendar-lightbox{max-width:min(94vw,1100px);max-height:94vh;border:0;border-radius:10px;padding:44px 12px 12px;background:#fff}
    .calendar-lightbox::backdrop{background:rgba(20,20,20,.8)}
    .calendar-lightbox img{max-height:calc(94vh - 70px);width:auto;max-width:100%;object-fit:contain;margin:auto}
    .lightbox-close{position:absolute;right:12px;top:7px}
    .lightbox-close button{padding:6px 10px;font-size:19px}
    @media(max-width:900px){.product-grid{grid-template-columns:1fr;gap:2rem}.purchase-column{position:static}.gallery-stage{min-height:280px}}
    @media(max-width:620px){.gallery-layout{display:flex;flex-direction:column-reverse;gap:9px}.thumbnail-strip{flex-direction:row;width:100%;max-height:none;overflow-x:auto;padding-bottom:5px}.gallery-thumb{width:60px;height:70px}.gallery-zoom img{max-height:570px;aspect-ratio:4/5}.zoom-hint{display:none}.gallery-stage{width:100%}}
  </style>
</PublicLayout>

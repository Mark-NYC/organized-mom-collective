.meeting-rhythm-head > div:first-child { flex:1; }
.meeting-rhythm-head p:not(.eyebrow) { max-width:620px; line-height:1.5; }
.meeting-clock { flex:0 0 175px; border-radius:100%; width:175px; height:175px; background:#CDDDE1; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; gap:.1rem; transform:rotate(5deg); color:#3D6671; }

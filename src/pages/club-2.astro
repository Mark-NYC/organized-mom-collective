/* Hero: copy left, full-bleed family photo right (as /club). */
.hero{padding-top:28px}
.hero-inner{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);min-height:clamp(540px,43vw,700px)}
.hero-copy{align-self:center;padding:clamp(38px,5.4vw,90px)}
.hero h1{font-size:clamp(2.35rem,3.15vw,3.8rem);line-height:1.1;margin:0 0 20px}
.hero h1 em{color:var(--rose-ink)}
.hero-sub{font:400 clamp(1.3rem,1.75vw,1.65rem)/1.35 Georgia,serif;color:var(--ink);max-width:520px}
.hero-sub em{font-style:italic;color:var(--sage-ink)}
.hero-seam-badge{position:absolute;z-index:5;left:50%;top:24px;transform:translateX(-50%);display:flex;align-items:center;justify-content:center;width:124px;height:124px;padding:7px;border-radius:50%;background:var(--gray);pointer-events:none}
.hero-seam-badge img{width:66.6667%;height:66.6667%;object-fit:contain;border-radius:50%}
.hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:28px}
.hero-actions .primary{min-height:58px;padding:17px 30px;font-size:1rem}
.hero-rating{display:flex;flex-wrap:wrap;align-items:center;gap:8px 13px;margin-top:16px}
.hero-rating img{width:clamp(130px,12.67vw,159px);height:auto;display:block}
.hero-rating span{font-size:.69rem;color:var(--muted)}
.hero-photo{position:relative;margin:0;overflow:hidden}
.hero-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}

/* Problem: the mental load, then the turn to shared thinking. */
.problem{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(32px,6vw,96px);align-items:end;padding-top:clamp(56px,7vw,100px);padding-bottom:clamp(56px,7vw,96px)}
.problem h2{margin-bottom:20px}
.problem-copy>p:last-child{font-size:1.05rem;line-height:1.75;color:var(--muted);max-width:560px}
.problem-turn{border-top:1px solid var(--rose);padding-top:24px}
.problem-big{font:400 clamp(1.4rem,2.1vw,1.9rem)/1.3 Georgia,serif;margin-bottom:16px!important}
.problem-big em{color:var(--rose-ink)}
.problem-turn>p:last-child{line-height:1.75;color:var(--muted)}

/* Product introduction: real monthly tools laid out like prints on a table. */
.product-intro{padding-bottom:clamp(48px,6vw,88px)}
.intro-head{max-width:860px;text-align:center}
.intro-head h2{margin-bottom:16px}
.intro-head>p:last-child{font-size:1.02rem;line-height:1.7;color:var(--muted);max-width:720px;margin-inline:auto}
.intro-spread{list-style:none;display:flex;justify-content:center;max-width:1360px;margin:36px auto 0;padding:clamp(28px,3vw,44px) clamp(16px,3vw,48px) clamp(20px,2.4vw,32px);background:#f6f3ee}
.intro-item{flex:1 1 0;min-width:0;margin:0 -1.4%;text-align:center;position:relative}
.intro-open{position:absolute;inset:0;z-index:2;width:100%;border:0;background:transparent;cursor:zoom-in}
.intro-open:focus-visible{outline:3px solid #6f8f6a;outline-offset:2px}
.intro-item:hover .intro-label{text-decoration:underline;text-underline-offset:4px}
.intro-pic{display:block}
.intro-item img{display:block;width:100%;height:auto;aspect-ratio:1;mix-blend-mode:multiply}
.intro-item:nth-child(1) img{transform:rotate(-2.5deg) translateY(14px) scale(1.1)}
.intro-item:nth-child(2) img{transform:rotate(1.5deg) scale(1.1)}
.intro-item:nth-child(3) img{transform:rotate(-1deg) translateY(20px) scale(1.1)}
.intro-item:nth-child(4) img{transform:rotate(2deg) translateY(4px) scale(1.1)}
.intro-item:nth-child(5) img{transform:rotate(-1.8deg) translateY(12px) scale(1.1)}
.intro-month{margin-top:10px!important}
.intro-month span{display:inline-block;padding:4px 10px;font-size:.6rem;font-weight:750;letter-spacing:.1em;text-transform:uppercase;color:#354f42}
.intro-label{font:400 clamp(1.05rem,1.35vw,1.3rem)/1.3 Georgia,serif;color:var(--ink);margin:8px auto 0!important;max-width:15ch}
.intro-swipe{display:none}
.intro-bridge{text-wrap:balance;max-width:820px;margin:34px auto 0!important;padding-inline:24px;text-align:center;font:400 clamp(1.5rem,2.3vw,2.1rem)/1.3 Georgia,serif;color:var(--ink)}
.intro-bridge em{color:var(--rose-ink)}
.intro-spread:focus-visible{outline:3px solid #6f8f6a;outline-offset:-3px}

/* Hero: what the membership includes, in one compact line. */
.hero-includes{list-style:none;margin:16px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.76rem;font-weight:700;color:#526b54}
.hero-includes li{display:flex;align-items:center;gap:7px}
.hero-includes li::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--rose)}

/* The demo: three families, the phone Family Meeting plan beside the real May page (side by side, locked in). */
.demo{padding-top:0}
.demo-surface{position:relative;padding:clamp(40px,5vw,80px) clamp(18px,4vw,64px) clamp(32px,4vw,56px)}
.demo-head{max-width:820px;margin:0 auto;text-align:center}
.demo-head h2{margin-bottom:16px}
.demo-head>p:not(.eyebrow){font-size:1.02rem;line-height:1.7;color:var(--muted)}
.demo-head>p.demo-sub{font:400 clamp(1.3rem,1.8vw,1.6rem)/1.35 Georgia,serif;color:var(--ink)}
.tabs-label{margin:30px auto 10px!important;text-align:center;font-size:.68rem;font-weight:750;letter-spacing:.11em;text-transform:uppercase;color:var(--muted)}
.family-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;max-width:820px;margin:0 auto 36px}
.family-tabs button{display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:12px;align-items:center;text-align:left;min-height:64px;padding:12px 16px;border:1px solid #d9d9d4;border-radius:2px;background:#fff;color:var(--ink);font:inherit;cursor:pointer;transition:border-color .15s,box-shadow .15s}
.family-tabs button:hover{border-color:#9aab8f}
.family-tabs button[aria-selected=true]{border-color:var(--dark);box-shadow:inset 0 -3px 0 var(--dark)}
.tab-dots{grid-row:1/3;display:flex}
.tab-dots i{width:12px;height:12px;border-radius:50%;border:2px solid #fff;margin-left:-4px}
.tab-dots i:first-child{margin-left:0}
.family-tabs strong{font-size:.88rem}
.family-tabs small{font-size:.72rem;color:var(--muted)}
.family-panel{display:grid;grid-template-columns:1fr;gap:44px;max-width:1180px;margin:0 auto}
.family-panel:not([hidden]){animation:panel-in .35s ease-out}
@keyframes panel-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

.stage{min-width:0;display:grid;grid-template-columns:minmax(250px,320px) minmax(0,640px);grid-template-areas:"plabel slabel" "phone sheet";justify-content:center;align-items:center;column-gap:clamp(36px,5.5vw,96px);row-gap:20px}
.stage-label{align-self:end;justify-self:center;display:flex;align-items:center;gap:10px;font-size:1rem;font-weight:750;color:var(--ink)}
.stage-label b{display:inline-grid;place-items:center;flex:none;width:28px;height:28px;border-radius:50%;background:#dfe7d8;color:#3f5a40;font-size:.8rem}
.stage-label-plan{grid-area:plabel}
.stage-label-print{grid-area:slabel}
.demo-included{display:flex;align-items:center;justify-content:center;margin:-16px auto 0!important;font-size:.92rem;font-weight:700;color:var(--ink)}
.sheet{grid-area:sheet;container-type:inline-size;width:100%;max-width:640px;background:#fff;border:1px solid #e2e7df;box-shadow:0 2px 4px #0000000a,0 24px 50px -20px #3c463540;padding:clamp(14px,4.4%,38px) clamp(14px,5.6%,48px) clamp(10px,2.8%,23px);color:#464e44;display:flex;flex-direction:column}
.sheet-head{background:#e4eddc;border-top:max(5px,1.1cqw) solid #cbdcbf;padding:2.4cqw 3.4cqw 2.6cqw}
.sheet-head>span{font-size:clamp(7px,1.25cqw,10px);letter-spacing:.15em;font-weight:700;color:#526849}
.sheet-head h3{font:400 clamp(26px,6.1cqw,50px)/1.1 Georgia,serif;color:#3f5a40;margin:1.2cqw 0 .8cqw;letter-spacing:-.01em}
.sheet-head h3 em{font-style:normal}
.sheet-head p{font:italic clamp(12px,2.1cqw,17px) Georgia,serif;color:#587052}
.sheet-family{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:4px 12px;margin:2.3cqw 0 1.5cqw;font-size:clamp(8px,1.25cqw,10px);font-weight:700;letter-spacing:.12em;color:#687866}
.sheet-people{display:flex;flex-wrap:wrap;gap:3px 10px;letter-spacing:.04em}
.sheet-people span,.sheet-name{display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.sheet-people i,.sheet-name i{width:clamp(7px,1.1cqw,9px);height:clamp(7px,1.1cqw,9px);border-radius:50%;flex:none}
.sheet-name{font-weight:700;color:#4d564b}
.sheet-rows{display:flex;flex-direction:column;gap:max(5px,1cqw)}
.sheet-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:max(8px,1.5cqw);min-height:max(50px,10.5cqw);padding:.6cqw 2cqw .6cqw .9cqw;border:1px solid #e4e8e0;border-radius:max(6px,1.1cqw);background:linear-gradient(90deg,var(--tint) 0%,#fff 88%)}
.sheet-icon{width:max(38px,8.6cqw);height:max(38px,8.6cqw);border-radius:max(5px,1cqw);background:var(--tint);display:flex;align-items:center;justify-content:center}
.sheet-icon img{width:86%;height:86%;object-fit:contain;mix-blend-mode:multiply}
.sheet-copy{min-width:0}
.sheet-copy strong{display:block;font:400 clamp(14px,2.9cqw,24px)/1.1 Georgia,serif;color:#455644;margin-bottom:.6cqw}
.sheet-copy>span{display:block;font-size:clamp(10.5px,1.95cqw,13px);line-height:1.45;color:#5d685b}
.sheet-time{font-size:clamp(15px,3.6cqw,29px);font-weight:800;letter-spacing:-.05em;color:#577350;font-variant-numeric:tabular-nums;text-align:right}
.sheet-rule{background:#edf3e9;border-radius:max(5px,.9cqw);margin-top:2cqw;padding:1.8cqw;text-align:center}
.sheet-rule span{display:block;font-size:clamp(7px,1.1cqw,9px);letter-spacing:.13em;font-weight:700;color:#687c61}
.sheet-rule strong{display:block;font:400 clamp(14px,2.7cqw,22px) Georgia,serif;color:#3e5e3f;margin:.6cqw 0}
.sheet-rule p{font-size:clamp(9px,1.35cqw,11px);color:#647960}
.sheet-foot{display:flex;justify-content:space-between;border-top:1px solid #dfe6dc;margin-top:2.4cqw;padding-top:1.1cqw;font-size:clamp(7px,1.1cqw,9px);letter-spacing:.1em;font-weight:700;color:#687964}

.phone{grid-area:phone;position:relative;justify-self:center;width:100%;max-width:320px;height:clamp(600px,50vw,730px);padding:10px;border-radius:44px;background:linear-gradient(145deg,#3a3a3c,#1c1c1e 40%,#2c2c2e);box-shadow:0 0 0 1.5px #545456,0 30px 60px -18px #1f2a2080,0 12px 24px -12px #00000059}
.phone::before,.phone::after{content:"";position:absolute;width:3px;border-radius:2px;background:#2c2c2e}
.phone::before{left:-3px;top:110px;height:54px;box-shadow:0 70px 0 #2c2c2e}
.phone::after{right:-3px;top:150px;height:80px}
.phone-screen{position:relative;height:100%;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:none;border-radius:35px;background:#fbfaf7;padding:0 16px 34px;color:#433c3b;-webkit-mask-image:linear-gradient(#000 calc(100% - 34px),transparent);mask-image:linear-gradient(#000 calc(100% - 34px),transparent)}
.phone-screen::-webkit-scrollbar{display:none}
.phone-status{position:sticky;top:0;z-index:1;display:flex;justify-content:space-between;align-items:center;margin:0 -16px 6px;padding:12px 22px 8px;background:#fbfaf7;font-size:11px;font-weight:700}
.phone-island{width:76px;height:22px;border-radius:12px;background:#111}
.phone-icons{display:flex;gap:3px;align-items:flex-end}
.phone-icons i{width:3px;background:#433c3b;border-radius:1px}
.phone-icons i:nth-child(1){height:5px}.phone-icons i:nth-child(2){height:8px}.phone-icons i:nth-child(3){width:16px;height:8px;border-radius:2px;margin-left:3px}
.phone-kicker{font-size:8.5px;font-weight:800;letter-spacing:.14em;color:var(--rose-ink)}
.phone-screen h3{font-size:23px;margin:4px 0 9px;color:#3e3736}
.phone-people{list-style:none;margin:0 0 10px;padding:0;display:flex;flex-wrap:wrap;gap:5px}
.phone-people li{display:inline-flex;align-items:center;gap:5px;padding:3px 8px 3px 6px;border:1px solid #e4e0da;border-radius:20px;background:#fff;font-size:10.5px;font-weight:650}
.phone-people i,.phone-parts i{width:9px;height:9px;border-radius:50%;flex:none}
.phone-adults i{background:#fff;border:1.5px solid #8a8580}
.phone-card{background:#fff;border:1px solid #ece8e2;border-radius:10px;padding:9px 11px;margin-bottom:7px}
.phone-card>span{display:block;font-size:8px;font-weight:800;letter-spacing:.13em;color:#7a8d74;margin-bottom:4px}
.phone-card p{font-size:11.5px;line-height:1.45}
.phone-goal{background:#eef4ea;border-color:#dce7d6}
.phone-goal strong{display:block;font:400 15px/1.25 Georgia,serif;color:#3f5a40;margin-bottom:2px}
.phone-parts{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.phone-parts li{display:grid;grid-template-columns:9px 1fr;gap:7px;align-items:start}
.phone-parts i{margin-top:4px}
.phone-parts p{font-size:11px;line-height:1.42}
.phone-parts b{font-weight:750;margin-right:2px}
.phone-talk p{font:italic 12.5px/1.4 Georgia,serif;color:#4d4544}
.phone-review{display:flex;gap:6px;margin-top:9px}
.phone-review span{flex:1;text-align:center;font-size:10px;font-weight:750;padding:8px 4px;border:1px solid #d6d2cc;border-radius:6px;background:#fff}
.phone-review .phone-approve{background:var(--lime);border-color:var(--lime);color:#2f4630}

.why .eyebrow{color:var(--sage-ink)}
.why{max-width:1040px;width:100%;margin:0 auto}
.why .eyebrow{text-align:center}
.why ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 40px}
.why ul li{display:grid;gap:3px;align-content:start;padding:14px 0;border-top:1px solid #d6d6d0}
.why ul li b{font:400 1.2rem/1.25 Georgia,serif;color:var(--ink)}
.why ul li span{font-size:.88rem;line-height:1.55;color:var(--muted)}
.why ul li span::before{content:"→ ";color:var(--rose)}
.demo-disclaimer{max-width:760px;margin:32px auto 0!important;text-align:center;font-size:.72rem;line-height:1.5;color:var(--muted)}

/* How it works */
.how{padding-top:clamp(56px,7vw,100px);padding-bottom:clamp(56px,7vw,96px)}
.how h2{max-width:820px}
.steps{list-style:none;margin:40px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:34px}
.steps li{display:flex;flex-direction:column}
.steps b{font:italic 1.8rem Georgia,serif;color:var(--sage-ink);margin-top:18px}
.steps h3{margin:6px 0 6px;font-size:clamp(1.4rem,1.8vw,1.7rem)}
.steps p{line-height:1.6;color:var(--muted)}
.step-visual{height:190px;background:var(--gray);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:18px;overflow:hidden}
.sv-kicker{font-size:.6rem;font-weight:800;letter-spacing:.13em;color:#7a8d74}
.sv-chip{display:inline-flex;align-items:center;gap:6px;padding:4px 11px 4px 8px;border:1px solid #e4e0da;border-radius:20px;background:#fff;font-size:.78rem;font-weight:650}
.sv-chip i{width:9px;height:9px;border-radius:50%}
.sv-tags{display:flex;gap:6px;margin-top:4px}
.sv-tags span{font-size:.66rem;font-weight:700;padding:3px 8px;background:#e4e8df;color:#4d5a4b}
.step-review strong{display:block;max-width:240px;padding:12px 16px;background:#eef4ea;border:1px solid #dce7d6;border-radius:8px;font:400 1.15rem/1.25 Georgia,serif;color:#3f5a40;text-align:center}
.sv-buttons{display:flex;gap:6px}
.sv-buttons span{font-size:.72rem;font-weight:750;padding:7px 14px;border:1px solid #d6d2cc;border-radius:6px;background:#fff}
.sv-buttons .sv-keep{background:var(--lime);border-color:var(--lime);color:#2f4630}
.step-mail{padding:0;background:#f6f3ee}
.step-mail{justify-content:flex-start}
.step-mail img{width:86%;height:auto;margin-top:6%;mix-blend-mode:multiply;transform:rotate(-2deg)}

/* What changes (inside How it works) */
.change-title{margin-top:clamp(56px,7vw,88px)!important;font-size:clamp(1.9rem,2.8vw,2.8rem)}
.change-title em{font-style:italic;color:var(--sage-ink)}
.change-table{margin-top:22px;border-top:1px solid var(--line)}
.change-table>div{display:grid;grid-template-columns:180px minmax(0,1fr) minmax(0,1fr);gap:24px;padding:18px 0;border-bottom:1px solid var(--line);align-items:baseline}
.change-head{font-size:.68rem;letter-spacing:.11em;font-weight:750;text-transform:uppercase;color:var(--muted)}
.change-head span:last-child{color:var(--sage-ink)}
.change-table b{font-size:.8rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ink)}
.change-table span[role=cell]:nth-child(2){color:var(--muted)}
.change-table span[role=cell]:nth-child(3){font:400 1.25rem/1.35 Georgia,serif;color:var(--ink)}
.change-note{margin-top:20px!important;font-size:.88rem;color:var(--muted)}

/* Monthly resources gallery and its full-screen previews */
.kit-gallery{padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(48px,6vw,88px);text-align:center}
.kit-gallery h2{max-width:850px;margin-inline:auto}
.kit-gallery-intro{max-width:720px;margin:16px auto 30px!important;color:var(--muted);line-height:1.7}
.kit-gallery-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:26px 14px}
.kit-gallery-item{position:relative;margin:0;min-width:0;display:flex;flex-direction:column}
.kit-gallery-item img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:contain}
.kit-gallery-item figcaption{padding:10px 4px 0}
.kit-gallery-month{display:inline-block;padding:5px 10px;font-size:.62rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#354f42}
.kit-gallery-item h3{margin:9px 0 0;font-size:clamp(.98rem,1.2vw,1.15rem);line-height:1.3;color:#303030}
.kit-gallery-open{position:absolute;inset:0;z-index:1;width:100%;border:0;background:transparent;cursor:zoom-in;border-radius:4px}
.kit-gallery-open:focus-visible{outline:3px solid #354f42;outline-offset:5px}
.kit-gallery-zoom{position:absolute;top:8px;right:8px;background:#fff;padding:4px 7px;border:1px solid #ddd;color:var(--dark);font-size:.62rem;border-radius:2px}
.kit-show-all{display:none}
.kit-gallery-note{margin:28px auto 0!important;font-size:.76rem;color:var(--muted)}
.kit-fullscreen{position:fixed;inset:0;width:100%;max-width:none;height:100dvh;max-height:none;margin:0;padding:0;border:0;background:#fff;color:#303030;overflow-y:auto;overscroll-behavior:contain}
.kit-fullscreen::backdrop{background:#fff}
.kit-fullscreen-close{position:fixed;top:max(14px,env(safe-area-inset-top));right:max(18px,env(safe-area-inset-right));z-index:2;display:grid;place-items:center;width:48px;height:48px;border:1px solid #ddd;border-radius:50%;background:#fff;color:#303030;font:32px/1 Arial,sans-serif;cursor:pointer}
.kit-fullscreen-content{max-width:880px;margin:0 auto;padding:76px 24px 56px;text-align:center}
.kit-fullscreen-month{display:inline-block;padding:7px 15px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#354f42}
.kit-fullscreen h2{font:400 clamp(1.65rem,4vw,2.5rem)/1.2 Georgia,serif;margin:18px auto 12px;max-width:740px}
.kit-image-stage{min-width:0;position:relative}
.kit-fullscreen-image{display:block;width:100%;max-width:760px;height:auto;margin:0 auto;object-fit:contain}
.kit-zoom-hint{display:none}
.kit-fullscreen-copy{max-width:620px;margin:24px auto 0;text-align:left;font-size:1rem;line-height:1.75;color:var(--dark)}
.kit-personal{margin-top:28px;padding:clamp(22px,4vw,32px);background:var(--kit-tint);border-top:3px solid var(--kit-accent);border-radius:3px}
.kit-fullscreen-copy .kit-personal h3{margin:0 0 22px;font-size:clamp(1.5rem,3vw,1.85rem);line-height:1.2}
.kit-personal h3 span{color:#62665e}
.kit-personal-benefits{margin:0;display:grid;gap:14px}
.kit-personal-benefits div{display:grid;grid-template-columns:112px 1fr;gap:14px;font-size:.9rem;line-height:1.5}
.kit-personal-benefits dt{font-weight:700;color:#303030}
.kit-personal-benefits dd{margin:0}

---
import PublicLayout from '../layouts/PublicLayout.astro';
import { BRAND_NAME } from '../config';
import { monthColors } from '../theme';
import { clubEnabled, CLUB_OFFER, CLUB_PROGRAM_START, clubFoundingOpen } from '../data/club/config';
import { MARKER_COLORS } from '../data/club/family-colors';
import { carouselPreviews } from '../data/club/carousel-previews';
import { clubCheckoutEnabled } from '../lib/club/membership';
import clubHeroUrl from '../../assets/icons/ofc/hero-family-pointing.jpeg?url';
const clubBadgeUrl = '/images/club/family-meeting-club-circle-logo.webp';
const monthIcons = import.meta.glob('../../assets/icons/ofc/month-icons/*-OFC-icon.png', { eager: true, query: '?url', import: 'default' });
// Enrollment shows only with PUBLIC_CLUB_ENABLED and PUBLIC_CLUB_CHECKOUT_ENABLED: the offer button opens Stripe
// Checkout directly (club-billing); the server still decides whether anyone can pay. Off, it asks about early access.
const joinOpen = clubEnabled() && (clubCheckoutEnabled() || Boolean(import.meta.env.DEV));
// Built before the 2027 program starts: the founding member's free January and her February 1 first charge.
const founding = clubFoundingOpen();
const months = [{"month":"January","title":"Stop Being the Family's Calendar","responsibility":"Planning together","how":"A personalized weekly family meeting helps everyone look ahead, prepare, and own their part.","url":"/app/club/january/?sample=rivera"},{"month":"February","title":"Laundry That Isn't All on You","responsibility":"Caring for their own things","how":"A picture laundry guide for each child, matched to their age: My Clothes, My Job or I Can Do My Own Laundry.","url":"/app/club/february/"},{"month":"March","title":"Chores Without Chasing Everyone","responsibility":"Finishing a job","how":"Each person gets a clear cleaning job, supplies, steps, and a definition of done.","url":"/club/march-preview/"},{"month":"April","title":"Dinner Isn't All on You","responsibility":"Sharing meal ownership","how":"A prepared dinner plan gives family members roles from gathering ingredients through cleanup.","url":"/club/april-preview/"},{"month":"May","title":"Summer Days Without Constant Questions","responsibility":"Managing their day","how":"A flexible daily rhythm and activity menu help kids choose what comes next.","url":"/club/may-preview/"},{"month":"June","title":"Snack Time Without Calling Mom","responsibility":"Respecting shared boundaries","how":"An age-appropriate picture guide helps kids choose and prepare a snack without calling Mom.","url":"/club/june-preview/"},{"month":"July","title":"Less ‘I’m Bored.’ More Independent Play.","responsibility":"Preparing independently","how":"A ready-to-use activity menu gives kids ideas they can pick and start themselves.","url":"/club/july-preview/"},{"month":"August","title":"Back to School Without the Scramble","responsibility":"Taking initiative","how":"A personalized countdown gives everyone their own school-ready responsibilities.","url":"/club/august-preview/"},{"month":"September","title":"School Routines Without the Nagging","responsibility":"Building independent routines","how":"Personalized habit reminder cards help kids practice one small school-day responsibility without constant reminders.","url":"/app/club/september/?sample=rivera"},{"month":"October","title":"Less Asking. More Doing.","responsibility":"Caring for shared spaces","how":"A daily reset with one familiar cue, picture jobs and a clear finish line kids can recognize.","url":"/club/october-preview/"},{"month":"November","title":"Stop Being Everyone's Reminder","responsibility":"Owning a whole responsibility","how":"Each ready family member gets a job with a clear owner, timing, and finish line.","url":"/club/worksheet-generator/"},{"month":"December","title":"Raise Kids Who Love to Give","responsibility":"Being a blessing to others","how":"Two cards give kids space to draw a picture, write a poem, or share a letter, then send it to someone like a grandparent or teacher.","url":"/club/december-preview/"}].map(m => ({...m, icon: monthIcons[`../../assets/icons/ofc/month-icons/${m.month === 'January' ? 'September' : m.month === 'September' ? 'January' : m.month}-OFC-icon.png`]}));

const kitImages = import.meta.glob('../../assets/icons/ofc/monthly-kits/*.webp', { eager: true, query: '?url', import: 'default' });
const kitPreviews = [
 ['January', 'September', 'Weekly family meeting'],
 ['February', 'February', 'Family laundry guides'],
 ['March', 'March', 'Family chore charts'],
 ['April', 'April', 'Dinner responsibilities'],
 ['May', 'May', 'Summer day rhythm'],
 ['June', 'June', 'Independent snack choices'],
 ['July', 'July', 'Ideas for independent play'],
 ['August', 'July (2)', 'School-day rhythm'],
 ['September', 'January', 'Personalized family habit cards'],
 ['October', 'October', 'Daily family reset'],
 ['December', 'December', 'Two kindness cards for drawings, poems, or letters'],
].map(([month, file, description]) => ({ month, description, title: months.find(m => m.month === month)!.title, color: monthColors.find(m => m.name === month)!.hex, image: kitImages[`../../assets/icons/ofc/monthly-kits/${file}.webp`] as string }));

const kitDetails: Record<string, { relief: string; example: string }> = {
 January: { relief: "You shouldn't have to keep the whole family's week in your head. A shared calendar and a weekly family meeting give everyone a place to see the plan and prepare together.", example: "For example: each child sees their own activities and what they need to get ready for the week." },
 February: { relief: "Laundry doesn't have to begin and end with you. Picture guides give kids a clear part of the process they can learn to handle themselves.", example: "For example: your younger child sorts clothes; an older child follows the steps to run a load." },
 March: { relief: "Spend less time chasing people through their chores. A shared chart makes assignments visible, while the cleaning plan explains the steps and what finished looks like.", example: "For example: your 5-year-old puts toys in a basket; your 10-year-old clears and wipes the table." },
 April: { relief: "Dinner takes more than cooking. This plan shares the preparation and cleanup so you aren't the only person thinking through what needs doing.", example: "For example: one child sets out napkins; an older child prepares a simple side. Everyone sees their part." },
 May: { relief: "When school structure disappears, you shouldn't have to invent the next activity all day. A flexible summer rhythm gives kids a familiar plan to check.", example: "For example: younger kids get a supported play block; older kids choose an activity they can start themselves." },
 June: { relief: "Fewer calls of 'Mom, can I have a snack?' A simple picture guide helps kids choose and prepare snacks they can manage.", example: "For example: a younger child chooses a ready-to-eat snack; an older child follows simple preparation steps." },
 July: { relief: "You don't have to come up with something every time someone says 'I'm bored.' An activity menu gives kids practical ideas to choose and start.", example: "For example: building blocks for one child, a drawing project for another. Ideas they can actually start." },
 August: { relief: "School days run more smoothly when everyone can see what comes next. A clear school-day rhythm helps you spend less time directing every transition.", example: "For example: one child follows picture steps to get ready; another checks their bag and school supplies." },
 September: { relief: "You shouldn't have to repeat the same reminders every morning and night. Small habit cards put one clear next step right where your family needs it.", example: "For example: one child puts their bowl by the sink after breakfast; another packs their bag after getting dressed." },
 October: { relief: "A short daily reset gives everyone a clear way to help care for home. Familiar cues and picture jobs mean less explaining the same tasks over and over.", example: "For example: one child puts toys away; another resets the table. Each has a clear job and finish line." },
 December: { relief: "You want your kids to experience the joy of giving, not just receiving. Two cards give them space to draw a picture, write a poem, or share a letter, then send a little encouragement to someone like a grandparent or teacher.", example: "For example: your younger child draws a picture for Grandma; your older child writes a poem for a teacher. Two simple ways to practice being a blessing." },
};


/*
 * The May demo: three made-up households, each with the Family Meeting plan she reviews on her phone and the printed
 * Our Summer Day page (the real May sheet: src/components/club/MaySummerRhythm.astro) built from the same answers.
 * Person colors are the Club's marker colors, children first (src/data/club/family-colors.ts). Illustrative only:
 * not production output, not customers.
 */
type Kid = { name: string; age: number; part: string };
type Family = {
 id: string; tab: string; family: string; summary: string; kids: Kid[];
 challenge: string; goal: string; goalNote: string; adults: string; talk: string;
 why: [string, string][]; dayLabel: string; rule: [string, string];
 rows: [string, string][];
};
const families: Family[] = [
 {
  id: 'parkers', tab: 'Younger kids', family: 'The Parker Family', summary: '2 kids · ages 4 & 7',
  kids: [
   { name: 'Emma', age: 4, part: 'Picks a play bin with help, then puts it back at Snack & Reset.' },
   { name: 'Noah', age: 7, part: 'Checks the page after breakfast and starts Move & Play on his own.' },
  ],
  challenge: 'School just ended. Emma still naps, and both kids ask Mom what’s next every hour.',
  goal: 'Picture cues before questions', goalNote: 'Kids look at the page first. Mom answers less.',
  adults: 'Dad runs Morning Start on his work-from-home days.',
  talk: 'Which part of the morning could someone else lead?',
  why: [['Ages 4 and 7', 'Pictures and supported play, not a list to read.'], ['Emma still naps', 'Quiet Time is built around her rest.'], ['Dad works from home twice a week', 'He owns Morning Start on those days.']],
  dayLabel: 'A DAY AT HOME', rule: ['Look at the pictures before asking Mom.', 'Our plans can change. We can still find what’s next.'],
  rows: [['7:30', 'Breakfast · get dressed · shoes by the door'], ['9:00', 'Emma: sandbox · Noah: bike loop'], ['10:30', 'Emma: play-dough bin · Noah: Lego build'], ['12:00', 'Noah clears plates · Emma wipes her spot'], ['1:00', 'Emma naps · Noah reads or listens'], ['2:30', 'Park, sprinkler or library'], ['4:00', 'Pick a snack · toys back in bins']],
 },
 {
  id: 'riveras', tab: 'Three busy kids', family: 'The Rivera Family', summary: '3 kids · ages 6, 9 & 12',
  kids: [
   { name: 'Mia', age: 6, part: 'Resets the toy corner at Snack & Reset.' },
   { name: 'Lucas', age: 9, part: 'Clears lunch and packs his soccer bag the night before.' },
   { name: 'Sofia', age: 12, part: 'Reads out the week’s activities at the Family Meeting.' },
  ],
  challenge: 'Camp, soccer and dance mean three schedules, and Mom is the only one tracking all of them.',
  goal: 'One rhythm for home days', goalNote: 'Everyone checks it before asking Mom what’s next.',
  adults: 'Dad owns Tuesday and Thursday pickups. Mom stops being the only one who knows the schedule.',
  talk: 'What should we check before asking Mom?',
  why: [['Three activity schedules', 'Home days share the same anchors, so camp days don’t break the rhythm.'], ['Sofia is 12', 'She owns a planning job, not just a chore.'], ['Two parents driving', 'Pickups get a named owner.']],
  dayLabel: 'HOME DAYS', rule: ['Check the rhythm before asking Mom.', 'Our plans can change. We can still find what’s next.'],
  rows: [['7:30', 'Breakfast · Lucas & Sofia: gear check'], ['9:00', 'Camp days: camp · home days: outside'], ['10:30', 'Mia: art · Lucas: build · Sofia: read'], ['12:00', 'Lucas clears · Mia wipes the table'], ['1:00', 'Read, draw or rest'], ['2:00', 'Soccer Tue & Thu · dance Wed'], ['4:30', 'Mia: toys · Lucas: table · Sofia: bags']],
 },
 {
  id: 'johnsons', tab: 'Mixed ages', family: 'The Johnson Family', summary: '5 kids · ages 3 to 16',
  kids: [
   { name: 'Ava', age: 3, part: 'Carries her plate to the counter with a grown-up.' },
   { name: 'Ben', age: 6, part: 'Feeds the dog after breakfast.' },
   { name: 'Chloe', age: 9, part: 'Leads the ten-minute tidy at Snack & Reset.' },
   { name: 'Eli', age: 13, part: 'Plans his own afternoon and shares it on Sunday.' },
   { name: 'Grace', age: 16, part: 'Adds her work shifts to the plan herself.' },
  ],
  challenge: 'Naps, teen jobs and five different summers. Mom fields reminders all day.',
  goal: 'Two tracks, one family plan', goalNote: 'The younger three share anchors. The teens plan their own afternoons.',
  adults: 'Dad leads the Sunday Family Meeting. Mom takes the little-kid mornings.',
  talk: 'What can we simplify so this works for all seven of us?',
  why: [['Five kids, ages 3 to 16', 'Shared anchors for the younger three; the teens plan their own blocks.'], ['Ava still naps', 'Quiet Time protects it.'], ['Grace has a summer job', 'Her shifts go on the plan, not in Mom’s head.']],
  dayLabel: 'A FULL HOUSE', rule: ['Check the rhythm, then do your part.', 'Our plans can change. We can still find what’s next.'],
  rows: [['8:00', 'Breakfast together · teens self-start'], ['9:30', 'Ava & Ben: backyard · Chloe: bike'], ['11:00', 'Ben: blocks · Chloe: art · Eli: project'], ['12:00', 'Ava carries plates · Ben & Chloe clear'], ['1:00', 'Ava naps · Ben & Chloe read'], ['2:00', 'Grace: work · Eli: his plan · pool Friday'], ['4:00', 'Chloe leads a ten-minute tidy']],
 },
];
// The May sheet's seven anchors, icons and tints, exactly as the printable draws them.
const blocks = [
 ['Morning Start', 'morning-start', '#F8E8B5'], ['Move & Play', 'move-play', '#F4DEA3'], ['Create & Explore', 'create-explore', '#F0D493'],
 ['Lunch & Reset', 'lunch-reset', '#DDEBDB'], ['Quiet Time', 'quiet-time', '#D1E5D6'], ['Free Afternoon', 'free-afternoon', '#C3DDCF'], ['Snack & Reset', 'lunch-reset', '#E4E9D5'],
];
const colorOf = (f: Family, name: string) => MARKER_COLORS[f.kids.findIndex(k => k.name === name)]?.hex;
// Names on the printed page carry each child's marker dot, the same as on her phone.
const withDots = (f: Family, text: string) => text.split(new RegExp(`\\b(${f.kids.map(k => k.name).join('|')})\\b`)).filter(Boolean).map(part => ({ part, color: colorOf(f, part) }));

const faqs = [
 ['How is this different from printables or a chore chart?', 'A blank printable is one more project: you still decide what goes on it and who does what. We start from what you tell us about your family (names, ages, activities and what’s hard right now) and prepare the plan for you, so it arrives finished.'],
 ['How much time does it take?', 'Look over the prepared plan and change anything that doesn’t fit. Then bring it to your Family Meeting: the guide is built for about ten minutes, once a week.'],
 ['Will this work with young kids?', 'Yes. Younger children get small parts they can do with help, and older kids take on more. Much of the value starts with the grown-ups agreeing on what matters. Independence builds over time, not overnight.'],
 ['What if our family has a different schedule?', 'Your plan starts from your household’s answers, and you can review and adjust it before it prints.'],
 ['Is this another app I need to manage?', 'No. Your family uses the printed plan together. The website is there when you want to review or adjust the next plan.'],
 ['What if we miss a meeting?', 'Just pick it up again next week. This is a family rhythm, not a streak to maintain.'],
 ['Why stay after we learn how to meet?', 'The weekly rhythm stays familiar, but your kids and household keep changing. Each month brings a fresh focus and personalized ideas for the next step.'],
 ['Do I need a printer or your wall calendar?', 'No. The plan arrives printed in the mail, and the Club stands on its own. The calendar helps everyone see the schedule; the Club helps everyone share responsibility.'],
 joinOpen
  ? ['Can I subscribe or cancel right now?', founding
    ? `Yes. Your first month is free: join today and nothing is charged. Your personalized Family Vision welcome print ships before January, and your ${CLUB_PROGRAM_START.label} plan is printed and mailed free. Your first charge is $5.90 on ${CLUB_PROGRAM_START.foundingFirstCharge}, then $5.90 a month, U.S. shipping included. Cancel any time from your account; cancel before ${CLUB_PROGRAM_START.foundingFirstCharge} and you pay nothing.`
    : 'Yes. Your first month is free: join today and nothing is charged. Your first personalized plan is printed and mailed free, and your first charge is $5.90 one month after you join, then $5.90 a month, U.S. shipping included. Cancel any time from your account; cancel before your first charge and you pay nothing.']
  : ['Can I subscribe or cancel right now?', 'Enrollment is not open yet. We are testing print fulfillment and billing. Pricing and cancellation terms will be confirmed before sign-up. You can ask about early access.']
];
const ctaLabel = joinOpen ? 'Start My Free Month' : 'See Club Membership';
// Close-up image dimensions used by the remaining monthly kit gallery modal.
const closeUp = (month: string) => {
 const p = carouselPreviews.find(c => c.month === month)!;
 return { ...p, style: `--r:${(p.height / p.width).toFixed(4)};--mx0:${p.mobile.x0};--mw:${(p.mobile.x1 - p.mobile.x0).toFixed(3)};--my0:${p.mobile.y0}` };
};
---

<PublicLayout fullTitle={`Family Meeting Club · ${BRAND_NAME}`} description="A personalized printed family resource every month, plus a simple weekly meeting guide to help your family do its part." indexable={false} chrome={false} width="full" tracking={false}>
<div class="club">
<header class="ofc-nav">
 <div class="ofc-nav-inner">
  <a class="brand" href="/" aria-label="Organized Mom Collective home">
   <img src="/images/club/family-meeting-club-horizontal-logo.webp" alt="Family Meeting Club by Organized Mom Collective" width="2027" height="570"/>
  </a>
  <nav aria-label="Club navigation"><a href="#what-you-get">What You Get</a><a href="#how-it-works">How It Works</a><a href="#monthly-topics">Monthly Topics</a><a href="#faq">FAQ</a></nav>
  <a class="button nav-cta" href="#offer">{ctaLabel}</a>
 </div>
</header>
<main>
<section class="ofc-hero" id="start">
 <div class="ofc-hero-copy">
  <p class="eyebrow">FAMILY MEETING CLUB</p>
  <h1>Your family shouldn't depend on you <em>for everything.</em></h1>
  <p class="hero-explain">One personalized family resource mailed every month. One simple weekly meeting to help everyone do their part.</p>
  <a class="button hero-cta" href="#offer">{ctaLabel} <span aria-hidden="true">→</span></a>
  <p class="hero-terms">{joinOpen ? 'Your first month is free. $5.90/month after. Cancel anytime.' : 'Enrollment opens soon. $5.90/month is the proposed price.'}</p>
 </div>
 <div class="ofc-hero-visual"><img src={clubHeroUrl} width="1200" height="900" alt="Family gathered around the table with their family plan" loading="eager" fetchpriority="high"/></div>
</section>

<section class="ofc-products" id="what-you-get" aria-labelledby="what-heading">
 <div class="products-surface">
  <h2 id="what-heading">Here's what you get <em>every month.</em></h2>
  <div class="products-grid">
   <article class="product-piece">
    <div class="paper-image"><img src={kitPreviews.find(k => k.month === 'March')!.image} alt="Example of the March family chore chart resource" width="1080" height="1080" loading="lazy"/></div>
    <div class="piece-copy"><span class="pill">A PERSONALIZED FAMILY RESOURCE</span><h3>One problem. One ready-to-use tool.</h3><p>Chores, laundry, dinner, or summer routines, with your family's names, ages, and responsibilities worked in. Printed and mailed to you.</p></div>
   </article>
   <div class="product-plus" aria-hidden="true">+</div>
   <article class="product-piece">
    <div class="paper-image paper-blue"><img src={kitPreviews.find(k => k.month === 'January')!.image} alt="Example of the January Family Meeting printed resource" width="1080" height="1080" loading="lazy"/></div>
    <div class="piece-copy"><span class="pill">A WEEKLY FAMILY MEETING GUIDE</span><h3>Ten minutes to put it to work.</h3><p>Four simple parts to help everyone talk, choose one thing to try, and take responsibility together.</p></div>
   </article>
  </div>
  <p class="products-foot">Made for your family. No blank pages to figure out.</p>
 </div>
</section>

<section class="ofc-how" id="how-it-works" aria-labelledby="how-heading">
 <div class="container">
  <h2 id="how-heading">A simple way to get <em>everyone involved.</em></h2>
  <div class="steps">
   <article><span class="step-number">1</span><div class="step-icon" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><rect x="9" y="19" width="46" height="35" rx="5"/><path d="M9 27h46M20 9v16M44 9v16M20 38h8m8 0h8M20 46h8"/></svg></div><h3>Get your monthly resource.</h3><p>We personalize it, print it, and mail it to your door.</p></article>
   <article><span class="step-number">2</span><div class="step-icon" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><circle cx="21" cy="20" r="7"/><circle cx="43" cy="20" r="7"/><circle cx="32" cy="12" r="7"/><path d="M7 48c1-12 10-18 19-15m31 15c-1-12-10-18-19-15M19 49c1-12 7-18 13-18s12 6 13 18"/></svg></div><h3>Meet for 10 minutes each week.</h3><p>Talk, plan, and pick one small thing to try together.</p></article>
   <article><span class="step-number">3</span><div class="step-icon" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><rect x="13" y="12" width="38" height="42" rx="5"/><path d="m21 32 8 8 17-19"/></svg></div><h3>See your family take on more.</h3><p>Little by little, everyone learns to do their part, with fewer reminders from you.</p></article>
  </div>
 </div>
</section>

<section class="ofc-months" id="monthly-topics" aria-labelledby="months-heading">
 <div class="months-layout container">
  <div class="months-intro"><h2 id="months-heading">One family challenge <em>each month.</em></h2><p>Practical, real-life tools that help your family handle more together.</p></div>
  <div class="months-cards">
   {[
     {month:months[0],description:"Get everyone on the same page."},
     {month:months[1],description:"Laundry isn't all on you."},
     {month:months[2],description:"Chores without the nagging."},
     {month:months[3],description:"Dinner isn't all on you."},
     {month:months[4],description:"Summer days without constant questions."}
   ].map(({month,description},i)=><div class="month-card"><span class="month-name">{month.month}</span><p>{description}</p><img src={month.icon} alt="" loading="lazy" width="92" height="92"/></div>)}
  </div>
 </div>
</section>

<section class="ofc-founder" aria-labelledby="founder-heading">
 <div class="container founder-layout">
  <img class="founder-photo" src="/images/site/mark-megan-family-story-1200.webp" alt="Megan and her family" width="460" height="460" loading="lazy"/>
  <div class="founder-copy"><h2 id="founder-heading">Hi, I'm Megan.</h2><p>We created Family Meeting Club because we want our kids to grow into capable people, without Mom having to manage every little thing along the way.</p><p>You don't need another parenting project. You need an easy way to get everyone involved.</p><p class="signature">Megan <span>Co-creator, Organized Mom Collective</span></p></div>
 </div>
</section>

<section class="ofc-offer" id="offer" aria-labelledby="offer-heading">
 <div class="container offer-layout">
  <div class="offer-summary"><p class="eyebrow">YOUR MEMBERSHIP</p><h2 id="offer-heading">Ready to lighten <em>your mental load?</em></h2><p>One personalized resource mailed every month, plus a simple weekly meeting guide.</p><ul><li>Prepared using your family's details</li><li>Printed and mailed to your door</li><li>Digital access to review and reprint</li></ul></div>
  <div class="price-card"><img class="club-brand-wordmark" src="/images/club/family-meeting-club-horizontal-logo.webp" alt="The Family Meeting Club" width="2027" height="570" loading="lazy" decoding="async" /><h3>{joinOpen ? CLUB_OFFER : 'One simple monthly delivery.'}</h3>{joinOpen && <p class="offer-free-summary">{founding ? "January’s plan and your Family Vision welcome print are free." : "Your first personalized printed plan is free."}</p>}<div class="founding-price-label">FOUNDING FAMILY PRICE</div><div class="price">$5.90 <span>/ month</span></div><p class="founding-price-lock">✓ Keep your $5.90 rate while subscribed.</p>{joinOpen ? <><p class="fineprint">{founding ? `First charge: ${CLUB_PROGRAM_START.foundingFirstCharge}. Cancel before then and pay nothing.` : 'First charge one month after joining. Cancel anytime.'}</p><button type="button" class="primary" id="club-checkout" hidden>Get My First Month Free →</button><div data-checkout-closed><p class="fineprint" data-checkout-checking>Checking enrollment…</p><a class="primary" href="/support" hidden>Ask About Early Access →</a></div><p class="checkout-error" id="club-checkout-error" role="alert" hidden></p><small>Secure checkout with Stripe.</small><small class="block mt-1" data-household-disclosure>{founding ? 'One free first month per household. A household that already had one starts January 1, 2027, with $5.90 charged that day.' : 'One free first month per household. A household that already had one is charged $5.90 today.'}</small></> : <><p class="fineprint">Proposed pricing. Enrollment isn't open yet while printing, fulfillment, and billing are tested.</p><a class="primary" href="/support">Ask About Early Access →</a><small>No payment required to ask.</small></>}</div>
 </div>
</section>

<section class="ofc-faq" id="faq" aria-labelledby="faq-heading">
 <div class="container faq-layout">
  <h2 id="faq-heading">A few quick <em>questions.</em></h2>
  <div class="faq-list">
   {faqs.filter(([q])=>['How is this different from printables or a chore chart?','How much time does it take?','Will this work with young kids?','Is this another app I need to manage?','Do I need a printer or your wall calendar?','Can I subscribe or cancel right now?'].includes(q)).map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}
  </div>
 </div>
</section>
</main>

<footer class="footer"><a href="/">Organized Mom Collective</a><span>© {new Date().getFullYear()} Organized Mom Collective</span><a href="/support">Support</a></footer>
</div>


<script>
 // The offer button opens Stripe Checkout directly: Stripe collects her email, card and mailing address.
 import { billingErrorText, checkoutOffered, startCheckout } from '../lib/club/membership';
 // Shown only when checkout is really open (live; or test mode for the owner's /club/?test-checkout=1): a visitor
 // never starts a Stripe test-mode checkout. Otherwise the early-access link, as before enrollment opened.
 const closed = document.querySelector<HTMLElement>('[data-checkout-closed]');
 checkoutOffered().then((open) => {
  const button = document.getElementById('club-checkout');
  if (open) { button?.removeAttribute('hidden'); closed?.remove(); return; }
  closed?.querySelector('[data-checkout-checking]')?.replaceChildren('Enrollment opens soon. We’re finishing printing and billing tests.');
  closed?.querySelector('a')?.removeAttribute('hidden');
 });
 const checkout = document.getElementById('club-checkout') as HTMLButtonElement | null;
 const checkoutError = document.getElementById('club-checkout-error') as HTMLParagraphElement;
 const checkoutLabel = checkout?.textContent ?? '';
 const resetCheckout = () => { if (checkout) { checkout.disabled = false; checkout.textContent = checkoutLabel; } };
 checkout?.addEventListener('click', async () => {
  if (checkout.disabled) return;
  checkout.disabled = true;
  checkout.textContent = 'Opening secure checkout…';
  checkoutError.hidden = true;
  try {
   location.assign((await startCheckout('monthly')).url);
  } catch (err) {
   resetCheckout();
   checkoutError.textContent = billingErrorText((err as Error).message);
   checkoutError.hidden = false;
  }
 });
 // Back from Stripe (the page restored from the back/forward cache): the button works again.
 addEventListener('pageshow', (e) => { if (e.persisted) resetCheckout(); });
</script>


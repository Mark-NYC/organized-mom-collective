.meeting-rhythm-foot { font-weight: 600; margin-top: 1.6rem; color: #3D6671; }
@media (max-width: 700px) { .meeting-rhythm-grid { grid-template-columns: 1fr; gap: .75rem; } .meeting-rhythm-grid > div { padding: 1.2rem 1.35rem; } .meeting-rhythm-intro { margin-bottom: 1.5rem; } }

/* Visual-first StoryBrand, using existing kit artwork and intentionally small inline diagrams. */

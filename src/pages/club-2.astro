---
import PublicLayout from '../layouts/PublicLayout.astro';
import { BRAND_NAME } from '../config';
import clubHeroUrl from '../../assets/icons/ofc/hero-family-pointing.jpeg?url';
import summerDayExampleUrl from '../../assets/icons/ofc/our-summer-day.webp?url';
import routineExampleUrl from '../../assets/icons/ofc/routine-club-example.jpg?url';
const kits = import.meta.glob('../../assets/icons/ofc/monthly-kits/*.webp', { eager: true, query: '?url', import: 'default' });
const months = [
  { name: 'January', headline: 'Stop holding the whole week in your head', detail: 'A weekly family meeting plan that gets everyone looking ahead.', image: kits['../../assets/icons/ofc/monthly-kits/September.webp'] },
  { name: 'March', headline: 'Chores without chasing everyone', detail: 'Clear jobs that make it easier for each person to contribute.', image: kits['../../assets/icons/ofc/monthly-kits/March.webp'] },
  { name: 'May', headline: 'Summer days without constant questions', detail: 'A rhythm your kids can learn to check before asking what comes next.', image: kits['../../assets/icons/ofc/monthly-kits/May.webp'] },
];
const families = [
  {
    id: 'parkers', button: '2 young kids', family: 'The Parker Family', summary: '2 kids · ages 4 & 7',
    context: 'Preschool drop-off, first grade, and Saturday soccer',
    challenge: 'Busy school mornings when everyone needs a reminder',
    insight: 'For this family, the plan uses one small shared morning habit and easy, age-appropriate steps.',
    items: [
      { person: 'Emma · 4', heading: 'Shoes in their spot', detail: 'After breakfast, with Dad helping as needed' },
      { person: 'Noah · 7', heading: 'Backpack ready', detail: 'Put the folder and water bottle in the bag after breakfast' },
      { person: 'Dad', heading: 'Own the door check', detail: 'Help Emma with shoes and check the bags before leaving' },
    ],
    question: 'What could we prepare tonight to make tomorrow morning easier?',
    word: 'READY'
  },
  {
    id: 'riveras', button: '3 busy kids', family: 'The Rivera Family', summary: '3 kids · ages 6, 9 & 12',
    context: 'Soccer, dance, homework, and different afternoon schedules',
    challenge: 'Everyone is willing to help, but Mom still assigns and checks every job',
    insight: 'For this family, the plan gives each child a distinct part and makes adult ownership visible too.',
    items: [
      { person: 'Mia · 6', heading: 'Set out napkins', detail: 'Before dinner, using the picture cue on the fridge' },
      { person: 'Lucas · 9', heading: 'Clear the table', detail: 'After dinner, take dishes to the kitchen' },
      { person: 'Sofia · 12', heading: 'Own dishwasher unloading', detail: 'After school on the agreed weekdays' },
      { person: 'Dad', heading: 'Own Thursday dinner', detail: 'From planning through cleanup, not just cooking' },
    ],
    question: 'Which responsibility can someone take over from start to finish?',
    word: 'OWNERSHIP'
  },
  {
    id: 'johnsons', button: '5 kids, mixed ages', family: 'The Johnson Family', summary: '5 kids · ages 3–16',
    context: 'Teen sports, elementary homework, and younger-kid bedtimes',
    challenge: 'Too many individual schedules to manage with one generic checklist',
    insight: 'For this family, the plan groups shared routines and gives older kids independent ownership.',
    items: [
      { person: 'Ava · 3 + Ben · 6', heading: 'Shared toy reset', detail: 'Put toys into baskets before evening reading' },
      { person: 'Chloe · 9', heading: 'Backpack station', detail: 'After school, put bags and shoes in their places' },
      { person: 'Eli · 13', heading: 'Lunchbox cleanup', detail: 'Empty and rinse after arriving home' },
      { person: 'Grace · 16', heading: 'Own a laundry load', detail: 'Wash, dry, fold, and put away on Saturday' },
      { person: 'Dad', heading: 'Lead the weekly check-in', detail: 'Guide the family meeting and help agree on adjustments' },
    ],
    question: 'What could we simplify or combine so this works for everyone?',
    word: 'TEAMWORK'
  }
];
const faqs = [
  ['Is this just a printable with names added?', 'No. The aim is to prepare practical recommendations based on your household, ages, routines, and the specific problem that month addresses. You can review or adjust the suggested plan.'],
  ['Do I have to make the plan myself?', 'No. You start with a prepared recommendation, not an empty worksheet. Changes are optional.'],
  ['Do I need a printer?', 'No. The physical printed tool is the main product. A digital copy is available to review, edit, or reprint.'],
  ['Is this another app to manage?', 'No. You use the printed plan with your family. The digital companion is there when you need it.'],
  ['When can I join?', 'Enrollment and current billing terms are shown on our main Club page. This is a preview of a proposed landing page, not a separate checkout.'],
];
---
<PublicLayout fullTitle={`Organized Family Club Preview · ${BRAND_NAME}`} description="Personalized family plans made for your kids, ages, and routines, printed and mailed to your door." indexable={false} chrome={false} width="full" tracking={false}>
  <div class="club2">
    <div class="preview-banner">LANDING PAGE PREVIEW · The existing /club page is unchanged</div>
    <main>
      <section class="hero section-wrap">
        <div class="hero-copy">
          <p class="eyebrow">FOR MOMS WITH SCHOOL-AGED KIDS</p>
          <h1>Your family shouldn't depend on you <em>for everything.</em></h1>
          <p class="hero-problem">Stop being the one who remembers, plans, and reminds everyone.</p>
          <p class="hero-definition">Get <strong>personalized family plans</strong> built around your kids, their ages, and your real routines. We prepare them, print them, and mail them to your door every month, ready to use.</p>
          <div class="hero-cta"><a class="button button-primary" href="/club/#offer">Explore Club Membership <span aria-hidden="true">→</span></a><a class="text-link" href="#families">See family examples ↓</a></div>
          <p class="micro">Made for your family. Ready to use. Nothing to print.</p>
        </div>
        <figure class="hero-image"><img src={clubHeroUrl} alt="Family gathered at the kitchen table with a printed family plan" loading="eager" /><figcaption>Plans for your family, not just another blank worksheet.</figcaption></figure>
      </section>

      <section class="problem section-wrap" aria-labelledby="problem-title">
        <p class="eyebrow">SOUND FAMILIAR?</p>
        <h2 id="problem-title">Even when everyone helps, <em>you're still managing everything.</em></h2>
        <p class="intro">You remember what needs doing. You figure out who should do it. You remind everyone when it's time. The work isn't just doing things. It's keeping track of everything.</p>
        <div class="three-up">
          <article><span class="hand-icon" aria-hidden="true">☀</span><h3>Mornings</h3><p>Who's dressed? Where's the backpack? What did someone forget?</p></article>
          <article><span class="hand-icon" aria-hidden="true">⌂</span><h3>Home</h3><p>Everyone can help, but you're still assigning and checking every chore.</p></article>
          <article><span class="hand-icon" aria-hidden="true">♧</span><h3>Daily life</h3><p>It's always “Mom, what do I do next?”</p></article>
        </div>
      </section>

      <section class="difference shade">
        <div class="section-wrap">
          <p class="eyebrow">WHY THIS IS DIFFERENT</p>
          <h2>Another printable shouldn't mean <em>another job for you.</em></h2>
          <div class="compare">
            <article><p class="eyebrow">THE USUAL PRINTABLE</p><h3>Mom has to build the plan.</h3><ul><li>Choose the routine</li><li>Decide what's age-appropriate</li><li>Assign every job</li><li>Fill out the chart</li><li>Keep reminding everyone</li></ul></article>
            <article class="compare-good"><p class="eyebrow">YOUR CLUB PLAN</p><h3>We prepare it around your family.</h3><ul><li>Recommendations based on your kids' ages</li><li>Real names and responsibilities</li><li>Routines shaped around your household</li><li>A finished plan you can review</li><li>Printed and mailed, ready to use</li></ul></article>
          </div>
        </div>
      </section>

      <section class="personal section-wrap">
        <div class="personal-copy"><p class="eyebrow">PERSONALIZED MEANS MORE THAN NAMES</p><h2>Not just your family's names. <em>A plan made for your actual family.</em></h2><p>We learn a little about your household once: your kids' ages, your routines, and where you could use some help.</p><p>Then we prepare useful ideas and responsibilities around those details. No starting with a blank page or figuring out everything yourself.</p><a class="text-link" href="#families">See three different families ↓</a></div>
        <figure class="real-product"><img src={summerDayExampleUrl} alt="Example of an actual Organized Family Club summer rhythm printed resource" loading="lazy"/><figcaption>Real Club resource design. Each mailed plan is prepared around the member household.</figcaption></figure>
      </section>

      <section class="family-demo shade" id="families" aria-labelledby="family-title">
        <div class="section-wrap">
          <p class="eyebrow">SEE HOW PERSONALIZATION CHANGES THE PLAN</p>
          <h2 id="family-title">Every family is different. <em>Your plan should be, too.</em></h2>
          <p class="intro">Choose a family below. No forms, no email, no setup. See how different ages, activities, and daily challenges lead to different recommendations.</p>
          <div class="family-tabs" role="tablist" aria-label="Choose a sample family">
            {families.map((f, i) => <button type="button" role="tab" id={`family-tab-${f.id}`} aria-controls={`family-panel-${f.id}`} aria-selected={i === 1 ? 'true' : 'false'} tabindex={i === 1 ? 0 : -1} data-family={f.id} class={i === 1 ? 'active' : ''}><strong>{f.button}</strong><small>{f.summary}</small></button>)}
          </div>
          {families.map((f, i) => <div class="family-panel" id={`family-panel-${f.id}`} role="tabpanel" aria-labelledby={`family-tab-${f.id}`} hidden={i !== 1}>
            <div class="family-details"><p class="eyebrow">EXAMPLE HOUSEHOLD</p><h3>{f.family}</h3><p class="family-summary">{f.summary}</p><dl><dt>What their week looks like</dt><dd>{f.context}</dd><dt>Where they need help</dt><dd>{f.challenge}</dd><dt>How the plan adapts</dt><dd>{f.insight}</dd></dl><p class="sample-disclaimer">These are illustrative examples showing our approach to personalization. They aren't real customer results or exports from the live generator.</p></div>
            <div class="plan-stage"><div class="sample-sheet"><div class="sheet-header"><p>ORGANIZED FAMILY CLUB · FAMILY MEETING</p><h3>{f.family}</h3><span>A little planning. More shared ownership.</span></div><div class="sheet-label">OUR FAMILY'S SMALL STARTS</div><div class="assignment-list">{f.items.map(item => <div class="assignment"><strong>{item.person}</strong><div><b>{item.heading}</b><span>{item.detail}</span></div></div>)}</div><div class="sheet-question"><strong>Try asking together</strong><p>{f.question}</p></div><div class="sheet-footer"><span>WORD OF THE WEEK</span><strong>{f.word}</strong></div></div><p class="sample-caption">Illustrative January-style plan, not the production PDF. Your actual Club printable uses the approved monthly design.</p></div>
          </div>)}
          <p class="demo-bottom">The point isn't just seeing your child's name on a page. It's having the recommendations and ownership already thought through.</p>
        </div>
      </section>

      <section class="how section-wrap" id="how">
        <p class="eyebrow">THREE SIMPLE STEPS</p><h2>We do the preparation. <em>Your family gets started.</em></h2>
        <div class="three-up steps"><article><b class="step-num">1</b><h3>Tell us about your family once.</h3><p>Your kids, their ages, routines, and where you want help.</p></article><article><b class="step-num">2</b><h3>We prepare your plan.</h3><p>Each month, a practical plan with ready-made recommendations. Review or adjust it if you'd like.</p></article><article><b class="step-num">3</b><h3>Find it in your mailbox.</h3><p>A printed resource ready to put on your fridge or bring to your family meeting.</p></article></div><p class="center-note">No elaborate setup. No new family app everyone has to learn.</p>
      </section>

      <section class="month-section shade" id="months"><div class="section-wrap"><p class="eyebrow">ONE FAMILY PROBLEM AT A TIME</p><h2>A little less on your shoulders, <em>every month.</em></h2><p class="intro">Every month addresses one practical part of family life. Each tool stands on its own. You don't have to catch up or keep a complicated system running.</p><div class="month-cards">{months.map(m => <article><img src={m.image} alt={`${m.name} example of an Organized Family Club printed resource`} loading="lazy"/><div class="month-copy"><span>{m.name}</span><h3>{m.headline}</h3><p>{m.detail}</p></div></article>)}</div><a class="text-link" href="/club/#kit-gallery-title">Explore the full year of Club resources →</a></div></section>

      <section class="outcome section-wrap"><p class="eyebrow">THE GOAL IS MORE OWNERSHIP</p><h2>Imagine not being the answer <em>to every question.</em></h2><div class="compare"><article><h3>Before</h3><p>“Mom, what do I do next?”</p><p>“Who's cleaning this?”</p><p>“What's the plan?”</p></article><article class="compare-good"><h3>What we're working toward</h3><p>Kids know their routines.</p><p>Adults share meaningful responsibility.</p><p>The plan isn't all in Mom's head.</p></article></div><p class="center-note">It won't transform a family overnight. But small, prepared plans make it easier to practice sharing responsibility.</p></section>

      <section class="founder shade"><div class="section-wrap founder-grid"><img src="/images/site/mark-megan-family-story-1200.webp" alt="Megan and her family" loading="lazy"/><div><p class="eyebrow">FROM OUR FAMILY TO YOURS</p><h2>Created by a family <em>who gets it.</em></h2><p>Hi, I'm Megan. I know how easy it is to become the person everyone depends on for the next reminder, answer, or instruction.</p><p>We believe an organized family isn't built by one person doing everything. It's built as everyone learns to participate, build routines, and take responsibility.</p><p>That's why we prepare practical plans around real families, rather than handing Mom another blank worksheet.</p></div></div></section>

      <section class="offer section-wrap" id="offer"><p class="eyebrow">ORGANIZED FAMILY CLUB MEMBERSHIP</p><h2>One useful personalized plan. <em>Printed and mailed every month.</em></h2><div class="offer-card"><p class="price"><strong>$5.90</strong> / month after the introductory offer</p><ul><li>One prepared, personalized family plan every month</li><li>Age-appropriate recommendations and clear ownership</li><li>Printed and mailed to your door, US shipping included</li><li>A digital copy to review, change, or reprint</li><li>Simple month-by-month resources, not another program to manage</li></ul><a class="button button-primary" href="/club/#offer">See Current Enrollment Offer →</a><p class="micro">This preview doesn't process signups. Current availability, introductory offers, billing dates, and cancellation terms are confirmed on the main Club page before checkout.</p></div></section>
      <section class="faq section-wrap"><p class="eyebrow">GOOD QUESTIONS</p><h2>Questions before you join?</h2><div class="faq-list">{faqs.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
    </main>
  </div>
</PublicLayout>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.club2 [role="tab"]')];
  function activateFamily(tab: HTMLButtonElement) {
    tabs.forEach(t => {
      const active = t === tab;
      t.setAttribute('aria-selected', String(active));
      t.tabIndex = active ? 0 : -1;
      t.classList.toggle('active', active);
      const panel = document.getElementById('family-panel-' + t.dataset.family);
      if (panel) panel.hidden = !active;
    });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateFamily(tab));
    tab.addEventListener('keydown', event => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft' && event.key !== 'Home' && event.key !== 'End') return;
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      activateFamily(tabs[next]);
      tabs[next].focus();
    });
  });
</script>
<style>

.shift-symbol { flex:0 0 34px; width:34px; height:34px; display:grid; place-items:center; border-radius:50%; background:#E8D2D6; font-weight:700; color:#545454; }.shift-after .shift-symbol { background:#D4DFC4; color:#3D6671; }

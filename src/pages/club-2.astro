@media(max-width:800px){.hero-promise { grid-template-columns:repeat(3,minmax(0,1fr)); }.meeting-clock { flex-basis:130px; width:130px; height:130px; }.meeting-visual { grid-template-columns:repeat(2,minmax(0,1fr)); }.meeting-visual > div:nth-child(2)::after { display:none; } }

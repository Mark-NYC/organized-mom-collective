<script>
 // This public preview uses fixed January Rivera sample data. Nothing is generated or saved here.
 const personalStory = document.querySelector<HTMLElement>('[data-personal-story]');
 if (personalStory) {
   const controls = [...personalStory.querySelectorAll<HTMLButtonElement>('[data-personal-tab]')];
   const panels = [...personalStory.querySelectorAll<HTMLElement>('[data-personal-panel]')];
   const show = (step: string) => {
     controls.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.personalTab === step)));
     panels.forEach(panel => { panel.hidden = panel.dataset.personalPanel !== step; });
   };
   controls.forEach(button => button.addEventListener('click', () => show(button.dataset.personalTab!)));
   personalStory.querySelector<HTMLButtonElement>('[data-personal-next]')?.addEventListener('click', () => show('plan'));
 }
 // Sample-family tabs: click, or arrow keys / Home / End with roving tabindex (WAI-ARIA tabs, automatic activation).
 const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-family-tab]')];
 const surface = document.querySelector<HTMLElement>('.demo-surface')!;
 const viewTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-view-tab]')];

 // Mobile: one preview at a time (Family Meeting Plan | Printed Monthly Tool); kept when the family changes.
 const showView = (tab: HTMLButtonElement, focus = false) => {
  viewTabs.forEach(v => { const on = v === tab; v.setAttribute('aria-selected', String(on)); v.tabIndex = on ? 0 : -1; });
  surface.dataset.view = tab.dataset.viewTab;
  if (focus) tab.focus();
 };
 viewTabs.forEach((tab, i) => {
  tab.addEventListener('click', () => showView(tab));
  tab.addEventListener('keydown', e => {
   const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: viewTabs.length - 1 }[e.key];
   if (next === undefined) return;
   e.preventDefault();
   showView(viewTabs[(next + viewTabs.length) % viewTabs.length], true);
  });
 });

 const select = (tab: HTMLButtonElement, focus = false) => {
  tabs.forEach(t => {
   const on = t === tab;
   t.setAttribute('aria-selected', String(on));
   t.tabIndex = on ? 0 : -1;
   const panel = document.getElementById(t.getAttribute('aria-controls')!);
   if (panel) panel.hidden = !on;
  });
  const id = tab.id.replace('family-tab-', '');
  viewTabs.forEach(v => v.setAttribute('aria-controls', `${v.dataset.viewTab === 'plan' ? 'phone' : 'sheet'}-${id}`));
  if (focus) tab.focus();
 };
 tabs.forEach((tab, i) => {
  tab.addEventListener('click', () => select(tab));
  tab.addEventListener('keydown', e => {
   const next = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
   if (next === undefined) return;
   e.preventDefault();
   select(tabs[(next + tabs.length) % tabs.length], true);
  });
 });

 // Mobile gallery: six months first, the rest on request.
 document.querySelector<HTMLButtonElement>('[data-kit-show-all]')?.addEventListener('click', e => {
  const button = e.currentTarget as HTMLButtonElement;
  button.closest('.kit-gallery')?.classList.add('show-all');
  button.setAttribute('aria-expanded', 'true');
  button.hidden = true;
 });

 // Month previews: full-screen dialog, with hover magnify on desktop.
 document.querySelectorAll<HTMLElement>('.kit-image-stage').forEach(stage => {
  stage.addEventListener('pointermove', event => {
   if (event.pointerType !== 'mouse') return;
   const bounds = stage.getBoundingClientRect();
   stage.style.setProperty('--zoom-x', ((event.clientX - bounds.left) / bounds.width * 100) + '%');
   stage.style.setProperty('--zoom-y', ((event.clientY - bounds.top) / bounds.height * 100) + '%');
  });
 });
 let previousOverflow = '';
 document.querySelectorAll<HTMLButtonElement>('[data-kit-open]').forEach(button => {
  button.addEventListener('click', () => {
   const dialog = document.getElementById(`kit-preview-${button.dataset.kitOpen}`) as HTMLDialogElement | null;
   if (!dialog) return;
   previousOverflow = document.body.style.overflow;
   document.body.style.overflow = 'hidden';
   dialog.showModal();
   dialog.scrollTop = 0;
  });
 });
 document.querySelectorAll<HTMLDialogElement>('.kit-fullscreen').forEach(dialog => {
  dialog.querySelector('button')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => { document.body.style.overflow = previousOverflow; });
 });
</script>
<script>
 // The offer button opens Stripe Checkout directly: Stripe collects her email, card and mailing address.
 import { billingErrorText, checkoutOffered, startCheckout } from '../lib/club/membership';
 // Shown only when checkout is really open (live; or test mode for the owner's /club/?test-checkout=1): a visitor
 // never starts a Stripe test-mode checkout. Otherwise the early-access link, as before enrollment opened.
 const closed = document.querySelector<HTMLElement>('[data-checkout-closed]');
 checkoutOffered().then((open) => {
  const button = document.getElementById('club-checkout');
  if (open) { button?.removeAttribute('hidden'); closed?.remove(); return; }
  closed?.querySelector('[data-checkout-checking]')?.replaceChildren('Enrollment opens soon. We’re finishing printing and billing tests.');
  closed?.querySelector('a')?.removeAttribute('hidden');
 });
 const checkout = document.getElementById('club-checkout') as HTMLButtonElement | null;
 const checkoutError = document.getElementById('club-checkout-error') as HTMLParagraphElement;
 const checkoutLabel = checkout?.textContent ?? '';
 const resetCheckout = () => { if (checkout) { checkout.disabled = false; checkout.textContent = checkoutLabel; } };
 checkout?.addEventListener('click', async () => {
  if (checkout.disabled) return;
  checkout.disabled = true;
  checkout.textContent = 'Opening secure checkout…';
  checkoutError.hidden = true;
  try {
   location.assign((await startCheckout('monthly')).url);
  } catch (err) {
   resetCheckout();
   checkoutError.textContent = billingErrorText((err as Error).message);
   checkoutError.hidden = false;
  }
 });
 // Back from Stripe (the page restored from the back/forward cache): the button works again.
 addEventListener('pageshow', (e) => { if (e.persisted) resetCheckout(); });
</script>


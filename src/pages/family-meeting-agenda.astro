---
import PublicLayout from '../layouts/PublicLayout.astro';
import { MEETING_GUIDE as G } from '../data/club/meeting-guide';
const icons = [
  '/images/club/onboarding/family-members.webp',
  '/images/club/onboarding/family-meeting.webp',
  '/images/club/onboarding/shared-responsibility.webp',
  '/images/club/onboarding/individual-ownership.webp',
];
const prompts = [
  'Choose one thing to work on together this month. Why does it matter to all of us?',
  'What went well? What was hard? What would help? Hear everyone, youngest first.',
  'Each person agrees to one small part they own this week. Say it out loud.',
  'Try one part together now, so everyone knows what finished looks like.',
];
---
<PublicLayout title="Free 10-Minute Family Meeting Agenda Printable" description="Customize and download a beautiful one-page family meeting agenda with four illustrated parts and room for everyone’s responsibilities." width="wide">
  <main class="fm-public" data-fm-tool>
    <header class="fm-intro">
      <h1>One family meeting. Ten minutes.</h1>
      <p>Give everyone a voice and a part to play. Make this sheet yours, or print it blank and fill it in together.</p>
    </header>
    <div class="fm-layout">
      <aside class="fm-editor" aria-label="Customize your meeting">
        <h2>Make it yours</h2>
        <p>Tap any writing line on the sheet to type your own words. Leave it blank for a reusable agenda.</p>
        <div class="fm-actions">
          <button type="button" data-meeting-download>Download PNG</button>
          <button type="button" data-meeting-print>Print / Save PDF</button>
          <button type="button" data-meeting-reset>Clear my entries</button>
        </div>
        <p class="fm-small">US Letter · One page. Your edits are saved in this browser.</p>
        <a href="/resources/family-meeting-agenda/">Read the simple guide</a>
      </aside>
      <div class="fm-preview">
        <article class="fm-public-paper" data-meeting-paper aria-label="Editable family meeting agenda">
          <header class="fm-paper-head">
            <p class="fm-kicker">OUR WEEKLY RHYTHM</p>
            <h2>{G.title}</h2>
            <p class="fm-sub">Ten minutes. Everyone has a part.</p>
            <div class="fm-meta">
              <label>Our family<input data-field="family" maxlength="45" aria-label="Family name" /></label>
              <label>Week of<input data-field="week" maxlength="30" aria-label="Week of" /></label>
            </div>
          </header>
          <div class="fm-steps">
            {G.parts.map((part,i) => (
              <section class="fm-step">
                <img src={icons[i]} alt="" aria-hidden="true" width="66" height="66" decoding="async" />
                <div class="fm-step-body">
                  <div class="fm-step-head"><h3>{part.title}</h3><span>{part.minutes} min</span></div>
                  <p class="fm-prompt">{prompts[i]}</p>
                  {i === 0 && <label>Our focus this month<input data-field="focus" maxlength="85" /></label>}
                  {i === 1 && <label>Something we heard<input data-field="heard" maxlength="85" /></label>}
                  {i === 2 && <div class="fm-roles">
                    <div class="fm-role-head"><span>Who</span><span>My part this week</span></div>
                    {Array.from({length:4},(_,j)=><div class="fm-role"><input data-field={`who-${j}`} maxlength="25" aria-label={`Person ${j+1}`} /><input data-field={`part-${j}`} maxlength="65" aria-label={`Responsibility ${j+1}`} /></div>)}
                  </div>}
                  {i === 3 && <label>What we’ll try together now<input data-field="practice" maxlength="85" /></label>}
                </div>
              </section>
            ))}
          </div>
          <footer class="fm-paper-foot"><p>Everyone has a voice. Everyone has a part.</p><span>ORGANIZED MOM COLLECTIVE · organizedmomcollective.com</span></footer>
        </article>
      </div>
    </div>
    <aside class="fm-club-note"><p>Want the conversation prepared for you each month? The Family Meeting Club pairs this weekly rhythm with a fresh Family Focus and personalized questions.</p><a href="/club/">Explore the Family Meeting Club</a></aside>
  </main>
</PublicLayout>
<style is:global>
.fm-public{--fm-ink:#3F3B39;--fm-green:#3F6B5A;--fm-rule:#E4DDD6;--fm-muted:#6E6461;max-width:1200px;margin:auto;padding:38px 24px 64px;font-family:Montserrat,var(--font-sans),Arial,sans-serif;color:var(--fm-ink)}
.fm-intro{max-width:760px;margin:0 auto 34px;text-align:center}.fm-intro h1{font:400 clamp(2rem,5vw,3.2rem)/1.15 Georgia,serif;margin:0 0 14px}.fm-intro p{font-size:15px;line-height:1.75;margin:0}
.fm-layout{display:grid;grid-template-columns:minmax(220px,280px) minmax(0,1fr);gap:32px;align-items:start}.fm-editor{padding:20px 0;position:sticky;top:24px}.fm-editor h2{font-size:21px;font-weight:700;margin:0 0 10px}.fm-editor p{font-size:14px;line-height:1.7;margin:0 0 20px}.fm-actions{display:grid;gap:10px;margin:0 0 17px}.fm-actions button{border:1px solid var(--fm-green);background:white;color:var(--fm-green);min-height:45px;border-radius:5px;font:600 13px Montserrat,Arial,sans-serif;cursor:pointer}.fm-actions button:first-child{background:var(--fm-green);color:white}.fm-actions button:last-child{border-color:transparent;text-decoration:underline}.fm-actions button:disabled{opacity:.55}.fm-editor .fm-small{font-size:12px;color:var(--fm-muted)}.fm-editor a,.fm-club-note a{text-decoration:underline;text-underline-offset:4px;font-weight:600}
.fm-preview{min-width:0;padding:14px;background:#F4F3F0}.fm-public-paper{box-sizing:border-box;width:100%;max-width:816px;min-height:1056px;margin:0 auto;padding:46px 54px 35px;background:white;box-shadow:0 10px 30px #3d38311f;display:flex;flex-direction:column;font-family:Montserrat,Arial,sans-serif;color:#3F3B39;print-color-adjust:exact;-webkit-print-color-adjust:exact}.fm-public-paper *{box-sizing:border-box}.fm-paper-head{text-align:center;margin-bottom:24px}.fm-kicker{font:700 11px/1.3 Montserrat,Arial,sans-serif;letter-spacing:.22em;color:#3F6B5A;margin:0 0 12px}.fm-paper-head h2{font:700 39px/1.12 Montserrat,Arial,sans-serif;letter-spacing:-.04em;margin:0 0 8px}.fm-sub{font:italic 17px/1.4 Georgia,serif;color:#6E6461;margin:0 0 22px}.fm-meta{display:grid;grid-template-columns:1.4fr 1fr;gap:22px;text-align:left}.fm-public-paper label{display:block;font-size:11px;font-weight:600;color:#6E6461;line-height:1.4}.fm-public-paper input{display:block;width:100%;min-width:0;border:0;border-bottom:1px solid #CFC9C3;border-radius:0;background:transparent;color:#3F3B39;font:500 13px/1.35 Montserrat,Arial,sans-serif;padding:3px 0;height:27px}.fm-public-paper input:focus{outline:2px solid #3F6B5A;outline-offset:2px;background:#EEF4F1}.fm-steps{border-top:1px solid #E4DDD6}.fm-step{display:grid;grid-template-columns:66px minmax(0,1fr);gap:19px;padding:20px 0;border-bottom:1px solid #E4DDD6;break-inside:avoid}.fm-step img{width:66px;height:66px;object-fit:contain}.fm-step-head{display:flex;align-items:baseline;justify-content:space-between;gap:8px}.fm-step-head h3{font:700 22px/1.2 Montserrat,Arial,sans-serif;letter-spacing:-.025em;margin:0}.fm-step-head span{font:700 11px Montserrat,Arial,sans-serif;white-space:nowrap;color:#3F6B5A}.fm-prompt{font:500 13px/1.5 Montserrat,Arial,sans-serif;margin:7px 0 12px}.fm-role-head,.fm-role{display:grid;grid-template-columns:1fr 2.5fr;gap:16px}.fm-role-head{font-size:11px;font-weight:600;color:#6E6461}.fm-role input{height:25px}.fm-paper-foot{text-align:center;margin-top:auto;padding-top:22px}.fm-paper-foot p{font:italic 16px Georgia,serif;margin:0 0 9px}.fm-paper-foot span{font-size:9px;font-weight:600;letter-spacing:.075em;color:#6E6461}.fm-club-note{max-width:680px;margin:30px auto 0;text-align:center;font-size:13px;line-height:1.7}.fm-club-note p{margin:0 0 8px}
@media(max-width:1050px){.fm-layout{display:block}.fm-editor{position:static;max-width:816px;margin:0 auto;padding:0 0 20px}.fm-actions{display:flex;flex-wrap:wrap}.fm-actions button{padding:0 18px}}
@media(max-width:650px){.fm-public{padding:26px 12px 45px}.fm-preview{padding:5px}.fm-public:not(.fm-exporting) .fm-public-paper{padding:25px 18px;min-height:0}.fm-public:not(.fm-exporting) .fm-paper-head h2{font-size:28px}.fm-public:not(.fm-exporting) .fm-meta{gap:12px}.fm-public:not(.fm-exporting) .fm-step{grid-template-columns:42px minmax(0,1fr);gap:10px;padding:17px 0}.fm-public:not(.fm-exporting) .fm-step img{width:42px;height:42px}.fm-public:not(.fm-exporting) .fm-step-head h3{font-size:18px}.fm-public:not(.fm-exporting) .fm-role{gap:8px}.fm-public:not(.fm-exporting) .fm-public-paper input{font-size:16px;height:32px}.fm-public:not(.fm-exporting) .fm-paper-foot{margin-top:12px}}
@page{size:letter portrait;margin:0}
@media print{body{background:white!important}body > header,body > footer,body > nav,.site-header,.site-footer,.fm-intro,.fm-editor,.fm-club-note{display:none!important}.fm-public{padding:0!important;margin:0!important;max-width:none!important}.fm-layout{display:block}.fm-preview{padding:0;background:white}.fm-public .fm-public-paper{width:8.5in!important;max-width:none!important;min-height:11in!important;height:11in!important;margin:0!important;padding:46px 54px 35px!important;box-shadow:none;break-inside:avoid}.fm-public .fm-step{grid-template-columns:66px minmax(0,1fr)!important;gap:19px!important;padding:20px 0!important}.fm-public .fm-step img{width:66px!important;height:66px!important}.fm-public .fm-paper-head h2{font-size:39px!important}.fm-public .fm-step-head h3{font-size:22px!important}.fm-public .fm-public-paper input{font-size:13px!important;height:27px!important}}
</style>
<script>
  import { autosave, clearFields, downloadPng } from '../lib/printable';
  import { requireToolEmail } from '../lib/tool-email';
  const host = document.querySelector<HTMLElement>('[data-fm-tool]');
  const paper = host?.querySelector<HTMLElement>('[data-meeting-paper]');
  const download = host?.querySelector<HTMLButtonElement>('[data-meeting-download]');
  if (host && paper && download) {
    const save = autosave(paper, 'omc:family-meeting-agenda:v1');
    download.addEventListener('click', () => downloadPng(paper, { filename:'OMC-Family-Meeting-Agenda.png', width:816, height:1056, layoutHost:host, exportClass:'fm-exporting', button:download }));
    host.querySelector('[data-meeting-print]')?.addEventListener('click', async () => {
      if (await requireToolEmail('family-meeting-agenda')) { host.classList.add('fm-exporting'); try { window.print(); } finally { host.classList.remove('fm-exporting'); } }
    });
    host.querySelector('[data-meeting-reset]')?.addEventListener('click', () => { if (confirm('Clear your meeting entries?')) { clearFields(paper); save(); } });
  }
</script>

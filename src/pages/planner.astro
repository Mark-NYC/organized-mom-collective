---
/**
 * /planner — a free printable weekly planner people fill in on screen and download as a PNG.
 * The planner itself (design, autosave, PNG export) is src/components/site/WeeklyPlanner.astro, shared
 * with the upgraded planner for Take Back Control buyers (PLANNER_PLUS_PATH in src/data/planner.ts).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import WeeklyPlanner from '../components/site/WeeklyPlanner.astro';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Weekly Planner', item: new URL(routes.planner, site).href },
    ],
  },
];
---

<PublicLayout
  title="Free Weekly Planner"
  description="A free weekly planner for busy families: plan each day, the family menu, groceries, to-dos and self care, then download it as an image to print or keep on your phone."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="planner-h" class="bg-cream">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free weekly planner</p>
      <h1 id="planner-h" class="serif-hero mt-3">Plan Your Week in One Place.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        Fill in your days, meals, groceries and to-dos, then download it as an image to print or keep on your phone. What you type stays
        saved in this browser until you clear it.
      </p>
    </div>
  </section>

  <WeeklyPlanner>
    <p slot="footnote" class="wp-footnote">
      Want the week on your wall too? See the <a href={routes.calendar} data-cta="planner" class="text-link">Family Wall Calendar</a>
    </p>
  </WeeklyPlanner>
</PublicLayout>

---
/**
 * /closet-reset — a free one-page closet reset checklist: pull everything out, sort into keep / donate / store,
 * organize what stays, then keep it that way. Ticked and edited on screen, downloaded as a PNG
 * (src/components/site/ChecklistPages.astro). Saves in this browser (`omc:closet-reset:v1`).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import ChecklistPages from '../components/site/ChecklistPages.astro';
import type { ChecklistPage } from '../lib/checklist-pages';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const pages: ChecklistPage[] = [
  {
    sections: [
      {
        title: 'Pull Everything Out',
        groups: [
          { title: 'Empty it', variant: 'step', cols: 2, items: ['Everything out and onto the bed', 'Shelves, floor and rod cleared'] },
          { title: 'The one rule', variant: 'priority', cols: 1, items: ['Not worn in 12 months, or doesn’t fit your life now? It goes.'] },
        ],
      },
      {
        title: 'Decide',
        groupCols: 3,
        groups: [
          { title: 'Keep', variant: 'step', items: ['Fits right now', 'Worn in the last 6 months', 'You feel good in it', 'No repairs needed'] },
          { title: 'Donate', variant: 'step', items: ['Wrong size', 'Not your style anymore', 'Not worn in 12+ months', 'Itchy or uncomfortable'] },
          { title: 'Store', variant: 'step', items: ['Out of season', 'Special occasions only', 'Maternity or another stage', 'Sentimental, not daily'] },
        ],
      },
      {
        title: 'Organize What Stays',
        groups: [
          {
            title: 'Put it back',
            variant: 'step',
           
            cols: 2,
            items: ['Group by type: tops, pants, dresses', 'Color order within each group', 'Work clothes together', 'Everyday clothes together', 'Most-worn at eye level', 'Matching hangers if you have them'],
          },
        ],
      },
      {
        title: 'Finish & Keep It That Way',
        groupCols: 3,
        groups: [
          { title: 'Every day', variant: 'timeline', items: ['Clothes away, not on a chair', 'Pick tomorrow’s outfit tonight', 'One in, one out'] },
          { title: 'Every season', variant: 'timeline', items: ['Spring swap', 'Fall swap', 'Quick purge each quarter'] },
          { title: 'Before you’re done', variant: 'priority', items: ['Donations in the car', 'Stored items in labeled bins', 'List what you actually need'] },
        ],
      },
    ],
  },
];

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Closet Reset Checklist', item: new URL(routes.closetReset, site).href },
    ],
  },
];
---

<PublicLayout
  title="Free Closet Reset Checklist"
  description="A free closet declutter checklist: pull everything out, sort into keep, donate and store, organize what stays, then keep it that way. Edit it and download it to print."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="cr-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free closet reset</p>
      <h1 id="cr-h" class="serif-hero mt-3">A Closet You Can Get Dressed From.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        Everything out, three piles, put back only what earns its spot. One page to work through in an afternoon, with simple habits so it
        doesn’t creep back. Tick it off, change anything, then download it to print.
      </p>
    </div>
  </section>

  <ChecklistPages title="Closet Reset" pages={pages} storageKey="omc:closet-reset:v1" filename="closet-reset">
    <p slot="footnote" class="ck-footnote">
      More free tools: the <a href={routes.laundrySystem} class="text-link">Laundry System</a>, the
      {' '}<a href={routes.fallCleaning} class="text-link">Fall Cleaning Checklist</a> and the
      {' '}<a href={routes.calendar} data-cta="closet-reset" class="text-link">Family Wall Calendar</a>
    </p>
  </ChecklistPages>
</PublicLayout>

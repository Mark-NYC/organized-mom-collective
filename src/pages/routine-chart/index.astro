---
/**
 * /routine-chart — free routine charts (morning, after-school, bedtime, weekend, custom) people edit on screen
 * and download as a PNG. The chart itself (design, autosave, PNG export) is
 * src/components/site/RoutineChart.astro, shared with the upgraded chart for Take Back Control and Essential Routines buyers
 * (ROUTINE_PLUS_PATH in src/data/routines.ts). Saves in this browser (`omc:routine-chart:v1`).
 * Illustrated steps: the shared responsibility library. Under the chart, the one Responsibility Cards note
 * (src/data/responsibility-cards.ts); the line under the picker shows only once the cards have a live page.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import RoutineChart from '../../components/site/RoutineChart.astro';
import ResponsibilityCardsNote from '../../components/site/ResponsibilityCardsNote.astro';
import { responsibilityCards } from '../../data/responsibility-cards';
import { routes } from '../../routes';
import { BRAND_NAME } from '../../config';

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Routine Charts', item: new URL(routes.routineChart, site).href },
    ],
  },
];
---

<PublicLayout
  title="Free Picture Routine Charts for Kids: Morning, After-School and Bedtime"
  description="Make a free picture routine chart for kids: tap illustrated steps like brushing teeth or packing a backpack, put them in order, add times, then download to print."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="mr-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free routine charts</p>
      <h1 id="mr-h" class="serif-hero mt-3">Routines That Run Without You Repeating Yourself.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink mr-hero-desktop">
        Pick a routine, tap the illustrated steps your child needs, and set the times once. Pictures mean even early readers can check
        what’s next without asking you. Change any line, then download it to print and hang where it happens. What you set stays saved in
        this browser.
      </p>
      <p class="mr-hero-mobile">Choose a routine, make it yours, and download a picture chart your child can follow.</p>
    </div>
  </section>

  <RoutineChart storageKey="omc:routine-chart:v1">
    {
      responsibilityCards.pageUrl && (
        <p slot="picker-note" class="mr-picker-note">
          Want to teach these responsibilities step by step?{' '}
          <a href={responsibilityCards.pageUrl} data-cta="routine-chart-picker" class="text-link">Discover our Responsibility Cards</a>
        </p>
      )
    }
    <ResponsibilityCardsNote slot="after-sheet" />
    <p slot="footnote" class="mr-footnote">
      More free tools: the <a href={routes.choreChart} class="text-link">Chore Chart by Age</a>, the
      {' '}<a href={routes.screenTime} class="text-link">Screen Time Contract</a> and the
      {' '}<a href={routes.calendar} data-cta="routine-chart" class="text-link">Family Wall Calendar</a>
    </p>
  </RoutineChart>
</PublicLayout>

<style is:global>
  .mr-hero-mobile {display:none}
  @media screen and (max-width:850px) {
    html,body {max-width:100%;overflow-x:clip}
    .public-intro:has(#mr-h) {
      width:100%;max-width:100%;overflow:hidden;
      padding:0!important;margin:0!important;
      background:#FBF7F1!important;
    }
    .public-intro:has(#mr-h)>div {
      max-width:100%;padding:22px 20px 14px!important;
      background:transparent!important;
    }
    .public-intro #mr-h {
      font-size:clamp(30px,8.1vw,39px)!important;
      line-height:1.08!important;max-width:600px;
      margin:10px 0 0!important;
      overflow-wrap:break-word;
    }
    .public-intro .mr-hero-desktop {display:none!important}
    .public-intro .mr-hero-mobile {
      display:block;margin:12px 0 0;max-width:36ch;
      color:#706963;font:400 14px/1.55 Montserrat,sans-serif;
    }
  }
</style>

---
/**
 * The resource library hub, laid out like a small publication: one featured
 * article, the latest guides as a card grid, the three topics, and a quiet route
 * to the wall calendar. Until the first article is published it shows the
 * topics only, is noindex, and is left out of the sitemap.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import ArticleCard from '../../components/resources/ArticleCard.astro';
import { getArticles, getPillarArticles } from '../../lib/articles';
import { pillars } from '../../data/pillars';
import { imageAttrs } from '../../data/images';
import { routes } from '../../routes';
import { freeTools } from '../../data/free-tools';
import { inspirationGalleries } from '../../data/inspiration-galleries';
import { toyStorageGallery } from '../../data/toy-storage-gallery';
import { BRAND_NAME } from '../../config';

const all = await getArticles();
const sections = await Promise.all(pillars.map(async (pillar) => ({ pillar, articles: await getPillarArticles(pillar.id) })));

// Featured: the newest article with a photo, else the newest pillar guide, else the newest article.
const featured = all.find((a) => a.data.hero) ?? all.find((a) => a.data.pillarGuide) ?? all[0];
const guides = all;
const calendarPhoto = imageAttrs('hc-01-wall-calendar');
const visualIdeas = [inspirationGalleries[0], toyStorageGallery].filter((gallery) => gallery.published && gallery.ideas.length && gallery.ideas.every((idea) => Boolean(idea.image)));

// Free fill-in printables: filled in on screen, downloaded as an image.


const site = Astro.site!;
const description =
  'Simple systems for busy families: weekly planning, realistic cleaning routines and shared responsibilities that lighten the mental load of running a home.';
const jsonLd = all.length
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: `Resources · ${BRAND_NAME}`,
        description,
        url: new URL(routes.resources, site).href,
        hasPart: all.map((a) => ({ '@type': 'Article', headline: a.data.title, url: new URL(routes.article(a.id), site).href })),
      },
    ]
  : [];
---

<PublicLayout
  title="Home Organization Resources for Busy Families"
  description={description}
  indexable={all.length > 0}
  chrome
  width="wide"
  jsonLd={jsonLd}
>
  <header class="public-editorial-intro article-shell max-w-2xl">
    <p class="label text-muted">The Real-Life Reset</p>
    <h1 class="article-title mt-3">Simple systems for a busy home</h1>
    <p class="article-deck mt-4">
      Get plans out of your head, give jobs clear owners and teach routines the family can follow. Every guide answers one real question, gives you a routine you can start
      today, and a plan for the weeks that don’t go to plan.
    </p>
  </header>

  {
    featured && (
      <section aria-label="Featured" class="mt-12 border-t border-rule pt-10">
        <ArticleCard article={featured} as="h2" size="lg" layout="feature" priority />
      </section>
    )
  }

  {guides.length > 0 && (
    <section aria-labelledby="guides-h" class="resource-rail-section mt-16 border-t border-rule pt-10">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="label text-muted">Start with one small step</p>
          <h2 id="guides-h" class="mt-2 text-[1.8rem] font-bold" style="font-family: var(--font-editorial)">Guides</h2>
          <p class="mt-2 text-[0.97rem]" style="color: var(--color-prose-soft)">Practical plans for everyday family life.</p>
        </div>
        <div class="resource-rail-controls flex shrink-0 gap-2">
          <button type="button" data-rail-prev aria-label="Previous guides" aria-controls="guides-rail" class="resource-rail-arrow">←</button>
          <button type="button" data-rail-next aria-label="Next guides" aria-controls="guides-rail" class="resource-rail-arrow">→</button>
        </div>
      </div>
      <ul id="guides-rail" class="resource-rail mt-7" aria-label="Guides">
        {guides.map((article) => <li class="resource-rail-card"><ArticleCard article={article} /></li>)}
      </ul>
    </section>
  )}

  {visualIdeas.length > 0 && (
    <section aria-labelledby="inspiration-h" class="resource-rail-section mt-16 border-t border-rule pt-10">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="label text-muted">Ideas for your home</p>
          <h2 id="inspiration-h" class="mt-2 text-[1.8rem] font-bold" style="font-family: var(--font-editorial)">Inspiration</h2>
          <p class="mt-2 max-w-2xl text-[0.97rem]" style="color: var(--color-prose-soft)">Beautiful spaces and clever storage ideas you can make your own.</p>
        </div>
        <div class="resource-rail-controls flex shrink-0 gap-2">
          <button type="button" data-rail-prev aria-label="Previous inspiration" aria-controls="inspiration-rail" class="resource-rail-arrow">←</button>
          <button type="button" data-rail-next aria-label="Next inspiration" aria-controls="inspiration-rail" class="resource-rail-arrow">→</button>
        </div>
      </div>
      <ul id="inspiration-rail" class="resource-rail mt-7" aria-label="Inspiration">
        {visualIdeas.map((gallery) => (
          <li class="resource-rail-card">
            <a href={`/resources/${gallery.slug}`} class="group block">
              <img src={gallery.coverImage || gallery.ideas[0].image} alt={`Design inspiration for ${gallery.title.toLowerCase()}`} loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover" />
              <p class="label mt-4 text-muted">Home inspiration</p>
              <h3 class="mt-2 text-[1.25rem] font-bold leading-snug group-hover:underline" style="font-family: var(--font-editorial)">{gallery.title}</h3>
              <span class="mt-3 inline-block text-[0.95rem] font-semibold underline underline-offset-4">Browse ideas →</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-[0.82rem] text-muted">Inspiration images are AI-generated design concepts, not photographs of actual homes or specific products.</p>
    </section>
  )}

  <section id="free-tools" aria-labelledby="tools-h" class="resource-rail-section mt-16 border-t border-rule pt-10">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="label text-muted">Make it work for your family</p>
        <h2 id="tools-h" class="mt-2 text-[1.8rem] font-bold" style="font-family: var(--font-editorial)">Tools</h2>
        <p class="mt-2 text-[0.97rem]" style="color: var(--color-prose-soft)">Free, fill-in planners, charts, and checklists.</p>
        <a href={routes.freeTools} class="mt-3 inline-block text-[0.95rem] font-semibold underline underline-offset-4">See all tools →</a>
      </div>
      <div class="resource-rail-controls flex shrink-0 gap-2">
        <button type="button" data-rail-prev aria-label="Previous tools" aria-controls="tools-rail" class="resource-rail-arrow">←</button>
        <button type="button" data-rail-next aria-label="Next tools" aria-controls="tools-rail" class="resource-rail-arrow">→</button>
      </div>
    </div>
    <ul id="tools-rail" class="resource-rail mt-7" aria-label="Free tools">
      {freeTools.map((tool) => (
        <li class="resource-rail-card border-t-2 border-ink pt-4">
          <p class="label text-muted">Free printable tool</p>
          <h3 class="mt-3 text-[1.25rem] font-bold leading-tight" style="font-family: var(--font-editorial)">
            <a href={tool.href} class="hover:underline">{tool.name}</a>
          </h3>
          <p class="mt-3 text-[0.97rem] leading-relaxed" style="color: var(--color-prose-soft)">{tool.summary}</p>
          <a href={tool.href} class="mt-5 inline-block font-semibold underline underline-offset-4">Open tool →</a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="topics-h" class="mt-16 border-t border-rule pt-12">
    <h2 id="topics-h" class="section-label">Browse by topic</h2>
    <ul class="mt-8 grid gap-8 md:grid-cols-3">
      {
        sections.map(({ pillar, articles }) => (
          <li class="border-t-2 border-ink pt-4">
            <h3 class="text-[1.3rem] leading-tight font-bold" style="font-family: var(--font-editorial)">
              {articles.length > 0 ? (
                <a href={routes.pillar(pillar.id)} class="hover:underline hover:decoration-month hover:decoration-[3px] hover:underline-offset-4">
                  {pillar.name}
                </a>
              ) : (
                pillar.name
              )}
            </h3>
            <p class="mt-2 text-[0.97rem] leading-relaxed" style="color: var(--color-prose-soft)">
              {pillar.summary}
            </p>
            {articles.length > 0 ? (
              <ul class="mt-4 space-y-2 text-[0.95rem]">
                {articles.slice(0, 4).map((a) => (
                  <li>
                    <a href={routes.article(a.id)} class="font-semibold underline decoration-rule underline-offset-4 hover:decoration-ink">
                      {a.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 text-[0.9rem] text-muted">The first guides in this topic are on the way.</p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <aside aria-label="The wall calendar" class="mt-16 overflow-hidden bg-sage-wash md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] md:items-center">
    <img
      {...calendarPhoto}
      sizes="(min-width: 768px) 420px, 100vw"
      alt="The Organized Mom Collective weekly wall calendar hanging on a wall in soft daylight, with a column for each day and sections for meals, groceries and to-dos."
      loading="lazy"
      decoding="async"
      class="block aspect-[5/4] h-auto w-full object-cover"
    />
    <div class="px-6 py-8 sm:px-10">
      <p class="label text-soft">The wall calendar</p>
      <p class="mt-2 text-[1.5rem] leading-[1.2] font-bold text-balance sm:text-[1.8rem]" style="font-family: var(--font-editorial)">
        One shared place for the family’s week.
      </p>
      <p class="mt-3 text-[1rem] leading-relaxed sm:text-[1.0625rem]" style="color: var(--color-prose-soft)">
        An 11 × 17 weekly wall calendar with room for schedules, meals, groceries, cleaning zones and priorities, plus a companion website
        for the daily cleaning checklist.
      </p>
      <a href={routes.calendar} class="btn-primary mt-6 w-full sm:w-auto">See the Wall Calendar</a>
    </div>
  </aside>
</PublicLayout>

<style>
  .resource-rail { display:grid; grid-auto-flow:column; grid-auto-columns:minmax(0, min(82vw, 320px)); gap:1.5rem; overflow-x:auto; scroll-snap-type:x mandatory; scroll-padding-inline:2px; overscroll-behavior-inline:contain; padding:2px 2px 1.5rem; scrollbar-width:thin; scrollbar-color:#b5bdb0 transparent; }
  .resource-rail-card { min-width:0; scroll-snap-align:start; }
  .resource-rail-arrow { width:2.5rem; height:2.5rem; display:grid; place-items:center; border:1px solid #c8ceca; background:transparent; font-size:1.25rem; color:inherit; }
  .resource-rail-arrow:hover:not(:disabled) { background:#e7ece5; }
  .resource-rail-arrow:disabled { opacity:.3; cursor:default; }
  .resource-rail-arrow:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  @media(min-width:768px) { .resource-rail { grid-auto-columns:minmax(0, calc((100% - 3rem)/3)); } }
  @media(max-width:639px) { .resource-rail-controls { display:none; } }
  @media(prefers-reduced-motion:reduce) { .resource-rail { scroll-behavior:auto; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.resource-rail-section').forEach((section) => {
    const rail = section.querySelector<HTMLElement>('.resource-rail');
    const previous = section.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = section.querySelector<HTMLButtonElement>('[data-rail-next]');
    if (!rail || !previous || !next) return;
    const update = () => {
      previous.disabled = rail.scrollLeft <= 2;
      next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
    };
    const step = (direction: number) => {
      const card = rail.querySelector<HTMLElement>('.resource-rail-card');
      if (!card) return;
      const gap = parseFloat(getComputedStyle(rail).columnGap) || 0;
      rail.scrollBy({ left: direction * (card.offsetWidth + gap), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    };
    previous.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    rail.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

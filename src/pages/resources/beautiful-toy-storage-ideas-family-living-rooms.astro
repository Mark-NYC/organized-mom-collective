---
import PublicLayout from '../../layouts/PublicLayout.astro';
import InspirationGallery from '../../components/resources/InspirationGallery.astro';
import { toyStorageGallery as gallery } from '../../data/toy-storage-gallery';
const ready = gallery.published && gallery.ideas.length === 49 && gallery.ideas.every(i=>Boolean(i.image));
const origin = Astro.site?.origin ?? 'https://www.organizedmomcollective.com';
const url = new URL('/resources/'+gallery.slug,origin).href;
const jsonLd = ready ? [{
  '@context':'https://schema.org','@type':'BlogPosting',
  headline:gallery.title,description:gallery.description,
  mainEntityOfPage:url,
  image:[...(gallery.coverImage ? [new URL(gallery.coverImage,origin).href] : []),...gallery.ideas.map(i=>new URL(i.image,origin).href)],
  author:{'@type':'Organization',name:'Organized Mom Collective'},
  publisher:{'@type':'Organization',name:'Organized Mom Collective'}
}] : [];
---
<PublicLayout title={gallery.seoTitle} description={gallery.description} indexable={ready} width="wide" chrome jsonLd={jsonLd} ogImage={ready?(gallery.coverImage ?? gallery.ideas[0].image):undefined}>
  <InspirationGallery gallery={gallery}/>
</PublicLayout>

---
/**
 * The brand homepage, built as a sales page for what exists today: the printed 2027
 * Family Wall Calendar plus its included cleaning companion website (/app).
 * Promise → Problem → Process → Features → Proof → Offer → Risk removal → CTA.
 *
 * Honesty rules:
 * - Sell only what exists. No planned features (shared calendar, accounts, syncing,
 *   meal or to-do tools in the companion); the wall and the phone are separate, and
 *   the copy never implies they sync. Companion facts come from src/data/cleaning.ts
 *   and the companion's real behavior (no setup, no account, saved on the phone).
 * - Prices, weeks and editions come from src/config.ts via calendarOptions(). Every
 *   shop button goes to /calendar (or its options, #buy), never straight to Etsy.
 *   While no option has a live Etsy listing, the offer says so.
 * - Calendar facts match /calendar and the Etsy listing images in design/etsy-listing/.
 *   Shipping and checkout are Etsy's: don't add shipping origins, times or guarantees.
 * - Photos and phone screenshots are real (see README → Where things live).
 * - Etsy ratings and quotes come from src/data/reviews.ts and always carry its
 *   REVIEWS_DISCLAIMER (previous calendar editions); never in structured data.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import PhoneShot from '../components/site/PhoneShot.astro';
import LiveTodayPhone from '../components/site/LiveTodayPhone.astro';
import ShopButton from '../components/site/ShopButton.astro';
import { photo } from '../lib/images';
import { calendarOptions, formatPrice } from '../lib/reorder';
import { dailyEssentials } from '../data/cleaning';
import { BRAND_NAME } from '../config';
import { ETSY_REVIEWS_URL, ETSY_SHOP_URL, REVIEWS_DISCLAIMER, reviewDate, reviews, shopStats } from '../data/reviews';

const kitchen = photo('family-kitchen');
const inUse = photo('calendar-in-use', [640, 960, 1280], '/images/reorder');
const sets = photo('calendar-sets');

const options = calendarOptions();
const byWeeks = [...options].sort((a, b) => a.weeks - b.weeks);
const half = byWeeks[0];
const anyLive = options.some((o) => o.url);

const SHOP = 'Shop the Family Calendar';
/** "15 minutes" → "15-minute" */
const resetLength = dailyEssentials.minutes.replace(/ minutes?$/, '-minute');

const problemLines = [
  'The dentist on Tuesday and the field trip form due Thursday.',
  'What’s for dinner tonight, and what’s missing from the fridge.',
  'Which room hasn’t been cleaned in two weeks.',
  'Practice times, school events and who’s driving.',
  'The little things nobody else remembers until you do.',
];

// Simple 24px line icons, one stroke weight, drawn for this page.
const icons = {
  calendar: 'M4 7.5A1.5 1.5 0 0 1 5.5 6h13A1.5 1.5 0 0 1 20 7.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-11ZM4 10.5h16M8.5 4v3.5M15.5 4v3.5M8 14h2M11 14h2M14 14h2M8 17h2',
  cleaning: 'M14.5 3.5 9 13M6.5 13h7l1 7.5h-9l1-7.5ZM9 16.5v4M12 16.5v4M18 6.5l.6 1.4L20 8.5l-1.4.6L18 10.5l-.6-1.4L16 8.5l1.4-.6L18 6.5Z',
  clock: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM12 7.5V12l3 2',
  meals: 'M4 12.5h16a8 8 0 0 1-16 0ZM9 9c0-1.2 1-1.6 1-2.8S9 4.5 9 4.5M13 9c0-1.2 1-1.6 1-2.8s-1-1.7-1-1.7M9 20.5h6',
  todos: 'M4 6.5l1.5 1.5 2.5-3M4 12.5 5.5 14l2.5-3M4.5 18h2.5v2.5H4.5V18ZM11 6.5h9M11 12.5h9M11 19.5h9',
  project: 'M4 20h16M6 20V10l6-5 6 5v10M10 20v-5h4v5',
};

type Where = 'wall' | 'phone' | 'both';
const whereLabel: Record<Where, string> = { wall: 'On the wall', phone: 'On your phone', both: 'Wall + phone' };

const features: { icon: keyof typeof icons; title: string; body: string; where: Where }[] = [
  {
    icon: 'calendar',
    title: 'Everyone knows what’s happening this week.',
    body: 'A tall column for every day, Monday to Sunday, for school runs, practices and appointments. Hung where the whole family looks.',
    where: 'wall',
  },
  {
    icon: 'cleaning',
    title: 'Know what needs cleaning today.',
    body: 'Each day is printed with one area of the house. The companion opens that zone as a short checklist.',
    where: 'both',
  },
  {
    icon: 'clock',
    title: 'Keep up without marathon cleaning days.',
    body: `A ${resetLength} Daily Reset and 10–15 minutes on weekday zones. Weekends are optional, and a missed day doesn’t pile up.`,
    where: 'phone',
  },
  {
    icon: 'meals',
    title: 'Stop wondering what’s for dinner.',
    body: 'A meal plan for every night of the week, with the grocery list right beside it.',
    where: 'wall',
  },
  {
    icon: 'todos',
    title: 'Get important tasks out of your head.',
    body: 'A to-do list and notes on every weekly page, for the things that don’t belong to one day.',
    where: 'wall',
  },
  {
    icon: 'project',
    title: 'Tackle bigger jobs one month at a time.',
    body: 'One deeper home project a month, split into small tasks for a weekend when you have time.',
    where: 'phone',
  },
];

const steps = [
  { title: 'Hang your calendar.', body: 'Put the week somewhere everyone can see it, and fill in what’s coming.' },
  { title: 'Scan the QR code once.', body: 'The companion website opens on today’s cleaning zone. Nothing to set up, no account.' },
  { title: 'Keep the week moving.', body: 'Plan on the wall. Tick off today’s cleaning on your phone.' },
];

const included = [
  '11 × 17 in weekly pages, Monday through Sunday',
  'Daily schedule, meal plan, grocery list, to-dos and notes',
  'A daily cleaning zone printed on every day',
  'Premium uncoated paper, Wire-O binding, built-in hanging hole',
  'The cleaning companion website: no subscription, no account',
];

const faqs = [
  {
    q: 'What comes with the calendar?',
    a: `The printed 11 × 17-inch weekly wall calendar (${half.weeks} weeks, or the full year as two ${half.weeks}-week sets) and access to the cleaning companion website.`,
  },
  {
    q: 'Is the companion website included?',
    a: 'Yes. It comes with every calendar at no extra cost. There’s no subscription and no account.',
  },
  {
    q: 'Do I need to download an app?',
    a: 'No. The companion opens in your phone’s browser. If you like, add it to your Home Screen so it opens with one tap.',
  },
  {
    q: 'How do I open the companion website?',
    a: 'Scan the QR code printed on your calendar with your phone’s camera. It opens on today’s cleaning zone. Your checkmarks are saved on your phone.',
  },
  {
    q: 'When does the calendar start?',
    a: 'The first page of the January–June 2027 calendar is the week of Monday, December 28, 2026, so you can start right after Christmas.',
  },
  {
    q: 'How do shipping and checkout work?',
    a: 'You buy on Etsy. Checkout, payment, shipping options and delivery details are all shown on the Etsy listing. If your calendar arrives damaged or misprinted, reach out through Etsy with your order and we’ll make it right.',
  },
];

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: BRAND_NAME,
    url: site.href,
    logo: new URL('/brand/omc-badge.png', site).href,
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: BRAND_NAME, url: site.href },
];

const wrap = 'mx-auto max-w-6xl px-5 sm:px-8';
const card = 'rounded-[8px] bg-paper shadow-[0_14px_30px_-26px_rgba(77,69,68,0.6)]';
const check = 'M4 10.5l4 4 8-9';
---

<PublicLayout
  fullTitle={`${BRAND_NAME}: Your Whole Family. One Simple System.`}
  description={`A 2027 weekly family wall calendar everyone can see, plus an included companion website for daily cleaning routines. From ${half.priceLabel} for ${half.weeks} weeks.`}
  width="full"
  jsonLd={jsonLd}
>
  <!-- Promise -->
  <section aria-labelledby="hero-h" class="overflow-hidden bg-cream">
    <div class:list={[wrap, 'grid items-center gap-10 pt-9 pb-14 sm:pt-14 md:grid-cols-[1.05fr_1fr] md:gap-12 md:py-20 lg:gap-16']}>
      <div>
        <p class="label text-warm-soft">2027 Family Wall Calendar + companion website</p>
        <h1 id="hero-h" class="serif-hero mt-4">Your Whole Family. One Simple System.</h1>
        <p class="lede mt-5 max-w-xl text-warm-ink">
          A wall calendar everyone can see. A companion website for daily cleaning and home routines. One simpler way to keep family life
          moving.
        </p>
        <p class="mt-5 text-[1rem] leading-snug text-warm-ink">
          <strong class="font-semibold">From {half.priceLabel}</strong> for {half.weeks} weeks
          <span class="text-warm-soft"> · companion website included</span>
        </p>
        <div class="mt-7">
          <ShopButton label={SHOP} to="product" cta="home-hero" class="min-h-14 w-full px-8 sm:w-auto" />
          <p class="mt-5 max-w-md text-[0.92rem] leading-snug text-warm-ink">
            <span aria-hidden="true" class="mr-1 tracking-[0.08em] text-rose-deep">★</span>{' '}
            <strong class="font-semibold">{shopStats.rating}/5</strong> from {shopStats.reviews} reviews · {shopStats.sales} sales on{' '}
            <a href={ETSY_SHOP_URL} target="_blank" rel="noopener noreferrer" class="underline decoration-warm-rule underline-offset-[3px] hover:decoration-warm-ink"
              >our Etsy shop<span class="sr-only"> (opens Etsy)</span></a
            >
            <span class="block text-[0.85rem] text-warm-soft">{REVIEWS_DISCLAIMER}</span>
          </p>
        </div>
      </div>

      <!-- The printed calendar and the real companion, cut out and set straight on the background -->
      <div class="relative mx-auto w-full max-w-[30rem] pr-[22%] pb-6 md:max-w-none md:pr-[20%] md:pb-0 lg:pr-[22%]">
        <img
          src="/images/site/calendar-cutout-720.webp"
          srcset="/images/site/calendar-cutout-480.webp 480w, /images/site/calendar-cutout-720.webp 720w, /images/site/calendar-cutout-960.webp 960w"
          sizes="(min-width: 1152px) 400px, (min-width: 768px) 36vw, 76vw"
          width="960"
          height="1410"
          fetchpriority="high"
          decoding="async"
          alt="A page of the Organized Mom Collective weekly wall calendar: a column for each day with its cleaning zone, Self-Care Habits, Word of the Week, Family and Friends, Grateful For, a meal plan, a grocery list, a to-do list and notes."
          class="block h-auto w-full"
        />
        <div class="absolute right-0 bottom-0 w-[42%] max-w-[14rem] md:-bottom-6 lg:max-w-[15rem]">
          <LiveTodayPhone />
        </div>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section aria-labelledby="problem-h" class="bg-paper">
    <div class:list={[wrap, 'grid items-center gap-10 py-16 sm:py-24 md:grid-cols-[1.1fr_1fr] md:gap-16']}>
      <div>
        <h2 id="problem-h" class="serif-title">You’re Not Just Managing a Calendar. You’re Managing Everyone’s Life.</h2>
        <ul class="mt-8 border-t border-warm-rule">
          {
            problemLines.map((line) => (
              <li class="flex gap-4 border-b border-warm-rule py-3.5 text-[1.0625rem] leading-snug">
                <span aria-hidden="true" class="mt-[0.15rem] size-5 shrink-0 rounded-[3px] border border-rule-strong" />
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-7 font-serif text-[1.3rem] leading-snug text-warm-ink italic sm:text-[1.45rem]">
          And somehow, everyone still asks you what’s going on.
        </p>
        <p class="lede mt-4">
          You don’t need to try harder. You need the plan out of your head and somewhere the whole family can see it.
        </p>
      </div>
      <figure class="-mx-5 overflow-hidden bg-band sm:mx-0 sm:rounded-[8px]">
        <img
          src={kitchen.src}
          srcset={kitchen.srcset}
          sizes="(min-width: 1152px) 500px, (min-width: 768px) 45vw, 100vw"
          width="1280"
          height="1024"
          loading="lazy"
          decoding="async"
          alt="A mom and her young daughter scooping cookie dough at the kitchen counter, with the family's filled-in weekly calendar beside them."
          class="block h-auto w-full"
        />
      </figure>
    </div>
  </section>

  <!-- One system, two places -->
  <section aria-labelledby="solution-h" class="bg-sage-wash">
    <div class:list={[wrap, 'py-16 sm:py-24']}>
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="solution-h" class="serif-title">One System. Two Places.</h2>
        <p class="lede mt-4">The family plan lives on the wall. Today’s cleaning lives on your phone.</p>
      </div>

      <div class="relative mt-10 grid gap-5 md:mt-12 md:grid-cols-2 md:gap-8">
        <article class="flex flex-col overflow-hidden rounded-[8px] bg-paper shadow-[0_20px_40px_-32px_rgba(77,69,68,0.5)]">
          <div class="h-64 overflow-hidden bg-band sm:h-80">
            <img
              src={inUse.src}
              srcset={inUse.srcset}
              sizes="(min-width: 1152px) 540px, (min-width: 768px) 46vw, calc(100vw - 2.5rem)"
              width="1280"
              height="1280"
              loading="lazy"
              decoding="async"
              alt="A hand writing in the wall calendar on a kitchen counter, its week filled with school runs, a meal plan, a grocery list and to-dos."
              class="block h-full w-full object-cover"
            />
          </div>
          <div class="p-6 sm:p-8">
            <h3 class="font-serif text-[1.5rem] leading-snug text-warm-ink">On the wall</h3>
            <p class="mt-2 text-[1.02rem] leading-relaxed">
              The family’s visible weekly plan: schedules, meals, groceries, to-dos and priorities, one week to a page.
            </p>
          </div>
        </article>

        <span
          aria-hidden="true"
          class="absolute top-[16rem] left-1/2 z-10 hidden size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-warm-rule bg-paper font-serif text-[1.8rem] text-rose-deep shadow-sm sm:top-[20rem] md:grid"
          >+</span
        >

        <article class="flex flex-col overflow-hidden rounded-[8px] bg-paper shadow-[0_20px_40px_-32px_rgba(77,69,68,0.5)]">
          <div class="flex h-64 items-start justify-center overflow-hidden bg-cream px-6 pt-7 sm:h-80">
            <div class="w-[11.5rem] sm:w-[13rem]">
              <PhoneShot name="week" alt="The cleaning companion's Week screen: each day's cleaning zone from the calendar, with today's progress." />
            </div>
          </div>
          <div class="p-6 sm:p-8">
            <h3 class="font-serif text-[1.5rem] leading-snug text-warm-ink">On your phone</h3>
            <p class="mt-2 text-[1.02rem] leading-relaxed">
              The companion website: today’s cleaning zone as a short checklist, a {resetLength} Daily Reset and one home project a month.
            </p>
          </div>
        </article>
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-[0.95rem] leading-relaxed text-warm-soft">
        The cleaning zones are printed on the calendar, and the companion follows the same ones. Nothing to sync, nothing to set up.
      </p>
      <div class="mt-8 text-center">
        <ShopButton label={SHOP} to="product" cta="home-system" class="min-h-14 w-full px-8 sm:w-auto" />
      </div>
    </div>
  </section>

  <!-- Process -->
  <section aria-labelledby="how-h" class="bg-paper">
    <div class:list={[wrap, 'py-16 sm:py-20']}>
      <h2 id="how-h" class="serif-title mx-auto max-w-2xl text-center">How It Works</h2>
      <ol class="mt-10 grid gap-4 md:grid-cols-3 md:gap-6">
        {
          steps.map((s, i) => (
            <li class="flex gap-5 rounded-[8px] border border-warm-rule bg-ivory p-6 md:flex-col md:gap-0 md:p-7">
              <span aria-hidden="true" class="font-serif text-[2.6rem] leading-none text-rose md:text-[3rem]">
                {i + 1}
              </span>
              <div class="md:mt-4">
                <h3 class="text-[1.15rem] leading-snug font-bold text-warm-ink">
                  <span class="sr-only">{i + 1}. </span>
                  {s.title}
                </h3>
                <p class="mt-1.5 text-[1rem] leading-relaxed">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Features and benefits -->
  <section aria-labelledby="features-h" class="bg-cream">
    <div class:list={[wrap, 'py-16 sm:py-24']}>
      <h2 id="features-h" class="serif-title mx-auto max-w-2xl text-center">What Gets Easier This Week</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
        {
          features.map((f) => (
            <li class:list={[card, 'flex gap-4 p-5 sm:flex-col sm:gap-0 sm:p-7']}>
              <div class="flex shrink-0 items-start justify-between gap-3">
                <span aria-hidden="true" class="grid size-11 place-items-center rounded-full bg-rose-wash text-rose-deep">
                  <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d={icons[f.icon]} />
                  </svg>
                </span>
                <span class="hidden pt-3 text-[0.62rem] font-semibold tracking-[0.14em] text-warm-soft uppercase sm:block">{whereLabel[f.where]}</span>
              </div>
              <div class="sm:mt-5">
                <p class="text-[0.62rem] font-semibold tracking-[0.14em] text-warm-soft uppercase sm:hidden">{whereLabel[f.where]}</p>
                <h3 class="mt-1 text-[1.08rem] leading-snug font-bold text-warm-ink sm:mt-0 sm:text-[1.12rem]">{f.title}</h3>
                <p class="mt-1.5 text-[0.98rem] leading-relaxed sm:mt-2 sm:text-[1rem]">{f.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Proof: Etsy reviews of previous calendar editions (src/data/reviews.ts) -->
  <section aria-labelledby="reviews-h" class="bg-paper">
    <div class:list={[wrap, 'py-16 sm:py-24']}>
      <div class="mx-auto max-w-2xl text-center">
        <p class="label text-warm-soft">From our Etsy shop</p>
        <h2 id="reviews-h" class="serif-title mt-3">What Families Said About Our Calendars.</h2>
      </div>

      <dl class="mx-auto mt-10 grid max-w-3xl grid-cols-3 divide-x divide-warm-rule border-y border-warm-rule text-center">
        <div class="flex flex-col-reverse gap-1 px-2 py-5 sm:py-6">
          <dt class="text-[0.78rem] leading-snug text-warm-soft sm:text-[0.85rem]">Etsy shop rating</dt>
          <dd class="font-serif text-[1.75rem] leading-none text-warm-ink sm:text-[2.3rem]">
            {shopStats.rating}<span class="text-[0.55em] text-warm-soft">/5</span>
          </dd>
        </div>
        <div class="flex flex-col-reverse gap-1 px-2 py-5 sm:py-6">
          <dt class="text-[0.78rem] leading-snug text-warm-soft sm:text-[0.85rem]">Shop reviews</dt>
          <dd class="font-serif text-[1.75rem] leading-none text-warm-ink sm:text-[2.3rem]">{shopStats.reviews}</dd>
        </div>
        <div class="flex flex-col-reverse gap-1 px-2 py-5 sm:py-6">
          <dt class="text-[0.78rem] leading-snug text-warm-soft sm:text-[0.85rem]">Shop sales</dt>
          <dd class="font-serif text-[1.75rem] leading-none text-warm-ink sm:text-[2.3rem]">{shopStats.sales}</dd>
        </div>
      </dl>

      <ul class="mt-10 grid gap-4 sm:mt-12 md:grid-cols-[1.45fr_1fr_1fr] md:gap-6">
        {
          reviews.map((r, i) => (
            <li class="flex">
              <figure class:list={['flex w-full flex-col p-6 sm:p-7', i === 0 ? 'rounded-[8px] bg-blush-wash' : 'rounded-[8px] bg-cream']}>
                <span aria-hidden="true" class="font-serif text-[3rem] leading-[0.6] text-rose">“</span>
                <blockquote
                  cite={ETSY_REVIEWS_URL}
                  class:list={[
                    'mt-3 flex-1 font-serif leading-snug text-warm-ink italic',
                    i === 0 ? 'text-[1.4rem] sm:text-[1.6rem]' : 'text-[1.1rem] sm:text-[1.15rem]',
                  ]}
                >
                  <p>{r.quote}</p>
                </blockquote>
                <figcaption class="mt-6 border-t border-warm-rule pt-4 text-[0.9rem] leading-snug">
                  <span class="block font-semibold text-warm-ink">{r.name}</span>
                  <span class="block text-warm-soft">
                    <time datetime={r.date}>{reviewDate(r.date)}</time>
                    {r.excerpt && ' · Excerpt'}
                  </span>
                  <a
                    href={ETSY_REVIEWS_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-block text-[0.8rem] text-warm-soft underline decoration-warm-rule underline-offset-[3px] hover:text-warm-ink hover:decoration-warm-ink"
                  >
                    Read the review on Etsy <span aria-hidden="true">↗</span><span class="sr-only"> (opens Etsy)</span>
                  </a>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <p class="mx-auto mt-8 max-w-2xl text-center text-[0.88rem] leading-relaxed text-balance text-soft">
        {REVIEWS_DISCLAIMER} They aren’t reviews of the 2027 redesign or the companion website.{' '}
        <a href={ETSY_SHOP_URL} target="_blank" rel="noopener noreferrer" class="underline decoration-warm-rule underline-offset-[3px] hover:decoration-warm-ink"
          >Visit our Etsy shop<span class="sr-only"> (opens Etsy)</span></a
        >
      </p>
    </div>
  </section>

  <!-- Offer, risk removal and questions -->
  <section id="offer" aria-labelledby="offer-h" class="bg-sage-wash">
    <div class:list={[wrap, 'py-16 sm:py-24']}>
      <div class="mx-auto max-w-2xl text-center">
        <p class="label text-warm-soft">The 2027 Family Wall Calendar</p>
        <h2 id="offer-h" class="serif-title mt-3">Choose How Far Ahead You Plan.</h2>
        <p class="lede mt-4">Same calendar, same companion website. Pick half a year or the whole year.</p>
      </div>

      <ul class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-2 sm:gap-6 md:mt-12">
        {
          options.map((o) => (
            <li class:list={['flex flex-col rounded-[8px] p-6 sm:p-7', o.bestValue ? 'border-2 border-warm-button bg-paper' : 'border border-warm-rule bg-ivory']}>
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-[1.1rem] leading-tight font-bold text-warm-ink">{o.name}</h3>
                {o.bestValue && (
                  <span class="shrink-0 rounded-full bg-rose-wash px-2.5 py-1 text-[0.6rem] leading-none font-bold tracking-[0.14em] text-warm-ink uppercase">
                    Best value
                  </span>
                )}
              </div>
              <p class="mt-3 font-serif text-[2.6rem] leading-none text-warm-ink">{o.priceLabel}</p>
              <p class="mt-2 text-[1rem] font-semibold text-warm-ink">{o.weeks} weeks</p>
              <p class="mt-1 text-[0.95rem] leading-snug text-warm-soft">
                {o.setsWeeks > 0 ? `All of 2027, as two ${o.setsWeeks}-week sets.` : `${o.editions.map((e) => e.label).join(' or ')}.`}
              </p>
              {o.save > 0 && <p class="mt-3 text-[0.95rem] leading-snug font-semibold text-warm-ink">{formatPrice(o.save)} less than two half-year calendars.</p>}
            </li>
          ))
        }
      </ul>

      <div class="mx-auto mt-6 grid max-w-4xl items-center gap-6 sm:mt-8 md:grid-cols-[1fr_1.1fr] md:gap-8">
        <div class="rounded-[10px] bg-paper p-6 shadow-[0_24px_50px_-40px_rgba(77,69,68,0.6)] sm:p-8 md:order-last">
          <p class="label text-warm-soft">Every calendar includes</p>
          <ul class="mt-3 border-t border-warm-rule">
            {
              included.map((item) => (
                <li class="flex gap-3 border-b border-warm-rule py-3 text-[1rem] leading-snug text-warm-ink">
                  <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-[0.15rem] size-5 shrink-0 text-rose-deep" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d={check} />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
          <ShopButton label={SHOP} to="options" cta="home-offer" class="mt-7 min-h-14 w-full px-4" />
          <ul class="mt-5 space-y-1.5 text-[0.92rem] leading-snug text-warm-soft">
            <li>Secure checkout on Etsy.</li>
            <li>Arrives damaged or misprinted? We’ll make it right.</li>
            {!anyLive && <li>The 2027 Etsy listings are coming soon.</li>}
          </ul>
        </div>
        <figure class="overflow-hidden rounded-[8px] bg-paper">
          <img
            src={sets.src}
            srcset={sets.srcset}
            sizes="(min-width: 1152px) 420px, (min-width: 768px) 42vw, calc(100vw - 2.5rem)"
            width="2000"
            height="2000"
            loading="lazy"
            decoding="async"
            alt="A full year as two 26-week sets, January to June and July to December, each month in its own soft color."
            class="block h-auto w-full"
          />
        </figure>
      </div>

      <div class="mx-auto mt-16 max-w-3xl">
        <h2 id="faq-h" class="serif-title text-center text-[1.6rem] sm:text-[2rem]">Questions Before You Buy</h2>
        <div class="mt-8 border-t border-warm-rule">
          {
            faqs.map((f) => (
              <details class="group border-b border-warm-rule">
                <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 text-[1.05rem] leading-snug font-semibold text-warm-ink [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <span aria-hidden="true" class="shrink-0 text-[1.25rem] font-normal text-warm-soft transition-transform group-open:rotate-45">
                    +
                  </span>
                </summary>
                <p class="pb-5 text-[1rem] leading-relaxed text-warm-soft">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section aria-labelledby="close-h" class="bg-warm-button text-white">
    <div class="mx-auto max-w-2xl px-5 py-16 text-center sm:px-8 sm:py-20">
      <h2 id="close-h" class="font-serif text-[1.95rem] leading-[1.12] tracking-[-0.015em] text-balance sm:text-[2.6rem]">
        Less Managing Everything. More Enjoying Your Family.
      </h2>
      <p class="lede mt-5 text-white/85">Get the week out of your head and onto the wall, where everyone can see it.</p>
      <ShopButton label={SHOP} to="product" cta="home-close" class="mt-8 min-h-14 w-full bg-paper px-8 text-warm-ink hover:bg-cream sm:w-auto" />
      <p class="mt-4 text-[0.9rem] text-white/75">From {half.priceLabel} · companion website included</p>
    </div>
  </section>
</PublicLayout>

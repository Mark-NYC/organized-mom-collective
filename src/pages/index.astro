---
/**
 * The brand homepage, built as a sales page for what exists today: the printed 2027
 * Family Wall Calendar plus its included cleaning companion website (/app).
 * Hero → Mental load → Product (wall + phone) → Benefits → Testimonial → How it works
 * → Pricing → FAQ → Final CTA.
 *
 * Honesty rules:
 * - Sell only what exists. No planned features (shared calendar, accounts, syncing,
 *   meal or to-do tools in the companion); the wall and the phone are separate, and
 *   the copy never implies they sync. Companion facts come from src/data/cleaning.ts
 *   and the companion's real behavior (no setup, no account, saved on the phone).
 * - Prices, weeks and editions come from src/config.ts via calendarOptions(). Every
 *   shop button goes to /calendar (or its options, #buy), never straight to Etsy.
 *   Nothing reads as buyable until its Etsy listing is live: until then buttons say "See",
 *   and the pricing cards say "Coming soon to Etsy". The 26-week calendar is the first
 *   print run's main offer (PRIMARY_OPTION_ID); the full year is the secondary option.
 * - Calendar facts match /calendar and the Etsy listing images in design/etsy-listing/.
 *   Shipping and checkout are Etsy's: don't add shipping origins, times or guarantees.
 * - Photos and phone screenshots are real (see README → Where things live). The hero's
 *   breakfast photo (family-breakfast) sells the feeling: it's not a customer, and the calendar
 *   in its background is not a reference for the printed layout. The product section below
 *   shows the real calendar and companion. No founder story until there's authentic founder
 *   information and a real photo.
 * - Etsy ratings and quotes come from src/data/reviews.ts and always carry its
 *   REVIEWS_DISCLAIMER (previous calendar editions); never in structured data.
 *   The one customer testimonial (Camille S.) also lives there, quoted word for word, and is
 *   never labeled as a review of the 2027 edition. Every CTA carries data-cta (src/lib/analytics.ts).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import PhoneShot from '../components/site/PhoneShot.astro';
import ShopButton from '../components/site/ShopButton.astro';
import EntrywayScene from '../components/site/EntrywayScene.astro';
import { photo } from '../lib/images';
import { routes } from '../routes';
import { calendarOptions, formatPrice } from '../lib/reorder';
import { BRAND_NAME, PRIMARY_OPTION_ID } from '../config';
import { ETSY_REVIEWS_URL, ETSY_SHOP_URL, REVIEWS_DISCLAIMER, review, reviewDate, shopStats, testimonial } from '../data/reviews';

const family = photo('family-breakfast', [640, 960, 1280, 1536]);
const held = photo('calendar-held', [640, 960, 1254]);
const kitchen = photo('family-kitchen');
const inUse = photo('calendar-in-use', [640, 960, 1280], '/images/reorder');

const options = calendarOptions();
const byWeeks = [...options].sort((a, b) => a.weeks - b.weeks);
const half = byWeeks[0];
const full = byWeeks[byWeeks.length - 1];
const anyLive = options.some((o) => o.url);
/** The first print run's main offer first, then the rest. */
const primary = options.find((o) => o.id === PRIMARY_OPTION_ID) ?? half;
const others = options.filter((o) => o.id !== primary.id);
/** "Shop" only once something can actually be bought. */
const SHOP_CLOSE = anyLive ? 'Shop the 2027 Calendar' : 'See the 2027 Calendar';

const [quoteBefore, quoteAfter] = testimonial.quote.split(testimonial.highlight);
/** Two Etsy reviews that add something Camille's quote doesn't: print quality and service. */
const supporting = [review('quality'), review('service')];

const loadLines = ['What’s for dinner?', 'Who needs to be where?', 'When was the bathroom last cleaned?', 'What’s coming up this weekend?'];

// Simple 24px line icons, one stroke weight, drawn for this page.
const icons = {
  calendar: 'M4 7.5A1.5 1.5 0 0 1 5.5 6h13A1.5 1.5 0 0 1 20 7.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-11ZM4 10.5h16M8.5 4v3.5M15.5 4v3.5M8 14h2M11 14h2M14 14h2M8 17h2',
  meals: 'M4 12.5h16a8 8 0 0 1-16 0ZM9 9c0-1.2 1-1.6 1-2.8S9 4.5 9 4.5M13 9c0-1.2 1-1.6 1-2.8s-1-1.7-1-1.7M9 20.5h6',
  cleaning: 'M14.5 3.5 9 13M6.5 13h7l1 7.5h-9l1-7.5ZM9 16.5v4M12 16.5v4M18 6.5l.6 1.4L20 8.5l-1.4.6L18 10.5l-.6-1.4L16 8.5l1.4-.6L18 6.5Z',
};

const benefits: { icon: keyof typeof icons; title: string; body: string }[] = [
  {
    icon: 'calendar',
    title: 'Know What’s Coming',
    body: 'Appointments, activities, meals, and priorities all have a place. Less scrambling to remember what’s next.',
  },
  {
    icon: 'meals',
    title: 'Make Fewer Decisions',
    body: 'Plan dinners and groceries before the week gets busy. Give yourself fewer things to figure out at 5 PM.',
  },
  {
    icon: 'cleaning',
    title: 'Keep the House Moving',
    body: 'A simple daily cleaning routine helps you know what needs attention without starting from scratch every morning.',
  },
];

/** Mechanics only: the outcomes are in `benefits`, so the steps don't repeat them. */
const steps = [
  { title: 'Hang your calendar', body: 'Somewhere the whole family walks past every day.' },
  { title: 'Plan your week', body: 'A few minutes with a pen. Fill in what matters and skip the rest.' },
  { title: 'Scan the QR code once', body: 'The cleaning companion opens on your phone with today’s tasks. No app, no account.' },
];

const priceCopy: Record<string, { cta: string; note: string }> = {
  [half.id]: { cta: 'Choose Half-Year', note: 'A great way to get started.' },
  [full.id]: { cta: 'Choose Full-Year', note: `Twice the planning for just ${formatPrice(full.price - half.price)} more.` },
};
/** Where an option's button goes: its live Etsy listing, else the options on /calendar. */
const optionHref = (o: (typeof options)[number]) => o.url ?? routes.buy;

const faqs = [
  {
    q: 'What exactly comes with the calendar?',
    a: `A printed 11 × 17-inch weekly wall calendar (${half.weeks} weeks, or the full year as two ${half.weeks}-week sets) with room for the family schedule, meals, groceries, to-dos, priorities and a daily cleaning zone. Access to the cleaning companion website is included.`,
  },
  {
    q: 'Is the cleaning companion included?',
    a: 'Yes, with every calendar, at no extra cost. Scan the QR code printed on the calendar and it opens in your phone’s browser. No subscription, no account, nothing to download.',
  },
  {
    q: 'Do I have to use every section?',
    a: 'No. Start with what helps, like the schedule and dinners, and leave the rest blank. In the companion, a missed day doesn’t put you behind.',
  },
  {
    q: 'How big is the calendar?',
    a: '11 × 17 inches in portrait, one week to a page, Monday through Sunday. It hangs from its Wire-O binding with a built-in hanging hole.',
  },
  {
    q: 'When does the 2027 calendar start?',
    a: 'The first page of the January–June 2027 calendar is the week of Monday, December 28, 2026, so you can start right after Christmas.',
  },
  {
    q: 'Where do I buy it, and how does shipping work?',
    a: 'On Etsy. Checkout, payment, shipping options and delivery details are all shown on the Etsy listing. If your calendar arrives damaged or misprinted, reach out through Etsy with your order and we’ll make it right.',
  },
];

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: BRAND_NAME,
    url: site.href,
    logo: new URL('/brand/omc-badge.png', site).href,
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: BRAND_NAME, url: site.href },
];

const wrap = 'mx-auto max-w-6xl px-5 sm:px-8';
const pad = 'py-12 sm:py-20 md:py-24';
const card = 'rounded-[10px] bg-paper shadow-[0_20px_40px_-32px_rgba(77,69,68,0.5)]';
const cta = 'min-h-14 w-full px-8 sm:w-auto';
---

<PublicLayout
  fullTitle={`${BRAND_NAME}: 2027 Family Wall Calendar + Cleaning Companion`}
  description={`Less to remember, more room to breathe. A 2027 weekly family wall calendar for schedules, meals and groceries, plus an included cleaning companion website. From ${half.priceLabel} for ${half.weeks} weeks.`}
  width="full"
  jsonLd={jsonLd}
>
  <!-- 1. Hero. Phones: headline, product photo, CTA. Desktop: copy left, photo right. -->
  <section aria-labelledby="hero-h" class="overflow-hidden bg-cream">
    <div
      class:list={[
        wrap,
        'grid items-center gap-x-12 gap-y-6 pt-7 pb-12 sm:pt-12 md:grid-cols-[1.05fr_1fr] md:gap-y-0 md:py-20 lg:gap-x-16',
        "[grid-template-areas:'head'_'img'_'body'] md:[grid-template-areas:'head_img'_'body_img']",
      ]}
    >
      <div class="[grid-area:head] md:self-end">
        <p class="label text-warm-soft">Your week, a little lighter</p>
        <h1 id="hero-h" class="serif-hero mt-3 sm:mt-4">Less to Remember. More Room to Breathe.</h1>
      </div>

      <!-- The feeling: one complete, unedited photo, 4:3 so all three faces stay in frame. -->
      <figure class="-mx-5 overflow-hidden bg-band [grid-area:img] sm:mx-0 sm:rounded-[10px]">
        <img
          src={family.src}
          srcset={family.srcset}
          sizes="(min-width: 1152px) 520px, (min-width: 768px) 46vw, 100vw"
          width="1536"
          height="1024"
          fetchpriority="high"
          decoding="async"
          alt="A mom laughing with her son and daughter over breakfast at the kitchen table, a filled-in wall calendar hanging in the background."
          class="block aspect-[4/3] h-auto w-full object-cover object-[60%_50%]"
        />
      </figure>

      <div class="[grid-area:body] md:self-start md:pt-6">
        <p class="lede max-w-xl text-warm-ink">
          One simple wall calendar and cleaning companion to plan your week, keep the house moving, and clear some of the mental load.
        </p>
        <div class="mt-6 sm:mt-7">
          <ShopButton label="See the Calendar" to="product" cta="home-hero" class={cta} />
        </div>
        <p class="mt-4 text-[0.95rem] leading-snug text-warm-soft">
          <span class="whitespace-nowrap">2027 Family Wall Calendar</span> · <strong class="font-semibold whitespace-nowrap text-warm-ink">Starting at {half.priceLabel}</strong> ·{' '}
          <span class="whitespace-nowrap">Cleaning Companion Included</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Entryway scene: shown once its real photos exist (design/entryway/README.md) -->
  <EntrywayScene />

  <!-- 2. The mental load -->
  <section aria-labelledby="load-h" class="bg-paper">
    <div class:list={[wrap, pad, 'grid items-center gap-10 md:grid-cols-[1.1fr_1fr] md:gap-16']}>
      <div>
        <h2 id="load-h" class="serif-title">You’re Carrying Enough in Your Head Already.</h2>
        <ul class="mt-7 border-t border-warm-rule">
          {
            loadLines.map((line) => (
              <li class="flex gap-4 border-b border-warm-rule py-3.5 text-[1.0625rem] leading-snug text-warm-ink">
                <span aria-hidden="true" class="mt-[0.15rem] size-5 shrink-0 rounded-[3px] border border-rule-strong" />
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
        <p class="lede mt-6">It’s a lot to keep track of. And somehow, most of it ends up in your head.</p>
        <p class="mt-5 font-serif text-[1.3rem] leading-snug text-warm-ink italic sm:text-[1.45rem]">
          Your home needs a plan that doesn’t depend on you remembering everything.
        </p>
      </div>
      <figure class="-mx-5 overflow-hidden bg-band sm:mx-0 sm:rounded-[10px]">
        <img
          src={kitchen.src}
          srcset={kitchen.srcset}
          sizes="(min-width: 1152px) 500px, (min-width: 768px) 45vw, 100vw"
          width="1280"
          height="1024"
          loading="lazy"
          decoding="async"
          alt="A mom and her young daughter scooping cookie dough at the kitchen counter, with the family's filled-in weekly calendar beside them."
          class="block h-auto w-full"
        />
      </figure>
    </div>
  </section>

  <!-- 3. Product reveal: the wall and the phone, side by side (they don't sync) -->
  <section aria-labelledby="product-h" class="bg-sage-wash">
    <div class:list={[wrap, pad]}>
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="product-h" class="serif-title">One Place for the Plans.<br class="hidden sm:inline" /> A Little Help for Everything Else.</h2>
        <p class="lede mt-4">
          The {BRAND_NAME} combines a large weekly wall calendar with a simple cleaning companion website. So your family’s plans have a place
          to live, and you have a little help staying on top of the house.
        </p>
      </div>

      <div class="mt-9 grid gap-5 md:mt-12 md:grid-cols-2 md:gap-8">
        <article class:list={[card, 'flex flex-col overflow-hidden']}>
          <div class="aspect-[4/3] overflow-hidden bg-band">
            <img
              src={held.src}
              srcset={held.srcset}
              sizes="(min-width: 1152px) 540px, (min-width: 768px) 46vw, calc(100vw - 2.5rem)"
              width="1254"
              height="1254"
              loading="lazy"
              decoding="async"
              alt="A smiling woman holding up the 2027 Family Wall Calendar, open to the week of January 4, to show its 11 × 17-inch size."
              class="block h-full w-full object-cover object-[50%_55%]"
            />
          </div>
          <div class="p-6 sm:p-8">
            <p class="label text-warm-soft">The printed calendar</p>
            <h3 class="mt-2 font-serif text-[1.6rem] leading-snug text-warm-ink">On Your Wall</h3>
            <p class="mt-2 text-[1.02rem] leading-relaxed">See the family’s schedule, meals, groceries, and priorities together. 11 × 17 inches, one week to a page.</p>
          </div>
        </article>

        <article class:list={[card, 'flex flex-col overflow-hidden']}>
          <div class="flex aspect-[4/3] items-start justify-center overflow-hidden bg-cream px-6 pt-7">
            <div class="w-[11.5rem] sm:w-[13.5rem]">
              <PhoneShot name="today" alt="The cleaning companion's Today screen: today's cleaning zone as a short checklist, with some tasks checked off." />
            </div>
          </div>
          <div class="p-6 sm:p-8">
            <p class="label text-warm-soft">The cleaning companion website</p>
            <h3 class="mt-2 font-serif text-[1.6rem] leading-snug text-warm-ink">On Your Phone</h3>
            <p class="mt-2 text-[1.02rem] leading-relaxed">See today’s cleaning tasks, check off what’s done, and keep track of your progress.</p>
          </div>
        </article>
      </div>

      <p class="mx-auto mt-7 max-w-2xl text-center text-[0.95rem] leading-relaxed text-balance text-warm-soft">
        The cleaning zones are printed on the calendar, and the companion follows the same ones. Nothing to sync, nothing to set up.
      </p>
      <div class="mt-7 text-center">
        <ShopButton label="Explore the Calendar" to="product" cta="home-product" class={cta} />
      </div>
    </div>
  </section>

  <!-- 4. Three core benefits: open columns with rules, so they read differently from the product cards -->
  <section aria-labelledby="benefits-h" class="bg-cream">
    <div class:list={[wrap, pad]}>
      <h2 id="benefits-h" class="serif-title mx-auto max-w-2xl text-center">What Gets Easier This Week</h2>
      <ul class="mt-8 grid border-t border-warm-rule md:mt-12 md:grid-cols-3 md:border-t-0">
        {
          benefits.map((b) => (
            <li class="flex gap-4 border-b border-warm-rule py-6 md:flex-col md:gap-4 md:border-b-0 md:border-l md:px-8 md:py-2 md:first:border-l-0 md:first:pl-0 md:last:pr-0">
              <span aria-hidden="true" class="grid size-11 shrink-0 place-items-center rounded-full bg-rose-wash text-rose-deep">
                <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d={icons[b.icon]} />
                </svg>
              </span>
              <div>
                <h3 class="font-serif text-[1.35rem] leading-snug text-warm-ink sm:text-[1.5rem]">{b.title}</h3>
                <p class="mt-1.5 text-[1rem] leading-relaxed">{b.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Featured testimonial (Camille S.), then Etsy reviews of previous editions (src/data/reviews.ts) -->
  <section aria-labelledby="reviews-h" class="bg-blush-wash">
    <div class:list={[wrap, pad]}>
      <h2 id="reviews-h" class="serif-title mx-auto max-w-2xl text-center">A Little More Calm in Real Homes.</h2>

      <figure class="mx-auto mt-8 max-w-3xl text-center sm:mt-10">
        <span aria-hidden="true" class="block font-serif text-[4rem] leading-[0.6] text-rose">“</span>
        <blockquote class="mt-6 font-serif text-[1.45rem] leading-[1.42] text-balance text-warm-ink italic sm:text-[1.9rem]">
          <p>
            {quoteBefore}<span class="box-decoration-clone bg-[linear-gradient(transparent_60%,color-mix(in_srgb,var(--color-rose)_28%,transparent)_60%,color-mix(in_srgb,var(--color-rose)_28%,transparent)_92%,transparent_92%)] px-0.5">{testimonial.highlight}</span>{quoteAfter}
          </p>
        </blockquote>
        <figcaption class="mx-auto mt-7 w-fit border-t border-rose/40 px-6 pt-4 text-[1rem] font-semibold tracking-[0.02em] text-warm-ink">
          {testimonial.name}
        </figcaption>
      </figure>

      <div class="mx-auto mt-12 max-w-3xl border-t border-rose/30 pt-8">
        <h3 class="label text-center text-warm-ink">From our Etsy shop: earlier calendar editions</h3>
        <p class="mx-auto mt-2 max-w-xl text-center text-[0.9rem] leading-relaxed text-balance text-warm-soft">
          These reviews are of the family calendars we sold before the 2027 redesign. They aren’t reviews of the 2027 calendar or the cleaning companion.
        </p>
      </div>
      <ul class="mx-auto mt-5 grid max-w-3xl gap-4 sm:grid-cols-2 sm:gap-5">
        {
          supporting.map((r) => (
            <li class="flex">
              <figure class="flex w-full flex-col rounded-[8px] bg-paper/80 p-5 sm:p-6">
                <blockquote cite={ETSY_REVIEWS_URL} class="flex-1 font-serif text-[1.08rem] leading-snug text-warm-ink italic">
                  <p>“{r.quote}”</p>
                </blockquote>
                <figcaption class="mt-4 text-[0.88rem] leading-snug text-warm-soft">
                  <span class="font-semibold text-warm-ink">{r.name}</span> · Etsy review, <time datetime={r.date}>{reviewDate(r.date)}</time>
                  {r.excerpt && ' · Excerpt'}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <p class="mx-auto mt-6 max-w-2xl text-center text-[0.85rem] leading-relaxed text-balance text-warm-soft">
        Etsy shop: {shopStats.rating}/5 from {shopStats.reviews} reviews, {shopStats.sales} sales, all items. {REVIEWS_DISCLAIMER}{' '}
        <a href={ETSY_SHOP_URL} target="_blank" rel="noopener noreferrer" class="underline decoration-warm-rule underline-offset-[3px] hover:text-warm-ink hover:decoration-warm-ink"
          >Visit our Etsy shop<span class="sr-only"> (opens Etsy)</span></a
        >
      </p>
    </div>
  </section>

  <!-- 6. How it works: the filled-in calendar beside three short steps (mechanics, not benefits) -->
  <section aria-labelledby="steps-h" class="bg-paper">
    <div class:list={[wrap, pad, 'grid items-center gap-9 md:grid-cols-[1fr_1.05fr] md:gap-16']}>
      <figure class="-mx-5 overflow-hidden bg-band sm:mx-0 sm:rounded-[10px]">
        <img
          src={inUse.src}
          srcset={inUse.srcset}
          sizes="(min-width: 1152px) 520px, (min-width: 768px) 46vw, 100vw"
          width="1280"
          height="1280"
          loading="lazy"
          decoding="async"
          alt="A hand writing in the wall calendar on a kitchen counter, its week filled with school runs, a meal plan, a grocery list and to-dos."
          class="block aspect-[4/3] h-auto w-full object-cover object-[50%_40%] md:aspect-square"
        />
      </figure>
      <div>
        <h2 id="steps-h" class="serif-title">A Calmer Week Starts Here.</h2>
        <p class="lede mt-4">Three simple steps to give your week a little more structure.</p>
        <ol class="mt-7 border-t border-warm-rule">
          {
            steps.map((st, i) => (
              <li class="flex gap-5 border-b border-warm-rule py-4">
                <span aria-hidden="true" class="w-6 shrink-0 font-serif text-[2rem] leading-none text-rose">
                  {i + 1}
                </span>
                <div>
                  <h3 class="text-[1.05rem] leading-snug font-bold text-warm-ink">
                    <span class="sr-only">{i + 1}. </span>
                    {st.title}
                  </h3>
                  <p class="mt-1 text-[1rem] leading-relaxed">{st.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="mt-6 font-serif text-[1.15rem] leading-snug text-warm-ink italic sm:text-[1.25rem]">
          Start with what helps. You don’t need a perfect routine or every box filled in.
        </p>
        <div class="mt-6">
          <ShopButton label="See How It Works" to="product" cta="home-steps" class={cta} />
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Pricing. The 26-week calendar leads (first print run); the full year is the secondary option.
       A button says "Choose" and goes to Etsy only once that option's listing is live; until then
       the card says "Coming soon to Etsy" and links to the details on /calendar#buy. -->
  <section id="offer" aria-labelledby="offer-h" class="bg-sage-wash">
    <div class:list={[wrap, pad]}>
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="offer-h" class="serif-title">Choose How Far Ahead You Want to Plan.</h2>
        <p class="lede mt-4">Same calendar. Same companion. Just choose how many weeks you want.</p>
      </div>

      <ul class="mx-auto mt-9 grid max-w-3xl gap-4 sm:grid-cols-[1.15fr_1fr] sm:items-center sm:gap-6 md:mt-12">
        {
          [primary, ...others].map((o) => {
            const main = o.id === primary.id;
            return (
              <li
                class:list={[
                  'flex flex-col rounded-[10px]',
                  main ? 'border-2 border-warm-button bg-paper p-6 shadow-[0_24px_50px_-36px_rgba(77,69,68,0.7)] sm:p-8' : 'border border-warm-rule bg-ivory p-6 sm:p-7',
                ]}
              >
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="text-[1.1rem] leading-tight font-bold text-warm-ink">{o.name}</h3>
                  {main && (
                    <span class="rounded-full bg-rose-wash px-2.5 py-1 text-[0.62rem] leading-none font-bold tracking-[0.14em] text-warm-ink uppercase">
                      Start here
                    </span>
                  )}
                </div>
                <p class:list={['mt-4 font-serif leading-none text-warm-ink', main ? 'text-[3.1rem]' : 'text-[2.5rem]']}>{o.priceLabel}</p>
                <p class="mt-2 text-[1rem] font-semibold text-warm-ink">{o.weeks} weeks</p>
                <p class="mt-1 text-[0.9rem] leading-snug text-warm-soft">
                  {o.setsWeeks > 0 ? `All of 2027, as two ${o.setsWeeks}-week sets` : o.editions.map((e) => e.label).join(' or ')}
                </p>
                <p class="mt-4 mb-6 text-[1rem] leading-snug text-warm-ink">{priceCopy[o.id].note}</p>
                {o.url ? (
                  <a
                    href={optionHref(o)}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-cta={`home-price-${o.id}`}
                    class:list={['mt-auto min-h-14 w-full gap-2 px-4', main ? 'btn-primary' : 'btn-secondary border-warm-button text-[0.75rem] text-warm-ink hover:bg-warm-button']}
                  >
                    {priceCopy[o.id].cta} on Etsy <span aria-hidden="true">↗</span>
                    <span class="sr-only"> (opens Etsy)</span>
                  </a>
                ) : (
                  <div class="mt-auto">
                    <p class="flex min-h-14 items-center justify-center rounded-[3px] border border-dashed border-warm-rule px-4 text-center text-[0.75rem] font-semibold tracking-[0.16em] text-warm-soft uppercase">
                      Coming soon to Etsy
                    </p>
                    <a href={optionHref(o)} data-cta={`home-price-${o.id}`} class="text-link mt-4 inline-block text-warm-ink">
                      See the details
                    </a>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>

      <ul class="mx-auto mt-7 max-w-2xl space-y-1.5 text-center text-[0.95rem] leading-snug text-warm-soft">
        <li class="font-semibold text-warm-ink">Both options include access to the cleaning companion website.</li>
        <li>Checkout is on Etsy. Arrives damaged or misprinted? We’ll make it right.</li>
      </ul>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section aria-labelledby="faq-h" class="bg-paper">
    <div class="mx-auto max-w-3xl px-5 py-12 sm:px-8 sm:py-20">
      <h2 id="faq-h" class="serif-title text-center">Questions Before You Buy?</h2>
      <div class="mt-8 border-t border-warm-rule">
        {
          faqs.map((f) => (
            <details class="group border-b border-warm-rule">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 text-[1.05rem] leading-snug font-semibold text-warm-ink [&::-webkit-details-marker]:hidden">
                {f.q}
                <span aria-hidden="true" class="shrink-0 text-[1.25rem] font-normal text-warm-soft transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="pb-5 text-[1rem] leading-relaxed text-warm-soft">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 10. Final CTA -->
  <section aria-labelledby="close-h" class="bg-blush-wash">
    <div class="mx-auto max-w-2xl px-5 py-14 text-center sm:px-8 sm:py-20">
      <h2 id="close-h" class="serif-title">Your Home Doesn’t Have to Run on Your Memory.</h2>
      <p class="lede mt-5 text-warm-ink">Give your family’s plans a place to live, and yourself a little more breathing room.</p>
      <ShopButton label={SHOP_CLOSE} to="product" cta="home-close" class={`mt-8 ${cta}`} />
      <p class="mt-4 text-[0.9rem] text-warm-soft">
        Starting at <strong class="font-semibold text-warm-ink">{half.priceLabel}</strong> · Cleaning companion included
      </p>
    </div>
  </section>
</PublicLayout>

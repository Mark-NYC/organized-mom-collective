---
/**
 * TEMPORARY public homepage. Reserves "/" for the future marketing site.
 * Indexable. Replace this page when the real homepage is built.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import { routes } from '../routes';
---

<PublicLayout description="Organized Mom Collective: family wall calendars and a simple home cleaning system. A calmer way to organize home and family.">
  <div class="flex min-h-[60dvh] flex-col justify-center">
    <img src="/brand/omc-badge.png" alt="" width="512" height="512" class="size-24" />
    <h1 class="page-title mt-8">Organized Mom Collective</h1>
    <p class="mt-3 text-[1.0625rem] leading-relaxed">A calmer way to organize home and family.</p>
    <p class="mt-10">
      <a href={routes.today} class="btn-primary">Open Companion App</a>
    </p>
  </div>
</PublicLayout>

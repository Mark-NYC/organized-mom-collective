---
/**
 * The brand homepage, built as a sales page for what exists today: the printed 2027
 * Family Wall Calendar plus its included cleaning companion website (/app).
 * Hero → The problem → Product (wall + phone) → The Organized Mom Method (four rhythms)
 * → Testimonial → What's included + pricing → FAQ → Final CTA.
 * One action throughout: "Get the Calendar", always to /calendar.
 * Hand-drawn accents (global.css → .hand-underline / .hand-highlight): four, no more. Hero
 * underline, problem highlighter, method underline (light), final CTA highlighter. None on the
 * product images, pricing or navigation. Plus two HandAsterisks dividers, where a section turns:
 * before the method's closing line, and between the testimonial and the Etsy reviews.
 *
 * Honesty rules:
 * - Sell only what exists. No planned features (shared calendar, accounts, syncing,
 *   meal or to-do tools in the companion); the wall and the phone are separate, and
 *   the copy never implies they sync. Companion facts come from src/data/cleaning.ts
 *   and the companion's real behavior (no setup, no account, saved on the phone).
 *   Each rhythm names the real calendar sections that deliver it.
 * - Prices, weeks and editions come from src/config.ts via calendarOptions(). Every
 *   shop button goes to /calendar (or its options, #buy), never straight to Etsy.
 *   The pricing cards only say "Choose" once that option's Etsy listing is live; until
 *   then they say "Coming soon to Etsy". The 26-week calendar is the first print run's
 *   main offer (PRIMARY_OPTION_ID); the full year is the secondary option.
 * - Calendar facts match /calendar and the Etsy listing images in design/etsy-listing/.
 *   Shipping and checkout are Etsy's: don't add shipping origins, times or guarantees.
 * - Photos and phone screenshots are real (see README → Where things live). The hero's
 *   breakfast photo (family-breakfast) sells the feeling, the life the product supports: it's not
 *   a customer, and the calendar in its background is not a reference for the printed layout.
 *   The sections below show the real calendar and companion. No founder story until there's
 *   authentic founder information and a real photo.
 * - Etsy ratings and quotes come from src/data/reviews.ts and always carry its
 *   REVIEWS_DISCLAIMER (previous calendar editions); never in structured data.
 *   The one customer testimonial (Camille S.) also lives there, quoted word for word, with no
 *   photo, and is never labeled as a review of the 2027 edition. Every CTA carries data-cta
 *   (src/lib/analytics.ts).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import PhoneShot from '../components/site/PhoneShot.astro';
import ShopButton from '../components/site/ShopButton.astro';
import HandUnderline from '../components/site/HandUnderline.astro';
import HandAsterisks from '../components/site/HandAsterisks.astro';
import EntrywayScene from '../components/site/EntrywayScene.astro';
import { photo } from '../lib/images';
import { routes } from '../routes';
import { calendarOptions, formatPrice } from '../lib/reorder';
import { BRAND_NAME, PRIMARY_OPTION_ID } from '../config';
import { ETSY_REVIEWS_URL, ETSY_SHOP_URL, REVIEWS_DISCLAIMER, review, reviewDate, shopStats, testimonial } from '../data/reviews';

const family = photo('family-breakfast', [640, 960, 1280, 1536]);
const kitchen = photo('family-kitchen');
const filledIn = photo('calendar-filled-in', [640, 960, 1254]);
const features = photo('calendar-features', [640, 960, 1280], '/images/reorder');

const options = calendarOptions();
const byWeeks = [...options].sort((a, b) => a.weeks - b.weeks);
const half = byWeeks[0];
const full = byWeeks[byWeeks.length - 1];
/** The first print run's main offer first, then the rest. */
const primary = options.find((o) => o.id === PRIMARY_OPTION_ID) ?? half;
const others = options.filter((o) => o.id !== primary.id);
/** Whether any option can be bought yet (a real Etsy listing in src/config.ts). */
const anyLive = options.some((o) => o.url);

/** The one call to action, everywhere on the page. */
const GET = 'Get the Calendar';

const [quoteBefore, quoteAfter] = testimonial.quote.split(testimonial.highlight);
/** Two Etsy reviews that add something Camille's quote doesn't: print quality and service. */
const supporting = [review('quality'), review('service')];

const loadLines = ['The appointments.', 'The groceries and the meals.', 'The cleaning.', 'Remembering what’s coming next.'];

// Line icons, one per rhythm (public/images/site/icons/).
const icons = ['calendar', 'family', 'cleaning', 'heart'] as const;

/** The Organized Mom Method. `on` names the real calendar sections (or the companion) that deliver each rhythm. */
const rhythms: { icon: (typeof icons)[number]; title: string; body: string; on: string }[] = [
  {
    icon: 'calendar',
    title: 'Plan the Week',
    body: 'Put meals, appointments, and priorities where everyone can see them.',
    on: 'Daily schedule · Meal plan · Grocery list · To-do',
  },
  {
    icon: 'family',
    title: 'Get Everyone on the Same Page',
    body: 'Give your family one shared place to see what’s coming.',
    on: 'One page a week, where everyone walks past',
  },
  {
    icon: 'cleaning',
    title: 'Keep the House Moving',
    body: 'Follow simple cleaning rhythms without starting over each day.',
    on: 'Daily cleaning zone · Cleaning companion',
  },
  {
    icon: 'heart',
    title: 'Make Room for What Matters',
    body: 'Spend less energy managing the details.',
    on: 'Family & friends · Self-care · Grateful for',
  },
];

const included = [
  `The printed 11 × 17-inch family wall calendar, one week to a page`,
  'Room for the schedule, meals, groceries, priorities, and to-dos',
  'A daily cleaning zone and a monthly home project',
  'The cleaning companion website for simple daily routines, at no extra cost',
];

const priceCopy: Record<string, { cta: string; note: string }> = {
  [half.id]: { cta: 'Choose Half-Year', note: 'A great way to get started.' },
  [full.id]: { cta: 'Choose Full-Year', note: `Twice the planning for just ${formatPrice(full.price - half.price)} more.` },
};
/** Where an option's button goes: its live Etsy listing, else the options on /calendar. */
const optionHref = (o: (typeof options)[number]) => o.url ?? routes.buy;

const faqs = [
  {
    q: 'Is the cleaning companion an app?',
    a: 'No. It’s a website included with every calendar. Scan the QR code printed on the calendar and it opens in your phone’s browser. No subscription, no account, nothing to download.',
  },
  {
    q: 'Do I have to use every section?',
    a: 'No. Start with what helps, like the schedule and dinners, and leave the rest blank. In the companion, a missed day doesn’t put you behind.',
  },
  {
    q: 'When does the 2027 calendar start?',
    a: 'The first page of the January–June 2027 calendar is the week of Monday, December 28, 2026, so you can start right after Christmas.',
  },
  {
    q: 'Where do I buy it, and how does shipping work?',
    a: 'On Etsy. Checkout, payment, shipping options and delivery details are all shown on the Etsy listing. If your calendar arrives damaged or misprinted, reach out through Etsy with your order and we’ll make it right.',
  },
];

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: BRAND_NAME,
    url: site.href,
    logo: new URL('/brand/omc-badge.png', site).href,
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: BRAND_NAME, url: site.href },
];

const wrap = 'mx-auto max-w-6xl px-5 sm:px-8';
const pad = 'py-12 sm:py-20 md:py-24';
const card = 'rounded-[10px] bg-paper shadow-[0_20px_40px_-32px_rgba(77,69,68,0.5)]';
const cta = 'min-h-14 w-full px-8 sm:w-auto';
---

<PublicLayout
  fullTitle={`${BRAND_NAME}: 2027 Family Wall Calendar + Cleaning Companion`}
  description={`Less chaos, more room for what matters. A 2027 weekly family wall calendar for schedules, meals and groceries, plus an included cleaning companion website. From ${half.priceLabel} for ${half.weeks} weeks.`}
  width="full"
  jsonLd={jsonLd}
>
  <!-- 1. Hero. Phones (under 768px): label, headline, copy, CTA, then the photo, so the CTA is on the
       first screen. Desktop: copy left, photo right. -->
  <section aria-labelledby="hero-h" class="overflow-hidden bg-cream">
    <div class:list={[wrap, 'grid items-center gap-x-12 gap-y-6 pt-6 pb-8 sm:pt-8 md:grid-cols-[1.05fr_1fr] md:py-20 lg:gap-x-16']}>
      <div>
        <p class="label text-warm-soft">
          <span class="text-balance">2027 Family Wall Calendar + <span class="whitespace-nowrap">Cleaning Companion</span></span>
        </p>
        <!-- Three lines at every width ("What Matters." never splits); sized so "More Room for" (about 6.6 × the font size wide in Georgia) fits a phone. -->
        <h1
          id="hero-h"
          class="serif-hero mt-3 text-[length:min(2.6rem,calc((100vw_-_40px)/7.4))] sm:mt-4 sm:text-[3.1rem] md:text-[length:min(3.4rem,4.4vw)]"
        >
          Less Chaos.<br /> More Room for <HandUnderline>What Matters.</HandUnderline>
        </h1>
        <p class="lede mt-4 max-w-xl text-warm-ink sm:mt-5">
          A simple wall calendar and companion website to help you plan your week, keep up with the house, and get the whole family on the same page.
        </p>
        <div class="mt-5 sm:mt-7">
          <ShopButton label={GET} to="product" cta="home-hero" class={cta} />
        </div>
        <p class="mt-4 text-center text-[0.95rem] leading-snug text-warm-soft sm:text-left">
          <strong class="block font-semibold whitespace-nowrap text-warm-ink sm:inline">Starting at {half.priceLabel}</strong><span aria-hidden="true" class="hidden sm:inline"> · </span>
          <span class="whitespace-nowrap">Cleaning companion included</span>
        </p>
      </div>

      <!-- The feeling: one complete, unedited photo at its own 3:2 ratio at every width, so nothing is
           cropped: the wall calendar on the right, all three faces and the breakfast table. -->
      <figure class="-mx-5 overflow-hidden bg-band sm:mx-0 sm:rounded-[10px]">
        <img
          src={family.src}
          srcset={family.srcset}
          sizes="(min-width: 1152px) 520px, (min-width: 768px) 46vw, 100vw"
          width="1536"
          height="1024"
          fetchpriority="high"
          decoding="async"
          alt="A mom laughing with her son and daughter over breakfast at the kitchen table, a filled-in wall calendar hanging in the background."
          class="block aspect-[3/2] h-auto w-full object-cover"
        />
      </figure>
    </div>
  </section>

  <!-- Entryway scene: shown once its real photos exist (design/entryway/README.md) -->
  <EntrywayScene />

  <!-- 2. The problem: recognition before the solution -->
  <section aria-labelledby="load-h" class="bg-paper">
    <div class:list={[wrap, pad, 'grid items-center gap-10 md:grid-cols-[1.1fr_1fr] md:gap-16']}>
      <div>
        <h2 id="load-h" class="serif-title">Does Everything Seem to <span class="hand-highlight whitespace-nowrap">Run Through You?</span></h2>
        <ul class="mt-7 border-t border-warm-rule">
          {
            loadLines.map((line) => (
              <li class="flex gap-4 border-b border-warm-rule py-3.5 text-[1.0625rem] leading-snug text-warm-ink">
                <span aria-hidden="true" class="mt-[0.15rem] size-5 shrink-0 rounded-[3px] border border-rule-strong" />
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
        <p class="lede mt-6">When everything lives in your head, even the little things start to feel like a lot.</p>
        <p class="mt-5 font-serif text-[1.3rem] leading-snug text-warm-ink italic sm:text-[1.45rem]">
          What if there were one simple place to bring it all together?
        </p>
      </div>
      <figure class="-mx-5 overflow-hidden bg-band sm:mx-0 sm:rounded-[10px]">
        <img
          src={kitchen.src}
          srcset={kitchen.srcset}
          sizes="(min-width: 1152px) 500px, (min-width: 768px) 45vw, 100vw"
          width="1280"
          height="1024"
          loading="lazy"
          decoding="async"
          alt="A mom and her young daughter scooping cookie dough at the kitchen counter, with the family's filled-in weekly calendar beside them."
          class="block h-auto w-full"
        />
      </figure>
    </div>
  </section>

  <!-- 3. The product: the wall and the phone, side by side (they don't sync) -->
  <section aria-labelledby="product-h" class="bg-sage-wash">
    <div class:list={[wrap, pad]}>
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="product-h" class="serif-title">One Place for the Whole Family to See the Plan.</h2>
        <p class="lede mt-4">Two simple parts: a big weekly calendar for the whole family, and a little help with the house.</p>
      </div>

      <div class="mt-9 grid gap-5 md:mt-12 md:grid-cols-2 md:gap-8">
        <article class:list={[card, 'flex flex-col overflow-hidden']}>
          <div class="aspect-square overflow-hidden bg-band">
            <img
              src={filledIn.src}
              srcset={filledIn.srcset}
              sizes="(min-width: 1152px) 540px, (min-width: 768px) 46vw, calc(100vw - 2.5rem)"
              width="1254"
              height="1254"
              loading="lazy"
              decoding="async"
              alt="A hand writing in the 2027 wall calendar on a marble counter, its January week filled with school runs, dinners, a meal plan, a grocery list and to-dos."
              class="block h-full w-full object-cover"
            />
          </div>
          <div class="p-6 sm:p-8">
            <p class="label text-warm-soft">The printed calendar</p>
            <h3 class="mt-2 font-serif text-[1.6rem] leading-snug text-warm-ink">On Your Wall</h3>
            <p class="mt-2 text-[1.02rem] leading-relaxed">
              Schedules, meals, priorities, and household plans, all where everyone can see them. <span class="whitespace-nowrap">11 × 17 inches</span>, one week to
              a page.
            </p>
          </div>
        </article>

        <article class:list={[card, 'flex flex-col overflow-hidden']}>
          <div class="flex aspect-[4/3] items-start justify-center overflow-hidden bg-cream px-6 pt-7 md:aspect-square md:items-center md:pt-0">
            <div class="w-[11.5rem] sm:w-[13.5rem]">
              <PhoneShot name="today" alt="The cleaning companion's Today screen: today's cleaning zone as a short checklist, with some tasks checked off." />
            </div>
          </div>
          <div class="p-6 sm:p-8">
            <p class="label text-warm-soft">The cleaning companion website</p>
            <h3 class="mt-2 font-serif text-[1.6rem] leading-snug text-warm-ink">On Your Phone</h3>
            <p class="mt-2 text-[1.02rem] leading-relaxed">
              Today’s cleaning tasks as a short checklist. Scan the QR code on the calendar and it opens in your browser. No app, no account.
            </p>
          </div>
        </article>
      </div>

      <p class="mx-auto mt-7 max-w-2xl text-center text-[0.95rem] leading-relaxed text-balance text-warm-soft">
        The cleaning zones are printed on the calendar, and the companion follows the same ones. Nothing to sync, nothing to set up.
      </p>
    </div>
  </section>

  <!-- 4. The Organized Mom Method: four rhythms, readable in ten seconds. Open columns with rules, not cards. -->
  <section aria-labelledby="method-h" class="bg-cream">
    <div class:list={[wrap, pad]}>
      <div class="mx-auto max-w-2xl text-center">
        <p class="label text-warm-soft">The Organized Mom Method</p>
        <h2 id="method-h" class="serif-title mt-3">One Family. <HandUnderline light>One Plan.</HandUnderline><br class="hidden sm:inline" /> Four Simple Rhythms.</h2>
        <p class="lede mt-4">
          You don’t need another complicated system. Just a simple way to plan the week, keep the house moving, and make more room for the people who matter most.
        </p>
      </div>
      <ol class="mt-8 grid border-t border-warm-rule md:mt-12 md:grid-cols-2 md:border-t-0 lg:grid-cols-4">
        {
          rhythms.map((r, i) => (
            <li class="flex gap-4 border-b border-warm-rule py-5 md:flex-col md:gap-4 md:border-b-0 md:py-6 md:pr-8 lg:border-l lg:px-7 lg:py-2 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0">
              <span aria-hidden="true" class="grid size-14 shrink-0 place-items-center rounded-full bg-white shadow-[0_3px_10px_rgba(60,40,30,0.14)]">
                <img src={`/images/site/icons/${r.icon}.png`} alt="" width="32" height="32" class="size-8" loading="lazy" />
              </span>
              <div>
                <h3 class="font-serif text-[1.3rem] leading-snug text-warm-ink sm:text-[1.4rem]">
                  <span class="text-rose-deep">{i + 1}.</span> {r.title}
                </h3>
                <p class="mt-1.5 text-[1rem] leading-relaxed">{r.body}</p>
                <p class="mt-2 text-[0.85rem] leading-snug text-warm-soft">{r.on}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <HandAsterisks class="mt-10" />
      <p class="mx-auto mt-4 max-w-xl text-center font-serif text-[1.15rem] leading-snug text-warm-ink italic sm:text-[1.25rem]">
        Start with what helps. You don’t need a perfect routine or every box filled in.
      </p>
    </div>
  </section>

  <!-- 5. Featured testimonial (Camille S., no photo), then Etsy reviews of previous editions (src/data/reviews.ts) -->
  <section aria-labelledby="reviews-h" class="bg-blush-wash">
    <div class:list={[wrap, pad]}>
      <h2 id="reviews-h" class="serif-title mx-auto max-w-2xl text-center">A Little More Calm in Real Homes.</h2>

      <figure class="mx-auto mt-8 max-w-3xl text-center sm:mt-10">
        <span aria-hidden="true" class="block font-serif text-[4rem] leading-[0.6] text-rose">“</span>
        <blockquote class="mt-6 font-serif text-[1.45rem] leading-[1.42] text-balance text-warm-ink italic sm:text-[1.9rem]">
          <p>
            {quoteBefore}<span class="box-decoration-clone bg-[linear-gradient(transparent_60%,color-mix(in_srgb,var(--color-rose)_28%,transparent)_60%,color-mix(in_srgb,var(--color-rose)_28%,transparent)_92%,transparent_92%)] px-0.5">{testimonial.highlight}</span>{quoteAfter}
          </p>
        </blockquote>
        <figcaption class="mx-auto mt-7 w-fit border-t border-rose/40 px-6 pt-4 text-[1rem] font-semibold tracking-[0.02em] text-warm-ink">
          {testimonial.name}
        </figcaption>
      </figure>

      <HandAsterisks class="mt-10" />
      <!-- Compact trust row: the verified Etsy shop figures (whole shop, earlier editions), labeled as such right here. -->
      <div class="mx-auto mt-6 max-w-3xl text-center">
        <h3 class="label text-warm-ink">From our Etsy shop: earlier calendar editions</h3>
        <p class="mt-3 flex flex-wrap items-baseline justify-center gap-x-3 gap-y-1 text-warm-ink">
          <span class="whitespace-nowrap"><span aria-hidden="true" class="text-rose-deep">★</span> <strong class="font-serif text-[1.6rem] font-normal">{shopStats.rating}</strong><span class="text-[0.95rem] text-warm-soft">/5</span></span>
          <span class="text-[0.95rem] whitespace-nowrap">{shopStats.reviews} Etsy reviews</span>
          <span aria-hidden="true" class="text-warm-soft">·</span>
          <span class="text-[0.95rem] whitespace-nowrap">{shopStats.sales} sales</span>
        </p>
      </div>
      <ul class="mx-auto mt-5 grid max-w-3xl gap-4 sm:grid-cols-2 sm:gap-5">
        {
          supporting.map((r) => (
            <li class="flex">
              <figure class="flex w-full flex-col rounded-[8px] bg-paper/80 p-5 sm:p-6">
                <blockquote cite={ETSY_REVIEWS_URL} class="flex-1 font-serif text-[1.08rem] leading-snug text-warm-ink italic">
                  <p>“{r.quote}”</p>
                </blockquote>
                <figcaption class="mt-4 text-[0.88rem] leading-snug text-warm-soft">
                  <span class="font-semibold text-warm-ink">{r.name}</span> · Etsy review, <time datetime={r.date}>{reviewDate(r.date)}</time>
                  {r.excerpt && ' · Excerpt'}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <p class="mx-auto mt-6 max-w-2xl text-center text-[0.85rem] leading-relaxed text-balance text-warm-soft">
        Rating, review count and sales cover all items in the shop. {REVIEWS_DISCLAIMER} They aren’t reviews of the 2027 calendar or the cleaning
        companion.{' '}
        <a href={ETSY_SHOP_URL} target="_blank" rel="noopener noreferrer" class="underline decoration-warm-rule underline-offset-[3px] hover:text-warm-ink hover:decoration-warm-ink"
          >Visit our Etsy shop<span class="sr-only"> (opens Etsy)</span></a
        >
      </p>
    </div>
  </section>

  <!-- 6. What's included + pricing. The labeled listing image shows every section; the list says what's in the box.
       The 26-week calendar leads (first print run). A pricing button says "Choose" and goes to Etsy only once that
       option's listing is live; until then the card says "Coming soon to Etsy" and links to /calendar#buy. -->
  <section id="offer" aria-labelledby="offer-h" class="bg-sage-wash">
    <div class:list={[wrap, pad]}>
      <div class="grid items-center gap-9 md:grid-cols-[1fr_1.05fr] md:gap-16">
        <figure class="-mx-5 overflow-hidden bg-paper sm:mx-0 sm:rounded-[10px]">
          <img
            src={features.src}
            srcset={features.srcset}
            sizes="(min-width: 1152px) 520px, (min-width: 768px) 46vw, 100vw"
            width="1280"
            height="1280"
            loading="lazy"
            decoding="async"
            alt="A filled-in week of the 2027 calendar with its sections labeled: Daily Schedule, Daily Cleaning Zone, Word of the Week, Self-Care, Family + Friends, Prayer + Gratitude, Meal Plan, Grocery List and To-Do List."
            class="block h-auto w-full"
          />
        </figure>
        <div>
          <h2 id="offer-h" class="serif-title">What You Get</h2>
          <ul class="mt-6 border-t border-warm-rule">
            {
              included.map((item) => (
                <li class="flex gap-4 border-b border-warm-rule py-3.5 text-[1.0625rem] leading-snug text-warm-ink">
                  <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-[0.1rem] size-5 shrink-0 text-rose-deep" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.5 10.5 8 14l7.5-8" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-[0.95rem] leading-relaxed text-warm-soft">
            The January–June 2027 calendar starts the week of December 28, 2026, so you can hang it right after Christmas.
          </p>
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-2xl text-center md:mt-16">
        <h3 class="serif-title">Ready for a Little More Breathing Room?</h3>
        {!anyLive && <p class="mt-3 text-[0.95rem] leading-snug text-warm-soft">Not on sale yet: both calendars are coming soon to Etsy.</p>}
      </div>
      <ul class="mx-auto mt-7 grid max-w-3xl gap-4 sm:grid-cols-[1.15fr_1fr] sm:items-center sm:gap-6">
        {
          [primary, ...others].map((o) => {
            const main = o.id === primary.id;
            return (
              <li
                class:list={[
                  'flex flex-col rounded-[10px]',
                  main ? 'border-2 border-warm-button bg-paper p-6 shadow-[0_24px_50px_-36px_rgba(77,69,68,0.7)] sm:p-8' : 'border border-warm-rule bg-ivory p-6 sm:p-7',
                ]}
              >
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="text-[1.1rem] leading-tight font-bold text-warm-ink">{o.name}</h3>
                  {main && (
                    <span class="rounded-full bg-rose-wash px-2.5 py-1 text-[0.62rem] leading-none font-bold tracking-[0.14em] text-warm-ink uppercase">
                      Start here
                    </span>
                  )}
                </div>
                <p class:list={['mt-4 font-serif leading-none text-warm-ink', main ? 'text-[3.1rem]' : 'text-[2.5rem]']}>{o.priceLabel}</p>
                <p class="mt-2 text-[1rem] font-semibold text-warm-ink">{o.weeks} weeks</p>
                <p class="mt-1 text-[0.9rem] leading-snug text-warm-soft">
                  {o.setsWeeks > 0 ? `All of 2027, as two ${o.setsWeeks}-week sets` : o.editions.map((e) => e.label).join(' or ')}
                </p>
                <p class="mt-4 mb-6 text-[1rem] leading-snug text-warm-ink">{priceCopy[o.id].note}</p>
                {o.url ? (
                  <a
                    href={optionHref(o)}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-cta={`home-price-${o.id}`}
                    class:list={['mt-auto min-h-14 w-full gap-2 px-4', main ? 'btn-primary' : 'btn-secondary border-warm-button text-[0.75rem] text-warm-ink hover:bg-warm-button']}
                  >
                    {priceCopy[o.id].cta} on Etsy <span aria-hidden="true">↗</span>
                    <span class="sr-only"> (opens Etsy)</span>
                  </a>
                ) : (
                  <div class="mt-auto">
                    <p class="flex min-h-14 items-center justify-center rounded-[3px] border border-dashed border-warm-rule px-4 text-center text-[0.75rem] font-semibold tracking-[0.16em] text-warm-soft uppercase">
                      Coming soon to Etsy
                    </p>
                    <a href={optionHref(o)} data-cta={`home-price-${o.id}`} class="text-link mt-4 inline-block text-warm-ink">
                      See the details
                    </a>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>

      <p class="mx-auto mt-7 max-w-2xl text-center text-[0.95rem] leading-snug text-warm-soft">
        Both include the cleaning companion. Checkout is on Etsy. Arrives damaged or misprinted? We’ll make it right.
      </p>
    </div>
  </section>

  <!-- 7. FAQ: only the questions the page above doesn't already answer -->
  <section aria-labelledby="faq-h" class="bg-paper">
    <div class="mx-auto max-w-3xl px-5 py-12 sm:px-8 sm:py-20">
      <h2 id="faq-h" class="serif-title text-center">Questions Before You Buy?</h2>
      <div class="mt-8 border-t border-warm-rule">
        {
          faqs.map((f) => (
            <details class="group border-b border-warm-rule">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 text-[1.05rem] leading-snug font-semibold text-warm-ink [&::-webkit-details-marker]:hidden">
                {f.q}
                <span aria-hidden="true" class="shrink-0 text-[1.25rem] font-normal text-warm-soft transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="pb-5 text-[1rem] leading-relaxed text-warm-soft">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 8. Final CTA, with the product beside it: the flat 2027 page and the companion's Today screen -->
  <section aria-labelledby="close-h" class="overflow-hidden bg-blush-wash">
    <div class:list={[wrap, 'grid items-center gap-10 py-14 sm:py-20 md:grid-cols-[1fr_1.1fr] md:gap-16']}>
      <div class="relative mx-auto w-full max-w-[19rem] pr-[22%] pb-4 sm:max-w-[22rem] md:order-last md:max-w-[24rem]">
        <img
          src="/images/site/calendar-cutout-480.webp"
          srcset="/images/site/calendar-cutout-480.webp 480w, /images/site/calendar-cutout-720.webp 720w"
          sizes="(min-width: 768px) 300px, 60vw"
          width="960"
          height="1410"
          loading="lazy"
          decoding="async"
          alt="A page of the 2027 weekly wall calendar."
          class="block h-auto w-full"
        />
        <div class="absolute right-0 bottom-0 w-[38%]">
          <PhoneShot name="today" alt="The cleaning companion's Today screen." />
        </div>
      </div>
      <div class="text-center md:text-left">
        <h2 id="close-h" class="serif-title">A Little More Organized.<br /> A Lot More <span class="hand-highlight hand-highlight-apricot whitespace-nowrap">Breathing Room.</span></h2>
        <p class="lede mt-5 text-warm-ink">Bring your family’s plans, everyday routines, and priorities together in one simple system.</p>
        <ShopButton label={GET} to="product" cta="home-close" class={`mt-8 ${cta}`} />
        <p class="mt-4 text-[0.9rem] text-warm-soft">
          <span class="block sm:inline">Starting at <strong class="font-semibold text-warm-ink">{half.priceLabel}</strong></span><span aria-hidden="true" class="hidden sm:inline"> · </span>
          <span class="whitespace-nowrap">Cleaning companion included</span>
        </p>
      </div>
    </div>
  </section>
</PublicLayout>

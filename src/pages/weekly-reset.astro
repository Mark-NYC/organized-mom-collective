---
/**
 * The Weekly Reset System landing page: a $9 digital bundle (Weekly Command Center, 30-Minute
 * Daily Tidy System, coaching audio), recreated from the original Etsy-era landing page with
 * the same copy in the public page style (serif Title Case headlines, warm ink, cream / sage /
 * blush washes). A standalone landing page: no site header or footer, one action throughout.
 *
 * Hero → What 30 minutes gets you → Guarantee → Offer + what's included → Testimonial → Final CTA.
 *
 * Honesty rules:
 * - Prices, checkout and contact live in src/data/weekly-reset.ts. Until buyUrl is set the
 *   buttons say "Coming soon" and the page is noindex (and out of the sitemap).
 * - Etsy figures come from src/data/weekly-reset.ts → etsyStats (supplied by the shop owner). Camille S.'s quote is word for word from there, with no photo.
 * - Photos switch on when their files exist (AssetSlot). The guarantee badge is drawn here.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import PublicLayout from '../layouts/PublicLayout.astro';
import AssetSlot from '../components/site/AssetSlot.astro';
import ResetButton from '../components/site/ResetButton.astro';
import EtsyTrustRow from '../components/site/EtsyTrustRow.astro';
import { coachingPreviewAudio, weeklyReset, weeklyResetAssets as assets } from '../data/weekly-reset';
import { testimonial } from '../data/reviews';
import { BRAND_NAME } from '../config';

const { price, regularPrice, contactEmail } = weeklyReset;
const live = Boolean(weeklyReset.buyUrl);
const hasAudio = existsSync(join(process.cwd(), 'public', coachingPreviewAudio));
const [quoteBefore, quoteAfter] = testimonial.quote.split(testimonial.highlight);

const outcomes = [
  { title: 'Plan your entire week in minutes', pre: 'So you ', em: 'stop going to bed with that “what am I forgetting?” feeling', post: '' },
  { title: 'Keep your home tidy without cleaning all day', pre: 'So you can actually ', em: 'sit on the couch guilt-free', post: '' },
  { title: 'Start Monday calm, not scrambling', pre: 'So you wake up knowing exactly what needs to happen ', em: 'instead of playing catch-up', post: '' },
];

const included = [
  {
    title: 'The Weekly Command Center',
    sub: 'Digital + Print-Ready',
    body: 'Plan your week in under 10 minutes and know exactly what’s happening when.',
  },
  {
    title: 'The 30-Minute Daily Tidy System',
    sub: 'Step-by-Step Guide',
    body: 'The exact system busy moms use to maintain a peaceful home without spending hours cleaning.',
  },
];

const wrap = 'mx-auto max-w-6xl px-5 sm:px-8';
const pad = 'py-12 sm:py-20 md:py-24';
const check = 'M4.5 10.5 8 14l7.5-8';
---

<PublicLayout
  fullTitle={`End Sunday Night Chaos in 30 Minutes · ${weeklyReset.name} · ${BRAND_NAME}`}
  description={`A 30-minute Sunday reset for busy moms: the Weekly Command Center, the 30-Minute Daily Tidy System and a personal coaching audio. Instant download, $${price}.`}
  indexable={live}
  chrome={false}
  width="full"
>
  <!-- 1. Hero -->
  <section aria-labelledby="hero-h" class="overflow-hidden bg-cream">
    <div class:list={[wrap, 'grid items-center gap-x-12 gap-y-8 pt-8 pb-10 md:grid-cols-[1fr_1.05fr] md:py-20 lg:gap-x-16']}>
      <div class="text-center md:text-left">
        <a href="/" class="inline-block"><img src="/brand/omc-badge.png" alt={BRAND_NAME} width="56" height="56" class="size-14" /></a>
        <h1 id="hero-h" class="serif-hero mt-5 text-[2.2rem] sm:text-[2.9rem] lg:text-[3.3rem]">
          End Sunday Night Chaos in 30 Minutes <span class="whitespace-nowrap">— Just <span class="text-rose-deep">${price}</span> <s class="text-[0.6em] text-warm-soft">${regularPrice}</s></span>
        </h1>
        <p class="lede mt-5 text-warm-ink">If Sunday nights feel like laundry piling up, meals unplanned, and Monday looming—this system is your reset button.</p>
        <p class="lede mt-4 text-warm-ink">
          In just 30 minutes, you’ll prep your week, <strong class="font-semibold">ditch the overwhelm</strong>, and finally feel in control again.
        </p>
        <p class="mt-4 text-[0.95rem] font-semibold text-warm-ink">Less than 2 lattes. Saves 5+ hours every week. Instant download.</p>
        <div class="mt-7"><ResetButton cta="reset-hero" /></div>

        <!-- Trust row: the Etsy shop's figures (src/data/weekly-reset.ts → etsyStats). -->
        <EtsyTrustRow class="mt-7" />
      </div>

      <figure class="-mx-5 overflow-hidden sm:mx-0 sm:rounded-[10px]">
        <AssetSlot asset={assets.hero} sizes="(min-width: 768px) 50vw, 100vw" eager />
      </figure>
    </div>
  </section>

  <!-- 2. What 30 minutes gets you -->
  <section aria-labelledby="gets-h" class="bg-paper">
    <div class:list={['mx-auto max-w-3xl px-5 sm:px-8', pad]}>
      <h2 id="gets-h" class="serif-title text-center">What 30 Minutes Gets You: A Week That <span class="hand-highlight whitespace-nowrap">Actually Goes to Plan</span></h2>
      <ul class="mt-9 border-t border-warm-rule">
        {
          outcomes.map((o) => (
            <li class="border-b border-warm-rule py-6 text-center">
              <p class="text-[1.05rem] font-semibold text-balance text-warm-ink">
                <svg aria-hidden="true" viewBox="0 0 20 20" class="mr-1.5 inline size-5 -translate-y-px align-middle text-rose-deep" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={check} />
                </svg>
                {o.title}
              </p>
              <p class="mt-2 font-serif text-[1.05rem] text-warm-soft italic">
                {o.pre}<strong class="font-semibold text-warm-ink">{o.em}</strong>{o.post}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Guarantee. The badge is drawn here (no stock badge art). -->
  <section aria-labelledby="guarantee-h" class="bg-sage-wash">
    <div class:list={['mx-auto max-w-2xl px-5 text-center sm:px-8', pad]}>
      <div aria-hidden="true" class="mx-auto grid size-28 place-items-center rounded-full border-2 border-warm-ink/70 bg-paper outline outline-1 outline-offset-4 outline-warm-ink/30">
        <p class="font-serif leading-none text-warm-ink">
          <span class="block text-[2.4rem]">30</span>
          <span class="mt-1 block text-[0.62rem] font-sans font-semibold tracking-[0.2em] uppercase">Day Money-Back</span>
        </p>
      </div>
      <h2 id="guarantee-h" class="serif-title mt-8">Your “Actually Used It” Guarantee</h2>
      <p class="lede mt-4 text-warm-ink">
        Use the complete system for 30 days. If you don’t feel more in control of your weeks, email us and we’ll refund every penny — no questions asked.
      </p>
      <div class="mt-8"><ResetButton cta="reset-guarantee" /></div>
    </div>
  </section>

  <!-- 4. The offer: why this over free printables, then what's included -->
  <section aria-labelledby="offer-h" class="bg-paper">
    <div class:list={[wrap, pad]}>
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="offer-h" class="serif-title"><span class="text-rose-deep">${price} New Customer Special</span> (Normally ${regularPrice})</h2>
        <p class="mt-6 text-[1.05rem] font-semibold text-warm-ink">Why Smart Moms Choose This Over Free Solutions:</p>
        <div class="lede mt-4 space-y-4 text-warm-ink">
          <p>Free printables give you pages. This gives you a <strong class="font-semibold">plan.</strong></p>
          <p>Instead of collecting dust in a drawer, this becomes the 30-minute ritual that <strong class="font-semibold">saves you 5+ hours of chaos every week.</strong></p>
          <p>With freebies, <strong class="font-semibold">you’re left guessing</strong> what to do and when.</p>
          <p>With this system, you get a <strong class="font-semibold">step-by-step reset</strong> that actually sticks — even if you’ve failed before.</p>
        </div>
        <h3 class="mt-12 font-serif text-[1.6rem] leading-snug text-warm-ink sm:text-[1.9rem]">Here’s Your Complete Weekly Reset System:</h3>
      </div>

      <figure class="mx-auto mt-8 max-w-5xl">
        <AssetSlot asset={assets.bundle} sizes="(min-width: 1152px) 1024px, 100vw" />
      </figure>

      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          included.map((item) => (
            <li class="rounded-[10px] bg-cream p-6 text-center sm:p-7">
              <h4 class="font-serif text-[1.3rem] leading-snug text-warm-ink">{item.title}</h4>
              <p class="label mt-1 text-warm-soft">{item.sub}</p>
              <p class="mt-3 text-[1rem] leading-relaxed">{item.body}</p>
            </li>
          ))
        }
        <li class="rounded-[10px] bg-sage-wash p-6 text-center shadow-[0_20px_40px_-32px_rgba(77,69,68,0.5)] ring-1 ring-sage/50 sm:p-7">
          <h4 class="font-serif text-[1.3rem] leading-snug text-warm-ink">Personal Coaching Audio</h4>
          <p class="label mt-1 text-warm-soft">Real Mom Voice, Not AI</p>
          <p class="mt-3 text-[1rem] leading-relaxed">
            I’ll guide you through your very first weekly reset, step-by-step, so you <strong class="font-semibold text-warm-ink">start this Sunday feeling calm and confident.</strong>
          </p>
          {
            hasAudio ? (
              <>
                <audio controls preload="none" src={coachingPreviewAudio} class="mt-5 w-full" />
                <p class="mt-2 text-[0.85rem] text-warm-soft italic">Listen to a preview of your coaching audio</p>
              </>
            ) : (
              <p class="mt-5 rounded-[6px] border border-dashed border-warm-rule px-3 py-3 text-[0.8rem] text-warm-soft">
                Audio preview coming · <code>public{coachingPreviewAudio}</code>
              </p>
            )
          }
        </li>
      </ul>
    </div>
  </section>

  <!-- 5. Testimonial: Camille S., word for word, no photo (src/data/reviews.ts) -->
  <section aria-labelledby="say-h" class="bg-blush-wash">
    <div class:list={['mx-auto max-w-3xl px-5 text-center sm:px-8', pad]}>
      <h2 id="say-h" class="serif-title">What Moms Are Saying</h2>
      <figure class="mt-8">
        <p class="text-[1.05rem] font-semibold text-warm-ink">{testimonial.title}</p>
        <span aria-hidden="true" class="mt-4 block font-serif text-[4rem] leading-[0.6] text-rose">“</span>
        <blockquote class="mt-6 font-serif text-[1.35rem] leading-[1.42] text-balance text-warm-ink italic sm:text-[1.75rem]">
          <p>{quoteBefore}<strong class="font-semibold">{testimonial.highlight}</strong>{quoteAfter}</p>
        </blockquote>
        <figcaption class="mx-auto mt-7 w-fit border-t border-rose/40 px-6 pt-4 text-[1rem] font-semibold tracking-[0.02em] text-warm-ink">
          {testimonial.name}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 6. Final CTA -->
  <section aria-labelledby="close-h" class="bg-cream">
    <div class:list={['mx-auto max-w-2xl px-5 text-center sm:px-8', pad]}>
      <h2 id="close-h" class="serif-title">New Customer Special</h2>
      <p class="mt-3 font-serif text-[1.1rem] text-warm-soft italic">Limited to <strong class="font-semibold text-warm-ink">first 100 moms</strong></p>
      <div class="mt-8"><ResetButton cta="reset-close" /></div>
      <p class="mt-4 text-[0.95rem] font-semibold text-warm-ink">(Save ${regularPrice - price})</p>
      <p class="mt-8 text-[0.95rem] text-warm-soft italic">
        Questions? Email us at <a href={`mailto:${contactEmail}`} class="text-warm-ink underline underline-offset-2">{contactEmail}</a>
      </p>
    </div>
  </section>
</PublicLayout>

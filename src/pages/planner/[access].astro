---
/**
 * The upgraded Weekly Planner: the free planner plus one-tap example weeks. Unlisted, not locked:
 * noindex, out of the sitemap, linked only from a Take Back Control buyer's download page. Its
 * address is PLANNER_PLUS_PATH in src/data/planner.ts (change it there to retire a shared link).
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import WeeklyPlanner from '../../components/site/WeeklyPlanner';
import { PLANNER_PLUS_PATH, plannerPresets } from '../../data/planner';

export function getStaticPaths() {
  return [{ params: { access: PLANNER_PLUS_PATH.split('/').pop() } }];
}
---

<PublicLayout title="Weekly Planner Generator (Upgraded)" description="The upgraded weekly planner from Take Back Control, with one-tap example weeks." indexable={false} width="full">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-8 sm:py-12">
    <div class="no-print mx-auto max-w-2xl text-center">
      <p class="label text-rose-deep">Take Back Control</p>
      <h1 class="serif-title mt-3">Weekly Planner Generator</h1>
      <p class="lede mt-4 text-warm-ink">
        Start from an example week or a blank page, make it yours, then print it or save it as a PDF. Bookmark this page: it’s your upgraded planner.
      </p>
    </div>
    <div class="mt-8">
      <WeeklyPlanner client:load presets={plannerPresets} />
    </div>
  </div>
</PublicLayout>

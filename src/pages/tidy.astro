---
import Layout from '../layouts/Layout.astro';
import MonthBrowser from '../components/MonthBrowser';
import { TimeMark, ZoneTag, shortTime } from '../components/marks';
import { dailyEssentials, weekend, weeklySchedule } from '../data/cleaning';

const week = [
  ...weeklySchedule.map((d) => ({ num: d.day as number, short: d.shortLabel, day: d.dayLabel, zone: d.zone, icon: d.icon, time: shortTime(d.minutes) })),
  ...weekend.days.map((d) => ({ num: d.day as number, short: d.shortLabel, day: d.dayLabel, zone: d.zone, icon: weekend.icon, time: 'Optional' })),
];

const principles = [
  {
    title: 'Daily reset',
    body: `About ${dailyEssentials.minutes}: beds, dishes, counters and a quick pickup. Starts fresh every morning.`,
  },
  {
    title: 'Mon–Thu rhythm',
    body: 'One room each weekday, 10–15 minutes. By Thursday the whole house is reset.',
  },
  {
    title: 'Fri–Sun',
    body: 'One deep-cleaning task, a home project, or catching up. All optional.',
  },
  {
    title: 'Monthly focus',
    body: 'One deeper project a month, in a few small tasks. Spread them across the weekends.',
  },
];
---

<Layout title="How Tidy Works" description="The Organized Mom cleaning system: a daily reset, a Mon–Thu room rhythm, flexible weekends and one monthly focus.">
  <header class="max-w-2xl">
    <p class="label text-muted">Tidy · The system</p>
    <h1 class="page-title mt-3">One small reset.<br />One room a day.</h1>
    <p class="mt-3 text-[1.0625rem] leading-relaxed">You don’t need to clean the whole house every day.</p>
  </header>

  <section aria-labelledby="week-heading" class="mt-9 max-w-2xl border-t border-rule-strong pt-5">
    <h2 id="week-heading" class="section-label">The week</h2>
    <ol class="mt-4 border-t border-rule-strong">
      {
        week.map((d) => (
          <li data-day={d.num} class="flex items-center gap-3 border-b border-rule py-2.5">
            <span class="day-label w-11 shrink-0 text-[0.78rem] font-bold tracking-[0.16em] uppercase">
              <span aria-hidden="true">{d.short}</span>
              <span class="sr-only">{d.day}:</span>
            </span>
            <span class="min-w-0 flex-1">
              <ZoneTag icon={d.icon} label={d.zone} size="sm" />
            </span>
            <TimeMark>{d.time}</TimeMark>
          </li>
        ))
      }
    </ol>
    <p class="mt-3 text-center text-[1rem] text-muted">Plus the daily reset, every day.</p>
    <script is:inline>
      document.querySelector('[data-day="' + new Date().getDay() + '"]')?.classList.add('is-today');
    </script>
  </section>

  <div class="mt-9 grid gap-x-12 sm:grid-cols-2">
    {
      principles.map((p) => (
        <section class="border-t border-rule-strong py-4">
          <h2 class="label">{p.title}</h2>
          <p class="mt-1.5 text-[1.0625rem] leading-relaxed sm:text-[1rem]">{p.body}</p>
        </section>
      ))
    }
  </div>

  <section aria-labelledby="month-heading" class="mt-8 max-w-2xl border-t border-rule-strong pt-5">
    <h2 id="month-heading" class="section-label mb-4">Monthly focus</h2>
    <MonthBrowser client:only="react">
      <div slot="fallback" class="h-96"></div>
    </MonthBrowser>
  </section>

  <div class="mt-14 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-rule pt-6">
    <a href="/" class="btn-primary">Go to today</a>
    <a href="/reorder" class="text-link">Order your next calendar</a>
  </div>
</Layout>

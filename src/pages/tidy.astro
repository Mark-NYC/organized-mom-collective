---
import Layout from '../layouts/Layout.astro';
import MonthBrowser from '../components/MonthBrowser';
import { accentClasses } from '../components/accent';
import { dailyEssentials, weekend, weeklySchedule } from '../data/cleaning';
---

<Layout title="How Tidy Works" description="The Organized Mom cleaning system: a daily reset, a Mon–Thu room rhythm, flexible weekends and one monthly focus.">
  <header>
    <p class="eyebrow">The Tidy system</p>
    <h1 class="mt-1.5 font-serif text-[2.35rem] leading-tight font-medium sm:text-5xl">Small, steady, enough.</h1>
    <p class="mt-3 max-w-prose text-[1.02rem] leading-relaxed text-muted">
      You don’t need to clean the whole house every day. A short reset plus one area keeps everything in rhythm.
    </p>
  </header>

  <section aria-labelledby="week-heading" class="mt-8">
    <h2 id="week-heading" class="eyebrow mb-3">Your week</h2>
    <ol class="card divide-y divide-line">
      {
        weeklySchedule.map((d) => (
          <li class="flex items-center gap-4 px-5 py-3.5 sm:px-6">
            <span class:list={['grid h-9 w-[4.25rem] shrink-0 place-items-center rounded-full text-[0.72rem] font-semibold tracking-[0.12em] uppercase', accentClasses[d.accent].dot]}>
              {d.shortLabel}
            </span>
            <span class="flex-1 font-medium">{d.zone}</span>
            <span class="text-sm text-muted">{d.minutes.replace('minutes', 'min')}</span>
          </li>
        ))
      }
      <li class="flex items-center gap-4 px-5 py-3.5 sm:px-6">
        <span class="grid h-9 w-[4.25rem] shrink-0 place-items-center rounded-full border border-line bg-paper text-[0.72rem] font-semibold tracking-[0.08em] uppercase">
          {weekend.shortLabel}
        </span>
        <span class="flex-1 leading-snug font-medium">{weekend.zone}</span>
        <span class="text-sm text-muted">optional</span>
      </li>
    </ol>
    <p class="mt-3 px-1 text-sm text-muted">Plus the daily reset, every day.</p>
  </section>

  <div class="mt-10 grid gap-x-8 gap-y-7 sm:grid-cols-2">
    <section aria-labelledby="daily-h">
      <h2 id="daily-h" class="font-serif text-2xl font-semibold">Your daily reset</h2>
      <p class="mt-1.5 leading-relaxed text-muted">
        About {dailyEssentials.minutes}. Beds, dishes, counters, a quick pickup and any obvious spills. It resets each morning.
      </p>
    </section>
    <section aria-labelledby="rhythm-h">
      <h2 id="rhythm-h" class="font-serif text-2xl font-semibold">Mon–Thu rhythm</h2>
      <p class="mt-1.5 leading-relaxed text-muted">
        One room each weekday, 10–15 minutes. By Thursday the whole house has had a quick reset.
      </p>
    </section>
    <section aria-labelledby="weekend-h">
      <h2 id="weekend-h" class="font-serif text-2xl font-semibold">Weekend deep clean / catch up</h2>
      <p class="mt-1.5 leading-relaxed text-muted">
        Friday to Sunday are flexible. Do one task from the monthly project, catch up on something you missed, or rest.
      </p>
    </section>
    <section aria-labelledby="monthly-h">
      <h2 id="monthly-h" class="font-serif text-2xl font-semibold">Monthly focus</h2>
      <p class="mt-1.5 leading-relaxed text-muted">
        Each month has one deeper project, broken into a handful of tasks. Spread them across the month’s weekends.
      </p>
    </section>
  </div>

  <section aria-labelledby="month-heading" class="mt-10">
    <h2 id="month-heading" class="eyebrow mb-3">Monthly focus</h2>
    <MonthBrowser client:only="react">
      <div slot="fallback" class="card h-80"></div>
    </MonthBrowser>
  </section>

  <div class="mt-10 flex flex-col items-center gap-4 text-center">
    <a href="/" class="btn-primary">Go to today</a>
    <a href="/reorder" class="text-sm text-muted underline decoration-line underline-offset-4 hover:text-ink">
      Order your next calendar
    </a>
  </div>
</Layout>

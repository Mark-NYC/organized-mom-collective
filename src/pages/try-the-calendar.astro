---
/**
 * /try-the-calendar — a free monthly family calendar people fill in on screen and download as a PNG
 * (US Letter portrait, 8.5 × 11 in at 96 px/in, drawn at 2×). Not the printed calendar: that one is a
 * weekly 11 × 17 page (/calendar), so the copy here never says this is what ships.
 * One row per family member (five), one activity shown per person per day. Activities are stored as
 * rules (every Tuesday, or a date that repeats), not expanded into dates, so any month renders from them.
 * Everything autosaves in this browser (`omc:family-calendar:v1`). Export: src/lib/printable.ts.
 * Classes are prefixed `fc-` so they never collide with the site's own.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import FamilyActivityCalendar from '../components/FamilyActivityCalendar.astro';
import { routes } from '../routes';
import { BRAND_NAME } from '../config';

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: BRAND_NAME, item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Try the Family Wall Calendar', item: new URL(routes.tryCalendar, site).href },
    ],
  },
];
---

<PublicLayout
  title="Try the Family Wall Calendar"
  description="A free monthly family calendar: add everyone's activities once, see the whole month by person, then download it as an image to print or keep on your phone."
  width="full"
  jsonLd={jsonLd}
>
  <section aria-labelledby="try-h" class="bg-cream public-panel public-intro">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
      <p class="label text-warm-soft">Free monthly family calendar</p>
      <h1 id="try-h" class="serif-hero mt-3">Make a Monthly Family Calendar.</h1>
      <p class="lede mt-4 max-w-2xl text-warm-ink">
        Add your family, tap an activity, pick the days and who it’s for. The whole month fills in, one row per person. Download it as an
        image to print or keep on your phone. What you add stays saved in this browser until you reset it.
      </p>
    </div>
  </section>

  <FamilyActivityCalendar />

</PublicLayout>


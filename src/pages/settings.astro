---
import Layout from '../layouts/Layout.astro';
import SettingsApp from '../components/SettingsApp';
---

<Layout title="Settings">
  <div class="max-w-xl">
    <h1 class="page-title">Settings</h1>
    <p class="mt-3 text-muted">Your progress is saved on this device only.</p>
    <div class="mt-10">
      <SettingsApp client:only="react">
        <div slot="fallback" class="h-60"></div>
      </SettingsApp>
    </div>
  </div>
</Layout>

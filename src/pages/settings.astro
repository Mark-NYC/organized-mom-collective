---
import Layout from '../layouts/Layout.astro';
import SettingsApp from '../components/SettingsApp';
---

<Layout title="Settings">
  <div class="max-w-xl">
    <p class="rule-label text-muted">Settings</p>
    <h1 class="mt-4 font-serif text-[2.9rem] leading-[0.98] font-medium tracking-[-0.01em]">Settings</h1>
    <p class="mt-4 text-muted">Your progress is saved on this device only.</p>
    <div class="mt-10">
      <SettingsApp client:only="react">
        <div slot="fallback" class="h-60"></div>
      </SettingsApp>
    </div>
  </div>
</Layout>

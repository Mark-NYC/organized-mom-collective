---
/** Shared December physical mission prototype, rendered in both preview and member kit. */
import { monthColors } from '../../theme';
import {families} from '../../lib/december/traditions';
---
<main class="dec" style={`--accent:${monthColors[11].hex}`}>
  <a href="/club/worksheet-generator/" class="back">← November experiment</a>
  <header><p class="eyebrow">ORGANIZED FAMILY CLUB · DECEMBER</p><h1>Your Christmas Mission Has Arrived!</h1><p>A surprise addressed to the children. One kindness mission and two Christmas cards, ready to give.</p></header>
  <div class="workspace">
    <section class="details" aria-label="December tradition plan">
      <div hidden><label for="family">Explore a sample family</label>
      <select id="family">{families.map(f=><option value={f.id}>{f.label}</option>)}</select>
      <p class="demo">Demo only · Nothing is saved or mailed</p></div>
      <h2 id="mission-title">One mission. Two Christmas cards.</h2>
      <p id="mission-summary">The children choose someone to encourage, make a card, and ask a grown-up to help deliver it.</p>
      <h3>The three steps</h3>
      <ol><li>Choose someone to surprise.</li><li>Make their Christmas card.</li><li>Deliver your kindness with a grown-up.</li></ol>
      <p class="duration">No special supplies or shopping. Just a pen, a kind idea, and the two cards included on the second sheet.</p>
      <button type="button" id="download" disabled>Download mission + cards</button>
      <p class="demo" id="message" role="status" aria-live="polite">Two US Letter pages. Print page 1 for the kids. Print page 2 on one side only, then cut and fold the two cards.</p>
    </section>
    <section class="preview" aria-label="Actual print preview"><div class="previewheading"><h2>Your December mission</h2><span>Mission + two gift cards</span></div><div class="sheets"><figure><div class="sheet" id="front">Loading preview…</div><figcaption>Personalized mission</figcaption></figure><figure><div class="sheet" id="reverse"></div><figcaption>Two one-sided cards · cut and fold</figcaption></figure></div></section>
  </div>
</main>


<script>
import {families, type Family} from '../../lib/december/traditions';
import type {Household} from '../../lib/club/profile';
import {decemberPages} from '../../lib/december/layout';
import {renderSvg} from '../../lib/worksheet/svg';
import {renderPdf} from '../../lib/worksheet/pdf';
import {createMetrics,FONT_FILES,FONT_URL,type FontBytes} from '../../lib/worksheet/fonts';
import type {FontKey,Metrics} from '../../lib/worksheet/types';
const get=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T;
const family=get<HTMLSelectElement>('family');
const button=get<HTMLButtonElement>('download'),message=get<HTMLElement>('message');
let bytes:FontBytes|null=null,metrics:Metrics|null=null;
let clubHousehold:Household|null=null;
function current():Family {
 if(clubHousehold){
  const adults=clubHousehold.members.filter(m=>m.kind==='adult'&&!m.archived);
  const children=clubHousehold.members.filter(m=>m.kind==='child'&&!m.archived);
  const members=[adults[0]?.firstName??'A parent',adults[1]?.firstName??'a grown-up',...children.map(m=>m.firstName)];
  const ages=[0,0,...children.map(m=>m.birthYear?2026-m.birthYear:8)];
  return {id:'rivera',label:'Family profile',family:clubHousehold.displayName??'Our Family',members,ages,recommended:'kindness'};
 }
 return families.find(f=>f.id===family.value)??families[0];
}
window.addEventListener('omc:club-preview-household',(event:Event)=>{
 const detail=(event as CustomEvent<{household:Household|null}>).detail;
 clubHousehold=detail?.household??null;
 show();
});
function show(){
 const f=current();
 const children=f.members.slice(2);
 const names=children.join(' & ');
 get<HTMLElement>('mission-title').textContent=names+', your Christmas mission is ready.';
 if(metrics){const pages=decemberPages(metrics,f);
 get<HTMLElement>('front').innerHTML=renderSvg(pages[0],'Personalized Christmas mission');
 get<HTMLElement>('reverse').innerHTML=renderSvg(pages[1],'Two Christmas kindness cards, one-sided');}
}
family.addEventListener('change',show);
button.addEventListener('click',async()=>{
 if(!metrics||!bytes)return;
 button.disabled=true;message.textContent='Preparing your mission and cards…';
 try{
 const f=current();const pdf=await renderPdf(decemberPages(metrics,f),bytes,{title:'December Christmas Mission · '+f.family,subject:'Personalized kids Christmas mission and two one-sided cards',duplex:false});
 const url=URL.createObjectURL(new Blob([pdf as BlobPart],{type:'application/pdf'}));
 const link=document.createElement('a');link.href=url;link.download='december-christmas-mission-'+f.id+'.pdf';document.body.appendChild(link);link.click();link.remove();
 setTimeout(()=>URL.revokeObjectURL(url),60000);
 message.textContent='Downloaded. Print each PDF page on a separate sheet, single-sided. This demo does not mail anything.';
 }catch(e){console.error(e);message.textContent='Could not generate the PDF. Please try again.';}
 finally{button.disabled=false;}
});
async function start(){
 try{
 const keys=Object.keys(FONT_FILES) as FontKey[];
 const files=await Promise.all(keys.map(async key=>{
 const response=await fetch(FONT_URL+FONT_FILES[key]);if(!response.ok)throw Error('Font loading failed');
 return new Uint8Array(await response.arrayBuffer());
 }));
 bytes=Object.fromEntries(keys.map((k,i)=>[k,files[i]])) as FontBytes;
 metrics=createMetrics(bytes);
 await Promise.all(['400 12px "WS Gelasio"','italic 400 12px "WS Gelasio"','italic 600 12px "WS Gelasio"','400 12px "WS Montserrat"','600 12px "WS Montserrat"'].map(f=>document.fonts.load(f)));
 button.disabled=false;show();
 }catch(e){console.error(e);message.textContent='Preview could not load. Please refresh.';}
}
show();start();
</script>
<style is:global>
@font-face{font-family:'WS Gelasio';src:url('/fonts/worksheet/gelasio-400.ttf');font-weight:400}
@font-face{font-family:'WS Gelasio';src:url('/fonts/worksheet/gelasio-400-italic.ttf');font-weight:400;font-style:italic}
@font-face{font-family:'WS Gelasio';src:url('/fonts/worksheet/gelasio-600-italic.ttf');font-weight:600;font-style:italic}
@font-face{font-family:'WS Montserrat';src:url('/fonts/worksheet/montserrat-400.ttf');font-weight:400}
@font-face{font-family:'WS Montserrat';src:url('/fonts/worksheet/montserrat-600.ttf');font-weight:600}
</style>
<style>
.dec{max-width:1440px;margin:auto;padding:28px clamp(18px,3.5vw,54px) 90px;color:#454545}
.back{font-size:12px;text-decoration:underline;text-underline-offset:3px}
header{margin:38px 0 42px;max-width:750px}
.eyebrow{font:600 11px Montserrat,sans-serif;letter-spacing:.16em}
h1,h2,h3{font-family:Georgia,serif}
h1{font-size:clamp(36px,4.4vw,58px);font-weight:700;font-style:italic;color:#527468;line-height:1.1;margin:16px 0}
header>p:last-child{line-height:1.65;max-width:650px}
.workspace{display:grid;grid-template-columns:minmax(290px,350px) minmax(0,1fr);gap:clamp(25px,4vw,55px)}
.details{min-width:0}.details h2{font-size:27px;margin:28px 0 8px;color:#527468;font-weight:700;font-style:italic}
.details h3{font-size:19px;margin:29px 0 12px}.details>p{line-height:1.6}
label{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;display:block;margin-bottom:8px}
select{background:white;width:100%;border:1px solid #bbb;border-radius:0;padding:12px;font-size:15px;min-height:46px;color:#333}
.switch{margin-top:25px;padding-top:20px;border-top:1px solid var(--accent)}
.demo,.duration{font-size:12px;color:#686868;margin:9px 0}
ul,ol{padding-left:21px;line-height:1.7;font-size:14px}li{margin-bottom:6px}
.role{display:grid;grid-template-columns:96px 1fr;gap:12px;padding:12px 0;border-bottom:1px solid var(--accent);font-size:13px;line-height:1.5}
.role strong{font-family:Georgia,serif;font-size:16px}
#download{width:100%;background:#454545;border:0;color:white;min-height:51px;margin-top:25px;padding:13px;cursor:pointer;font-size:12px;font-weight:600;letter-spacing:.07em;text-transform:uppercase}
#download:disabled{opacity:.55;cursor:default}
.previewheading{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--accent);margin-bottom:25px}
.previewheading h2{font-size:25px}.previewheading span{font-size:12px}
.sheets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
figure{margin:0;min-width:0}.sheet{aspect-ratio:612/792;border:1px solid #ddd;box-shadow:0 12px 32px #0002;background:#fff;display:grid;place-items:center;font-size:13px}
.sheet :global(svg){display:block;width:100%;height:100%}figcaption{text-align:center;font-size:11px;letter-spacing:.1em;text-transform:uppercase;margin-top:10px}
@media(max-width:950px){.workspace{grid-template-columns:1fr}.details{max-width:680px}}
@media(max-width:560px){.sheets{grid-template-columns:1fr}.previewheading{margin-top:12px}}
</style>

<style>.details h2{font-size:25px}.details .duration{border-top:1px solid var(--accent);padding-top:15px}#download{margin-top:22px}</style>
---
/** Shared December physical mission prototype, rendered in both preview and member kit. */
import { monthColors } from '../../theme';
import {families} from '../../lib/december/traditions';
---
<main class="dec" style={`--accent:${monthColors[11].hex}`}>
  
  <header><p class="eyebrow">ORGANIZED FAMILY CLUB · DECEMBER</p><h1>Your Christmas Mission Has Arrived!</h1><p>A surprise addressed to the children. One kindness mission and two Christmas cards, ready to give.</p></header>
  <div class="workspace">
    <section class="details" aria-label="December mission plan">
      <div class="dec-prepared" id="december-edit-controls">
       <p class="eyebrow">ORGANIZED FAMILY CLUB · DECEMBER</p><h2>Your Christmas Mission Has Arrived!</h2>
       <button type="button" class="dec-why" data-dec-why>Why this matters</button>
       <div class="dec-summary"><span class="eyebrow">YOUR FAMILY'S PREPARED MISSION</span><h3 id="mission-title">One mission. Two Christmas cards.</h3><p id="mission-summary">The children choose someone to encourage, make a card, and ask a grown-up to help deliver it.</p>
        <p class="dec-summary-line"><span>Included</span><strong>Kindness mission + 2 cards</strong></p>
        <p class="dec-summary-line"><span>Supplies</span><strong>Just a pen</strong></p>
        <button type="button" class="dec-edit-link" data-dec-edit>Make changes</button>
       </div>
       <p class="dec-note">One simple act of kindness that kids can initiate. A grown-up helps deliver the cards.</p>
      </div>
      <div class="dec-actions"><div class="dec-primary-actions"><a href="#december-edit-controls" class="dec-jump">Make changes</a><button type="button" id="download" disabled>Download PDF</button></div><p class="demo" id="message" role="status" aria-live="polite">Print each PDF page single-sided. Cut and fold the two cards.</p></div>
    </section>
    <dialog class="dec-dialog" id="dec-why-dialog" aria-labelledby="dec-why-title"><div class="dec-dialog-header"><h2 id="dec-why-title">Why this matters</h2><button type="button" data-dec-close aria-label="Close">×</button></div><p>Children don't have to wait for Mom to plan every meaningful Christmas activity. Their own kindness mission comes prepared with two cards so they can choose who to encourage, create something personal, and help deliver it.</p><button type="button" class="dec-dialog-done" data-dec-close>Back to our mission</button></dialog>
    <dialog class="dec-dialog" id="dec-edit-dialog" aria-labelledby="dec-edit-title"><div class="dec-dialog-header"><h2 id="dec-edit-title">Make it your family’s mission</h2><button type="button" data-dec-close aria-label="Close">×</button></div><p>The mission and cards are prepared for the family selected in the top navigation. To personalize names, use the family selector above. You can also explore another sample below.</p><label for="family">Explore a sample family</label><select id="family">{families.map(f=><option value={f.id}>{f.label}</option>)}</select><p class="demo">Sample preview only · Nothing is saved or mailed.</p><button type="button" class="dec-dialog-done" data-dec-close>Done · See our mission</button></dialog>
    <section class="preview" aria-label="Actual print preview"><button type="button" class="dec-float" data-dec-edit><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 4 4M4 20l4-.8L19 8.2a2.1 2.1 0 0 0-3-3L5 16.2 4 20Z"/></svg>MAKE CHANGES</button><div class="sheets"><figure><div class="sheet" id="front">Loading preview…</div><figcaption>Personalized mission</figcaption></figure><figure><div class="sheet" id="reverse"></div><figcaption>Two one-sided cards · cut and fold</figcaption></figure></div></section>
  </div>
</main>


<script>
import {families, type Family} from '../../lib/december/traditions';
import type {Household} from '../../lib/club/profile';
import {decemberPages} from '../../lib/december/layout';
import {renderSvg} from '../../lib/worksheet/svg';
import {renderPdf} from '../../lib/worksheet/pdf';
import {createMetrics,FONT_FILES,FONT_URL,type FontBytes} from '../../lib/worksheet/fonts';
import type {FontKey,Metrics} from '../../lib/worksheet/types';
const get=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T;
const family=get<HTMLSelectElement>('family');
const button=get<HTMLButtonElement>('download'),message=get<HTMLElement>('message');
let bytes:FontBytes|null=null,metrics:Metrics|null=null;
let clubHousehold:Household|null=null;
function current():Family {
 if(clubHousehold){
  const adults=clubHousehold.members.filter(m=>m.kind==='adult'&&!m.archived);
  const children=clubHousehold.members.filter(m=>m.kind==='child'&&!m.archived);
  // The mission speaks to children, so its helper should be someone they naturally address.
  // Keep saved first names unchanged; only the printed child-facing instruction uses a title.
  const parents=adults.filter(m=>m.role==='parent'||m.role==='partner');
  const helper=parents.length>1?'Dad':parents.length===1?'Mom':adults[0]?.firstName??'a grown-up';
  const members=[adults[0]?.firstName??'A parent',helper,...children.map(m=>m.firstName)];
  const ages=[0,0,...children.map(m=>m.birthYear?2026-m.birthYear:8)];
  return {id:'rivera',label:'Family profile',family:clubHousehold.displayName??'Our Family',members,ages,recommended:'kindness'};
 }
 return families.find(f=>f.id===family.value)??families[0];
}
const applyHousehold=(detail:{household:Household|null})=>{clubHousehold=detail?.household??null;show()};
window.addEventListener('omc:club-preview-household',(event:Event)=>applyHousehold((event as CustomEvent<{household:Household|null}>).detail));
const cached=(window as Window & {__ofcPreviewHousehold?:{household:Household|null}}).__ofcPreviewHousehold;
if(cached)applyHousehold(cached);
const editDialog=document.querySelector<HTMLDialogElement>('#dec-edit-dialog');
const whyDialog=document.querySelector<HTMLDialogElement>('#dec-why-dialog');
document.querySelectorAll('[data-dec-edit]').forEach(el=>el.addEventListener('click',()=>editDialog?.showModal()));
document.querySelector('[data-dec-why]')?.addEventListener('click',()=>whyDialog?.showModal());
document.querySelectorAll('[data-dec-close]').forEach(el=>el.addEventListener('click',()=>el.closest('dialog')?.close()));
for(const dialog of [editDialog,whyDialog])dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
function show(){
 const f=current();
 const children=f.members.slice(2);
 const names=children.join(' & ');
 get<HTMLElement>('mission-title').textContent=names+', your Christmas mission is ready.';
 if(metrics){const pages=decemberPages(metrics,f);
 get<HTMLElement>('front').innerHTML=renderSvg(pages[0],'Personalized Christmas mission');
 get<HTMLElement>('reverse').innerHTML=renderSvg(pages[1],'Two Christmas kindness cards, one-sided');}
}
family.addEventListener('change',show);
button.addEventListener('click',async()=>{
 if(!metrics||!bytes)return;
 button.disabled=true;message.textContent='Preparing your mission and cards…';
 try{
 const f=current();const pdf=await renderPdf(decemberPages(metrics,f),bytes,{title:'December Christmas Mission · '+f.family,subject:'Personalized kids Christmas mission and two one-sided cards',duplex:false});
 const url=URL.createObjectURL(new Blob([pdf as BlobPart],{type:'application/pdf'}));
 const link=document.createElement('a');link.href=url;link.download='december-christmas-mission-'+f.id+'.pdf';document.body.appendChild(link);link.click();link.remove();
 setTimeout(()=>URL.revokeObjectURL(url),60000);
 message.textContent='Downloaded. Print each PDF page on a separate sheet, single-sided. This demo does not mail anything.';
 }catch(e){console.error(e);message.textContent='Could not generate the PDF. Please try again.';}
 finally{button.disabled=false;}
});
async function start(){
 try{
 const keys=Object.keys(FONT_FILES) as FontKey[];
 const files=await Promise.all(keys.map(async key=>{
 const response=await fetch(FONT_URL+FONT_FILES[key]);if(!response.ok)throw Error('Font loading failed');
 return new Uint8Array(await response.arrayBuffer());
 }));
 bytes=Object.fromEntries(keys.map((k,i)=>[k,files[i]])) as FontBytes;
 metrics=createMetrics(bytes);
 await Promise.all(['400 12px "WS Gelasio"','italic 400 12px "WS Gelasio"','italic 600 12px "WS Gelasio"','400 12px "WS Montserrat"','600 12px "WS Montserrat"'].map(f=>document.fonts.load(f)));
 button.disabled=false;show();
 }catch(e){console.error(e);message.textContent='Preview could not load. Please refresh.';}
}
show();start();
</script>
<style is:global>
@font-face{font-family:'WS Gelasio';src:url('/fonts/worksheet/gelasio-400.ttf');font-weight:400}
@font-face{font-family:'WS Gelasio';src:url('/fonts/worksheet/gelasio-400-italic.ttf');font-weight:400;font-style:italic}
@font-face{font-family:'WS Gelasio';src:url('/fonts/worksheet/gelasio-600-italic.ttf');font-weight:600;font-style:italic}
@font-face{font-family:'WS Montserrat';src:url('/fonts/worksheet/montserrat-400.ttf');font-weight:400}
@font-face{font-family:'WS Montserrat';src:url('/fonts/worksheet/montserrat-600.ttf');font-weight:600}

</style>
<style is:global>
/* December club preview format, scoped so member kit remains unaffected. */
#club-month-content .dec{max-width:none;margin:0;padding:0;font-family:Montserrat,Arial,sans-serif}
#club-month-content .dec>header{display:none}
#club-month-content .dec .workspace{grid-template-columns:clamp(315px,28vw,410px) minmax(0,1fr);gap:0;align-items:stretch}
#club-month-content .dec .details{display:flex;flex-direction:column;min-width:0;border-right:1px solid #e5e0e1;background:#faf9f7;padding:16px clamp(17px,2vw,26px)}
#club-month-content .dec-prepared{border-top:5px solid #d8e6df;padding-top:12px;min-height:0;overflow-y:auto;flex:1 1 auto}
#club-month-content .dec-prepared>h2{font:400 clamp(23px,2.6vw,31px)/1.1 Georgia,serif;color:#527468;margin:10px 0}
#club-month-content .dec-why,#club-month-content .dec-edit-link{border:0;background:transparent;color:#527468;text-decoration:underline;text-underline-offset:3px;font:700 12px Montserrat,Arial,sans-serif;min-height:35px;cursor:pointer}
#club-month-content .dec-summary{border:1px solid #e0e6da;background:#fff;padding:15px;margin-top:12px}
#club-month-content .dec-summary h3{font:400 22px Georgia,serif;color:#527468;margin:11px 0}
#club-month-content .dec-summary>p{font:12px/1.6 Montserrat,Arial,sans-serif}
#club-month-content .dec-summary-line{border-top:1px solid #e7eae4;padding:10px 0;margin:0!important;display:flex;justify-content:space-between;gap:10px;font:12px Montserrat,Arial,sans-serif}
#club-month-content .dec-summary-line strong{text-align:right;color:#527468}
#club-month-content .dec-note{font:11px/1.5 Montserrat,Arial,sans-serif;color:#686e65;margin:12px 0}
#club-month-content .dec-actions{flex:0 0 auto;margin-top:auto;background:#faf9f7;padding-top:8px}
#club-month-content .dec-actions #download{margin:0;min-height:45px;text-transform:none;letter-spacing:0;background:#527468}
#club-month-content .dec-actions .demo{font-size:10px;line-height:1.45}
#club-month-content .dec-jump,#club-month-content .dec-float{display:none}
#club-month-content .dec .preview{min-width:0;background:#f5f3f2;padding:16px clamp(18px,3vw,45px) 38px}
#club-month-content .dec .sheets{display:flex;flex-direction:column;align-items:center;gap:28px}
#club-month-content .dec .sheets figure{width:min(100%,816px);margin:0}
#club-month-content .dec .sheet{width:100%}
#club-month-content .dec-dialog{position:fixed;inset:0;margin:auto;box-sizing:border-box;width:min(540px,calc(100vw - 64px));max-height:calc(100dvh - 80px);overflow-y:auto;padding:24px;background:#fff;border:1px solid #dce2d7;border-radius:10px;box-shadow:0 20px 65px #0003;color:#454545;font-family:Montserrat,Arial,sans-serif}
#club-month-content .dec-dialog::backdrop{background:rgba(33,40,36,.52)}
#club-month-content .dec-dialog-header{display:flex;align-items:start;justify-content:space-between;gap:15px}
#club-month-content .dec-dialog-header h2{font:400 28px Georgia,serif;color:#527468;margin:0 0 14px}
#club-month-content .dec-dialog-header button{width:36px;height:36px;border:0;border-radius:50%;background:#edf2ec;font-size:24px;cursor:pointer}
#club-month-content .dec-dialog>p{font:13px/1.65 Montserrat,Arial,sans-serif}
#club-month-content .dec-dialog-done{width:100%;min-height:46px;border:0;background:#527468;color:#fff;font-weight:700;cursor:pointer;margin-top:16px}
@media screen and (min-width:1101px){
 html:has(#club-month-content .dec),body:has(#club-month-content .dec){height:100%;overflow:hidden}
 #club-month-content:has(.dec){position:fixed;top:var(--adc-nav-height,118px);bottom:0;left:0;right:0;overflow:hidden}
 #club-month-content .dec,#club-month-content .dec .workspace{height:100%}
 #club-month-content .dec .details{height:100%;overflow:hidden}
 #club-month-content .dec .preview{height:100%;overflow-y:auto;overscroll-behavior:contain}
 #club-month-content .dec-float{display:inline-flex;position:fixed;right:clamp(22px,3vw,48px);bottom:24px;z-index:25;align-items:center;gap:9px;min-height:52px;border:0;border-radius:999px;padding:13px 19px;background:#454545;color:#fff;box-shadow:0 8px 25px #0003;font:700 12px Montserrat,Arial,sans-serif;letter-spacing:.08em;cursor:pointer}
}
@media screen and (max-width:1100px){
 #club-month-content .dec{padding:0 0 42px}
 #club-month-content .dec .workspace{display:flex;flex-direction:column;gap:0}
 #club-month-content .dec .preview{order:0;width:100%;padding:14px 14px 28px}
 #club-month-content .dec .details{order:1;width:100%;max-width:none;border:0;padding:20px}
 #club-month-content .dec-prepared{overflow:visible;flex:auto}
}
@media screen and (max-width:700px){
 #club-month-content .dec{padding-bottom:110px}
 #club-month-content .dec .details{padding:17px 18px}
 #club-month-content .dec-prepared{scroll-margin-top:12px}
 #club-month-content .dec-actions{position:fixed;left:0;right:0;bottom:0;z-index:20;margin:0;padding:9px 16px calc(9px + env(safe-area-inset-bottom,0px));border-top:1px solid #dce2d7;background:#faf9f7;box-shadow:0 -5px 20px #0001}
 #club-month-content .dec-primary-actions{display:flex;gap:9px}
 #club-month-content .dec-jump{display:flex;flex:1;align-items:center;justify-content:center;min-height:45px;border:1px solid #527468;background:white;color:#527468;text-decoration:none;font:700 12px Montserrat,Arial,sans-serif}
 #club-month-content .dec-actions #download{flex:1.3;min-width:0;font-size:12px}
 #club-month-content .dec-actions .demo{margin:5px 0 0;font-size:9px}
 #club-month-content .dec-dialog{width:calc(100vw - 32px);max-height:calc(100dvh - 48px);padding:19px}
}
@media print{#club-month-content .dec-float,#club-month-content .dec-dialog,#club-month-content .dec-actions{display:none!important}}
</style>
<style>
.dec{max-width:1440px;margin:auto;padding:28px clamp(18px,3.5vw,54px) 90px;color:#454545}
.back{font-size:12px;text-decoration:underline;text-underline-offset:3px}
header{margin:38px 0 42px;max-width:750px}
.eyebrow{font:600 11px Montserrat,sans-serif;letter-spacing:.16em}
h1,h2,h3{font-family:Georgia,serif}
h1{font-size:clamp(36px,4.4vw,58px);font-weight:700;font-style:italic;color:#527468;line-height:1.1;margin:16px 0}
header>p:last-child{line-height:1.65;max-width:650px}
.workspace{display:grid;grid-template-columns:minmax(290px,350px) minmax(0,1fr);gap:clamp(25px,4vw,55px)}
.details{min-width:0}.details h2{font-size:27px;margin:28px 0 8px;color:#527468;font-weight:700;font-style:italic}
.details h3{font-size:19px;margin:29px 0 12px}.details>p{line-height:1.6}
label{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;display:block;margin-bottom:8px}
select{background:white;width:100%;border:1px solid #bbb;border-radius:0;padding:12px;font-size:15px;min-height:46px;color:#333}
.switch{margin-top:25px;padding-top:20px;border-top:1px solid var(--accent)}
.demo,.duration{font-size:12px;color:#686868;margin:9px 0}
ul,ol{padding-left:21px;line-height:1.7;font-size:14px}li{margin-bottom:6px}
.role{display:grid;grid-template-columns:96px 1fr;gap:12px;padding:12px 0;border-bottom:1px solid var(--accent);font-size:13px;line-height:1.5}
.role strong{font-family:Georgia,serif;font-size:16px}
#download{width:100%;background:#454545;border:0;color:white;min-height:51px;margin-top:25px;padding:13px;cursor:pointer;font-size:12px;font-weight:600;letter-spacing:.07em;text-transform:uppercase}
#download:disabled{opacity:.55;cursor:default}
.previewheading{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--accent);margin-bottom:25px}
.previewheading h2{font-size:25px}.previewheading span{font-size:12px}
.sheets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
figure{margin:0;min-width:0}.sheet{aspect-ratio:612/792;border:1px solid #ddd;box-shadow:0 12px 32px #0002;background:#fff;display:grid;place-items:center;font-size:13px}
.sheet :global(svg){display:block;width:100%;height:100%}figcaption{text-align:center;font-size:11px;letter-spacing:.1em;text-transform:uppercase;margin-top:10px}
@media(max-width:950px){.workspace{grid-template-columns:1fr}.details{max-width:680px}}
@media(max-width:560px){.sheets{grid-template-columns:1fr}.previewheading{margin-top:12px}}
</style>

<style>.details h2{font-size:25px}.details .duration{border-top:1px solid var(--accent);padding-top:15px}#download{margin-top:22px}</style>
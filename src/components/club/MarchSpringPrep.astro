</style>
<script>
import {monthlyDeepClean} from '../../data/cleaning';
type Member={id:string;firstName:string;kind:'adult'|'child';birthYear?:number;birthMonth?:number;archived?:boolean;isAccountHolder?:boolean};
const project=monthlyDeepClean.find(p=>p.month===2)!;
const adultOnly=new Set(['mar-vents','mar-curtains']);
const kidFriendly=new Set(['mar-baseboards','mar-winter-gear','mar-donate']);
for(const root of document.querySelectorAll<HTMLElement>('.msc')){
 const stage=root.querySelector<HTMLElement>('[data-sheet-stage]');
 const preview=root.querySelector<HTMLElement>('.msc-preview');
 const fitPreview=()=>{
  if(!stage||!preview)return;
  // Match June: scale to preview width, without limiting height.
  const width=Math.max(180,(stage.parentElement?.clientWidth??816)-4);
  const scale=Math.min(1,width/816);
  stage.style.width=`${816*scale}px`;
  stage.style.height=`${1056*scale}px`;
  stage.style.setProperty('--msc-preview-scale',String(scale));
 };
 fitPreview();
 const previewObserver=typeof ResizeObserver!=='undefined'?new ResizeObserver(fitPreview):null;
 if(previewObserver && preview) previewObserver.observe(preview);
 window.addEventListener('resize',fitPreview);
 const managed=root.dataset.mscManaged==='true';
 let key=root.dataset.mscKey??'omc:preview:march:v1';
 const store=sessionStorage; // Do not persist family member names beyond this tab.
 let members:Member[]=[];
 let family='Our Family';
 let chosen:Record<string,string>={};
 let custom=new Set<string>();
 let customOwnerLabels:Record<string,string>={};
 type TaskCopyKey='title'|'supplies'|'ready'|'doJob'|'done';
 let textEdits:Record<string,Partial<Record<TaskCopyKey,string>>>={};
 const copyDefaults=JSON.parse(root.dataset.taskCopy??'{}') as Record<string,Record<TaskCopyKey,string>>;
 let sampleKey='';
 const eligible=(task:string,m:Member)=>m.kind==='adult'||(!adultOnly.has(task)&&m.birthYear!==undefined&&2027-m.birthYear-(m.birthMonth&&m.birthMonth>3?1:0)>=5);
 const pick=(task:string,people:Member[]):Member|undefined=>{
  const adults=people.filter(m=>m.kind==='adult');
  const kids=people.filter(m=>m.kind==='child'&&m.birthYear!==undefined&&2027-m.birthYear-(m.birthMonth&&m.birthMonth>3?1:0)>=5);
  if(adultOnly.has(task))return adults[task==='mar-vents'&&adults.length>1?1:0];
  if(task==='mar-baseboards')return kids[0]??adults[0];
  if(task==='mar-winter-gear')return kids[1]??kids[0]??adults[0];
  if(task==='mar-donate')return adults[0]??kids[2]??kids[0];
  return adults[0];
 };
 // Keep stable member IDs for assignments, but show parent roles to children.
 const ownerLabel=(member:Member,people:Member[]):string=>{
  if(member.kind==='child')return member.firstName;
  const adults=people.filter(m=>m.kind==='adult');
  const mom=adults.find(m=>m.isAccountHolder)??adults[0];
  if(member.id===mom?.id)return 'Mom';
  const dad=adults.find(m=>m.id!==mom?.id);
  if(member.id===dad?.id)return 'Dad';
  return member.firstName;
 };
 const nav=document.querySelector<HTMLElement>('.cproto-shell');
 const positionShell=()=>{if(nav)document.documentElement.style.setProperty('--msc-nav-height',nav.getBoundingClientRect().bottom+'px')};
 positionShell();window.addEventListener('resize',positionShell);
 const visionDialog=root.querySelector<HTMLDialogElement>('[data-vision-dialog]');
 root.querySelector('[data-open-vision]')?.addEventListener('click',()=>visionDialog?.showModal());
 root.querySelectorAll('[data-close-vision]').forEach(button=>button.addEventListener('click',()=>visionDialog?.close()));
 visionDialog?.addEventListener('click',event=>{if(event.target===visionDialog)visionDialog.close()});
 const ownerDialog=root.querySelector<HTMLDialogElement>('[data-owner-dialog]');
 root.querySelectorAll('[data-open-owners]').forEach(button=>button.addEventListener('click',()=>ownerDialog?.showModal()));
 root.querySelectorAll('[data-close-owners]').forEach(button=>button.addEventListener('click',()=>ownerDialog?.close()));
 ownerDialog?.addEventListener('click',event=>{if(event.target===ownerDialog)ownerDialog.close()});
 const draw=()=>{
  const live=members.filter(m=>!m.archived);
  for(const task of project.tasks){
   const select=root.querySelector<HTMLSelectElement>(`[data-owner="${task.id}"]`);
   const printed=root.querySelector<HTMLElement>(`[data-printed-owner="${task.id}"]`);
   if(!select||!printed)continue;
   const current=chosen[task.id]??'';
   select.replaceChildren();
   const placeholder=document.createElement('option');placeholder.value='';placeholder.textContent='Choose a family member';select.append(placeholder);
   for(const m of live){
    if(managed?!eligible(task.id,m):adultOnly.has(task.id)&&m.kind!=='adult')continue;
    const option=document.createElement('option');option.value=m.id;option.textContent=ownerLabel(m,live);select.append(option);
   }
   select.value=live.some(m=>m.id===current&&(managed?eligible(task.id,m):(!adultOnly.has(task.id)||m.kind==='adult')))?current:'';
   const selected=live.find(m=>m.id===select.value);
   const customName=customOwnerLabels[task.id];
   if(customName && !adultOnly.has(task.id) && !managed){
    const option=document.createElement('option');option.value='custom:'+task.id;option.textContent='Custom: '+customName;select.append(option);select.value=option.value;
   }
   if(document.activeElement!==printed)printed.textContent=(customName && !adultOnly.has(task.id) && !managed)?customName:selected?ownerLabel(selected,live):'Optional · unassigned';
   const summary=root.querySelector<HTMLElement>(`[data-summary-owner="${task.id}"]`);if(summary)summary.textContent=(customName && !adultOnly.has(task.id) && !managed)?customName:selected?ownerLabel(selected,live):'Optional · unassigned';
  }
  root.querySelectorAll<HTMLElement>('[data-march-edit]').forEach(el=>{
   if(document.activeElement===el)return;
   const task=el.dataset.task!,field=el.dataset.marchEdit as TaskCopyKey;
   el.textContent=textEdits[task]?.[field]??copyDefaults[task]?.[field]??'';
  });
  const title=root.querySelector<HTMLElement>('[data-family]');if(title)title.textContent=family;
  if(managed)root.dispatchEvent(new CustomEvent('msc-state',{detail:{family,members:live.map(m=>({...m})),tasks:project.tasks.map(task=>{const selected=live.find(m=>m.id===chosen[task.id]);return {id:task.id,ownerId:chosen[task.id]??'',owner:customOwnerLabels[task.id]&&!adultOnly.has(task.id)&&!managed?customOwnerLabels[task.id]:selected?ownerLabel(selected,live):'Optional · unassigned',adultOnly:adultOnly.has(task.id),...copyDefaults[task.id],...textEdits[task.id]}})}}));
 };
 const save=()=>{if(managed&&!sampleKey)return;try{store.setItem(key,JSON.stringify({sampleKey,chosen,custom:[...custom],customOwnerLabels,textEdits}))}catch{}};
 const clean=(el:HTMLElement,limit:number)=> (el.textContent??'').replace(/\s+/g,' ').trim().slice(0,limit);
 root.querySelectorAll<HTMLElement>('[data-march-edit]').forEach(el=>{
  const task=el.dataset.task!,field=el.dataset.marchEdit as TaskCopyKey;
  el.addEventListener('input',()=>{(textEdits[task]??={})[field]=clean(el,field==='title'?60:180);save()});
  el.addEventListener('blur',()=>{(textEdits[task]??={})[field]=clean(el,field==='title'?60:180)||copyDefaults[task][field];save();draw()});
  el.addEventListener('keydown',(e:KeyboardEvent)=>{if(e.key==='Enter'){e.preventDefault();el.blur()}});
 });
 root.querySelectorAll<HTMLElement>('[data-printed-owner]').forEach(el=>{
  const task=el.dataset.printedOwner!;
  el.addEventListener('input',()=>{const value=clean(el,32);if(!managed&&!adultOnly.has(task))customOwnerLabels[task]=value;save()});
  el.addEventListener('blur',()=>{
   const value=clean(el,32);const people=members.filter(m=>!m.archived&&(managed?eligible(task,m):(!adultOnly.has(task)||m.kind==='adult')));
   const match=people.find(m=>ownerLabel(m,members).toLowerCase()===value.toLowerCase()||m.firstName.toLowerCase()===value.toLowerCase());
   if(match){chosen[task]=match.id;delete customOwnerLabels[task];custom.add(task)}
   else if(!managed&&!adultOnly.has(task)&&value&&value!=='Optional · unassigned'){
    customOwnerLabels[task]=value;chosen[task]='';custom.add(task);
   }else if(!value||value==='Optional · unassigned'){
    chosen[task]='';delete customOwnerLabels[task];custom.add(task);
   }
   // Adult-only tasks must stay assigned to a known adult, never an unknown typed name.
   save();draw();
  });
  el.addEventListener('keydown',(e:KeyboardEvent)=>{if(e.key==='Enter'){e.preventDefault();el.blur()}});
 });
 root.querySelectorAll<HTMLSelectElement>('[data-owner]').forEach(select=>select.addEventListener('change',()=>{const task=select.dataset.owner!;chosen[task]=select.value.startsWith('custom:')?'':select.value;if(!select.value.startsWith('custom:'))delete customOwnerLabels[task];custom.add(task);save();draw()}));
 root.querySelector('[data-reset]')?.addEventListener('click',()=>{custom.clear();customOwnerLabels={};textEdits={};for(const t of project.tasks)chosen[t.id]=pick(t.id,members)?.id??'';save();draw()});
 root.querySelector('[data-print]')?.addEventListener('click',()=>{(document.activeElement as HTMLElement|null)?.blur();window.print()});
 root.querySelector<HTMLButtonElement>('[data-single-page-png]')?.addEventListener('click',async()=>{
  const button=root.querySelector<HTMLButtonElement>('[data-single-page-png]');
  const sheet=root.querySelector<HTMLElement>("[data-sheet]");
  if(!button||!sheet)return;
  button.disabled=true;const old=button.textContent;button.textContent='Preparing image…';
  root.classList.add('msc-image-export');
  try{
   await Promise.all(Array.from(sheet.querySelectorAll('img')).map(async img=>{if(!img.complete)await img.decode();if(!img.naturalWidth)throw new Error('Illustration unavailable: '+new URL(img.currentSrc||img.src).pathname)}));
   const {toPng}=await import('html-to-image');
   const options={pixelRatio:2,width:816,height:1056,backgroundColor:'#fff',cacheBust:true,style:{transform:'none',margin:'0',boxShadow:'none'}};
   let png:string;
   try{
    png=await toPng(sheet,options);
   }catch(firstError){
    // Font embedding can fail on some browser/CSS combinations. Retry with
    // the fonts already loaded in the page instead of embedding external CSS.
    console.warn('March PNG first rendering attempt failed; retrying without font embedding',firstError);
    png=await toPng(sheet,{...options,fontEmbedCSS:''});
   }
   const link=document.createElement('a');link.href=png;link.download="march-family-spring-prep.png";document.body.append(link);link.click();link.remove();
  }catch(error){
   console.error('Single-page image export failed',error);
   const detail=error instanceof Error?error.message:String(error);
   alert('PNG export failed: '+detail.slice(0,220)+'\\nYou can still use Print / Save PDF.');
  }
  finally{root.classList.remove('msc-image-export');button.disabled=false;button.textContent=old}
 });
 
 const applyHousehold=(detail:{household:{id?:string;displayName?:string;members:Member[]}|null;sample?:string|null})=>{
  if(!detail?.household)return;
  const h=detail.household;
  const id=(detail.sample??'account')+':'+(managed?h.id??'':h.displayName??'');
  if(managed&&!h.id)return;
  if(managed)key=(root.dataset.mscKey??'omc:club:march:v1')+':'+encodeURIComponent(id);
  const changed=id!==sampleKey;
  members=h.members.filter(m=>!m.archived);
  family=h.displayName??'Our Family';
  if(changed){chosen={};custom.clear();customOwnerLabels={};textEdits={};sampleKey=id;
   try{const saved=JSON.parse(store.getItem(key)??'null');if(saved?.sampleKey===id){chosen=saved.chosen??{};custom=new Set(Array.isArray(saved.custom)?saved.custom:[]);customOwnerLabels=saved.customOwnerLabels??{};textEdits=saved.textEdits??{}}}catch{}
  }
  for(const task of project.tasks){const current=chosen[task.id]??'';const valid=members.some(m=>m.id===current&&(managed?eligible(task.id,m):(!adultOnly.has(task.id)||m.kind==='adult')));if(!custom.has(task.id)||(managed?(!valid&&current!==''):(!customOwnerLabels[task.id]&&!valid)))chosen[task.id]=pick(task.id,members)?.id??'';}
  save();draw();
 };
 if(managed){
  root.addEventListener('msc-household',(event:Event)=>applyHousehold((event as CustomEvent).detail));
  root.addEventListener('msc-request',()=>draw());
  root.addEventListener('msc-edit',(event:Event)=>{
   const detail=(event as CustomEvent<{task:string;owner?:string;field?:TaskCopyKey;value?:string}>).detail;
   if(!detail||!project.tasks.some(t=>t.id===detail.task))return;
   if(detail.owner!==undefined){const candidate=members.find(m=>m.id===detail.owner&&!m.archived);if(detail.owner!==''&&(!candidate||!eligible(detail.task,candidate)))return;chosen[detail.task]=detail.owner;delete customOwnerLabels[detail.task];custom.add(detail.task)}
   if(detail.field&&['title','supplies','ready','doJob','done'].includes(detail.field)){(textEdits[detail.task]??={})[detail.field]=(detail.value??'').slice(0,detail.field==='title'?60:180)}
   save();draw();
  });
 }
 if(!managed)window.addEventListener('omc:club-preview-household',(event:Event)=>applyHousehold((event as CustomEvent<{household:{displayName?:string;members:Member[]}|null;sample?:string|null}>).detail));
 const cached=(window as Window & {__ofcPreviewHousehold?:{household:{displayName?:string;members:Member[]}|null;sample?:string|null}}).__ofcPreviewHousehold;
 if(!managed&&cached)applyHousehold(cached);
 draw();
}

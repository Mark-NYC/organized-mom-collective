@font-face{font-family:'MSC Gelasio';src:url('/fonts/worksheet/gelasio-600-italic.ttf') format('truetype');font-weight:600;font-style:italic;font-display:swap}
@font-face{font-family:'MSC Montserrat';src:url('/fonts/worksheet/montserrat-400.ttf') format('truetype');font-weight:400;font-display:swap}
@font-face{font-family:'MSC Montserrat';src:url('/fonts/worksheet/montserrat-600.ttf') format('truetype');font-weight:600;font-display:swap}
.msc,.msc *{box-sizing:border-box}.msc{max-width:1440px;margin:auto;padding:26px clamp(17px,3.5vw,54px) 85px;color:#454545;font-family:'MSC Montserrat',sans-serif}
.msc-back{font-size:12px;text-decoration:underline;text-underline-offset:4px;display:inline-block;margin-bottom:31px}.msc-overline{font:600 10px 'MSC Montserrat',sans-serif;letter-spacing:.16em}
.msc-intro{max-width:770px;margin-bottom:44px}.msc-intro h1{font:400 clamp(36px,4.5vw,58px)/1.08 'MSC Gelasio',Georgia,serif;letter-spacing:-.02em;margin:12px 0 19px;color:#393e3b}.msc-intro h1 em{font-weight:600;color:#497666}.msc-intro>p:last-child{font-size:15px;line-height:1.7;max-width:650px}
.msc-workspace{display:grid;grid-template-columns:minmax(290px,365px) minmax(0,1fr);gap:clamp(26px,3vw,48px);align-items:start}.msc-editor,.msc-preview{min-width:0}
.msc-editor-head{border-top:9px solid var(--msc-month);padding-top:21px}.msc-editor-head h2{font:600 italic 28px 'MSC Gelasio',Georgia,serif;color:#497666;margin:12px 0}.msc-editor-head>p:last-child{font-size:13px;line-height:1.65}.msc-app-link{font-size:12px;margin:18px 0 23px}.msc-app-link a{text-decoration:underline;text-underline-offset:4px}
.msc-owner-row{border-top:1px solid var(--msc-month);padding:15px 0 20px}.msc-owner-heading{display:flex;gap:12px;align-items:baseline}.msc-owner-heading span{font-size:11px;font-weight:600;color:#497666}.msc-owner-heading strong{font:400 19px 'MSC Gelasio',Georgia,serif}.msc-task-note{font-size:12px;line-height:1.6;color:#656565;margin:8px 0 13px}.msc-owner-row label{font-size:10px;font-weight:600;letter-spacing:.07em;display:block;text-transform:uppercase}.msc-owner-row select{display:block;width:100%;min-height:45px;margin-top:8px;border:1px solid #b8b8b8;padding:10px 12px;background:#fff;color:#454545;font:13px 'MSC Montserrat',sans-serif}
.msc-reminder{border-top:2px solid var(--msc-month);padding:18px 0}.msc-reminder h3{font:400 20px 'MSC Gelasio',Georgia,serif;margin:0 0 9px}.msc-reminder p{font:12px/1.7 'MSC Montserrat',sans-serif}
.msc-print{background:#454545;color:#fff;min-height:52px;padding:14px;border:0;cursor:pointer;width:100%;font:600 12px 'MSC Montserrat',sans-serif;letter-spacing:.07em;text-transform:uppercase}.msc-reset{display:block;margin:10px auto;border:0;background:none;text-decoration:underline;text-underline-offset:4px;color:#454545;min-height:45px;cursor:pointer;font:600 12px 'MSC Montserrat',sans-serif}.msc-status,.msc-preview-note{font:11px/1.6 'MSC Montserrat',sans-serif;color:#666}
.msc-preview-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;border-bottom:1px solid var(--msc-month);padding-bottom:14px;margin-bottom:21px}.msc-preview-head h2{font:400 25px 'MSC Gelasio',Georgia,serif}.msc-preview-head p{font-size:12px}
.msc-print-scroll{overflow-x:auto;padding:5px 0 25px}.msc-sheet{width:816px;height:1056px;background:#fff;box-shadow:0 12px 30px #0002;padding:42px 51px 31px;display:flex;flex-direction:column}
.msc-sheet-head{background:#edf5f0;border-top:11px solid var(--msc-month);padding:24px 27px 27px;min-height:206px}.msc-sheet-head>p:first-child{font:600 9px 'MSC Montserrat',sans-serif;letter-spacing:.14em;color:#405f53}.msc-sheet-head h2{font:400 43px/1.1 'MSC Gelasio',Georgia,serif;color:#3d6556;margin:20px 0 12px}.msc-sheet-head h2 em{font-weight:600}.msc-sheet-head>p:last-child{font:italic 18px 'MSC Gelasio',Georgia,serif;color:#577669}
.msc-sheet-family{padding:22px 0 14px;border-bottom:1px solid var(--msc-month);display:flex;justify-content:space-between;align-items:baseline;gap:15px}.msc-sheet-family span,.msc-sheet-family strong{font:600 9px 'MSC Montserrat',sans-serif;letter-spacing:.12em}.msc-sheet-family strong{font-size:13px;letter-spacing:0}
.msc-sheet-caption{font:italic 20px 'MSC Gelasio',Georgia,serif;margin:19px 0 12px;color:#497666}
.msc-sheet-tasks{flex:1}.msc-task{display:grid;grid-template-columns:30px minmax(0,1fr) 126px 22px;gap:12px;padding:20px 2px;border-top:1px solid #cdded4;align-items:center;min-height:111px}.msc-task-num{font:600 10px 'MSC Montserrat',sans-serif;color:#497666}.msc-task-text h3{font:400 19px/1.15 'MSC Gelasio',Georgia,serif;margin:0 0 7px}.msc-task-text p{font:10px/1.5 'MSC Montserrat',sans-serif;color:#606060}.msc-task-person{text-align:left}.msc-task-person span{display:block;font:600 8px 'MSC Montserrat',sans-serif;letter-spacing:.12em;color:#658070;margin-bottom:6px}.msc-task-person strong{font:600 italic 16px/1.2 'MSC Gelasio',Georgia,serif;color:#3e6c5a;overflow-wrap:anywhere}.msc-check{width:17px;height:17px;border:1.5px solid #829e90}
.msc-sheet-principle{background:#f0f5f1;padding:17px 20px;display:grid;grid-template-columns:125px 1fr;gap:14px}.msc-sheet-principle span{font:600 9px 'MSC Montserrat',sans-serif;letter-spacing:.1em;color:#3d6556}.msc-sheet-principle p{font:italic 15px/1.35 'MSC Gelasio',Georgia,serif}
.msc-sheet-bottom{display:flex;align-items:end;justify-content:space-between;border-top:1px solid #c7ded3;margin-top:17px;padding-top:14px;gap:20px}.msc-sheet-bottom span{display:block;font:600 7px 'MSC Montserrat',sans-serif;letter-spacing:.08em}.msc-sheet-bottom strong{font:400 11px 'MSC Montserrat',sans-serif}.msc-sheet-bottom>p{font:600 7px 'MSC Montserrat',sans-serif;letter-spacing:.04em;white-space:nowrap}
@media(min-width:1130px){.msc-sheet{transform:scale(.85);transform-origin:top left}.msc-print-scroll{height:930px}}
@media(max-width:1129px){.msc-workspace{grid-template-columns:1fr}.msc-editor{max-width:700px}}

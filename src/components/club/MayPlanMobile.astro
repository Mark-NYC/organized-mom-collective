---
/** May, Our Summer Day, on phones and tablets (below 1100px), inside the shared ClubPlanScreen (approval, action bar,
 * print). A reference the family can glance at all summer without zooming into the Letter sheet: the blocks in order,
 * each with its time or trigger, its activities and who helps, then the summer rule. The same plan as the printable
 * (the `.msr` root's `clubPlan`); nothing is tracked. Editing opens the shared May editor (src/lib/club/may-editor.ts)
 * in an edit sheet: Our day, When it happens, Activities & responsibilities, with Done and Cancel. */
import ClubPlanScreen from './plan/ClubPlanScreen.astro';
import '../../styles/club-personalize.css';
import '../../styles/club-marks.css';
interface Props { deadline: string }
const { deadline } = Astro.props;
---
<ClubPlanScreen deadline={deadline} kicker="May · Organized Family Club" sheets={['sheet']} previewNote="One reusable Letter-size rhythm" hero={false}>
  <Fragment slot="title">Our <em>Summer Day</em></Fragment>
  <div class="mym" data-mym>
    <p class="mym-motto">A little structure. Plenty of freedom.</p>
    <ol class="mym-blocks" data-may-rows></ol>
    <section class="mym-rule" aria-label="Our summer rule"><span>Our summer rule</span><strong>Check the rhythm before asking what’s next.</strong><p>Our plans can change. We can still find what's next.</p></section>
    <section class="cp-section" aria-labelledby="mym-edit-title">
      <h2 id="mym-edit-title">Make it yours</h2>
      <p class="cp-intro">It’s prepared from your family page. Change only what doesn’t fit your summer.</p>
      <ul class="cp-group" data-may-edit></ul>
    </section>
  </div>
</ClubPlanScreen>
<script>
import { el } from '../../lib/club/plan/dom';
import { mountPlanScreen, type PlanScreen } from '../../lib/club/plan/screen';
import type { MayState, MayPlan, MayKey } from '../../lib/club/engines/may-summer-rhythm';
import { ownerTags } from '../../lib/club/personalize/marks';
import { MAY_SECTIONS, mayEditor, type MaySection } from '../../lib/club/may-editor';
const root = document.querySelector<HTMLElement>('.may-plan');
const host = root?.querySelector<HTMLElement & {clubPlan?: MayPlan}>('.msr');
if (root && host) {
 const q = <T extends HTMLElement>(sel:string) => root.querySelector<T>(sel)!;
 const plan = () => host.clubPlan!;
 let ui:PlanScreen<MayState> | null = null;
 let locked = false;
 let section: MaySection = 'day';
 let opened: MayState | null = null;
 const TITLES: Record<MaySection, string> = Object.fromEntries(MAY_SECTIONS) as Record<MaySection, string>;
 const sheetEl = () => root.querySelector<HTMLDialogElement>('[data-cp-sheet]');
 // The trigger's printed box is ~128px wide at 14.5px: the same measure as the sheet.
 const lines = (text: string) => { const p = el('div', { class: 'msr-when-probe' }, text); document.body.append(p); const n = Math.round(p.offsetHeight / (14.5 * 1.22)); p.remove(); return n; };
 const show = () => {
  if (!ui) return;
  const sheet = sheetEl();
  const top = sheet?.open ? sheet.scrollTop : 0;
  const done = el('button', { type: 'button', class: 'cp-btn cp-btn-dark' }, 'Done');
  done.addEventListener('click', () => { opened = null; ui?.closeSheet(); });
  const cancel = el('button', { type: 'button', class: 'cp-btn' }, 'Cancel');
  cancel.addEventListener('click', () => { if (opened) plan().replace(opened); opened = null; ui?.closeSheet(); });
  ui.openSheet(TITLES[section], editor.section(section), el('div', { class: 'cp-sheet-actions' }, done, cancel));
  if (sheet) sheet.scrollTop = top;
 };
 const editor = mayEditor({
  state: () => plan().state(), update: (fn) => plan().update(fn), ctx: () => plan().context(), locked: () => locked,
  redraw: () => { if (sheetEl()?.open) show(); }, lines,
  restore: () => plan().restore(),
 });
 const open = (s: MaySection, key?: MayKey) => { section = s; editor.focus(key); opened = structuredClone(plan().state()); sheetEl()?.close(); show(); };
 const arrow = () => { const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); svg.setAttribute('viewBox', '0 0 16 16'); svg.setAttribute('class', 'mym-arrow'); svg.setAttribute('aria-hidden', 'true'); svg.innerHTML = '<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>'; return svg; };
 const row = (step: string, title: string, detail: string, go: () => void) => {
  const b = el('button', { type: 'button', class: 'cp-row', disabled: locked }, el('span'),
   el('span', { class: 'cp-row-text' }, el('span', { class: 'mym-step' }, step), el('strong', {}, title), detail ? el('span', {}, detail) : ''),
   el('span', { class: 'cp-chev', 'aria-hidden': 'true' }));
  b.setAttribute('aria-label', `${step}: ${title}.${locked ? '' : ' Change'}`);
  b.addEventListener('click', go);
  return el('li', {}, b);
 };
 const render = (_ui: PlanScreen<MayState>, s: MayState, isLocked: boolean) => {
  locked = isLocked;
  // The daily reference: each block in order, its time or trigger first so the family sees what starts it.
  q('[data-may-rows]').replaceChildren(...s.rows.map((r) => {
   // Flexible blocks show nothing here, as on paper.
   const when = r.slot ? el('span', { class: `mym-when mym-when--${r.slot.kind}` }, ...(r.slot.kind === 'trigger' ? [arrow()] : []), r.slot.text) : el('span');
   const li = el('li', { class: 'mym-block' },
    el('div', { class: 'mym-head' }, el('h2', {}, r.title), when),
    el('p', { class: 'mym-desc' }, r.desc),
    ...(r.parts.length ? [el('p', { class: 'mym-parts' }, ...r.parts.map((p) => el('span', { class: 'mym-part' }, ownerTags(p.owners), ' ', p.label)))] : []),
    ...(locked ? [] : [(() => { const b = el('button', { type: 'button', class: 'cp-link mym-change' }, el('span', {}, 'Change when')); b.addEventListener('click', () => open('when', r.key)); return b; })()]));
   li.style.setProperty('--mym-tint', ({ morning: '#F8E8B5', move: '#F4DEA3', create: '#F0D493', lunch: '#DDEBDB', quiet: '#D1E5D6', free: '#C3DDCF', snack: '#E4E9D5', evening: '#D1D7EA' } as Record<MayKey, string>)[r.key]);
   return li;
  }));
  const times = s.rows.filter((r) => r.slot?.kind === 'time').length, triggers = s.rows.filter((r) => r.slot?.kind === 'trigger').length;
  const jobs = s.rows.reduce((n, r) => n + r.parts.length, 0);
  q('[data-may-edit]').replaceChildren(
   row('1 · Our day', `${s.rows.length} blocks`, s.rows.map((r) => r.title).join(' · '), () => open('day')),
   row('2 · When it happens', [times ? `${times} by the clock` : '', triggers ? `${triggers} after an event` : '', s.rows.length - times - triggers ? `${s.rows.length - times - triggers} flexible` : ''].filter(Boolean).join(' · '), 'Time, trigger or flexible, block by block', () => open('when')),
   row('3 · Activities & responsibilities', jobs ? `${jobs} family ${jobs === 1 ? 'job' : 'jobs'}` : 'Activities only', 'Ideas for each block and who helps', () => open('jobs')));
 };
 ui = mountPlanScreen({ root, host, approvalKey: 'omc:preview:may-summer-rhythm:approval', render });
 // Closing the sheet another way (×, backdrop, Escape) keeps her changes, like Done: they save as she goes.
 sheetEl()?.addEventListener('close', () => { opened = null; });
}
</script>
<style is:global>
@media screen and (max-width:1099px){
.mym{display:grid;gap:14px;margin:0 0 24px}
.mym-motto{margin:0;font:italic 400 1.05rem/1.4 var(--font-serif);color:var(--cp-soft)}
.mym-blocks{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.mym-block{padding:14px 16px 12px;border:1px solid #e4e8e0;border-radius:9px;background:linear-gradient(90deg,var(--mym-tint,#eef4ea) 0%,#fff 92%)}
.mym-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.mym-head h2{margin:0;font:400 clamp(21px,5.8vw,25px)/1.15 var(--font-serif);color:#455644}
.mym-when{flex:none;max-width:48%;display:block;text-align:right;color:#4f6a49}
.mym-when--time{font:700 1.2rem/1.1 var(--font-sans);letter-spacing:-.02em}
.mym-when--trigger{font:600 .9rem/1.25 var(--font-sans)}
.mym-when--none{font-size:.8rem;color:var(--cp-soft)}
.mym-arrow{display:inline-block;width:12px;height:12px;margin-right:5px;vertical-align:-1px;color:#7c9675}
.mym-desc{margin:6px 0 0;font-size:.95rem;line-height:1.45;color:#5d685b}
.mym-parts{display:flex;flex-wrap:wrap;gap:4px 12px;margin:8px 0 0;font-size:.85rem;color:#59664f}
.mym-part{display:inline-flex;flex-wrap:wrap;align-items:center;gap:2px 5px}
.mym-change{margin-top:6px}
.mym-rule{padding:14px 15px;border-radius:7px;background:#edf3e9;text-align:center}
.mym-rule span{display:block;font-size:.66rem;letter-spacing:.13em;font-weight:700;text-transform:uppercase;color:#687c61}
.mym-rule strong{display:block;margin:5px 0;font:400 1.2rem/1.3 var(--font-serif);color:#3e5e3f}
.mym-rule p{margin:0;font-size:.85rem;color:#647960}
.mym-step{font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--cp-soft)}
}
</style>

.osr-paper-head>p{font-size:9px;color:#405f53}
.osr-paper-head h2{font:400 39px/1.1 'OSR Gelasio',Georgia,serif;color:#3d6556;margin:12px 0 8px}
.osr-paper-head h2 em{font-weight:600}

</style>
<script>
type Member={id:string;firstName:string;kind:string;birthYear?:number;birthMonth?:number;role?:string;isAccountHolder?:boolean};
type Household={id:string;displayName?:string;members?:Member[]};
type State={trigger:string;leadId:string;assignments:Record<string,string>};
const defaultTrigger='Every Sunday after lunch';
const ageOf=(m:Member)=>m.birthYear?Math.max(1,2027-m.birthYear-((m.birthMonth??1)>10?1:0)):8;
const assigned=(m:Member)=>m.kind!=='child'?'Review the calendar, own logistics and any follow-through that needs an adult.':ageOf(m)<=4?'Find my coat and shoes with a grown-up.':ageOf(m)<=7?'Find my backpack, choose Monday clothes, and put shoes by the door.':ageOf(m)<=11?'Check the week, prepare school bag, clothes and activity gear.':'Review this week’s plans, prepare my own gear and flag any unmet needs.';
for(const root of document.querySelectorAll<HTMLElement>('.osr')){
 const storageKey=root.dataset.osrKey??'omc:preview:october-sunday-reset:v1';
 let current='',members:Member[]=[];
 let state:State={trigger:defaultTrigger,leadId:'',assignments:{}};
 const stage=root.querySelector<HTMLElement>('[data-osr-stage]');
 const pages=root.querySelector<HTMLElement>('[data-osr-pages]');
 const sheets=Array.from(root.querySelectorAll<HTMLElement>('.osr-paper'));
 const fit=()=>{if(!stage||!pages)return;const scale=Math.min(1,Math.max(180,stage.clientWidth-2)/816);pages.style.gap=22*scale+'px';for(const sheet of sheets){sheet.style.setProperty('--osr-scale',String(scale));sheet.style.marginBottom=-(1056*(1-scale))+'px';sheet.style.marginRight=-(816*(1-scale))+'px'}};
 fit();if(stage&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(stage);
 const save=()=>{try{sessionStorage.setItem(storageKey,JSON.stringify({current,state}))}catch{}};
 const fillAssignments=()=>{for(const member of members)if(!state.assignments[member.id])state.assignments[member.id]=assigned(member)};
 const lead=()=>members.find(m=>m.id===state.leadId&&m.kind==='adult')??members.find(m=>m.kind==='adult');
 const paint=()=>{
  const family=root.querySelector<HTMLElement>('[data-osr-family]');if(family)family.textContent='A weekly rhythm for '+(members.length?members.map(m=>m.firstName).slice(0,2).join(' & ')+(members.length>2?' and family':''):'our family');
  const cue=root.querySelector<HTMLElement>('[data-osr-cue]');if(cue)cue.textContent=state.trigger;
  const selected=root.querySelector<HTMLSelectElement>('[data-osr-trigger]');if(selected)selected.value=state.trigger;
  const leadSelect=root.querySelector<HTMLSelectElement>('[data-osr-lead]');if(leadSelect)leadSelect.value=lead()?.id??'';
  const childFacingLead=()=>{const adult=lead();if(!adult)return 'the responsible adult';const parents=members.filter(m=>m.kind==='adult'&&(m.role==='parent'||m.role==='partner'));const index=parents.indexOf(adult);return index===0?'Mom':index===1?'Dad':adult.firstName;};
   const who=root.querySelector<HTMLElement>('[data-osr-lead-name]');if(who)who.textContent=(lead()?.firstName??'An adult')+' owns the follow-through';
  const people=root.querySelector<HTMLElement>('[data-osr-people]');if(people){people.replaceChildren();for(const member of members.slice(0,9)){
   const entry=document.createElement('div');entry.className='osr-person'+(member.kind==='adult'?' osr-adult':'');
   const name=document.createElement('strong');name.textContent=member.firstName;
   const job=document.createElement('p');job.textContent=state.assignments[member.id]??assigned(member);
   entry.append(name,job);people.append(entry);
  }if(members.length===0){const empty=document.createElement('div');empty.className='osr-person';empty.textContent='Choose a preview family to see prepared assignments.';people.append(empty)}}
  const editor=root.querySelector<HTMLElement>('[data-osr-edit-assignments]');
  if(editor){editor.replaceChildren();for(const member of members){
    const div=document.createElement('div');div.className='osr-edit-entry';
    const label=document.createElement('label');label.textContent=member.firstName+' — weekly preparation';
    const input=document.createElement('input');input.type='text';input.maxLength=105;input.value=state.assignments[member.id]??assigned(member);
    input.addEventListener('input',()=>{state.assignments[member.id]=input.value.slice(0,105);save();const row=Array.from(root.querySelectorAll<HTMLElement>('.osr-person')).find(x=>x.querySelector('strong')?.textContent===member.firstName);if(row)row.querySelector('p')!.textContent=input.value});
    div.append(label,input);editor.append(div);
  }}
  const childCount=members.filter(m=>m.kind==='child').length;
  const clothes=root.querySelector<HTMLElement>('[data-osr-clothes]');if(clothes)clothes.textContent=childCount?'Kids try on their coats, jackets and shoes; little ones have adult help. Anything too small is reported to '+childFacingLead()+'.':'Check jackets, shoes and layers for cooler mornings; set aside anything that needs replacing.';
  const gear=root.querySelector<HTMLElement>('[data-osr-gear]');if(gear)gear.textContent='Each person checks what they need for school, work, or activities this week. Prepare what is clean and ready; tell '+childFacingLead()+' about gaps.';
  const home=root.querySelector<HTMLElement>('[data-osr-home]');if(home)home.textContent='Give coats, shoes, bags and outdoor gear a reachable home so everyone can find and put away their own things.';
 };
 root.querySelector<HTMLSelectElement>('[data-osr-trigger]')?.addEventListener('change',e=>{state.trigger=(e.target as HTMLSelectElement).value;save();paint()});
 root.querySelector<HTMLSelectElement>('[data-osr-lead]')?.addEventListener('change',e=>{state.leadId=(e.target as HTMLSelectElement).value;save();paint()});
 root.querySelector('[data-osr-restore]')?.addEventListener('click',()=>{state={trigger:defaultTrigger,leadId:members.find(m=>m.kind==='adult'&&!m.isAccountHolder)?.id??members.find(m=>m.kind==='adult')?.id??'',assignments:{}};fillAssignments();save();paint()});
 root.querySelector('[data-osr-print]')?.addEventListener('click',()=>window.print());
 const png=root.querySelector<HTMLButtonElement>('[data-osr-png]');png?.addEventListener('click',async()=>{const front=root.querySelector<HTMLElement>('[data-osr-front]');if(!front)return;png.disabled=true;const original=png.textContent;png.textContent='Preparing image…';root.classList.add('osr-export');
  try{await Promise.all(Array.from(front.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));const {toPng}=await import('html-to-image');const uri=await toPng(front,{pixelRatio:2,width:816,height:1056,backgroundColor:'#fff',style:{transform:'none',marginBottom:'0px',marginRight:'0px'}});const link=document.createElement('a');link.download='our-sunday-reset.png';link.href=uri;link.click()}catch(error){console.error(error);alert('Image download failed. Please use Print / Save PDF instead.')}finally{root.classList.remove('osr-export');png.disabled=false;png.textContent=original}});
 window.addEventListener('omc:club-preview-household',(event:Event)=>{
  const detail=(event as CustomEvent<{household:Household;sample:string}>).detail;if(!detail?.household)return;
  const key=detail.sample+':'+detail.household.id;members=(detail.household.members??[]).filter(m=>m.kind==='adult'||m.kind==='child');
  if(key!==current){current=key;state={trigger:defaultTrigger,leadId:members.find(m=>m.kind==='adult'&&!m.isAccountHolder)?.id??members.find(m=>m.kind==='adult')?.id??'',assignments:{}};try{const previous=JSON.parse(sessionStorage.getItem(storageKey)??'null');if(previous?.current===key&&previous.state&&typeof previous.state.trigger==='string'&&typeof previous.state.assignments==='object')state=previous.state}catch{}}
  if(!members.some(m=>m.id===state.leadId&&m.kind==='adult'))state.leadId=members.find(m=>m.kind==='adult')?.id??'';
  fillAssignments();
  const select=root.querySelector<HTMLSelectElement>('[data-osr-lead]');if(select){select.replaceChildren();for(const adult of members.filter(m=>m.kind==='adult')){const item=document.createElement('option');item.value=adult.id;item.textContent=adult.firstName;select.append(item)}}save();paint();
 });
 paint();
}
</script>

<script>
type Member={id:string;firstName:string;kind:string;birthYear?:number;birthMonth?:number;role?:string;isAccountHolder?:boolean};
type Household={id:string;displayName?:string;members?:Member[]};
type FallJob={id:string;title:string;description:string;icon:string;ownerId:string;removed?:boolean};
type State={trigger:string;assignments:Record<string,string>;fallJobs:FallJob[];text?:Record<string,string>;names?:Record<string,string>};
const defaultTrigger='Sunday after lunch';
const ageOf=(m:Member)=>m.birthYear?Math.max(1,2027-m.birthYear-((m.birthMonth??1)>10?1:0)):8;
const weeklyRole=(m:Member,i:number)=>m.kind==='adult'?(m.isAccountHolder?'Review our shared plans and prepare my own commitments.':'Own upcoming transportation, supplies, and logistics.'):(ageOf(m)<=5?'Look at the picture calendar with an adult and get my clothes ready.':ageOf(m)<=10?(i%2===0?'Check school and activity days; spot what I need.':'Prepare my clothes, bag, and belongings for the week.'):'Review my calendar, prepare for commitments, and ask for help early.');
const fallTemplates=[
 {id:'warm',title:'Check warmer clothes',description:'Try on long sleeves, pants, sweaters, and jackets. Set aside what no longer fits.',icon:'/images/club/october/clothes-for-cooler-mornings.webp'},
 {id:'summer',title:'Sort summer clothes',description:'Gather summer clothes. Keep what may fit next year, store it, and set aside outgrown items for adult review.',icon:'/images/club/october/school-and-activity-gear.webp'},
 {id:'gear',title:'Check seasonal gear',description:'Check coats, boots, hats, and gloves where needed. Flag anything missing or outgrown.',icon:'/images/club/october/a-home-for-everything.webp'}
];
for(const root of document.querySelectorAll<HTMLElement>('.osr')){
 root.querySelectorAll<HTMLButtonElement>('[data-osr-tab]').forEach(button=>{
  button.addEventListener('click',()=>{
   const selected=button.dataset.osrTab;
   root.querySelectorAll<HTMLButtonElement>('[data-osr-tab]').forEach(b=>{const active=b===button;b.setAttribute('aria-selected',String(active));b.tabIndex=active?0:-1});
   root.querySelectorAll<HTMLElement>('[data-osr-panel]').forEach(panel=>{panel.hidden=panel.dataset.osrPanel!==selected});
   root.querySelector<HTMLElement>('.osr-floating-edit')?.toggleAttribute('hidden',selected!=='reset');
  });
 });
 const storageKey=root.dataset.osrKey??'omc:preview:october-sunday-reset:v2';
 let current='',members:Member[]=[];
 let state:State={trigger:defaultTrigger,assignments:{},fallJobs:[]};
 const stage=root.querySelector<HTMLElement>('[data-osr-stage]');
 const pages=root.querySelector<HTMLElement>('[data-osr-pages]');
 const sheets=Array.from(root.querySelectorAll<HTMLElement>('.osr-paper'));
 // Desktop app uses PDF-style page frames: the frame owns scaled dimensions,
 // and the paper scales inside it. Mobile and legacy Club previews retain their original fitting.
 const documentMode=Boolean(root.closest('.club-mobile-kit') && window.matchMedia('(min-width: 1100px)').matches);
 const frames=documentMode?sheets.map(sheet=>{
   const frame=document.createElement('div');
   frame.className='osr-document-frame';
   sheet.before(frame);frame.appendChild(sheet);
   return frame;
 }):[];
 const fit=()=>{
  if(!stage||!pages)return;
  const desktop=Boolean(root.closest('.club-mobile-kit') && window.matchMedia('(min-width: 1100px)').matches);
  const available=Math.max(1,stage.clientWidth-2);
  const viewer=root.closest<HTMLElement>('.kit-artwork');
  // Fit a full letter page on desktop (width AND height), not merely its width.
  // Allow room for the viewer's padding so paper never appears cut off on load.
  const viewportHeight=viewer?.clientHeight ?? window.innerHeight;
  const verticalSpace=Math.max(220,viewportHeight-130);
  const scale=desktop?Math.min(1,available/816,verticalSpace/1056):Math.min(1,available/816);
  pages.style.gap=desktop?'28px':22*scale+'px';
  for(const [index,sheet] of sheets.entries()){
   sheet.style.setProperty('--osr-scale',String(scale));
   if(documentMode && desktop){
    const frame=frames[index];
    frame.style.width=816*scale+'px';
    frame.style.height=1056*scale+'px';
    sheet.style.marginBottom='0';
    sheet.style.marginRight='0';
   }else{
    sheet.style.marginBottom=-(1056*(1-scale))+'px';
    sheet.style.marginRight=-(816*(1-scale))+'px';
   }
  }
 };
 fit();if(stage&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(stage);
 const visionDialog=root.querySelector<HTMLDialogElement>('[data-osr-vision]');
 const editorDialog=root.querySelector<HTMLDialogElement>('[data-osr-editor]');
 root.querySelector('[data-open-vision]')?.addEventListener('click',()=>visionDialog?.showModal());
 root.querySelectorAll('[data-open-editor]').forEach(button=>button.addEventListener('click',()=>editorDialog?.showModal()));
 root.querySelectorAll('[data-close-dialog]').forEach(button=>button.addEventListener('click',()=>button.closest('dialog')?.close()));
 for(const dialog of [visionDialog,editorDialog])dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});
 const save=()=>{try{sessionStorage.setItem(storageKey,JSON.stringify({current,state}))}catch{}};
 const nameOf=(m:Member)=>{if(m.kind==='child')return state.names?.[m.id]??m.firstName;const parents=members.filter(x=>x.kind==='adult'&&(x.role==='parent'||x.role==='partner'));const ix=parents.findIndex(x=>x.id===m.id);return state.names?.[m.id]??(ix===0?'Mom':ix===1?'Dad':m.firstName)};
 const defaultFallJobs=():FallJob[]=>{const children=members.filter(m=>m.kind==='child');const adults=members.filter(m=>m.kind==='adult');const otherAdult=adults.find(m=>!m.isAccountHolder)??adults[0];return fallTemplates.map((item,i)=>({...item,ownerId:(i===2?otherAdult?.id:children[i]?.id??adults[i%Math.max(1,adults.length)]?.id)??members[i%Math.max(1,members.length)]?.id??''}))};
 const setup=()=>{members.forEach((m,i)=>{if(state.assignments[m.id]===undefined)state.assignments[m.id]=weeklyRole(m,i)});if(!state.fallJobs?.length)state.fallJobs=defaultFallJobs()};
 const clean=(el:HTMLElement,max:number)=>(el.textContent??'').replace(/\s+/g,' ').trim().slice(0,max);
 const write=(id:string,value:string)=>{const el=root.querySelector<HTMLElement>('[data-osr-'+id+']');if(el&&document.activeElement!==el)el.textContent=state.text?.[id]??value};
 const personChoices=(selected:string,change:(value:string)=>void)=>{const select=document.createElement('select');select.setAttribute('aria-label','Assigned family member');members.forEach(m=>{const option=document.createElement('option');option.value=m.id;option.textContent=nameOf(m);select.append(option)});select.value=selected;select.addEventListener('change',()=>change(select.value));return select};
 const drawFall=()=>{const container=root.querySelector<HTMLElement>('[data-osr-fall-sections]');if(!container)return;container.replaceChildren();for(const item of state.fallJobs.filter(x=>!x.removed)){
  const section=document.createElement('section');section.className='osr-person-task';
  const img=document.createElement('img');img.src=item.icon;img.alt='';img.width=58;img.height=58;
  const details=document.createElement('div');const heading=document.createElement('h3');heading.textContent=item.title;
  const owner=document.createElement('p');owner.className='osr-task-owner';owner.textContent=nameOf(members.find(m=>m.id===item.ownerId)??members[0]??{id:'',firstName:'Our family',kind:'adult'});
  const description=document.createElement('p');description.textContent=item.description;
  details.append(heading,owner,description);section.append(img,details);container.append(section);
 }if(!container.children.length){const empty=document.createElement('p');empty.textContent='No fall jobs selected. Restore a task in Make Changes.';container.append(empty)}};
 const drawEditor=()=>{
  const weekly=root.querySelector<HTMLElement>('[data-osr-edit-assignments]');if(weekly){weekly.replaceChildren();for(const member of members){
   const card=document.createElement('div');card.className='osr-guided-job';
   const heading=document.createElement('div');heading.className='osr-guided-job-header';const title=document.createElement('strong');title.textContent=nameOf(member);heading.append(title);
   const label=document.createElement('label');label.textContent='Weekly responsibility';
   const input=document.createElement('input');input.type='text';input.maxLength=105;input.value=state.assignments[member.id]??'';
   input.addEventListener('input',()=>{state.assignments[member.id]=input.value;save();const row=root.querySelector<HTMLElement>('[data-osr-person-job="'+member.id+'"]');if(row)row.textContent=input.value});
   label.append(input);card.append(heading,label);weekly.append(card);
  }}
  const fall=root.querySelector<HTMLElement>('[data-osr-fall-editor]');if(fall){fall.replaceChildren();for(const item of state.fallJobs){
   const card=document.createElement('div');card.className='osr-guided-job';
   const heading=document.createElement('div');heading.className='osr-guided-job-header';const title=document.createElement('strong');title.textContent=item.title;
   const tag=document.createElement('span');tag.textContent=item.removed?'REMOVED':'ONE-TIME JOB';heading.append(title,tag);card.append(heading);
   if(item.removed){const restore=document.createElement('button');restore.type='button';restore.className='osr-guide-add';restore.textContent='Restore this job';restore.addEventListener('click',()=>{item.removed=false;save();paint()});card.append(restore)}
   else{
    const ownerLabel=document.createElement('label');ownerLabel.textContent='Who owns this job?';ownerLabel.append(personChoices(item.ownerId,id=>{item.ownerId=id;save();drawFall()}));card.append(ownerLabel);
    const titleLabel=document.createElement('label');titleLabel.textContent='Job';const ti=document.createElement('input');ti.value=item.title;ti.maxLength=65;ti.addEventListener('input',()=>{item.title=ti.value;save();drawFall()});titleLabel.append(ti);card.append(titleLabel);
    const descLabel=document.createElement('label');descLabel.textContent='What finished looks like';const di=document.createElement('input');di.value=item.description;di.maxLength=180;di.addEventListener('input',()=>{item.description=di.value;save();drawFall()});descLabel.append(di);card.append(descLabel);
    const remove=document.createElement('button');remove.type='button';remove.className='osr-job-remove';remove.textContent='Remove this job';remove.addEventListener('click',()=>{item.removed=true;save();paint()});card.append(remove);
   }fall.append(card);
  }}
 };
 const paint=()=>{
  write('family','Look ahead. Get ready. Share the work.');
  write('cue',state.trigger);
  const summary=root.querySelector<HTMLElement>('[data-osr-summary-trigger]');if(summary)summary.textContent=state.trigger;
  root.querySelectorAll<HTMLButtonElement>('[data-osr-trigger-choice]').forEach(button=>{const active=button.dataset.osrTriggerChoice===state.trigger;button.classList.toggle('is-active',active);button.setAttribute('aria-pressed',String(active))});
  const custom=root.querySelector<HTMLInputElement>('[data-osr-custom-trigger]');if(custom&&document.activeElement!==custom)custom.value=state.trigger.startsWith('Sunday')&&['Sunday after breakfast','Sunday after church','Sunday after lunch','Sunday evening'].includes(state.trigger)?'':state.trigger;
  const people=root.querySelector<HTMLElement>('[data-osr-people]');if(people){people.replaceChildren();for(const member of members.slice(0,9)){
   const row=document.createElement('div');row.className='osr-person'+(member.kind==='adult'?' osr-adult':'');
   const name=document.createElement('strong');name.textContent=nameOf(member);name.contentEditable='true';name.dataset.osrPersonName=member.id;name.setAttribute('aria-label','Edit family member name');
   const job=document.createElement('p');job.textContent=state.assignments[member.id]??'';job.contentEditable='true';job.dataset.osrPersonJob=member.id;job.setAttribute('aria-label','Edit weekly responsibility');
   row.append(name,job);people.append(row);
  }if(!members.length){const row=document.createElement('div');row.className='osr-person';row.textContent='Choose a preview family to see prepared roles.';people.append(row)}}
  drawFall();drawEditor();
 };
 root.querySelectorAll<HTMLElement>('.osr-paper [contenteditable="true"]').forEach(el=>{if(!el.hasAttribute('data-osr-family')&&!el.hasAttribute('data-osr-cue'))return;const id=el.hasAttribute('data-osr-cue')?'cue':'family';
  const saveField=()=>{(state.text??={})[id]=clean(el,130);if(id==='cue')state.trigger=clean(el,85);save()};
  el.addEventListener('input',saveField);el.addEventListener('blur',()=>{saveField();paint()});
  el.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();el.blur()}})
 });
 root.querySelector<HTMLElement>('[data-osr-people]')?.addEventListener('input',event=>{const el=(event.target as HTMLElement).closest<HTMLElement>('[data-osr-person-job],[data-osr-person-name]');if(!el)return;if(el.dataset.osrPersonJob)state.assignments[el.dataset.osrPersonJob]=clean(el,105);if(el.dataset.osrPersonName)(state.names??={})[el.dataset.osrPersonName]=clean(el,35);save()});
 root.querySelector<HTMLElement>('[data-osr-people]')?.addEventListener('focusout',()=>paint());
 root.querySelector<HTMLElement>('[data-osr-people]')?.addEventListener('keydown',event=>{if((event as KeyboardEvent).key==='Enter'){event.preventDefault();(event.target as HTMLElement).blur()}});
 root.querySelectorAll<HTMLButtonElement>('[data-osr-trigger-choice]').forEach(button=>button.addEventListener('click',()=>{state.trigger=button.dataset.osrTriggerChoice??defaultTrigger;if(state.text)delete state.text.cue;save();paint()}));
 root.querySelector<HTMLInputElement>('[data-osr-custom-trigger]')?.addEventListener('input',event=>{state.trigger=(event.target as HTMLInputElement).value.slice(0,85);if(state.text)delete state.text.cue;save();write('cue',state.trigger);const summary=root.querySelector<HTMLElement>('[data-osr-summary-trigger]');if(summary)summary.textContent=state.trigger});
 root.querySelector('[data-osr-restore-fall]')?.addEventListener('click',()=>{state.fallJobs=defaultFallJobs();save();paint()});
 root.querySelector('[data-osr-restore]')?.addEventListener('click',()=>{state={trigger:defaultTrigger,assignments:{},fallJobs:[]};setup();save();paint()});
 root.querySelector('[data-osr-print]')?.addEventListener('click',()=>{(document.activeElement as HTMLElement|null)?.blur();window.print()});
 const png=root.querySelector<HTMLButtonElement>('[data-osr-png]');png?.addEventListener('click',async()=>{const front=root.querySelector<HTMLElement>('[data-osr-front]');if(!front)return;png.disabled=true;const original=png.textContent;png.textContent='Preparing image…';root.classList.add('osr-export');try{await Promise.all(Array.from(front.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));const {toPng}=await import('html-to-image');const uri=await toPng(front,{pixelRatio:2,width:816,height:1056,backgroundColor:'#fff',style:{transform:'none',marginBottom:'0px',marginRight:'0px'}});const link=document.createElement('a');link.download='our-family-sunday-reset.png';link.href=uri;link.click()}catch(error){console.error(error);alert('Image download failed. Please use Print / Save PDF instead.')}finally{root.classList.remove('osr-export');png.disabled=false;png.textContent=original}});
 const applyHousehold=(detail:{household:Household;sample:string})=>{if(!detail?.household)return;const key=detail.sample+':'+detail.household.id;members=(detail.household.members??[]).filter(m=>m.kind==='adult'||m.kind==='child');
  if(key!==current){current=key;state={trigger:defaultTrigger,assignments:{},fallJobs:[]};try{const previous=JSON.parse(sessionStorage.getItem(storageKey)??'null');if(previous?.current===key&&previous.state&&typeof previous.state.trigger==='string'&&previous.state.assignments&&Array.isArray(previous.state.fallJobs))state=previous.state}catch{}}setup();save();paint()};
 window.addEventListener('omc:club-preview-household',(event:Event)=>applyHousehold((event as CustomEvent<{household:Household;sample:string}>).detail));
 const cached=(window as Window & {__ofcPreviewHousehold?:{household:Household;sample:string}}).__ofcPreviewHousehold;if(cached)applyHousehold(cached);
 paint();
}
</script>

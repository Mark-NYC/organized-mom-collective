---
/**
 * October Sunday Reset on phones and tablets (below 1100px): the family's prepared plan as the screen itself,
 * a sheet per detail, approval in place, and a one-time copy. It reads and changes the plan only through the
 * printable's controller (`.osr` element's `osrPlan`, see src/lib/club/engines/october-sunday-reset.ts), so the
 * printable, its saving and its print output stay the single source. Design: docs/club/OCTOBER_PHASE2_DESIGN.md.
 */
import { SUNDAY_STEPS } from '../../lib/club/engines/october-sunday-reset';
interface Props { deadline: string }
const { deadline } = Astro.props;
---
<section class="omp" data-omp data-deadline={deadline} aria-labelledby="omp-title">
  <header class="omp-head">
    <p class="omp-kicker">October · Organized Family Club</p>
    <h1 id="omp-title" class="omp-title">Our Family <em>Sunday Reset</em></h1>
    <p class="omp-for"><span data-omp-for>Prepared for your family</span><span class="omp-tag" data-omp-sample hidden>Sample family</span></p>
  </header>

  <div class="omp-copy-banner" data-omp-copy-banner hidden>
    <strong>One-time copy</strong>
    <p>Changes here are for printing only. Your plan stays as it is, and this copy isn’t saved.</p>
  </div>

  <div class="omp-status" data-omp-status>
    <p class="omp-approval" data-omp-approval><span class="omp-mark" aria-hidden="true"></span><span data-omp-approval-text>Not approved yet</span></p>
    <p class="omp-window" data-omp-window></p>
  </div>

  <button type="button" class="omp-preview" data-kit-open-proof>
    <span class="omp-thumbs" aria-hidden="true" inert><span class="omp-thumb" data-omp-thumb="front"></span><span class="omp-thumb" data-omp-thumb="back"></span></span>
    <span class="omp-preview-text"><strong>Your printable</strong><span>Front and back, ready to print</span></span>
    <span class="omp-go" aria-hidden="true">View</span>
  </button>

  <button type="button" class="omp-rhythm" data-omp-edit="rhythm" aria-describedby="omp-rhythm-note">
    <span class="omp-rhythm-label" data-omp-rhythm-label>Every Sunday</span>
    <span class="omp-rhythm-time" data-omp-trigger>After lunch</span>
    <span class="omp-rhythm-note" id="omp-rhythm-note">10–15 minutes together with our wall calendar.</span>
    <span class="omp-change" aria-hidden="true">Change</span>
  </button>
  <ol class="omp-steps" aria-label="Every Sunday, three simple steps">
    {SUNDAY_STEPS.map((step) => (
      <li><img src={step.icon} alt="" width="44" height="44" loading="lazy" /><span><strong>{step.title}</strong>{step.text}</span></li>
    ))}
  </ol>

  <section class="omp-section" aria-labelledby="omp-people-title">
    <h2 id="omp-people-title">Everyone has a part</h2>
    <p class="omp-intro">The same small job every Sunday, so it isn’t all on you.</p>
    <ul class="omp-group" data-omp-people></ul>
  </section>

  <section class="omp-section" aria-labelledby="omp-fall-title">
    <h2 id="omp-fall-title">First, try it: fall readiness</h2>
    <p class="omp-intro">Do these once, together. Next Sunday, use the same three steps for whatever’s coming up.</p>
    <ul class="omp-group" data-omp-jobs></ul>
  </section>

  <p class="omp-more"><button type="button" class="omp-link" data-omp-copy>Need a different version? <span>Make a one-time copy</span></button></p>
  <p class="omp-foot" data-omp-foot></p>

  <div class="omp-bar" data-omp-bar>
    <div class="omp-bar-inner">
      <button type="button" class="omp-primary" data-omp-primary>Approve this plan</button>
      <button type="button" class="omp-square" data-kit-print aria-label="Print or save as PDF" title="Print or save as PDF" data-omp-print><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v7H6zM18 12h.01"/></svg></button>
      <button type="button" class="omp-square omp-done" data-omp-copy-done hidden>Done</button>
    </div>
  </div>

  <dialog class="omp-sheet" data-omp-sheet aria-labelledby="omp-sheet-title">
    <div class="omp-sheet-head"><h2 id="omp-sheet-title" data-omp-sheet-title></h2><button type="button" class="omp-close" data-omp-sheet-close aria-label="Close">×</button></div>
    <div class="omp-sheet-body" data-omp-sheet-body></div>
  </dialog>
  <div class="omp-toast" data-omp-toast role="status" aria-live="polite" hidden><span data-omp-toast-text></span><button type="button" data-omp-toast-undo hidden>Undo</button></div>
</section>

<style is:global>
.omp{display:none}
@media screen and (max-width:1099px){
.club-mobile-kit > .omp{display:block}
.omp{--omp-sage:#536e4e;--omp-wash:#eef2ea;--omp-line:var(--color-warm-rule);--omp-soft:var(--color-warm-soft);--omp-ink:var(--color-warm-ink);
 max-width:640px;margin:0 auto;padding-bottom:64px;color:var(--omp-ink);font-family:var(--font-sans)}
:where(.omp) button{font:inherit;color:inherit}
.omp-head{margin:0 0 18px}
.omp-kicker{font-size:.69rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--omp-soft)}
.omp-title{font:400 clamp(32px,8.6vw,42px)/1.08 var(--font-serif);letter-spacing:-.02em;margin:10px 0 8px}
.omp-for{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:.98rem;color:var(--omp-soft)}
.omp-tag{border:1px solid var(--omp-line);background:#fff;padding:2px 8px;font-size:.75rem;font-weight:600;color:var(--omp-ink)}
.omp-tag[hidden]{display:none}

.omp-status{display:grid;gap:3px;border-top:1px solid var(--omp-line);border-bottom:1px solid var(--omp-line);padding:12px 0;margin:0 0 16px}
.omp-approval{display:flex;align-items:center;gap:9px;font-size:.92rem;font-weight:600}
.omp-mark{flex:none;width:16px;height:16px;border:1.5px solid var(--color-sage);border-radius:50%;display:grid;place-items:center}
.omp[data-approval="approved"] .omp-mark{background:var(--omp-sage);border-color:var(--omp-sage)}
.omp[data-approval="approved"] .omp-mark::after{content:"";width:7px;height:4px;border:solid #fff;border-width:0 0 1.5px 1.5px;transform:translateY(-1px) rotate(-45deg)}
.omp[data-approval="changed"] .omp-mark{border-style:dashed}
.omp-window{padding-left:25px;font-size:.85rem;color:var(--omp-soft)}
.omp[data-window="soon"] .omp-window,.omp[data-window="today"] .omp-window{color:var(--omp-sage);font-weight:600}

.omp-preview{display:flex;align-items:center;gap:14px;width:100%;min-height:72px;padding:10px 14px 10px 10px;margin:0 0 22px;border:1px solid var(--omp-line);background:#fff;text-align:left;cursor:pointer}
.omp-thumbs{display:flex;gap:5px;flex:none}
.omp-thumb{position:relative;display:block;width:46px;height:60px;overflow:hidden;background:#fff;box-shadow:0 0 0 1px #e3e0da,0 2px 6px #0000000f}
.omp-thumb .osr-paper{position:absolute;top:0;left:0;margin:0;box-shadow:none;border:0}
.omp-preview-text{display:grid;gap:2px;flex:1;min-width:0}
.omp-preview-text strong{font-size:.95rem;font-weight:600}
.omp-preview-text span{font-size:.82rem;color:var(--omp-soft)}
.omp-go{font-size:.82rem;font-weight:600;color:var(--omp-sage);text-decoration:underline;text-underline-offset:4px}

.omp-rhythm{position:relative;display:grid;gap:6px;width:100%;padding:20px 20px 18px;border:0;background:var(--omp-wash);text-align:left;cursor:pointer}
.omp-rhythm-label{font-size:.8rem;font-weight:600;color:var(--omp-sage)}
.omp-rhythm-time{font:400 clamp(28px,7.6vw,34px)/1.1 var(--font-serif);letter-spacing:-.01em}
.omp-rhythm-note{font-size:.9rem;line-height:1.55;color:var(--omp-soft);max-width:30ch}
.omp-change{position:absolute;top:18px;right:18px;font-size:.82rem;font-weight:600;color:var(--omp-sage);text-decoration:underline;text-underline-offset:4px}
.omp-steps{list-style:none;margin:0 0 30px;padding:6px 0 0;display:grid}
.omp-steps li{display:grid;grid-template-columns:44px 1fr;gap:14px;align-items:center;padding:12px 4px;border-bottom:1px solid var(--omp-line)}
.omp-steps img{width:44px;height:44px;object-fit:contain}
.omp-steps span{font-size:.88rem;line-height:1.45;color:var(--omp-soft)}
.omp-steps strong{display:block;font-size:.98rem;font-weight:600;color:var(--omp-ink);margin-bottom:1px}

.omp-section{margin:0 0 30px}
.omp-section h2{font:400 clamp(24px,6.4vw,28px)/1.15 var(--font-serif);margin:0 0 4px}
.omp-intro{font-size:.9rem;line-height:1.55;color:var(--omp-soft);margin:0 0 12px}
.omp-group{list-style:none;margin:0;padding:0;border:1px solid var(--omp-line);background:#fff}
.omp-group > li + li{border-top:1px solid var(--omp-line)}
.omp-row{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;width:100%;min-height:64px;padding:13px 14px 13px 16px;border:0;background:transparent;text-align:left;cursor:pointer}
.omp-row:disabled{cursor:default}
.omp-avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--omp-wash);color:var(--omp-sage);font:400 1.15rem var(--font-serif)}
.omp-row-text{display:grid;gap:2px;min-width:0}
.omp-row-text strong{font-size:1rem;font-weight:600}
.omp-row-text span{font-size:.88rem;line-height:1.45;color:var(--omp-soft)}
.omp-row img{width:42px;height:42px;object-fit:contain}
.omp-row-text .omp-owner{justify-self:start;margin-top:3px;padding:2px 8px;background:var(--omp-wash);color:var(--omp-sage);font-size:.8rem;font-weight:600}
.omp-chev{width:9px;height:9px;border:solid #a39b97;border-width:1.5px 1.5px 0 0;transform:rotate(45deg);margin-right:4px}
.omp-row:disabled .omp-chev,.omp[data-readonly] .omp-change{display:none}
.omp-removed{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:52px;padding:8px 14px 8px 16px;font-size:.88rem;color:var(--omp-soft)}
.omp-removed s{text-decoration-color:#b9b1ad}
.omp-link{min-height:44px;border:0;background:none;padding:0;cursor:pointer;color:var(--omp-soft);font-size:.9rem;text-align:left}
.omp-link span,.omp-removed button{color:var(--omp-sage);font-weight:600;text-decoration:underline;text-underline-offset:4px}
.omp-removed button{min-height:44px;border:0;background:none;cursor:pointer;font-size:.88rem}
.omp-more{margin:-8px 0 12px}
.omp-foot{font-size:.8rem;line-height:1.6;color:var(--omp-soft);border-top:1px solid var(--omp-line);padding-top:14px}

.omp-copy-banner{border-left:3px solid var(--color-sage);background:#f1f2f2;padding:12px 16px;margin:0 0 16px}
.omp-copy-banner[hidden]{display:none}
.omp-copy-banner strong{font-size:.92rem}
.omp-copy-banner p{font-size:.86rem;line-height:1.5;color:var(--omp-soft);margin-top:2px}
.omp[data-mode="copy"] .omp-status,.omp[data-mode="copy"] .omp-more{display:none}

/* Above the app tab bar when it shows (it carries the safe area); otherwise at the bottom edge. */
.omp-bar{position:fixed;left:0;right:0;bottom:var(--omp-nav,0px);z-index:38;background:rgba(255,253,250,.97);border-top:1px solid var(--omp-line);box-shadow:0 -6px 18px #3d38340d;padding:10px 20px calc(10px + var(--omp-safe,0px))}
.omp-bar-inner{max-width:640px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}
.omp-primary{min-height:52px;padding:10px 14px;border:1px solid var(--color-warm-button);border-radius:3px;background:var(--color-warm-button);color:#fff;font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
.omp-primary[aria-disabled="true"]{background:var(--omp-wash);border-color:var(--color-sage);color:var(--omp-sage);cursor:default}
.omp-square{display:grid;place-items:center;min-width:52px;height:52px;padding:0 14px;border:1px solid var(--omp-ink);border-radius:3px;background:#fff;cursor:pointer}
.omp-square[hidden]{display:none}
.omp-done{font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}
.omp :focus-visible,.omp-sheet :focus-visible{outline:2px solid var(--omp-sage);outline-offset:2px}

.omp-toast{position:fixed;left:50%;bottom:calc(var(--omp-nav,0px) + 86px);z-index:39;transform:translateX(-50%);display:flex;align-items:center;gap:14px;width:max-content;max-width:calc(100vw - 32px);padding:11px 16px;background:var(--omp-ink);color:#fff;font-size:.88rem;line-height:1.4;box-shadow:0 8px 24px #0002}
.omp-toast[hidden]{display:none}
.omp-toast button{min-height:36px;border:0;background:none;color:#fff;font-weight:600;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.omp-toast button[hidden]{display:none}

.omp-sheet{position:fixed;inset:auto 0 0 0;width:100%;max-width:640px;max-height:88dvh;margin:auto auto 0;padding:0;border:0;border-radius:10px 10px 0 0;background:var(--color-ivory);color:var(--omp-ink);overflow-y:auto;overscroll-behavior:contain;box-shadow:0 -10px 40px #0003}
.omp-sheet::backdrop{background:rgba(45,40,38,.45)}
.omp-sheet-head{position:sticky;top:0;z-index:1;display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:22px 20px 10px;background:var(--color-ivory)}
.omp-sheet-head::before{content:"";position:absolute;top:8px;left:50%;width:36px;height:4px;margin-left:-18px;border-radius:2px;background:#d9d2cb}
.omp-sheet-head h2{font:400 clamp(22px,6vw,26px)/1.2 var(--font-serif);margin:0}
.omp-close{flex:none;width:44px;height:44px;margin:-8px -10px 0 0;border:0;background:none;font-size:1.6rem;line-height:1;color:var(--omp-soft);cursor:pointer}
.omp-sheet-body{display:grid;gap:16px;padding:6px 20px calc(22px + env(safe-area-inset-bottom,0px))}
.omp-sheet-hint{font-size:.9rem;line-height:1.5;color:var(--omp-soft);margin-top:-8px}
.omp-chips{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.omp-chips.omp-people-chips{display:flex;flex-wrap:wrap}
.omp-chip{min-height:52px;padding:10px 14px;border:1px solid #d6ddd2;border-radius:3px;background:#fff;text-align:left;font-size:.95rem;font-weight:600;cursor:pointer}
.omp-people-chips .omp-chip{min-height:44px;padding:8px 16px;text-align:center}
.omp-chip[aria-pressed="true"]{border:2px solid var(--omp-sage);background:var(--omp-wash);padding:9px 13px;color:#3f5b3c}
.omp-people-chips .omp-chip[aria-pressed="true"]{padding:7px 15px}
.omp-field{display:grid;gap:6px;font-size:.85rem;font-weight:600}
.omp-field input,.omp-field textarea,.omp-own textarea{width:100%;min-height:48px;padding:11px 12px;border:1px solid #cfc6bf;border-radius:3px;background:#fff;font:400 1rem/1.45 var(--font-sans);color:var(--omp-ink)}
.omp-field textarea,.omp-own textarea{min-height:76px;resize:vertical}
.omp-choices{display:grid;gap:8px;border:0;margin:0;padding:0}
.omp-choice{display:grid;grid-template-columns:22px 1fr;gap:12px;align-items:start;padding:13px 14px;border:1px solid #d6ddd2;border-radius:3px;background:#fff;font-size:.95rem;line-height:1.45;cursor:pointer}
.omp-choice:has(input:checked){border:2px solid var(--omp-sage);background:var(--omp-wash);padding:12px 13px}
.omp-choice input{width:20px;height:20px;margin:1px 0 0;accent-color:var(--omp-sage)}
.omp-own{display:grid;gap:8px}
.omp-sheet-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px}
.omp-sheet-actions > :only-child{grid-column:1/-1}
.omp-btn{min-height:50px;padding:10px 14px;border:1px solid var(--omp-ink);border-radius:3px;background:#fff;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}
.omp-btn-dark{background:var(--color-warm-button);border-color:var(--color-warm-button);color:#fff}
.omp-text-btn{justify-self:start;min-height:44px;border:0;background:none;padding:0;color:#8c514c;font-size:.9rem;font-weight:600;text-decoration:underline;text-underline-offset:4px;cursor:pointer}
}
@media screen and (max-width:1099px) and (prefers-reduced-motion:no-preference){
 .omp-sheet[open]{animation:omp-up .2s ease-out}
 @keyframes omp-up{from{transform:translateY(24px);opacity:.6}}
}
@media print{.omp{display:none}}
</style>

<script>
import { editingWindow } from '../../lib/club/edition-status';
import {
  TRIGGER_CHOICES, planFingerprint, roleSuggestions, setFallJob, setName, setRole, setTrigger,
  type OsrPlan, type PlanMember, type PlanState,
} from '../../lib/club/engines/october-sunday-reset';

const APPROVAL_KEY = 'omc:preview:october-sunday-reset:approval';
const CHOICE_LABEL: Record<string, string> = { 'Sunday after breakfast': 'After breakfast', 'Sunday after church': 'After church', 'Sunday after lunch': 'After lunch', 'Sunday evening': 'Sunday evening' };

const root = document.querySelector<HTMLElement>('[data-omp]');
const kit = root?.closest<HTMLElement>('.club-mobile-kit');
const osr = kit?.querySelector<HTMLElement & { osrPlan?: OsrPlan }>('.osr');
if (root && kit && osr) {
  const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Record<string, unknown> = {}, ...kids: (Node | string)[]): HTMLElementTagNameMap[K] => {
    const { class: cls, ...rest } = props;
    const node = Object.assign(document.createElement(tag), rest) as HTMLElementTagNameMap[K];
    if (typeof cls === 'string') node.className = cls;
    node.append(...kids);
    return node;
  };
  const sheet = $<HTMLDialogElement>('[data-omp-sheet]');
  const plan = () => osr.osrPlan!;
  let copySnapshot: PlanState | null = null;
  let toastTimer = 0;

  // Prototype approval: kept in this tab against a fingerprint of what prints (production: approved_revision).
  type Approval = { for: string; print: string; at: string };
  const readApproval = (): Approval | null => {
    try {
      const a = JSON.parse(sessionStorage.getItem(APPROVAL_KEY) ?? 'null') as Approval | null;
      return a && a.for === kit.dataset.planFor ? a : null;
    } catch { return null; }
  };
  const writeApproval = (a: Approval | null) => {
    try { if (a) sessionStorage.setItem(APPROVAL_KEY, JSON.stringify(a)); else sessionStorage.removeItem(APPROVAL_KEY); } catch { /* this visit only */ }
  };

  const now = () => {
    const d = import.meta.env.DEV ? new URLSearchParams(location.search).get('preview-date') : null;
    return d ? new Date(d) : new Date();
  };
  const windowState = () => editingWindow(root.dataset.deadline ?? '', now());
  const readOnly = () => windowState().phase === 'closed' && !copySnapshot;

  const toast = (text: string, undo?: () => void) => {
    const t = $('[data-omp-toast]');
    $('[data-omp-toast-text]').textContent = text;
    const u = $<HTMLButtonElement>('[data-omp-toast-undo]');
    u.hidden = !undo;
    u.onclick = undo ? () => { undo(); t.hidden = true; } : null;
    t.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { t.hidden = true; }, 6000);
  };

  // ------------------------------------------------------------ the plan screen
  const shortTrigger = (t: string) => {
    const rest = t.replace(/^sunday\s+/i, '');
    return rest === t ? t : rest.charAt(0).toUpperCase() + rest.slice(1);
  };
  let thumbTimer = 0;
  const paintThumbs = () => {
    for (const side of ['front', 'back'] as const) {
      const src = osr.querySelector<HTMLElement>(`.osr-pages .osr-${side}`);
      const box = root.querySelector<HTMLElement>(`[data-omp-thumb="${side}"]`);
      if (!src || !box) continue;
      const copy = src.cloneNode(true) as HTMLElement;
      copy.querySelectorAll('*').forEach((n) => {
        for (const a of [...n.attributes]) if (a.name.startsWith('data-osr') || ['contenteditable', 'role', 'aria-label', 'spellcheck', 'id'].includes(a.name)) n.removeAttribute(a.name);
      });
      copy.removeAttribute('data-osr-front');
      copy.removeAttribute('data-osr-back');
      copy.style.cssText = `--osr-scale:${box.clientWidth / 816}`;
      box.replaceChildren(copy);
    }
  };

  const render = () => {
    const p = plan();
    if (!p.ready()) return;
    const s = p.state();
    const members = p.members();
    const locked = readOnly();
    root.toggleAttribute('data-readonly', locked);
    root.dataset.mode = copySnapshot ? 'copy' : 'plan';

    $('[data-omp-for]').textContent = 'Prepared for ' + (kit.dataset.planLabel || 'your family');
    $('[data-omp-sample]').hidden = kit.dataset.planSource !== 'sample';
    $<HTMLButtonElement>('[data-omp-edit="rhythm"]').disabled = locked;
    const sunday = /^sunday\b/i.test(s.trigger);
    $('[data-omp-rhythm-label]').textContent = sunday ? 'Every Sunday' : 'Our weekly reset';
    $('[data-omp-trigger]').textContent = sunday ? shortTrigger(s.trigger) : s.trigger;
    $('[data-omp-edit="rhythm"]').setAttribute('aria-label', `When you reset: ${s.trigger}. Change`);

    const people = $('[data-omp-people]');
    people.replaceChildren(...members.map((m) => {
      const name = p.nameOf(m);
      const row = el('button', { type: 'button', class: 'omp-row', disabled: locked },
        el('span', { class: 'omp-avatar' }, name.charAt(0)),
        el('span', { class: 'omp-row-text' }, el('strong', {}, name), el('span', {}, s.assignments[m.id] || 'No part yet')),
        el('span', { class: 'omp-chev' }));
      row.setAttribute('aria-label', `${name}: ${s.assignments[m.id] || 'no part yet'}. Change`);
      row.addEventListener('click', () => openPerson(m.id));
      return el('li', {}, row);
    }));

    const jobs = $('[data-omp-jobs]');
    jobs.replaceChildren(...s.fallJobs.map((j) => {
      if (j.removed) {
        const restore = el('button', { type: 'button', disabled: locked }, 'Restore');
        restore.setAttribute('aria-label', `Restore ${j.title}`);
        restore.addEventListener('click', () => p.update((st) => setFallJob(st, j.id, { removed: false })));
        return el('li', { class: 'omp-removed' }, el('s', {}, j.title), locked ? '' : restore);
      }
      const owner = members.find((m) => m.id === j.ownerId);
      const who = owner ? p.nameOf(owner) : 'Everyone';
      const row = el('button', { type: 'button', class: 'omp-row', disabled: locked },
        el('img', { src: j.icon, alt: '', width: 42, height: 42 }),
        el('span', { class: 'omp-row-text' }, el('strong', {}, j.title), el('span', { class: 'omp-owner' }, who)),
        el('span', { class: 'omp-chev' }));
      row.setAttribute('aria-label', `${j.title}, ${who}. Change`);
      row.addEventListener('click', () => openJob(j.id));
      return el('li', {}, row);
    }));
    if (!s.fallJobs.some((j) => !j.removed)) jobs.prepend(el('li', { class: 'omp-removed' }, 'No fall jobs this month.'));

    // Status and the action bar.
    const w = windowState();
    root.dataset.window = w.phase;
    $('[data-omp-window]').textContent = w.phase === 'closed' ? `${w.text}. You can still print a copy.` : w.text;
    const a = readApproval();
    const approval = !a ? 'none' : a.print === planFingerprint(s) ? 'approved' : 'changed';
    root.dataset.approval = approval;
    const day = a ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(new Date(a.at)) : '';
    $('[data-omp-approval-text]').textContent =
      approval === 'approved' ? `Approved ${day} · preview only` : approval === 'changed' ? 'Changed since you approved' : 'Not approved yet';
    const primary = $<HTMLButtonElement>('[data-omp-primary]');
    const copy = Boolean(copySnapshot);
    primary.textContent = copy ? 'Print this copy' : locked ? 'Print a copy' : approval === 'approved' ? '✓ Approved' : approval === 'changed' ? 'Approve changes' : 'Approve this plan';
    primary.setAttribute('aria-disabled', String(!copy && !locked && approval === 'approved'));
    $<HTMLButtonElement>('[data-omp-print]').hidden = copy || locked;
    $<HTMLButtonElement>('[data-omp-copy-done]').hidden = !copy;
    $('[data-omp-copy-banner]').hidden = !copy;

    const sample = kit.dataset.planSource === 'sample';
    $('[data-omp-foot]').textContent = (sample ? `${kit.dataset.planLabel?.replace(/^the /, 'The ') ?? 'This family'} is a made-up sample family for this preview. ` : '')
      + 'Changes and approval stay in this browser tab for now. Nothing is saved to an account or mailed yet.';

    clearTimeout(thumbTimer);
    thumbTimer = window.setTimeout(paintThumbs, 120);
  };

  // ------------------------------------------------------------ sheets
  const openSheet = (title: string, ...body: Node[]) => {
    $('[data-omp-sheet-title]').textContent = title;
    $('[data-omp-sheet-body]').replaceChildren(...body);
    if (!sheet.open) sheet.showModal();
    sheet.scrollTop = 0;
  };
  const closeSheet = () => sheet.close();
  $('[data-omp-sheet-close]').addEventListener('click', closeSheet);
  sheet.addEventListener('click', (e) => { if (e.target === sheet) closeSheet(); });
  const doneButton = () => {
    const b = el('button', { type: 'button', class: 'omp-btn omp-btn-dark' }, 'Done');
    b.addEventListener('click', closeSheet);
    return b;
  };

  const openRhythm = () => {
    const p = plan();
    const current = p.state().trigger;
    const chips = el('div', { class: 'omp-chips', role: 'group' });
    chips.setAttribute('aria-label', 'Reset time');
    for (const choice of TRIGGER_CHOICES) {
      const chip = el('button', { type: 'button', class: 'omp-chip' }, CHOICE_LABEL[choice] ?? choice);
      chip.setAttribute('aria-pressed', String(choice === current));
      chip.addEventListener('click', () => {
        p.update((s) => setTrigger(s, choice));
        chips.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === chip)));
        window.setTimeout(closeSheet, 220);
      });
      chips.append(chip);
    }
    const custom = !(TRIGGER_CHOICES as readonly string[]).includes(current);
    const input = el('input', { type: 'text', maxLength: 85, value: custom ? current : '', placeholder: 'e.g. Sunday at 4 PM' });
    const field = el('label', { class: 'omp-field' }, 'Something else', input);
    const save = el('button', { type: 'button', class: 'omp-btn omp-btn-dark' }, 'Use this time');
    save.addEventListener('click', () => { if (input.value.trim()) p.update((s) => setTrigger(s, input.value)); closeSheet(); });
    const other = el('div', { class: 'omp-own' }, field, save);
    other.hidden = !custom;
    const reveal = el('button', { type: 'button', class: 'omp-link' }, el('span', {}, 'Something else…'));
    reveal.hidden = custom;
    reveal.addEventListener('click', () => { other.hidden = false; reveal.hidden = true; input.focus(); });
    openSheet('When does your family reset?', el('p', { class: 'omp-sheet-hint' }, 'Pick a time that already happens every Sunday.'), chips, reveal, other);
  };

  const openPerson = (id: string) => {
    const p = plan();
    const members = p.members();
    const index = members.findIndex((m) => m.id === id);
    const m = members[index];
    if (!m) return;
    const s = p.state();
    const name = p.nameOf(m);
    const options = roleSuggestions(m, index);
    const currentRole = s.assignments[m.id] ?? '';
    const own = !options.includes(currentRole);
    const group = el('fieldset', { class: 'omp-choices' });
    group.append(el('legend', { class: 'sr-only' }, `${name}’s weekly part`));
    const radio = (value: string, checked: boolean) => el('input', { type: 'radio', name: 'omp-role', value, checked });
    for (const o of options) {
      const r = radio(o, o === currentRole);
      r.addEventListener('change', () => p.update((st) => setRole(st, m.id, o)));
      group.append(el('label', { class: 'omp-choice' }, r, el('span', {}, o)));
    }
    const ownRadio = radio('own', own);
    const ownText = el('textarea', { maxLength: 105, value: own ? currentRole : '', placeholder: 'Their weekly part, in a short sentence' });
    ownText.setAttribute('aria-label', 'In your own words');
    ownRadio.addEventListener('change', () => { ownText.focus(); if (ownText.value.trim()) p.update((st) => setRole(st, m.id, ownText.value)); });
    ownText.addEventListener('focus', () => { ownRadio.checked = true; });
    ownText.addEventListener('input', () => { ownRadio.checked = true; p.update((st) => setRole(st, m.id, ownText.value)); });
    group.append(el('label', { class: 'omp-choice' }, ownRadio, el('span', { class: 'omp-own' }, 'In your own words', ownText)));
    const nameInput = el('input', { type: 'text', maxLength: 35, value: name, autocomplete: 'off' });
    nameInput.addEventListener('input', () => p.update((st) => setName(st, m.id, nameInput.value === (m.kind === 'child' ? m.firstName : '') ? '' : nameInput.value)));
    const actions = el('div', { class: 'omp-sheet-actions' }, doneButton());
    const next = members[index + 1];
    if (next) {
      const b = el('button', { type: 'button', class: 'omp-btn' }, `Next: ${p.nameOf(next)} ›`);
      b.addEventListener('click', () => openPerson(next.id));
      actions.append(b);
    }
    openSheet(`${name}’s part each Sunday`, group, el('label', { class: 'omp-field' }, 'Name on the printable', nameInput), actions);
  };

  const openJob = (jobId: string) => {
    const p = plan();
    const job = p.state().fallJobs.find((j) => j.id === jobId);
    if (!job) return;
    const people = el('div', { class: 'omp-chips omp-people-chips', role: 'group' });
    people.setAttribute('aria-label', 'Who’s doing this?');
    for (const m of p.members()) {
      const chip = el('button', { type: 'button', class: 'omp-chip' }, p.nameOf(m));
      chip.setAttribute('aria-pressed', String(m.id === job.ownerId));
      chip.addEventListener('click', () => {
        p.update((s) => setFallJob(s, jobId, { ownerId: m.id }));
        people.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === chip)));
      });
      people.append(chip);
    }
    const title = el('input', { type: 'text', maxLength: 65, value: job.title });
    title.addEventListener('input', () => p.update((s) => setFallJob(s, jobId, { title: title.value })));
    const desc = el('textarea', { maxLength: 180, value: job.description });
    desc.addEventListener('input', () => p.update((s) => setFallJob(s, jobId, { description: desc.value })));
    const remove = el('button', { type: 'button', class: 'omp-text-btn' }, 'Remove from this month');
    remove.addEventListener('click', () => {
      p.update((s) => setFallJob(s, jobId, { removed: true }));
      closeSheet();
      toast(`Removed “${job.title}”.`, () => p.update((s) => setFallJob(s, jobId, { removed: false })));
    });
    openSheet(job.title,
      el('div', { class: 'omp-field' }, el('span', {}, 'Who’s doing this?'), people),
      el('label', { class: 'omp-field' }, 'Job', title),
      el('label', { class: 'omp-field' }, 'What done looks like', desc),
      remove,
      el('div', { class: 'omp-sheet-actions' }, doneButton()));
  };
  $('[data-omp-edit="rhythm"]').addEventListener('click', openRhythm);

  // ------------------------------------------------------------ approval, printing, one-time copy
  const print = () => kit.querySelector<HTMLButtonElement>('[data-osr-print]')?.click();
  $('[data-omp-primary]').addEventListener('click', () => {
    if (copySnapshot || readOnly()) return print();
    const a = readApproval();
    const s = plan().state();
    if (a && a.print === planFingerprint(s)) return;
    writeApproval({ for: kit.dataset.planFor ?? '', print: planFingerprint(s), at: new Date().toISOString() });
    render();
    toast('Approved in this preview. Nothing is mailed yet.', () => { writeApproval(a); render(); });
  });
  $('[data-omp-copy]').addEventListener('click', () => {
    copySnapshot = structuredClone(plan().state());
    plan().setPersist(false);
    render();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  $('[data-omp-copy-done]').addEventListener('click', () => {
    const snap = copySnapshot;
    copySnapshot = null;
    if (snap) plan().replace(snap);
    plan().setPersist(true);
    render();
    toast('Back to your plan. The copy wasn’t saved.');
  });

  // Keep the action bar above the app's bottom tab bar (shown on small screens only).
  const nav = document.querySelector<HTMLElement>('nav[data-chrome]');
  const fitBar = () => {
    // offsetParent is always null for a fixed element, so ask for its display instead.
    const shown = Boolean(nav && getComputedStyle(nav).display !== 'none');
    kit.style.setProperty('--omp-nav', `${shown ? nav!.offsetHeight : 0}px`);
    kit.style.setProperty('--omp-safe', shown ? '0px' : 'env(safe-area-inset-bottom, 0px)');
  };
  fitBar();
  if (nav && typeof ResizeObserver !== 'undefined') new ResizeObserver(fitBar).observe(nav);
  window.addEventListener('resize', fitBar);

  osr.addEventListener('osr:change', render);
  render();
}
</script>

---
/**
 * October Daily Reset on phones and tablets (below 1100px): when cleanup starts, where, the jobs and who does each,
 * inside the shared ClubPlanScreen. It reads and changes the plan only through the printable's controller (`.srr`
 * root's `clubPlan`, src/lib/club/engines/daily-reset.ts).
 */
import ClubPlanScreen from './plan/ClubPlanScreen.astro';
interface Props { deadline: string }
const { deadline } = Astro.props;
---
<ClubPlanScreen deadline={deadline} kicker="October · Organized Family Club" sheets={['front', 'back']} previewNote="Front for the kids, back for you">
  <Fragment slot="title">Less asking. <em>More doing.</em></Fragment>
  <section class="cp-section" aria-labelledby="dpm-when-title">
    <h2 id="dpm-when-title">Our Daily Reset</h2>
    <p class="cp-intro">One familiar cue, a few cleanup jobs and a finish line kids can recognize.</p>
    <ul class="cp-group" data-orm-setup></ul>
  </section>
  <section class="cp-section" aria-labelledby="dpm-jobs-title">
    <h2 id="dpm-jobs-title">The cleanup jobs</h2>
    <p class="cp-intro">Prepared for your children’s ages. Choose a different job or person only if needed.</p>
    <ul class="cp-group" data-orm-jobs></ul>
    <p class="orm-restore" data-orm-restore hidden><button type="button" class="cp-link"><span>Restore prepared plan</span></button></p>
  </section>
</ClubPlanScreen>

<style is:global>
@media screen and (max-width:1099px){
.orm-restore{margin:6px 0 0}
.orm-restore[hidden]{display:none}
.orm-label{font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--cp-soft)}
.orm-icon{width:44px;height:44px;object-fit:contain}
}
</style>

<script>
import { el } from '../../lib/club/plan/dom';
import { mountPlanScreen, type PlanScreen } from '../../lib/club/plan/screen';
import {
  AREAS, EVERYONE, JOB_OPTIONS, OTHER_TRIGGERS, TRIGGERS, planChanged, restorePlan, setArea, setJob, setJobOwner, setTrigger,
  type Area, type ResetPlan, type ResetState,
} from '../../lib/club/engines/daily-reset';

const APPROVAL_KEY = 'omc:preview:october-daily-reset:approval';
const root = document.querySelector<HTMLElement>('.club-plan:has(.srr)');
const host = root?.querySelector<HTMLElement & { clubPlan?: ResetPlan }>('.srr');
if (root && host) {
  const plan = () => host.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  let ui: PlanScreen<ResetState>;

  const row = (label: string, title: string, detail: string, open: () => void, locked: boolean, lead: Node = el('span')) => {
    const b = el('button', { type: 'button', class: 'cp-row', disabled: locked }, lead,
      el('span', { class: 'cp-row-text' }, el('span', { class: 'orm-label' }, label), el('strong', {}, title), detail ? el('span', {}, detail) : ''),
      el('span', { class: 'cp-chev', 'aria-hidden': 'true' }));
    b.setAttribute('aria-label', `${label}: ${title}.${locked ? '' : ' Change'}`);
    b.addEventListener('click', open);
    return el('li', {}, b);
  };
  const render = (_ui: PlanScreen<ResetState>, s: ResetState, locked: boolean) => {
    const v = plan().view();
    q('[data-orm-setup]').replaceChildren(
      row('When do we start?', v.cue, v.duration, openWhen, locked),
      row('Where', v.summary.area, v.owner, openWhere, locked, el('img', { class: 'orm-icon', src: AREAS[v.area].icon, alt: '' })));
    q('[data-orm-jobs]').replaceChildren(...v.jobs.map((j, i) => row(`Job ${i + 1}`, j.label, `Person responsible: ${j.person}`, () => openJob(i), locked, el('img', { class: 'orm-icon', src: j.icon, alt: '' }))));
    q('[data-orm-restore]').hidden = locked || !planChanged(s, plan().members());
  };
  const chips = (label: string, items: { value: string; text: string; on: boolean }[], pick: (v: string) => void) => {
    const g = el('div', { class: 'cp-chips', role: 'group' });
    g.setAttribute('aria-label', label);
    for (const it of items) {
      const c = el('button', { type: 'button', class: 'cp-chip' }, it.text);
      c.setAttribute('aria-pressed', String(it.on));
      c.addEventListener('click', () => pick(it.value));
      g.append(c);
    }
    return el('div', { class: 'cp-field' }, el('span', {}, label), g);
  };
  const openWhen = () => {
    const p = plan();
    const v = p.view();
    ui.openSheet('When should cleanup happen?',
      chips('Cue', [...TRIGGERS, ...OTHER_TRIGGERS].map((t) => ({ value: t, text: t, on: v.trigger === t })), (t) => { p.update((s) => setTrigger(s, t)); openWhen(); }),
      el('p', { class: 'cp-sheet-hint' }, 'A familiar daily event works better than another exact time to remember.'),
      el('div', { class: 'cp-sheet-actions' }, ui.doneButton()));
  };
  const openWhere = () => {
    const p = plan();
    const v = p.view();
    ui.openSheet('Where are we cleaning up?',
      chips('Area', (Object.keys(AREAS) as Area[]).map((a) => ({ value: a, text: AREAS[a].label, on: v.area === a })), (a) => { p.update((s) => setArea(s, a as Area, p.members())); openWhere(); }),
      el('p', { class: 'cp-sheet-hint' }, 'Changing the area prepares new jobs for it.'),
      el('div', { class: 'cp-sheet-actions' }, ui.doneButton()));
  };
  const openJob = (i: number) => {
    const p = plan();
    const v = p.view();
    const job = v.jobs[i];
    if (!job) return;
    ui.openSheet(`Cleanup job ${i + 1}`,
      chips('Job', [...new Set([...JOB_OPTIONS, job.label])].map((j) => ({ value: j, text: j, on: job.label === j })), (j) => { p.update((s) => setJob(s, i, j)); openJob(i); }),
      chips('Person responsible', [{ value: EVERYONE, text: 'Everyone', on: job.ownerId === EVERYONE }, ...v.kids.map((k) => ({ value: k.id, text: k.name, on: job.ownerId === k.id }))], (id) => { p.update((s) => setJobOwner(s, i, id, p.members())); openJob(i); }),
      el('div', { class: 'cp-sheet-actions' }, ui.doneButton()));
  };
  q('[data-orm-restore] button').addEventListener('click', () => {
    const before = structuredClone(plan().state());
    plan().update((s) => restorePlan(s, plan().members()));
    ui.toast('Back to the prepared plan.', () => plan().replace(before));
  });

  const mounted = mountPlanScreen<ResetState>({ root, host, approvalKey: APPROVAL_KEY, render });
  if (mounted) ui = mounted;
}
</script>

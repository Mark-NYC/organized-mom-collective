---
/** August Club one-page school routine: "My School Day", a picture routine for before and after school.
 * Steps, choices and rules: src/lib/club/engines/august-school-routines.ts.
 * planMode: inside a Club plan page (/app/club/august) the page brings the layout, rail and mobile screen; this keeps
 * the routine editor and the sheet, marked data-plan-sheet, and publishes the plan as `clubPlan` (docs/club/PLAN_ARCHITECTURE.md). */
import { ICONS, preparedRoutine, shown, clock } from '../../lib/club/engines/august-school-routines';
interface Props {storageKey?:string; planMode?:boolean}
const {storageKey='omc:club:august-school-routines:v1',planMode=false}=Astro.props;
const prepared=preparedRoutine(8);
const panels=[
 {group:'morning' as const,num:'01',cls:'asr-panel-am',title:'Before School',line:'First things first. I can do this!',accent:'MORNING'},
 {group:'after' as const,num:'02',cls:'asr-panel-pm',title:'After School',line:'Come home. Reset. Enjoy the afternoon.',accent:'AFTERNOON'},
];
const pencil='<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 4 4M4 20l4-.8L19 8.2a2.1 2.1 0 0 0-3-3L5 16.2 4 20Z"/></svg>';
---
<div class="asr" data-asr-key={storageKey} data-asr-plan={planMode ? "" : undefined}>
 {!planMode && <header class="asr-intro">
  <a href="/club">← Organized Family Club</a>
  <h1>Fewer reminders. <em>Smoother school days.</em></h1>
  <p>A ready-made picture routine for mornings and after school. Kids can see the next step instead of asking Mom what to do.</p>
 </header>}
 <div class={planMode ? "asr-plan" : "asr-layout"}>
  {!planMode && <aside class="asr-editor"><div class="asr-editor-head"><h2>Fewer reminders. <em>Smoother school days.</em></h2><button type="button" class="asr-edit-link" data-open-vision>Why this matters</button></div><div class="asr-prepared" id="august-edit-controls"><span class="asr-eyebrow">YOUR FAMILY'S SCHOOL ROUTINES</span><strong>My School Day</strong><p>Two ready-made picture routines for before and after school.</p><button type="button" class="asr-edit-link" data-open-editor>Edit routines <Fragment set:html={pencil} /></button></div><div class="asr-actions"><div class="asr-primary-actions"><a class="asr-jump" href="#august-edit-controls">Make changes</a><button class="asr-primary" data-asr-print type="button">Print / Save PDF</button></div><button class="asr-secondary" data-asr-png type="button">Download image (PNG)</button><button class="asr-reset" data-asr-reset type="button">Restore original steps</button></div></aside>}
  {!planMode && <dialog class="asr-dialog" data-asr-vision aria-labelledby="asr-vision-title"><div class="asr-dialog-head"><h2 id="asr-vision-title">Why this matters</h2><button type="button" data-close-dialog aria-label="Close">×</button></div><p>School mornings and afternoons shouldn't depend on Mom repeating the same reminders. These prepared routines show kids their next step so they can take more responsibility for getting ready and resetting after school.</p><button type="button" class="asr-dialog-done" data-close-dialog>Back to our plan</button></dialog>}
  <dialog class="asr-dialog asr-guided-dialog" data-asr-editor aria-labelledby="asr-editor-title">
   <div class="asr-dialog-head"><div><span class="asr-guide-kicker">MAKE IT YOURS · AUGUST</span><h2 id="asr-editor-title">Our school routines</h2></div><button type="button" data-close-dialog aria-label="Close">×</button></div>
   <p class="asr-guide-intro">We've prepared a starting routine. Just change what doesn't fit your child.</p>
   <div class="asr-guide-section"><strong>Whose routine?</strong><div class="asr-child-chips" data-asr-children></div></div>
   <div class="asr-routine-tabs" role="tablist" aria-label="School routine"><button type="button" data-asr-tab="morning" role="tab" aria-selected="true">Before school</button><button type="button" data-asr-tab="after" role="tab" aria-selected="false">After school</button></div>
   <div class="asr-guide-section"><div class="asr-guide-caption"><strong data-asr-guided-title>Morning routine</strong><span>Tap any step to change it</span></div><div class="asr-guided-steps" data-asr-options></div>
    <button type="button" class="asr-guide-add" data-asr-add>＋ Add a step</button>
    <div data-asr-gallery class="asr-guide-gallery" hidden></div>
   </div>
   <details class="asr-guide-more"><summary>More options</summary><label class="asr-mode-choice"><input type="checkbox" data-asr-shorter/> Use a shorter routine</label><p>Hides two optional steps without deleting them. Removed steps can be restored in the list above.</p></details>
   <div class="asr-guide-saved">{planMode ? '✓ Each child keeps their own routine' : '✓ Changes save automatically for each child'}</div>
   <button type="button" class="asr-dialog-done" data-close-dialog>Done · See our plan</button>
  </dialog>
  <section class={planMode ? "asr-plan-view" : "asr-preview"}>{!planMode && <button type="button" class="asr-float" data-open-editor><Fragment set:html={pencil} /><span>MAKE CHANGES</span></button>}
   <div class="asr-stage" data-asr-stage>
    <article class="asr-sheet" data-asr-sheet data-plan-sheet={planMode ? "sheet" : undefined} data-plan-sheet-end={planMode ? "" : undefined}>
     <header class="asr-paper-head"><h2>My School Day</h2><span data-asr-name>Our morning & after-school routines</span></header>
     {panels.map((p)=><div class={'asr-panel '+p.cls}><header><span class="asr-circle">{p.num}</span><div><h3>{p.title}</h3><p>{p.line}</p></div><span class="asr-accent">{p.accent}</span></header><div class="asr-rows" data-asr-group={p.group}>
      {shown(prepared,p.group).map((item)=><div class="asr-row" data-asr-id={item.id} data-asr-section={p.group}>
        <time data-asr-time role="button" tabindex="0" aria-label={'Change time for '+item.label}>{clock(item.time)}</time>
        <img src={ICONS[item.icon]} alt="" width="76" height="76"/>
        <strong data-asr-text contenteditable="true" role="textbox" aria-label={'Edit '+item.label}>{item.label}</strong>
        <button type="button" data-asr-remove class="asr-remove" title="Remove step" aria-label={'Remove '+item.label}>×</button>
       </div>)}
     </div></div>)}
     <footer class="asr-paper-foot"><strong data-asr-footer contenteditable="true" role="textbox" aria-label="Edit reminder">Check my routine. Do my part. Then I'm ready!</strong><span>ORGANIZED FAMILY CLUB · AUGUST</span></footer>
    </article>
   </div>
  </section>
 </div>
</div>
<style is:global>
.asr,.asr *{box-sizing:border-box}.asr:not([data-asr-plan]){max-width:1480px;margin:auto;padding:27px clamp(18px,3.5vw,52px) 70px}.asr{color:#484941;font-family:Montserrat,Arial,sans-serif}
.asr-intro{max-width:760px;margin-bottom:34px}.asr-intro>a{font-size:12px;color:#43493f;display:inline-block;margin-bottom:25px}.asr-eyebrow{font-size:10px!important;letter-spacing:.15em;font-weight:700;color:#718569}.asr-intro h1{font:400 clamp(38px,4.4vw,60px)/1.14 Georgia,serif;margin:12px 0}.asr-intro h1 em{color:#788e72}.asr-intro>p:last-child{font-size:15px;line-height:1.75}
.asr-layout{display:grid;grid-template-columns:minmax(275px,350px) minmax(0,1fr);gap:clamp(25px,4vw,60px);align-items:start}
.asr-editor{border-top:8px solid #d8e6df;padding-top:16px}.asr-editor h2{font:italic 30px Georgia,serif;color:#668075;margin:10px 0}.asr-editor>p:nth-of-type(2){font-size:13px;line-height:1.75}.asr-editor label{display:block;font-weight:700;font-size:12px;margin:18px 0}.asr-editor select,.asr-option select{display:block;width:100%;min-height:44px;padding:9px;border:1px solid #b8c5bd;background:#fff;color:#424c43;font:12px Montserrat,Arial,sans-serif;margin-top:8px}
.asr-customize{border:1px solid #d7e1dc;border-radius:6px;margin:22px 0;padding:0 13px}.asr-customize summary{padding:15px 0;font-size:13px;font-weight:700;cursor:pointer}.asr-customize summary span{font-weight:400;font-size:11px;color:#849289}.asr-customize>p{font-size:11px;line-height:1.6}.asr-option{padding:11px 0;border-top:1px solid #e5eae6}.asr-option strong{display:block;font-size:12px}.asr-option button{font-size:11px;margin:8px 6px 0 0;background:#fff;border:1px solid #b7c8bb;color:#527253;border-radius:3px;padding:7px 10px;cursor:pointer}
.asr-parent-note{background:#f3f5ef;padding:17px;margin:20px 0}.asr-parent-note strong{font:21px Georgia,serif}.asr-parent-note p{font-size:11px;line-height:1.75;margin:7px 0 0}.asr-primary,.asr-secondary{width:100%;min-height:48px;cursor:pointer;font-size:12px;font-weight:700}.asr-primary{background:#5f7767;border:0;color:white}.asr-secondary{border:1px solid #b7c9bc;color:#5f7767;background:white;margin-top:9px}.asr-reset{border:0;text-decoration:underline;background:none;color:#607867;font-size:12px;cursor:pointer;min-height:40px;display:block;margin:8px auto}.asr-small{font-size:11px;line-height:1.65;color:#858982}
.asr-preview{min-width:0}.asr-preview-heading{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:12px;border-bottom:1px solid #e1e6e3;margin-bottom:17px}.asr-preview-heading h2{font:26px Georgia,serif}.asr-preview-heading span{font-size:11px;color:#858982}
.asr-stage{position:relative}.asr-sheet{position:absolute;left:0;top:0;width:816px;height:1056px;transform:scale(var(--asr-scale,1));transform-origin:top left;border:1px solid #e6e6e0;box-shadow:0 8px 26px #0002;background:#fff;padding:35px 45px 27px;display:flex;flex-direction:column;overflow:hidden}
.asr-paper-head{text-align:center;padding:12px 15px 15px;border-top:0}.asr-paper-head p{font-size:10px;color:#7c9085;letter-spacing:.15em;font-weight:700;margin:0}.asr-paper-head h2{font:400 49px Georgia,serif;color:#506255;margin:9px 0 7px}.asr-paper-head>span{font:italic 17px Georgia,serif;color:#849487}
.asr-panel{border-radius:10px;padding:15px 18px 17px;margin-top:17px}.asr-panel-am{background:#f7ebd0}.asr-panel-pm{background:#dfeae8}.asr-panel>header{display:flex;align-items:center;gap:12px;margin-bottom:12px}.asr-circle{font:italic 34px Georgia,serif;color:#9a8560}.asr-panel-pm .asr-circle{color:#6e958e}.asr-panel header div{flex:1}.asr-panel h3{font:400 27px Georgia,serif;color:#655a47;margin:0}.asr-panel-pm h3{color:#4c6d65}.asr-panel header p{font:italic 12px Georgia,serif;color:#807b6b;margin:4px 0 0}.asr-panel-pm header p{color:#67817b}.asr-accent{font-size:10px;letter-spacing:.1em;font-weight:700;color:#8b7b5c}
.asr-rows{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.asr-row{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-height:142px;background:white;border-radius:8px;text-align:center;padding:11px 7px}.asr-row[hidden]{display:none!important}.asr-row img{display:block;width:80px;height:80px;object-fit:contain}.asr-row strong{font:500 13px/1.3 Montserrat,Arial,sans-serif;color:#526052;overflow-wrap:anywhere}.asr-remove{position:absolute;top:3px;right:3px;width:26px;height:26px;border:1px solid #b9caba;border-radius:50%;background:white;color:#607761;font-size:19px;cursor:pointer;opacity:0}.asr-row:hover .asr-remove,.asr-row:focus-within .asr-remove{opacity:1}.asr [contenteditable]{cursor:text;outline-offset:3px}.asr [contenteditable]:hover{outline:1px dashed #98b19c}.asr [contenteditable]:focus{outline:2px solid #7da588;background:#f4fcf5}
.asr-paper-foot{margin-top:auto;text-align:center;border-top:1px solid #dee5dd;padding-top:17px}.asr-paper-foot strong{display:block;font:italic 20px Georgia,serif;color:#65806c}.asr-paper-foot span{display:block;margin-top:12px;font-size:9px;letter-spacing:.12em;font-weight:700;color:#9ca99f}
.asr.asr-export .asr-stage{width:816px!important;height:1056px!important}.asr.asr-export .asr-sheet{transform:none!important;box-shadow:none!important}.asr.asr-export .asr-remove{display:none!important}
@media(max-width:1050px){.asr-layout{display:flex;flex-direction:column}.asr-preview{order:0;width:100%}.asr-editor{order:1;max-width:720px;width:100%}.asr-remove{opacity:1}}
@page{size:letter portrait;margin:0}
/* Printing outside a Club plan page; on one, ClubPrintStyles prints the data-plan-sheet page. */
@media print{html,body{padding:0!important;margin:0!important;background:#fff!important}body:has(.asr:not([data-asr-plan])) *{visibility:hidden!important}.asr:not([data-asr-plan]) :is(.asr-stage,.asr-sheet,.asr-sheet *){visibility:visible!important}.asr:not([data-asr-plan]) .asr-stage{position:absolute!important;top:0!important;left:0!important;width:8.5in!important;height:11in!important}.asr:not([data-asr-plan]) .asr-sheet{position:absolute!important;top:0!important;left:0!important;width:8.5in!important;height:11in!important;border:0!important;box-shadow:none!important;transform:none!important;-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}.asr-remove{display:none!important}.asr [contenteditable]{outline:none!important;background:transparent!important}}

/* August is a sequential time-based routine, never a card grid. */
.asr-sheet{padding:27px 46px 22px}
.asr-paper-head{padding:0 15px 10px}
.asr-paper-head h2{font-size:44px;margin:6px 0}
.asr-panel{padding:13px 18px 14px;margin-top:14px}
.asr-panel>header{margin-bottom:9px}
.asr-panel h3{font-size:27px}
.asr-rows{display:flex;flex-direction:column;gap:clamp(3px,0.5vh,6px)}
.asr-row{display:grid;grid-template-columns:82px 62px minmax(0,1fr);grid-template-rows:minmax(48px,auto);align-items:center;text-align:left;column-gap:18px;row-gap:0;min-height:58px;padding:3px 15px;border-radius:7px}.asr-row>time{grid-column:1;grid-row:1}.asr-row>img{grid-column:2;grid-row:1}.asr-row>strong{grid-column:3;grid-row:1;min-width:0}.asr-row>.asr-remove{grid-column:3;grid-row:1}
.asr-row time{cursor:pointer;border-radius:4px;outline-offset:3px}.asr-row time:hover{outline:1px dashed #9bb4a1}.asr-row time:focus-visible{outline:2px solid #6d9980}.asr-row time{font:700 18px/1.15 Montserrat,Arial,sans-serif;color:#536558;white-space:nowrap;font-variant-numeric:tabular-nums}
.asr-row img{width:58px;height:47px;object-fit:contain}
.asr-row strong{font:600 16px/1.24 Montserrat,Arial,sans-serif;overflow-wrap:normal}
.asr-row .asr-remove{right:5px;top:50%;transform:translateY(-50%)}
.asr-row strong{padding-right:11px}.asr-option input{width:100%;min-height:38px;border:1px solid #c6d4c8;padding:8px;font:12px Montserrat,Arial,sans-serif}.asr-add-label{display:block;margin:14px 0 20px;font-size:12px;font-weight:700}.asr-add-label select{width:100%;min-height:44px;display:block;margin-top:7px;border:1px solid #b8c5bd;background:white;padding:9px}.asr-rows:has(.asr-row:nth-child(6)) .asr-row{min-height:45px;padding-top:1px;padding-bottom:1px}.asr-rows:has(.asr-row:nth-child(6)) .asr-row img{height:38px}.asr-rows:has(.asr-row:nth-child(8)) .asr-row{min-height:34px}.asr-rows:has(.asr-row:nth-child(8)) .asr-row img{height:28px}.asr-panel:has(.asr-row:nth-child(7)){padding-top:8px;padding-bottom:8px;margin-top:9px}.asr-panel:has(.asr-row:nth-child(7)) .asr-row{min-height:38px}.asr-panel:has(.asr-row:nth-child(7)) .asr-rows{gap:3px}
.asr-paper-foot{padding-top:10px}
.asr-paper-foot strong{font-size:18px}
.asr-paper-foot span{margin-top:8px}

.asr:not([data-asr-plan]){max-width:none;padding:0}.asr-intro{display:none}.asr-layout{grid-template-columns:clamp(315px,28vw,410px) minmax(0,1fr);gap:0;align-items:stretch}
.asr-editor{display:flex;flex-direction:column;min-width:0;border:0;border-right:1px solid #e5e0e1;background:#faf9f7;padding:16px 22px}

 .srr-actions{position:fixed;left:0;right:0;bottom:0;z-index:20;margin:0;padding:9px 16px calc(9px + env(safe-area-inset-bottom,0px));border-top:1px solid #dce2d7;background:rgba(250,249,247,.98);box-shadow:0 -5px 20px #0001}
 .srr-primary-actions{display:flex;gap:9px}.srr-jump-edit{display:inline-flex;align-items:center;justify-content:center;gap:7px;flex:1;min-height:45px;padding:8px;border:1px solid #5f7767;border-radius:4px;background:#fff;color:#5f7767;font:700 12px Montserrat,Arial,sans-serif;text-decoration:none}

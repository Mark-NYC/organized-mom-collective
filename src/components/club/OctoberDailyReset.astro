@media(max-width:540px){.srr-guided-dialog{padding:20px 17px}.srr-guided-fields{grid-template-columns:1fr;gap:7px}.srr-guided-job img{width:52px;height:52px}.srr-choice-grid button{font-size:11px;padding:9px;min-height:46px}}
/* Plan mode: the Club plan page places the sheets; the phone proof is a preview. */
.srr-plan-view .srr-pages{align-items:center}
.srr-plan .srr-dialog{z-index:100}
.srr-sheet[data-srr-locked] [contenteditable]{cursor:default}
</style>
<script>
import {
  EVERYONE, JOB_ICONS, JOB_OPTIONS, OTHER_TRIGGERS, TEXT_IDS, applyFamily, freshState, fromLegacy, isResetState, resetFingerprint,
  resetView, restorePlan, setArea, setJob, setJobOwner, setText, setTrigger,
  type Area, type ResetMember, type ResetPlan, type ResetState, type TextId,
} from '../../lib/club/engines/daily-reset';
import { el } from '../../lib/club/plan/dom';
import { PLAN_CHANGE } from '../../lib/club/plan/resource';
import { planKey, readScoped, tabStorage } from '../../lib/club/plan/storage';

type Detail = { household: { id: string; members?: ResetMember[] } | null; sample?: string | null };
/** The earlier (September) page's key; its tab copy is read once for the same family. */
const LEGACY_KEY = 'omc:preview:september-room-reset:v2';
for (const root of document.querySelectorAll<HTMLElement & { clubPlan?: ResetPlan }>('.srr')) {
  const key = root.dataset.srrKey || 'omc:preview:october-daily-reset:v1';
  const planMode = root.hasAttribute('data-srr-plan');
  let current = '';
  let members: ResetMember[] = [];
  let state: ResetState = freshState([]);
  let persist = true;
  let locked = false;
  const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
  const $$ = <T extends HTMLElement>(sel: string) => [...root.querySelectorAll<T>(sel)];

  const stage = $('[data-srr-stage]');
  const pages = $('[data-srr-pages]');
  const sheets = $$('.srr-sheet');
  const fit = () => {
    if (!stage || !pages) return;
    const scale = Math.min(1, Math.max(180, stage.clientWidth - 2) / 816);
    pages.style.gap = `${22 * scale}px`;
    for (const sheet of sheets) {
      sheet.style.setProperty('--srr-scale', String(scale));
      sheet.style.marginBottom = `${-(1056 * (1 - scale))}px`;
      sheet.style.marginRight = `${-(816 * (1 - scale))}px`;
    }
  };
  fit();
  if (stage && typeof ResizeObserver !== 'undefined') new ResizeObserver(fit).observe(stage);

  const visionDialog = $<HTMLDialogElement>('[data-srr-vision]');
  const editorDialog = $<HTMLDialogElement>('[data-srr-editor]');
  const openEditor = () => { if (!locked && editorDialog && !editorDialog.open) editorDialog.showModal(); };
  $('[data-open-vision]')?.addEventListener('click', () => visionDialog?.showModal());
  $$('[data-open-editor]').forEach((b) => b.addEventListener('click', openEditor));
  $$('[data-close-dialog]').forEach((b) => b.addEventListener('click', () => b.closest('dialog')?.close()));
  for (const d of [visionDialog, editorDialog]) d?.addEventListener('click', (e) => { if (e.target === d) d.close(); });

  const save = () => { if (persist && current) tabStorage.set(key, JSON.stringify({ current, state })); };
  const put = (id: string, value: string) => { const node = $(`[data-srr-${id}]`); if (node && document.activeElement !== node) node.textContent = value; };

  const render = () => {
    const v = resetView(state, members);
    put('owner', v.owner);
    put('cue', v.cue);
    put('duration', v.duration);
    put('count', v.countLine);
    put('finish', v.finish);
    put('start', v.start);
    $('[data-srr-jobs]')?.classList.toggle('srr-two', v.count === 2);
    $$('.srr-job').forEach((card, i) => {
      const job = v.jobs[i];
      card.hidden = !job;
      if (!job) return;
      const label = card.querySelector<HTMLElement>('[data-srr-job-label]');
      if (label && document.activeElement !== label) label.textContent = job.label;
      const img = card.querySelector<HTMLImageElement>('[data-srr-icon]');
      if (img) img.src = job.icon;
      let who = card.querySelector<HTMLElement>('.srr-job-owner');
      if (!who) { who = el('span', { class: 'srr-job-owner' }); card.append(who); }
      who.textContent = `Person responsible: ${job.person}`;
    });
    $('[data-srr-checks]')?.replaceChildren(...v.checks.map((c) => el('span', {}, c)));
    const coaching = $('[data-srr-coaching-cue]');
    if (coaching) coaching.textContent = v.coaching;
    for (const [k, value] of Object.entries(v.summary)) { const node = $(`[data-srr-summary-${k}]`); if (node) node.textContent = value; }
    $$<HTMLButtonElement>('[data-srr-trigger-choice]').forEach((b) => { const on = b.dataset.srrTriggerChoice === v.trigger; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', String(on)); });
    $$<HTMLButtonElement>('[data-srr-area-choice]').forEach((b) => { const on = b.dataset.srrAreaChoice === v.area; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', String(on)); });
    const other = $<HTMLSelectElement>('[data-srr-other-trigger]');
    if (other) other.value = (OTHER_TRIGGERS as readonly string[]).includes(v.trigger) ? v.trigger : '';
    $('[data-srr-guided-jobs]')?.replaceChildren(...v.jobs.map((job, i) => {
      const jobSelect = el('select');
      jobSelect.setAttribute('aria-label', `Cleanup job ${i + 1}`);
      for (const name of new Set([...JOB_OPTIONS, job.label])) jobSelect.append(el('option', { value: name }, name));
      jobSelect.value = job.label;
      jobSelect.addEventListener('change', () => update((s) => setJob(s, i, jobSelect.value)));
      const ownerSelect = el('select');
      ownerSelect.setAttribute('aria-label', `Person responsible for job ${i + 1}`);
      for (const o of [{ id: EVERYONE, name: 'Everyone' }, ...v.kids]) ownerSelect.append(el('option', { value: o.id }, o.name));
      ownerSelect.value = job.ownerId;
      ownerSelect.addEventListener('change', () => update((s) => setJobOwner(s, i, ownerSelect.value, members)));
      return el('div', { class: 'srr-guided-job' }, el('img', { src: JOB_ICONS[job.label] ?? job.icon, alt: '', width: 60, height: 60 }),
        el('div', { class: 'srr-guided-fields' }, el('label', {}, `Cleanup job ${i + 1}`, jobSelect), el('label', {}, 'Person responsible', ownerSelect)));
    }));
  };
  const changed = () => { save(); render(); if (planMode && current) root.dispatchEvent(new Event(PLAN_CHANGE, { bubbles: true })); };
  const update = (change: (s: ResetState) => void) => { if (locked) return; change(state); changed(); };

  // Typing on the sheet.
  $$('.srr-sheet [contenteditable="true"]').forEach((node) => {
    const index = node.dataset.srrJobLabel;
    const id = index !== undefined ? 'job' : TEXT_IDS.find((k) => node.hasAttribute(`data-srr-${k}`));
    if (!id) return;
    node.addEventListener('blur', () => {
      if (!locked) update((s) => (id === 'job' ? setJob(s, Number(index), node.textContent ?? '') : setText(s, id as TextId, node.textContent ?? '')));
      render();
    });
    node.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); node.blur(); } });
  });
  $$<HTMLButtonElement>('[data-srr-trigger-choice]').forEach((b) => b.addEventListener('click', () => update((s) => setTrigger(s, b.dataset.srrTriggerChoice ?? 'Before Dinner'))));
  $$<HTMLButtonElement>('[data-srr-area-choice]').forEach((b) => b.addEventListener('click', () => update((s) => setArea(s, (b.dataset.srrAreaChoice ?? 'whole') as Area, members))));
  $<HTMLSelectElement>('[data-srr-other-trigger]')?.addEventListener('change', (e) => { const v = (e.target as HTMLSelectElement).value; if (v) update((s) => setTrigger(s, v)); });

  // Standalone page controls.
  $('[data-srr-reset]')?.addEventListener('click', () => update((s) => restorePlan(s, members)));
  $('[data-srr-print]')?.addEventListener('click', () => { (document.activeElement as HTMLElement | null)?.blur(); window.print(); });
  const pngButton = $<HTMLButtonElement>('[data-srr-png]');
  pngButton?.addEventListener('click', async () => {
    const front = $('[data-srr-front]');
    if (!front || !pngButton) return;
    pngButton.disabled = true; root.classList.add('srr-export'); const prev = pngButton.textContent; pngButton.textContent = 'Preparing image…';
    try {
      await Promise.all([...front.querySelectorAll('img')].map((img) => (img.complete ? null : img.decode().catch(() => null))));
      const { toPng } = await import('html-to-image');
      const url = await toPng(front, { pixelRatio: 2, width: 816, height: 1056, backgroundColor: '#fff', style: { transform: 'none', marginBottom: '0px', marginRight: '0px' } });
      const link = document.createElement('a'); link.href = url; link.download = 'october-daily-reset.png'; link.click();
    } catch (err) { console.error(err); alert('Image export failed. Use Print / Save PDF instead.'); }
    finally { root.classList.remove('srr-export'); pngButton.textContent = prev; pngButton.disabled = false; }
  });

  const setLocked = (on: boolean) => {
    locked = on;
    $$('.srr-sheet [contenteditable]').forEach((node) => node.setAttribute('contenteditable', on ? 'false' : 'true'));
    sheets.forEach((sheet) => sheet.toggleAttribute('data-srr-locked', on));
    if (on) editorDialog?.close();
  };

  const applyHousehold = (detail: Detail) => {
    if (!detail?.household) return;
    const next = planKey(detail.sample ?? null, detail.household.id);
    members = detail.household.members ?? [];
    if (next !== current) {
      current = next;
      const old = fromLegacy(tabStorage.get(LEGACY_KEY), `${detail.sample}:${detail.household.id}`, members);
      if (old) tabStorage.remove(LEGACY_KEY);
      state = readScoped(tabStorage.get(key), current, isResetState) ?? old ?? freshState(members);
    }
    applyFamily(state, members);
    changed();
  };

  root.clubPlan = {
    ready: () => Boolean(current),
    state: () => state,
    update,
    replace: (s) => { state = structuredClone(s); applyFamily(state, members); changed(); },
    setPersist: (on) => { persist = on; if (on) save(); },
    fingerprint: () => resetFingerprint(state, members),
    members: () => members,
    view: () => resetView(state, members),
    setLocked,
    openEditor,
  };
  window.addEventListener('omc:club-preview-household', (e) => applyHousehold((e as CustomEvent<Detail>).detail));
  const cached = (window as Window & { __ofcPreviewHousehold?: Detail }).__ofcPreviewHousehold;
  if (cached) applyHousehold(cached);
  render();
}
</script>

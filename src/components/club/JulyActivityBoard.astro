---
/** July Club printed prototype: child-led activity decision board, one letter-size page. */
import book from '../../../assets/icons/ofc/updated/supporting/book.png';
import blocks from '../../../assets/icons/ofc/updated/supporting/blocks.png';
import puzzle from '../../../assets/icons/ofc/updated/supporting/puzzle-piece.png';
import tree from '../../../assets/icons/ofc/updated/supporting/tree.png';
import scissors from '../../../assets/icons/ofc/updated/supporting/scissors.png';
import bike from '../../../assets/icons/ofc/updated/supporting/bike.png';
import rope from '../../../assets/icons/ofc/updated/supporting/jump-rope.png';
import friends from '../../../assets/icons/ofc/updated/supporting/friend-pair.png';
import lightbulb from '../../../assets/icons/ofc/updated/utility/lightbulb.png';
interface Props {storageKey?:string}
const {storageKey='omc:club:july-activities:v1'}=Astro.props;
const icons={book:book.src,blocks:blocks.src,puzzle:puzzle.src,tree:tree.src,scissors:scissors.src,bike:bike.src,rope:rope.src,friends:friends.src,lightbulb:lightbulb.src};
const tiers=[
 {id:'quick',num:'01',title:'5-Minute Ideas',subtitle:'I can start right now.',hint:'NO SETUP · BY MYSELF',color:'#E3EEDC',
  items:[{id:'read',label:'Read a book',icon:'book'},{id:'draw',label:'Draw something new',icon:'scissors'},{id:'build',label:'Build with blocks',icon:'blocks'}]},
 {id:'busy',num:'02',title:'Keep Me Busy',subtitle:'I want to get into something.',hint:'A LITTLE SETUP · KEEP GOING',color:'#F6E8BE',
  items:[{id:'puzzle',label:'Finish a puzzle',icon:'puzzle'},{id:'outdoor',label:'Explore outside',icon:'tree'},{id:'craft',label:'Make a paper craft',icon:'scissors'}]},
 {id:'project',num:'03',title:'My Own Project',subtitle:'I can work on this again tomorrow.',hint:'BUILD IT OVER TIME · MY IDEA',color:'#DFE7F1',
  items:[{id:'city',label:'Build a mini city',icon:'blocks'},{id:'story',label:'Write & draw a story',icon:'book'},{id:'course',label:'Design an obstacle course',icon:'rope'}]}
];
---
<div class="jab" data-jab-key={storageKey} data-jab-icons={JSON.stringify(icons)}>
 <header class="jab-intro"><a href="/club">← Organized Family Club</a><p class="jab-eyebrow">ORGANIZED FAMILY CLUB · JULY 2027</p><h1>Less “I'm bored.” <em>More “I've got this.”</em></h1><p>A picture-led board that gives kids real options they can start themselves. Choose, try, and keep going—without Mom having to plan every moment.</p></header>
 <div class="jab-layout">
  <aside class="jab-editor">
   <p class="jab-eyebrow">PREPARED FOR YOUR FAMILY</p><h2>Ready to use.</h2>
   <p>The activities are selected for the child you choose below. Review them once, then print. You can edit or remove an idea right on the board; advanced choices are optional.</p>
   <label>Who is this for?<select data-jab-child><option value="family">The whole family</option></select></label>
   <label>Activity style<select data-jab-focus>
     <option value="mixed">A little of everything</option><option value="inside">Mostly indoors</option><option value="outside">Mostly outdoors</option>
   </select></label>
   <details class="jab-customize"><summary>Change activity choices <span>Optional</span></summary><p>Only if you want: swap or restore an idea here. On the board itself, click the text to edit or × to remove.</p><div data-jab-options></div></details>
   <div class="jab-guidance"><strong>Make this work at home</strong><p>Only keep activities your child can safely start with supplies already available. Supervise activities when needed. For little ones, adult help and shorter attention spans are normal.</p></div>
   <button class="jab-primary" type="button" data-jab-print>Print Board / Save PDF</button>
   <button class="jab-secondary" type="button" data-jab-download>Download image (PNG)</button>
   <button class="jab-clear" type="button" data-jab-reset>Restore starter board</button>
   <p class="jab-note">US Letter · One reusable printed sheet · Preview edits stay in this browser tab.</p>
  </aside>
  <section class="jab-preview" aria-label="July illustrated activity board">
   <div class="jab-preview-bar"><h2>July's printed tool</h2><span>One page · Kid-led</span></div>
   <div class="jab-stage" data-jab-stage>
    <article class="jab-sheet" data-jab-sheet>
     <header class="jab-sheet-header"><p>ORGANIZED FAMILY CLUB · JULY 2027</p><h2>What Can I Do <em>Right Now?</em></h2><div class="jab-for" data-jab-for>My own ideas for summer</div></header>
     <p class="jab-sub" data-jab-edit="intro" contenteditable="true" role="textbox" aria-label="Edit board introduction">Pick something that sounds good. Start small or make something big.</p>
     <div class="jab-tiers">
      {tiers.map(t=><section class={'jab-tier jab-tier-'+t.id} data-jab-tier={t.id} style={'--jab-tint:'+t.color}>
        <header class="jab-tier-head"><div class="jab-step">{t.num}</div><div class="jab-tier-heading"><h3>{t.title}</h3><p>{t.subtitle}</p></div><span>{t.id==="quick"?"START NOW":t.id==="busy"?"STAY WITH IT":"COME BACK TOMORROW"}</span></header>
        <div class="jab-items">
         {t.items.map((a,i)=><div class="jab-item" data-jab-item={t.id} data-jab-slot={i}>
          <div class="jab-icon"><img src={icons[a.icon as keyof typeof icons]} width="76" height="76" alt=""/></div>
          <strong data-jab-label contenteditable="true" role="textbox" aria-label={'Edit '+a.label}>{a.label}</strong>
          <button type="button" data-jab-remove class="jab-remove" aria-label={'Remove '+a.label} title="Remove activity">×</button>
         </div>)}
        </div>
       </section>)}
     </div>
     <footer class="jab-footer"><strong data-jab-edit="rule" contenteditable="true" role="textbox" aria-label="Edit finishing rule">Pick one. Give it a try. Put things away when you're done.</strong><span>ORGANIZED FAMILY CLUB</span></footer>
    </article>
   </div>
   <p class="jab-note">Unlike May's daily rhythm, July gives kids specific choices they can initiate during their free time. These are starter ideas, not a requirement to buy materials or plan projects.</p>
  </section>
 </div>
</div>
<style is:global>
.jab,.jab *{box-sizing:border-box}.jab{max-width:1480px;margin:0 auto;padding:26px clamp(18px,3.5vw,52px) 70px;font-family:Montserrat,Arial,sans-serif;color:#484941}
.jab-intro{max-width:790px;margin-bottom:35px}.jab-intro>a{display:inline-block;font-size:12px;color:#47483e;margin-bottom:24px}.jab-eyebrow{font-size:10px!important;letter-spacing:.16em;color:#738569;font-weight:700}.jab-intro h1{font:400 clamp(37px,4.5vw,60px)/1.12 Georgia,serif;margin:13px 0}.jab-intro h1 em{color:#7C946E}.jab-intro>p:last-child{font-size:15px;line-height:1.75}
.jab-layout{display:grid;grid-template-columns:minmax(285px,350px) minmax(0,1fr);gap:clamp(28px,4vw,60px);align-items:start}.jab-editor{border-top:8px solid #E1EBCF;padding-top:16px}.jab-editor h2{font:italic 30px Georgia,serif;color:#728364;margin:12px 0}.jab-editor>p:nth-of-type(2){font-size:13px;line-height:1.7}
.jab-editor>label{display:block;font-size:12px;font-weight:700;margin:16px 0}.jab-editor select,.jab-option select{display:block;width:100%;min-height:44px;background:#fff;border:1px solid #b9c5b5;color:#414d3d;font:12px Montserrat,Arial,sans-serif;padding:8px;margin-top:7px}.jab-customize{border:1px solid #d4decf;padding:0 13px;border-radius:6px;margin:16px 0}.jab-customize summary{padding:15px 0;cursor:pointer;font-size:13px;font-weight:700}.jab-customize summary span{font-size:11px;font-weight:400;color:#7e8d74}.jab-customize>p,.jab-guidance p{font-size:11px;line-height:1.7}.jab-option{border-top:1px solid #e5e8df;padding:10px 0}.jab-option label{font-size:11px;font-weight:700}.jab-option button{border:1px solid #b9c7b4;background:#fff;border-radius:4px;padding:7px 11px;margin-top:7px;font-size:11px;color:#53724d;cursor:pointer}.jab-guidance{padding:17px;background:#f5f2e9;margin:19px 0}.jab-guidance strong{font:20px Georgia,serif}.jab-guidance p{margin:7px 0 0}.jab-primary,.jab-secondary{width:100%;min-height:49px;cursor:pointer;font-size:12px;font-weight:700}.jab-primary{background:#607755;color:#fff;border:0}.jab-secondary{background:#fff;border:1px solid #afc0aa;color:#607755;margin-top:9px}.jab-clear{display:block;border:0;background:none;margin:11px auto;min-height:35px;text-decoration:underline;color:#536d4b;font-size:12px;cursor:pointer}.jab-note{font-size:11px;line-height:1.65;color:#81877d}
.jab-preview{min-width:0}.jab-preview-bar{display:flex;align-items:baseline;justify-content:space-between;gap:12px;border-bottom:1px solid #e5e8df;margin-bottom:18px}.jab-preview-bar h2{font:26px Georgia,serif}.jab-preview-bar span{font-size:11px;color:#81877d}
.jab-stage{position:relative}.jab-sheet{position:absolute;top:0;left:0;width:816px;height:1056px;padding:29px 42px 24px;transform:scale(var(--jab-scale,1));transform-origin:top left;display:flex;flex-direction:column;background:#fff;border:1px solid #e4e4dd;box-shadow:0 8px 26px #0002;overflow:hidden}
.jab-sheet-header{text-align:center;background:#f7f5ec;padding:14px 15px 12px;border-top:7px solid #DCE8D7}.jab-sheet-header>p{font-size:10px;font-weight:700;color:#728267;letter-spacing:.14em;margin:0}.jab-sheet-header h2{font:400 44px/1.12 Georgia,serif;color:#525d4b;margin:12px 0 8px}.jab-sheet-header h2 em{color:#849773}.jab-for{font-size:12px;color:#65755c;letter-spacing:.07em}.jab-sub{text-align:center;font:italic 17px/1.4 Georgia,serif;margin:13px 0 14px;color:#6e7768}
.jab-tiers{display:flex;flex-direction:column;gap:12px;flex:1;justify-content:space-between}.jab-tier{background:var(--jab-tint);border-radius:12px;padding:13px 14px 14px;min-height:238px}.jab-tier-head{display:flex;align-items:center;gap:13px;margin-bottom:12px;min-height:54px}.jab-step{font:italic 42px Georgia,serif;color:#7f8c71;min-width:46px}.jab-tier-heading{flex:1}.jab-tier-heading h3{font:400 28px Georgia,serif;margin:0;color:#455747}.jab-tier-heading p{font:italic 13px Georgia,serif;color:#61715c;margin:3px 0 0}.jab-tier-head>span{font-size:10px;line-height:1.35;font-weight:700;letter-spacing:.09em;color:#63775b;max-width:145px;text-align:right}.jab-tier-quick .jab-tier-head>span{color:#456849}.jab-tier-busy .jab-tier-head>span{color:#92733e}.jab-tier-project .jab-tier-head>span{color:#5d7192}
.jab-items{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.jab-item{position:relative;border-radius:9px;background:#fff;min-height:149px;padding:12px 8px 10px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;text-align:center}.jab-item[hidden]{display:none!important}.jab-icon{position:relative;width:112px;height:78px;overflow:hidden;flex:none}.jab-icon img{position:absolute;left:50%;top:-32px;transform:translateX(-50%);width:152px;height:152px;max-width:none;object-fit:contain;clip-path:inset(0 0 31% 0)}.jab-item strong{font:500 15px/1.25 Montserrat,Arial,sans-serif;color:#4e5a4b;overflow-wrap:anywhere}.jab-remove{position:absolute;right:3px;top:3px;border:1px solid #cad6c3;border-radius:50%;height:27px;width:27px;font-size:19px;background:#fff;color:#62775d;cursor:pointer;opacity:0}.jab-item:hover .jab-remove,.jab-item:focus-within .jab-remove{opacity:1}.jab [contenteditable]{cursor:text;outline-offset:3px}.jab [contenteditable]:hover{outline:1px dashed #a2b39e}.jab [contenteditable]:focus{outline:2px solid #86a481;background:#f6fcf3}.jab-footer{margin-top:12px;text-align:center;border-top:1px solid #dee6db;padding-top:11px}.jab-footer strong{display:block;font:italic 19px Georgia,serif;color:#536e4f}.jab-footer span{display:block;margin-top:10px;color:#9ca69a;font-size:9px;letter-spacing:.13em;font-weight:700}
.jab.jab-export .jab-stage{width:816px!important;height:1056px!important}.jab.jab-export .jab-sheet{transform:none!important;box-shadow:none!important}.jab.jab-export .jab-remove{display:none!important}
@media(max-width:1050px){.jab-layout{display:flex;flex-direction:column}.jab-preview{order:0;width:100%}.jab-editor{order:1;max-width:730px;width:100%}.jab-remove{opacity:1}.jab [contenteditable]{pointer-events:auto}}
@page{size:letter portrait;margin:0}
@media print{html,body{margin:0!important;padding:0!important;background:#fff!important}body *{visibility:hidden!important}.jab-stage,.jab-sheet,.jab-sheet *{visibility:visible!important}.jab-stage{position:absolute!important;left:0!important;top:0!important;width:8.5in!important;height:11in!important}.jab-sheet{position:absolute!important;left:0!important;top:0!important;width:8.5in!important;height:11in!important;transform:none!important;box-shadow:none!important;border:0!important;-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}.jab-remove{display:none!important}.jab [contenteditable]{outline:none!important;background:transparent!important}}
</style>
<script>
type Tier='quick'|'busy'|'project';
type Idea={id:string;label:string;icon:string;removed?:boolean;minAge?:number;maxAge?:number};
type State={quick:Idea[];busy:Idea[];project:Idea[];focus:'mixed'|'inside'|'outside';child:string;intro:string;rule:string};
const library:Record<Tier,Idea[]>={
 quick:[
  {id:'picture',label:'Look at a picture book',icon:'book',maxAge:5},
  {id:'sort',label:'Sort blocks by color',icon:'blocks',maxAge:5},
  {id:'doodle',label:'Draw a funny animal',icon:'scissors',maxAge:8},
  {id:'read',label:'Read a book',icon:'book',minAge:6},
  {id:'draw',label:'Draw something new',icon:'scissors',minAge:6},
  {id:'build',label:'Build with blocks',icon:'blocks'},
  {id:'stretch',label:'Try ten stretches',icon:'rope',minAge:6},
  {id:'look',label:'Find five things in nature',icon:'tree',minAge:6}
 ],
 busy:[
  {id:'pretend',label:'Set up pretend play',icon:'blocks',maxAge:5},
  {id:'easy-puzzle',label:'Work on a picture puzzle',icon:'puzzle',maxAge:5},
  {id:'picture-art',label:'Make a big picture',icon:'scissors',maxAge:5},
  {id:'puzzle',label:'Finish a puzzle',icon:'puzzle',minAge:6},
  {id:'outdoor',label:'Explore outside (ask first)',icon:'tree',minAge:6},
  {id:'craft',label:'Make a paper craft',icon:'scissors',minAge:6},
  {id:'bike',label:'Ride my bike (ask first)',icon:'bike',minAge:6},
  {id:'tower',label:'Build a giant tower',icon:'blocks'},
  {id:'reading',label:'Read a whole chapter',icon:'book',minAge:9}
 ],
 project:[
  {id:'small-town',label:'Build a pretend town',icon:'blocks',maxAge:5},
  {id:'picture-story',label:'Make a picture story',icon:'book',maxAge:5},
  {id:'big-art',label:'Add to a big drawing',icon:'scissors',maxAge:5},
  {id:'city',label:'Build a mini city',icon:'blocks',minAge:6},
  {id:'story',label:'Write & draw a story',icon:'book',minAge:9},
  {id:'course',label:'Design a safe obstacle course',icon:'rope',minAge:6},
  {id:'comic',label:'Make my own comic book',icon:'scissors',minAge:6},
  {id:'garden',label:'Observe a plant growing',icon:'tree',minAge:6},
  {id:'mural',label:'Make a big art project',icon:'scissors',minAge:6}
 ]
};
const ageGroups={
 little:{quick:['picture','sort','build'],busy:['pretend','easy-puzzle','picture-art'],project:['small-town','picture-story','big-art']},
 middle:{quick:['read','draw','build'],busy:['puzzle','outdoor','craft'],project:['city','comic','course']},
 older:{quick:['read','draw','stretch'],busy:['puzzle','reading','craft'],project:['city','story','garden']}
} satisfies Record<string,Record<Tier,string[]>>;
const eligible=(idea:Idea,age:number)=> (idea.minAge??0)<=age&&(idea.maxAge??99)>=age;
const defaultsFor=(age:number,child='family'):State=>{
 const preset=age<=5?ageGroups.little:age>=10?ageGroups.older:ageGroups.middle;
 const select=(tier:Tier)=>preset[tier].map(id=>({...library[tier].find(x=>x.id===id)!}));
 return {quick:select('quick'),busy:select('busy'),project:select('project'),focus:'mixed',child,
  intro:'Pick something that sounds good. Start small or make something big.',
  rule:"Pick one. Give it a try. Put things away when you're done."};
};
const fresh=():State=>defaultsFor(8);
for(const root of document.querySelectorAll<HTMLElement>('.jab')){
 const key=root.dataset.jabKey??'omc:club:july-activities:v1';
 const icons=JSON.parse(root.dataset.jabIcons??'{}') as Record<string,string>;
 let state=fresh();let profile='';let family='My own ideas for summer';let kids:{id:string;firstName:string;birthYear?:number;birthMonth?:number}[]=[];
 let boards:Record<string,State>={};
 const selectedAge=(child=state.child)=>{const kid=kids.find(k=>k.id===child);if(!kid?.birthYear)return 8;
  return Math.max(2,Math.min(18,2027-kid.birthYear-(kid.birthMonth&&kid.birthMonth>7?1:0)))};
 const validIdeas=(tier:Tier)=>library[tier].filter(idea=>eligible(idea,selectedAge()));
 const stage=root.querySelector<HTMLElement>('[data-jab-stage]');const sheet=root.querySelector<HTMLElement>('[data-jab-sheet]');
 const fit=()=>{if(!stage||!sheet)return;const width=Math.max(180,(stage.parentElement?.clientWidth??816)-4);const scale=Math.min(1,width/816);stage.style.width=816*scale+'px';stage.style.height=1056*scale+'px';sheet.style.setProperty('--jab-scale',String(scale))};
 fit();if(stage?.parentElement&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(stage.parentElement);window.addEventListener('resize',fit);
 const save=()=>{boards[state.child]=structuredClone(state);try{sessionStorage.setItem(key,JSON.stringify({profile,state,boards}))}catch{}};
 const draw=()=>{
  for(const tier of ['quick','busy','project'] as Tier[])for(const row of root.querySelectorAll<HTMLElement>('[data-jab-item="'+tier+'"]')){
   const item=state[tier][Number(row.dataset.jabSlot)];if(!item)continue;row.hidden=!!item.removed;
   const img=row.querySelector<HTMLImageElement>('img');if(img)img.src=icons[item.icon]??icons.book;
   const txt=row.querySelector<HTMLElement>('[data-jab-label]');if(txt&&document.activeElement!==txt)txt.textContent=item.label;
  }
  const title=root.querySelector<HTMLElement>('[data-jab-for]');if(title)title.textContent=family;
  for(const name of ['intro','rule'] as const){const el=root.querySelector<HTMLElement>('[data-jab-edit="'+name+'"]');if(el&&document.activeElement!==el)el.textContent=state[name]}
  const child=root.querySelector<HTMLSelectElement>('[data-jab-child]');if(child)child.value=state.child;
  const focus=root.querySelector<HTMLSelectElement>('[data-jab-focus]');if(focus)focus.value=state.focus;
 };
 const options=()=>{
  const parent=root.querySelector<HTMLElement>('[data-jab-options]');if(!parent)return;parent.replaceChildren();
  for(const tier of ['quick','busy','project'] as Tier[]){
   for(let i=0;i<3;i++){
    const item=state[tier][i];const wrap=document.createElement('div');wrap.className='jab-option';const label=document.createElement('label');
    label.textContent=({quick:'5-Minute',busy:'Keep Me Busy',project:'My Project'} as Record<Tier,string>)[tier]+' · '+(i+1);
    const select=document.createElement('select');select.setAttribute('aria-label',label.textContent);
    for(const suggestion of validIdeas(tier)){const opt=document.createElement('option');opt.value=suggestion.id;opt.textContent=suggestion.label;select.append(opt)}
    if(!validIdeas(tier).some(x=>x.id===item.id)){const opt=document.createElement('option');opt.value=item.id;opt.textContent=item.label+' (custom)';select.append(opt)}
    select.value=item.id;select.addEventListener('change',()=>{
     const replacement=library[tier].find(x=>x.id===select.value);if(!replacement)return;
     state[tier][i]={...replacement,removed:item.removed};save();draw();
    });
    const toggle=document.createElement('button');toggle.type='button';toggle.textContent=item.removed?'＋ Restore idea':'× Remove idea';
    toggle.addEventListener('click',()=>{state[tier][i].removed=!state[tier][i].removed;save();draw();options()});
    label.append(select);wrap.append(label,toggle);parent.append(wrap);
   }
  }
 };
 const updateFamily=()=>{const kid=kids.find(k=>k.id===state.child);family=kid?kid.firstName+"'s ideas for summer":'Our ideas for summer'};
 const childSelect=root.querySelector<HTMLSelectElement>('[data-jab-child]');
 childSelect?.addEventListener('change',()=>{
  save();
  const id=childSelect.value;
  state=boards[id]?structuredClone(boards[id]):defaultsFor(selectedAge(id),id);
  updateFamily();save();draw();options();
 });
 root.querySelector<HTMLSelectElement>('[data-jab-focus]')?.addEventListener('change',event=>{
  const focus=(event.target as HTMLSelectElement).value as State['focus'];state.focus=focus;
  // Only suggest activities appropriate to the selected child's age.
  const age=selectedAge();
  const choose=(tier:Tier,slot:number,ids:string[])=>{
   const candidate=ids.map(id=>library[tier].find(x=>x.id===id)).find((x):x is Idea=>!!x&&eligible(x,age));
   if(candidate)state[tier][slot]={...candidate};
  };
  if(focus==='inside'){choose('busy',1,['tower','easy-puzzle']);choose('project',2,['comic','big-art'])}
  else if(focus==='outside'){choose('quick',1,['look','sort']);choose('busy',1,['bike','pretend']);choose('project',2,['garden','big-art'])}
  else{choose('quick',1,['draw','sort']);choose('busy',1,['outdoor','easy-puzzle']);choose('project',2,['course','big-art'])}
  save();draw();options();
 });
 root.querySelectorAll<HTMLElement>('[data-jab-item]').forEach(row=>{
  const tier=row.dataset.jabItem as Tier,index=Number(row.dataset.jabSlot);const txt=row.querySelector<HTMLElement>('[data-jab-label]');
  txt?.addEventListener('input',()=>{state[tier][index].label=(txt.textContent??'').replace(/\s+/g,' ').slice(0,55);save()});
  txt?.addEventListener('blur',()=>{const s=state[tier][index];s.label=(txt.textContent??'').replace(/\s+/g,' ').trim().slice(0,55)||library[tier].find(x=>x.id===s.id)!.label;save();draw()});
  txt?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();txt.blur()}});
  row.querySelector('[data-jab-remove]')?.addEventListener('click',()=>{state[tier][index].removed=true;save();draw();options()});
 });
 for(const name of ['intro','rule'] as const){const el=root.querySelector<HTMLElement>('[data-jab-edit="'+name+'"]');el?.addEventListener('input',()=>{state[name]=(el.textContent??'').replace(/\s+/g,' ').slice(0,130);save()});el?.addEventListener('blur',()=>{state[name]=(el.textContent??'').trim().slice(0,130);save();draw()});el?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();el.blur()}})}
 root.querySelector('[data-jab-reset]')?.addEventListener('click',()=>{const child=state.child;state=defaultsFor(selectedAge(child),child);updateFamily();save();draw();options()});
 root.querySelector('[data-jab-print]')?.addEventListener('click',()=>window.print());
 const dl=root.querySelector<HTMLButtonElement>('[data-jab-download]');
 dl?.addEventListener('click',async()=>{
  if(!dl||!sheet)return;dl.disabled=true;const label=dl.textContent;dl.textContent='Preparing image…';root.classList.add('jab-export');
  try{await Promise.all(Array.from(sheet.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));
   const {toPng}=await import('html-to-image');const image=await toPng(sheet,{pixelRatio:2,width:816,height:1056,backgroundColor:'#fff'});
   const link=document.createElement('a');link.href=image;link.download='july-what-can-i-do.png';link.click();
  }catch(err){console.error('July image export failed',err);alert('Image download failed; please use Print / Save PDF.')}
  finally{root.classList.remove('jab-export');dl.disabled=false;dl.textContent=label}
 });
 window.addEventListener('omc:club-preview-household',(event:Event)=>{
  const detail=(event as CustomEvent<{household:{id:string;members?:{id:string;firstName:string;kind:string;birthYear?:number;birthMonth?:number}[]};sample?:string}>).detail;
  if(!detail?.household)return;const next=(detail.sample??'account')+':'+detail.household.id;
  kids=(detail.household.members??[]).filter(x=>x.kind==='child');
  const select=root.querySelector<HTMLSelectElement>('[data-jab-child]');
  if(select){select.replaceChildren();const familyOption=document.createElement('option');familyOption.value='family';familyOption.textContent='The whole family';select.append(familyOption);
   for(const kid of kids){const option=document.createElement('option');option.value=kid.id;option.textContent=kid.firstName;select.append(option)}}
  if(profile!==next){profile=next;state=fresh();boards={};
   try{const record=JSON.parse(sessionStorage.getItem(key)??'null');if(record?.profile===profile&&record.state){
    const s=record.state;
    if(record.boards&&typeof record.boards==='object')boards=record.boards;
    state=defaultsFor(selectedAge(typeof s.child==='string'?s.child:'family'),typeof s.child==='string'?s.child:'family');
    state.focus=['mixed','inside','outside'].includes(s.focus)?s.focus:'mixed';
    for(const name of ['intro','rule'] as const)if(typeof s[name]==='string')state[name]=s[name].slice(0,130);
    for(const tier of ['quick','busy','project'] as Tier[])if(Array.isArray(s[tier])&&s[tier].length===3){
     state[tier]=s[tier].map((a:Idea,i:number)=>{const found=library[tier].find(x=>x.id===a?.id);return found?{...found,label:typeof a.label==='string'?a.label.slice(0,55):found.label,removed:a.removed===true}:state[tier][i]});
    }
   }}catch{}
  }
  if(state.child!=='family'&&!kids.some(x=>x.id===state.child))state.child='family';
  if(state.child==='family'&&profile===next&&!boards.family&&kids.length){state=defaultsFor(selectedAge(kids[0].id),kids[0].id)}
  updateFamily();save();draw();options();
 });
 updateFamily();draw();options();
}
</script>
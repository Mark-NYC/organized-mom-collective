---
/** Digital companion. Reuses the public calendar's month/week/member-row format, not November's separate weekly grid. */
---
<div class="ofc-calendar" data-ofc-calendar>
 <div class="ofc-calendar-intro"><h3>Our Family Activity Calendar</h3><p>Everyone is already here. Add recurring activities so each person can see what's coming.</p></div>
 <div class="ofc-calendar-controls">
  <div><strong>Our family</strong><div data-ofc-people class="ofc-people">Loading family…</div></div>
  <form data-ofc-add class="ofc-calendar-form">
   <label class="ofc-activity-name">Activity <input required maxlength="60" name="activity" placeholder="Soccer practice, preschool, piano…" autocomplete="off" /></label>
   <label>For <select required name="member" data-ofc-member aria-label="Family member"></select></label>
   <fieldset class="ofc-days"><legend>Repeats every</legend>
     <div class="ofc-days-options">
       <label><input type="checkbox" value="1" name="weekday"/>Mon</label>
       <label><input type="checkbox" value="2" name="weekday"/>Tue</label>
       <label><input type="checkbox" value="3" name="weekday"/>Wed</label>
       <label><input type="checkbox" value="4" name="weekday"/>Thu</label>
       <label><input type="checkbox" value="5" name="weekday"/>Fri</label>
       <label><input type="checkbox" value="6" name="weekday"/>Sat</label>
       <label><input type="checkbox" value="0" name="weekday"/>Sun</label>
     </div>
   </fieldset>
   <div class="ofc-form-actions"><button type="submit" data-ofc-submit>Add activity</button><button type="button" data-ofc-cancel hidden>Cancel editing</button></div>
  </form>
  <div data-ofc-list class="ofc-activity-list" aria-label="Saved activities"></div>
  <p role="status" aria-live="polite" data-ofc-status class="ofc-calendar-status"></p>
 </div>
 <div class="ofc-calendar-sheet-wrap"><div class="ofc-export"><span>Monthly view · scroll sideways on smaller screens</span><button type="button" data-ofc-print>Print calendar</button></div>
  <div class="ofc-calendar-nav"><button type="button" data-ofc-prev aria-label="Previous month">←</button><strong data-ofc-month>September 2027</strong><button type="button" data-ofc-next aria-label="Next month">→</button></div>
  <div class="ofc-calendar-sheet" role="region" tabindex="0" aria-label="Scrollable monthly family calendar"><div class="ofc-sheet-header"><span>Big Things / Deadlines</span><h3 data-ofc-heading>September</h3><span>Our Family Calendar</span></div><div data-ofc-weeks></div></div>
  <p class="ofc-calendar-note">The calendar is a digital companion. September's mailed resource is your Sunday Reset guide.</p>
 </div>
</div>
<style is:global>
.ofc-calendar{--ofc-mint:#59c2a5;max-width:1260px;margin:auto;color:#4b5563;font-family:Montserrat,Arial,sans-serif}
.ofc-calendar-intro h3{font:400 29px Georgia,serif;color:#526e59;margin:0 0 7px}.ofc-calendar-intro p{font-size:14px;margin:0 0 22px}
.ofc-calendar-controls{background:#faf9f6;border:1px solid #e1e5dc;border-radius:9px;padding:20px;margin-bottom:24px}
.ofc-people{display:flex;flex-wrap:wrap;gap:7px;margin:10px 0 20px}.ofc-people span{padding:8px 12px;border-radius:4px;font-size:13px}
.ofc-calendar-form{display:grid;grid-template-columns:2fr 1fr 1fr auto;align-items:end;gap:10px}
.ofc-calendar-form label{font-size:12px;font-weight:700}.ofc-calendar-form input,.ofc-calendar-form select{display:block;width:100%;margin-top:6px;padding:12px;border:1px solid #bbcdbd;border-radius:5px;background:white;min-height:44px}
.ofc-calendar-form button{background:#53745d;color:#fff;border:0;border-radius:5px;padding:12px 16px;min-height:44px;font-weight:700;cursor:pointer}
.ofc-activity-list{margin-top:14px;display:grid;gap:7px}.ofc-activity-item{display:flex;align-items:center;justify-content:space-between;gap:9px;border-bottom:1px solid #e1e5dc;padding:7px 0;font-size:12px}.ofc-activity-item button{border:1px solid #ced9cd;background:white;border-radius:4px;padding:7px 9px;cursor:pointer}
.ofc-calendar-status{font-size:12px;color:#496b54;min-height:18px}
.ofc-calendar-sheet-wrap{max-width:900px;margin:auto}.ofc-calendar-nav{display:flex;justify-content:center;gap:22px;align-items:center;margin-bottom:14px}.ofc-calendar-nav button{padding:7px 14px;background:white;border:1px solid #c4d5cb;border-radius:4px;cursor:pointer}
.ofc-calendar-sheet{background:white;border:1px solid #ddd;box-shadow:0 6px 23px #0001;padding:20px;overflow-x:auto}.ofc-sheet-header{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #b7e2d0;margin-bottom:10px;padding-bottom:15px;gap:8px}.ofc-sheet-header span{font-size:10px;max-width:25%}.ofc-sheet-header h3{font:400 27px Georgia,serif;color:#506b5b}
.ofc-week{width:100%;min-width:620px;border-collapse:collapse;table-layout:fixed;margin-bottom:12px}.ofc-week th,.ofc-week td{border:1px solid #ddd;padding:5px 4px;font-size:10px;text-align:center}.ofc-week th{font-weight:600;background:#f6f9f7}.ofc-week .ofc-side{width:15%;text-align:left}.ofc-week .ofc-dayname{display:block;font-size:9px}.ofc-week .ofc-outside{color:#aaa}.ofc-week td{height:29px;overflow-wrap:anywhere}.ofc-week .ofc-person{text-align:left;font-weight:700;font-size:11px}.ofc-week .ofc-item{display:block;line-height:1.2;margin:2px 0}.ofc-calendar-note{text-align:center;font-size:12px;margin:14px;color:#69756b}
@media(max-width:760px){.ofc-calendar-form{grid-template-columns:1fr 1fr}.ofc-calendar-form label:first-child{grid-column:1/-1}.ofc-calendar-form button{grid-column:1/-1}.ofc-calendar-controls{padding:15px}.ofc-calendar-sheet{padding:10px}.ofc-sheet-header h3{font-size:23px}.ofc-calendar-sheet-wrap{min-width:0}}
@media(max-width:390px){.ofc-calendar-form{grid-template-columns:1fr}.ofc-calendar-form label,.ofc-calendar-form button{grid-column:1/-1}}
@media print{.ofc-calendar{display:none!important}}

.ofc-calendar-form{grid-template-columns:minmax(220px,1.3fr) minmax(135px,.7fr);align-items:start}
.ofc-calendar-form .ofc-days{grid-column:1/-1;border:0;padding:0;margin:0;min-width:0}
.ofc-days legend{font-size:12px;font-weight:700;margin-bottom:8px}
.ofc-days-options{display:flex;flex-wrap:wrap;gap:6px}
.ofc-days-options label{display:flex;align-items:center;justify-content:center;gap:6px;min-width:66px;padding:9px 11px;border:1px solid #c4d4c7;border-radius:5px;background:#fff;cursor:pointer}
.ofc-days-options label:has(input:checked){background:#dbebdf;border-color:#698c70;color:#35583d}
.ofc-days-options input{width:16px;height:16px;min-height:auto;margin:0;accent-color:#53745d}
.ofc-form-actions{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:10px}
.ofc-form-actions button{min-width:145px}
.ofc-form-actions [data-ofc-cancel]{background:white;color:#53745d;border:1px solid #b9ccbd}
.ofc-calendar-form button:disabled,.ofc-activity-item button:disabled{opacity:.55;cursor:not-allowed}
.ofc-activity-item>div{display:flex;gap:6px;flex-shrink:0}
.ofc-activity-item{line-height:1.5}
.ofc-calendar-sheet{scrollbar-color:#a8b8ac #f3f5f3;scrollbar-width:auto}
.ofc-week{min-width:680px}
.ofc-week .ofc-person{min-width:110px;word-break:break-word;overflow-wrap:anywhere}
.ofc-week td{height:34px;font-size:11px}
.ofc-week .ofc-item{font-size:10px;line-height:1.3}
.ofc-export{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:9px;font-size:11px;color:#67776a}
.ofc-export button{min-height:40px;background:#fff;border:1px solid #b9ccbd;border-radius:5px;color:#4c6b54;padding:8px 13px;font-weight:700;cursor:pointer}
.ofc-calendar :focus-visible{outline:3px solid #53745d;outline-offset:2px}
@media(max-width:760px){.ofc-calendar-form{grid-template-columns:1fr}.ofc-calendar-form .ofc-activity-name,.ofc-calendar-form .ofc-days,.ofc-form-actions{grid-column:1}.ofc-calendar-intro h3{font-size:24px}.ofc-calendar-sheet{max-width:100%;overflow-x:auto}.ofc-export{flex-wrap:wrap}.ofc-week th,.ofc-week td{font-size:11px;padding:7px 5px}}
@media print{body:has(.ofc-calendar-print) *{visibility:hidden!important}body:has(.ofc-calendar-print) .ofc-calendar-sheet,body:has(.ofc-calendar-print) .ofc-calendar-sheet *{visibility:visible!important}body:has(.ofc-calendar-print) #ofc-calendar-panel{display:block!important;visibility:visible!important}body:has(.ofc-calendar-print) .ofc-calendar-sheet{position:absolute;top:0;left:0;width:10in;max-width:10in;padding:.2in;border:0;box-shadow:none;overflow:visible!important}body:has(.ofc-calendar-print) .ofc-week{min-width:0;width:100%}body:has(.ofc-calendar-print) .ofc-week td{font-size:9px}body:has(.ofc-calendar-print) .ofc-calendar{display:block!important}}
</style>
<script>
import {weeksOf,occursOn,calendarMembers,validateActivity,DAY_NAMES,type CalendarActivity,type CalendarMember} from '../../lib/family-calendar/core';
import {accountStore,sampleStore,type ClubStore} from '../../lib/club/store';
import {defaultToolPalette} from '../../data/tool-palettes';
type Profile={household:{id:string;displayName?:string;profileVersion?:number;members:{id:string;firstName:string;archived?:boolean}[]}|null;sample:string|null};
const root=document.querySelector<HTMLElement>('[data-ofc-calendar]');
if(root){
 const $=<T extends Element=HTMLElement>(selector:string)=>root.querySelector<T>(selector)!;
 const slug='2027-09-a-week-everyone-can-see';
 const documentId='family-activity-calendar';
 const form=$<HTMLFormElement>('[data-ofc-add]');
 const input=form.elements.namedItem('activity') as HTMLInputElement;
 const person=$<HTMLSelectElement>('[data-ofc-member]');
 const submit=$<HTMLButtonElement>('[data-ofc-submit]');
 const cancel=$<HTMLButtonElement>('[data-ofc-cancel]');
 const checks=Array.from(form.querySelectorAll<HTMLInputElement>('input[name="weekday"]'));
 const selections=()=>checks.filter(c=>c.checked).map(c=>Number(c.value));
 const personName=(id:string)=>members.find(m=>m.id===id)?.name??'Former family member';
 let members:CalendarMember[]=[];
 let activities:CalendarActivity[]=[];
 let month=new Date(2027,8,1);
 let store:ClubStore|null=null;
 let identity='',revision=0,profileVersion=1,loadSequence=0;
 let ready=false,canEdit=false,editingId:string|null=null,queue:Promise<void>=Promise.resolve();let storeKind:'sample'|'account'='sample';
 const status=(message:string)=>{$('[data-ofc-status]').textContent=message};
 const resetEditor=()=>{editingId=null;input.value='';checks.forEach(c=>c.checked=false);submit.textContent='Add activity';cancel.hidden=true};
 const controls=()=>{submit.disabled=!ready||!canEdit;input.disabled=!ready||!canEdit;person.disabled=!ready||!canEdit;checks.forEach(c=>c.disabled=!ready||!canEdit)};
 const render=()=>{
  const previous=person.value;person.replaceChildren();
  for(const m of members){const option=document.createElement('option');option.value=m.id;option.textContent=m.name;person.append(option)}
  if(members.some(m=>m.id===previous))person.value=previous;
  const chips=$('[data-ofc-people]');chips.replaceChildren();
  for(const m of members){const badge=document.createElement('span');badge.style.backgroundColor=m.color;badge.textContent=m.name;chips.append(badge)}
  const label=month.toLocaleDateString('en-US',{month:'long',year:'numeric'});
  $('[data-ofc-month]').textContent=label;
  $('[data-ofc-heading]').textContent=month.toLocaleDateString('en-US',{month:'long'});
  const host=$('[data-ofc-weeks]');host.replaceChildren();
  weeksOf(month).forEach((week,w)=>{
   const table=document.createElement('table');table.className='ofc-week';
   const caption=document.createElement('caption');caption.className='sr-only';caption.textContent=label+' week '+(w+1);table.append(caption);
   const thead=document.createElement('thead'),tr=document.createElement('tr');
   const side=document.createElement('th');side.className='ofc-side';side.scope='col';side.textContent='Person';tr.append(side);
   week.forEach((d,i)=>{const th=document.createElement('th');th.scope='col';if(w===0){const weekday=document.createElement('span');weekday.className='ofc-dayname';weekday.textContent=DAY_NAMES[i];th.append(weekday)}const day=document.createElement('span');day.textContent=String(d.getDate());if(d.getMonth()!==month.getMonth())day.className='ofc-outside';th.append(day);tr.append(th)});
   const end=document.createElement('th');end.scope='col';end.className='ofc-side';end.textContent='✓';tr.append(end);thead.append(tr);table.append(thead);
   const body=document.createElement('tbody');
   for(const m of members){
    const row=document.createElement('tr');const name=document.createElement('th');name.scope='row';name.className='ofc-person ofc-side';name.style.backgroundColor=m.color;name.textContent=m.name;row.append(name);
    for(const d of week){const td=document.createElement('td');td.style.backgroundColor=m.color;for(const activity of activities.filter(a=>a.memberId===m.id&&occursOn(a,d))){const text=document.createElement('span');text.className='ofc-item';text.textContent=activity.name;td.append(text)}row.append(td)}
    const last=document.createElement('td');last.className='ofc-side';last.style.backgroundColor=m.color;row.append(last);body.append(row)
   }
   table.append(body);host.append(table)
  });
  const list=$('[data-ofc-list]');list.replaceChildren();
  if(!activities.length){const empty=document.createElement('p');empty.textContent='No activities yet. Add your first one above.';list.append(empty)}
  for(const a of activities){
   const entry=document.createElement('div');entry.className='ofc-activity-item';
   const label=document.createElement('span');
   label.textContent=personName(a.memberId)+' · '+a.name+' · '+(a.kind==='weekly'?(a.days??[]).map(d=>['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d]).join(', '):a.date??'');
   const actions=document.createElement('div');
   const edit=document.createElement('button');edit.type='button';edit.textContent='Edit';edit.disabled=!ready||!canEdit||!members.some(m=>m.id===a.memberId);
   edit.setAttribute('aria-label','Edit '+a.name+' for '+personName(a.memberId));
   edit.addEventListener('click',()=>{editingId=a.id;input.value=a.name;person.value=a.memberId;checks.forEach(c=>c.checked=(a.days??[]).includes(Number(c.value)));submit.textContent='Save changes';cancel.hidden=false;input.focus()});
   const remove=document.createElement('button');remove.type='button';remove.textContent='Remove';remove.disabled=!ready||!canEdit;
   remove.setAttribute('aria-label','Remove '+a.name+' for '+personName(a.memberId));
   remove.addEventListener('click',()=>{activities=activities.filter(item=>item.id!==a.id);if(editingId===a.id)resetEditor();render();enqueueSave()});
   actions.append(edit,remove);entry.append(label,actions);list.append(entry)
  }
  controls()
 };
 const enqueueSave=()=>{
  if(!store||!canEdit)return;
  const snapshot=activities.map(a=>({...a,days:a.days?[...a.days]:undefined}));
  const target=store;
  const targetIdentity=identity;
  const targetVersion=profileVersion;
  status('Saving calendar…');
  queue=queue.then(async()=>{
   if(identity!==targetIdentity)return;
   const next=await target.saveDocument(slug,documentId,{edits:{activities:snapshot},palette:defaultToolPalette,engineVersion:1,profileVersion:targetVersion},revision);
   revision=next;
  }).then(()=>{if(identity===targetIdentity)status(storeKind==='sample'?'Saved in this browser tab only. No mailing is initiated.':'Saved to your Club account across signed-in devices. No mailing is initiated.')}).catch((e:unknown)=>{
   if(identity!==targetIdentity)return;
   canEdit=false;render();status(e instanceof Error&&e.message==='conflict'?'Another device changed this calendar. Reload before editing.':'Save failed. Your changes are visible here but not safely stored. Reload to try again.')
  })
 };
 const hydrate=async(detail:Profile)=>{
  const h=detail?.household;if(!h)return;
  const next=h.id+'::'+(detail.sample??'account');
  if(identity===next){members=calendarMembers(h);profileVersion=h.profileVersion??1;render();return}
  identity=next;const token=++loadSequence;
  ready=false;canEdit=false;resetEditor();members=calendarMembers(h);activities=[];profileVersion=h.profileVersion??1;revision=0;
  store=detail.sample?sampleStore(detail.sample):accountStore;storeKind=detail.sample?'sample':'account';
  render();status('Loading saved family activities…');
  try{
   const activeStore=store;if(!activeStore)throw new Error('No Club store');const docs=await activeStore.documents(slug);if(loadSequence!==token)return;
   const doc=docs.documents[documentId];revision=doc?.revision??0;
   const value=(doc?.edits as {activities?:unknown}|undefined)?.activities;
   activities=Array.isArray(value)?value.filter(validateActivity):[];
   canEdit=docs.can==='edit';ready=true;render();status(canEdit?(storeKind==='sample'?'Preview data stays in this browser tab. No mailing is initiated.':'Saved to your Club account, available on signed-in devices. No mailing is initiated.'):'Read-only calendar.');
  }catch{
   if(loadSequence!==token)return;
   ready=false;canEdit=false;render();status('Could not load saved activities. Please reload the page to retry.')
  }
 };
 window.addEventListener('omc:club-preview-household',(e:Event)=>void hydrate((e as CustomEvent<Profile>).detail));
 const cached=(window as Window&{__ofcPreviewHousehold?:Profile}).__ofcPreviewHousehold;if(cached)void hydrate(cached);
 form.addEventListener('submit',e=>{
  e.preventDefault();if(!ready||!canEdit)return;
  const name=input.value.trim(),days=selections();if(!name||name.length>60){status('Enter an activity name.');input.focus();return}
  if(!days.length){status('Choose at least one weekday.');checks[0].focus();return}
  if(!members.some(m=>m.id===person.value)){status('Choose a family member.');return}
  if(editingId){const existing=activities.find(a=>a.id===editingId);if(existing){existing.memberId=person.value;existing.name=name;existing.days=days;existing.kind='weekly'}}
  else activities.push({id:crypto.randomUUID(),memberId:person.value,name,kind:'weekly',days});
  resetEditor();render();enqueueSave()
 });
 cancel.addEventListener('click',()=>resetEditor());
 $('[data-ofc-prev]').addEventListener('click',()=>{month=new Date(month.getFullYear(),month.getMonth()-1,1);render()});
 $('[data-ofc-next]').addEventListener('click',()=>{month=new Date(month.getFullYear(),month.getMonth()+1,1);render()});
 $('[data-ofc-print]').addEventListener('click',()=>{root.classList.add('ofc-calendar-print');window.addEventListener('afterprint',()=>root.classList.remove('ofc-calendar-print'),{once:true});window.print()});
 controls();
}
</script>
@media screen and (max-width:700px){
 #club-month-content .fbc{padding-bottom:calc(145px + env(safe-area-inset-bottom,0px))}
 #club-month-content .fbc-editor-pane{padding:17px 18px}
 #club-month-content .fbc-prepared{scroll-margin-top:12px}
 #club-month-content .fbc-actions{position:fixed;left:0;right:0;bottom:0;z-index:20;margin:0;padding:9px 16px calc(9px + env(safe-area-inset-bottom,0px));border-top:1px solid #e3d4d9;background:#faf9f7;box-shadow:0 -5px 20px #0001;display:grid;grid-template-columns:1fr 1.3fr;gap:7px}
 #club-month-content .fbc-jump-edit{display:flex;align-items:center;justify-content:center;min-height:45px;border:1px solid #9b6477;background:#fff;color:#9b6477;text-decoration:none;font:700 12px Montserrat,Arial,sans-serif}
 #club-month-content .fbc-actions .fbc-download{min-width:0;font-size:12px;text-transform:none;letter-spacing:0}
 #club-month-content .fbc-actions .fbc-png,#club-month-content .fbc-actions .fbc-reset{grid-column:1/-1}
 #club-month-content .fbc-dialog{width:calc(100vw - 32px);max-height:calc(100dvh - 48px);padding:19px}
}
@media print{#club-month-content .fbc-dialog,#club-month-content .fbc-floating-edit,#club-month-content .fbc-actions{display:none!important}}
</style>
<script>
type Card={owner:string;recipient:string;headline:string;invite:string;idea:string};
const defaults:Card[]=[
 {owner:"Sofia",recipient:"Dad",headline:"Game night?",invite:"Dad, will you play a game with me tonight?",idea:"I'll get the game ready!"},
 {owner:"Mateo",recipient:"Mom",headline:"Just us two",invite:"Mom, will you read a book with me after dinner?",idea:"I'll pick the book!"},
 {owner:"Luis",recipient:"Sofia",headline:"I picked you!",invite:"Sofia, want to build something with me this weekend?",idea:"You choose what we build."},
 {owner:"Ana",recipient:"Mateo",headline:"Let's have fun!",invite:"Mateo, will you make a blanket fort with me?",idea:"I'll bring the blankets!"}
];
for(const root of document.querySelectorAll<HTMLElement>('.fbc')){
 const editDialog=root.querySelector<HTMLDialogElement>('[data-fbc-dialog]');
 root.querySelectorAll('[data-fbc-open]').forEach(button=>button.addEventListener('click',()=>editDialog?.showModal()));
 root.querySelectorAll('[data-fbc-close]').forEach(button=>button.addEventListener('click',()=>editDialog?.close()));
 editDialog?.addEventListener('click',event=>{if(event.target===editDialog)editDialog.close()});
 const stage=root.querySelector<HTMLElement>('[data-fbc-stage]');
 const fit=()=>{if(!stage)return;const width=Math.max(180,(stage.parentElement?.clientWidth??816)-4);const scale=Math.min(1,width/816);stage.style.width=816*scale+'px';stage.style.height=1056*scale+'px';stage.style.setProperty('--fbc-scale',String(scale))};
 fit();if(stage?.parentElement&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(stage.parentElement);window.addEventListener('resize',fit);
 const key=root.dataset.fbcKey??'omc:preview:february:v1';
 const storage=key.startsWith('omc:club:')?sessionStorage:localStorage;
 const editors=Array.from(root.querySelectorAll<HTMLElement>('[data-editor]'));
 const cards=Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));

 let values=defaults.map(x=>({...x}));

 let automatic=defaults.map(x=>({owner:x.owner,recipient:x.recipient}));
 try{const saved=JSON.parse(storage.getItem(key)??'null');if(saved?.cards?.length===4){values=defaults.map((d,i)=>Object.fromEntries(Object.entries(d).map(([field,v])=>[field,typeof saved.cards[i]?.[field]==='string'?saved.cards[i][field].slice(0,180):v])) as Card);}}
 catch{}
 try{const saved=JSON.parse(storage.getItem(key+':automatic')??'null');if(Array.isArray(saved)&&saved.length===4&&saved.every(x=>x&&typeof x.owner==="string"&&typeof x.recipient==="string"))automatic=saved;}catch{}
 const save=()=>{try{storage.setItem(key,JSON.stringify({cards:values}));storage.setItem(key+':automatic',JSON.stringify(automatic));}catch{}};
 const draw=()=>{
  editors.forEach((editor,i)=>editor.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('[data-field]').forEach(input=>{const field=input.dataset.field as keyof Card;if(document.activeElement!==input)input.value=values[i][field]}));
  cards.forEach((card,i)=>card.querySelectorAll<HTMLElement>('[data-out]').forEach(out=>{const field=out.dataset.out as keyof Card;out.textContent=values[i][field]||' ';}));

 };
 editors.forEach((editor,i)=>editor.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('[data-field]').forEach(input=>input.addEventListener('input',()=>{const field=input.dataset.field as keyof Card;const previous=values[i].recipient;const oldInvite=values[i].invite;values[i][field]=input.value.slice(0,180);if(field==='recipient'&&previous&&oldInvite.startsWith(previous+','))values[i].invite=values[i].recipient+oldInvite.slice(previous.length);save();draw()})));

 root.querySelector('[data-reset]')?.addEventListener('click',()=>{values=defaults.map(x=>({...x}));automatic=defaults.map(x=>({owner:x.owner,recipient:x.recipient}));try{storage.removeItem(key);storage.removeItem(key+':automatic')}catch{}draw()});
 root.querySelector('[data-print]')?.addEventListener('click',()=>window.print());
 root.querySelector<HTMLButtonElement>('[data-single-page-png]')?.addEventListener('click',async()=>{
  const button=root.querySelector<HTMLButtonElement>('[data-single-page-png]');
  const sheet=root.querySelector<HTMLElement>(".fbc-paper");
  if(!button||!sheet)return;
  button.disabled=true;const old=button.textContent;button.textContent='Preparing image…';
  root.classList.add('fbc-image-export');
  try{
   await Promise.all(Array.from(sheet.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));
   const {toPng}=await import('html-to-image');
   const png=await toPng(sheet,{pixelRatio:2,width:816,height:1056,backgroundColor:'#fff',style:{transform:'none',margin:'0',boxShadow:'none'}});
   const link=document.createElement('a');link.href=png;link.download="february-family-invitations.png";link.click();
  }catch(error){console.error('Single-page image export failed',error);alert('Image download failed. Please use Print / Save PDF instead.')}
  finally{root.classList.remove('fbc-image-export');button.disabled=false;button.textContent=old}
 });
 
 window.addEventListener('omc:club-preview-household',(event:Event)=>{
  const h=(event as CustomEvent<{household:{members:{firstName:string;kind:string;archived?:boolean;isAccountHolder?:boolean;role?:string}[]} | null}>).detail?.household;
  if(!h)return;
  const members=h.members.filter(m=>!m.archived);
  const kids=members.filter(m=>m.kind==='child');
  const adults=members.filter(m=>m.kind==='adult');
  const all=[...kids,...adults];
  // These cards are from a child's point of view. Profile roles identify adults, but do not
  // identify what the children call them; use editable Mom/Dad suggestions, never assert gender.
  const parentAdults=adults.filter(m=>m.role==='parent'||m.role==='partner');
  const address=(person:typeof members[number]|undefined,fromChild:boolean)=>{
   if(!person)return '';
   if(!fromChild||person.kind==='child')return person.firstName;
   const index=parentAdults.indexOf(person);
   if(index===0)return 'Mom';
   if(index===1)return 'Dad';
   return person.firstName;
  };
  const next=defaults.map((fallback,i)=>{
   const sender=(i<2?kids[i%Math.max(1,kids.length)]??adults[0]:adults[(i-2)%Math.max(1,adults.length)]??kids[0]);
   const preferred=i<2 ? (parentAdults[(i===0&&parentAdults.length>1)?1:0]??adults[0]) : kids[(i-2)%Math.max(kids.length,1)];
   const recipient=(preferred!==sender?preferred:undefined)??all.find(m=>m!==sender && (i<2?m.kind==='adult':m.kind==='child'))??all.find(m=>m!==sender);
   return {owner:address(sender,false)||fallback.owner,recipient:address(recipient,sender?.kind==='child')||fallback.recipient};
  });
  values.forEach((v,i)=>{
   if(v.owner===automatic[i]?.owner||v.owner===defaults[i].owner)v.owner=next[i].owner;
   if(v.recipient===automatic[i]?.recipient||v.recipient===defaults[i].recipient)v.recipient=next[i].recipient;
   const initial=defaults[i];
   if(v.invite===initial.invite || v.invite.startsWith((automatic[i]?.recipient??initial.recipient)+','))v.invite=next[i].recipient+initial.invite.slice(initial.recipient.length);
  });
  automatic=next;save();draw();
 });
 draw();
}
</script>

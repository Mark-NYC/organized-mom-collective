/* Plan mode: the Club plan page places the sheet. */
.jss-plan-view .jss-stage{margin:0 auto}
</style>
<script>
import {
  FOODS, LEVEL_TEXT, PEANUT, SNACK_ICONS, SLOTS, ZONES, addCustom, applyFamily, children, freshState,
  fromLegacy, isJuneState, juneFingerprint, juneView, relabel, setFoods, setLevel, setPeanuts, setReset, setRule, setText,
  type JuneMember, type JunePlan, type JuneState, type Level, type Rule, type TextKey, type Zone,
} from '../../lib/club/engines/june-snack-station';
import { PLAN_CHANGE } from '../../lib/club/plan/resource';
import { planKey, readScoped, tabStorage } from '../../lib/club/plan/storage';

type Detail = { household: { id: string; displayName?: string; members?: JuneMember[] } | null; sample?: string | null };
const FALLBACK = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 75 75"><rect x="13" y="15" width="49" height="45" rx="8" fill="#f2f1e9" stroke="#748569" stroke-width="2"/><path d="M24 38h27M37 25v26" stroke="#748569" stroke-width="2" stroke-linecap="round"/></svg>');
const iconFor = (id: string) => (id === 'custom' ? FALLBACK : SNACK_ICONS[id] ?? `/images/tools/lunch/${id}.png`);
const LEVEL_SVG: Record<Level, string> = {
  help: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 13V8a2 2 0 0 1 4 0v4-7a2 2 0 0 1 4 0v6-3a2 2 0 0 1 4 0v8c0 4-3 6-7 6h-1c-2 0-4-1-5-3l-3-5a2 2 0 0 1 3-2l2 2"/></svg>',
  independent: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>',
};

for (const root of document.querySelectorAll<HTMLElement & { clubPlan?: JunePlan }>('.jss')) {
  const key = root.dataset.jssKey ?? 'omc:preview:june-snack-station:v1';
  const planMode = root.hasAttribute('data-jss-plan');
  let current = '';
  let members: JuneMember[] = [];
  let displayName: string | undefined;
  let state: JuneState = freshState();
  let persist = true;
  let locked = false;
  const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
  const $$ = <T extends HTMLElement>(sel: string) => [...root.querySelectorAll<T>(sel)];

  const stage = $('[data-jss-stage]');
  const sheet = $('[data-jss-sheet]');
  const fit = () => {
    if (!stage || !sheet) return;
    const width = Math.max(200, (stage.parentElement?.clientWidth ?? 816) - 4);
    const scale = Math.min(1, width / 816);
    stage.style.width = `${scale * 816}px`;
    stage.style.height = `${scale * 1056}px`;
    sheet.style.setProperty('--jss-scale', String(scale));
  };
  fit();
  if (stage?.parentElement && typeof ResizeObserver !== 'undefined') new ResizeObserver(fit).observe(stage.parentElement);
  window.addEventListener('resize', fit);

  const visionDialog = $<HTMLDialogElement>('[data-vision-dialog]');
  const editDialog = $<HTMLDialogElement>('[data-editor-dialog]');
  const snackDialog = $<HTMLDialogElement>('[data-snack-dialog]');
  $('[data-open-vision]')?.addEventListener('click', () => visionDialog?.showModal());
  $$('[data-close-dialog]').forEach((b) => b.addEventListener('click', () => b.closest('dialog')?.close()));
  for (const d of [visionDialog, editDialog, snackDialog]) d?.addEventListener('click', (e) => { if (e.target === d) d.close(); });

  const save = () => { if (persist && current) tabStorage.set(key, JSON.stringify({ current, state })); };
  const text = (el: HTMLElement | null, value: string) => { if (el && document.activeElement !== el) el.textContent = value; };

  const draw = () => {
    const v = juneView(state, members, displayName);
    for (const zone of ZONES) {
      const items = v[zone];
      $$(`.jss-food[data-zone="${zone}"]`).forEach((el, i) => {
        const item = items[i];
        el.hidden = !item;
        if (!item) return;
        const img = el.querySelector<HTMLImageElement>('img');
        if (img && img.dataset.food !== item.id) { img.dataset.food = item.id; img.src = iconFor(item.id); img.onerror = () => { img.onerror = null; img.src = FALLBACK; }; }
        text(el.querySelector<HTMLElement>('[data-food-text]'), item.label);
        el.querySelector('[data-jss-remove]')?.setAttribute('aria-label', `Remove ${item.label}`);
      });
    }
    $('.jss-fridge')?.toggleAttribute('hidden', !v.showFridge);
    $('.jss-pantry')?.toggleAttribute('hidden', !v.showPantry);
    $$('.jss-zone-title p').forEach((el, i) => { el.textContent = i === 0 ? v.fridgeChoose : 'Choose one'; });
    text($('[data-jss-rule-text]'), v.rule);
    text($('[data-jss-reset-text]'), v.cleanup);
    for (const k of ['headline', 'subtitle', 'fridgeTitle', 'pantryTitle'] as const) text($(`[data-jss-edit="${k}"]`), v[k]);
    const fam = $('[data-jss-family]'); if (fam) fam.textContent = v.family;
    const lines = $('[data-jss-level-lines]');
    lines?.replaceChildren(...v.levels.map((g) => {
      const line = document.createElement('div');
      line.className = 'jss-level-line';
      line.innerHTML = LEVEL_SVG[g.level];
      if (g.names.length) line.append(Object.assign(document.createElement('span'), { className: 'jss-level-names', textContent: `${g.names.join(', ')} ·` }));
      line.append(document.createTextNode(LEVEL_TEXT[g.level]));
      return line;
    }));
    // The station editor (dialog): rule, reminder, who needs help.
    const ruleSelect = $<HTMLSelectElement>('[data-rule]'); if (ruleSelect) ruleSelect.value = state.rule;
    const resetSelect = $<HTMLSelectElement>('[data-reset]'); if (resetSelect) resetSelect.value = state.reset;
    const controls = $('[data-jss-level-controls]');
    if (controls && !controls.contains(document.activeElement)) {
      controls.replaceChildren(...v.kids.map((k) => {
        const select = document.createElement('select');
        select.setAttribute('aria-label', `Snack responsibility for ${k.name}`);
        for (const [value, label] of [['help', 'Ask for help'], ['independent', 'Choose. Prepare. Clean up.']]) select.append(Object.assign(document.createElement('option'), { value, textContent: label }));
        select.value = k.level ?? 'help';
        select.disabled = locked;
        select.addEventListener('change', () => update((s) => setLevel(s, k.id, select.value as Level)));
        const row = document.createElement('label');
        row.className = 'jss-level-control';
        row.append(Object.assign(document.createElement('span'), { textContent: k.name }), select);
        return row;
      }));
      if (!v.kids.length) controls.append(Object.assign(document.createElement('small'), { textContent: 'Add children to your family profile to get individual suggestions.' }));
    }
    const count = $('[data-jss-summary-count]'); if (count) count.textContent = `${v.fridge.length + v.pantry.length} foods`;
    const sr = $('[data-jss-summary-rule]'); if (sr) sr.textContent = ({ standard: '1 fridge + 1 pantry', big: '2 fridge + 1 pantry', fridge: 'Fridge only', pantry: 'Pantry only' } as Record<Rule, string>)[state.rule];
    const sreset = $('[data-jss-summary-reset]'); if (sreset) sreset.textContent = v.cleanup;
  };
  const changed = () => { save(); draw(); if (planMode && current) root.dispatchEvent(new Event(PLAN_CHANGE, { bubbles: true })); };
  const update = (change: (s: JuneState) => void) => { change(state); changed(); };

  // Typing on the sheet.
  $$('.jss-food').forEach((el) => {
    const zone = el.dataset.zone as Zone;
    const slot = Number(el.dataset.slot);
    el.querySelector('[data-jss-remove]')?.addEventListener('click', () => { if (!locked) update((s) => setFoods(s, zone, juneView(s, members)[zone].filter((_, i) => i !== slot))); });
    const title = el.querySelector<HTMLElement>('[data-food-text]');
    title?.addEventListener('blur', () => { if (!locked) update((s) => relabel(s, zone, s[zone].indexOf(juneView(s, members)[zone][slot]), title.textContent ?? '')); draw(); });
    title?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); title.blur(); } });
  });
  $$('[data-jss-edit]').forEach((el) => {
    const field = el.dataset.jssEdit as TextKey;
    el.addEventListener('blur', () => { if (!locked) update((s) => setText(s, field, el.textContent ?? '')); draw(); });
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); el.blur(); } });
  });
  $<HTMLSelectElement>('[data-rule]')?.addEventListener('change', (e) => update((s) => setRule(s, (e.target as HTMLSelectElement).value as Rule)));
  $<HTMLSelectElement>('[data-reset]')?.addEventListener('change', (e) => update((s) => setReset(s, (e.target as HTMLSelectElement).value)));

  // The snack picker (dialog): a draft, saved on "Save Snack Options".
  let zone: Zone = 'fridge';
  let draft: JuneState = structuredClone(state);
  const message = (m: string) => { const el = $('[data-snack-message]'); if (el) el.textContent = m; };
  const renderSnacks = () => {
    const grid = $('[data-snack-grid]');
    if (!grid) return;
    const selected = draft[zone];
    const counter = $('[data-snack-count]'); if (counter) counter.textContent = `${selected.length} of ${SLOTS} selected`;
    $$<HTMLButtonElement>('[data-snack-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.snackTab === zone)));
    const tile = (label: string, icon: string, on: boolean, disabled: boolean, click: () => void) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'jss-snack-tile'; b.setAttribute('aria-pressed', String(on)); b.disabled = disabled;
      const img = Object.assign(document.createElement('img'), { src: icon, alt: '' });
      img.onerror = () => { img.onerror = null; img.src = FALLBACK; };
      b.append(img, Object.assign(document.createElement('span'), { textContent: label }));
      b.addEventListener('click', click);
      return b;
    };
    grid.replaceChildren(
      ...FOODS.filter((f) => f.zone === zone && !(draft.excludePeanuts && PEANUT.has(f.id))).map((f) => {
        const on = selected.some((i) => i.id === f.id);
        return tile(f.name, iconFor(f.id), on, !on && selected.length >= SLOTS, () => { setFoods(draft, zone, on ? selected.filter((i) => i.id !== f.id) : [...selected, { id: f.id, label: f.name }]); message(''); renderSnacks(); });
      }),
      ...selected.filter((i) => i.id === 'custom').map((i) => tile(i.label, FALLBACK, true, false, () => { setFoods(draft, zone, selected.filter((x) => x !== i)); renderSnacks(); })),
    );
  };
  const openSnacks = () => {
    if (locked) return;
    draft = structuredClone(state);
    zone = 'fridge';
    const box = $<HTMLInputElement>('[data-snack-peanuts]'); if (box) box.checked = draft.excludePeanuts;
    const input = $<HTMLInputElement>('[data-snack-custom]'); if (input) input.value = '';
    message('');
    renderSnacks();
    snackDialog?.showModal();
  };
  $$('[data-open-snacks]').forEach((b) => b.addEventListener('click', openSnacks));
  $$<HTMLButtonElement>('[data-snack-tab]').forEach((b) => b.addEventListener('click', () => { zone = b.dataset.snackTab as Zone; message(''); renderSnacks(); }));
  $<HTMLInputElement>('[data-snack-peanuts]')?.addEventListener('change', (e) => { setPeanuts(draft, (e.target as HTMLInputElement).checked); renderSnacks(); });
  $('[data-snack-add]')?.addEventListener('click', () => {
    const input = $<HTMLInputElement>('[data-snack-custom]');
    const name = (input?.value ?? '').trim();
    if (!name) return message('Enter a snack name.');
    if ([...draft.fridge, ...draft.pantry].some((i) => i.id === 'custom')) return message('Only one custom food per station. Remove the current one first.');
    if (draft[zone].length >= SLOTS) return message('Remove one food before adding another.');
    addCustom(draft, zone, name);
    if (input) input.value = '';
    message('Custom food added.');
    renderSnacks();
  });
  $('[data-snack-cancel]')?.addEventListener('click', () => snackDialog?.close());
  $('[data-snack-save]')?.addEventListener('click', () => {
    update((s) => { setPeanuts(s, draft.excludePeanuts); for (const z of ZONES) setFoods(s, z, draft[z]); });
    snackDialog?.close();
  });

  // Standalone page controls.
  $('[data-jss-restore]')?.addEventListener('click', () => update((s) => { Object.assign(s, freshState()); }));
  $('[data-jss-print]')?.addEventListener('click', () => window.print());
  $$('[data-open-editor]').forEach((b) => b.addEventListener('click', () => editDialog?.showModal()));
  const download = $<HTMLButtonElement>('[data-jss-download]');
  download?.addEventListener('click', async () => {
    if (!sheet || !download) return;
    download.disabled = true; const label = download.textContent; download.textContent = 'Preparing image…'; root.classList.add('jss-export');
    try {
      await Promise.all([...sheet.querySelectorAll('img')].map((img) => (img.complete ? null : img.decode().catch(() => null))));
      const { toPng } = await import('html-to-image');
      const png = await toPng(sheet, { pixelRatio: 2, width: 816, height: 1056, backgroundColor: '#fff' });
      const a = document.createElement('a'); a.download = 'our-family-snack-station.png'; a.href = png; a.click();
    } catch (err) { console.error('Snack station image export error', err); alert('Image download failed. Please try Print / Save PDF instead.'); }
    finally { root.classList.remove('jss-export'); download.disabled = false; download.textContent = label; }
  });

  const setLocked = (on: boolean) => {
    locked = on;
    $$('.jss-sheet [contenteditable]').forEach((el) => el.setAttribute('contenteditable', on ? 'false' : 'true'));
    $$<HTMLButtonElement>('.jss-sheet [data-jss-remove]').forEach((b) => { b.hidden = on; });
    $$<HTMLSelectElement>('.jss-dialog select').forEach((s) => { s.disabled = on; });
    if (on) { editDialog?.close(); snackDialog?.close(); }
  };

  const applyHousehold = (detail: Detail) => {
    if (!detail?.household) return;
    const next = planKey(detail.sample ?? null, detail.household.id);
    members = detail.household.members ?? [];
    displayName = detail.household.displayName;
    if (next !== current) {
      current = next;
      const raw = tabStorage.get(key);
      state = readScoped(raw, current, isJuneState) ?? fromLegacy(raw, `${detail.sample ?? 'account'}:${detail.household.id}`, members) ?? freshState();
    }
    applyFamily(state, members);
    changed();
  };

  root.clubPlan = {
    ready: () => Boolean(current),
    state: () => state,
    update,
    replace: (s) => { state = structuredClone(s); changed(); },
    setPersist: (on) => { persist = on; if (on) save(); },
    fingerprint: () => juneFingerprint(state, members, displayName),
    members: () => children(members),
    view: () => juneView(state, members, displayName),
    setLocked,
    openEditor: (which) => { if (locked) return; if (which === 'snacks') openSnacks(); else editDialog?.showModal(); },
  };
  window.addEventListener('omc:club-preview-household', (e) => applyHousehold((e as CustomEvent<Detail>).detail));
  const cached = (window as Window & { __ofcPreviewHousehold?: Detail }).__ofcPreviewHousehold;
  if (cached) applyHousehold(cached);
  draw();
}
</script>

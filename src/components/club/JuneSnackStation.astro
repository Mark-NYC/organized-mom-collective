 root.querySelectorAll('[data-open-snacks]').forEach(b=>b.addEventListener('click',openSnacks));
 root.querySelectorAll<HTMLButtonElement>('[data-snack-tab]').forEach(b=>b.addEventListener('click',()=>{activeSnackZone=b.dataset.snackTab as Zone;snackMessage('');renderSnacks()}));

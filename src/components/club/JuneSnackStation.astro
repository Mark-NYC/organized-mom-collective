    const id=String(index)+':'+(child.name??'').trim().toLowerCase();
    if(select.value==='help'||select.value==='independent')state.levels[id]=select.value;
    else delete state.levels[id];
    save();renderLevels();
   });
   row.append(name,select);controls.append(row);
  });
  if(!children.length){const note=document.createElement('small');note.textContent='Add family details to get individual suggestions. The sample works without them.';controls.append(note)}
  const svg=(level:Level)=>level==='help'?'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 13V8a2 2 0 0 1 4 0v4-7a2 2 0 0 1 4 0v6-3a2 2 0 0 1 4 0v8c0 4-3 6-7 6h-1c-2 0-4-1-5-3l-3-5a2 2 0 0 1 3-2l2 2"/></svg>':'<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m7.5 12 3 3 6-6"/></svg>';
  const populated=groups.filter(g=>g.names.length);
  if(!populated.length){const row=document.createElement('div');row.className='jss-level-line';row.innerHTML=svg('help');row.append(document.createTextNode('Ask for help.'));sheetLines.append(row);return}
  for(const group of populated){
   const line=document.createElement('div');line.className='jss-level-line';line.innerHTML=svg(group.level);
   const named=group.names.filter(Boolean);if(named.length){const label=document.createElement('span');label.className='jss-level-names';label.textContent=named.join(', ')+' ·';line.append(label)}
   line.append(document.createTextNode(group.level==='help'?'Ask for help.':'Choose. Prepare. Clean up.'));
   sheetLines.append(line);
  }
 };
 const draw=()=>{
  root.querySelectorAll<HTMLElement>('.jss-food').forEach(el=>{
   const zone=el.dataset.zone as Zone;const index=Number(el.dataset.slot);const item=state[zone]?.[index];if(!item)return;
   el.hidden=!!item.removed||forbidden(item.id);
   const img=el.querySelector<HTMLImageElement>('img');if(img){img.src=item.id==='custom'?fallback:(snackIconPaths[item.id]||'/images/tools/lunch/'+item.id+'.png');img.onerror=()=>{img.onerror=null;img.src=fallback}}
   const title=el.querySelector<HTMLElement>('[data-food-text]');if(title&&document.activeElement!==title)title.textContent=item.label;
  });
  const rule=root.querySelector<HTMLElement>('[data-jss-rule-text]');if(rule&&document.activeElement!==rule)rule.textContent=state.text.rule??rules[state.rule];
  root.querySelectorAll<HTMLElement>('.jss-zone-title p').forEach((el,i)=>el.textContent=i===0&&state.rule==='big'?'Choose two':'Choose one');
  root.querySelector<HTMLElement>('.jss-fridge')?.toggleAttribute('hidden',state.rule==='pantry');
  root.querySelector<HTMLElement>('.jss-pantry')?.toggleAttribute('hidden',state.rule==='fridge');
  const reset=root.querySelector<HTMLElement>('[data-jss-reset-text]');if(reset&&document.activeElement!==reset)reset.textContent=state.text.cleanup??state.reset;
  const initial:Record<string,string>={headline:'my own snack!',subtitle:'Pick it. Enjoy it. Put it away.',fridgeTitle:'From the fridge',pantryTitle:'From the pantry'};
  for(const [key,value] of Object.entries(initial)){const node=root.querySelector<HTMLElement>('[data-jss-edit="'+key+'"]');if(node&&document.activeElement!==node)node.textContent=state.text[key]??value}
  const fam=root.querySelector<HTMLElement>('[data-jss-family]');if(fam)fam.textContent=family;
  renderLevels();
  const visible=[...state.fridge,...state.pantry].filter(item=>!item.removed&&!forbidden(item.id)).length;
  const total=root.querySelector<HTMLElement>('[data-jss-summary-count]');if(total)total.textContent=visible+' foods';
  const summaryRule=root.querySelector<HTMLElement>('[data-jss-summary-rule]');if(summaryRule)summaryRule.textContent=({standard:'1 fridge + 1 pantry',big:'2 fridge + 1 pantry',fridge:'Fridge only',pantry:'Pantry only'})[state.rule];
  const summaryReset=root.querySelector<HTMLElement>('[data-jss-summary-reset]');if(summaryReset)summaryReset.textContent=state.reset.replace('Put food away · ','Food away + ').replace('Bring dishes to the sink','dishes to sink').replace('Throw wrappers away','wrappers in trash').replace('Wipe your spot','wipe your spot');
  const ruleSelect=root.querySelector<HTMLSelectElement>('[data-rule]');if(ruleSelect)ruleSelect.value=state.rule;
  const peanut=root.querySelector<HTMLInputElement>('[data-exclude-peanuts]');if(peanut)peanut.checked=state.excludePeanuts;
  const resetSelect=root.querySelector<HTMLSelectElement>('[data-reset]');if(resetSelect)resetSelect.value=state.reset;
 };
 const makeChoices=()=>{
  const container=root.querySelector<HTMLElement>('[data-jss-choices]');if(!container)return;container.replaceChildren();
  for(const zone of ['fridge','pantry'] as Zone[]){
   for(let i=0;i<4;i++){
    const field=document.createElement('div');field.className='jss-choice';
    const label=document.createElement('label');label.textContent=(zone==='fridge'?'Fridge':'Pantry')+' · choice '+(i+1);
    const select=document.createElement('select');select.setAttribute('aria-label',label.textContent);
    for(const food of foods.filter(f=>f.zone===zone&&!forbidden(f.id))){
     const opt=document.createElement('option');opt.value=food.id;opt.textContent=food.name;select.append(opt);
    }
    const custom=document.createElement('option');custom.value='custom';custom.textContent='My custom food';select.append(custom);
    select.value=forbidden(state[zone][i].id)?'custom':state[zone][i].id;
    select.addEventListener('change',()=>{
     const food=foods.find(f=>f.id===select.value&&f.zone===zone);
     state[zone][i]={id:select.value,label:food?.name??'My snack',removed:false};save();draw();makeChoices();
    });
    label.append(select);field.append(label);
    const labelEdit=document.createElement('label');labelEdit.textContent='Change displayed label';
    const input=document.createElement('input');input.type='text';input.maxLength=45;input.value=state[zone][i].label;
    input.setAttribute('aria-label','Change '+zone+' choice '+(i+1)+' label');
    input.addEventListener('input',()=>{state[zone][i].label=input.value.slice(0,45);save();draw()});
    labelEdit.append(input);field.append(labelEdit);
    const toggle=document.createElement('button');toggle.type='button';toggle.className='jss-toggle';toggle.textContent=state[zone][i].removed?'＋ Restore row':'× Remove row';
    toggle.setAttribute('aria-label',(state[zone][i].removed?'Restore ':'Remove ')+state[zone][i].label);
    toggle.addEventListener('click',()=>{state[zone][i].removed=!state[zone][i].removed;save();draw();makeChoices()});
    field.append(toggle);container.append(field);
   }
  }
 };
 root.querySelectorAll<HTMLElement>('.jss-food').forEach(el=>{
  const zone=el.dataset.zone as Zone,index=Number(el.dataset.slot);
  const remove=el.querySelector<HTMLButtonElement>('[data-jss-remove]');
  remove?.addEventListener('click',()=>{state[zone][index].removed=true;save();draw();makeChoices()});
  const title=el.querySelector<HTMLElement>('[data-food-text]');if(!title)return;
  title.addEventListener('input',()=>{state[zone][index].label=(title.textContent??'').replace(/\s+/g,' ').slice(0,36);save()});
  title.addEventListener('blur',()=>{state[zone][index].label=(title.textContent??'').replace(/\s+/g,' ').trim().slice(0,36)||(foods.find(f=>f.id===state[zone][index].id)?.name??'My snack');save();draw()});
  title.addEventListener('keydown',(e:KeyboardEvent)=>{if(e.key==='Enter'){e.preventDefault();title.blur()}});
 });
 root.querySelectorAll<HTMLElement>('[data-jss-edit]').forEach(el=>{
  const field=el.dataset.jssEdit;if(!field)return;
  el.addEventListener('input',()=>{state.text[field]=(el.textContent??'').replace(/\s+/g,' ').slice(0,110);save()});
  el.addEventListener('blur',()=>{state.text[field]=(el.textContent??'').replace(/\s+/g,' ').trim().slice(0,110);save();draw()});
  el.addEventListener('keydown',(event:KeyboardEvent)=>{if(event.key==='Enter'){event.preventDefault();el.blur()}});
 });
 root.querySelector<HTMLSelectElement>('[data-rule]')?.addEventListener('change',e=>{state.rule=(e.target as HTMLSelectElement).value as State['rule'];delete state.text.rule;save();draw()});
 root.querySelector<HTMLSelectElement>('[data-reset]')?.addEventListener('change',e=>{state.reset=(e.target as HTMLSelectElement).value;delete state.text.cleanup;save();draw()});
 root.querySelector<HTMLInputElement>('[data-exclude-peanuts]')?.addEventListener('change',e=>{
  state.excludePeanuts=(e.target as HTMLInputElement).checked;
  for(const zone of ['fridge','pantry'] as Zone[])for(const item of state[zone])if(forbidden(item.id)){item.id='custom';item.label='Choose a safe snack';item.removed=true}
  save();draw();makeChoices();
 });
 root.querySelector('[data-jss-restore]')?.addEventListener('click',()=>{state=starter();save();draw();makeChoices()});
 root.querySelector('[data-jss-print]')?.addEventListener('click',()=>window.print());
 const download=root.querySelector<HTMLButtonElement>('[data-jss-download]');
 download?.addEventListener('click',async()=>{
  if(!sheet||!download)return;
  download.disabled=true;const label=download.textContent;download.textContent='Preparing image…';root.classList.add('jss-export');
  try{
   await Promise.all(Array.from(sheet.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));
   const {toPng}=await import('html-to-image');
   const png=await toPng(sheet,{pixelRatio:2,width:816,height:1056,backgroundColor:'#fff'});
   const a=document.createElement('a');a.download='our-family-snack-station.png';a.href=png;a.click();
  }catch(err){console.error('Snack station image export error',err);alert('Image download failed. Please try Print / Save PDF instead.')}
  finally{root.classList.remove('jss-export');download.disabled=false;download.textContent=label}
 });
 const applyHousehold=(detail:{household:{id:string;displayName?:string;children?:Child[]};sample?:string})=>{
  if(!detail?.household)return;
  const next=(detail.sample??'account')+':'+detail.household.id;const changed=profile!==next;profile=next;
  children=Array.isArray(detail.household.children)?detail.household.children.slice(0,8).map(c=>({name:typeof c.name==='string'?c.name.slice(0,40):'',age:typeof c.age==='number'&&Number.isFinite(c.age)?c.age:null})):[];
  const display=detail.household.displayName?.trim();family=display?display.toUpperCase()+' · SNACK STATION':"OUR FAMILY'S SNACK STATION";
  if(changed){
   state=starter();
   try{
    const saved=JSON.parse(sessionStorage.getItem(key)??'null');
    if(saved?.profile===profile&&saved.state){
     const s=saved.state;
     if(s.levels&&typeof s.levels==='object')for(const [id,level] of Object.entries(s.levels))if(level==='help'||level==='independent')state.levels[id]=level;
     if(['standard','big','fridge','pantry'].includes(s.rule))state.rule=s.rule;else if(s.rule==='two')state.rule='standard';state.excludePeanuts=s.excludePeanuts===true;
     if(s.text&&typeof s.text==='object'){
      for(const field of ['headline','subtitle','rule','cleanup','fridgeTitle','pantryTitle']){
       if(typeof s.text[field]==='string')state.text[field]=s.text[field].slice(0,110);
      }
     }
     if(["When you're done, bring your snack and dishes back to the kitchen counter.",'Put food away · Bring dishes to the sink','Put food away · Throw wrappers away','Put food away · Wipe your spot'].includes(s.reset))state.reset=s.reset;
     for(const zone of ['fridge','pantry'] as Zone[]){
      if(Array.isArray(s[zone])&&s[zone].length===4){
       for(let i=0;i<4;i++){
        const item=s[zone][i];if(!item||(item.id!=='custom'&&!foods.some(f=>f.id===item.id&&f.zone===zone)))continue;
        state[zone][i]={id:item.id,label:typeof item.label==='string'?(item.label.slice(0,36)):(foods.find(f=>f.id===item.id)?.name??'My snack'),removed:item.removed===true};
       }
      }
     }
    }
   }catch{}
  }
  save();draw();makeChoices();
 };
 window.addEventListener('omc:club-preview-household',(event:Event)=>applyHousehold((event as CustomEvent<{household:{id:string;displayName?:string;children?:Child[]};sample?:string}>).detail));
 const cached=(window as Window & {__ofcPreviewHousehold?:{household:{id:string;displayName?:string;children?:Child[]};sample?:string}}).__ofcPreviewHousehold;
 if(cached)applyHousehold(cached);
 draw();makeChoices();
}
</script>
---
/**
 * August, Back to School Without the Scramble, on phones and tablets (below 1100px): the family plan (who does what,
 * edited with the shared owner editor, src/lib/club/personalize/editor.ts), each child's routine (the before- and
 * after-school steps) and the words on the sheet, inside the shared ClubPlanScreen. It reads and changes the plan
 * only through the printable's controller (`.asr` root's `clubPlan`, src/lib/club/engines/august-school-routines.ts).
 */
import ClubPlanScreen from './plan/ClubPlanScreen.astro';
import '../../styles/club-personalize.css';
import '../../styles/club-marks.css';
interface Props { deadline: string }
const { deadline } = Astro.props;
---
<ClubPlanScreen deadline={deadline} kicker="August · Organized Family Club" sheets={['plan', 'morning', 'after']} previewNote="Your family’s plan and two routine charts, ready to print">
  <Fragment slot="title">Back to School <em>Without the Scramble</em></Fragment>
  <section class="cp-section" aria-labelledby="aum-plan-title" data-aum-plan-section>
    <h2 id="aum-plan-title">Our back-to-school plan</h2>
    <p class="cp-intro">Who does what, prepared from your family: every child’s own part by age, and the grown-up jobs shared between the grown-ups. Tap a part to change who does it.</p>
    <ul class="cp-group" data-aum-plan></ul>
    <p class="aum-restore" data-aum-plan-restore hidden><button type="button" class="cp-link"><span>Start over with the prepared plan</span></button></p>
  </section>
  <section class="cp-section" aria-labelledby="aum-steps-title">
    <h2 id="aum-steps-title">Our routine charts</h2>
    <p class="cp-intro">One morning chart and one after-school chart for all the children. Each row shows a time (mornings) or a trigger, the everyday moment that starts it (after school). Tap a chart to change it.</p>
    <ul class="cp-group" data-aum-groups></ul>
  </section>
  <section class="cp-section" aria-labelledby="aum-words-title">
    <h2 id="aum-words-title">Words on your charts</h2>
    <ul class="cp-group" data-aum-words></ul>
    <p class="aum-restore" data-aum-restore hidden><button type="button" class="cp-link"><span>Restore this routine</span></button><span data-aum-restore-note></span></p>
  </section>
</ClubPlanScreen>

<style is:global>
@media screen and (max-width:1099px){
.aum-restore{display:grid;margin:6px 0 0;font-size:.85rem;line-height:1.45;color:var(--cp-soft)}
.aum-restore[hidden]{display:none}
.aum-label{font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--cp-soft)}
.aum-steps{display:grid;gap:10px;margin:0;padding:0;list-style:none}
.aum-step{display:grid;gap:8px;padding:12px;border:1px solid #dfe5dc;border-radius:8px;background:#fff}
.aum-step-head{display:flex;align-items:center;gap:10px}
.aum-step-head>span{margin-left:auto;white-space:nowrap;font-size:.9rem;color:var(--cp-soft)}
.aum-step-head img{width:40px;height:40px;object-fit:contain;flex:0 0 40px}
.aum-step-fields{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,8.5rem);gap:8px}
.aum-step-fields input{min-width:0}
.aum-step-fields .cp-field{margin:0}
.aum-step-actions{display:flex;flex-wrap:wrap;gap:6px}
.aum-step-actions .cp-chip{min-height:40px}
.aum-check{display:flex;gap:10px;align-items:flex-start;margin:4px 0 0;font-size:.92rem;line-height:1.45}
.aum-check input{width:20px;height:20px;margin-top:2px;flex:0 0 20px}
.aum-step[data-removed]{background:#f6f6f3}
.aum-issue{margin:0;padding:8px 10px;border-left:3px solid #c9822f;background:#fbf4ea;color:#5a4630;font-size:.85rem;line-height:1.45}
.aum-step[data-removed] strong{color:var(--cp-soft);text-decoration:line-through}
.cp-thumbs [data-cp-thumb][hidden]{display:none}
[data-aum-plan-section][hidden]{display:none}
}
</style>

<script>
import { el } from '../../lib/club/plan/dom';
import { mountPlanScreen, type PlanScreen } from '../../lib/club/plan/screen';
import {
  CHOICES, CUE_TEXT_LIMIT, FOOTER_LIMIT, GROUPS, GROUP_INFO, MAX_STEPS, cueOf, routineKids, setChartMode, setCue, setLeave, setShowOther, setWho, slotKind, ICONS, LABEL_LIMIT, addStep, clock, move, planEdited, restorePlan, restoreRoutine, routineChanged, routineOf,
  setChild, setFooter, setLabel, setMode, setRemoved, setTime, shown, taskRules, validTime, type AugPlan, type AugState, type Group, type PlanSection,
} from '../../lib/club/engines/august-school-routines';
import { resetTask, setTaskCue, setTaskSkip, setTaskTitle, toggleTaskOwner } from '../../lib/club/personalize/edits';
import { taskEditor } from '../../lib/club/personalize/editor';

const APPROVAL_KEY = 'omc:preview:august-school-routines:approval';
const root = document.querySelector<HTMLElement>('.club-plan:has(.asr)');
const asr = root?.querySelector<HTMLElement & { clubPlan?: AugPlan }>('.asr');
if (root && asr) {
  const plan = () => asr.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  let ui: PlanScreen<AugState>;

  const row = (label: string, title: string, detail: string, open: () => void, locked: boolean, lead: Node = el('span')) => {
    const b = el('button', { type: 'button', class: 'cp-row', disabled: locked }, lead,
      el('span', { class: 'cp-row-text' }, el('span', { class: 'aum-label' }, label), el('strong', {}, title), detail ? el('span', {}, detail) : ''),
      el('span', { class: 'cp-chev', 'aria-hidden': 'true' }));
    b.setAttribute('aria-label', `${label}: ${title}.${locked ? '' : ' Change'}`);
    b.addEventListener('click', open);
    return el('li', {}, b);
  };

  const render = (_ui: PlanScreen<AugState>, s: AugState, locked: boolean) => {
    const v = plan().view();
    // The family plan: a row per part of the day, its jobs and who does them.
    q('[data-aum-plan-section]').hidden = !v.plan.active;
    q('[data-aum-plan]').replaceChildren(
      row('Out the door', v.plan.leaveClock, 'From the school start on your family page', () => {}, true),
      ...v.plan.sections.map((sec) => {
        const on = sec.tasks.filter((t) => !t.skipped);
        return row(sec.title, `${on.length} ${on.length === 1 ? 'job' : 'jobs'}`, on.map((t) => `${t.label}: ${t.who}`).join(' · '), () => openSection(sec.id), locked);
      }));
    q('[data-aum-plan-restore]').hidden = locked || !planEdited(s);
    // Thumbnails: only the sheets this family prints; the large preview is the plan, or the morning chart without one.
    const hero = root.querySelector<HTMLElement>('.cp-thumb--hero');
    if (hero) hero.dataset.cpThumb = v.plan.active ? 'plan' : 'morning';
    root.querySelectorAll<HTMLElement>('.cp-thumbs [data-cp-thumb="plan"]').forEach((t) => { t.hidden = !v.plan.active; });
    q('[data-aum-groups]').replaceChildren(...v.charts.map((c) => {
      const timed = c.steps.flatMap((x) => (x.slot?.kind === 'time' ? [x.slot] : []));
      const span = c.mode === 'time' && timed.length ? `times ${timed[0].clock.join(' ')} to ${timed.at(-1)!.clock.join(' ')}` : 'triggers';
      const warn = c.issues.length ? ` · ${c.issues.length} to check` : '';
      return row(c.title, `${c.steps.length} ${c.steps.length === 1 ? 'step' : 'steps'} · ${span}${warn}`, c.steps.map((x) => x.label).join(', '), () => openGroup(c.group), locked);
    }));
    q('[data-aum-words]').replaceChildren(
      row('Under the title', v.footer, '', openWords, locked));
    q('[data-aum-restore]').hidden = locked || !routineChanged(s, plan().members());
    q('[data-aum-restore-note]').textContent = 'Puts back the prepared steps, times, triggers and wording on both charts.';
  };

  // One part of the family plan, in the shared owner editor.
  const openSection = (id: PlanSection) => {
    const p = plan();
    const sec = p.view().plan.sections.find((x) => x.id === id);
    if (!sec) return;
    const again = () => { const sheet = root.querySelector<HTMLDialogElement>('[data-cp-sheet]'); const top = sheet?.scrollTop ?? 0; openSection(id); if (sheet) sheet.scrollTop = top; };
    const edit = (fn: (s: AugState) => void) => { p.update((s) => { s.plan ??= {}; fn(s); }); again(); };
    ui.openSheet(sec.title,
      el('p', { class: 'cp-sheet-hint' }, 'Tap names to change who does each job (more than one is fine), change the wording or when it happens, or leave a job off the page.'),
      taskEditor({
        ctx: p.view().plan.ctx, tasks: sec.tasks, rules: taskRules, locked: ui.readOnly(),
        onOwners: (tid, person, cur) => edit((s) => toggleTaskOwner(s.plan!, tid, cur, person)),
        onTitle: (tid, title) => edit((s) => setTaskTitle(s.plan!, tid, title, sec.tasks.find((t) => t.id === tid)?.title ?? title)),
        onCue: (tid, cue) => edit((s) => setTaskCue(s.plan!, tid, cue, sec.tasks.find((t) => t.id === tid)?.preparedCue)),
        onSkip: (tid, skip) => edit((s) => setTaskSkip(s.plan!, tid, skip)),
        onReset: (tid) => edit((s) => resetTask(s.plan!, tid)),
      }),
      el('div', { class: 'cp-sheet-actions' }, ui.doneButton()));
  };
  const openGroup = (g: Group) => {
    const p = plan();
    const members = p.members();
    const r = routineOf(p.state(), members);
    const visible = shown(r, g);
    const chart = p.view().charts.find((c) => c.group === g)!;
    const mode = chart.mode;
    const overflow = new Set(p.overflowing());
    const kids = routineKids(members);
    // Redrawing after each change keeps the sheet where she was.
    const again = () => { const sheet = root.querySelector<HTMLDialogElement>('[data-cp-sheet]'); const top = sheet?.scrollTop ?? 0; openGroup(g); if (sheet) sheet.scrollTop = top; };
    const steps = el('ul', { class: 'aum-steps' }, ...r.steps.filter((x) => x.group === g).map((step) => {
      const off = Boolean(step.removed) || !visible.includes(step);
      const li = el('li', { class: 'aum-step' });
      if (off) li.setAttribute('data-removed', '');
      const shows = slotKind(r, step) === 'time' ? clock(step.time) : cueOf(step);
      li.append(el('div', { class: 'aum-step-head' }, el('img', { src: ICONS[step.icon] ?? ICONS.bag, alt: '' }), el('strong', {}, step.label), off || !shows ? '' : el('span', {}, shows)));
      const actions = el('div', { class: 'aum-step-actions' });
      if (step.removed) {
        const b = el('button', { type: 'button', class: 'cp-chip' }, 'Put back');
        b.setAttribute('aria-label', `Put back ${step.label}`);
        b.addEventListener('click', () => { p.update((s) => setRemoved(s, step.id, false, p.members())); again(); });
        actions.append(b);
      } else if (!off) {
        const name = el('input', { type: 'text', maxLength: LABEL_LIMIT, value: step.label });
        name.addEventListener('change', () => { p.update((s) => setLabel(s, step.id, name.value, p.members())); again(); });
        const time = el('input', { type: 'time', step: '300', value: validTime(step.time) ? step.time : '07:30' });
        time.addEventListener('change', () => { if (validTime(time.value)) { p.update((s) => setTime(s, step.id, time.value, p.members())); again(); } });
        const cue = el('input', { type: 'text', maxLength: CUE_TEXT_LIMIT, value: step.cue ?? cueOf(step), placeholder: 'e.g. After breakfast' });
        cue.addEventListener('change', () => { p.update((s) => setCue(s, step.id, cue.value, p.members())); again(); });
        const check = (label: string, on: boolean, set: (v: boolean) => void) => { const c = el('input', { type: 'checkbox', checked: on }); c.addEventListener('change', () => { set(c.checked); again(); }); return el('label', { class: 'aum-check' }, c, ` ${label}`); };
        li.append(el('div', { class: 'aum-step-fields' }, el('label', { class: 'cp-field' }, 'Step', name), el('label', { class: 'cp-field' }, 'Time', time)),
          el('label', { class: 'cp-field' }, 'Trigger (the everyday moment that starts it)', cue),
          check(mode === 'time' ? 'Show the trigger instead of the time' : 'Show the time instead of the trigger', Boolean(step.show && step.show !== mode), (v) => p.update((s) => setShowOther(s, step.id, v, p.members()))));
        if (overflow.has(`${g}:${step.id}`)) li.append(el('p', { class: 'aum-issue' }, 'This trigger needs more than two lines in its box. Shorten it a little.'));
        if (kids.length > 1) {
          const chip = (label: string, on: boolean, pick: () => void) => { const b = el('button', { type: 'button', class: 'cp-chip' }, label); b.setAttribute('aria-pressed', String(on)); b.addEventListener('click', () => { pick(); again(); }); return b; };
          li.append(el('div', { class: 'cp-field' }, el('span', {}, 'Who does it'), el('div', { class: 'cp-chips', role: 'group' },
            chip('Everyone', !step.who?.length, () => p.update((s) => setWho(s, step.id, [], p.members()))),
            ...kids.map((k) => { const on = Boolean(step.who?.includes(k.id)); return chip(k.firstName, on, () => p.update((s) => setWho(s, step.id, on ? (step.who ?? []).filter((w) => w !== k.id) : [...(step.who ?? []), k.id], p.members()))); }))));
        }
        for (const issue of chart.issues.filter((x) => x.stepId === step.id)) li.append(el('p', { class: 'aum-issue' }, issue.text));
        for (const [dir, text] of [[-1, 'Move up'], [1, 'Move down']] as const) {
          const b = el('button', { type: 'button', class: 'cp-chip', disabled: !visible[visible.indexOf(step) + dir] }, text);
          b.setAttribute('aria-label', `Move ${step.label} ${text.toLowerCase()}`);
          b.addEventListener('click', () => { p.update((s) => move(s, step.id, dir, p.members())); again(); });
          actions.append(b);
        }
        const rm = el('button', { type: 'button', class: 'cp-chip' }, 'Remove');
        rm.setAttribute('aria-label', `Remove ${step.label}`);
        rm.addEventListener('click', () => { p.update((s) => setRemoved(s, step.id, true, p.members())); again(); });
        actions.append(rm);
      } else {
        actions.append(el('span', { class: 'cp-sheet-hint' }, 'Hidden by the shorter routine'));
      }
      li.append(actions);
      return li;
    }));
    // The chart as a whole: times or triggers in every row's box; the morning's out-the-door time.
    const modeChip = (m: 'time' | 'trigger', label: string) => { const b = el('button', { type: 'button', class: 'cp-chip' }, label); b.setAttribute('aria-pressed', String(mode === m)); b.addEventListener('click', () => { p.update((s) => setChartMode(s, g, m, p.members())); again(); }); return b; };
    const whole: Node[] = [el('div', { class: 'cp-field' }, el('span', {}, 'Show on the chart'), el('div', { class: 'cp-chips', role: 'group' }, modeChip('time', 'Times'), modeChip('trigger', 'Triggers'))),
      el('p', { class: 'cp-sheet-hint' }, mode === 'time' ? 'Each row shows its time. Open a step to show its trigger instead.' : 'Each row shows the everyday moment that starts it. Open a step to show its time instead.')];
    if (g === 'morning') {
      const leave = el('input', { type: 'time', step: '300', value: p.view().leave });
      leave.addEventListener('change', () => { p.update((s) => setLeave(s, leave.value, p.members())); again(); });
      whole.push(el('label', { class: 'cp-field' }, 'Out the door by', leave),
        el('p', { class: 'cp-sheet-hint' }, p.view().sampleTimes ? 'Sample times: add when school starts on your family page, or set the out-the-door time here.' : 'Timed back from when school starts on your family page.'));
    }
    const present = new Set(r.steps.filter((x) => x.group === g && !x.removed).map((x) => x.id));
    const full = visible.length >= MAX_STEPS;
    const add = el('div', { class: 'cp-chips', role: 'group' }, ...CHOICES[g].filter((c) => !present.has(c.id)).map((c) => {
      const b = el('button', { type: 'button', class: 'cp-chip', disabled: full }, `＋ ${c.label}`);
      b.addEventListener('click', () => { p.update((s) => addStep(s, g, c.id, p.members())); again(); });
      return b;
    }));
    add.setAttribute('aria-label', 'Add a step');
    const other = GROUPS.find((x) => x !== g)!;
    const next = el('button', { type: 'button', class: 'cp-btn' }, `${GROUP_INFO[other].title} ›`);
    next.addEventListener('click', () => openGroup(other));
    ui.openSheet(GROUP_INFO[g].title, ...whole, el('p', { class: 'cp-sheet-hint' }, 'Rename, retime, reorder or remove steps, or change a trigger. Removed steps can be put back.'), steps,
      el('div', { class: 'cp-field' }, el('span', {}, full ? `${MAX_STEPS} steps is the most that fit one page` : 'Add a step'), add), el('div', { class: 'cp-sheet-actions' }, ui.doneButton(), next));
  };
  const openWords = () => {
    const p = plan();
    const v = p.view();
    const input = el('textarea', { maxLength: FOOTER_LIMIT, value: v.footer });
    input.addEventListener('input', () => p.update((s) => setFooter(s, input.value, p.members())));
    ui.openSheet('Words on your charts', el('label', { class: 'cp-field' }, 'Under the title', input),
      el('p', { class: 'cp-sheet-hint' }, 'Blank goes back to “Check the chart. Do the next thing.”'),
      el('div', { class: 'cp-sheet-actions' }, ui.doneButton()));
  };
  q('[data-aum-plan-restore] button').addEventListener('click', () => {
    const before = structuredClone(plan().state());
    plan().update((s) => restorePlan(s));
    ui.toast('The prepared plan is back.', () => plan().replace(before));
  });
  q('[data-aum-restore] button').addEventListener('click', () => {
    const before = structuredClone(plan().state());
    plan().update((s) => restoreRoutine(s, plan().members()));
    ui.toast('This routine is back to its prepared steps.', () => plan().replace(before));
  });

  const mounted = mountPlanScreen<AugState>({ root, host: asr, approvalKey: APPROVAL_KEY, render });
  if (mounted) ui = mounted;
}
</script>

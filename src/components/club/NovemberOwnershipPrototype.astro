---
/** Shared November physical worksheet prototype, rendered in both preview and member kit. */
import { JOB_PRESETS, LIMITS } from '../../lib/worksheet/content';
import { monthColors } from '../../theme';
const first=JOB_PRESETS[0];
---
<main class="ws-shell" style={`--ws-month-color: ${monthColors[10].hex}`}>
  <div class="ws-top"><a class="ws-back" href="/club">← Organized Family Club</a><span class="ws-eyebrow">ORGANIZED FAMILY CLUB · NOVEMBER 2027</span></div>
  <div class="ws-intro">
    <p class="ws-eyebrow">ONE WHOLE JOB · HANDED OFF</p>
    <h1>Less reminding. <em>More ownership.</em></h1>
    <p>One ready-made plan that gives every family member a real responsibility, with a clear finish line. You can adjust it, but you don’t have to build it.</p>
  </div>
  <div class="ws-workspace">
    <div class="ws-left">
      <div class="ws-ready" id="november-edit-controls">
        <p class="ws-eyebrow">NOVEMBER · PREPARED PLAN</p>
        <h2>Less reminding. <em>More ownership.</em></h2>
        <p>We made a ready-to-use ownership plan for <span id="ws-ready-family">the Goering Family</span>. Each person has a part with a clear finish line.</p><button class="ws-open-editor" type="button" data-ws-open>Edit responsibilities</button>
        <div class="ws-field" hidden><label for="ws-sample">Explore a sample household</label><select id="ws-sample" aria-label="Choose a sample household"><option value="goering">Goering · Two school-age children</option><option value="rivera">Rivera · Preschool and early elementary</option><option value="bennett">Bennett · Two teenagers</option></select></div><p class="ws-demo">Sample plans only · No account, payment, or mailing</p>
      </div>
      <div class="ws-actions"><div class="ws-mobile-actions"><button type="button" class="ws-mobile-edit" data-ws-open>Make changes</button><button type="submit" form="ws-form" class="ws-download ws-mobile-print" disabled>Download PDF</button></div><button type="button" class="ws-download" id="ws-approve">Looks good. Approve plan</button><button type="button" class="ws-secondary" id="ws-review">Change a responsibility</button><p id="ws-approval-note" class="ws-status" role="status" aria-live="polite">This is a demo. Approval does not send anything or initiate a mailing.</p></div>
    <dialog class="ws-edit-dialog" id="ws-edit-dialog" aria-labelledby="ws-dialog-title"><div class="ws-dialog-top"><div><span class="ws-eyebrow">MAKE IT YOURS · NOVEMBER</span><h2 id="ws-dialog-title">Edit family ownership</h2></div><button type="button" class="ws-close-dialog" data-ws-close aria-label="Close editor">×</button></div><p>We have prepared real responsibilities for your family. Adjust only what needs to change.</p>      <div class="ws-rec-head"><p id="ws-plan-heading" class="ws-plan-heading">Our School-Night Reset</p><p id="ws-plan-goal-line">Tomorrow is ready without one person managing every step.</p><h2>Everyone has a part.</h2><p>Each person knows what they own and what finished looks like. Change a handoff only if it doesn’t fit your family.</p></div>
      <div id="ws-recommendations"><article class="ws-rec" data-role="existing"><div class="ws-rec-top"><span>ALREADY OWNED</span><button class="ws-edit" type="button" data-edit="mom">Edit</button></div><h3 id="ws-mom-title">Mom</h3><p class="ws-rec-job" id="ws-mom-owns">Family calendar</p></article>
        <article class="ws-rec" data-role="adult"><div class="ws-rec-top"><span>ADULT HANDOFF</span><button class="ws-edit" type="button" data-edit="adult">Edit</button></div><h3 id="ws-adult-title">Dad</h3><p class="ws-rec-job" id="ws-adult-summary">School communications and forms</p><p id="ws-adult-desc">Check messages, handle forms, track deadlines and put dates on the family calendar.</p></article>
        <article class="ws-rec" data-role="child"><div class="ws-rec-top"><span>CHILD HANDOFF · AGE 8</span><button class="ws-edit" type="button" data-edit="child1">Edit</button></div><h3 id="ws-child1-title">Andrew</h3><p class="ws-rec-job" id="ws-child1-summary">Prepare tomorrow’s clothes and supplies</p><p id="ws-child1-desc">Lay out clothes, check supplies and put everything in its ready spot.</p></article>
        <article class="ws-rec" data-role="child"><div class="ws-rec-top"><span>CHILD HANDOFF · AGE 8</span><button class="ws-edit" type="button" data-edit="child2">Edit</button></div><h3 id="ws-child2-title">Philip</h3><p class="ws-rec-job" id="ws-child2-summary">Pack the school bag</p><p id="ws-child2-desc">Put tomorrow's folder, water bottle and supplies in the bag before bed.</p></article>
      </div>
      <details class="ws-advanced"><summary>More plan options <span>Optional</span></summary><form class="ws-controls" id="ws-form" aria-label="Optional plan adjustments" novalidate>
        <input type="hidden" name="planTitle" id="ws-plan-title" value="Our School-Night Reset"/>
        <input type="hidden" name="planGoal" id="ws-plan-goal" value="Tomorrow is ready without one person managing every step."/>
        <h2 id="ws-edit-heading">Adjust your plan</h2>
        <p class="ws-note">Only edit what you want changed. Everything else is ready.</p>
        <div class="ws-field ws-profile"><label for="ws-family">Family name</label><input id="ws-family" name="familyName" value="Goering" maxlength={LIMITS.familyName}/><p id="ws-family-hint" class="ws-hint"></p></div>
        <fieldset id="ws-mom-fields" class="ws-edit-group"><legend>Existing responsibility</legend><input type="hidden" id="ws-mom-name" name="momName" value="Mom"/><div class="ws-field"><label for="ws-mom-owns-input">Already owns</label><input id="ws-mom-owns-input" name="momOwns" value="Family calendar and weekly schedule" maxlength="110"/></div><div class="ws-field"><label for="ws-mom-relief-input">What she will no longer need to coordinate</label><textarea id="ws-mom-relief-input" name="momRelief" maxlength="170" rows="2">Reminding everyone about tomorrow and following up on school readiness.</textarea></div></fieldset><fieldset id="ws-adult-fields" class="ws-edit-group">
          <legend>Adult handoff</legend>
          <input type="hidden" id="ws-adult-owner" name="adultOwner" value="Dad"/>
          <div class="ws-field"><label for="ws-adult-job">Suggested whole responsibility</label><select id="ws-adult-job" name="adultJob"><option>Own the school communications and forms</option><option>Plan and manage weekday dinners</option><option>Manage family appointments and transportation</option><option>Own household supplies and restocking</option><option>Manage the weekly laundry system</option><option value="custom">Custom responsibility</option></select><input id="ws-adult-custom" name="adultCustom" maxlength="90" placeholder="Whole responsibility" hidden/></div>
          <div class="ws-field"><label for="ws-adult-when">When</label><input id="ws-adult-when" name="adultWhen" value="Check messages and forms each school day" maxlength="80"/></div>
          <div class="ws-field"><label for="ws-adult-steps">What finished looks like</label><textarea id="ws-adult-steps" name="adultSteps" rows="3" maxlength="260"></textarea></div>
        </fieldset>
        <fieldset id="ws-child1-fields" class="ws-edit-group">
          <legend>First child</legend>
          <div class="ws-field"><label for="ws-owner">Name</label><input id="ws-owner" name="owner" value="Andrew" maxlength={LIMITS.owner}/></div>
          <div class="ws-field"><label for="ws-job">Suggested job</label><select id="ws-job" name="preset">{JOB_PRESETS.map((p,i)=><option value={String(i)}>{p.job}</option>)}<option value="custom">Custom job</option></select></div>
          <div class="ws-field" id="ws-custom-wrap" hidden><label for="ws-custom">Custom job</label><input id="ws-custom" name="job" maxlength={LIMITS.job}/></div>
          <div class="ws-field"><label for="ws-when">When</label><input id="ws-when" name="when" value={first.when} maxlength={LIMITS.when}/></div>
          <div class="ws-field"><label for="ws-done">Specific finished result</label><textarea id="ws-done" name="done" rows="3" maxlength={LIMITS.done}>{first.done}</textarea><p class="ws-hint"><span id="ws-done-count"></span></p></div>
        </fieldset>
        <fieldset id="ws-child2-fields" class="ws-edit-group">
          <legend>Second child</legend>
          <div class="ws-field"><label for="ws-child2">Name</label><input id="ws-child2" name="secondChild" value="Philip" maxlength="28"/></div>
          <div class="ws-field"><label for="ws-child2-job">Suggested job</label><select id="ws-child2-job"><option value="1">Pack my school bag</option><option value="0">Set and clear the dinner table</option><option value="2">Put away my clean laundry</option><option value="4">Keep the entryway tidy</option><option value="custom">Custom job</option></select><input id="ws-child2-custom" maxlength="90" placeholder="Custom responsibility" hidden/></div>
          <div class="ws-field"><label for="ws-child2-done">What finished looks like</label><textarea id="ws-child2-done" name="secondDone" rows="3" maxlength="260">Homework, folder, water bottle and lunch box packed, bag by the door.</textarea></div>
        <div class="ws-field"><label for="ws-child2-when">When</label><input id="ws-child2-when" name="secondWhen" maxlength="80" value="Every school night, before bed"/></div>
        </fieldset>
        <div class="ws-field"><label for="ws-existing">Other responsibilities already owned <span class="ws-optional">optional</span></label><input id="ws-existing" name="existing" maxlength="130" placeholder="Mom: calendar"/></div>
        <div class="ws-field"><label for="ws-checkin">Family check-in <span class="ws-optional">optional</span></label><div class="ws-date-row"><input id="ws-checkin" name="checkIn" type="date"/><button type="button" id="ws-two-weeks" class="ws-link">In two weeks</button></div><p id="ws-date-hint" class="ws-hint"></p></div>
        <button type="button" id="ws-done-editing" class="ws-download">Done editing</button>
        <button type="submit" id="ws-download" class="ws-download" disabled>Download personalized PDF</button>
        <p id="ws-status" class="ws-status" role="status" aria-live="polite"></p>
        <p class="ws-helper">Two US Letter pages. Print front and back on one sheet, 100% scale, long-edge flip.</p>
      </form></details>
<button type="button" class="ws-dialog-done" data-ws-close>Done · See our plan</button></dialog>
      <p class="ws-disclaimer">This is a preview of future Club membership. No plan is saved or mailed. Recommendations are examples based on a sample family.</p>
    </div>
    <section class="ws-preview" id="ws-preview" aria-label="Worksheet preview"><button type="button" class="ws-floating-edit" data-ws-open><span>✎</span> MAKE CHANGES</button>
      
      <p class="ws-tap-hint">Tap the underlined words on your plan to edit them, or choose Make Changes.</p>
      <div class="ws-pages" id="ws-pages" aria-busy="true">
        <figure class="ws-page"><div class="ws-sheet" data-page="0"><p class="ws-loading">Loading preview…</p></div><figcaption>Front</figcaption></figure>
        <figure class="ws-page"><div class="ws-sheet" data-page="1"></div><figcaption>Back</figcaption></figure>
      </div>
      <button type="submit" form="ws-form" class="ws-download ws-download-again" disabled>Download printable PDF</button>
    </section>
  </div>
</main>
<script>
  import { JOB_PRESETS } from '../../lib/worksheet/content';
  import { createMetrics, FONT_FILES, FONT_URL, type FontBytes } from '../../lib/worksheet/fonts';
  import { layoutWorksheet } from '../../lib/worksheet/layout';
  import { normalize } from '../../lib/worksheet/normalize';
  import { renderSvg } from '../../lib/worksheet/svg';
  import type { FontKey, Metrics, WorksheetInput } from '../../lib/worksheet/types';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('ws-form');
  const preset = $<HTMLSelectElement>('ws-job');
  const custom = $<HTMLInputElement>('ws-custom');
  const when = $<HTMLInputElement>('ws-when');
  const done = $<HTMLTextAreaElement>('ws-done');
  const checkIn = $<HTMLInputElement>('ws-checkin');
  const child2 = $<HTMLSelectElement>('ws-child2-job');
  const sample = $<HTMLSelectElement>('ws-sample');
  const sampleProfiles = {
    goering:{mom:'Mom',momOwns:'Family calendar and weekly schedule',momRelief:'Reminding everyone about tomorrow and following up on school readiness.',title:'Our School-Night Reset',goal:'Tomorrow is ready without one person managing every step.',family:'Goering',adult:'Dad',adultJob:'Own the school communications and forms',adultWhen:'Check school messages each weekday; complete forms and update the calendar',child1:'Andrew',childJob:'Prepare tomorrow’s clothes and school supplies',childWhen:'Every school night before bed',childDone:'Lay out tomorrow’s clothes. Check school supplies. Put everything in the ready spot.',child2:'Philip',secondJob:'Pack my school bag',secondWhen:'Each school night before bed',existing:'Mom: family calendar'},
    rivera:{mom:'Mom',momOwns:'Family meals and groceries',momRelief:'Directing every step of the evening cleanup.',title:'Our Evening Reset',goal:'Everyone helps put the shared spaces back in order.',family:'Rivera',adult:'Dad',adultJob:'Own household supplies and restocking',adultWhen:'Check essential supplies on Sundays and restock before they run out',child1:'Sofia',childJob:'Put toys away',childWhen:'Before dinner, with an adult nearby',childDone:'Put blocks in their bin, books on the shelf and stuffed toys in the basket. A grown-up helps with sorting.',child2:'Leo',secondJob:'Keep the entryway tidy',secondWhen:'After school with a grown-up checking',existing:'Mom: meals and grocery shopping'},
    bennett:{mom:'Mom',momOwns:'Dinner planning',momRelief:'Tracking everyones commitments and chasing updates.',title:'Our Week-Ahead Plan',goal:'Everyone notices and prepares for their part of the coming week.',family:'Bennett',adult:'Dad',adultJob:'Manage family appointments and transportation',adultWhen:'Review next week each Sunday; confirm rides and update the family calendar',child1:'Maya',childJob:'Put away my clean laundry',childWhen:'On laundry day, without waiting for a reminder',childDone:'Sort and fold clean clothes, put each item in the right drawer or closet, return the basket.',child2:'Ethan',secondJob:'Take out the trash and recycling',secondWhen:'The evening before scheduled pickup',existing:'Mom: dinner planning'}
  } as const;
  function applySample(key:keyof typeof sampleProfiles) {
    const p=sampleProfiles[key];
    const value=(id:string,v:string)=> {($<HTMLInputElement|HTMLTextAreaElement>(id)).value=v;};
    value('ws-mom-name',p.mom);value('ws-mom-owns-input',p.momOwns);value('ws-mom-relief-input',p.momRelief);value('ws-family',p.family);value('ws-plan-title',p.title);value('ws-plan-goal',p.goal);value('ws-adult-owner',p.adult);value('ws-adult-when',p.adultWhen);
    value('ws-owner',p.child1);value('ws-when',p.childWhen);value('ws-done',p.childDone);
    value('ws-child2',p.child2);value('ws-child2-when',p.secondWhen);value('ws-existing',p.existing);
    const pick=(id:string,customId:string,job:string,list:string[])=>{
      const el=$<HTMLSelectElement>(id);const idx=list.findIndex(x=>x===job);
      el.value=idx<0?'custom':String(idx);
      const custom=$<HTMLInputElement>(customId);custom.hidden=idx>=0;custom.value=job;
    };
    const adultOptions=Array.from($<HTMLSelectElement>('ws-adult-job').options).filter(o=>o.value!=='custom').map(o=>o.value);
    const adultIndex=adultOptions.indexOf(p.adultJob);
    const adultSelect=$<HTMLSelectElement>('ws-adult-job');
    adultSelect.value=adultIndex<0?'custom':adultOptions[adultIndex];
    adultCustom.hidden=adultIndex>=0;adultCustom.value=p.adultJob;
    value('ws-adult-steps',adultCatalog[p.adultJob]?.steps??'Notice what needs doing. Make a plan. Follow through without reminders.');
    pick('ws-job','ws-custom',p.childJob,JOB_PRESETS.map(x=>x.job));
    $('ws-custom-wrap').hidden=$<HTMLSelectElement>('ws-job').value!=='custom';
    const options=Array.from(child2.options).filter(x=>x.value!=='custom');
    const match=options.find(o=>JOB_PRESETS[Number(o.value)].job===p.secondJob);
    child2.value=match?.value??'custom';child2Custom.hidden=Boolean(match);child2Custom.value=p.secondJob;
    value('ws-child2-done',p.child2==='Philip' ? 'Pack homework and school folder. Check water bottle and lunch container. Put bag by the door.' : match ? JOB_PRESETS[Number(match.value)].done : 'Complete the whole job and put everything back where it belongs.');
    last={when:p.childWhen,done:p.childDone};
    originalJobs=jobSelections();refreshPlanTheme();
    closeInlineEditors();
    $('ws-approval-note').textContent='Sample plan prepared. Nothing is mailed from this demo.';
    update();
  }
  sample.addEventListener('change',()=>applySample(sample.value as keyof typeof sampleProfiles));
  // The shared Family tab owns the sample household. The original three-case
  // selector remains only as an internal baseline for job recommendations.
  window.addEventListener('omc:club-preview-household',(event:Event)=>{
    const h=(event as CustomEvent<{household:{displayName?:string;members:{firstName:string;kind:string;archived?:boolean;isAccountHolder?:boolean}[]} | null}>).detail?.household;
    if(!h)return;
    const adults=h.members.filter(m=>m.kind==='adult'&&!m.archived);
    const children=h.members.filter(m=>m.kind==='child'&&!m.archived);
    const holder=adults.find(m=>m.isAccountHolder)??adults[0];
    sample.value='rivera';
    applySample('rivera');
    const put=(id:string,name:string|undefined)=>{if(name)($<HTMLInputElement>(id)).value=name;};
    put('ws-family',h.displayName);
    put('ws-mom-name','Mom');
    put('ws-adult-owner','Dad');
    put('ws-owner',children[0]?.firstName);
    put('ws-child2',children[1]?.firstName);
    $('ws-ready-family').textContent=h.displayName??'your family';
    update();
  });

  $('ws-approve').addEventListener('click',()=>{const error=planIssue();$('ws-approval-note').textContent=error??'Approved in this preview only. No mailing was scheduled, and nothing was saved.';});
  $('ws-review').addEventListener('click',()=>{editorDialog?.showModal();toggleInlineEditor('adult')});
  const editorDialog=document.querySelector<HTMLDialogElement>('#club-month-content #ws-edit-dialog');
  document.querySelectorAll<HTMLButtonElement>('#club-month-content [data-ws-open]').forEach(button=>button.addEventListener('click',()=>editorDialog?.showModal()));
  document.querySelectorAll<HTMLButtonElement>('#club-month-content [data-ws-close]').forEach(button=>button.addEventListener('click',()=>editorDialog?.close()));
  editorDialog?.addEventListener('click',event=>{if(event.target===editorDialog)editorDialog.close()});

  const child2Custom = $<HTMLInputElement>('ws-child2-custom');
  const downloads = [...document.querySelectorAll<HTMLButtonElement>('.ws-download')];
  const setBusy = (busy: boolean) => downloads.forEach((b) => (b.disabled = busy));
  const status = $<HTMLParagraphElement>('ws-status');
  const sheets = [...document.querySelectorAll<HTMLElement>('.ws-sheet')];

  let fonts: FontBytes | null = null;
  let metrics: Metrics | null = null;

  function planIssue():string|null {
    const data=normalize(input());
    if(!data.momName || !data.momOwns || !data.momRelief)return 'Complete the existing responsibility and intended relief.';
    if(!data.adultOwner || !data.owner || !data.secondChild)return 'Add a name for each featured person before approving.';
    if(!data.adultJob || !data.job || !data.secondJob)return 'Each person needs a responsibility before this plan is ready.';
    if(!data.adultWhen || !data.when || !data.secondWhen)return 'Add a time for every responsibility.';
    if(!data.adultSteps || !data.done || !data.secondDone)return 'Each responsibility needs specific steps before this plan is ready.';
    return null;
  }
  const isoDate = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  checkIn.min = isoDate(new Date());

  function input(): WorksheetInput {
    const v = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value;
    return {
      familyName: v('familyName'),
      owner: v('owner'),
      adultOwner: v('adultOwner'),
      adultJob: v('adultJob') === 'custom' ? v('adultCustom') : v('adultJob'),
      adultWhen: v('adultWhen'),
      existing: v('existing'),
      secondChild: v('secondChild'),
      secondJob: child2.value === 'custom' ? child2Custom.value : JOB_PRESETS[Number(child2.value)].job,
      secondWhen: v('secondWhen'),
      secondDone: v('secondDone'),
      job: preset.value === 'custom' ? custom.value : JOB_PRESETS[Number(preset.value)].job,
      when: when.value,
      done: done.value,
      checkIn: checkIn.value,
      planTitle: v('planTitle'),
      planGoal: v('planGoal'),
      adultSteps: v('adultSteps'),
      momName: v('momName'),momOwns: v('momOwns'),momRelief: v('momRelief'),
    };
  }

  function hints(data: ReturnType<typeof normalize>) {
    $('ws-family-hint').textContent = data.familyName ? `Prints as “${data.familyName}”.` : 'Prints as a line to write on.';
    $('ws-done-count').textContent = `${done.value.length} / ${done.maxLength} characters`;
    const past = checkIn.value && checkIn.value < isoDate(new Date());
    $('ws-date-hint').textContent = checkIn.value && !data.checkIn ? 'Choose a valid date.' : past ? 'That date has already passed.' : data.checkIn ? `Prints as “${data.checkIn}”.` : 'Leave blank to write it in.';
  }

  let queued = false;
  function update() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      const data = normalize(input());
      hints(data);
      const set = (id:string,value:string) => { const e=document.getElementById(id); if(e)e.textContent=value; };
      set('ws-ready-family',(data.familyName??'your family').replace(/^The /,'the '));
      set('ws-plan-heading',data.planTitle??'Our Family Ownership Plan');
      set('ws-plan-goal-line',data.planGoal??'');
      set('ws-mom-title','Mom');set('ws-mom-owns',data.momOwns??'Existing contribution');
      set('ws-adult-title','Dad');
      set('ws-adult-summary',data.adultJob??'Choose a responsibility');
      set('ws-adult-desc',data.adultWhen??'');
      set('ws-child1-title',data.owner??'Child');
      set('ws-child1-summary',data.job??'Choose a job');
      set('ws-child1-desc',data.done??'');
      set('ws-child2-title',data.secondChild??'Child');
      set('ws-child2-summary',data.secondJob??'Choose a job');
      set('ws-child2-desc',data.secondDone??data.secondWhen??'');
      if (!metrics) return;
      layoutWorksheet(metrics, data).forEach((page, i) => {
        sheets[i].innerHTML = renderSvg(page, i ? 'Back of the worksheet' : 'Front of the worksheet');
        bindPrintedText(i,page,sheets[i]);
      });
    });
  }


  // June-style editing: attach controls to actual SVG text nodes, never guessed page positions.
  // SVG text cannot reliably host contenteditable across browsers, so the text itself opens
  // a precisely anchored inline input. The worksheet form remains the PDF's source of truth.
  type PreviewField = {id:string;label:string;kind?:'job'};
  const fieldInfo:Record<string,PreviewField>={
    'ws-family':{id:'ws-family',label:'Family name'},
    'ws-adult-job':{id:'ws-adult-job',label:'Dad’s responsibility',kind:'job'},
    'ws-adult-when':{id:'ws-adult-when',label:'When Dad does it'},
    'ws-adult-steps':{id:'ws-adult-steps',label:'What finished looks like for Dad'},
    'ws-owner':{id:'ws-owner',label:'Child’s name'},
    'ws-job':{id:'ws-job',label:'Child’s responsibility',kind:'job'},
    'ws-when':{id:'ws-when',label:'When this job happens'},
    'ws-done':{id:'ws-done',label:'What finished looks like'},
    'ws-child2':{id:'ws-child2',label:'Child’s name'},
    'ws-child2-job':{id:'ws-child2-job',label:'Child’s responsibility',kind:'job'},
    'ws-child2-when':{id:'ws-child2-when',label:'When this job happens'},
    'ws-child2-done':{id:'ws-child2-done',label:'What finished looks like'},
    'ws-mom-owns-input':{id:'ws-mom-owns-input',label:'Mom’s existing responsibility'},
    'ws-mom-relief-input':{id:'ws-mom-relief-input',label:'What Mom no longer has to manage'}
  };
  function fieldAt(page:number,x:number,y:number):string|null{
    if(page===1)return y>=615&&y<660?'ws-mom-relief-input':null;
    if(y>=87&&y<103)return 'ws-family';
    if(y>=208&&y<235&&x>=190)return 'ws-adult-job';
    if(y>=235&&y<257)return 'ws-adult-when';
    if(y>=258&&y<363)return 'ws-adult-steps';
    if(y>=379&&y<406)return x<190?'ws-owner':'ws-job';
    if(y>=406&&y<433)return x>=190?'ws-job':'ws-when';
    if(y>=433&&y<537)return 'ws-done';
    if(y>=550&&y<577)return x<190?'ws-child2':'ws-child2-job';
    if(y>=577&&y<602)return x>=190?'ws-child2-job':'ws-child2-when';
    if(y>=602&&y<682)return 'ws-child2-done';
    if(y>=702&&y<741&&x>=190)return 'ws-mom-owns-input';
    return null;
  }
  let activeEdit:{host:HTMLDivElement;commit:()=>void}|null=null;
  function closeInlinePreview(commit:boolean){
    if(!activeEdit)return;
    const current=activeEdit;activeEdit=null;
    if(commit)current.commit();
    current.host.remove();
  }
  function originalValue(field:PreviewField):string{
    const control=$<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>(field.id);
    if(field.kind!=='job')return control.value;
    const value=control.value;
    if(value==='custom'){
      const id=field.id==='ws-adult-job'?'ws-adult-custom':field.id==='ws-job'?'ws-custom':'ws-child2-custom';
      return $<HTMLInputElement>(id).value;
    }
    return field.id==='ws-adult-job'?value:JOB_PRESETS[Number(value)]?.job??'';
  }
  function saveInlinePreview(field:PreviewField,value:string){
    if(field.kind==='job'){
      const select=$<HTMLSelectElement>(field.id);
      const option=Array.from(select.options).find(item=>item.value!=='custom' && (field.id==='ws-adult-job'?item.value===value:JOB_PRESETS[Number(item.value)]?.job===value));
      if(option)select.value=option.value;
      else{
        select.value='custom';
        const id=field.id==='ws-adult-job'?'ws-adult-custom':field.id==='ws-job'?'ws-custom':'ws-child2-custom';
        $<HTMLInputElement>(id).value=value.slice(0,90);
      }
      if(field.id==='ws-adult-job')adultCustom.hidden=select.value!=='custom';
      if(field.id==='ws-job')$('ws-custom-wrap').hidden=select.value!=='custom';
      if(field.id==='ws-child2-job')child2Custom.hidden=select.value!=='custom';
    }else{
      const control=$<HTMLInputElement|HTMLTextAreaElement>(field.id);
      control.value=value.slice(0,control.maxLength>0?control.maxLength:260);
      control.dispatchEvent(new Event('input',{bubbles:true}));
    }
    refreshPlanTheme();
    update();
  }
  function editPrintedText(node:SVGTextElement,field:PreviewField){
    closeInlinePreview(true);
    const rect=node.getBoundingClientRect();
    const box=document.createElement('div');box.className='ws-precise-editor';
    const label=document.createElement('label');label.textContent=field.label;
    const textarea=['ws-adult-steps','ws-done','ws-child2-done','ws-mom-relief-input'].includes(field.id);
    const input=document.createElement(textarea?'textarea':'input') as HTMLInputElement|HTMLTextAreaElement;
    input.setAttribute('aria-label',field.label);
    input.value=originalValue(field);
    const reference=$<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>(field.id);
    input.maxLength=field.kind==='job'?90:reference instanceof HTMLSelectElement?90:reference.maxLength>0?reference.maxLength:260;
    const approve=document.createElement('button');approve.type='button';approve.textContent='✓';approve.setAttribute('aria-label','Apply change');
    box.append(label,input,approve);document.body.append(box);
    // Positioned from the actual rendered text bounding box, not from page percentages.
    const width=Math.min(Math.max(rect.width+35,210),Math.min(390,window.innerWidth-24));
    box.style.width=width+'px';
    box.style.left=Math.max(12,Math.min(rect.left-8,window.innerWidth-width-12))+'px';
    box.style.top=Math.max(12,Math.min(rect.top-14,window.innerHeight-(textarea?205:140)))+'px';
    const old=input.value;
    const commit=()=>{if(input.value.trim()!==old)saveInlinePreview(field,input.value.trim())};
    activeEdit={host:box,commit};
    approve.addEventListener('click',()=>closeInlinePreview(true));
    input.addEventListener('keydown',event=>{
      const e=event as KeyboardEvent;
      if(e.key==='Escape'){input.value=old;closeInlinePreview(false)}
      if(e.key==='Enter' && !textarea){e.preventDefault();closeInlinePreview(true)}
    });
    input.addEventListener('blur',()=>{
      // A click on the confirm button must run before blur disposes it.
      window.setTimeout(()=>{if(activeEdit?.host===box && !box.contains(document.activeElement))closeInlinePreview(true)},0);
    });
    input.focus();input.select();
  }
  function bindPrintedText(pageIndex:number,page:ReturnType<typeof layoutWorksheet>[number],sheet:HTMLElement){
    const texts=Array.from(sheet.querySelectorAll<SVGTextElement>('svg text'));
    const textOps=page.ops.filter(op=>op.t==='text');
    texts.forEach((node,i)=>{
      const op=textOps[i];if(!op||op.t!=='text')return;
      const id=fieldAt(pageIndex,op.x,op.y);
      if(!id)return;
      const field=fieldInfo[id];
      node.classList.add('ws-print-editable');
      node.setAttribute('tabindex','0');
      node.setAttribute('role','button');
      node.setAttribute('aria-label','Edit '+field.label);
      node.addEventListener('click',()=>editPrintedText(node,field));
      node.addEventListener('keydown',event=>{
        if(event.key==='Enter'||event.key===' '){event.preventDefault();editPrintedText(node,field)}
      });
    });
  }

  // A preset fills "when" and "finished", unless they've been changed from the last preset's wording.
  let last: { when: string; done: string } = { when: when.value, done: done.value };
  preset.addEventListener('change', () => {
    const isCustom = preset.value === 'custom';
    $('ws-custom-wrap').hidden = !isCustom;
    if (isCustom) {
      when.value = '';
      done.value = '';
      last = { when: '', done: '' };
      custom.focus();
    } else {
      const p = JOB_PRESETS[Number(preset.value)];
      when.value = p.when;
      done.value = p.done;
      last = { when: p.when, done: p.done };
    }
    refreshPlanTheme();update();
  });
  const adultJob = $<HTMLSelectElement>('ws-adult-job');
  const adultCustom = $<HTMLInputElement>('ws-adult-custom');

  const adultCatalog: Record<string,{when:string;steps:string}> = {
    'Own the school communications and forms':{when:'Check each school day and follow up before deadlines',steps:'Check school messages and deadlines. Handle forms and responses. Add important dates to the family calendar.'},
    'Plan and manage weekday dinners':{when:'Plan once a week and manage each assigned dinner',steps:'Choose the meals. Prepare or arrange the ingredients. Manage serving and cleanup.'},
    'Manage family appointments and transportation':{when:'Review the coming week each Sunday',steps:'Review upcoming appointments and commitments. Confirm transportation and rides. Update the family calendar.'},
    'Own household supplies and restocking':{when:'Check supplies once a week',steps:'Notice which essentials are low. Make the restocking list. Buy or arrange replacements.'},
    'Manage the weekly laundry system':{when:'On the family laundry days',steps:'Gather and sort loads. Run and dry the laundry. Make sure clean clothes get put away.'},
  };
  const jobSelections = () => [adultJob.value === 'custom' ? adultCustom.value : adultJob.value,preset.value==='custom'? custom.value : JOB_PRESETS[Number(preset.value)].job,child2.value==='custom'?child2Custom.value:JOB_PRESETS[Number(child2.value)].job];
  let originalJobs:string[]=[];
  function refreshPlanTheme(){
    const current=jobSelections();
    const matched=current.every((job,i)=>job===originalJobs[i]);
    const key=sample.value as keyof typeof sampleProfiles;
    const p=sampleProfiles[key];
    ($<HTMLInputElement>('ws-plan-title')).value=matched?p.title:'Our Family Ownership Plan';
    ($<HTMLInputElement>('ws-plan-goal')).value=matched?p.goal:'Everyone knows their whole job, when to do it, and what finished means.';
  }
  adultJob.addEventListener('change', () => {
    adultCustom.hidden = adultJob.value !== 'custom';
    if (!adultCustom.hidden) { adultCustom.focus(); ($<HTMLTextAreaElement>('ws-adult-steps')).value=''; ($<HTMLInputElement>('ws-adult-when')).value=''; }
    else {const d=adultCatalog[adultJob.value];if(d){($<HTMLTextAreaElement>('ws-adult-steps')).value=d.steps;($<HTMLInputElement>('ws-adult-when')).value=d.when;}}
    refreshPlanTheme();update();
  });
  form.addEventListener('input',()=>{refreshPlanTheme();update();});
  child2.addEventListener('change',()=> {
    child2Custom.hidden = child2.value !== 'custom';
    const selected=child2.value==='custom'?null:JOB_PRESETS[Number(child2.value)];
    if(!selected) {($<HTMLInputElement>('ws-child2-when')).value='';($<HTMLTextAreaElement>('ws-child2-done')).value='';child2Custom.focus();}
    if(selected) $('ws-child2-when').setAttribute('value',selected.when);
    if(selected) ($<HTMLInputElement>('ws-child2-when')).value=selected.when;
    if(selected) ($<HTMLTextAreaElement>('ws-child2-done')).value=selected.done;
    refreshPlanTheme();update();
  });
  // Keep the PDF form as the single data source while locating each editor below its owner.
  // Form-associated controls outside the form still appear in form.elements.
  const inlineEditors = new Map<string,HTMLElement>();
  const editorGroups: Record<string,string> = {mom:'ws-mom-fields',adult:'ws-adult-fields',child1:'ws-child1-fields',child2:'ws-child2-fields'};
  Object.entries(editorGroups).forEach(([role,id])=>{
    const article=document.querySelector<HTMLElement>(`.ws-rec:has([data-edit="${role}"])`);
    const group=$<HTMLFieldSetElement>(id);
    if(!article)return;
    const panel=document.createElement('div');
    panel.className='ws-inline-editor';
    panel.id=`ws-inline-${role}`;
    panel.hidden=true;
    panel.appendChild(group);
    group.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('input, textarea, select').forEach(control=>control.setAttribute('form','ws-form'));
    const doneButton=document.createElement('button');
    doneButton.type='button';
    doneButton.className='ws-inline-done';
    doneButton.textContent='Done';
    doneButton.addEventListener('click',()=>toggleInlineEditor(role));
    panel.appendChild(doneButton);
    article.appendChild(panel);
    inlineEditors.set(role,panel);
    const edit=article.querySelector<HTMLButtonElement>('.ws-edit');
    edit?.setAttribute('aria-expanded','false');
    edit?.setAttribute('aria-controls',panel.id);
  });
  function closeInlineEditors(){
    inlineEditors.forEach((panel,role)=>{
      panel.hidden=true;
      const button=document.querySelector<HTMLButtonElement>(`[data-edit="${role}"]`);
      if(button){button.setAttribute('aria-expanded','false');button.textContent='Edit';}
    });
  }
  function toggleInlineEditor(role:string){
    const panel=inlineEditors.get(role);
    if(!panel)return;
    const opening=panel.hidden;
    closeInlineEditors();
    if(opening){
      panel.hidden=false;
      const button=document.querySelector<HTMLButtonElement>(`[data-edit="${role}"]`);
      if(button){button.setAttribute('aria-expanded','true');button.textContent='Close';}
    }
  }
  document.querySelectorAll<HTMLButtonElement>('.ws-edit').forEach(button=>button.addEventListener('click',()=>toggleInlineEditor(button.dataset.edit??'adult')));
  $('ws-done-editing').addEventListener('click',()=>{closeInlineEditors();update();});
  document.querySelectorAll<HTMLElement>('.ws-inline-editor').forEach(panel=>{
    panel.addEventListener('input',()=>{refreshPlanTheme();update();});
    panel.addEventListener('change',()=>{refreshPlanTheme();update();});
  });
  form.addEventListener('change', update);
  $('ws-two-weeks').addEventListener('click', () => {
    const d = new Date();
    d.setDate(d.getDate() + 14);
    checkIn.value = isoDate(d);
    update();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!fonts || !metrics) return;
    const issue=planIssue();
    if(issue){status.textContent=issue;toggleInlineEditor(issue.startsWith('Complete the existing')?'mom':'adult');return;}
    setBusy(true);
    status.textContent = 'Making your PDF…';
    try {
      const { createWorksheetPdf, worksheetFileName } = await import('../../lib/worksheet/index');
      const values = input();
      const pdf = await createWorksheetPdf(values, fonts, { metrics });
      const url = URL.createObjectURL(new Blob([pdf as BlobPart], { type: 'application/pdf' }));
      const a = Object.assign(document.createElement('a'), { href: url, download: worksheetFileName(values) });
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 60_000);
      status.textContent = 'PDF downloaded. This demo does not submit a mailing.';
    } catch (err) {
      console.error(err);
      status.textContent = 'Something went wrong making the PDF. Please try again.';
    } finally {
      setBusy(false);
    }
  });

  async function start() {
    try {
      const keys = Object.keys(FONT_FILES) as FontKey[];
      const files = await Promise.all(keys.map(async (k) => {
        const res = await fetch(FONT_URL + FONT_FILES[k]);
        if (!res.ok) throw new Error(`font ${k}: ${res.status}`);
        return new Uint8Array(await res.arrayBuffer());
      }));
      fonts = Object.fromEntries(keys.map((k, i) => [k, files[i]])) as FontBytes;
      metrics = createMetrics(fonts);
      // Draw the preview once its faces are ready, so it never shows a fallback font.
      await Promise.all(['400 12px "WS Gelasio"', 'italic 400 12px "WS Gelasio"', 'italic 600 12px "WS Gelasio"', '400 12px "WS Montserrat"', '500 12px "WS Montserrat"', '600 12px "WS Montserrat"'].map((f) => document.fonts.load(f)));
      setBusy(false);
      $('ws-pages').setAttribute('aria-busy', 'false');
      update();
    } catch (err) {
      console.error(err);
      sheets[0].innerHTML = '<p class="ws-loading">The preview couldn’t load. Check your connection and refresh.</p>';
      status.textContent = 'The worksheet couldn’t load. Refresh to try again.';
    }
  }
  applySample('goering');
  start();
</script>

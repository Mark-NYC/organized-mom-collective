---
import {Image} from 'astro:assets';
import morning from '../../../assets/icons/ofc/primary/morning-start.png';
import move from '../../../assets/icons/ofc/primary/move-play.png';
import create from '../../../assets/icons/ofc/primary/create-explore.png';
import lunch from '../../../assets/icons/ofc/primary/lunch-reset.png';
import quiet from '../../../assets/icons/ofc/primary/quiet-time.png';
import free from '../../../assets/icons/ofc/primary/free-afternoon.png';
import evening from '../../../assets/icons/ofc/primary/evening-reset.png';
interface Props {storageKey?:string}
const {storageKey='omc:club:may-summer-rhythm:v1'}=Astro.props;
const blocks=[
 {key:'morning',title:'Morning Start',time:'8:00',desc:'Breakfast · Get dressed · Make beds',icon:morning,tint:'#F8E8B5'},
 {key:'move',title:'Move & Play',time:'9:00',desc:'Outside · Bikes · Park · Backyard',icon:move,tint:'#F4DEA3'},
 {key:'create',title:'Create & Explore',time:'10:30',desc:'Read · Build · Draw · Make',icon:create,tint:'#F0D493'},
 {key:'lunch',title:'Lunch & Reset',time:'12:00',desc:'Eat · Clear dishes · Tidy up',icon:lunch,tint:'#DDEBDB'},
 {key:'quiet',title:'Quiet Time',time:'1:00',desc:'Read · Puzzles · Quiet play',icon:quiet,tint:'#D1E5D6'},
 {key:'free',title:'Free Afternoon',time:'2:00',desc:'Friends · Outings · Free play',icon:free,tint:'#C3DDCF'},
 {key:'evening',title:'Evening Reset',time:'Evening',desc:'Pick up · Wash up · Wind down',icon:evening,tint:'#D1D7EA'},
];
---
<div class="msr" data-msr-key={storageKey}>
 <header class="msr-intro"><a href="/club">← Organized Family Club</a><p class="msr-label">ORGANIZED FAMILY CLUB · MAY 2027</p><h1>Less reminding. <em>More summer freedom.</em></h1><p>A picture-led rhythm kids can check for themselves, prepared for your family and ready for the refrigerator.</p></header>
 <div class="msr-layout">
  <aside class="msr-editor">
   <p class="msr-label">YOUR FAMILY'S SUMMER RHYTHM</p><h2>Ready for the fridge.</h2><p>Your illustrated plan is already made. On desktop, click the words or times on the chart to edit them; hover over a block to move or remove it.</p>
   <label>Kind of summer day<select data-days><option value="home">Mostly at home</option><option value="camp">Camp or a program</option></select></label>
   <fieldset class="msr-structure"><legend>How much structure?</legend>
    <label><input type="radio" name="msr-structure" value="relaxed" /> Relaxed <small>Five broad anchors; no set times</small></label>
    <label><input type="radio" name="msr-structure" value="balanced" checked /> Balanced <small>Seven blocks with flexible times</small></label>
    <label><input type="radio" name="msr-structure" value="structured" /> More structured <small>Seven blocks with specific times</small></label>
   </fieldset>
   <label>Morning starts<select data-start><option value="7">7:00 AM</option><option value="7.5">7:30 AM</option><option value="8" selected>8:00 AM</option><option value="8.5">8:30 AM</option><option value="9">9:00 AM</option><option value="9.5">9:30 AM</option></select></label>
   <label>Quiet time<select data-quiet><option value="independent">Independent play and reading</option><option value="rest">Rest or nap</option><option value="older">Independent recharge</option></select></label>
   <label>Favorite kind of play<select data-play><option value="outdoors">Outdoor play</option><option value="active">Sports and movement</option><option value="creative">Making and creativity</option><option value="mixed">A mix of everything</option></select></label>
   <details class="msr-customize" data-customize>
    <summary>Edit activities on mobile <span>Optional</span></summary>
    <p>These seven blocks are already prepared. Change any title, activity or time, or move a block up or down. Changes appear on the printable immediately.</p>
    <div data-edit-rows class="msr-edit-rows"></div>
   </details>
   <div class="msr-removed" data-removed-container hidden><strong>Removed blocks</strong><div data-removed-actions></div><p>Tap a block to add it back without losing your other changes.</p></div>
   <div class="msr-message"><strong>A reusable rhythm, not a rigid calendar.</strong><p>On camp days, trips, or appointments, follow the anchors that fit. The printed rhythm stays useful even when plans change.</p></div>
   <button type="button" data-print>Print rhythm / Save PDF</button>
   <button type="button" class="msr-download" data-download>Download as image (PNG)</button><button type="button" data-reset class="msr-reset">Restore suggested rhythm</button>
   <p class="msr-note">US Letter · 8.5 × 11 inches · one page. Draft icons are being reviewed before print production.</p>
  </aside>
  <section class="msr-preview" aria-label="May illustrated rhythm board preview">
   <div class="msr-preview-head"><h2>Your summer board</h2><span>One page · US Letter</span></div>
   <div class="msr-stage" data-stage><article class="msr-sheet" data-sheet>
    <div class="msr-sheet-head"><span>ORGANIZED FAMILY CLUB · MAY 2027</span><h2>Our <em>Summer Day</em></h2><p>A little structure. Plenty of freedom.</p></div>
    <div class="msr-family"><span data-family>OUR FAMILY'S SUMMER RHYTHM</span><span data-day-label>A DAY AT HOME</span></div>
    <div class="msr-rows" data-print-rows>
     {blocks.map((b,i)=><div class="msr-row" data-rhythm-key={b.key} style={'--msr-tint:'+b.tint}>
      <div class="msr-icon-box"><Image src={b.icon} alt="" width={70} height={70} loading="eager" class="msr-icon" /></div>
      <div class="msr-row-copy"><h3 data-title contenteditable="true" spellcheck="true" role="textbox" aria-label={`Edit ${b.title} name`}>{b.title}</h3><p data-desc contenteditable="true" spellcheck="true" role="textbox" aria-label={`Edit ${b.title} activities`}>{b.desc}</p></div>
      <span class="msr-time" data-time role="button" tabindex="0" title="Click to change this time" aria-label={`Change ${b.title} time`}>{b.time}</span>
      <div class="msr-row-actions" aria-label={`Edit ${b.title} position`}><button type="button" data-move-up aria-label={`Move ${b.title} earlier`} title="Move earlier">↑</button><button type="button" data-move-down aria-label={`Move ${b.title} later`} title="Move later">↓</button><button type="button" data-remove aria-label={`Remove ${b.title}`} title="Remove block">×</button></div>
     </div>)}
    </div>
    <div class="msr-rule"><span>OUR SUMMER RULE</span><strong>Check the rhythm before asking Mom.</strong><p>Our plans can change. We can still find what's next.</p></div>
    <footer class="msr-foot"><span>ORGANIZED FAMILY CLUB</span><span>OUR SUMMER DAY · MAY</span></footer>
   </article></div>
   <p class="msr-note">Visual proof using the seven supplied draft PNG icons. Artwork still needs approval and cleanup before mailing.</p>
  </section>
 </div>
</div>
<style is:global>
.msr,.msr *{box-sizing:border-box}.msr{font-family:Montserrat,Arial,sans-serif;color:#454a43;max-width:1480px;margin:0 auto;padding:25px clamp(18px,3.5vw,52px) 65px}.msr-intro{max-width:760px;margin:0 0 38px}.msr-intro>a{display:inline-block;font-size:12px;color:inherit;margin-bottom:28px}.msr-label{font-size:10px;font-weight:700;letter-spacing:.16em;color:#62765e}.msr-intro h1{font:400 clamp(37px,4.5vw,60px)/1.12 Georgia,serif;margin:12px 0 16px}.msr-intro h1 em{color:#6b8464}.msr-intro>p:last-child{font-size:15px;line-height:1.7}.msr-layout{display:grid;grid-template-columns:minmax(280px,360px) minmax(0,1fr);gap:clamp(22px,4vw,64px)}.msr-editor{border-top:8px solid #d4dfc4;padding-top:19px}.msr-editor h2{font:italic 29px Georgia,serif;color:#5a7154;margin:12px 0}.msr-editor>p:nth-of-type(2){font-size:13px;line-height:1.65;margin-bottom:23px}.msr-editor label{display:block;border-top:1px solid #dfe5d9;margin-top:16px;padding-top:15px;font-size:12px;font-weight:700}.msr-editor select{display:block;width:100%;min-height:45px;margin-top:8px;padding:8px;border:1px solid #aab6a3;background:white;color:#464d42;font:13px Montserrat,Arial,sans-serif}.msr-message{background:#f1f5ee;margin:25px 0 20px;padding:19px}.msr-message strong{font:400 20px Georgia,serif;color:#506849}.msr-message p{font-size:12px;line-height:1.7;margin:10px 0 0}.msr-editor button[data-print]{display:block;width:100%;border:0;background:#4f654b;color:#fff;padding:16px;cursor:pointer;font-size:12px;font-weight:700}.msr-download{display:block;width:100%;margin-top:10px;background:#fff;color:#4f654b;border:1px solid #9aaf94;min-height:45px;cursor:pointer;font-weight:700;font-size:12px}.msr-download:disabled{opacity:.6;cursor:wait}.msr-reset{display:block;margin:10px auto;background:none;border:0;color:#4c6046;text-decoration:underline;min-height:40px;cursor:pointer;font-size:12px}.msr-note{font-size:11px;line-height:1.6;color:#777}.msr-preview{min-width:0}.msr-preview-head{display:flex;gap:12px;flex-wrap:wrap;justify-content:space-between;align-items:baseline;border-bottom:1px solid #dfe5d9;margin-bottom:20px}.msr-preview-head h2{font:400 26px Georgia,serif}.msr-preview-head span{font-size:12px;color:#777}.msr-stage{position:relative}.msr-sheet{position:absolute;left:0;top:0;width:816px;height:1056px;padding:38px 48px 23px;border:1px solid #e2e7df;box-shadow:0 8px 30px #0002;background:white;color:#464e44;transform:scale(var(--msr-scale,.8));transform-origin:top left;display:flex;flex-direction:column;overflow:hidden}.msr-sheet-head{background:#e4eddc;border-top:9px solid #cbdcbf;min-height:153px;padding:19px 28px}.msr-sheet-head>span{font-size:10px;letter-spacing:.15em;font-weight:700;color:#526849}.msr-sheet-head h2{font:400 50px/1.1 Georgia,serif;color:#3f5a40;margin:10px 0 6px}.msr-sheet-head p{font:italic 17px Georgia,serif;color:#587052;margin:0}.msr-family{display:flex;justify-content:space-between;gap:18px;margin:19px 0 12px;font-size:10px;font-weight:700;letter-spacing:.12em;color:#687866}.msr-rows{display:flex;flex-direction:column;gap:8px}.msr-row{display:grid;grid-template-columns:80px minmax(0,1fr) 144px;align-items:center;gap:12px;min-height:91px;padding:7px 16px 7px 7px;border:1px solid #e4e8e0;border-radius:9px;background:linear-gradient(90deg,var(--msr-tint) 0%,#fff 88%)}.msr-icon-box{width:76px;height:76px;border-radius:8px;background:var(--msr-tint);display:flex;align-items:center;justify-content:center}.msr-icon{width:65px;height:65px;object-fit:contain;display:block;mix-blend-mode:multiply}.msr-row-copy h3{font:400 24px/1.1 Georgia,serif;color:#455644;margin:0 0 7px}.msr-row-copy p{font:12px/1.45 Montserrat,Arial,sans-serif;color:#5d685b;margin:0}.msr-time{font-size:29.4px;font-weight:700;line-height:1;letter-spacing:-.055em;color:#577350;white-space:nowrap;text-align:right;min-width:130px;font-variant-numeric:tabular-nums}.msr-rule{background:#edf3e9;border-radius:7px;margin-top:16px;padding:14px 15px;text-align:center}.msr-rule span{display:block;font-size:9px;letter-spacing:.13em;font-weight:700;color:#687c61}.msr-rule strong{display:block;font:400 22px Georgia,serif;color:#3e5e3f;margin:5px 0}.msr-rule p{margin:0;font-size:11px;color:#647960}.msr-foot{display:flex;justify-content:space-between;border-top:1px solid #dfe6dc;margin-top:auto;padding-top:9px;font-size:9px;letter-spacing:.1em;font-weight:700;color:#687964}


/* Direct editing belongs to the digital preview, never the mailed printable. */
.msr-row{position:relative}
.msr-row-actions{position:absolute;z-index:4;top:-12px;right:8px;display:flex;align-items:center;gap:3px;opacity:0;pointer-events:none;transition:opacity .12s}
.msr-row:hover .msr-row-actions,.msr-row:focus-within .msr-row-actions{opacity:1;pointer-events:auto}
.msr-row-actions button{width:28px;height:28px;padding:0;border:1px solid #afbdab;border-radius:5px;background:#fff;color:#3f5a40;box-shadow:0 1px 4px #0002;font:700 17px Arial,sans-serif;cursor:pointer}
.msr-row-actions button:hover{background:#e6f0e1}
.msr-row-actions button:disabled{opacity:.35;cursor:not-allowed}
.msr-row-copy [contenteditable]{cursor:text;outline-offset:3px;border-radius:3px}
.msr-row-copy [contenteditable]:hover{outline:1px dashed #9baf94}
.msr-row-copy [contenteditable]:focus{outline:2px solid #6f9866;background:#f7faf5}
.msr-time[role=button]{cursor:pointer;border-radius:4px;outline-offset:3px}
.msr-time[role=button]:hover{outline:1px dashed #9baf94}
.msr-time[role=button]:focus{outline:2px solid #6f9866}
.msr-time input[type=time]{width:145px;padding:6px 3px;max-width:none;background:#fff;border:1px solid #83a177;border-radius:4px;color:#3f5a40;font:700 15px Arial,sans-serif}
.msr-removed{border:1px solid #cbd8c5;margin-top:18px;padding:13px 15px;border-radius:6px}
.msr-removed strong{display:block;font:600 12px Montserrat,Arial,sans-serif;color:#52684b;margin-bottom:8px}
.msr-removed [data-removed-actions]{display:flex;flex-wrap:wrap;gap:7px}
.msr-removed button{padding:7px 10px;border:1px solid #b4c5aa;border-radius:18px;background:#f7faf5;color:#3b5839;font-size:11px;cursor:pointer}
.msr-removed p{color:#6b7867;font-size:11px;line-height:1.5;margin:10px 0 0}
.msr-row[hidden]{display:none!important}
.msr-removed[hidden]{display:none!important}
@media(min-width:1081px){.msr-customize{display:none}}
@media(max-width:1080px){.msr-row-actions{display:none}.msr-row-copy [contenteditable]{pointer-events:none}.msr-time[role=button]{pointer-events:none}}
@media print{.msr-row-actions{display:none!important}.msr-row-copy [contenteditable]{outline:none!important;background:transparent!important}.msr-time[role=button]{outline:none!important}}
.msr.msr-exporting .msr-row-actions{display:none!important}
.msr.msr-exporting .msr-row-copy [contenteditable]{outline:none!important;background:transparent!important}

/* May editor: finished product stays central; detailed changes are opt-in. */
.msr-row[hidden]{display:none!important}
.msr.msr-exporting .msr-stage{width:816px!important;height:1056px!important}
.msr.msr-exporting .msr-sheet{transform:none!important;position:relative!important;left:0!important;top:0!important;box-shadow:none!important}
.msr-structure{border:0;border-top:1px solid #dfe5d9;margin:18px 0 8px;padding:13px 0 0;min-width:0}
.msr-structure legend{font-size:12px;font-weight:700;padding:0}
.msr-editor .msr-structure label{border:0;margin:0;padding:8px 0;display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;font-weight:600}
.msr-structure input{width:17px;height:17px;accent-color:#587554;flex:0 0 17px}
.msr-structure small{font-size:10px;line-height:1.35;color:#757f72;font-weight:400;margin-left:auto;text-align:right;max-width:165px}
.msr-customize{border:1px solid #cbd8c5;margin-top:22px;border-radius:6px;background:#fff}
.msr-customize summary{cursor:pointer;padding:15px;font-size:13px;font-weight:700;color:#3d5a3d;list-style-position:inside}
.msr-customize summary span{font-size:11px;font-weight:400;color:#697b68;margin-left:5px}
.msr-customize>p{font-size:12px;line-height:1.6;margin:0;padding:0 15px 12px;color:#6c7468}
.msr-edit-rows{padding:0 12px 12px;display:grid;gap:10px}
.msr-edit-row{border:1px solid #e2e9de;border-radius:5px;padding:10px 12px;background:#fafbf8}
.msr-edit-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px}
.msr-edit-top>span{font-size:11px;font-weight:700;color:#52684b}
.msr-edit-buttons{display:flex;gap:5px}
.msr-edit-buttons button{border:1px solid #c9d6c3;background:#fff;color:#3d5a3d;font-size:13px;min-width:32px;min-height:32px;cursor:pointer}
.msr-edit-buttons button:disabled{opacity:.3;cursor:default}
.msr-editor .msr-edit-row label{border:0;margin:0 0 7px;padding:0;font-weight:600;font-size:10px}
.msr-edit-row input{display:block;width:100%;border:1px solid #cbd7c4;border-radius:3px;padding:8px;font:12px Montserrat,Arial,sans-serif;color:#404a3e;margin-top:4px;min-height:36px}
.msr-edit-row .msr-edit-clock{width:120px}
.msr[data-msr-structure="relaxed"] .msr-time{display:none}
.msr[data-msr-structure="relaxed"] .msr-row{min-height:100px}
.msr[data-msr-structure="relaxed"] .msr-rows{gap:15px}
.msr[data-msr-structure="structured"] .msr-time{font-weight:800}
@media(max-width:1080px){.msr-preview{order:0}.msr-editor{order:1}.msr-layout{display:flex;flex-direction:column}}
@media print{.msr-edit-rows,.msr-customize,.msr-editor{visibility:hidden!important}}

@media(max-width:1080px){.msr-layout{grid-template-columns:1fr}.msr-editor{max-width:720px}}
@page{size:letter portrait;margin:0}
@media print{html,body{margin:0!important;padding:0!important;background:#fff!important}body *{visibility:hidden!important}.msr-stage,.msr-sheet,.msr-sheet *{visibility:visible!important}.msr-stage{position:absolute!important;top:0!important;left:0!important;width:8.5in!important;height:11in!important}.msr-sheet{position:absolute!important;top:0!important;left:0!important;width:8.5in!important;height:11in!important;border:0!important;box-shadow:none!important;transform:none!important;print-color-adjust:exact!important;-webkit-print-color-adjust:exact!important}.msr-icon{mix-blend-mode:normal!important}}
</style>
<script>
import {ageInMonth} from '../../lib/club/profile';
type Person={firstName:string;kind:'adult'|'child';birthYear?:number;birthMonth?:number;archived?:boolean};
type Quiet='independent'|'rest'|'older';
type Play='outdoors'|'active'|'creative'|'mixed';
type Structure='relaxed'|'balanced'|'structured';
type Days='home'|'camp';
type Key='morning'|'move'|'create'|'lunch'|'quiet'|'free'|'evening';
type Edit={title?:string;desc?:string;time?:string};
type Options={start:number;quiet:Quiet;play:Play;structure:Structure;days:Days};
const keys:Key[]=['morning','move','create','lunch','quiet','free','evening'];
const labels:Record<Key,string>={morning:'Morning Start',move:'Move & Play',create:'Create & Explore',lunch:'Lunch & Reset',quiet:'Quiet Time',free:'Free Afternoon',evening:'Evening Reset'};
const baseDesc:Record<Key,string>={
 morning:'Breakfast · Get dressed · Make beds',
 move:'Outside · Bikes · Park · Backyard',
 create:'Read · Build · Draw · Make',
 lunch:'Eat · Clear dishes · Tidy up',
 quiet:'Read · Puzzles · Quiet play',
 free:'Friends · Outings · Free play',
 evening:'Pick up · Wash up · Wind down'
};
const defaults:Options={start:8,quiet:'independent',play:'outdoors',structure:'balanced',days:'home'};
const hhmm=(n:number)=>{const normalized=(n+24)%24;const h=Math.floor(normalized);const min=Math.round((normalized-h)*60);return String(h).padStart(2,'0')+':'+String(min).padStart(2,'0')};
const clock=(time:string)=>{if(!time)return 'Evening';const [hour,min]=time.split(':').map(Number);return String(hour%12||12)+':'+String(min).padStart(2,'0')};
for(const root of document.querySelectorAll<HTMLElement>('.msr')){
 const storageKey=root.dataset.msrKey??'omc:preview:may:v2';
 let profile='';
 let options:Options={...defaults};
 let edits:Partial<Record<Key,Edit>>={};
 let order:Key[]=[...keys];
 let removed:Key[]=[];
 let children:Person[]=[];
 let familyLabel="OUR FAMILY'S SUMMER RHYTHM";
 const stage=root.querySelector<HTMLElement>('[data-stage]');
 const sheet=root.querySelector<HTMLElement>('[data-sheet]');
 const list=root.querySelector<HTMLElement>('[data-print-rows]');
 const editor=root.querySelector<HTMLElement>('[data-edit-rows]');
 const nodes=new Map<Key,HTMLElement>();
 list?.querySelectorAll<HTMLElement>('[data-rhythm-key]').forEach(el=>{const key=el.dataset.rhythmKey as Key;if(keys.includes(key))nodes.set(key,el)});
 const fit=()=>{
  if(!stage||!sheet)return;
  const width=Math.max(200,(stage.parentElement?.clientWidth??816)-4);
  const scale=Math.min(1,width/816);
  stage.style.width=String(816*scale)+'px';
  stage.style.height=String(1056*scale)+'px';
  sheet.style.setProperty('--msr-scale',String(scale));
 };
 fit();
 const parent=stage?.parentElement;
 if(parent&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(parent);
 window.addEventListener('resize',fit);
 const ageDefaults=()=>{
  const ages=children.map(p=>ageInMonth(p.birthYear??2027,p.birthMonth,'2027-05'));
  const quiet:Quiet=ages.length&&Math.min(...ages)<5?'rest':ages.length&&Math.min(...ages)>11?'older':'independent';
  options={...defaults,quiet};
  edits={};
  order=[...keys];
  removed=[];
 };
 const starter=(key:Key):Required<Edit>=>{
  let title=labels[key],desc=baseDesc[key];
  const idx=keys.indexOf(key);
  const offset=[0,1,2.5,4,5,6,10][idx];
  let time=key==='evening'?'':hhmm(options.start+offset);
  if(options.days==='camp'){
   const names:Partial<Record<Key,[string,string]>>={
    move:['Pack & Head Out','Pack bag · Water bottle · Shoes'],
    create:['Camp or Program','Play · Learn · Explore · Friends'],
    lunch:['Lunch & Reset','Lunch · Pack things · Tidy up'],
    quiet:['Recharge','Snack · Quiet time · Rest'],
    free:['After-Camp Play','Outside · Friends · Free time']
   };
   if(names[key]){title=names[key]![0];desc=names[key]![1]}
   const campOffsets=[0,.5,1,4,7.5,8.5,10];
   time=key==='evening'?'':hhmm(options.start+campOffsets[idx]);
  }else{
   if(key==='quiet')desc=options.quiet==='rest'?'Nap · Rest · Quiet books':options.quiet==='older'?'Read · Recharge · Independent time':'Read · Puzzles · Quiet play';
   if(key==='move')desc=options.play==='active'?'Ball games · Movement · Outdoors':options.play==='creative'?'Explore · Move · Make something':options.play==='mixed'?'Get moving · Choose how to play':baseDesc.move;
   if(key==='free')desc=options.play==='creative'?'Art · Make · Friends · Free play':options.play==='active'?'Friends · Sports · Free play':baseDesc.free;
  }
  return {title,desc,time};
 };
 const resolved=(key:Key):Required<Edit>=>({...starter(key),...(edits[key]??{})});
 const save=()=>{try{sessionStorage.setItem(storageKey,JSON.stringify({profile,options,edits,order,removed}))}catch{}};
 const renderEditor=()=>{
  if(!editor)return;
  editor.replaceChildren();
  for(const [i,key] of order.entries()){
   const values=resolved(key);
   const wrapper=document.createElement('div');wrapper.className='msr-edit-row';
   const top=document.createElement('div');top.className='msr-edit-top';
   const name=document.createElement('span');name.textContent=String(i+1)+'. '+labels[key];
   const buttons=document.createElement('div');buttons.className='msr-edit-buttons';
   for(const dir of [-1,1]){
    const button=document.createElement('button');button.type='button';button.textContent=dir<0?'↑':'↓';button.title=dir<0?'Move earlier':'Move later';
    button.setAttribute('aria-label',(dir<0?'Move ':'Move ')+labels[key]+(dir<0?' earlier':' later'));
    button.disabled=dir<0?i===0:i===order.length-1;
    button.addEventListener('click',()=>{const j=order.indexOf(key),next=j+dir;if(next<0||next>=order.length)return;[order[j],order[next]]=[order[next],order[j]];save();render(true)});
    buttons.append(button);
   }
   const removeButton=document.createElement('button');removeButton.type='button';removeButton.textContent='×';removeButton.title='Remove block';removeButton.setAttribute('aria-label','Remove '+labels[key]);removeButton.disabled=order.length<=1;
   removeButton.addEventListener('click',()=>removeBlock(key));
   buttons.append(removeButton);
   top.append(name,buttons);wrapper.append(top);
   const fields:[keyof Edit,string,number][]=[['title','Block name',38],['desc','Activity examples',78],['time','Start time (optional)',5]];
   for(const [field,labelText,max] of fields){
    const label=document.createElement('label');label.textContent=labelText;
    const input=document.createElement('input');input.type=field==='time'?'time':'text';
    input.maxLength=max;input.value=values[field];input.setAttribute('aria-label',labels[key]+' — '+labelText);
    if(field==='time')input.className='msr-edit-clock';
    input.addEventListener('input',()=>{
      const raw=input.value;const clean=field==='time'?raw:raw.slice(0,max);
      edits[key]={...(edits[key]??{}),[field]:clean};
      save();render(false);
    });
    label.append(input);wrapper.append(label);
   }
   editor.append(wrapper);
  }
 };
 const renderRemoved=()=>{
  const container=root.querySelector<HTMLElement>('[data-removed-container]');
  const actions=root.querySelector<HTMLElement>('[data-removed-actions]');
  if(!container||!actions)return;
  container.hidden=removed.length===0;actions.replaceChildren();
  for(const key of removed){
   const button=document.createElement('button');button.type='button';button.textContent='+ '+labels[key];
   button.setAttribute('aria-label','Restore '+labels[key]);
   button.addEventListener('click',()=>{removed=removed.filter(k=>k!==key);order.push(key);update()});
   actions.append(button);
  }
 };
 const removeBlock=(key:Key)=>{
  if(!order.includes(key)||order.length<=1)return;
  order=order.filter(k=>k!==key);removed.push(key);
  update();
 };
 const moveBlock=(key:Key,dir:number)=>{
  const i=order.indexOf(key),next=i+dir;
  if(i<0||next<0||next>=order.length)return;
  [order[i],order[next]]=[order[next],order[i]];update();
 };
 const render=(buildEditor=false)=>{
  root.dataset.msrStructure=options.structure;
  root.dataset.msrDays=options.days;
  const family=root.querySelector<HTMLElement>('[data-family]');if(family)family.textContent=familyLabel;
  const dayLabel=root.querySelector<HTMLElement>('[data-day-label]');if(dayLabel)dayLabel.textContent=options.days==='camp'?'CAMP / PROGRAM DAY':'A DAY AT HOME';
  const visible=options.structure==='relaxed'?order.filter(k=>k!=='create'&&k!=='free'):order;
  for(const key of order){
   const node=nodes.get(key);if(!node||!list)continue;
   list.append(node);
   node.hidden=!visible.includes(key);
   const v=resolved(key);
   const title=node.querySelector<HTMLElement>('[data-title]');if(title)title.textContent=v.title;
   const desc=node.querySelector<HTMLElement>('[data-desc]');if(desc)desc.textContent=v.desc;
   const time=node.querySelector<HTMLElement>('[data-time]');if(time)time.textContent=clock(v.time);
   if(time)time.hidden=options.structure==='relaxed'||!v.time;
   node.querySelector<HTMLButtonElement>('[data-move-up]')?.toggleAttribute('disabled',order.indexOf(key)===0);
   node.querySelector<HTMLButtonElement>('[data-move-down]')?.toggleAttribute('disabled',order.indexOf(key)===order.length-1);
   node.querySelector<HTMLButtonElement>('[data-remove]')?.toggleAttribute('disabled',order.length<=1);
  }
  const day=root.querySelector<HTMLSelectElement>('[data-days]');if(day)day.value=options.days;
  const start=root.querySelector<HTMLSelectElement>('[data-start]');if(start)start.value=String(options.start);
  const quiet=root.querySelector<HTMLSelectElement>('[data-quiet]');if(quiet)quiet.value=options.quiet;
  const play=root.querySelector<HTMLSelectElement>('[data-play]');if(play)play.value=options.play;
  root.querySelectorAll<HTMLInputElement>('input[name="msr-structure"]').forEach(el=>{el.checked=el.value===options.structure});
  for(const key of keys){const node=nodes.get(key);if(node&&!order.includes(key))node.hidden=true}
  renderRemoved();
  if(buildEditor)renderEditor();
 };
 const update=()=>{save();render(true)};
 root.querySelector<HTMLSelectElement>('[data-days]')?.addEventListener('change',e=>{
  options.days=(e.target as HTMLSelectElement).value as Days;
  // The parent's custom words are preserved when changing day types.
  update();
 });
 root.querySelectorAll<HTMLInputElement>('input[name="msr-structure"]').forEach(el=>el.addEventListener('change',()=>{
  if(el.checked){options.structure=el.value as Structure;update()}
 }));
 root.querySelector<HTMLSelectElement>('[data-start]')?.addEventListener('change',e=>{options.start=Number((e.target as HTMLSelectElement).value);update()});
 root.querySelector<HTMLSelectElement>('[data-quiet]')?.addEventListener('change',e=>{options.quiet=(e.target as HTMLSelectElement).value as Quiet;update()});
 root.querySelector<HTMLSelectElement>('[data-play]')?.addEventListener('change',e=>{options.play=(e.target as HTMLSelectElement).value as Play;update()});
 root.querySelector('[data-reset]')?.addEventListener('click',()=>{ageDefaults();update()});
 for(const key of keys){
  const node=nodes.get(key);if(!node)continue;
  node.querySelector<HTMLButtonElement>('[data-move-up]')?.addEventListener('click',()=>moveBlock(key,-1));
  node.querySelector<HTMLButtonElement>('[data-move-down]')?.addEventListener('click',()=>moveBlock(key,1));
  node.querySelector<HTMLButtonElement>('[data-remove]')?.addEventListener('click',()=>removeBlock(key));
  for(const [selector,field,limit] of [['[data-title]','title',38],['[data-desc]','desc',78]] as const){
   const el=node.querySelector<HTMLElement>(selector);
   el?.addEventListener('input',()=>{
    const text=(el.textContent??'').replace(/\s+/g,' ').slice(0,limit);
    edits[key]={...(edits[key]??{}),[field]:text};save();
   });
   el?.addEventListener('blur',()=>{const text=(el.textContent??'').replace(/\s+/g,' ').trim().slice(0,limit);
    edits[key]={...(edits[key]??{}),[field]:text};update()});
   el?.addEventListener('keydown',(e:KeyboardEvent)=>{if(e.key==='Enter'){e.preventDefault();el.blur()}});
  }
  const time=node.querySelector<HTMLElement>('[data-time]');
  const editTime=()=>{
   if(!time||time.querySelector('input'))return;
   const input=document.createElement('input');input.type='time';input.value=resolved(key).time;
   input.setAttribute('aria-label','Set '+labels[key]+' time');
   time.replaceChildren(input);time.setAttribute('role','group');
   const finish=()=>{const value=input.value;edits[key]={...(edits[key]??{}),time:value};time.setAttribute('role','button');update()};
   input.addEventListener('change',finish,{once:true});
   input.addEventListener('blur',()=>{if(time.contains(input))finish()},{once:true});
   input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();input.blur()}if(e.key==='Escape'){e.preventDefault();time.setAttribute('role','button');render()}});
   input.focus();
  };
  time?.addEventListener('click',editTime);
  time?.addEventListener('keydown',e=>{if(e.target===time&&(e.key==='Enter'||e.key===' ')){e.preventDefault();editTime()}});
 }
 root.querySelector('[data-print]')?.addEventListener('click',()=>window.print());
 const download=root.querySelector<HTMLButtonElement>('[data-download]');
 download?.addEventListener('click',async()=>{
  if(!sheet||!download)return;
  const prior=download.textContent;
  download.disabled=true;download.textContent='Preparing image…';
  root.classList.add('msr-exporting');
  try{
   await Promise.all(Array.from(sheet.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));
   const {toPng}=await import('html-to-image');
   const url=await toPng(sheet,{pixelRatio:2,width:816,height:1056,backgroundColor:'#ffffff'});
   const anchor=document.createElement('a');anchor.download='our-summer-day.png';anchor.href=url;anchor.click();
  }catch(err){console.error('Summer rhythm PNG export failed',err);alert('Sorry, the image could not be saved. You can still use Print / Save PDF.')}
  finally{root.classList.remove('msr-exporting');download.disabled=false;download.textContent=prior}
 });
 window.addEventListener('omc:club-preview-household',(event:Event)=>{
  const detail=(event as CustomEvent<{household:{id:string;displayName?:string;members:Person[]};sample?:string}>).detail;
  if(!detail?.household)return;
  const nextProfile=(detail.sample??'account')+':'+detail.household.id;
  const changed=profile!==nextProfile;
  profile=nextProfile;
  children=detail.household.members.filter(p=>!p.archived&&p.kind==='child');
  const name=(detail.household.displayName??'').trim();
  familyLabel=name?name.toUpperCase()+' · SUMMER RHYTHM':"OUR FAMILY'S SUMMER RHYTHM";
  if(changed){
   ageDefaults();
   try{
    const stored=JSON.parse(sessionStorage.getItem(storageKey)??'null');
    if(stored?.profile===profile&&stored.options){
     const o=stored.options;
     if([7,7.5,8,8.5,9,9.5].includes(o.start))options.start=o.start;
     if(['independent','rest','older'].includes(o.quiet))options.quiet=o.quiet;
     if(['outdoors','active','creative','mixed'].includes(o.play))options.play=o.play;
     if(['home','camp'].includes(o.days))options.days=o.days;
     if(['relaxed','balanced','structured'].includes(o.structure))options.structure=o.structure;
     const savedOrder=stored.order;
     if(Array.isArray(savedOrder)&&savedOrder.length>=1&&savedOrder.length<=keys.length&&new Set(savedOrder).size===savedOrder.length&&savedOrder.every(k=>keys.includes(k)))order=savedOrder;
     if(Array.isArray(stored.removed)&&new Set(stored.removed).size===stored.removed.length&&stored.removed.every((k:Key)=>keys.includes(k))&&stored.removed.length+order.length===keys.length&&stored.removed.every((k:Key)=>!order.includes(k)))removed=stored.removed;
     else if(order.length<keys.length)removed=keys.filter(k=>!order.includes(k));
     if(stored.edits&&typeof stored.edits==='object'){
      for(const key of keys){
       const obj=stored.edits[key];if(!obj||typeof obj!=='object')continue;
       const edit:Edit={};
       if(typeof obj.title==='string')edit.title=obj.title.slice(0,38);
       if(typeof obj.desc==='string')edit.desc=obj.desc.slice(0,78);
       if(typeof obj.time==='string'&&(/^([01]\d|2[0-3]):[0-5]\d$/.test(obj.time)||obj.time===''))edit.time=obj.time;
       edits[key]=edit;
      }
     }
    }
   }catch{}
  }
  update();
 });
 render(true);
}
</script>
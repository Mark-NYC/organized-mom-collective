</style>
<script>
import {ageInMonth} from '../../lib/club/profile';
type Person={firstName:string;kind:'adult'|'child';birthYear?:number;birthMonth?:number;archived?:boolean};
type Quiet='independent'|'rest'|'older';
type Play='outdoors'|'active'|'creative'|'mixed';
type Structure='relaxed'|'balanced'|'structured';
type Days='home'|'camp';
type Key='morning'|'move'|'create'|'lunch'|'quiet'|'free'|'evening';
type Edit={title?:string;desc?:string;time?:string};
type Options={start:number;quiet:Quiet;play:Play;structure:Structure;days:Days};
const keys:Key[]=['morning','move','create','lunch','quiet','free','evening'];
const labels:Record<Key,string>={morning:'Morning Start',move:'Move & Play',create:'Create & Explore',lunch:'Lunch & Reset',quiet:'Quiet Time',free:'Free Afternoon',evening:'Evening Reset'};
const baseDesc:Record<Key,string>={
 morning:'Breakfast · Get dressed · Make beds',
 move:'Outside · Bikes · Park · Backyard',
 create:'Read · Build · Draw · Make',
 lunch:'Eat · Clear dishes · Tidy up',
 quiet:'Read · Puzzles · Quiet play',
 free:'Friends · Outings · Free play',
 evening:'Pick up · Wash up · Wind down'
};
const defaults:Options={start:8,quiet:'independent',play:'outdoors',structure:'balanced',days:'home'};
const hhmm=(n:number)=>{const normalized=(n+24)%24;const h=Math.floor(normalized);const min=Math.round((normalized-h)*60);return String(h).padStart(2,'0')+':'+String(min).padStart(2,'0')};
const clock=(time:string)=>{if(!time)return 'Evening';const [hour,min]=time.split(':').map(Number);return String(hour%12||12)+':'+String(min).padStart(2,'0')+(hour<12?' AM':' PM')};
for(const root of document.querySelectorAll<HTMLElement>('.msr')){
 const storageKey=root.dataset.msrKey??'omc:preview:may:v2';
 let profile='';
 let options:Options={...defaults};
 let edits:Partial<Record<Key,Edit>>={};
 let order:Key[]=[...keys];
 let removed:Key[]=[];
 let children:Person[]=[];
 let familyLabel="OUR FAMILY'S SUMMER RHYTHM";
 const stage=root.querySelector<HTMLElement>('[data-stage]');
 const sheet=root.querySelector<HTMLElement>('[data-sheet]');
 const list=root.querySelector<HTMLElement>('[data-print-rows]');
 const editor=root.querySelector<HTMLElement>('[data-edit-rows]');
 const nodes=new Map<Key,HTMLElement>();
 list?.querySelectorAll<HTMLElement>('[data-rhythm-key]').forEach(el=>{const key=el.dataset.rhythmKey as Key;if(keys.includes(key))nodes.set(key,el)});
 const fit=()=>{
  if(!stage||!sheet)return;
  const width=Math.max(200,(stage.parentElement?.clientWidth??816)-4);
  const scale=Math.min(1,width/816);
  stage.style.width=String(816*scale)+'px';
  stage.style.height=String(1056*scale)+'px';
  sheet.style.setProperty('--msr-scale',String(scale));
 };
 fit();
 const parent=stage?.parentElement;
 if(parent&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(parent);
 window.addEventListener('resize',fit);
 const ageDefaults=()=>{
  const ages=children.map(p=>ageInMonth(p.birthYear??2027,p.birthMonth,'2027-05'));
  const quiet:Quiet=ages.length&&Math.min(...ages)<5?'rest':ages.length&&Math.min(...ages)>11?'older':'independent';
  options={...defaults,quiet};
  edits={};
  order=[...keys];
  removed=[];
 };
 const starter=(key:Key):Required<Edit>=>{
  let title=labels[key],desc=baseDesc[key];
  const idx=keys.indexOf(key);
  const offset=[0,1,2.5,4,5,6,10][idx];
  let time=key==='evening'?'':hhmm(options.start+offset);
  if(options.days==='camp'){
   const names:Partial<Record<Key,[string,string]>>={
    move:['Pack & Head Out','Pack bag · Water bottle · Shoes'],
    create:['Camp or Program','Play · Learn · Explore · Friends'],
    lunch:['Lunch & Reset','Lunch · Pack things · Tidy up'],
    quiet:['Recharge','Snack · Quiet time · Rest'],
    free:['After-Camp Play','Outside · Friends · Free time']
   };
   if(names[key]){title=names[key]![0];desc=names[key]![1]}
   const campOffsets=[0,.5,1,4,7.5,8.5,10];
   time=key==='evening'?'':hhmm(options.start+campOffsets[idx]);
  }else{
   if(key==='quiet')desc=options.quiet==='rest'?'Nap · Rest · Quiet books':options.quiet==='older'?'Read · Recharge · Independent time':'Read · Puzzles · Quiet play';
   if(key==='move')desc=options.play==='active'?'Ball games · Movement · Outdoors':options.play==='creative'?'Explore · Move · Make something':options.play==='mixed'?'Get moving · Choose how to play':baseDesc.move;
   if(key==='free')desc=options.play==='creative'?'Art · Make · Friends · Free play':options.play==='active'?'Friends · Sports · Free play':baseDesc.free;
  }
  return {title,desc,time};
 };
 const resolved=(key:Key):Required<Edit>=>({...starter(key),...(edits[key]??{})});
 const visionDialog=root.querySelector<HTMLDialogElement>('[data-vision-dialog]');
 const editorDialog=root.querySelector<HTMLDialogElement>('[data-editor-dialog]');
 root.querySelector('[data-open-vision]')?.addEventListener('click',()=>visionDialog?.showModal());
 root.querySelectorAll('[data-open-editor]').forEach(button=>button.addEventListener('click',()=>editorDialog?.showModal()));
 root.querySelectorAll('[data-close-modal]').forEach(button=>button.addEventListener('click',()=>button.closest('dialog')?.close()));
 for(const dialog of [visionDialog,editorDialog])dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});
 const save=()=>{try{sessionStorage.setItem(storageKey,JSON.stringify({profile,options,edits,order,removed}))}catch{}};
 const renderEditor=()=>{
  if(!editor)return;
  editor.replaceChildren();
  for(const [i,key] of order.entries()){
   const values=resolved(key);
   const wrapper=document.createElement('div');wrapper.className='msr-edit-row';
   const top=document.createElement('div');top.className='msr-edit-top';
   const name=document.createElement('span');name.textContent=String(i+1)+'. '+labels[key];
   const buttons=document.createElement('div');buttons.className='msr-edit-buttons';
   for(const dir of [-1,1]){
    const button=document.createElement('button');button.type='button';button.textContent=dir<0?'↑':'↓';button.title=dir<0?'Move earlier':'Move later';
    button.setAttribute('aria-label',(dir<0?'Move ':'Move ')+labels[key]+(dir<0?' earlier':' later'));
    button.disabled=dir<0?i===0:i===order.length-1;
    button.addEventListener('click',()=>{const j=order.indexOf(key),next=j+dir;if(next<0||next>=order.length)return;[order[j],order[next]]=[order[next],order[j]];save();render(true)});
    buttons.append(button);
   }
   const removeButton=document.createElement('button');removeButton.type='button';removeButton.textContent='×';removeButton.title='Remove block';removeButton.setAttribute('aria-label','Remove '+labels[key]);removeButton.disabled=order.length<=1;
   removeButton.addEventListener('click',()=>removeBlock(key));
   buttons.append(removeButton);
   top.append(name,buttons);wrapper.append(top);
   const fields:[keyof Edit,string,number][]=[['title','Block name',38],['desc','Activity examples',78],['time','Start time (optional)',5]];
   for(const [field,labelText,max] of fields){
    const label=document.createElement('label');label.textContent=labelText;
    const input=document.createElement('input');input.type=field==='time'?'time':'text';
    input.maxLength=max;input.value=values[field];input.setAttribute('aria-label',labels[key]+' — '+labelText);
    if(field==='time')input.className='msr-edit-clock';
    input.addEventListener('input',()=>{
      const raw=input.value;const clean=field==='time'?raw:raw.slice(0,max);
      edits[key]={...(edits[key]??{}),[field]:clean};
      save();render(false);
    });
    label.append(input);wrapper.append(label);
   }
   editor.append(wrapper);
  }
 };
 const renderRemoved=()=>{
  const container=root.querySelector<HTMLElement>('[data-removed-container]');
  const actions=root.querySelector<HTMLElement>('[data-removed-actions]');
  if(!container||!actions)return;
  container.hidden=removed.length===0;actions.replaceChildren();
  for(const key of removed){
   const button=document.createElement('button');button.type='button';button.textContent='+ '+labels[key];
   button.setAttribute('aria-label','Restore '+labels[key]);
   button.addEventListener('click',()=>{removed=removed.filter(k=>k!==key);order.push(key);update()});
   actions.append(button);
  }
 };
 const removeBlock=(key:Key)=>{
  if(!order.includes(key)||order.length<=1)return;
  order=order.filter(k=>k!==key);removed.push(key);
  update();
 };
 const moveBlock=(key:Key,dir:number)=>{
  const i=order.indexOf(key),next=i+dir;
  if(i<0||next<0||next>=order.length)return;
  [order[i],order[next]]=[order[next],order[i]];update();
 };
 const render=(buildEditor=false)=>{
  root.dataset.msrStructure=options.structure;
  root.dataset.msrDays=options.days;
  const family=root.querySelector<HTMLElement>('[data-family]');if(family)family.textContent=familyLabel;
  const dayLabel=root.querySelector<HTMLElement>('[data-day-label]');if(dayLabel)dayLabel.textContent=options.days==='camp'?'CAMP / PROGRAM DAY':'A DAY AT HOME';
  const visible=options.structure==='relaxed'?order.filter(k=>k!=='create'&&k!=='free'):order;
  for(const key of order){
   const node=nodes.get(key);if(!node||!list)continue;
   list.append(node);
   node.hidden=!visible.includes(key);
   const v=resolved(key);
   const title=node.querySelector<HTMLElement>('[data-title]');if(title)title.textContent=v.title;
   const desc=node.querySelector<HTMLElement>('[data-desc]');if(desc)desc.textContent=v.desc;
   const time=node.querySelector<HTMLElement>('[data-time]');if(time){const formatted=clock(v.time);const match=formatted.match(/^(.*?)( AM| PM)$/);time.replaceChildren(document.createTextNode(match?match[1]:formatted));if(match){const suffix=document.createElement('span');suffix.className='msr-meridiem';suffix.textContent=match[2];time.append(suffix)}}
   if(time)time.hidden=options.structure==='relaxed'||!v.time;
   node.querySelector<HTMLButtonElement>('[data-move-up]')?.toggleAttribute('disabled',order.indexOf(key)===0);
   node.querySelector<HTMLButtonElement>('[data-move-down]')?.toggleAttribute('disabled',order.indexOf(key)===order.length-1);
   node.querySelector<HTMLButtonElement>('[data-remove]')?.toggleAttribute('disabled',order.length<=1);
  }
  const summaries:[string,string][]=[['days',options.days==='camp'?'Camp or program':'Mostly at home'],['structure',options.structure==='relaxed'?'Relaxed':options.structure==='structured'?'More structured':'Balanced'],['start',clock(hhmm(options.start))],['quiet',options.quiet==='rest'?'Rest or nap':options.quiet==='older'?'Independent recharge':'Independent play']];
  for(const [kind,value] of summaries){const el=root.querySelector<HTMLElement>('[data-summary-'+kind+']');if(el)el.textContent=value}
  const day=root.querySelector<HTMLSelectElement>('[data-days]');if(day)day.value=options.days;
  const start=root.querySelector<HTMLSelectElement>('[data-start]');if(start)start.value=String(options.start);
  const quiet=root.querySelector<HTMLSelectElement>('[data-quiet]');if(quiet)quiet.value=options.quiet;
  const play=root.querySelector<HTMLSelectElement>('[data-play]');if(play)play.value=options.play;
  root.querySelectorAll<HTMLInputElement>('input[name="msr-structure"]').forEach(el=>{el.checked=el.value===options.structure});
  for(const key of keys){const node=nodes.get(key);if(node&&!order.includes(key))node.hidden=true}
  renderRemoved();
  if(buildEditor)renderEditor();
 };
 const update=()=>{save();render(true)};
 root.querySelector<HTMLSelectElement>('[data-days]')?.addEventListener('change',e=>{
  options.days=(e.target as HTMLSelectElement).value as Days;
  // The parent's custom words are preserved when changing day types.
  update();
 });
 root.querySelectorAll<HTMLInputElement>('input[name="msr-structure"]').forEach(el=>el.addEventListener('change',()=>{
  if(el.checked){options.structure=el.value as Structure;update()}
 }));
 root.querySelector<HTMLSelectElement>('[data-start]')?.addEventListener('change',e=>{options.start=Number((e.target as HTMLSelectElement).value);update()});
 root.querySelector<HTMLSelectElement>('[data-quiet]')?.addEventListener('change',e=>{options.quiet=(e.target as HTMLSelectElement).value as Quiet;update()});
 root.querySelector<HTMLSelectElement>('[data-play]')?.addEventListener('change',e=>{options.play=(e.target as HTMLSelectElement).value as Play;update()});
 root.querySelector('[data-reset]')?.addEventListener('click',()=>{ageDefaults();update()});
 for(const key of keys){
  const node=nodes.get(key);if(!node)continue;
  node.querySelector<HTMLButtonElement>('[data-move-up]')?.addEventListener('click',()=>moveBlock(key,-1));
  node.querySelector<HTMLButtonElement>('[data-move-down]')?.addEventListener('click',()=>moveBlock(key,1));
  node.querySelector<HTMLButtonElement>('[data-remove]')?.addEventListener('click',()=>removeBlock(key));
  for(const [selector,field,limit] of [['[data-title]','title',38],['[data-desc]','desc',78]] as const){
   const el=node.querySelector<HTMLElement>(selector);
   el?.addEventListener('input',()=>{
    const text=(el.textContent??'').replace(/\s+/g,' ').slice(0,limit);
    edits[key]={...(edits[key]??{}),[field]:text};save();
   });
   el?.addEventListener('blur',()=>{const text=(el.textContent??'').replace(/\s+/g,' ').trim().slice(0,limit);
    edits[key]={...(edits[key]??{}),[field]:text};update()});
   el?.addEventListener('keydown',(e:KeyboardEvent)=>{if(e.key==='Enter'){e.preventDefault();el.blur()}});
  }
  const time=node.querySelector<HTMLElement>('[data-time]');
  const editTime=()=>{
   if(!time||time.querySelector('input'))return;
   const input=document.createElement('input');input.type='time';input.value=resolved(key).time;
   input.setAttribute('aria-label','Set '+labels[key]+' time');
   time.replaceChildren(input);time.setAttribute('role','group');
   const finish=()=>{const value=input.value;edits[key]={...(edits[key]??{}),time:value};time.setAttribute('role','button');update()};
   input.addEventListener('change',finish,{once:true});
   input.addEventListener('blur',()=>{if(time.contains(input))finish()},{once:true});
   input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();input.blur()}if(e.key==='Escape'){e.preventDefault();time.setAttribute('role','button');render()}});
   input.focus();
  };
  time?.addEventListener('click',editTime);
  time?.addEventListener('keydown',e=>{if(e.target===time&&(e.key==='Enter'||e.key===' ')){e.preventDefault();editTime()}});
 }
 root.querySelector('[data-print]')?.addEventListener('click',()=>window.print());
 const download=root.querySelector<HTMLButtonElement>('[data-download]');
 download?.addEventListener('click',async()=>{
  if(!sheet||!download)return;
  const prior=download.textContent;
  download.disabled=true;download.textContent='Preparing image…';
  root.classList.add('msr-exporting');
  try{
   await Promise.all(Array.from(sheet.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));
   const {toPng}=await import('html-to-image');
   const url=await toPng(sheet,{pixelRatio:2,width:816,height:1056,backgroundColor:'#ffffff'});
   const anchor=document.createElement('a');anchor.download='our-summer-day.png';anchor.href=url;anchor.click();
  }catch(err){console.error('Summer rhythm PNG export failed',err);alert('Sorry, the image could not be saved. You can still use Print / Save PDF.')}
  finally{root.classList.remove('msr-exporting');download.disabled=false;download.textContent=prior}
 });
 const applyHousehold=(detail:{household:{id:string;displayName?:string;members:Person[]};sample?:string})=>{
  if(!detail?.household)return;
  const nextProfile=(detail.sample??'account')+':'+detail.household.id;
  const changed=profile!==nextProfile;
  profile=nextProfile;
  children=detail.household.members.filter(p=>!p.archived&&p.kind==='child');
  const name=(detail.household.displayName??'').trim();
  familyLabel=name?name.toUpperCase()+' · SUMMER RHYTHM':"OUR FAMILY'S SUMMER RHYTHM";
  if(changed){
   ageDefaults();
   try{
    const stored=JSON.parse(sessionStorage.getItem(storageKey)??'null');
    if(stored?.profile===profile&&stored.options){
     const o=stored.options;
     if([7,7.5,8,8.5,9,9.5].includes(o.start))options.start=o.start;
     if(['independent','rest','older'].includes(o.quiet))options.quiet=o.quiet;
     if(['outdoors','active','creative','mixed'].includes(o.play))options.play=o.play;
     if(['home','camp'].includes(o.days))options.days=o.days;
     if(['relaxed','balanced','structured'].includes(o.structure))options.structure=o.structure;
     const savedOrder=stored.order;
     if(Array.isArray(savedOrder)&&savedOrder.length>=1&&savedOrder.length<=keys.length&&new Set(savedOrder).size===savedOrder.length&&savedOrder.every(k=>keys.includes(k)))order=savedOrder;
     if(Array.isArray(stored.removed)&&new Set(stored.removed).size===stored.removed.length&&stored.removed.every((k:Key)=>keys.includes(k))&&stored.removed.length+order.length===keys.length&&stored.removed.every((k:Key)=>!order.includes(k)))removed=stored.removed;
     else if(order.length<keys.length)removed=keys.filter(k=>!order.includes(k));
     if(stored.edits&&typeof stored.edits==='object'){
      for(const key of keys){
       const obj=stored.edits[key];if(!obj||typeof obj!=='object')continue;
       const edit:Edit={};
       if(typeof obj.title==='string')edit.title=obj.title.slice(0,38);
       if(typeof obj.desc==='string')edit.desc=obj.desc.slice(0,78);
       if(typeof obj.time==='string'&&(/^([01]\d|2[0-3]):[0-5]\d$/.test(obj.time)||obj.time===''))edit.time=obj.time;
       edits[key]=edit;
      }
     }
    }
   }catch{}
  }
  update();
 };
 window.addEventListener('omc:club-preview-household',(event:Event)=>applyHousehold((event as CustomEvent<{household:{id:string;displayName?:string;members:Person[]};sample?:string}>).detail));
 const cached=(window as Window & {__ofcPreviewHousehold?:{household:{id:string;displayName?:string;members:Person[]};sample?:string}}).__ofcPreviewHousehold;
 if(cached)applyHousehold(cached);
 render(true);
}

<script>
import { PLAN_CHANGE } from "../../lib/club/plan/resource";
import {
 LABELS, MAY_KEYS, START_TIMES, TINTS, clock as engineClock, familyDefaults, keepToFamily, mayContext,
 mayFingerprint, mayParts, mayRows, readEdit, readSaved, starter as prepared, visibleKeys as shownKeys,
 type MayState, type MayPlan, type MayMember, type MayRow,
} from "../../lib/club/engines/may-summer-rhythm";
import type { FamilyContext, FamilySnapshot } from '../../lib/club/personalize/family';
import { familySnapshot, settledSnapshot } from '../../lib/club/personalize/family';
import type { TaskEdits } from '../../lib/club/personalize/edits';
import { ownerTags } from '../../lib/club/personalize/marks';
import { MAY_SECTIONS, mayEditor, type MaySection } from '../../lib/club/may-editor';
import { moveBlock as moveSlots } from '../../lib/club/engines/may-summer-rhythm';
import type { FamilyProfile } from '../../lib/club/family-profile';
type Person=MayMember;
type Quiet='independent'|'rest'|'older';
type Play='outdoors'|'active'|'creative'|'mixed';
type Structure='relaxed'|'balanced'|'structured';
type Days='home'|'mixed'|'camp';
type Key='morning'|'move'|'create'|'lunch'|'quiet'|'free'|'snack'|'evening';
type Edit={title?:string;desc?:string;time?:string;cue?:string;when?:'time'|'trigger';trigger?:string};
type Options={start:number;quiet:Quiet;play:Play;structure:Structure;days:Days;snack:boolean};
type Detail={household:{id:string;displayName?:string;members:Person[];preferences?:{pets?:boolean}};sample?:string|null;profile?:FamilyProfile|null};
const keys:Key[]=[...MAY_KEYS];
const labels:Record<Key,string>=LABELS;
const hhmm=(n:number)=>{const normalized=(n+24)%24;const h=Math.floor(normalized);const min=Math.round((normalized-h)*60);return String(h).padStart(2,'0')+':'+String(min).padStart(2,'0')};
const clock=engineClock;
for(const root of document.querySelectorAll<HTMLElement>('.msr')){
 const storageKey=root.dataset.msrKey??'omc:preview:may:v2';
 const planMode=root.dataset.msrPlan==='true';
 let locked=false;
 // What scrolls the sheet: the plan page's printable column, or the standalone preview.
 const scroller=()=>root.closest<HTMLElement>('[data-plan-proof-scroll]')??root.querySelector<HTMLElement>('.msr-preview');
 let persist=true;
 let profile='';
 let ctx:FamilyContext|null=null;
 let members:Person[]=[];
 let prefs:{pets?:boolean}={};
 let parts:TaskEdits={};
 let snapshot:FamilySnapshot|undefined;
 // Her newest profile answers: used before anything is saved, or when she restores the suggested rhythm.
 let latest:FamilySnapshot|undefined;
 const rebuild=()=>{ctx=members.length?mayContext(members,prefs,snapshot):null;if(ctx)keepToFamily(parts,ctx)};
 let options:Options=familyDefaults(mayContext([],{}));
 let edits:Partial<Record<Key,Edit>>={};
 let order:Key[]=[...keys];
 let removed:Key[]=[];
 let familyLabel="OUR FAMILY'S SUMMER RHYTHM";
 const stage=root.querySelector<HTMLElement>('[data-stage]');
 const sheet=root.querySelector<HTMLElement>('[data-sheet]');
 const list=root.querySelector<HTMLElement>('[data-print-rows]');
 const nodes=new Map<Key,HTMLElement>();
 list?.querySelectorAll<HTMLElement>('[data-rhythm-key]').forEach(el=>{const key=el.dataset.rhythmKey as Key;if(keys.includes(key))nodes.set(key,el)});
 const fit=()=>{
  if(!stage||!sheet)return;
  const width=Math.max(200,(stage.parentElement?.clientWidth??816)-4);
  const scale=Math.min(1,width/816);
  stage.style.width=String(816*scale)+'px';
  stage.style.height=String(1056*scale)+'px';
  sheet.style.setProperty('--msr-scale',String(scale));
 };
 fit();
 // The sheet is measured when it's visible: the plan page shows it only once the family is ready (then it resizes).
 window.addEventListener('resize',()=>fitSheet());
 const parent=stage?.parentElement;
 if(parent&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(parent);
 window.addEventListener('resize',fit);
 // The prepared day for this family (quiet time by ages, play by interests); her edits start empty.
 const ageDefaults=()=>{
  options=ctx?familyDefaults(ctx):familyDefaults(mayContext([],{}));
  edits={};
  order=[...keys];
  removed=[];
  parts={};
 };
 const starter=(key:Key)=>prepared(key,options,ctx??undefined);
 const resolved=(key:Key)=>{const {cue:_c,when:_w,trigger:_t,...e}=edits[key]??{};return {...starter(key),...e}};
 const visionDialog=root.querySelector<HTMLDialogElement>('[data-vision-dialog]');
 const editorDialog=root.querySelector<HTMLDialogElement>('[data-editor-dialog]');
 root.querySelector('[data-open-vision]')?.addEventListener('click',()=>visionDialog?.showModal());
 root.querySelectorAll('[data-open-editor]').forEach(button=>button.addEventListener('click',()=>openEditor()));
 root.querySelectorAll('[data-close-modal]').forEach(button=>button.addEventListener('click',()=>button.closest('dialog')?.close()));
 visionDialog?.addEventListener('click',event=>{if(event.target===visionDialog)visionDialog.close()});
 const save=()=>{if(!persist)return;try{(planMode?sessionStorage:localStorage).setItem(storageKey,JSON.stringify({profile,options,edits,order,removed,...(Object.keys(parts).length?{parts}:{}),...(snapshot?{snapshot}:{})}))}catch{}};
 const removeBlock=(key:Key)=>{
  if(!order.includes(key)||order.length<=1)return;
  order=order.filter(k=>k!==key);removed.push(key);
  update();
 };
 // Earlier/later on the sheet: the same move as the editor (times stay in order).
 const moveBlock=(key:Key,dir:-1|1)=>{const s={edits,options,order};moveSlots(s,key,dir,ctx??undefined);order=s.order;update()};
 // Time-based pastel progression. Each daypart has its own palette, with a
 // gradual change within that range rather than a hardcoded color per activity.
 const interpolate=(first:string,last:string,progress:number)=>{
  const t=Math.max(0,Math.min(1,progress));
  const rgb=[1,3,5].map(i=>Math.round(parseInt(first.slice(i,i+2),16)*(1-t)+parseInt(last.slice(i,i+2),16)*t));
  return '#'+rgb.map(n=>n.toString(16).padStart(2,'0')).join('').toUpperCase();
 };
 const tintFor=(time:string,fallback:string)=>{
  if(!/^([01]\d|2[0-3]):[0-5]\d$/.test(time))return fallback;
  const minute=Number(time.slice(0,2))*60+Number(time.slice(3,5));
  if(minute<720)return interpolate('#FBF0CC','#EDCE86',minute/719);
  if(minute<1080)return interpolate('#DEEDDB','#B9D8C7',(minute-720)/360);
  return interpolate('#DBDFF0','#B4BBD9',(minute-1080)/359);
 };
 const visibleKeys=()=>shownKeys(order,options);
 // The family jobs on each anchor, as printed.
 const partsByKey=()=>{const all=ctx?mayParts(ctx,parts):[];return (key:Key)=>all.filter(p=>p.block===key&&!p.skipped)};
 // A long family plan can make the rows taller: a little tighter spacing keeps it on one page, never clipped.
 const fitSheet=()=>{
  if(!sheet)return;
  sheet.classList.remove('msr-dense');
  const foot=sheet.querySelector<HTMLElement>('.msr-foot');
  const rule=sheet.querySelector<HTMLElement>('.msr-rule');
  if(!foot||!rule)return;
  if(rule.offsetTop+rule.offsetHeight+foot.offsetHeight+8>1056-23)sheet.classList.add('msr-dense');
 };
 const render=(buildEditor=false)=>{
  root.dataset.msrStructure=options.structure;
  root.dataset.msrDays=options.days;
  const family=root.querySelector<HTMLElement>('[data-family]');if(family)family.textContent=familyLabel;
  const dayLabel=root.querySelector<HTMLElement>('[data-day-label]');if(dayLabel)dayLabel.textContent=options.days==='camp'?'CAMP / PROGRAM DAY':options.days==='mixed'?'HOME OR OUTING DAY':'A DAY AT HOME';
  const visible=visibleKeys();
  const partsOf=partsByKey();
  const rowsNow=mayRows({options,edits,order,parts},ctx??undefined);
  for(const key of order){
   const node=nodes.get(key);if(!node||!list)continue;
   list.append(node);
   node.hidden=!visible.includes(key);
   const v=resolved(key);
   node.style.setProperty('--msr-tint',tintFor(v.time,TINTS[key]));
   const title=node.querySelector<HTMLElement>('[data-title]');if(title)title.textContent=v.title;
   const desc=node.querySelector<HTMLElement>('[data-desc]');if(desc)desc.textContent=v.desc;
   const who=node.querySelector<HTMLElement>('[data-parts]');
   // The anchor's family jobs: each job with its owners in their family colors, then the one moment they follow.
   if(who){const list=partsOf(key);who.hidden=!list.length;who.replaceChildren(...list.map(p=>{const chip=document.createElement('span');chip.className='msr-part';const job=document.createElement('span');job.className='msr-part-job';job.textContent=p.label;chip.append(ownerTags(p.owners),job);return chip}))}
   // One box on the right: the block's time, or the familiar event that starts it (never both, no WHEN pill).
   const time=node.querySelector<HTMLElement>('[data-time]');
   if(time){const slot=rowsNow.find(r=>r.key===key)?.slot??null;time.hidden=!slot;time.classList.toggle('msr-time--trigger',slot?.kind==='trigger');
    if(slot?.kind==='time'){const match=slot.text.match(/^(.*?)( AM| PM)$/);time.replaceChildren(document.createTextNode(match?match[1]:slot.text));if(match){const suffix=document.createElement('span');suffix.className='msr-meridiem';suffix.textContent=match[2];time.append(suffix)}}
    else if(slot){const arrow=document.createElementNS('http://www.w3.org/2000/svg','svg');arrow.setAttribute('viewBox','0 0 16 16');arrow.setAttribute('class','msr-trigger-arrow');arrow.setAttribute('aria-hidden','true');arrow.innerHTML='<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>';const text=document.createElement('span');text.className='msr-trigger-text';text.append(arrow,slot.text);time.replaceChildren(text)}}
   node.querySelector<HTMLButtonElement>('[data-move-up]')?.toggleAttribute('disabled',order.indexOf(key)===0);
   node.querySelector<HTMLButtonElement>('[data-move-down]')?.toggleAttribute('disabled',order.indexOf(key)===order.length-1);
   node.querySelector<HTMLButtonElement>('[data-remove]')?.toggleAttribute('disabled',order.length<=1);
  }
  const summaries:[string,string][]=[['days',options.days==='camp'?'Camp or program':options.days==='mixed'?'Home + outings':'Mostly at home'],['structure',options.structure==='relaxed'?'Relaxed':options.structure==='structured'?'More structured':'Balanced'],['start',clock(hhmm(options.start))],['quiet',options.quiet==='rest'?'Rest or nap':options.quiet==='older'?'Independent recharge':'Independent play']];
  for(const [kind,value] of summaries){const el=root.querySelector<HTMLElement>('[data-summary-'+kind+']');if(el)el.textContent=value}
  for(const key of keys){const node=nodes.get(key);if(node&&!order.includes(key))node.hidden=true}
  if(editorDialog?.open&&buildEditor)drawEditor();
  fitSheet();
  if(planMode) root.dispatchEvent(new Event(PLAN_CHANGE,{bubbles:true}));
 };
 const update=()=>{save();render(true)};
 root.querySelector('[data-reset]')?.addEventListener('click',()=>{snapshot=latest;rebuild();ageDefaults();update()});
 for(const key of keys){
  const node=nodes.get(key);if(!node)continue;
  node.querySelector<HTMLButtonElement>('[data-move-up]')?.addEventListener('click',()=>moveBlock(key,-1));
  node.querySelector<HTMLButtonElement>('[data-move-down]')?.addEventListener('click',()=>moveBlock(key,1));
  node.querySelector<HTMLButtonElement>('[data-remove]')?.addEventListener('click',()=>removeBlock(key));
  for(const [selector,field,limit] of [['[data-title]','title',38],['[data-desc]','desc',78]] as const){
   const el=node.querySelector<HTMLElement>(selector);
   el?.addEventListener('input',()=>{
    const text=(el.textContent??'').replace(/\s+/g,' ').slice(0,limit);
    edits[key]={...(edits[key]??{}),[field]:text};save();
   });
   el?.addEventListener('blur',()=>{const text=(el.textContent??'').replace(/\s+/g,' ').trim().slice(0,limit);
    edits[key]={...(edits[key]??{}),[field]:text};update()});
   el?.addEventListener('keydown',(e:KeyboardEvent)=>{if(e.key==='Enter'){e.preventDefault();el.blur()}});
  }
  // The time-or-trigger box opens "When it happens" at this block.
  const time=node.querySelector<HTMLElement>('[data-time]');
  const editWhen=()=>{if(!locked)openEditor('when',key)};
  time?.addEventListener('click',editWhen);
  time?.addEventListener('keydown',e=>{if(e.target===time&&(e.key==='Enter'||e.key===' ')){e.preventDefault();editWhen()}});
 }
 root.querySelector('[data-print]')?.addEventListener('click',()=>window.print());
 const download=root.querySelector<HTMLButtonElement>('[data-download]');
 download?.addEventListener('click',async()=>{
  if(!sheet||!download)return;
  const prior=download.textContent;
  download.disabled=true;download.textContent='Preparing image…';
  root.classList.add('msr-exporting');
  try{
   await Promise.all(Array.from(sheet.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));
   const {toPng}=await import('html-to-image');
   const url=await toPng(sheet,{pixelRatio:2,width:816,height:1056,backgroundColor:'#ffffff'});
   const anchor=document.createElement('a');anchor.download='our-summer-day.png';anchor.href=url;anchor.click();
  }catch(err){console.error('Summer rhythm PNG export failed',err);alert('Sorry, the image could not be saved. You can still use Print / Save PDF.')}
  finally{root.classList.remove('msr-exporting');download.disabled=false;download.textContent=prior}
 });
 const applyHousehold=(detail:Detail)=>{
  if(!detail?.household)return;
  const nextProfile=(detail.sample??'account')+':'+detail.household.id;
  const changed=profile!==nextProfile;
  profile=nextProfile;
  members=detail.household.members.filter(p=>!p.archived);
  prefs=detail.household.preferences??{};
  // The owner's print view has no profile (null): the rhythm comes from the snapshot saved with her plan.
  if(detail.profile)latest=familySnapshot(detail.profile);
  const name=(detail.household.displayName??'').trim();
  familyLabel=name?name.toUpperCase()+' · SUMMER RHYTHM':"OUR FAMILY'S SUMMER RHYTHM";
  if(changed){
   let stored:Record<string,any>|null=null;
   try{stored=JSON.parse((planMode?sessionStorage:localStorage).getItem(storageKey)??'null')}catch{}
   const mine=stored?.profile===profile&&stored.options?stored:null;
   const saved=mine?readSaved(mine):{};
   snapshot=settledSnapshot(saved.snapshot,latest);
   rebuild();
   ageDefaults();
   if(mine){
     const o=mine.options;
     if((START_TIMES as readonly number[]).includes(o.start))options.start=o.start;
     if(['independent','rest','older'].includes(o.quiet))options.quiet=o.quiet;
     if(['outdoors','active','creative','mixed'].includes(o.play))options.play=o.play;
     if(['home','mixed','camp'].includes(o.days))options.days=o.days;
     if(typeof o.snack==='boolean')options.snack=o.snack;
     if(['relaxed','balanced','structured'].includes(o.structure))options.structure=o.structure;
     const savedOrder=mine.order;
     if(Array.isArray(savedOrder)&&savedOrder.length>=1&&savedOrder.length<=keys.length&&new Set(savedOrder).size===savedOrder.length&&savedOrder.every((k:Key)=>keys.includes(k)))order=savedOrder;
     if(Array.isArray(mine.removed)&&new Set(mine.removed).size===mine.removed.length&&mine.removed.every((k:Key)=>keys.includes(k))&&mine.removed.length+order.length===keys.length&&mine.removed.every((k:Key)=>!order.includes(k)))removed=mine.removed;
     else if(order.length<keys.length)removed=keys.filter(k=>!order.includes(k));
     if(mine.edits&&typeof mine.edits==='object'){
      // Saved before triggers or after: read the same way (a time she set stays a time; her jobs' moment becomes the trigger).
      for(const key of keys){const edit=readEdit(mine.edits[key]);if(edit)edits[key]=edit}
     }
     parts=saved.parts??{};
     rebuild();
   }
  }else rebuild();
  update();
 };
 // One state for the editor (both modes) and the Club plan (plan mode).
 const current=():MayState=>({options:structuredClone(options),edits:structuredClone(edits),order:[...order],removed:[...removed],rows:mayRows({options,edits,order,parts},ctx??undefined),familyLabel,parts:structuredClone(parts),...(snapshot?{snapshot:structuredClone(snapshot)}:{})});
 const replace=(s:MayState)=>{options=structuredClone(s.options);edits=structuredClone(s.edits);order=[...s.order];removed=[...s.removed];parts=structuredClone(s.parts??{});if(s.snapshot!==undefined||!snapshot)snapshot=s.snapshot??latest;rebuild();save();render(true)};
 const updateState=(fn:(s:MayState)=>void)=>{if(locked)return;const s=current();fn(s);replace(s)};
 // How many lines a trigger takes in its printed box (measured at the sheet's size, off screen).
 const lines=(text:string)=>{const probe=document.createElement('div');probe.className='msr-when-probe';probe.textContent=text;document.body.append(probe);const n=Math.round(probe.offsetHeight/(14.5*1.22));probe.remove();return n};
 let section:MaySection='when';
 let opened:MayState|null=null;
 const tabs=root.querySelector<HTMLElement>('[data-mye-tabs]');
 const body=root.querySelector<HTMLElement>('[data-mye-body]');
 const drawEditor=()=>{
  if(!editorDialog?.open||!tabs||!body)return;
  tabs.replaceChildren(...MAY_SECTIONS.map(([id,label])=>{const b=document.createElement('button');b.type='button';b.setAttribute('role','tab');b.textContent=label;b.setAttribute('aria-selected',String(id===section));b.addEventListener('click',()=>{section=id;editor.focus();drawEditor()});return b}));
  const top=editorDialog.scrollTop;
  body.replaceChildren(editor.section(section));
  editorDialog.scrollTop=top;
 };
 const restoreAll=()=>{snapshot=latest;rebuild();ageDefaults();update()};
 const editor=mayEditor({state:current,update:updateState,ctx:()=>ctx,locked:()=>locked,redraw:drawEditor,lines,restore:restoreAll});
 const openEditor=(s:MaySection='day',key?:Key)=>{
  if(locked||!editorDialog)return;
  section=s;editor.focus(key);opened=current();
  if(!editorDialog.open)editorDialog.showModal();
  drawEditor();
  if(key)editorDialog.querySelector<HTMLElement>(`.mye-when[data-key="${key}"]`)?.scrollIntoView({block:'center'});
 };
 // Done keeps the changes (they're already saved as she goes); Cancel puts the plan back as it was when she opened it.
 root.querySelector('[data-mye-done]')?.addEventListener('click',()=>{opened=null;editorDialog?.close()});
 const cancel=()=>{if(opened)replace(opened);opened=null;editorDialog?.close()};
 root.querySelector('[data-mye-cancel]')?.addEventListener('click',cancel);
 editorDialog?.addEventListener('cancel',e=>{e.preventDefault();cancel()});
 editorDialog?.addEventListener('click',event=>{if(event.target===editorDialog){opened=null;editorDialog.close()}});
 if(planMode){
  (root as HTMLElement & {clubPlan?:MayPlan}).clubPlan={
   ready:()=>Boolean(profile),state:current,
   update:updateState,replace,
   setPersist:on=>{persist=on;if(on)save()},
   fingerprint:()=>mayFingerprint({options,edits,order,parts,familyLabel},ctx??undefined),
   context:()=>ctx,
   restore:restoreAll,
   setLocked:on=>{locked=on;root.querySelectorAll<HTMLElement>('.msr-sheet [contenteditable]').forEach(el=>el.setAttribute('contenteditable',on?'false':'true'));root.querySelectorAll<HTMLElement>('.msr-sheet [data-time], .msr-sheet [data-move-up], .msr-sheet [data-move-down], .msr-sheet [data-remove]').forEach(el=>{el.style.pointerEvents=on?'none':'';el.tabIndex=on?-1:0});if(on)editorDialog?.close()},
   openEditor:(s?:MaySection,key?:Key)=>openEditor(s??'day',key),
  };
 }
 window.addEventListener('omc:club-preview-household',(event:Event)=>applyHousehold((event as CustomEvent<Detail>).detail));
 const cached=(window as Window & {__ofcPreviewHousehold?:Detail}).__ofcPreviewHousehold;
 if(cached)applyHousehold(cached);
 render(true);
}
</script>
---
/**
 * March Family Rhythm on phones and tablets (below 1100px), inside the shared ClubPlanScreen (approval, action bar,
 * print). Like January's Family Focus it is a calm reference the family can glance at all month: the same saved plan
 * as the printable (`[data-mfr]`'s `clubPlan.view()`), each moment with its cue, who owns which part and the new habits,
 * nothing tracked and nothing saved by viewing. Three edit rows, in order (Our moments, Who owns what, New habits),
 * open the shared editor (src/lib/club/march-rhythm-editor.ts) in an edit sheet.
 */
import ClubPlanScreen from './plan/ClubPlanScreen.astro';
import '../../styles/club-marks.css';
import MarchTabs from './MarchTabs.astro';
interface Props {
  deadline: string;
  kicker?: string;
  /** March's Family rhythm / Spring Prep switch (off for the Welcome resource). */
  tabs?: boolean;
}
const { deadline, kicker = 'March · Organized Family Club', tabs = true } = Astro.props;
---
<ClubPlanScreen deadline={deadline} kicker={kicker} sheets={['front']} previewNote="One page for the whole family, ready to print" hero={false}>
  <Fragment slot="title">Our Family <em>Rhythm</em></Fragment>
  {tabs && <MarchTabs current="rhythm" />}
  <div class="mrm" data-mrm>
    <p class="mrm-motto">Same moments. Everyone has a part.</p>
    <div class="mrm-moments" data-mrm-moments></div>
    <section class="mrm-habits" data-mrm-habits aria-labelledby="mrm-habits-title">
      <h2 id="mrm-habits-title" class="mrm-label">This week, we’re practicing</h2>
      <ul data-mrm-habit-list></ul>
      <p class="mrm-habits-note">Practice together at first. Then let them take the lead.</p>
    </section>
    <section class="cp-section" aria-labelledby="mrm-edit-title">
      <h2 id="mrm-edit-title">Make it yours</h2>
      <p class="cp-intro">It’s prepared from your family page. Change only what doesn’t fit.</p>
      <ul class="cp-group" data-mrm-edit></ul>
      <p class="mrm-restore" data-mrm-restore hidden><button type="button" class="cp-link"><span>Start over with the prepared plan</span></button></p>
    </section>
  </div>
</ClubPlanScreen>

<style is:global>
@media screen and (max-width:1099px){
.mrm{display:grid;gap:22px;margin:0 0 26px}
.mrm-motto{margin:0;font:italic 400 1.05rem/1.4 var(--font-serif);color:var(--cp-soft)}
.mrm-moments{display:grid;gap:18px}
.mrm-moment{padding:16px 16px 12px;border:1px solid var(--color-warm-rule);border-radius:8px;background:#fff}
.mrm-moment h2{margin:0;font:400 clamp(23px,6.2vw,27px)/1.15 var(--font-serif)}
.mrm-cue{margin:4px 0 10px;font-size:.88rem;color:var(--cp-soft)}
.mrm-cue b{font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--color-warm-ink);margin-right:6px}
.mrm-rows{list-style:none;margin:0;padding:0;display:grid}
.mrm-row{display:grid;grid-template-columns:4px minmax(0,1fr) auto;gap:4px 12px;align-items:center;padding:10px 0;border-top:1px solid var(--color-warm-rule)}
.mrm-row.is-habit{background:var(--mrm-wash,#EEF4F1);margin:0 -8px;padding:10px 8px}
.mrm-bar{align-self:stretch;border-radius:2px;background:var(--mrm-member,#9A918B)}
.mrm-text{display:grid;gap:2px;min-width:0}
.mrm-who{font-size:.74rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;overflow-wrap:anywhere}
.mrm-job{font-size:1.02rem;line-height:1.35}
.mrm-row.is-habit .mrm-job{font-weight:700}
.mrm-tag{font-size:.62rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--mrm-accent,#3F6B5A);border:1.5px solid currentColor;border-radius:999px;padding:4px 7px;white-space:nowrap}
.mrm-finish{margin:10px 0 0;font:italic 400 .95rem/1.4 var(--font-serif);color:var(--cp-soft)}
.mrm-finish b{font:700 .66rem var(--font-sans);font-style:normal;letter-spacing:.14em;text-transform:uppercase;color:var(--color-warm-ink);margin-right:6px}
.mrm-habits{padding:14px 16px;border-radius:8px;background:var(--mrm-wash,#EEF4F1)}
.mrm-habits[hidden]{display:none}
.mrm-label{margin:0 0 6px;font-size:.78rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--mrm-accent,#3F6B5A)}
.mrm-habits ul{list-style:none;margin:0;padding:0;display:grid;gap:4px}
.mrm-habits li{font:400 1.02rem/1.45 var(--font-serif)}
.mrm-habits-note{margin:8px 0 0;font:italic 400 .9rem/1.4 var(--font-serif);color:var(--cp-soft)}
.mrm-mode{font-size:.7rem;font-weight:600;letter-spacing:.08em;color:var(--cp-soft);margin-left:6px;text-transform:none}
.mrm-moment-edit{margin-top:8px}
.mrm-restore{margin:6px 0 0}
.mrm-restore[hidden]{display:none}
.mrm-step{font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--cp-soft)}
}
</style>

<script>
import { el } from '../../lib/club/plan/dom';
import { mountPlanScreen, type PlanScreen } from '../../lib/club/plan/screen';
import { restorePlan, type RhythmPlanResource, type RhythmState } from '../../lib/club/engines/march-family-rhythm';
import { rhythmEditor, type RhythmSection } from '../../lib/club/march-rhythm-editor';
import { monthTints } from '../../lib/club/month-tints';
import { WELCOME_APPROVAL_KEY } from '../../lib/club/plan/family';
import { isWelcomeResource } from '../../lib/club/plan/resource';

const root = document.querySelector<HTMLElement>('.club-plan:has([data-mfr])');
const APPROVAL_KEY = root && isWelcomeResource(root) ? WELCOME_APPROVAL_KEY : 'omc:preview:march-chore-charts:approval';
const host = root?.querySelector<HTMLElement & { clubPlan?: RhythmPlanResource }>('[data-mfr]');
if (root && host) {
  const plan = () => host.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const t = monthTints('2027-03');
  q('[data-mrm]').style.setProperty('--mrm-wash', t.wash);
  q('[data-mrm]').style.setProperty('--mrm-accent', t.accent);
  let ui: PlanScreen<RhythmState>;
  let isLocked = false;
  let section: RhythmSection = 'owners';

  const row = (step: string, title: string, detail: string, open: () => void, locked: boolean) => {
    const b = el('button', { type: 'button', class: 'cp-row', disabled: locked }, el('span'),
      el('span', { class: 'cp-row-text' }, el('span', { class: 'mrm-step' }, step), el('strong', {}, title), detail ? el('span', {}, detail) : ''),
      el('span', { class: 'cp-chev', 'aria-hidden': 'true' }));
    b.setAttribute('aria-label', `${step}: ${title}.${locked ? '' : ' Change'}`);
    b.addEventListener('click', open);
    return el('li', {}, b);
  };
  const named = (o: { name: string; color: { ink: string } }) => { const s = el('span', {}, o.name); s.style.color = o.color.ink; return s; };
  const render = (_ui: PlanScreen<RhythmState>, _s: RhythmState, locked: boolean) => {
    isLocked = locked;
    const v = plan().view();
    // The daily reference: each moment as it prints, who does what, and what finished looks like.
    q('[data-mrm-moments]').replaceChildren(...(v.printed.length ? v.printed.map((m) => el('section', { class: 'mrm-moment' },
      el('h2', {}, m.title),
      el('p', { class: 'mrm-cue' }, el('b', {}, 'Cue'), `${m.cue} → ${m.reset}`),
      el('ul', { class: 'mrm-rows' }, ...m.rows.map((r) => {
        const li = el('li', { class: `mrm-row${r.habit ? ' is-habit' : ''}` },
          el('span', { class: 'mrm-bar', 'aria-hidden': 'true' }),
          el('span', { class: 'mrm-text' },
            el('span', { class: 'mrm-who' }, ...r.owners.flatMap((o, i) => (i ? [r.mode === 'together' ? ' + ' : ' · ', named(o)] : [named(o)])),
              ...(r.mode === 'each' ? [el('span', { class: 'mrm-mode' }, 'each their own')] : r.mode === 'together' ? [el('span', { class: 'mrm-mode' }, 'together')] : [])),
            el('span', { class: 'mrm-job' }, r.title)),
          r.habit ? el('span', { class: 'mrm-tag' }, 'New habit') : el('span'));
        li.style.setProperty('--mrm-member', r.owners[0].color.hex);
        if (r.owners.length > 1) li.querySelector<HTMLElement>('.mrm-bar')!.style.background = `linear-gradient(${r.owners.map((o, i, a) => `${o.color.hex} ${(i / a.length) * 100}% ${((i + 1) / a.length) * 100}%`).join(',')})`;
        return li;
      })),
      ...(m.finish ? [el('p', { class: 'mrm-finish' }, el('b', {}, 'Finished when'), m.finish)] : []),
      ...(locked ? [] : [(() => { const b = el('button', { type: 'button', class: 'cp-link mrm-moment-edit' }, el('span', {}, `Change ${m.title.toLowerCase()} jobs`)); b.addEventListener('click', () => open('owners', m.id)); return b; })()])))
      : [el('p', { class: 'cp-intro' }, 'Add your family to your family profile and your rhythm is prepared here.')]));
    q('[data-mrm-habits]').hidden = !v.habits.length;
    q('[data-mrm-habit-list]').replaceChildren(...v.habits.map((h) => el('li', {}, h.sentence)));
    // Editing, in the order she thinks about it.
    const on = v.moments.filter((m) => m.enabled);
    const jobs = on.reduce((n, m) => n + m.rows.length, 0);
    q('[data-mrm-edit]').replaceChildren(
      row('1 · Our moments', on.map((m) => m.title).join(' · '), on.length < 3 ? 'Add a third moment if you need one' : '', () => open('moments'), locked),
      row('2 · Who owns what', `${jobs} ${jobs === 1 ? 'job' : 'jobs'} across ${on.length} ${on.length === 1 ? 'moment' : 'moments'}`, 'Change one job at a time', () => open('owners'), locked),
      row('3 · New habits', v.habits.length ? v.habits.map((h) => `${h.owners.map((o) => o.name).join(' & ')}: ${h.title}`).join(' · ') : 'None chosen', 'One or two to practice first', () => open('habits'), locked));
    q('[data-mrm-restore]').hidden = locked || !v.changed;
  };
  const TITLES: Record<RhythmSection, string> = { moments: 'Our family moments', owners: 'Who owns what', habits: 'Our new habits' };
  const sheetEl = () => root.querySelector<HTMLDialogElement>('[data-cp-sheet]');
  // Redrawing after each change keeps the sheet where she was, not back at the top. While one job is open it has its
  // own Done and Cancel, so the sheet's Done button steps aside.
  const show = () => {
    const sheet = sheetEl();
    const top = sheet?.open ? sheet.scrollTop : 0;
    const body = editor.section(section);
    ui.openSheet(TITLES[section], body, ...(editor.editingRow() ? [] : [el('div', { class: 'cp-sheet-actions' }, ui.doneButton())]));
    if (sheet) sheet.scrollTop = editor.editingRow() ? 0 : top;
  };
  const editor = rhythmEditor({ plan, locked: () => isLocked, redraw: () => { if (sheetEl()?.open) show(); } });
  const open = (s: RhythmSection, momentId?: string) => {
    section = s;
    editor.focus(momentId);
    sheetEl()?.close();
    show();
  };
  // The sheet never closes over a job she's still editing (×, the backdrop or Escape): Done or Cancel first.
  const guard = (e: Event) => { if (!editor.dirty()) return; e.preventDefault(); e.stopPropagation(); editor.warn(); const s = sheetEl(); if (s) s.scrollTop = 0; };
  const sheet = sheetEl();
  sheet?.addEventListener('cancel', guard);
  sheet?.addEventListener('click', (e) => { const t = e.target as HTMLElement; if (t === sheet || t.closest('[data-cp-sheet-close]')) guard(e); }, true);
  sheet?.addEventListener('close', () => { if (!editor.dirty()) editor.reset(); });
  q('[data-mrm-restore] button').addEventListener('click', () => {
    const before = structuredClone(plan().state());
    plan().update((s) => restorePlan(s));
    ui.toast('The prepared plan is back.', () => plan().replace(before));
  });

  const mounted = mountPlanScreen<RhythmState>({ root, host, approvalKey: APPROVAL_KEY, render });
  if (mounted) ui = mounted;
}
</script>

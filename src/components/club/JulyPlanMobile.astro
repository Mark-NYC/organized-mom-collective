---
/**
 * July Activity Board on phones and tablets (below 1100px): whose board, how they play, the three groups of
 * activities and the words on the sheet, inside the shared ClubPlanScreen. It reads and changes the plan only through
 * the printable's controller (`.jab` root's `clubPlan`, src/lib/club/engines/july-activity-board.ts).
 */
import ClubPlanScreen from './plan/ClubPlanScreen.astro';
interface Props { deadline: string }
const { deadline } = Astro.props;
---
<ClubPlanScreen deadline={deadline} kicker="July · Organized Family Club" sheets={['sheet']} previewNote="One activity board, ready to print">
  <Fragment slot="title">I’m Bored! <em>What Can I Do?</em></Fragment>
  <section class="cp-section" aria-labelledby="ypm-who-title">
    <h2 id="ypm-who-title">Whose board</h2>
    <p class="cp-intro">Each child keeps their own board. The sheet prints the one you choose.</p>
    <ul class="cp-group" data-ypm-who></ul>
  </section>
  <section class="cp-section" aria-labelledby="ypm-acts-title">
    <h2 id="ypm-acts-title">Activities</h2>
    <p class="cp-intro">Up to three in each group, right for their age. Kids start them without asking.</p>
    <ul class="cp-group" data-ypm-tiers></ul>
    <p class="ypm-note">Keep activities your child can safely start with supplies you already have. Supervise where needed.</p>
  </section>
  <section class="cp-section" aria-labelledby="ypm-words-title">
    <h2 id="ypm-words-title">Words on your printable</h2>
    <ul class="cp-group" data-ypm-words></ul>
    <p class="ypm-restore" data-ypm-restore hidden><button type="button" class="cp-link"><span>Restore this board</span></button><span data-ypm-restore-note></span></p>
  </section>
</ClubPlanScreen>

<style is:global>
@media screen and (max-width:1099px){
.ypm-restore{display:grid;margin:6px 0 0;font-size:.85rem;line-height:1.45;color:var(--cp-soft)}
.ypm-restore[hidden]{display:none}
.ypm-note{margin:10px 0 0;font-size:.82rem;line-height:1.5;color:var(--cp-soft)}
.ypm-label{font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--cp-soft)}
}
</style>

<script>
import { el } from '../../lib/club/plan/dom';
import { mountPlanScreen, type PlanScreen } from '../../lib/club/plan/screen';
import {
  FOCUS, INTERESTS, LABEL_LIMIT, PARTICIPATION, PER_TIER, TEXT_LIMIT, TIERS, TIER_INFO, available, boardChanged, boardOf,
  ideaById, relabel, restoreBoard, setChild, setFocus, setInterest, setParticipation, setText, toggleActivity,
  type Focus, type JulyPlan, type JulyState, type Participation, type Tier,
} from '../../lib/club/engines/july-activity-board';

const APPROVAL_KEY = 'omc:preview:july-activity-board:approval';
const root = document.querySelector<HTMLElement>('.club-plan:has(.jab)');
const jab = root?.querySelector<HTMLElement & { clubPlan?: JulyPlan }>('.jab');
if (root && jab) {
  const plan = () => jab.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  let ui: PlanScreen<JulyState>;

  const row = (label: string, title: string, detail: string, open: () => void, locked: boolean, lead: Node = el('span')) => {
    const b = el('button', { type: 'button', class: 'cp-row', disabled: locked }, lead,
      el('span', { class: 'cp-row-text' }, el('span', { class: 'ypm-label' }, label), el('strong', {}, title), detail ? el('span', {}, detail) : ''),
      el('span', { class: 'cp-chev', 'aria-hidden': 'true' }));
    b.setAttribute('aria-label', `${label}: ${title}.${locked ? '' : ' Change'}`);
    b.addEventListener('click', open);
    return el('li', {}, b);
  };

  const render = (_ui: PlanScreen<JulyState>, s: JulyState, locked: boolean) => {
    const v = plan().view();
    const b = v.board;
    q('[data-ypm-who]').replaceChildren(
      row('Board for', v.childName, `Ideas for age ${v.age}`, openChild, locked, el('span', { class: 'cp-avatar' }, v.childName.charAt(0))),
      row('How they play', PARTICIPATION[b.participation].label, `${INTERESTS[b.interest] ?? 'A bit of everything'} · ${FOCUS[b.focus]}`, openStyle, locked));
    q('[data-ypm-tiers]').replaceChildren(...TIERS.map((t) => row(TIER_INFO[t].title, v.tiers[t].length ? v.tiers[t].map((i) => i.label).join(', ') : 'No activities yet', TIER_INFO[t].subtitle, () => openTier(t), locked)));
    q('[data-ypm-words]').replaceChildren(row('Under the title and at the bottom', v.intro, v.rule, openWords, locked));
    q('[data-ypm-restore]').hidden = locked || !boardChanged(s, plan().members());
    q('[data-ypm-restore-note]').textContent = `Puts back the prepared activities and wording on ${v.childName === 'My children' ? 'the family' : `${v.childName}’s`} board. Other boards stay.`;
  };

  const chips = (label: string, items: { value: string; text: string; disabled?: boolean }[], current: string, pick: (v: string) => void) => {
    const g = el('div', { class: 'cp-chips', role: 'group' });
    g.setAttribute('aria-label', label);
    for (const it of items) {
      const c = el('button', { type: 'button', class: 'cp-chip', disabled: Boolean(it.disabled) }, it.text);
      c.setAttribute('aria-pressed', String(it.value === current));
      c.addEventListener('click', () => pick(it.value));
      g.append(c);
    }
    return el('div', { class: 'cp-field' }, el('span', {}, label), g);
  };
  const openChild = () => {
    const p = plan();
    const v = p.view();
    ui.openSheet('Whose board?',
      chips('Board for', [{ value: 'family', text: 'My children' }, ...v.kids.map((k) => ({ value: k.id, text: k.name }))], v.child, (id) => { p.update((s) => setChild(s, id, p.members())); openChild(); }),
      el('p', { class: 'cp-sheet-hint' }, 'Switching keeps each child’s board as you left it.'),
      el('div', { class: 'cp-sheet-actions' }, ui.doneButton()));
  };
  const openStyle = () => {
    const p = plan();
    const v = p.view();
    const b = v.board;
    ui.openSheet('How they play',
      chips('Play with', (Object.keys(PARTICIPATION) as Participation[]).map((k) => ({ value: k, text: PARTICIPATION[k].label, disabled: k === 'sibling' && v.kids.length < 2 })), b.participation, (x) => { p.update((s) => setParticipation(s, x as Participation, p.members())); openStyle(); }),
      chips('They enjoy', Object.entries(INTERESTS).map(([value, text]) => ({ value, text })), b.interest, (x) => { p.update((s) => setInterest(s, x, p.members())); openStyle(); }),
      chips('Activity style', (Object.keys(FOCUS) as Focus[]).map((k) => ({ value: k, text: FOCUS[k] })), b.focus, (x) => { p.update((s) => setFocus(s, x as Focus, p.members())); openStyle(); }),
      el('p', { class: 'cp-sheet-hint' }, 'Each choice suggests age-right activities on this board. You can still pick your own.'),
      el('div', { class: 'cp-sheet-actions' }, ui.doneButton()));
  };
  const openTier = (t: Tier) => {
    const p = plan();
    const members = p.members();
    const b = boardOf(p.state(), members);
    const picked = b[t].map((x) => x.id);
    const g = el('div', { class: 'cp-chips', role: 'group' });
    g.setAttribute('aria-label', TIER_INFO[t].title);
    for (const idea of available(t, b, p.view().age)) {
      const on = picked.includes(idea.id);
      const c = el('button', { type: 'button', class: 'cp-chip', disabled: !on && picked.length >= PER_TIER }, idea.label);
      c.setAttribute('aria-pressed', String(on));
      c.addEventListener('click', () => { p.update((s) => toggleActivity(s, t, idea.id, p.members())); openTier(t); });
      g.append(c);
    }
    const names = b[t].map((it, i) => {
      const input = el('input', { type: 'text', maxLength: LABEL_LIMIT, value: it.label });
      input.addEventListener('change', () => p.update((s) => relabel(s, t, i, input.value, p.members())));
      return el('label', { class: 'cp-field' }, `Name on the board: ${ideaById(t, it.id)?.label ?? it.label}`, input);
    });
    const next = TIERS[TIERS.indexOf(t) + 1];
    const actions = el('div', { class: 'cp-sheet-actions' }, ui.doneButton());
    if (next) { const n = el('button', { type: 'button', class: 'cp-btn' }, `Next: ${TIER_INFO[next].title} ›`); n.addEventListener('click', () => openTier(next)); actions.append(n); }
    ui.openSheet(TIER_INFO[t].title, el('p', { class: 'cp-sheet-hint' }, `Choose up to ${PER_TIER}. ${picked.length} chosen.`), g, ...names, actions);
  };
  const openWords = () => {
    const p = plan();
    const v = p.view();
    const field = (k: 'intro' | 'rule', label: string, value: string) => {
      const input = el('textarea', { maxLength: TEXT_LIMIT, value });
      input.addEventListener('input', () => p.update((s) => setText(s, k, input.value, p.members())));
      return el('label', { class: 'cp-field' }, label, input);
    };
    ui.openSheet('Words on your printable', field('intro', 'Under the title', v.intro), field('rule', 'At the bottom', v.rule),
      el('p', { class: 'cp-sheet-hint' }, 'Blank goes back to the original wording.'), el('div', { class: 'cp-sheet-actions' }, ui.doneButton()));
  };
  q('[data-ypm-restore] button').addEventListener('click', () => {
    const before = structuredClone(plan().state());
    plan().update((s) => restoreBoard(s, plan().members()));
    ui.toast('This board is back to its prepared activities.', () => plan().replace(before));
  });

  const mounted = mountPlanScreen<JulyState>({ root, host: jab, approvalKey: APPROVAL_KEY, render });
  if (mounted) ui = mounted;
}
</script>

---
/**
 * The Family Rhythm's desktop rail (1100px and wider), shared by March (/app/club/march) and the Welcome resource
 * (/app/club/family-rhythm): the shared ClubPlanDesktop with Our moments, Who owns what and This week's habits, each
 * opening the printable's editor (MarchFamilyRhythm.astro). Put it in ClubPlanShell's `desktop` slot. The approval key
 * follows the page: the Welcome resource's is kept on her account (src/lib/club/plan/family.ts), March's in the tab.
 */
import ClubPlanDesktop from './plan/ClubPlanDesktop.astro';
interface Props { deadline: string; kicker: string; instructions: string[] }
const { deadline, kicker, instructions } = Astro.props;
---
<ClubPlanDesktop deadline={deadline} kicker={kicker} instructions={instructions}>
  <Fragment slot="title">Our Family <em>Rhythm</em></Fragment>
  <div class="cpd-details">
    <section class="cpd-block" aria-labelledby="mch-d-moments">
      <p class="cpd-label" id="mch-d-moments">Our moments</p>
      <dl class="cpd-rows" data-mch-d-moments></dl>
      <button type="button" class="cpd-link" data-mch-d-open="moments">Change our moments</button>
    </section>
    <section class="cpd-block" aria-labelledby="mch-d-owners">
      <p class="cpd-label" id="mch-d-owners">Who owns what</p>
      <ul class="mch-d-people" data-mch-d-people></ul>
      <button type="button" class="cpd-link" data-mch-d-open="owners">Change who owns what</button>
    </section>
    <section class="cpd-block" aria-labelledby="mch-d-habits">
      <p class="cpd-label" id="mch-d-habits">This week, we’re practicing</p>
      <ul class="mch-d-habits" data-mch-d-habits></ul>
      <button type="button" class="cpd-link" data-mch-d-open="habits">Choose our new habits</button>
      <button type="button" class="cpd-link" data-mch-d-restore hidden>Start over with the prepared plan</button>
      <p class="cpd-hint" data-mch-d-restored role="status" tabindex="-1"></p>
    </section>
  </div>
</ClubPlanDesktop>
<style is:global>
.mch-tabs-desktop{display:none}
@media screen and (min-width:1100px){.mch-tabs-desktop{display:block}}
.mch-d-people,.mch-d-habits{list-style:none;margin:0 0 6px;padding:0;display:grid;gap:4px;font-size:.88rem}
.mch-d-people li{display:flex;align-items:baseline;gap:8px}
.mch-d-people .mc-owner{flex:none}
.mch-d-people span.mch-d-jobs{color:var(--color-warm-soft,#6e6461)}
</style>
<script>
import { restorePlan, type RhythmPlanResource, type RhythmState } from '../../lib/club/engines/family-rhythm';
import { ownerTag } from '../../lib/club/personalize/marks';
import { mountPlanDesktop } from '../../lib/club/plan/desktop';
import { el } from '../../lib/club/plan/dom';
import { WELCOME_APPROVAL_KEY } from '../../lib/club/plan/family';
import { isWelcomeResource } from '../../lib/club/plan/resource';

const root = document.querySelector<HTMLElement>('.club-plan');
const host = root?.querySelector<HTMLElement & { clubPlan?: RhythmPlanResource }>('[data-mfr]');
if (root && host) {
  const plan = () => host.clubPlan!;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const restored = q('[data-mch-d-restored]');
  let undo: RhythmState | null = null;
  mountPlanDesktop<RhythmState>({
    root,
    host,
    approvalKey: isWelcomeResource(root) ? WELCOME_APPROVAL_KEY : 'omc:preview:march-chore-charts:approval',
    edit: () => plan().openEditor(),
    lock: (on) => plan().setLocked(on),
    render: (_r, locked) => {
      const v = plan().view();
      q('[data-mch-d-moments]').replaceChildren(...v.moments.filter((m) => m.enabled).map((m) =>
        el('div', {}, el('dt', {}, m.title), el('dd', {}, `Cue: ${m.cue.toLowerCase()}`))));
      // Who owns what: everyone's parts, so she sees the share at a glance (not everyone needs one in each moment).
      q('[data-mch-d-people]').replaceChildren(...v.people.map((p) => {
        const jobs = v.printed.flatMap((m) => m.rows.filter((r) => r.owners.some((o) => o.id === p.id)));
        return el('li', {}, ownerTag(p.name, p.color), el('span', { class: 'mch-d-jobs' }, jobs.length ? jobs.map((r) => r.title).join(', ') : 'No part yet'));
      }));
      q('[data-mch-d-habits]').replaceChildren(...(v.habits.length ? v.habits.map((h) => el('li', {}, h.sentence)) : [el('li', {}, 'None chosen')]));
      root.querySelectorAll<HTMLButtonElement>('[data-mch-d-open]').forEach((b) => { b.disabled = locked; });
      q('[data-mch-d-restore]').hidden = locked || !v.changed;
    },
  });
  root.querySelectorAll<HTMLButtonElement>('[data-mch-d-open]').forEach((b) => b.addEventListener('click', () => plan().openEditor(b.dataset.mchDOpen as 'moments' | 'owners' | 'habits')));
  q('[data-mch-d-restore]').addEventListener('click', () => {
    undo = structuredClone(plan().state());
    plan().update((s) => restorePlan(s));
    const u = el('button', { type: 'button', class: 'cpd-undo' }, 'Undo');
    u.addEventListener('click', () => { if (undo) plan().replace(undo); undo = null; restored.textContent = 'Changes put back.'; });
    restored.replaceChildren('The prepared plan is back. ', u);
    restored.focus();
  });
}
</script>

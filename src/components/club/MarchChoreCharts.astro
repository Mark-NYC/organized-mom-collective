---
/**
 * March 2027 family chore charts: one landscape chart per child (11 × 8.5 in), prepared from the family profile:
 * the child's name, Weekly Chore Chart, "My jobs, start to finish.", their daily chores with a box per day (only the
 * chores they have, no blank rows), one weekly job per weekday with one box (or a day off), and one ownership line.
 * No rewards. Rules: src/lib/club/engines/march-chore-charts.ts; editor: src/lib/club/march-chore-editor.ts; icons:
 * src/data/club/march-chore-icons.ts. On the Club plan page (/app/club/march) the page brings the layout, rail and
 * mobile screen; this keeps the editor dialog and the sheets, marked data-plan-sheet ("k0", "k1", …), and publishes
 * the plan as `clubPlan` (docs/club/PLAN_ARCHITECTURE.md).
 *
 * Printing: the shared rules (ClubPrintStyles.astro) print portrait Letter pages for every month. Where the browser
 * has named pages (`page`: Chrome, Edge, Firefox) the charts print on their own landscape Letter pages instead,
 * upright in a saved PDF; the script adds that @page. Elsewhere (Safari) each chart is turned a quarter on the shared
 * portrait page, so the paper still comes out landscape.
 */
import '@fontsource/kalam/latin-700.css';
interface Props { storageKey: string }
const { storageKey } = Astro.props;
---
<div class="mcc" data-mcc data-mcc-key={storageKey}>
  <dialog class="mcc-dialog" data-mcc-editor aria-labelledby="mcc-editor-title">
    <div class="mcc-dialog-head">
      <div><p class="mcc-dialog-kicker">Make it yours · March</p><h2 id="mcc-editor-title">Our family chore charts</h2></div>
      <button type="button" class="mcc-close" data-mcc-close aria-label="Close">×</button>
    </div>
    <div class="mcc-tabs" role="tablist" aria-label="Whose chart" data-mcc-tabs></div>
    <div data-mcc-editor-body></div>
    <div class="mcc-dialog-actions"><button type="button" class="mcc-done" data-mcc-close>Done · See our charts</button></div>
  </dialog>
  <div class="mcc-sheets" data-mcc-pages></div>
  <p class="mcc-empty" data-mcc-empty hidden>Add your children to your family profile and their chore charts are prepared here.</p>
</div>

<style is:global>
.mcc{--mcc-ink:#4d4544;--mcc-soft:#7d726c;--mcc-rose-deep:#96666b;--mcc-rule:#b6aaa4;--mcc-a:#EFEBE7;--mcc-b:#E6EEEA;--mcc-c:#F6F1E7}
.mcc-sheets{display:flex;flex-direction:column;align-items:center;gap:26px}
.mcc-stage{position:relative;margin:0 auto;flex:none}
.mcc-sheet{position:absolute;left:0;top:0;width:1056px;height:816px;transform:scale(var(--mcc-scale,1));transform-origin:top left;overflow:hidden;background:#fff;box-shadow:0 10px 30px #3d38311f}
.mcc-empty{max-width:520px;margin:40px auto;text-align:center;font-size:15px;line-height:1.7;color:#7d726c}
.mcc-empty[hidden]{display:none}

/* The chart (1056 × 816 px = 11 × 8.5 in). Daily sizes come from the number of daily chores (--mcc-row, --mcc-row-max,
   --mcc-box, --mcc-icon, --mcc-text, set by the script): a short list gets larger rows, boxes, pictures and words,
   rows grow only to their maximum, and the rows sit together in the middle of the card. */
.mcc-paper{position:absolute;left:0;top:0;width:1056px;height:816px;box-sizing:border-box;display:flex;flex-direction:column;padding:34px 36px 24px;font-family:var(--font-sans);color:var(--mcc-ink)}
.mcc-paper *{box-sizing:border-box}
.mcc-head{flex:none;margin-bottom:16px;text-align:center}
.mcc-for{font:700 30px/1.15 Kalam,var(--font-serif);letter-spacing:.03em}
.mcc-title{margin-top:2px;font:700 24px/1.15 var(--font-sans);letter-spacing:.14em;text-transform:uppercase}
.mcc-motto{margin:6px 0 0;font:italic 400 17px/1.3 var(--font-serif);color:var(--mcc-rose-deep)}
.mcc-main{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,1.75fr) minmax(0,1fr);gap:20px}
.mcc-main.mcc-solo{grid-template-columns:minmax(0,420px);justify-content:center}
.mcc-daily,.mcc-weekly{display:flex;flex-direction:column;min-width:0;min-height:0;padding:12px 18px 16px;border:2px solid var(--mcc-a);border-radius:16px}
.mcc-weekly{border-color:var(--mcc-b)}
.mcc-section-title{flex:none;margin-bottom:8px;font:700 28px/1.2 Kalam,var(--font-serif);letter-spacing:.04em;text-align:center}
.mcc-table{flex:1;min-height:0;display:grid;row-gap:6px;align-content:center}
.mcc-daily .mcc-table{grid-template-rows:auto;grid-auto-rows:minmax(var(--mcc-row),var(--mcc-row-max))}
.mcc-weekly .mcc-table{grid-auto-rows:minmax(56px,70px)}
.mcc-days,.mcc-row{display:grid;grid-template-columns:minmax(0,1fr) repeat(7,var(--mcc-box));column-gap:6px;align-items:center}
.mcc-days{margin-bottom:2px}
.mcc-day{padding:5px 0;border-radius:7px;background:var(--mcc-c);font:700 12px/1 var(--font-sans);letter-spacing:.04em;text-align:center}
.mcc-chore{display:flex;align-items:center;gap:10px;min-width:0;height:100%;padding:4px 14px 4px 8px;border-radius:12px;background:var(--mcc-hl);font:500 var(--mcc-text)/1.2 var(--font-sans)}
.mcc-chore:not(:has(.mcc-slot)){padding-left:16px}
.mcc-chore.mcc-long{font-size:calc(var(--mcc-text) - 2px)}
.mcc-chore-text{min-width:0;overflow-wrap:break-word}
.mcc-row:nth-child(3n+2) .mcc-chore,.mcc-week-row:nth-child(3n+1) .mcc-chore{--mcc-hl:var(--mcc-b)}
.mcc-row:nth-child(3n+3) .mcc-chore,.mcc-week-row:nth-child(3n+2) .mcc-chore{--mcc-hl:var(--mcc-c)}
.mcc-row:nth-child(3n+4) .mcc-chore,.mcc-week-row:nth-child(3n+3) .mcc-chore{--mcc-hl:var(--mcc-a)}
/* The icon slot is a fixed square whatever the artwork's own size: transparent art, contained, no backdrop. */
.mcc-slot{flex:none;width:var(--mcc-icon);height:var(--mcc-icon)}
.mcc-icon{display:block;width:100%;height:100%;object-fit:contain}
.mcc-box{width:var(--mcc-box);height:var(--mcc-box);border:1.5px solid var(--mcc-rule);border-radius:8px;background:#fff}
/* Weekly: the day is a small label inside each job, so the job has room to read. */
.mcc-weekly{--mcc-icon:40px;--mcc-text:15px;--mcc-box:36px}
.mcc-week-row{display:grid;grid-template-columns:minmax(0,1fr) var(--mcc-box);column-gap:10px;align-items:center}
.mcc-weekday{display:block;margin-bottom:2px;font:700 10.5px/1.2 var(--font-sans);letter-spacing:.13em;text-transform:uppercase;color:var(--mcc-soft)}
.mcc-off{grid-column:1/-1;display:flex;flex-direction:column;justify-content:center;height:100%;padding:4px 16px;border:1.5px dashed #d6ccc6;border-radius:12px}
.mcc-off-text{font:700 19px/1.1 Kalam,var(--font-serif);letter-spacing:.03em;color:#968b86}
/* One to three daily chores (the youngest): the daily chores across the top, larger, and the week as seven tiles
   below, so a short list fills the sheet without stretched rows. */
.mcc-main.mcc-few{display:flex;flex-direction:column;justify-content:center;gap:14px}
.mcc-few .mcc-daily{flex:none}
.mcc-few .mcc-daily .mcc-table{flex:none;width:min(100%,800px);margin:0 auto}
.mcc-few .mcc-weekly{flex:none;padding-bottom:14px;--mcc-icon:42px;--mcc-text:14px}
.mcc-few .mcc-weekly .mcc-table{grid-template-columns:repeat(7,minmax(0,1fr));grid-auto-rows:auto;column-gap:10px}
.mcc-few .mcc-week-row{display:flex;flex-direction:column;align-items:center;gap:6px}
.mcc-few .mcc-week-row .mcc-chore{flex:1;width:100%;flex-direction:column;justify-content:flex-start;gap:4px;padding:8px 6px;text-align:center}
.mcc-few .mcc-weekly .mcc-chore.mcc-long{font-size:13px}
.mcc-few .mcc-weekly .mcc-chore-text{display:contents}
.mcc-few .mcc-weekly .mcc-weekday{order:-1;margin:0 0 auto;letter-spacing:.1em}
.mcc-few .mcc-weekly .mcc-chore-name{margin-bottom:auto}
.mcc-few .mcc-off{flex:1;width:100%;align-items:center;justify-content:flex-start;padding:8px 6px}
.mcc-few .mcc-off-text{margin:auto 0}
.mcc-foot{flex:none;margin:12px 0 0;font:500 13px/1.4 var(--font-sans);letter-spacing:.02em;text-align:center;color:var(--mcc-soft)}
@media print{
  .mcc-dialog,.mcc-empty{display:none!important}
  .mcc-paper{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
/* Printing. With named pages (Chrome, Edge, Firefox) the script sets html[data-mcc-print="landscape"] and adds the
   landscape @page: the charts get landscape Letter pages, upright on paper and in a saved PDF. Each rule adds to the
   shared print rule it widens, so it wins without touching the other months. Without (Safari, or before the
   script runs): a landscape chart on the shared portrait page, turned a quarter to fill the sheet. The same rules
   apply on the member's copy (/club/resources/<slug>, the fulfillment print), whose print root is data-plan-print-root. */
@media print{
  html:not([data-mcc-print="landscape"]) :is(.club-plan[data-plan-state="ready"],[data-plan-print-root]) .mcc-paper{transform:translateX(8.5in) rotate(90deg)!important;transform-origin:top left!important}
  html[data-mcc-print="landscape"]:has(:is(.club-plan[data-plan-state="ready"],[data-plan-print-root]) .mcc),html[data-mcc-print="landscape"]:has(:is(.club-plan[data-plan-state="ready"],[data-plan-print-root]) .mcc) body{width:11in!important}
  html[data-mcc-print="landscape"] body:has(:is(.club-plan[data-plan-state="ready"],[data-plan-print-root]) .mcc) #main{width:11in!important}
  html[data-mcc-print="landscape"] :is(.club-plan[data-plan-state="ready"],[data-plan-print-root]):not(#plan-print),html[data-mcc-print="landscape"] :is(.club-plan[data-plan-state="ready"],[data-plan-print-root]) :not(#plan-print):has([data-plan-sheet]){width:11in!important}
  html[data-mcc-print="landscape"] :is(.club-plan[data-plan-state="ready"],[data-plan-print-root]) [data-plan-sheet]:not(#plan-print){width:11in!important;height:8.5in!important;page:mcc-chart}
}

/* The editor dialog (desktop) and edit sheets (phones) share these. */
.mcc-dialog{position:fixed;inset:0;margin:auto;box-sizing:border-box;width:min(620px,calc(100vw - 32px));max-height:calc(100dvh - 48px);overflow-y:auto;padding:24px 26px;background:var(--color-ivory,#fffdfa);border:1px solid var(--color-warm-rule,#e7ddd4);border-radius:3px;box-shadow:0 20px 65px #0003;color:var(--color-warm-ink,#4d4544);z-index:100}
.mcc-dialog::backdrop{background:rgba(33,30,29,.5)}
.mcc-dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}
.mcc-dialog-head h2{margin:6px 0 0;font:400 28px/1.15 var(--font-serif,Georgia,serif)}
.mcc-dialog-kicker{margin:0;font-size:.7rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--color-warm-soft,#6e6461)}
.mcc-close{width:44px;height:44px;flex:none;border:0;background:none;font-size:28px;cursor:pointer;color:var(--color-warm-ink,#4d4544)}
.mcc-tabs{display:flex;flex-wrap:wrap;gap:4px 22px;margin:14px 0 6px;border-bottom:1px solid var(--color-warm-rule,#e7ddd4)}
.mcc-tabs button{min-height:44px;margin-bottom:-1px;padding:8px 2px;border:0;border-bottom:2px solid transparent;background:none;color:var(--color-warm-soft,#6e6461);font:600 .75rem var(--font-sans);letter-spacing:.14em;text-transform:uppercase;cursor:pointer}
.mcc-tabs button[aria-selected="true"]{color:var(--color-warm-ink,#4d4544);border-bottom-color:var(--color-warm-button,#4a3f3e)}
.mcc-dialog-actions{margin-top:20px}
.mcc-done{width:100%;min-height:48px;border:0;border-radius:3px;background:var(--color-warm-button,#4a3f3e);color:#fff;font:600 .75rem var(--font-sans);letter-spacing:.14em;text-transform:uppercase;cursor:pointer}
.mcc-ed{display:grid;gap:8px}
.mcc-ed-h{margin:16px 0 0;font:400 1.3rem/1.2 var(--font-serif,Georgia,serif);color:var(--color-warm-ink,#4d4544)}
.mcc-ed-hint{margin:0;font-size:.85rem;line-height:1.5;color:var(--color-warm-soft,#6e6461)}
.mcc-ed-label{margin:6px 0 0;font-size:.7rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--color-warm-soft,#6e6461)}
.mcc-ed-list{display:grid;border-top:1px solid var(--color-warm-rule,#e7ddd4)}
.mcc-ed-job{display:grid;gap:8px;padding:12px 0;border-bottom:1px solid var(--color-warm-rule,#e7ddd4)}
.mcc-ed-row{display:flex;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--color-warm-rule,#e7ddd4)}
.mcc-ed-row input{flex:1;min-width:0}
.mcc-ed input[type="text"]{min-height:44px;padding:10px 12px;border:1px solid #d7d3cc;border-radius:3px;background:#fff;font:400 1rem var(--font-sans);color:var(--color-warm-ink,#4d4544);width:100%;box-sizing:border-box}
.mcc-ed-remove{flex:none;min-height:44px;padding:0 6px;border:0;background:none;color:var(--color-warm-soft,#6e6461);font-size:.85rem;font-weight:600;text-decoration:underline;text-underline-offset:4px;cursor:pointer}
.mcc-ed-day{margin:0;font-size:.85rem;color:var(--color-warm-soft,#6e6461)}
.mcc-ed-day strong{color:var(--color-warm-ink,#4d4544)}
.mcc-ed-chips{display:flex;flex-wrap:wrap;gap:6px}
.mcc-ed-chip{min-height:44px;padding:8px 12px;border:1px solid var(--color-warm-rule,#e7ddd4);border-radius:3px;background:#fff;color:var(--color-warm-ink,#4d4544);font:500 .85rem var(--font-sans);cursor:pointer;text-align:left}
.mcc-ed-chip[aria-pressed="true"]{background:var(--color-warm-button,#4a3f3e);border-color:var(--color-warm-button,#4a3f3e);color:#fff}
.mcc-ed-chip:disabled{opacity:.45;cursor:not-allowed}
.mcc-dialog :focus-visible,.cp-sheet .mcc-ed :focus-visible{outline:2px solid var(--color-warm-button,#4a3f3e);outline-offset:2px}
</style>

<script>
import {
  applyFamily, choreFingerprint, choreView, freshState, isChoreState,
  type ChartView, type ChoreMember, type ChorePlan, type ChoreState, type Job,
} from '../../lib/club/engines/march-chore-charts';
import type { MarchIconArt } from '../../data/club/march-chore-icons';
import { familyEditor, kidEditor } from '../../lib/club/march-chore-editor';
import { el } from '../../lib/club/plan/dom';
import { PLAN_CHANGE } from '../../lib/club/plan/resource';
import { planKey, readScoped, tabStorage } from '../../lib/club/plan/storage';
import { toolPalettes } from '../../data/tool-palettes';

type Detail = { household: { id: string; members?: ChoreMember[]; preferences?: { pets?: boolean } } | null; sample?: string | null };
const root = document.querySelector<HTMLElement & { clubPlan?: ChorePlan }>('[data-mcc]');
if (root) {
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const key = root.dataset.mccKey ?? 'omc:club:march-chore-charts:v2';
  let current = '', members: ChoreMember[] = [], pets = false, state: ChoreState = freshState(), persist = true, locked = false;
  const save = () => { if (persist && current) tabStorage.set(key, JSON.stringify({ current, state })); };

  const fit = () => root.querySelectorAll<HTMLElement>('.mcc-stage').forEach((stage) => {
    const scale = Math.min(1, Math.max(240, (q('[data-mcc-pages]').clientWidth || 1056) - 4) / 1056);
    stage.style.width = `${1056 * scale}px`;
    stage.style.height = `${816 * scale}px`;
    stage.querySelector<HTMLElement>('.mcc-sheet')?.style.setProperty('--mcc-scale', String(scale));
  });
  if (typeof ResizeObserver !== 'undefined') new ResizeObserver(fit).observe(q('[data-mcc-pages]'));
  window.addEventListener('resize', fit);

  // Sizes for the number of daily chores: a short list gets larger rows, boxes, pictures and words.
  const density = (n: number) => (n <= 3 ? [{ row: 104, 'row-max': 104, box: 56, icon: 68, text: 24 }, { row: 96, 'row-max': 96, box: 54, icon: 64, text: 22 }, { row: 84, 'row-max': 84, box: 52, icon: 58, text: 21 }][Math.max(0, n - 1)]
    : n <= 5 ? { row: 70, 'row-max': 96, box: 44, icon: 50, text: 18 }
      : n <= 6 ? { row: 64, 'row-max': 84, box: 42, icon: 46, text: 17 } : { row: 54, 'row-max': 62, box: 40, icon: 42, text: 16 });
  // A chore with a picture has a fixed-size slot for it; one without starts its words at the edge, no placeholder.
  const chore = (j: Job & { icon: MarchIconArt | null }, long: number, day?: string) => {
    const cell = el('span', { class: `mcc-chore${j.title.length > long ? ' mcc-long' : ''}` });
    if (j.icon) {
      const img = el('img', { class: 'mcc-icon', src: j.icon.src, alt: '', decoding: 'async' });
      img.dataset.icon = j.icon.name;
      const slot = el('span', { class: 'mcc-slot' }, img);
      // A file that fails to load takes its slot with it: never a broken image.
      img.addEventListener('error', () => slot.remove(), { once: true });
      cell.append(slot);
    }
    cell.append(el('span', { class: 'mcc-chore-text' }, ...(day ? [el('span', { class: 'mcc-weekday' }, day)] : []), el('span', { class: 'mcc-chore-name' }, j.title)));
    return cell;
  };
  const sheet = (c: ChartView, i: number, last: boolean) => {
    const page = el('article', { class: 'mcc-sheet' });
    page.dataset.planSheet = `k${i}`;
    page.dataset.planWidth = '1056';
    if (last) page.setAttribute('data-plan-sheet-end', '');
    page.setAttribute('aria-label', `${c.name}’s chore chart`);
    const d = density(c.daily.length);
    const daily = c.daily.length ? el('section', { class: 'mcc-daily' }, el('div', { class: 'mcc-section-title' }, 'Daily chores'),
      el('div', { class: 'mcc-table' },
        el('div', { class: 'mcc-days' }, el('span'), ...['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((x) => {
          const day = el('span', { class: 'mcc-day' }, x.charAt(0));
          day.title = x;
          return day;
        })),
        ...c.daily.map((j) => el('div', { class: 'mcc-row' }, chore(j, 24), ...Array.from({ length: 7 }, () => el('span', { class: 'mcc-box' })))))) : null;
    const weekly = el('section', { class: 'mcc-weekly' }, el('div', { class: 'mcc-section-title' }, 'Weekly chores'),
      el('div', { class: 'mcc-table' }, ...c.weekly.map((w) => el('div', { class: 'mcc-week-row' },
        ...(w.job ? [chore(w.job, 22, w.label), el('span', { class: 'mcc-box' })]
          : [el('span', { class: 'mcc-off' }, el('span', { class: 'mcc-weekday' }, w.label), el('span', { class: 'mcc-off-text' }, 'Day off'))])))));
    const paper = el('div', { class: 'mcc-paper' },
      el('div', { class: 'mcc-head' }, el('div', { class: 'mcc-for' }, `${c.name}’s`), el('div', { class: 'mcc-title' }, 'Weekly Chore Chart'), el('p', { class: 'mcc-motto' }, 'My jobs, start to finish.')),
      el('div', { class: `mcc-main${!daily ? ' mcc-solo' : c.daily.length <= 3 ? ' mcc-few' : ''}` }, ...(daily ? [daily] : []), weekly),
      el('p', { class: 'mcc-foot' }, 'My jobs are finished when I’ve done the work and put everything away.'));
    Object.entries(d).forEach(([k, v]) => paper.style.setProperty(`--mcc-${k}`, `${v}px`));
    page.append(paper);
    return el('div', { class: 'mcc-stage' }, page);
  };
  const draw = () => {
    const v = choreView(state, members, pets);
    const colors = toolPalettes[v.palette].colors;
    root.style.setProperty('--mcc-a', colors[0]);
    root.style.setProperty('--mcc-b', colors[1]);
    root.style.setProperty('--mcc-c', colors[2]);
    q('[data-mcc-pages]').replaceChildren(...v.charts.map((c, i) => sheet(c, i, i === v.charts.length - 1)));
    q('[data-mcc-empty]').hidden = v.charts.length > 0;
    fit();
  };

  // The desktop editor: a tab per child and one for the whole family.
  const editor = q<HTMLDialogElement>('[data-mcc-editor]');
  let tab = 'family';
  const drawEditor = () => {
    if (!editor.open) return;
    const v = choreView(state, members, pets);
    if (tab !== 'family' && !v.charts.some((c) => c.id === tab)) tab = v.charts[0]?.id ?? 'family';
    q('[data-mcc-tabs]').replaceChildren(...[...v.charts.map((c) => ({ id: c.id, name: c.name })), { id: 'family', name: 'Whole family' }].map((t) => {
      const b = el('button', { type: 'button', role: 'tab' }, t.name);
      b.setAttribute('aria-selected', String(t.id === tab));
      b.addEventListener('click', () => { tab = t.id; drawEditor(); });
      return b;
    }));
    const body = q('[data-mcc-editor-body]');
    const scroll = editor.scrollTop;
    body.replaceChildren(tab === 'family' ? familyEditor(plan, drawEditor) : kidEditor(plan, tab, drawEditor));
    editor.scrollTop = scroll;
  };
  root.querySelectorAll('[data-mcc-close]').forEach((b) => b.addEventListener('click', () => editor.close()));
  editor.addEventListener('click', (e) => { if (e.target === editor) editor.close(); });

  const changed = () => { save(); draw(); if (current) root.dispatchEvent(new Event(PLAN_CHANGE, { bubbles: true })); };
  const update = (change: (s: ChoreState) => void) => { if (locked) return; change(state); applyFamily(state, members); changed(); };

  const applyHousehold = (detail: Detail) => {
    if (!detail?.household) return;
    const next = planKey(detail.sample ?? null, detail.household.id);
    members = detail.household.members ?? [];
    pets = Boolean(detail.household.preferences?.pets);
    if (next !== current) { current = next; state = readScoped(tabStorage.get(key), current, isChoreState) ?? freshState(); }
    applyFamily(state, members);
    changed();
  };

  const plan: ChorePlan = {
    ready: () => Boolean(current),
    state: () => state,
    update,
    replace: (s) => { state = structuredClone(s); applyFamily(state, members); changed(); },
    setPersist: (on) => { persist = on; if (on) save(); },
    fingerprint: () => choreFingerprint(state, members, pets),
    members: () => members,
    pets: () => pets,
    view: () => choreView(state, members, pets),
    setLocked: (on) => { locked = on; if (on) editor.close(); },
    openEditor: (kidId) => {
      if (locked) return;
      tab = kidId ?? choreView(state, members, pets).charts[0]?.id ?? 'family';
      if (!editor.open) editor.showModal();
      drawEditor();
    },
  };
  root.clubPlan = plan;
  // Landscape print pages where the browser has named pages. The @page goes in its own stylesheet at the end of the
  // head: in Chromium a later stylesheet's plain @page size (the shared portrait rule) beats an earlier named page.
  if (typeof CSS !== 'undefined' && CSS.supports('page', 'auto')) {
    document.head.append(el('style', {}, '@media print{@page mcc-chart{size:letter landscape;margin:0}}'));
    document.documentElement.dataset.mccPrint = 'landscape';
  }
  window.addEventListener('omc:club-preview-household', (e) => applyHousehold((e as CustomEvent<Detail>).detail));
  const cached = (window as Window & { __ofcPreviewHousehold?: Detail }).__ofcPreviewHousehold;
  if (cached) applyHousehold(cached);
}
</script>

/* Match the June prepared-plan workspace: small fixed editing sidebar and large scrollable preview. */
.fvp{max-width:none;margin:0;padding:0;background:#faf9f7}
.fvp-top{padding:12px clamp(18px,3vw,45px);background:#fff;border-bottom:1px solid #e4e3df;min-height:49px}
.fvp-grid{grid-template-columns:clamp(315px,28vw,410px) minmax(0,1fr);gap:0;align-items:stretch}
.fvp-editor{display:flex;flex-direction:column;border:0;border-right:1px solid #e5e0e1;background:#faf9f7;padding:17px clamp(17px,2vw,26px);min-width:0}
.fvp-intro{margin:0 0 15px;max-width:none}
.fvp-intro h1{font-size:clamp(29px,2.7vw,38px);margin:9px 0}
.fvp-intro>p:last-child{font-size:12px;line-height:1.6;margin:0}
.fvp-editor-summary{padding:17px;background:white;border:1px solid #e5e8e0;flex:1;min-height:0}
.fvp-editor-summary strong{display:block;font:400 25px Georgia,serif;color:#53694e;margin:16px 0 8px;overflow-wrap:anywhere}
.fvp-editor-summary>p{font:italic 19px Georgia,serif;color:#708767;margin:0 0 18px}
.fvp-edit-trigger{width:100%;min-height:45px;border:1px solid #b5c6ad;background:#eff5ea;color:#4b6246;font:700 12px Montserrat,Arial,sans-serif;cursor:pointer;border-radius:4px}
.fvp-ready{margin-top:auto;padding:15px 0 0;background:transparent}
.fvp-ready strong{font-size:19px}
.fvp-ready p{margin:7px 0 12px}

.fvp-visual{background:#f5f3f2;padding:18px clamp(18px,3vw,45px) 40px;min-width:0}
.fvp-visual-head h2{margin:5px 0 13px;font-size:27px}
.fvp-scenes{margin-bottom:12px}
.fvp-room.paper{height:min(75vw,800px);max-height:800px;min-height:500px}
.fvp-caption{margin:9px 0 17px}
.fvp-note{padding:13px 0}
.fvp-note strong{font-size:18px}
.fvp-note p{margin:6px 0}
.fvp-dialog{position:fixed;inset:0;margin:auto;box-sizing:border-box;width:min(635px,calc(100vw - 32px));max-height:calc(100dvh - 40px);overflow-y:auto;overscroll-behavior:contain;padding:24px;border:1px solid #dce2d7;border-radius:10px;background:#fff;box-shadow:0 20px 65px #0003;color:#454a43;font-family:Montserrat,Arial,sans-serif}
.fvp-dialog::backdrop{background:rgba(33,40,36,.52)}
.fvp-dialog-header{display:flex;align-items:center;justify-content:space-between;gap:14px}
.fvp-dialog-header button{display:grid;place-items:center;width:37px;height:37px;border:0;border-radius:50%;background:#eff2e9;color:#53694e;font-size:25px;cursor:pointer}
.fvp-dialog>h2{font:400 29px Georgia,serif;color:#53694e;margin:8px 0}
.fvp-dialog>p{font-size:13px;line-height:1.6}
.fvp-dialog .fvp-values{grid-template-columns:repeat(4,minmax(0,1fr))}
.fvp-dialog-done{position:sticky;bottom:-24px;padding:14px 0 0;background:white}
.fvp-dialog-done button{width:100%;min-height:47px;border:0;background:#596e50;color:white;font:700 12px Montserrat,Arial,sans-serif;cursor:pointer}
@media screen and (min-width:1101px){
 html:has(.fvp),body:has(.fvp){height:100%;overflow:hidden}
 .fvp{position:fixed;top:0;bottom:0;left:0;right:0;display:flex;flex-direction:column;overflow:hidden;height:100%}
 .fvp-grid{flex:1;min-height:0}
 .fvp-editor{height:100%;overflow-y:auto}
 .fvp-visual{height:100%;overflow-y:auto;overscroll-behavior:contain}
}
@media screen and (max-width:1100px){
 .fvp-grid{display:flex;flex-direction:column}
 .fvp-visual{order:0;padding:20px 18px}
 .fvp-editor{order:1;border:0;padding:20px}
 .fvp-room.paper{height:85vw;min-height:440px}
 .fvp-editor-summary{flex:auto}
}
@media screen and (max-width:700px){
 .fvp{padding-bottom:92px}
 .fvp-top{min-height:45px;padding:10px 16px}
 .fvp-editor{padding:17px 18px}
 .fvp-visual{padding:14px}
 .fvp-visual-head h2{font-size:23px}
 .fvp-ready{position:static;margin-top:18px;padding:15px 0;background:transparent;border:0;box-shadow:none}

 

 .fvp-dialog{padding:17px;max-height:calc(100dvh - 25px)}
 .fvp-dialog .fvp-values{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media print{
 html:has(.fvp),body:has(.fvp){overflow:visible!important;height:auto!important}
 .fvp{position:static!important;display:block!important;height:auto!important;overflow:visible!important;padding:0!important}
 .fvp-grid{display:block!important}
 .fvp-visual{display:block!important;height:auto!important;overflow:visible!important;padding:0!important}
 .fvp-dialog,.fvp-editor-summary{display:none!important}
 .fvp-room.paper{height:auto!important}
}


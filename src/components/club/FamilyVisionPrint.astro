.fvp-floating-edit{position:fixed;right:clamp(22px,3vw,48px);bottom:24px;z-index:25;display:inline-flex;align-items:center;gap:9px;min-height:50px;padding:12px 19px;border:0;border-radius:999px;background:#454545;color:white;box-shadow:0 8px 25px #0003;font:700 12px Montserrat,Arial,sans-serif;cursor:pointer}

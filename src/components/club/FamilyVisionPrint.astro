</style>
<script>
const valueImages:Record<string,string>=Object.fromEntries(Array.from(document.querySelectorAll<HTMLButtonElement>('[data-value]')).map(b=>[b.dataset.value!,b.querySelector('img')!.src]));
const byId=(id:string)=>document.getElementById(id);
let selectedValue='Love';
function render(){
 const name=(byId('fvp-name') as HTMLInputElement).value.trim()||'Your Family';
 byId('fvp-art-name')!.textContent=name;
 byId('fvp-summary-name')!.textContent=name;
 byId('fvp-summary-values')!.textContent=selectedValue;
 byId('fvp-art-word')!.textContent=selectedValue;
 byId('fvp-art')!.dataset.longValue=String(selectedValue.length>=12);
 const symbol=byId('fvp-symbol')!;
 const image=symbol.querySelector('img')??document.createElement('img');
 image.src=valueImages[selectedValue];
 image.alt='';
 if(!image.parentElement)symbol.append(image);
 for(const b of document.querySelectorAll<HTMLButtonElement>('[data-value]')){
  const yes=b.dataset.value===selectedValue;
  b.classList.toggle('selected',yes);
  b.setAttribute('aria-pressed',String(yes));
 }
 byId('fvp-selection-hint')!.textContent=selectedValue+' selected. Choose a different image to replace it.';
}

const editorDialog=byId('fvp-dialog') as HTMLDialogElement;
byId('fvp-open-editor')?.addEventListener('click',()=>editorDialog.showModal());
byId('fvp-floating-edit')?.addEventListener('click',()=>editorDialog.showModal());
byId('fvp-close-editor')?.addEventListener('click',()=>editorDialog.close());
byId('fvp-done-editor')?.addEventListener('click',()=>editorDialog.close());
editorDialog.addEventListener('click',(event)=>{if(event.target===editorDialog)editorDialog.close();});
byId('fvp-name')?.addEventListener('input',render);
for(const b of document.querySelectorAll<HTMLButtonElement>('[data-value]'))b.addEventListener('click',()=>{selectedValue=b.dataset.value!;render();});
for(const b of document.querySelectorAll<HTMLButtonElement>('[data-scene]'))b.addEventListener('click',()=>{const scene=b.dataset.scene!;byId('fvp-room')!.className='fvp-room '+scene+(scene==='wall'?' fvp-photo-room':'');document.querySelectorAll('[data-scene]').forEach(x=>{x.classList.toggle('selected',x===b);x.setAttribute('aria-pressed',String(x===b));});byId('fvp-caption')!.textContent=scene==='paper'?'Your finished artwork preview. US Letter, 8.5 × 11 inches.':'Styled wall preview. Frame and decor are not included.';});

byId('fvp-reset')?.addEventListener('click',()=>{(byId('fvp-name') as HTMLInputElement).value='The Johnson Family';selectedValue='Love';document.querySelector<HTMLButtonElement>('[data-scene="wall"]')?.click();render();});
// Member page: her saved choices in, her changes out, and no changes once it's approved for print.
const changed=()=>window.dispatchEvent(new CustomEvent('omc:vision-change',{detail:{family_name:(byId('fvp-name') as HTMLInputElement).value.trim(),value:selectedValue}}));
byId('fvp-name')?.addEventListener('input',changed);
for(const b of document.querySelectorAll<HTMLButtonElement>('[data-value]'))b.addEventListener('click',changed);
window.addEventListener('omc:vision-set',(e)=>{const d=(e as CustomEvent<{family_name?:string;value?:string}>).detail;if(d.family_name)(byId('fvp-name') as HTMLInputElement).value=d.family_name;if(d.value&&valueImages[d.value])selectedValue=d.value;render();});
window.addEventListener('omc:vision-lock',(e)=>{const locked=(e as CustomEvent<{locked:boolean}>).detail.locked;for(const id of ['fvp-open-editor','fvp-floating-edit'])(byId(id) as HTMLButtonElement|null)?.toggleAttribute('hidden',locked);});
render();
</script>

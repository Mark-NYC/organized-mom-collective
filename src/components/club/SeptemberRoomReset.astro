 .srr,.srr-layout{height:100%;margin:0}.srr-editor{height:100%;overflow:hidden}.srr-preview{height:100%;overflow-y:auto;overscroll-behavior:contain}
 .srr-floating-edit{position:fixed;right:clamp(22px,3vw,48px);bottom:24px;z-index:25;display:inline-flex;align-items:center;gap:10px;min-height:52px;border:0;border-radius:999px;padding:13px 19px;background:#454545;color:#fff;box-shadow:0 8px 25px #0003;font:700 12px Montserrat,Arial,sans-serif;letter-spacing:.08em;cursor:pointer}

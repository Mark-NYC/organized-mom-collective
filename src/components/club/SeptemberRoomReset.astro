/* August-style guided choices, scoped to September's editor only. */
.srr-guided-dialog{width:min(620px,calc(100vw - 32px));padding:26px 30px}
.srr-guide-kicker{display:block;font:700 10px Montserrat,Arial,sans-serif;color:#809484;letter-spacing:.14em;margin-bottom:9px}
.srr-guided-dialog .srr-dialog-head h2{margin:0 0 11px}
.srr-guided-dialog .srr-guide-intro{font:13px/1.65 Montserrat,Arial,sans-serif;color:#687267;margin:0 0 20px}
.srr-guide-section{border-top:1px solid #e4e9e2;padding:18px 0}
.srr-guide-section h3{font:700 13px Montserrat,Arial,sans-serif;color:#4d604f;margin:0 0 12px}
.srr-choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.srr-choice-grid button{min-height:49px;border:1px solid #d6e0d5;border-radius:8px;background:#fff;color:#516152;padding:10px 12px;text-align:left;font:600 12px/1.4 Montserrat,Arial,sans-serif;cursor:pointer;display:flex;align-items:center;gap:10px}
.srr-choice-grid button:hover{border-color:#819b81;background:#f9fbf7}
.srr-choice-grid button.is-active{border:2px solid #6c8a71;background:#edf4ec;padding:9px 11px}
.srr-choice-grid button.is-active::after{content:"✓";margin-left:auto;color:#507454;font-weight:700}
.srr-area-choices button span{font:24px/1 Georgia,serif;color:#74917d;width:24px;text-align:center}
.srr-guide-caption{display:flex;gap:14px;justify-content:space-between;align-items:baseline}
.srr-guide-caption span{font:500 10px Montserrat,Arial,sans-serif;color:#809080}
.srr-guide-tip{font:12px/1.5 Montserrat,Arial,sans-serif;color:#718073;margin:0 0 13px}
.srr-guide-jobs{display:grid;gap:10px}
.srr-guided-job{display:flex;gap:12px;align-items:center;background:#f8f8f4;border:1px solid #e5e9e0;border-radius:9px;padding:10px}
.srr-guided-job img{width:63px;height:63px;object-fit:contain;flex:none}
.srr-guided-fields{flex:1;min-width:0;display:grid;grid-template-columns:1.2fr 1fr;gap:10px}
.srr-guided-fields label{display:block;font:700 10px Montserrat,Arial,sans-serif;color:#778577}
.srr-guided-fields select,.srr-guide-more select{width:100%;min-height:39px;margin-top:5px;border:1px solid #ccd8cc;border-radius:5px;padding:7px;background:#fff;color:#465747;font:12px Montserrat,Arial,sans-serif}
.srr-guide-more{border-top:1px solid #e4e9e2;padding-top:14px;margin:0 0 10px}
.srr-guide-more summary{font:700 12px Montserrat,Arial,sans-serif;color:#5f7767;cursor:pointer;padding:7px 0}
.srr-guide-more label{display:block;font:700 11px Montserrat,Arial,sans-serif;margin:10px 0}
.srr-guide-more p{font:11px/1.6 Montserrat,Arial,sans-serif;color:#718073}
.srr-guide-saved{font:600 11px Montserrat,Arial,sans-serif;color:#668569;margin:11px 0 17px}
.srr-guided-dialog .srr-dialog-done{border-radius:5px}
@media(max-width:540px){.srr-guided-dialog{padding:20px 17px}.srr-guided-fields{grid-template-columns:1fr;gap:7px}.srr-guided-job img{width:52px;height:52px}.srr-choice-grid button{font-size:11px;padding:9px;min-height:46px}}
</style>
<script>
type Child={id:string;firstName:string;kind:string;birthYear?:number;birthMonth?:number};
type State={owner:string;area:string;trigger:string;jobs:string[];jobOwners?:string[];custom?:boolean;text?:Record<string,string>};
const ageOf=(child?:Child)=>child?.birthYear?Math.max(2,2027-child.birthYear-((child.birthMonth??1)>9?1:0)):8;
const jobOptions=['Toys Put Away','Clothes in Hamper','Personal Belongings Put Away','Floor Vacuum-Ready','Backpack Put Away','Books Put Away','Play Area Cleared'];
const areaJobs:Record<string,string[]>={whole:['Toys Put Away','Clothes in Hamper','Floor Vacuum-Ready'],bedroom:['Toys Put Away','Clothes in Hamper','Floor Vacuum-Ready'],playroom:['Toys Put Away','Books Put Away','Play Area Cleared'],living:['Toys Put Away','Personal Belongings Put Away','Floor Vacuum-Ready']};
const jobIcons:Record<string,string>={'Toys Put Away':'toys-in-toy-basket','Clothes in Hamper':'sorting-clothes','Personal Belongings Put Away':'toys-in-toy-basket','Floor Vacuum-Ready':'clear-floor','Backpack Put Away':'backpack','Books Put Away':'book','Play Area Cleared':'clear-floor'};
const prepare=(area:string,age:number)=>{const jobs=[...(areaJobs[area]??areaJobs.bedroom)];if(age<=5){jobs[0]='Toys Put Away';jobs[1]='Clothes in Hamper'}return jobs};
const defaults:State={owner:'family',area:'whole',trigger:'Before Dinner',jobs:['Toys Put Away','Clothes in Hamper','Floor Vacuum-Ready'],jobOwners:[]};
const descriptions:Record<string,string>={whole:'whole-house cleanup',bedroom:'bedroom cleanup',playroom:'playroom cleanup',living:'living room cleanup'};
const coachingCues:Record<string,string>={'Before Dinner':"It's almost dinnertime. Let's get our cleanup jobs done.",'After Dinner':"Dinner's finished. Time to put our things away.",'Before Bedtime':"Before we get ready for bed, let's finish our cleanup jobs.",'After School':"Now that we're home, let's put our things where they belong.",'Before the Next Play Activity':"Before starting something new, let's put away what we've been using."};
for(const root of document.querySelectorAll<HTMLElement>('.srr')){
 const storageKey=root.dataset.srrKey||'omc:preview:september-room-reset:v2';
 let familyKey='',children:Child[]=[];
 const age=()=>state.owner==='family'?(children.length?Math.min(...children.map(ageOf)):8):ageOf(children.find(c=>c.id===state.owner));
 const prepareState=()=>{state.jobs=prepare(state.area,age());state.jobOwners=[];state.custom=false};
 let state:State={...defaults,jobs:[...defaults.jobs],jobOwners:[]};
 const stage=root.querySelector<HTMLElement>('[data-srr-stage]');
 const pages=root.querySelector<HTMLElement>('[data-srr-pages]');
 const sheets=Array.from(root.querySelectorAll<HTMLElement>('.srr-sheet'));
 const fit=()=>{if(!stage||!pages)return;const w=Math.max(180,stage.clientWidth-2),scale=Math.min(1,w/816);pages.style.gap=22*scale+'px';for(const sheet of sheets){sheet.style.setProperty('--srr-scale',String(scale));sheet.style.marginBottom=-(1056*(1-scale))+'px';sheet.style.marginRight=-(816*(1-scale))+'px'}};
 fit();if(stage&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(stage);
 const visionDialog=root.querySelector<HTMLDialogElement>('[data-srr-vision]');
 const editorDialog=root.querySelector<HTMLDialogElement>('[data-srr-editor]');
 root.querySelector('[data-open-vision]')?.addEventListener('click',()=>visionDialog?.showModal());
 root.querySelectorAll('[data-open-editor]').forEach(button=>button.addEventListener('click',()=>editorDialog?.showModal()));
 root.querySelectorAll('[data-close-dialog]').forEach(button=>button.addEventListener('click',()=>button.closest('dialog')?.close()));
 for(const dialog of [visionDialog,editorDialog])dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});
 const remember=()=>{try{sessionStorage.setItem(storageKey,JSON.stringify({familyKey,state}))}catch{}};
 const setText=(id:string,value:string)=>{const el=root.querySelector<HTMLElement>('[data-srr-'+id+']');if(el&&document.activeElement!==el)el.textContent=state.text?.[id]??value};
 const render=()=>{
  const years=age(),count=years<=5?2:3;
  const selected=children.find(c=>c.id===state.owner);
  setText('owner',selected?selected.firstName+"'s "+descriptions[state.area]:"Our family's "+descriptions[state.area]);
  setText('cue',state.trigger);
  setText('duration',years<=5?'A small reset. A grown-up helps me start.':years>=10?'I own this reset and check my own work.':'A few minutes to put our things away.');
  setText('count',count===2?'Two little jobs. Then we’re done.':'Three things. Then we’re done.');
  const grid=root.querySelector<HTMLElement>('[data-srr-jobs]');grid?.classList.toggle('srr-two',count===2);
  const cards=Array.from(root.querySelectorAll<HTMLElement>('.srr-job'));
  cards.forEach((card,i)=>{card.hidden=i>=count;const label=card.querySelector<HTMLElement>('[data-srr-job-label]');if(label&&document.activeElement!==label)label.textContent=state.jobs[i]??'';const img=card.querySelector<HTMLImageElement>('[data-srr-icon]');if(img)img.src='/images/club/icon-library/'+(jobIcons[state.jobs[i]]??'toys-in-toy-basket')+'.png';let who=card.querySelector<HTMLElement>('.srr-job-owner');if(!who){who=document.createElement('span');who.className='srr-job-owner';card.append(who)}const fallback=selected?.firstName??(children.length>1?(i===count-1?'Everyone':children[i%children.length].firstName):children.length===1?children[0].firstName:'Our kids');const key=state.jobOwners?.[i];const assigned=key==='everyone'?'Everyone':children.find(c=>c.id===key)?.firstName??fallback;who.textContent='Person responsible: '+assigned});
  setText('finish',state.jobs.includes('Floor Vacuum-Ready')?'Toys, clothes, and loose belongings are off the floor so it could be vacuumed.':'Each item is back where it belongs.');
  setText('start',years<=5?'Start with just one toy.':years>=10?'Start by scanning the floor and putting away what you see.':'Start with the toys nearest your feet.');
  const checks=root.querySelector<HTMLElement>('[data-srr-checks]');if(checks)checks.replaceChildren(...state.jobs.slice(0,count).map(label=>{const chip=document.createElement('span');chip.textContent='✓ '+label;return chip}));
  const summaries:[string,string][]=[['owner',selected?.firstName??'Our kids together'],['area',state.area==='whole'?'Whole House':state.area==='bedroom'?'Bedroom':state.area==='playroom'?'Playroom':'Living Room'],['trigger',state.trigger]];
  const coaching=root.querySelector<HTMLElement>('[data-srr-coaching-cue]');if(coaching)coaching.textContent=coachingCues[state.trigger]??`It's cleanup time: ${state.trigger}. Let's put our things away.`;
  for(const [k,value] of summaries){const el=root.querySelector<HTMLElement>('[data-srr-summary-'+k+']');if(el)el.textContent=value}
  root.querySelectorAll<HTMLButtonElement>('[data-srr-trigger-choice]').forEach(button=>{const active=button.dataset.srrTriggerChoice===state.trigger;button.classList.toggle('is-active',active);button.setAttribute('aria-pressed',String(active))});
  root.querySelectorAll<HTMLButtonElement>('[data-srr-area-choice]').forEach(button=>{const active=button.dataset.srrAreaChoice===state.area;button.classList.toggle('is-active',active);button.setAttribute('aria-pressed',String(active))});
  const other=root.querySelector<HTMLSelectElement>('[data-srr-other-trigger]');if(other)other.value=['After our afternoon snack','When our daily cleanup alarm rings','When screen time ends'].includes(state.trigger)?state.trigger:'';
  const jobList=root.querySelector<HTMLElement>('[data-srr-guided-jobs]');
  if(jobList){jobList.replaceChildren();for(let i=0;i<count;i++){
   const entry=document.createElement('div');entry.className='srr-guided-job';
   const icon=document.createElement('img');icon.src='/images/club/icon-library/'+(jobIcons[state.jobs[i]]??'toys-in-toy-basket')+'.png';icon.alt='';icon.width=60;icon.height=60;
   const fields=document.createElement('div');fields.className='srr-guided-fields';
   const jobLabel=document.createElement('label');jobLabel.textContent='Cleanup job '+(i+1);const jobSelect=document.createElement('select');jobSelect.setAttribute('aria-label','Cleanup job '+(i+1));
   for(const name of [...new Set([...jobOptions,state.jobs[i]])]){const opt=document.createElement('option');opt.value=name;opt.textContent=name;jobSelect.append(opt)}jobSelect.value=state.jobs[i];jobLabel.append(jobSelect);
   jobSelect.addEventListener('change',()=>{state.jobs[i]=jobSelect.value;state.custom=true;remember();render()});
   const ownerLabel=document.createElement('label');ownerLabel.textContent='Person responsible';const ownerSelect=document.createElement('select');ownerSelect.setAttribute('aria-label','Person responsible for job '+(i+1));
   const owners=[{id:'everyone',name:'Everyone'},...children.map(c=>({id:c.id,name:c.firstName}))];
   for(const owner of owners){const opt=document.createElement('option');opt.value=owner.id;opt.textContent=owner.name;ownerSelect.append(opt)}
   const fallback=children.length>1?(i===count-1?'everyone':children[i%children.length].id):children.length===1?children[0].id:'everyone';
   ownerSelect.value=state.jobOwners?.[i]??(state.owner!=='family'?state.owner:fallback);
   ownerSelect.addEventListener('change',()=>{(state.jobOwners??=[])[i]=ownerSelect.value;remember();render()});
   ownerLabel.append(ownerSelect);fields.append(jobLabel,ownerLabel);entry.append(icon,fields);jobList.append(entry);
  }}

 };
 root.querySelectorAll<HTMLElement>('.srr-sheet [contenteditable="true"]').forEach(el=>{
  const index=el.dataset.srrJobLabel;
  const id=index!==undefined?'job':['owner','cue','duration','count','start','finish'].find(k=>el.hasAttribute('data-srr-'+k))??'';
  if(!id)return;
  const updateText=()=>{const v=(el.textContent??'').replace(/\s+/g,' ').trim().slice(0,160);
   if(id==='job'){state.jobs[Number(index)]=v;state.custom=true}
   else {(state.text??={})[id]=v;if(id==='cue')state.trigger=v}
   remember();
  };
  el.addEventListener('input',updateText);
  el.addEventListener('blur',()=>{updateText();render()});
  el.addEventListener('keydown',(e:KeyboardEvent)=>{if(e.key==='Enter'){e.preventDefault();el.blur()}});
 });
 root.querySelectorAll<HTMLButtonElement>('[data-srr-trigger-choice]').forEach(button=>button.addEventListener('click',()=>{state.trigger=button.dataset.srrTriggerChoice??defaults.trigger;if(state.text)delete state.text.cue;remember();render()}));
 root.querySelectorAll<HTMLButtonElement>('[data-srr-area-choice]').forEach(button=>button.addEventListener('click',()=>{state.area=button.dataset.srrAreaChoice??'whole';state.text={};prepareState();remember();render()}));
 root.querySelector<HTMLSelectElement>('[data-srr-other-trigger]')?.addEventListener('change',event=>{const v=(event.target as HTMLSelectElement).value;if(!v)return;state.trigger=v;if(state.text)delete state.text.cue;remember();render()});
 root.querySelector('[data-srr-reset]')?.addEventListener('click',()=>{state={...defaults,jobs:[...defaults.jobs],jobOwners:[]};prepareState();remember();render()});
 root.querySelector('[data-srr-print]')?.addEventListener('click',()=>{(document.activeElement as HTMLElement|null)?.blur();window.print()});
 const pngButton=root.querySelector<HTMLButtonElement>('[data-srr-png]');
 pngButton?.addEventListener('click',async()=>{const front=root.querySelector<HTMLElement>('[data-srr-front]');if(!front)return;pngButton.disabled=true;root.classList.add('srr-export');const prev=pngButton.textContent;pngButton.textContent='Preparing image…';try{await Promise.all(Array.from(front.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));const {toPng}=await import('html-to-image');const url=await toPng(front,{pixelRatio:2,width:816,height:1056,backgroundColor:'#fff',style:{transform:'none',marginBottom:'0px',marginRight:'0px'}});const link=document.createElement('a');link.href=url;link.download='september-5-minute-room-reset.png';link.click()}catch(err){console.error(err);alert('Image export failed. Use Print / Save PDF instead.')}finally{root.classList.remove('srr-export');pngButton.textContent=prev;pngButton.disabled=false}});
 const applyHousehold=(detail:{household:{id:string;members?:Child[]};sample:string})=>{if(!detail?.household)return;const next=detail.sample+':'+detail.household.id;children=(detail.household.members??[]).filter(x=>x.kind==='child');
 if(next!==familyKey){familyKey=next;state={...defaults,jobs:[...defaults.jobs],jobOwners:[]};prepareState();try{const saved=JSON.parse(sessionStorage.getItem(storageKey)??'null');if(saved?.familyKey===next&&saved.state&&Array.isArray(saved.state.jobs)&&saved.state.jobs.length===3&&['whole','bedroom','playroom','living'].includes(saved.state.area))state=saved.state}catch{}}
 if(state.owner!=='family'&&!children.some(c=>c.id===state.owner))state.owner='family';if(!state.custom)prepareState();remember();render()
 };
 window.addEventListener('omc:club-preview-household',(e:Event)=>applyHousehold((e as CustomEvent<{household:{id:string;members?:Child[]};sample:string}>).detail));
 const cached=(window as Window & {__ofcPreviewHousehold?:{household:{id:string;members?:Child[]};sample:string}}).__ofcPreviewHousehold;
 if(cached)applyHousehold(cached);
 render();
}
</script>
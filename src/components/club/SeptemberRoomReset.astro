@media print{html,body{margin:0!important;padding:0!important;background:white!important}body *{visibility:hidden!important}.srr-pages,.srr-sheet,.srr-sheet *{visibility:visible!important}.srr-pages{display:block!important;position:absolute!important;top:0!important;left:0!important;width:8.5in!important;gap:0!important}.srr-sheet{position:relative!important;top:auto!important;left:auto!important;page-break-after:always!important;break-after:page!important;width:8.5in!important;height:11in!important;transform:none!important;margin-bottom:0!important;margin-right:0!important;box-shadow:none!important;border:0!important;-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}.srr-sheet:last-child{page-break-after:auto!important;break-after:auto!important}}

/* September shared Club experience: prepared summary + independent printable preview. */
.srr{max-width:none;padding:0}.srr-intro{display:none}
.srr-layout{grid-template-columns:clamp(315px,28vw,410px) minmax(0,1fr);gap:0;align-items:stretch}
.srr-editor{display:flex;flex-direction:column;min-width:0;border:0;border-right:1px solid #e5e0e1;background:#faf9f7;padding:15px clamp(17px,2vw,26px)}
.srr-editor-head{border-top:5px solid #d8e6df;padding-top:10px;flex:0 0 auto}
.srr-editor-head h2{font:400 clamp(23px,2.7vw,31px)/1.12 Georgia,serif;color:#5f7767;margin:9px 0}.srr-editor-head h2 em{font-style:italic}

.srr-intro{max-width:780px;margin-bottom:34px}.srr-intro>a{font-size:12px;color:#43493f;display:inline-block;margin-bottom:25px}.srr-eyebrow{font-size:10px!important;letter-spacing:.15em;font-weight:700;color:#718569}.srr-intro h1{font:400 clamp(38px,4.4vw,60px)/1.14 Georgia,serif;margin:12px 0}.srr-intro h1 em{color:#788e72}.srr-intro>p:last-child{font-size:15px;line-height:1.75}
.srr-layout{display:grid;grid-template-columns:minmax(275px,350px) minmax(0,1fr);gap:clamp(25px,4vw,60px);align-items:start}
.srr-editor{border-top:8px solid #d8e6df;padding-top:16px}.srr-editor h2{font:italic 30px Georgia,serif;color:#668075;margin:10px 0}.srr-editor>p:nth-of-type(2){font-size:13px;line-height:1.75}.srr-editor label{display:block;font-size:12px;font-weight:700;margin:18px 0}.srr-editor select,.srr-editor input{display:block;margin-top:7px;width:100%;padding:10px;min-height:44px;color:#454545;background:#fff;border:1px solid #b8c5bd;font:12px Montserrat,Arial,sans-serif}.srr-cue-help{font-size:11px;line-height:1.55;color:#718073;margin:8px 0 15px}.srr-editor details{border:1px solid #d7e1dc;border-radius:6px;padding:0 13px;margin:22px 0}.srr-editor summary{padding:15px 0;cursor:pointer;font-size:13px;font-weight:700}.srr-editor summary span{font-weight:400;font-size:11px;color:#849289}.srr-note{background:#f3f5ef;padding:17px;margin:20px 0}.srr-note strong{font:21px Georgia,serif}.srr-note p{font-size:11px;line-height:1.7;margin:7px 0 0}.srr-primary,.srr-secondary{width:100%;min-height:48px;cursor:pointer;font-size:12px;font-weight:700}.srr-primary{border:0;background:#5f7767;color:#fff}.srr-secondary{border:1px solid #b7c9bc;background:#fff;color:#5f7767;margin-top:9px}.srr-restore{display:block;margin:8px auto;background:none;border:0;text-decoration:underline;cursor:pointer;color:#607867;min-height:40px}.srr-small{font-size:11px;line-height:1.65;color:#858982}
.srr-preview{min-width:0}.srr-preview-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;border-bottom:1px solid #e1e6e3;margin-bottom:17px}.srr-preview-heading h2{font:26px Georgia,serif}.srr-preview-heading span{font-size:11px;color:#858982}
.srr-stage{width:100%}.srr-pages{display:flex;flex-direction:column;gap:22px;align-items:flex-start}.srr-sheet{position:relative;width:816px;height:1056px;transform:scale(var(--srr-scale,1));transform-origin:top left;flex-shrink:0;border:1px solid #e6e6e0;box-shadow:0 8px 26px #0002;background:#fff;padding:42px 52px 30px;display:flex;flex-direction:column;overflow:hidden}.srr-paper-head{text-align:center;padding:12px 10px 20px;border-top:7px solid #deeae4}.srr-paper-head>p{font-size:10px;letter-spacing:.15em;font-weight:700;color:#7c9085;margin:0}.srr-paper-head h2{font:400 45px/1.1 Georgia,serif;color:#506255;margin:14px 0 10px}.srr-paper-head span{font:italic 17px Georgia,serif;color:#849487}

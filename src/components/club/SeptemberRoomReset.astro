.srr-jobs{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.srr-job{min-height:245px;border-radius:12px;background:#faf5eb;padding:14px;display:flex;align-items:center;flex-direction:column;text-align:center}.srr-job:nth-child(2){background:#f1e6de}.srr-job:nth-child(3){background:#edf2ec}.srr-icon{height:126px;width:126px;display:grid;place-items:center}.srr-icon img{width:112px;height:112px;object-fit:contain}.srr-number{font:italic 15px Georgia,serif;color:#8c937d;margin:0 0 12px}.srr-job strong{font-size:16px;line-height:1.35;color:#4d5a4d}

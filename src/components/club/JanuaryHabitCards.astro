.jhc-forms{display:grid;grid-template-columns:1fr 1fr;gap:22px 28px;margin-top:24px}.jhc-editor{border:0;border-top:1px solid #d7d6cf;padding:15px 0 0;min-width:0}.jhc-editor legend{font-family:Georgia,serif;font-size:18px;padding-right:8px}.jhc-editor-num{font:700 12px Montserrat,Arial,sans-serif;color:#788e79;margin-right:8px}.jhc-editor label{display:block;margin-top:14px}.jhc-editor label span{font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:#77796f;display:block;margin-bottom:7px}.jhc-editor input,.jhc-editor textarea{font:15px Georgia,serif;color:#423e39;width:100%;padding:10px 12px;min-height:42px;background:#fff;border:1px solid #d5d0c7;border-radius:0;resize:vertical}.jhc-editor input:focus-visible,.jhc-editor textarea:focus-visible,.jhc-actions button:focus-visible{outline:2px solid #586f5a;outline-offset:2px}
.jhc-actions{display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-top:25px}.jhc-print{background:#4a4a45;border:1px solid #4a4a45;color:white;font-size:12px;letter-spacing:.08em;font-weight:700;padding:15px 22px;min-height:48px;cursor:pointer}.jhc-reset{background:transparent;text-decoration:underline;text-underline-offset:3px;border:0;padding:12px 5px;min-height:48px;cursor:pointer;color:#4a4a45;font-weight:600}.jhc-help{font-size:12px;color:#777269;margin-top:13px;line-height:1.5}
.jhc-preview-heading{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin:0 0 15px}.jhc-print-scroll{overflow-x:auto;padding:1px 0 20px}

---
/**
 * September 2027 prototype: real, individual habit cue cards on one Letter-sized cut sheet.
 * A standalone printable, not a routine chart or a tracker. The printed sheet is 2x2
 * physical cards, and every card names a pre-existing anchor and one next action.
 * Kept reusable in the Club and the unlisted owner review preview.
 * planMode: inside a Club plan page (/app/club/january) the page brings the layout, rail and mobile screen; this keeps
 * the editor and finder dialogs and the sheet, and publishes the plan as `clubPlan` (docs/club/PLAN_ARCHITECTURE.md).
 */
import { monthColors } from '../../theme';
interface Props { storageKey?: string; planMode?: boolean }
const {storageKey='omc:club:september-habit-cards:v1', planMode=false} = Astro.props;
const defaults = [
  {name: 'My morning', anchor: 'After I finish breakfast', action: 'I put my bowl by the sink.', place: 'By the breakfast table', kind:'home'},
  {name: 'My backpack', anchor: 'After I put on my shoes', action: 'I put my backpack on.', place: 'Next to my shoes', kind:'school'},
  {name: 'My bedroom', anchor: 'After I get dressed', action: 'I put my pajamas away.', place: 'On my dresser', kind:'bed'},
  {name: 'Our kitchen', anchor: 'After we finish dinner', action: 'We clear the table together.', place: 'By the kitchen table', kind:'table'},
];
---
<div class="jhc" data-jhc-plan={planMode ? "" : undefined} data-jhc-storage={storageKey} style={`--jhc-month:${monthColors[0].hex}`}>
  {!planMode && <div class="jhc-intro">
    <a class="jhc-back" href="/club">← Organized Family Club</a><p class="jhc-overline">ORGANIZED FAMILY CLUB · SEPTEMBER</p>
    <h2>Your family’s habits. <em>Already prepared.</em></h2>
    <p>Up to two small habits, chosen for your family. Keep the prepared suggestion or find a habit that makes everyday life easier.</p>
  </div>}
  <div class={planMode ? "jhc-plan" : "jhc-workspace"}><div class={planMode ? "jhc-plan-editor" : "jhc-config"} aria-label="Customize your family habit cards">
    {!planMode && <Fragment><div class="jhc-config-heading"><p class="jhc-overline">SEPTEMBER · PREPARED PLAN</p><h3>Ready for your family.</h3><p>Already filled in. Edit only what you need.</p></div>
    <div class="jhc-prepared" id="january-edit-controls"><p class="jhc-overline">YOUR FAMILY'S PREPARED HABITS</p><h3>Two small habits. A real difference.</h3><p>We've prepared two starting ideas. Keep them, or answer a few easy questions to choose habits that would help your family.</p><div class="jhc-summary-row"><span>Recommended habit</span><strong data-jhc-habit-label>Clear dishes after breakfast</strong></div><div class="jhc-summary-row"><span>Focus</span><strong>Up to two habits this month</strong></div><button type="button" class="jhc-finder-launch" data-jhc-finder-open>Help me find our habits</button><button type="button" class="jhc-edit-trigger" data-jhc-open>Edit our cards</button></div></Fragment>}
    <dialog class="jhc-dialog" data-jhc-dialog aria-labelledby="jhc-dialog-title"><div class="jhc-dialog-head"><h2 id="jhc-dialog-title">Edit your family habit cards</h2><button type="button" data-jhc-close aria-label="Close">×</button></div><p>Make these two habit cards fit your family. Both cards will print on one page.</p>    <div class="jhc-forms">
      {defaults.slice(0,2).map((item, i) => (
        <fieldset class="jhc-editor" data-jhc-editor={i}>
          <legend><span class="jhc-editor-num">0{i+1}</span> Habit card {i+1}</legend>
          <label><span>Who will practice this habit?</span><input data-field="name" maxlength="42" value={item.name}/></label>
          <label><span>When this happens</span><input data-field="anchor" maxlength="85" value={item.anchor}/></label>
          <label><span>Here's what we do next</span><textarea data-field="action" maxlength="105" rows="2">{item.action}</textarea></label>
          <label><span>Place this reminder</span><input data-field="place" maxlength="70" value={item.place}/></label>
        </fieldset>
      ))}
    </div>
<button type="button" class="jhc-dialog-done" data-jhc-close>Done · See our cards</button></dialog>
    {!planMode && <Fragment><div class="jhc-actions">
      <button type="button" class="jhc-jump-edit" data-jhc-finder-open>HELP ME FIND OUR HABITS</button>
      <button class="jhc-print" type="button" data-print>Print cards / Save PDF</button>
      <button type="button" class="jhc-png" data-single-page-png>Download image (PNG)</button>
   <button class="jhc-reset" type="button" data-reset>Restore suggested cards</button>
    </div>
    <p class="jhc-help" aria-live="polite" data-status>Print at 100% / actual size on US Letter paper. Cut along the dotted lines. Put each card where its habit happens. No tracking, points or daily checkboxes.</p></Fragment>}
  </div>

  <dialog class="jhc-finder-dialog" data-jhc-finder-dialog aria-labelledby="jhc-finder-title"><div class="jhc-dialog-head"><h2 id="jhc-finder-title">Find your family's habits</h2><button type="button" data-jhc-finder-close aria-label="Close habit finder">×</button></div><p class="jhc-finder-intro">We'll help you choose one simple habit at a time. You can add a second when the first is ready.</p><div data-jhc-finder-body aria-live="polite"></div><div class="jhc-finder-actions"><button type="button" data-jhc-finder-back>Back</button><button type="button" data-jhc-finder-close>Keep my current cards</button></div></dialog>
  <div class={planMode ? "jhc-plan-view" : "jhc-preview-panel"} data-jhc-view>{!planMode && <button type="button" class="jhc-floating-edit" data-jhc-finder-open><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 4 4M4 20l4-.8L19 8.2a2.1 2.1 0 0 0-3-3L5 16.2 4 20Z"/></svg>HELP ME FIND OUR HABITS</button>}
  <div class="jhc-print-scroll">
    <div class="jhc-stage" data-jhc-stage><div class="jhc-page" data-jhc-page data-plan-sheet="sheet" data-plan-sheet-end>
      <div class="jhc-sheet-label"><span>ORGANIZED FAMILY CLUB · SEPTEMBER 2027</span><span>ONE SMALL STEP AT A TIME</span></div>
      <header class="jhc-sheet-heading"><h2>Little habits.<br/><em>More independence.</em></h2><p>Two quarter-sheet reminders. Cut along the dotted lines and place each one where its habit happens.</p></header>
      <div class="jhc-card-grid" data-jhc-card-grid>
        <svg class="jhc-cut-scissors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="m8.2 8.2 12.8 12.8M8.2 15.8 21 3"/></svg>
        <svg class="jhc-cut-scissors jhc-cut-scissors-second" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="m8.2 8.2 12.8 12.8M8.2 15.8 21 3"/></svg>
        {defaults.slice(0,2).map((item, i) => (
          <article class="jhc-card" data-jhc-card={i}>
            <div class="jhc-card-top">
              <span class="jhc-brand" data-jhc-owner>MY DAILY REMINDER</span>
              <span class="jhc-card-number">0{i+1}</span>
            </div>
            <div class="jhc-card-icon" aria-hidden="true"><img src={['dishes-in-sink','backpack','pajamas','table-after-meal'].map(n=>'/images/club/icon-library/'+n+'.png')[i]} alt="" width="58" height="58" /></div>
            
            
            <h3 class="jhc-card-name" data-print-field="name" contenteditable="true" role="textbox" spellcheck="true" aria-label="Edit habit name">{item.name}</h3>
            <div class="jhc-card-rule"></div>
            <p class="jhc-anchor-label">AFTER THIS</p>
            <p class="jhc-anchor" data-print-field="anchor" contenteditable="true" role="textbox" spellcheck="true" aria-label="Edit habit anchor">{item.anchor}</p>
            <p class="jhc-action-label">I DO THIS</p>
            <p class="jhc-action" data-print-field="action" contenteditable="true" role="textbox" spellcheck="true" aria-label="Edit habit action">{item.action}</p>
            <div class="jhc-card-bottom">
              <span>KEEP THE REMINDER</span>
              <p data-print-field="place" contenteditable="true" role="textbox" spellcheck="true" aria-label="Edit habit place">{item.place}</p>
            </div>
          </article>
        ))}
      </div>
      <aside class="jhc-start"><p class="jhc-start-label">START WITH ONE HABIT</p><h3>A small start. Something you can repeat.</h3><div class="jhc-start-steps"><p><strong>01 · Show it</strong>Walk through the action together. Make “done” clear.</p><p><strong>02 · Put it in sight</strong>Cut along the dotted lines. Put each card where its habit happens.</p><p><strong>03 · Practice it</strong>Use the same everyday cue. If it’s too much, make the action smaller.</p></div><p class="jhc-start-note">Missed it today? Try again at the next cue. Add the second habit when you’re ready.</p></aside><div class="jhc-sheet-footer"><span>OUR FAMILY HABIT CARDS</span><span>Small actions. Shared responsibility.</span></div>
    </div></div>
  </div>
  </div>
  </div>
</div>
<style is:global>
.jhc{color:#494741;font-family:Montserrat,Arial,sans-serif}.jhc:not([data-jhc-plan]){max-width:1080px;margin:0 auto;padding:0 14px 64px}
.jhc *{box-sizing:border-box}.jhc-overline,.jhc-small-title,.jhc-brand,.jhc-card-number,.jhc-sheet-label,.jhc-sheet-footer,.jhc-card-bottom span,.jhc-anchor-label,.jhc-action-label{font-family:Montserrat,Arial,sans-serif;font-size:10px;letter-spacing:.15em;font-weight:700}
.jhc-overline{color:#7b8e7b}.jhc-intro{max-width:750px;margin-bottom:30px}.jhc-intro h2{font-family:Georgia,serif;font-size:clamp(30px,4vw,44px);font-weight:400;line-height:1.14;margin:9px 0 16px}.jhc-intro>p:last-child{font-family:Georgia,serif;font-size:18px;line-height:1.55;color:#6b6860}
.jhc-config{background:#f5f4f0;padding:24px 28px 22px;margin-bottom:32px}.jhc-config-heading h3,.jhc-preview-heading h3{font-family:Georgia,serif;font-size:26px;font-weight:400}.jhc-config-heading p,.jhc-preview-heading p{font-size:14px;color:#777269;margin-top:5px}
.jhc-forms{display:grid;grid-template-columns:1fr 1fr;gap:22px 28px;margin-top:24px}.jhc-editor{border:0;border-top:1px solid #d7d6cf;padding:15px 0 0;min-width:0}.jhc-editor legend{font-family:Georgia,serif;font-size:18px;padding-right:8px}.jhc-editor-num{font:700 12px Montserrat,Arial,sans-serif;color:#788e79;margin-right:8px}.jhc-editor label{display:block;margin-top:14px}.jhc-editor label span{font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:#77796f;display:block;margin-bottom:7px}.jhc-editor input,.jhc-editor textarea{font:15px Georgia,serif;color:#423e39;width:100%;padding:10px 12px;min-height:42px;background:#fff;border:1px solid #d5d0c7;border-radius:0;resize:vertical}.jhc-editor input:focus-visible,.jhc-editor textarea:focus-visible,.jhc-actions button:focus-visible{outline:2px solid #586f5a;outline-offset:2px}
.jhc-actions{display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-top:25px}.jhc-print{background:#4a4a45;border:1px solid #4a4a45;color:white;font-size:12px;letter-spacing:.08em;font-weight:700;padding:15px 22px;min-height:48px;cursor:pointer}.jhc-reset{background:transparent;text-decoration:underline;text-underline-offset:3px;border:0;padding:12px 5px;min-height:48px;cursor:pointer;color:#4a4a45;font-weight:600}.jhc-help{font-size:12px;color:#777269;margin-top:13px;line-height:1.5}
.jhc-preview-heading{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin:0 0 15px}.jhc-print-scroll{overflow-x:auto;padding:1px 0 20px}
.jhc-page{width:816px;height:1056px;background:#fbfaf7;box-shadow:0 4px 25px #30292019;margin:0 auto;padding:40px 45px 29px;display:flex;flex-direction:column;color:#484740}
.jhc-sheet-label{display:flex;justify-content:space-between;align-items:center;color:#68796a;font-size:9px;height:28px;flex-shrink:0}.jhc-sheet-label span{color:#827b72}
.jhc-card-grid{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;flex:1;margin:12px 0 12px;border:1px dashed #bcbab0}
.jhc-card{position:relative;min-width:0;min-height:0;overflow:hidden;display:flex;flex-direction:column;padding:23px 27px 19px;background:#fff}
.jhc-card:nth-child(odd){border-right:1px dashed #bcbab0}.jhc-card:nth-child(-n+2){border-bottom:1px dashed #bcbab0}
.jhc-card-top{display:flex;justify-content:space-between;align-items:center;color:#959089}.jhc-brand{font-size:8px}.jhc-card-number{color:#8b9a84}
.jhc-card-icon{width:58px;height:58px;margin:13px auto 7px;background:#e9eee7;border-radius:50%;display:flex;justify-content:center;align-items:center;color:#576953;transform:rotate(-3deg)}.jhc-card:nth-child(2) .jhc-card-icon{background:#e8eff1}.jhc-card:nth-child(3) .jhc-card-icon{background:#f3e7d6}.jhc-card:nth-child(4) .jhc-card-icon{background:#f0e7e5}.jhc-card-icon svg{height:37px;width:37px}
.jhc-small-title{text-align:center;color:#8b9686;font-size:8px;margin:3px 0 0}
.jhc-card-name{font-family:Kalam,Georgia,serif;font-size:26px;line-height:1.1;text-align:center;font-weight:700;margin:5px 0 6px;overflow-wrap:anywhere}
.jhc-card-rule{width:90px;height:7px;background:#d9e3d6;margin:0 auto 13px;transform:rotate(-2deg);border-radius:45%}
.jhc-anchor-label,.jhc-action-label{color:#758773;margin:0 0 7px;font-size:8px}.jhc-anchor{font:17px/1.2 Georgia,serif;margin:0 0 14px;overflow-wrap:anywhere}.jhc-action{font:700 20px/1.2 Georgia,serif;margin:0;overflow-wrap:anywhere}.jhc-action-label{color:#ab8b76}
.jhc-card-bottom{border-top:1px solid #d9dbd4;margin-top:auto;padding-top:10px}.jhc-card-bottom span{font-size:8px;color:#8c8c83}.jhc-card-bottom p{font:italic 14px Georgia,serif;margin:5px 0 0;overflow-wrap:anywhere}
.jhc-sheet-footer{display:flex;align-items:center;justify-content:space-between;color:#99928a;font-size:8px;height:14px}
@media(max-width:700px){.jhc-forms{grid-template-columns:1fr}.jhc-config{padding:20px}.jhc-preview-heading{display:block}.jhc-page{margin-left:0}}
@page{size:letter portrait;margin:0}
@media print{
 html,body{margin:0!important;padding:0!important;background:white!important}
 body *{visibility:hidden!important}
 .jhc-page,.jhc-page *{visibility:visible!important}
 .jhc-page{position:absolute!important;left:0!important;top:0!important;box-shadow:none!important;margin:0!important;width:8.5in!important;height:11in!important;print-color-adjust:exact!important;-webkit-print-color-adjust:exact!important}
 .jhc-print-scroll{overflow:visible!important}
 .jhc{padding:0!important}
}


---
/**
 * January 2027 prototype: real, individual habit cue cards on one Letter-sized cut sheet.
 * A standalone printable, not a routine chart or a tracker. The printed sheet is 2x2
 * physical cards, and every card names a pre-existing anchor and one next action.
 * Kept reusable in the Club and the unlisted owner review preview.
 */
import { monthColors } from '../../theme';
interface Props { storageKey?: string; }
const {storageKey='omc:club:january-habit-cards:v1'} = Astro.props;
const defaults = [
  {name: 'My morning', anchor: 'After I finish breakfast', action: 'I put my dishes away.', place: 'By the breakfast table', kind:'home'},
  {name: 'My backpack', anchor: 'After I put on my shoes', action: 'I grab my backpack.', place: 'Next to my shoes', kind:'school'},
  {name: 'My bedroom', anchor: 'After I get dressed', action: 'I put my pajamas away.', place: 'On my dresser', kind:'bed'},
  {name: 'Our kitchen', anchor: 'After we finish dinner', action: 'We clear the table together.', place: 'By the kitchen table', kind:'table'},
];
---
<div class="jhc" data-jhc-storage={storageKey} style={`--jhc-month:${monthColors[0].hex}`}>
  <div class="jhc-intro">
    <a class="jhc-back" href="/club">← Organized Family Club</a><p class="jhc-overline">ORGANIZED FAMILY CLUB · JANUARY</p>
    <h2>Your family’s habits. <em>Already prepared.</em></h2>
    <p>Four small reminders, tied to things your family already does. Change anything, or print the suggestions as they are. Start with one or two.</p>
  </div>
  <div class="jhc-workspace"><div class="jhc-config" aria-label="Customize your family habit cards">
    <div class="jhc-config-heading"><p class="jhc-overline">JANUARY · PREPARED PLAN</p><h3>Ready for your family.</h3><p>Already filled in. Edit only what you need.</p></div>
    <div class="jhc-forms">
      {defaults.map((item, i) => (
        <fieldset class="jhc-editor" data-jhc-editor={i}>
          <legend><span class="jhc-editor-num">0{i+1}</span> Habit card {i+1}</legend>
          <label><span>Whose card?</span><input data-field="name" maxlength="42" value={item.name}/></label>
          <label><span>After I already...</span><input data-field="anchor" maxlength="85" value={item.anchor}/></label>
          <label><span>Then I will...</span><textarea data-field="action" maxlength="105" rows="2">{item.action}</textarea></label>
          <label><span>Put the reminder...</span><input data-field="place" maxlength="70" value={item.place}/></label>
        </fieldset>
      ))}
    </div>
    <div class="jhc-actions">
      <button class="jhc-print" type="button" data-print>Print cards / Save PDF</button>
      <button type="button" class="jhc-png" data-single-page-png>Download image (PNG)</button>
   <button class="jhc-reset" type="button" data-reset>Restore suggested cards</button>
    </div>
    <p class="jhc-help" aria-live="polite" data-status>Print at 100% / actual size on US Letter paper. Cut along the fine dotted lines. No tracking, points or daily checkboxes.</p>
  </div>

  <div class="jhc-preview-panel"><div class="jhc-preview-heading"><h3>Your January habit cards</h3><p>Four cut-out reminders · US Letter</p></div>
  <div class="jhc-print-scroll">
    <div class="jhc-stage" data-jhc-stage><div class="jhc-page" data-jhc-page>
      <div class="jhc-sheet-label"><span>ORGANIZED FAMILY CLUB · JANUARY 2027</span><span>OUR FAMILY HABIT CARDS</span></div>
      <div class="jhc-card-grid">
        {defaults.map((item, i) => (
          <article class="jhc-card" data-jhc-card={i}>
            <div class="jhc-card-top">
              <span class="jhc-brand">ORGANIZED FAMILY CLUB</span>
              <span class="jhc-card-number">0{i+1}</span>
            </div>
            <div class="jhc-card-icon" aria-hidden="true"><img src={['dishes-in-sink','backpack','pajamas','table-after-meal'].map(n=>'/images/club/icon-library/'+n+'.png')[i]} alt="" width="58" height="58" /></div>
            <p class="jhc-small-title">ONE LITTLE HABIT</p>
            <h3 class="jhc-card-name" data-print-field="name">{item.name}</h3>
            <div class="jhc-card-rule"></div>
            <p class="jhc-anchor-label">WHEN THIS HAPPENS</p>
            <p class="jhc-anchor" data-print-field="anchor">{item.anchor}</p>
            <p class="jhc-action-label">HERE’S WHAT I DO NEXT</p>
            <p class="jhc-action" data-print-field="action">{item.action}</p>
            <div class="jhc-card-bottom">
              <span>PLACE THIS CARD</span>
              <p data-print-field="place">{item.place}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="jhc-sheet-footer"><span>One habit at a time. The card is the reminder.</span><span>✂ CUT ALONG THE DOTTED LINES</span></div>
    </div></div>
  </div>
  </div>
  </div>
</div>
<style is:global>
.jhc{color:#494741;font-family:Montserrat,Arial,sans-serif;max-width:1080px;margin:0 auto;padding:0 14px 64px}
.jhc *{box-sizing:border-box}.jhc-overline,.jhc-small-title,.jhc-brand,.jhc-card-number,.jhc-sheet-label,.jhc-sheet-footer,.jhc-card-bottom span,.jhc-anchor-label,.jhc-action-label{font-family:Montserrat,Arial,sans-serif;font-size:10px;letter-spacing:.15em;font-weight:700}
.jhc-overline{color:#7b8e7b}.jhc-intro{max-width:750px;margin-bottom:30px}.jhc-intro h2{font-family:Georgia,serif;font-size:clamp(30px,4vw,44px);font-weight:400;line-height:1.14;margin:9px 0 16px}.jhc-intro>p:last-child{font-family:Georgia,serif;font-size:18px;line-height:1.55;color:#6b6860}

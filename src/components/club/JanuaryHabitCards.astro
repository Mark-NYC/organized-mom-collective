</style>

<style is:global>
/* January: match the actual December preview and November worksheet typography/layout. */
@font-face{font-family:'JHC Gelasio';src:url('/fonts/worksheet/gelasio-400.ttf') format('truetype');font-weight:400;font-display:swap}
@font-face{font-family:'JHC Gelasio';src:url('/fonts/worksheet/gelasio-600-italic.ttf') format('truetype');font-weight:600;font-style:italic;font-display:swap}
@font-face{font-family:'JHC Montserrat';src:url('/fonts/worksheet/montserrat-400.ttf') format('truetype');font-weight:400;font-display:swap}
@font-face{font-family:'JHC Montserrat';src:url('/fonts/worksheet/montserrat-600.ttf') format('truetype');font-weight:600;font-display:swap}
.jhc{max-width:1440px;padding:0 clamp(16px,3vw,48px) 65px;margin:0 auto;color:#454545;font-family:'JHC Montserrat',Montserrat,sans-serif}
.jhc-intro{max-width:790px!important;margin:0 0 38px!important}
.jhc-back{display:inline-block;margin-bottom:30px;font-size:12px;text-decoration:underline;text-underline-offset:4px}
.jhc-overline{font:600 10px 'JHC Montserrat',sans-serif!important;letter-spacing:.17em!important;color:#545454!important}
.jhc-intro h2{font:400 clamp(36px,4.5vw,57px)/1.09 'JHC Gelasio',Georgia,serif!important;color:#3d3d3d!important;letter-spacing:-.02em;margin:12px 0 18px!important}
.jhc-intro h2 em{font:600 italic 1em 'JHC Gelasio',Georgia,serif;color:#527384}
.jhc-intro>p:last-child{font:15px/1.7 'JHC Montserrat',sans-serif!important;color:#555!important;max-width:625px}
.jhc-workspace{display:grid;grid-template-columns:minmax(295px,355px) minmax(0,1fr);gap:clamp(25px,3vw,48px);align-items:start}
.jhc-config{min-width:0;background:transparent!important;margin:0!important;padding:0!important}
.jhc-config-heading{border-top:9px solid var(--jhc-month);padding-top:22px}
.jhc-config-heading h3{font:600 italic 27px/1.2 'JHC Gelasio',Georgia,serif!important;color:#527384;margin:12px 0}
.jhc-config-heading>p:last-child{font:13px/1.6 'JHC Montserrat',sans-serif!important;color:#555}
.jhc-forms{grid-template-columns:1fr!important;gap:0!important;margin-top:25px!important}
.jhc-editor{border-top:1px solid var(--jhc-month);padding:14px 0 18px}
.jhc-editor legend{font:400 19px 'JHC Gelasio',Georgia,serif}
.jhc-editor-num{font:600 12px 'JHC Montserrat',sans-serif;color:#527384}
.jhc-editor label{margin-top:12px}
.jhc-editor label span{font:600 10px 'JHC Montserrat',sans-serif;letter-spacing:.08em;color:#555}
.jhc-editor input,.jhc-editor textarea{font:14px/1.4 'JHC Montserrat',sans-serif;min-height:46px;border:1px solid #b5b5b5;border-radius:0;color:#333}
.jhc-actions{display:block;margin-top:16px}
.jhc-print{width:100%;background:#454545;border:0;min-height:52px;font:600 12px 'JHC Montserrat',sans-serif;letter-spacing:.11em;text-transform:uppercase}
.jhc-reset{display:block;margin:12px auto;font:600 12px 'JHC Montserrat',sans-serif}

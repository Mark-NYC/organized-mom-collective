<script>
const defaults = [
  {name:'My morning',anchor:'After I finish breakfast',action:'I put my dishes away.',place:'By the breakfast table',who:'THE FAMILY'},
  {name:'My backpack',anchor:'After I put on my shoes',action:'I grab my backpack.',place:'Next to my shoes',who:'THE FAMILY'},
  {name:'My bedroom',anchor:'After I get dressed',action:'I put my pajamas away.',place:'On my dresser',who:'THE FAMILY'},
  {name:'Our kitchen',anchor:'After we finish dinner',action:'We clear the table together.',place:'By the kitchen table',who:'THE FAMILY'}
];
for (const root of document.querySelectorAll<HTMLElement>('.jhc')) {
 const editorDialog=root.querySelector<HTMLDialogElement>('[data-jhc-dialog]');
 root.querySelectorAll('[data-jhc-open]').forEach(button=>button.addEventListener('click',()=>editorDialog?.showModal()));
 root.querySelectorAll('[data-jhc-close]').forEach(button=>button.addEventListener('click',()=>editorDialog?.close()));
 editorDialog?.addEventListener('click',event=>{if(event.target===editorDialog)editorDialog.close()});
 const stage=root.querySelector<HTMLElement>('[data-jhc-stage]');
 const fit=()=>{if(!stage)return;const width=Math.max(180,(stage.parentElement?.clientWidth??816)-4);const scale=Math.min(1,width/816);stage.style.width=816*scale+'px';stage.style.height=1056*scale+'px';stage.style.setProperty('--jhc-scale',String(scale))};
 fit();if(stage?.parentElement&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(stage.parentElement);window.addEventListener('resize',fit);
 const key = root.dataset.jhcStorage ?? 'omc:club:january-habit-cards:v1';
 // Family names never go into persistent localStorage on signed-in Club pages.
 const storage = key.startsWith('omc:club:') ? sessionStorage : localStorage;
 const editors=Array.from(root.querySelectorAll<HTMLElement>('[data-jhc-editor]'));
 const finder=root.querySelector<HTMLDialogElement>('[data-jhc-finder-dialog]');
 const finderBody=root.querySelector<HTMLElement>('[data-jhc-finder-body]');
 let finderStep=0;
 const finderAnswers:string[]=[];
 let selectedHabits:string[]=[];
 const finderQuestions=[
  {question:'What do you keep reminding everyone to do?',options:['Get ready to leave','Put things away','Clear up after meals','Get ready for bed','Start homework','Check what comes next']},
  {question:'What would you love them to do without being asked?',options:['Have their things ready','Put things back when finished','Take dishes to the kitchen','Get clothes ready for tomorrow','Begin homework at the same time','Look at the family plan first']},
  {question:'Who will practice these habits?',options:['The kids','One child','Mom and Dad','Everyone']}
 ];
 const suggestions:Record<string,{name:string;anchor:string;action:string;place:string}>={
  'Get ready to leave':{name:'Ready to go',anchor:'Before going to bed',action:'We put our shoes and backpacks by the door.',place:'By the front door'},
  'Put things away':{name:'Put it back',anchor:'When we finish playing',action:'We put away what we used.',place:'Near the toys'},
  'Clear up after meals':{name:'Clear our place',anchor:'After eating',action:'We take our dishes to the kitchen.',place:'By the dining table'},
  'Get ready for bed':{name:'Ready for tomorrow',anchor:'After brushing our teeth',action:'We lay out tomorrow’s clothes.',place:'On the dresser'},
  'Start homework':{name:'Homework first',anchor:'After our afternoon snack',action:'We get out our homework and start.',place:'At the homework spot'},
  'Check what comes next':{name:'Check our plan',anchor:'Before asking what’s next',action:'We look at our family calendar.',place:'Beside our calendar'}
 };
 const otherSuggestion:Record<string,string>={
  'Have their things ready':'Get ready to leave','Put things back when finished':'Put things away',
  'Take dishes to the kitchen':'Clear up after meals','Get clothes ready for tomorrow':'Get ready for bed',
  'Begin homework at the same time':'Start homework','Look at the family plan first':'Check what comes next'
 };
 const renderFinder=()=>{
  if(!finderBody)return;
  finderBody.replaceChildren();
  const make=(tag:string,content:string,cls?:string)=>{const el=document.createElement(tag);el.textContent=content;if(cls)el.className=cls;finderBody.append(el);return el};
  make('p',finderStep<3?`Step ${finderStep+1} of 3`:'Your habit cards');
  if(finderStep<3){
   const q=finderQuestions[finderStep];make('h3',q.question);
   if(finderStep===0)make('p','Choose one or two. Start with the parts of the day that need the most reminders.');
   if(finderStep===1)make('p','Pick what would help most. Your chosen habits will appear on the cards.');
   q.options.forEach(option=>{
    const btn=make('button',option,'jhc-finder-choice') as HTMLButtonElement;btn.type='button';
    if(finderStep===0){btn.setAttribute('aria-pressed',String(selectedHabits.includes(option)));btn.addEventListener('click',()=>{selectedHabits=selectedHabits.includes(option)?selectedHabits.filter(x=>x!==option):selectedHabits.length<2?[...selectedHabits,option]:[selectedHabits[1],option];renderFinder()})}
    else btn.addEventListener('click',()=>{finderAnswers[finderStep]=option;finderStep++;renderFinder()});
   });
   if(finderStep===0){const next=make('button','Next: Choose what would help','jhc-finder-choice jhc-finder-apply') as HTMLButtonElement;next.type='button';next.disabled=selectedHabits.length===0;next.addEventListener('click',()=>{finderStep=1;renderFinder()})}
  }else{
   const picks=[...selectedHabits];
   const priority=otherSuggestion[finderAnswers[1]];
   if(priority&&picks.includes(priority))picks.sort((a,b)=>Number(b===priority)-Number(a===priority));
   // Respect the family's choice of one or two habits. Never add a second without asking.
   const who=finderAnswers[2]||'Everyone';
   picks.slice(0,2).forEach((choice,i)=>{const suggestion=suggestions[choice];make('h3',`Card ${i+1}: ${suggestion.name}`);make('p',`For: ${who}`);make('p',`When: ${suggestion.anchor}`);make('p',suggestion.action)});
   const btn=make('button','Use these habits','jhc-finder-choice jhc-finder-apply') as HTMLButtonElement;btn.type='button';
   btn.addEventListener('click',()=>{picks.slice(0,2).forEach((choice,i)=>{values[i]={...values[i],...suggestions[choice],name:suggestions[choice].name,who}});activeCount=picks.length;save();paint();finder?.close()});
  }
  const back=root.querySelector<HTMLButtonElement>('[data-jhc-finder-back]');if(back)back.hidden=finderStep===0;
 };
 root.querySelectorAll('[data-jhc-finder-open]').forEach(button=>button.addEventListener('click',()=>{finderStep=0;finderAnswers.length=0;selectedHabits=[];renderFinder();finder?.showModal()}));
 root.querySelectorAll('[data-jhc-finder-close]').forEach(b=>b.addEventListener('click',()=>finder?.close()));
 root.querySelector('[data-jhc-finder-back]')?.addEventListener('click',()=>{finderStep=Math.max(0,finderStep-1);renderFinder()});
 finder?.addEventListener('click',e=>{if(e.target===finder)finder.close()});
 const cards=Array.from(root.querySelectorAll<HTMLElement>('[data-jhc-card]'));
 let values=defaults.map(x=>({...x}));
 let activeCount=2;
 try{const count=Number(storage.getItem(key+':count'));if(count===1||count===2)activeCount=count}catch{}
 try {const saved=JSON.parse(storage.getItem(key)??'null');if(Array.isArray(saved)&&saved.length===4) values=defaults.map((d,i)=>Object.fromEntries(Object.entries(d).map(([k,v])=>[k,typeof saved[i]?.[k]==='string'?saved[i][k].slice(0,105):v])) as typeof d)}catch{}
 const save=()=>{try{storage.setItem(key,JSON.stringify(values));storage.setItem(key+':count',String(activeCount))}catch{}};
 const paint=()=>{
  cards.forEach((card,i)=>{card.hidden=i>=activeCount});
  editors.forEach((editor,i)=>{editor.hidden=i>=activeCount});
  root.querySelector<HTMLElement>('[data-jhc-card-grid]')?.classList.toggle('jhc-one-card',activeCount===1);
  const habitLabel=root.querySelector<HTMLElement>('[data-jhc-habit-label]');if(habitLabel)habitLabel.textContent=values[0].name;
  editors.forEach((el,i)=>{el.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('[data-field]').forEach(input=>{const field=input.dataset.field as keyof typeof defaults[number];if(document.activeElement!==input)input.value=values[i][field]})});
  cards.forEach((el,i)=>{const owner=el.querySelector<HTMLElement>('[data-jhc-owner]');if(owner)owner.textContent='FOR '+((values[i] as typeof values[number] & {who?:string}).who||'THE FAMILY').toUpperCase();el.querySelectorAll<HTMLElement>('[data-print-field]').forEach(target=>{const field=target.dataset.printField as keyof typeof defaults[number];if(document.activeElement!==target)target.textContent=values[i][field] || ' ';});});
 };
 // Click directly on printed words; keep caret in place and save to the existing card state.
 cards.forEach((card,i)=>card.querySelectorAll<HTMLElement>('[data-print-field]').forEach(target=>{
  const field=target.dataset.printField as keyof typeof defaults[number];
  const max=field==='name'?42:field==='anchor'?85:field==='action'?105:70;
  const capture=()=>{values[i][field]=(target.textContent??'').replace(/\s+/g,' ').slice(0,max);try{storage.setItem(key,JSON.stringify(values))}catch{}};
  target.addEventListener('input',capture);
  target.addEventListener('blur',()=>{values[i][field]=(target.textContent??'').replace(/\s+/g,' ').trim().slice(0,max);try{storage.setItem(key,JSON.stringify(values))}catch{}paint()});
  target.addEventListener('keydown',(event:KeyboardEvent)=>{if(event.key==='Enter'){event.preventDefault();target.blur()}});
 }));
 editors.forEach((el,i)=>el.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('[data-field]').forEach(input=>input.addEventListener('input',()=>{
  const field=input.dataset.field as keyof typeof defaults[number];values[i][field]=input.value.slice(0,105);
  try{storage.setItem(key,JSON.stringify(values))}catch{}
  paint();
 })));
 root.querySelector('[data-reset]')?.addEventListener('click',()=>{
  values=defaults.map(x=>({...x}));try{storage.removeItem(key);storage.removeItem(key+':count');storage.removeItem(key+':automatic-names');activeCount=2}catch{}paint();
  const status=root.querySelector<HTMLElement>('[data-status]');if(status)status.textContent='Original suggestions restored. Print at 100% / actual size on US Letter paper.';
 });
 // Keep the four actual printable cards, but derive the starting owners from
 // the shared Club family settings. Never replace custom card names on profile edits.
 let suggestedNames=defaults.map(d=>d.name);
 try {
  const previous=JSON.parse(storage.getItem(key+':automatic-names')??'null');
  if(Array.isArray(previous)&&previous.length===4)suggestedNames=previous.filter((v:unknown)=>typeof v==='string') as string[];
 } catch { /* No previous family suggestion. */ }
 window.addEventListener('omc:club-preview-household',(event:Event)=>{
  const household=(event as CustomEvent<{household:{members:{firstName:string;kind:string;archived?:boolean}[]} | null}>).detail?.household;
  if(!household)return;
  const kids=household.members.filter(m=>m.kind==='child'&&!m.archived);
  const adults=household.members.filter(m=>m.kind==='adult'&&!m.archived);
  const nextNames=[
   kids[0]?kids[0].firstName+'’s morning':'My morning',
   kids[1]?kids[1].firstName+'’s backpack':kids[0]?kids[0].firstName+'’s backpack':'My backpack',
   kids[2]?kids[2].firstName+'’s bedroom':kids[0]?kids[0].firstName+'’s bedroom':'My bedroom',
   adults.length>1?'Our kitchen':'Our kitchen'
  ];
  values.forEach((item,i)=>{if(item.name===suggestedNames[i]||item.name===defaults[i].name)item.name=nextNames[i]});
  suggestedNames=nextNames;
  try{storage.setItem(key,JSON.stringify(values));storage.setItem(key+':automatic-names',JSON.stringify(nextNames))}catch{}
  paint();
 });
 root.querySelector('[data-print]')?.addEventListener('click',()=>{(document.activeElement as HTMLElement|null)?.blur();window.print()});
 root.querySelector<HTMLButtonElement>('[data-single-page-png]')?.addEventListener('click',async()=>{
  const button=root.querySelector<HTMLButtonElement>('[data-single-page-png]');
  const sheet=root.querySelector<HTMLElement>("[data-jhc-page]");
  if(!button||!sheet)return;
  (document.activeElement as HTMLElement|null)?.blur();
  button.disabled=true;const old=button.textContent;button.textContent='Preparing image…';
  root.classList.add('jhc-image-export');
  try{
   await Promise.all(Array.from(sheet.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));
   const {toPng}=await import('html-to-image');
   const png=await toPng(sheet,{pixelRatio:2,width:816,height:1056,backgroundColor:'#fff',style:{transform:'none',margin:'0',boxShadow:'none'}});
   const link=document.createElement('a');link.href=png;link.download="january-family-habit-cards.png";link.click();
  }catch(error){console.error('Single-page image export failed',error);alert('Image download failed. Please use Print / Save PDF instead.')}
  finally{root.classList.remove('jhc-image-export');button.disabled=false;button.textContent=old}
 });
 
 paint();
}
</script>
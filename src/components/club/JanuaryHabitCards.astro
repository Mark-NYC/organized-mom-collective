<script>
import {
  HABIT_LIMITS, FINDER_PROBLEMS, FINDER_WHO, applyFamilyNames, applyFinder, clip, finderActions, freshHabitState,
  habitFingerprint, isHabitState, ownerLine, suggestionFor, type Habit, type HabitChoice, type HabitState, type JhcPlan,
} from '../../lib/club/engines/january-habit-cards';
import type { PlanMember } from '../../lib/club/engines/sunday-reset';
import { PLAN_CHANGE } from '../../lib/club/plan/resource';
import { planKey, readScoped, tabStorage } from '../../lib/club/plan/storage';

type Household = { id: string; members?: (PlanMember & { archived?: boolean })[] };

for (const root of document.querySelectorAll<HTMLElement>('.jhc')) {
 const editorDialog=root.querySelector<HTMLDialogElement>('[data-jhc-dialog]');
 root.querySelectorAll('[data-jhc-open]').forEach(button=>button.addEventListener('click',()=>editorDialog?.showModal()));
 root.querySelectorAll('[data-jhc-close]').forEach(button=>button.addEventListener('click',()=>editorDialog?.close()));
 editorDialog?.addEventListener('click',event=>{if(event.target===editorDialog)editorDialog.close()});
 const stage=root.querySelector<HTMLElement>('[data-jhc-stage]');
 const fit=()=>{if(!stage)return;const width=Math.max(180,(stage.parentElement?.clientWidth??816)-4);const scale=Math.min(1,width/816);stage.style.width=816*scale+'px';stage.style.height=1056*scale+'px';stage.style.setProperty('--jhc-scale',String(scale))};
 fit();if(stage?.parentElement&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(stage.parentElement);window.addEventListener('resize',fit);

 // Plan state: one family at a time, in this tab only (never localStorage).
 const key = root.dataset.jhcStorage ?? 'omc:club:september-habit-cards:v2';
 for (const legacy of [key, key+':count', key+':automatic-names']) { try { localStorage.removeItem(legacy); } catch { /* none */ } }
 let current='', members:PlanMember[]=[], persist=true, locked=false;
 let state:HabitState=readScoped(tabStorage.get(key),current,isHabitState)??freshHabitState();
 const save=()=>{if(persist)tabStorage.set(key,JSON.stringify({current,state}))};

 const editors=Array.from(root.querySelectorAll<HTMLElement>('[data-jhc-editor]'));
 const cards=Array.from(root.querySelectorAll<HTMLElement>('[data-jhc-card]'));
 const paint=()=>{
  cards.forEach((card,i)=>{card.hidden=i>=state.count});
  editors.forEach((editor,i)=>{editor.hidden=i>=state.count});
  root.querySelector<HTMLElement>('[data-jhc-card-grid]')?.classList.toggle('jhc-one-card',state.count===1);
  const habitLabel=root.querySelector<HTMLElement>('[data-jhc-habit-label]');if(habitLabel)habitLabel.textContent=state.habits[0].name;
  editors.forEach((el,i)=>{el.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('[data-field]').forEach(input=>{const field=input.dataset.field as keyof Habit;if(document.activeElement!==input)input.value=state.habits[i][field]})});
  cards.forEach((el,i)=>{
   const habit=state.habits[i];
   el.classList.toggle('jhc-long',habit.action.length>65||habit.anchor.length>55||habit.name.length>28);
   const words=(habit.name+' '+habit.action).toLowerCase();
   const icon=/backpack|bag|shoes|door/.test(words)?'backpack':/pajama|clothes|dresser|bed/.test(words)?'pajamas':/dinner|table/.test(words)?'table-after-meal':/dish|bowl|plate|sink|breakfast/.test(words)?'dishes-in-sink':null;
   const picture=el.querySelector<HTMLImageElement>('.jhc-card-icon img');
   if(picture){picture.hidden=!icon;if(icon)picture.src='/images/club/icon-library/'+icon+'.png'}
   const owner=el.querySelector<HTMLElement>('[data-jhc-owner]');if(owner)owner.textContent=state.habits[i].who.toUpperCase()==='THE FAMILY'?'MY DAILY REMINDER':ownerLine(state.habits[i].who);
   el.querySelectorAll<HTMLElement>('[data-print-field]').forEach(target=>{const field=target.dataset.printField as keyof Habit;if(document.activeElement!==target)target.textContent=state.habits[i][field]});
  });
  if(current)root.dispatchEvent(new CustomEvent(PLAN_CHANGE,{bubbles:true}));
 };
 const change=(mutate:(s:HabitState)=>void)=>{mutate(state);save();paint()};

 // Click directly on printed words; keep caret in place and save to the same card state.
 cards.forEach((card,i)=>card.querySelectorAll<HTMLElement>('[data-print-field]').forEach(target=>{
  const field=target.dataset.printField as keyof Habit;
  target.addEventListener('input',()=>{state.habits[i][field]=clip(field,target.textContent??'');save();if(current)root.dispatchEvent(new CustomEvent(PLAN_CHANGE,{bubbles:true}))});
  target.addEventListener('blur',()=>{if(!locked)change(s=>{s.habits[i][field]=clip(field,target.textContent??'').trim()});else paint()});
  target.addEventListener('keydown',(event:KeyboardEvent)=>{if(event.key==='Enter'){event.preventDefault();target.blur()}});
 }));
 editors.forEach((el,i)=>el.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('[data-field]').forEach(input=>input.addEventListener('input',()=>{
  const field=input.dataset.field as keyof Habit;
  change(s=>{s.habits[i][field]=input.value.slice(0,HABIT_LIMITS[field])});
 })));
 root.querySelector('[data-reset]')?.addEventListener('click',()=>{
  change(s=>{const fresh=applyFamilyNames(freshHabitState(),members);Object.assign(s,fresh)});
  const status=root.querySelector<HTMLElement>('[data-status]');if(status)status.textContent='Original suggestions restored. Print at 100% / actual size on US Letter paper.';
 });

 // The habit finder (desktop dialog). Same suggestions as the mobile plan (january-habit-cards.ts).
 const finder=root.querySelector<HTMLDialogElement>('[data-jhc-finder-dialog]');
 const finderBody=root.querySelector<HTMLElement>('[data-jhc-finder-body]');
 let finderStep=0, habitIndex=0, drafts:HabitChoice[]=[];
 const renderFinder=()=>{
  if(!finderBody)return;
  finderBody.replaceChildren();
  const make=(tag:string,content:string,cls?:string)=>{const el=document.createElement(tag);el.textContent=content;if(cls)el.className=cls;finderBody.append(el);return el};
  const number=habitIndex+1;
  make('p',`HABIT ${number} OF UP TO 2`);
  const choose=(option:string,selected:boolean,onChoose:()=>void)=>{
   const button=make('button',option,'jhc-finder-choice') as HTMLButtonElement;
   button.type='button';button.setAttribute('aria-pressed',String(selected));
   button.addEventListener('click',onChoose);
  };
  const draft=drafts[habitIndex];
  if(finderStep===0){
   make('h3',`What keeps needing reminders?`);
   make('p',`Choose one thing to make easier. We’ll finish this habit before choosing another.`);
   FINDER_PROBLEMS.filter(problem=>habitIndex===0||problem!==drafts[0]?.problem).forEach(problem=>choose(problem,draft?.problem===problem,()=>{
    drafts[habitIndex]={problem,action:0,who:draft?.who||'Everyone'};
    finderStep=1;renderFinder();
   }));
  }else if(finderStep===1&&draft){
   make('h3','What would you like to happen instead?');
   make('p','Choose one small thing your family could do without being reminded.');
   finderActions(draft.problem).forEach((action,i)=>choose(action,draft.action===i,()=>{
    draft.action=i;finderStep=2;renderFinder();
   }));
  }else if(finderStep===2&&draft){
   make('h3','Who will practice this habit?');
   make('p','Choose who will use this card. You can change the name on the card afterward.');
   FINDER_WHO.forEach(who=>choose(who,draft.who===who,()=>{
    draft.who=who;finderStep=3;renderFinder();
   }));
  }else if(finderStep===3&&draft){
   const result=suggestionFor(draft);
   make('h3',`Habit ${number}: ${result.name}`);
   make('p',`For: ${draft.who}`);
   make('p',`When: ${result.anchor}`);
   make('p',result.action);
   make('p',`Put the card: ${result.place}`);
   if(habitIndex===0){
    const second=make('button','Add a second habit','jhc-finder-choice jhc-finder-apply') as HTMLButtonElement;
    second.type='button';
    second.addEventListener('click',()=>{habitIndex=1;finderStep=0;renderFinder()});
   }
   const done=make('button',habitIndex===0?'Use this one habit':'Use both habits','jhc-finder-choice jhc-finder-apply') as HTMLButtonElement;
   done.type='button';
   done.addEventListener('click',()=>{change(s=>applyFinder(s,drafts.slice(0,habitIndex+1)));finder?.close()});
  }
  const back=root.querySelector<HTMLButtonElement>('[data-jhc-finder-back]');
  if(back)back.hidden=habitIndex===0&&finderStep===0;
 };
 const openFinder=(event:Event)=>{
  event.preventDefault();
  if(!finder)return;
  finderStep=0;habitIndex=0;drafts=[];renderFinder();
  if(!finder.open)finder.showModal();
 };
 root.querySelectorAll('[data-jhc-finder-open]').forEach(button=>button.addEventListener('click',openFinder));
 root.querySelectorAll('[data-jhc-finder-close]').forEach(button=>button.addEventListener('click',()=>finder?.close()));
 root.querySelector('[data-jhc-finder-back]')?.addEventListener('click',()=>{
  if(finderStep>0)finderStep--;
  else if(habitIndex>0){habitIndex--;finderStep=3;}
  renderFinder();
 });
 finder?.addEventListener('click',event=>{if(event.target===finder)finder.close()});

 // The family: card names from the shared Club household, never replacing names she typed.
 const applyHousehold=(detail?:{household:Household|null;sample?:string|null})=>{
  const household=detail?.household;
  if(!household)return;
  members=(household.members??[]).filter(m=>(m.kind==='adult'||m.kind==='child')&&!m.archived);
  const next=planKey(detail?.sample,household.id);
  if(next!==current){current=next;state=readScoped(tabStorage.get(key),current,isHabitState)??freshHabitState()}
  applyFamilyNames(state,members);save();paint();
 };
 window.addEventListener('omc:club-preview-household',(event:Event)=>applyHousehold((event as CustomEvent<{household:Household|null;sample?:string|null}>).detail));
 applyHousehold((window as Window & {__ofcPreviewHousehold?:{household:Household|null;sample?:string|null}}).__ofcPreviewHousehold);

 root.querySelector('[data-print]')?.addEventListener('click',()=>{(document.activeElement as HTMLElement|null)?.blur();window.print()});
 root.querySelector<HTMLButtonElement>('[data-single-page-png]')?.addEventListener('click',async()=>{
  const button=root.querySelector<HTMLButtonElement>('[data-single-page-png]');
  const sheet=root.querySelector<HTMLElement>("[data-jhc-page]");
  if(!button||!sheet)return;
  (document.activeElement as HTMLElement|null)?.blur();
  button.disabled=true;const old=button.textContent;button.textContent='Preparing image…';
  root.classList.add('jhc-image-export');
  try{
   await Promise.all(Array.from(sheet.querySelectorAll('img')).map(img=>img.complete?null:img.decode().catch(()=>null)));
   const {toPng}=await import('html-to-image');
   const png=await toPng(sheet,{pixelRatio:2,width:816,height:1056,backgroundColor:'#fff',style:{transform:'none',margin:'0',boxShadow:'none'}});
   const link=document.createElement('a');link.href=png;link.download="september-family-habit-cards.png";link.click();
  }catch(error){console.error('Single-page image export failed',error);alert('Image download failed. Please use Print / Save PDF instead.')}
  finally{root.classList.remove('jhc-image-export');button.disabled=false;button.textContent=old}
 });


 const setLocked=(on:boolean)=>{locked=on;cards.forEach(card=>card.querySelectorAll<HTMLElement>('[data-print-field]').forEach(el=>el.setAttribute('contenteditable',on?'false':'true')));if(on){editorDialog?.close();finder?.close()}};
 const openEditor=(which:'cards'|'finder')=>{if(locked)return;if(which==='finder'){finderStep=0;habitIndex=0;drafts=[];renderFinder();if(finder&&!finder.open)finder.showModal()}else if(editorDialog&&!editorDialog.open)editorDialog.showModal()};
 const plan:JhcPlan={ready:()=>Boolean(current),state:()=>state,members:()=>members,update:change,replace:next=>{state=structuredClone(next);save();paint()},setPersist:on=>{persist=on;if(on)save()},fingerprint:()=>habitFingerprint(state),setLocked,openEditor};
 (root as HTMLElement & {clubPlan?:JhcPlan}).clubPlan=plan;
 paint();
}
</script>

.jhc-card:nth-child(odd){border-right:1px dashed #bcbab0}.jhc-card:nth-child(-n+2){border-bottom:1px dashed #bcbab0}
.jhc-card-top{display:flex;justify-content:space-between;align-items:center;color:#959089}.jhc-brand{font-size:8px}.jhc-card-number{color:#8b9a84}
.jhc-card-icon{width:58px;height:58px;margin:13px auto 7px;background:#e9eee7;border-radius:50%;display:flex;justify-content:center;align-items:center;color:#576953;transform:rotate(-3deg)}.jhc-card:nth-child(2) .jhc-card-icon{background:#e8eff1}.jhc-card:nth-child(3) .jhc-card-icon{background:#f3e7d6}.jhc-card:nth-child(4) .jhc-card-icon{background:#f0e7e5}.jhc-card-icon svg{height:37px;width:37px}

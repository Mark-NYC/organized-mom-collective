#club-month-content .jhc-floating-edit,#club-month-content .jhc-jump-edit{display:none}
#club-month-content .jhc-dialog{position:fixed;inset:0;margin:auto;width:min(650px,calc(100vw - 64px));max-height:calc(100dvh - 80px);overflow-y:auto;overscroll-behavior:contain;padding:24px;box-sizing:border-box;border:1px solid #dce2d7;border-radius:10px;background:#fff;color:#484941;box-shadow:0 20px 65px #0003;font-family:Montserrat,Arial,sans-serif}

@media(max-width:700px){.jhc-forms{grid-template-columns:1fr}.jhc-config{padding:20px}.jhc-preview-heading{display:block}.jhc-page{margin-left:0}}
@page{size:letter portrait;margin:0}
@media print{
 html,body{margin:0!important;padding:0!important;background:white!important}
 body *{visibility:hidden!important}

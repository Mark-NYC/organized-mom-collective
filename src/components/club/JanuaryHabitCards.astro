.jhc-card-bottom{border-top:1px solid #d9dbd4;margin-top:auto;padding-top:10px}.jhc-card-bottom span{font-size:8px;color:#8c8c83}.jhc-card-bottom p{font:italic 14px Georgia,serif;margin:5px 0 0;overflow-wrap:anywhere}

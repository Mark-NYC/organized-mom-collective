---
/**
 * The Club plan page at 1100px and wider, shared by every month: a document-centred editor. About 30% is the rail
 * (a breadcrumb, a compact title, the print deadline on one line, Approve / Make changes / Download and print, whose
 * family it is, the month's details and how to use the sheet); the rest is the real printable, scrolling on its own at
 * up to actual size. The page is exactly one screen tall under the one header, so the printable is visible at once.
 * Put it in ClubPlanShell's `desktop` slot; the printable stays in the `printable` slot. Wired by mountPlanDesktop
 * (src/lib/club/plan/desktop.ts). Architecture: docs/club/PLAN_ARCHITECTURE.md.
 */
interface Props {
  /** clubEditingDeadline(month), an ISO timestamp. */
  deadline: string;
  /** e.g. "April · Kit preview". */
  kicker: string;
  /** How to use the printable, one paragraph each. */
  instructions: string[];
}
const { deadline, kicker, instructions } = Astro.props;
---
<aside class="cpd" data-plan-desktop data-deadline={deadline} aria-label="Your plan">
  <header class="cpd-head">
    <p class="cpd-crumb"><a href="/app/club">Club</a> <span aria-hidden="true">/</span> {kicker.split(' · ')[0]}</p>
    <h1><slot name="title" /></h1>
  </header>
  <section class="cpd-deadline" aria-label="Print deadline">
    <p class="cpd-label" hidden>Your editing window</p>
    <p class="cpd-status" data-cpd-status role="status">Checking deadline…</p>
    <div class="cpd-countdown" data-cpd-countdown hidden role="timer"><span><strong data-cpd-days>–</strong><small>Days</small></span><span><strong data-cpd-hours>–</strong><small>Hours</small></span><span><strong data-cpd-minutes>–</strong><small>Minutes</small></span></div>
    <p class="cpd-detail" data-cpd-detail></p>
  </section>
  <div class="cpd-actions">
    <button type="button" class="cpd-approve" data-cpd-approve>Approve preview</button>
    <button type="button" class="cpd-edit" data-cpd-edit>Make changes</button>
    <button type="button" class="cpd-print" data-plan-print>Download and print</button>
  </div>
  <div class="cpd-note"><p data-cpd-source></p><p data-cpd-approval role="status"></p><button type="button" class="cpd-undo" data-cpd-undo hidden>Undo</button></div>
  <slot />
  <div class="cpd-instructions">{instructions.map((p) => <p>{p}</p>)}</div>
</aside>
<style is:global>
.cpd{display:none}
@media screen and (min-width:1100px){
  /* The page is one screen tall: the header, then the plan; the rail and the document scroll on their own. */
  html:has(.club-plan > .cpd),body:has(.club-plan > .cpd){height:100%;overflow:hidden}
  body:has(.club-plan > .cpd){display:flex;flex-direction:column}
  body:has(.club-plan > .cpd) > *{flex:none}
  body:has(.club-plan > .cpd) #main{flex:1 1 auto;display:flex;flex-direction:column;position:relative;width:100%;max-width:none;height:auto;min-height:0;margin:0;padding:0;overflow:hidden}
  body:has(.club-plan > .cpd) #main > *{flex:none}
  body:has(.club-plan > .cpd) #main > .club-plan{flex:1 1 auto}
  /* About 30% for the controls, the rest for the printable. */
  .club-plan[data-plan-state="ready"]:has(> .cpd){display:grid;grid-template-columns:clamp(320px,30%,440px) minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);width:100%;height:auto;min-height:0;overflow:hidden;background:var(--color-ivory);color:var(--color-warm-ink);font-family:var(--font-sans)}
  .club-plan > .cpd{display:block;grid-column:1;grid-row:2;height:100%;min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;background:var(--color-ivory);border-right:1px solid var(--color-warm-rule);padding:22px clamp(20px,2.2vw,34px) 36px}
  .club-plan:has(> .cpd) [data-plan-proof-body]{grid-column:2;grid-row:1 / span 2;height:100%;min-height:0;min-width:0;overflow:hidden}
  .club-plan:has(> .cpd) [data-plan-proof-scroll]{height:100%;min-height:0;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;background:#f1efec;padding:22px clamp(18px,3vw,45px) 48px;scrollbar-color:#b7b7b2 transparent}
  .club-plan:has(> .cpd) [data-plan-proof-scroll]:focus-visible{outline:2px solid #536e4e;outline-offset:-2px}
  /* The Monthly Tool / Family Meeting switch sits at the top of the rail, not in a bar across the page. */
  .club-plan[data-plan-state="ready"]:has(> .cpd) > .fm-switch{grid-column:1;grid-row:1;justify-self:stretch;width:auto;margin:0;padding:12px clamp(20px,2.2vw,34px) 0;border:0;border-right:1px solid var(--color-warm-rule);border-radius:0;background:var(--color-ivory)}
  .club-plan[data-plan-state="ready"]:has(> .cpd) > .fm-switch button{flex:1;min-height:38px;padding:0 10px;border:1px solid var(--color-warm-rule);border-radius:3px;font-size:.66rem}
  /* Welcome Kit mode: her one job is this printable. */
  .club-plan[data-plan-welcome] > .fm-switch{display:none!important}

  .cpd-head{margin:0 0 14px;padding-bottom:14px;border-bottom:1px solid var(--color-warm-rule)}
  .cpd-crumb{font-size:.68rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--color-warm-soft)}
  .cpd-crumb a{display:inline-flex;align-items:center;min-height:32px;color:var(--color-warm-ink);text-decoration:underline;text-decoration-color:var(--color-warm-rule);text-underline-offset:5px}
  .cpd-head h1{font:400 clamp(26px,2.3vw,32px)/1.12 var(--font-serif);letter-spacing:-.015em;color:var(--color-warm-ink);margin:6px 0 0}
  .cpd-head h1 em{color:inherit}
  .cpd-deadline{margin:0 0 16px;color:var(--color-warm-soft);font-size:.8rem}
  .cpd-status{display:inline-flex;align-items:center;gap:8px;padding:5px 11px;border-radius:999px;background:#eef2ea;color:#354f42;font-weight:600;font-size:.76rem}
  .cpd-status::before{content:'';width:7px;height:7px;border-radius:50%;background:#71866c}
  .cpd[data-deadline-soon="true"] .cpd-status{background:#f6e6c8;color:#5c4520}
  .cpd[data-deadline-soon="true"] .cpd-status::before{background:#c8963c}
  .cpd-label{letter-spacing:.16em;text-transform:uppercase;font-weight:600;font-size:.68rem;margin-bottom:10px}
  .cpd-label[hidden]{display:none}
  .cpd-countdown{display:flex;gap:20px;margin:12px 0}
  .cpd-countdown[hidden]{display:none}
  .cpd-countdown span{display:flex;flex-direction:column}
  .cpd-countdown strong{font:400 1.65rem var(--font-serif);font-variant-numeric:tabular-nums;color:var(--color-warm-ink)}
  .cpd-countdown small{font-size:.66rem;letter-spacing:.1em;text-transform:uppercase}
  .cpd-detail{margin-top:6px;font-size:.72rem;line-height:1.5}
  .cpd-actions{display:flex;flex-direction:column;gap:10px}
  .cpd-actions button{min-height:46px;padding:10px 18px;border:1px solid var(--color-warm-ink);border-radius:3px;background:transparent;color:var(--color-warm-ink);font:600 .74rem var(--font-sans);letter-spacing:.13em;text-transform:uppercase;cursor:pointer}
  .cpd-actions button[hidden]{display:none}
  .cpd-actions .cpd-edit:hover:not(:disabled){background:var(--color-warm-ink);color:#fff}
  .cpd-actions button:disabled{cursor:default;opacity:.6}
  .cpd-actions .cpd-approve{background:var(--color-warm-button);border-color:var(--color-warm-button);color:#fff}
  .cpd-actions .cpd-approve[aria-disabled="true"]{background:#eef2ea;border-color:var(--color-sage);color:#536e4e;cursor:default}
  .cpd-actions .cpd-print{align-self:flex-start;min-height:40px;padding:5px 2px;border:0;text-decoration:underline;text-decoration-color:var(--color-warm-rule);text-underline-offset:6px}
  .cpd-actions .cpd-print:hover{text-decoration-color:currentColor}
  .cpd-note{margin-top:6px;color:var(--color-warm-soft);font-size:.74rem;line-height:1.5}
  .cpd-undo{min-height:32px;border:0;background:none;padding:0;color:#536e4e;font-weight:600;text-decoration:underline;text-underline-offset:4px;cursor:pointer}
  .cpd-undo[hidden]{display:none}
  .cpd-instructions{display:grid;gap:10px;margin-top:24px;padding-top:18px;border-top:1px solid var(--color-warm-rule);color:var(--color-warm-soft);font-size:.8rem;line-height:1.6}
  .cpd :focus-visible{outline:2px solid #536e4e;outline-offset:3px}

  /* The month's details: short labeled blocks, each with one edit link. */
  .cpd-details{display:grid;gap:0;margin-top:24px;border-top:1px solid var(--color-warm-rule)}
  .cpd-block{padding:16px 0;border-bottom:1px solid var(--color-warm-rule)}
  .cpd-block > strong{display:block;font:400 1.25rem/1.25 var(--font-serif);color:var(--color-warm-ink)}
  .cpd-block > p{font-size:.8rem;line-height:1.5;color:var(--color-warm-soft);margin-top:3px}
  .cpd-rows{display:grid;margin:2px 0 0}
  .cpd-rows div{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:5px 0;font-size:.82rem;color:var(--color-warm-soft)}
  .cpd-rows dd{margin:0;font-weight:600;color:var(--color-warm-ink);text-align:right}
  .cpd-link{display:block;min-height:44px;border:0;background:none;padding:0;color:#536e4e;font-size:.8rem;font-weight:600;text-decoration:underline;text-underline-offset:4px;cursor:pointer;text-align:left}
  .cpd-link:disabled{color:var(--color-warm-soft);text-decoration:none;cursor:default}
  .cpd-link[hidden],.cpd-hint[hidden]{display:none}
  .cpd-hint{font-size:.74rem;line-height:1.45;color:var(--color-warm-soft);margin-top:-6px}
}
@media print{.cpd{display:none!important}}
</style>

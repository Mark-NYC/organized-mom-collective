---
/**
 * A Club plan page: the family gate, the month's desktop view, its printable (full-screen on request below
 * 1100px) and its mobile plan screen, with shared printing. The month supplies four slots:
 *   desktop  — the month's own desktop view (or nothing, if the printable component brings its own)
 *   printable — the printable inside data-plan-proof-body / data-plan-proof-scroll wrappers
 *   mobile   — a ClubPlanScreen with the month's sections
 * Every plan page also gets the month's Family Meeting (ClubFamilyMeeting) behind a "Monthly Tool / Family Meeting"
 * switch; the tool stays the default view. Above it, for a signed-in member: the Club nav (ClubNav) and, on her first
 * month, her Welcome Kit confirmation (WelcomeKitConfirm).
 * Architecture: docs/club/PLAN_ARCHITECTURE.md.
 */
import { kitBySlug } from '../../../data/club/kits';
import ClubFamilyGate from './ClubFamilyGate.astro';
import ClubFamilyMeeting from './ClubFamilyMeeting.astro';
import ClubPrintableProof from './ClubPrintableProof.astro';
import ClubPrintStyles from './ClubPrintStyles.astro';
import WelcomeKitConfirm from './WelcomeKitConfirm';
import { ClubNavForMembers } from '../ClubNav';

interface Props {
  /** The month's kit. Not used by the Welcome resource (context="welcome"). */
  kitSlug?: string;
  /**
   * 'month' (default): a month's plan page. 'welcome': the permanent Welcome Family Rhythm (/app/club/family-rhythm):
   * no kit, no monthly Family Meeting, no Welcome Kit confirmation, no editing deadline; open to any member, her plan
   * and approval saved to her account (docs/club/WELCOME_MARCH_DECEMBER_MIGRATION.md → Phase 2b).
   */
  context?: 'month' | 'welcome';
  /** "October": used in the gate's messages. */
  month: string;
  /** The printable's sides for the full-screen Front/Back switch (none for a single sheet). */
  sides?: string[];
  storageKey?: string;
  class?: string;
  /** The Monthly Tool / Family Meeting switch. Off for a month whose tool is the Family Meeting guide (January). */
  meeting?: boolean;
}
const { kitSlug, month, sides, storageKey, class: cls = '', meeting = true, context = 'month' } = Astro.props;
const welcome = context === 'welcome';
const kit = welcome ? null : kitBySlug(kitSlug ?? '');
if (!welcome && !kit) throw new Error(`Unknown kit ${kitSlug}`);
---
<!-- A signed-in member: the Club nav, and her Welcome Kit confirmation when this is her first month (both render nothing otherwise). -->
<ClubNavForMembers client:only="react" />
{!welcome && <WelcomeKitConfirm client:only="react" kitSlug={kitSlug!} />}
<div class={`club-plan ${cls}`.trim()} data-plan-state="loading" data-kit-slug={welcome ? undefined : kitSlug} data-plan-context={welcome ? 'welcome' : undefined} data-plan-month={month} data-plan-key={storageKey}>
  <ClubFamilyGate />
  {meeting && kit && <ClubFamilyMeeting kitMonth={kit.month} />}
  <slot name="desktop" />
  <ClubPrintableProof sides={sides}><slot name="printable" /></ClubPrintableProof>
  <slot name="mobile" />
</div>
<ClubPrintStyles />
<script>
import { startPlanFamily } from '../../../lib/club/plan/family';
import { mountPrintableProof } from '../../../lib/club/plan/proof';
for (const root of document.querySelectorAll<HTMLElement>('.club-plan')) {
  mountPrintableProof(root);
  startPlanFamily(root);
}
</script>

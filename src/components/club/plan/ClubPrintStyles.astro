---
/**
 * Printing for every Club plan page: exactly one US Letter page per sheet, whatever the screen was showing.
 * Only the sheets (data-plan-sheet) and the elements that contain them take part in print layout; everything
 * else is removed, so nothing on the page can add a blank page. The last sheet carries data-plan-sheet-end.
 * Tested by tests/club-plan-print.test.ts (WebKit pagination model) and the browser checks in the PR.
 *
 * In the Family Meeting view (data-plan-view="meeting", ClubFamilyMeeting.astro) the same approach prints only the
 * meeting guide (data-meeting-sheet): one portrait US Letter page, whatever the month's tool prints.
 */
---
<style is:global>
@media print{
  @page{size:letter portrait;margin:0}
  html:has(.club-plan),html:has(.club-plan) body{width:8.5in!important;height:auto!important;overflow:visible!important;margin:0!important;padding:0!important;background:#fff!important}
  body:has(.club-plan) #main{position:static!important;width:8.5in!important;max-width:none!important;height:auto!important;min-height:0!important;overflow:visible!important;margin:0!important;padding:0!important}
  .club-plan:not([data-plan-state="ready"]){display:none!important}
  /* :not(#plan-print) adds id-level specificity, so a printable's own id-scoped !important rules can't
     keep its editor panels in the print layout. */
  .club-plan[data-plan-state="ready"]:not([data-plan-view="meeting"]) :not(#plan-print):not([data-plan-sheet]):not([data-plan-sheet] *):not(:has([data-plan-sheet])){display:none!important}
  .club-plan[data-plan-state="ready"]:not([data-plan-view="meeting"]):not(#plan-print),.club-plan[data-plan-state="ready"]:not([data-plan-view="meeting"]) :not(#plan-print):has([data-plan-sheet]){
    display:block!important;position:static!important;float:none!important;
    width:8.5in!important;max-width:none!important;height:auto!important;
    min-height:0!important;max-height:none!important;
    margin:0!important;padding:0!important;gap:0!important;
    border:0!important;background:#fff!important;
    overflow:visible!important;transform:none!important;
    box-shadow:none!important;scrollbar-width:none!important;
  }
  .club-plan[data-plan-state="ready"]:not([data-plan-view="meeting"]) [data-plan-sheet]:not(#plan-print){
    visibility:visible!important;position:relative!important;
    top:auto!important;left:auto!important;
    width:8.5in!important;height:11in!important;max-width:none!important;
    flex:none!important;margin:0!important;border:0!important;
    transform:none!important;box-shadow:none!important;overflow:hidden!important;
    break-after:page!important;page-break-after:always!important;
    -webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;
  }
  .club-plan[data-plan-state="ready"] [data-plan-sheet-end]{break-after:auto!important;page-break-after:auto!important}
  .club-plan[data-plan-state="ready"] [data-plan-sheet] *{visibility:visible!important}
  /* The Family Meeting: only its guide, one portrait Letter page (even beside a landscape tool such as March's). */
  @page fm-guide{size:letter portrait;margin:0}
  .club-plan[data-plan-state="ready"][data-plan-view="meeting"] :not(#plan-print):not(#fm-print):not([data-meeting-sheet]):not([data-meeting-sheet] *):not(:has([data-meeting-sheet])){display:none!important}
  html .club-plan[data-plan-state="ready"][data-plan-view="meeting"]:not(#plan-print):not(#fm-print),html .club-plan[data-plan-state="ready"][data-plan-view="meeting"] :not(#plan-print):not(#fm-print):has([data-meeting-sheet]){
    display:block!important;position:static!important;float:none!important;
    width:8.5in!important;max-width:none!important;height:auto!important;min-height:0!important;max-height:none!important;
    margin:0!important;padding:0!important;gap:0!important;border:0!important;background:#fff!important;
    overflow:visible!important;transform:none!important;box-shadow:none!important;
  }
  .club-plan[data-plan-state="ready"][data-plan-view="meeting"] [data-meeting-sheet]:not(#plan-print):not(#fm-print){
    display:block!important;visibility:visible!important;page:fm-guide;position:relative!important;box-sizing:border-box!important;
    width:8.5in!important;height:11in!important;max-width:none!important;margin:0!important;padding:.48in .55in .4in!important;
    border:0!important;overflow:hidden!important;background:#fff!important;box-shadow:none!important;
    break-after:auto!important;page-break-after:auto!important;
    -webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;
  }
  .club-plan[data-plan-state="ready"][data-plan-view="meeting"] [data-meeting-sheet] *{visibility:visible!important}
  /* The member's own copy (/club/resources/<slug>, also the admin's ?fulfillment= print view that becomes the mailing
     PDF). data-plan-print-scope (#club-month-content): nothing outside the printable takes part in print layout. Before,
     the member panel above it stayed in the layout, invisible, pushing the sheets down: a blank page, a repeated
     page, or a sheet's last lines alone on a page. data-plan-print-root (set by the page only when the printable marks
     its sheets): the same one-sheet-per-page rules as a plan page. A printable without markers keeps its own rules. */
  html:has([data-plan-print-scope]),html:has([data-plan-print-scope]) body{height:auto!important;min-height:0!important;margin:0!important;padding:0!important;background:#fff!important}
  body:has([data-plan-print-scope]) :not(#plan-print):not([data-plan-print-scope]):not([data-plan-print-scope] *):not(:has([data-plan-print-scope])){display:none!important}
  body:has([data-plan-print-scope]) :not(#plan-print):has([data-plan-print-scope]),[data-plan-print-scope]:not(#plan-print){margin:0!important;padding:0!important;min-height:0!important;border:0!important;box-shadow:none!important}
  html:has([data-plan-print-root]),html:has([data-plan-print-root]) body{width:8.5in!important;overflow:visible!important}
  [data-plan-print-root] :not(#plan-print):not([data-plan-sheet]):not([data-plan-sheet] *):not(:has([data-plan-sheet])){display:none!important}
  body:has([data-plan-print-root]) :not(#plan-print):has([data-plan-print-root]),[data-plan-print-root]:not(#plan-print),[data-plan-print-root] :not(#plan-print):has([data-plan-sheet]){
    display:block!important;position:static!important;float:none!important;
    width:8.5in!important;max-width:none!important;height:auto!important;
    min-height:0!important;max-height:none!important;
    margin:0!important;padding:0!important;gap:0!important;
    border:0!important;background:#fff!important;
    overflow:visible!important;transform:none!important;
    box-shadow:none!important;scrollbar-width:none!important;
  }
  [data-plan-print-root] [data-plan-sheet]:not(#plan-print){
    visibility:visible!important;position:relative!important;
    top:auto!important;left:auto!important;
    width:8.5in!important;height:11in!important;max-width:none!important;
    flex:none!important;margin:0!important;border:0!important;
    transform:none!important;box-shadow:none!important;overflow:hidden!important;
    break-after:page!important;page-break-after:always!important;
    -webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;
  }
  [data-plan-print-root] [data-plan-sheet-end]{break-after:auto!important;page-break-after:auto!important}
  [data-plan-print-root] [data-plan-sheet] *{visibility:visible!important}
  /* WebKit (Safari on iPhone, iPad and Mac) cuts printed pages by aspect ratio: a page holds
     document width x printable height / printable width CSS px, after its own header and footer (always
     printed on iOS). An 8.5in-wide document left the 11in sheets no room, so each sheet spilled onto a
     near-blank page (WebCore PrintContext). Side padding widens the document so every page has headroom;
     the sheets stay centered and print uniformly smaller, never cropped. Covers printable areas at least
     1.128x as tall as wide; tests/club-plan-print.test.ts models it. Only WebKit has hanging-punctuation. */
  @supports (hanging-punctuation: first){
    html:has(.club-plan[data-plan-state="ready"]){box-sizing:content-box!important;width:8.5in!important;padding:0 .625in!important}
    html:has([data-plan-print-root]){box-sizing:content-box!important;width:8.5in!important;padding:0 .625in!important}
  }
}
</style>

</style>
<script>
import {ageInMonth} from '../../lib/club/profile';
import {aprilDinners,dinnerCategories,type DinnerEffort} from '../../data/club/april-dinners';
type Member={id:string;firstName:string;kind:'adult'|'child';birthYear?:number;birthMonth?:number;isAccountHolder?:boolean;archived?:boolean;role?:string};
const choices=aprilDinners;
type Role='captain'|'checker'|'table'|'cook';
const roles:Role[]=['captain','checker','table','cook'];
for(const root of document.querySelectorAll<HTMLElement>('.adc')){
 const key=root.dataset.adcKey??'omc:preview:april-dinner:v1';
 const storage=sessionStorage;
 let members:Member[]=[];
 let profile='';
 let effort:DinnerEffort='quick';
 let category='tacos';
 let meal='tacos-b';
 let assignments:Record<Role,string>={captain:'',checker:'',table:'',cook:''};
 let customized=new Set<Role>();
 let textEdits:Record<string,string>={};
 const defaultPlan=['Check ingredients & assign helpers','Cook safely using the directions on the back','Set out the food and call the family','Eat together; captain leads the cleanup'];
 const defaultRule='Ask the Dinner Captain what’s next, not Mom. The captain leads the plan and finishes with the team.';
 const defaultIntro='Follow these directions for tonight’s meal. The Cooking Lead handles hot or sharp tasks; everyone else does their part.';
 const clean=(el:HTMLElement,max:number)=>(el.textContent??'').replace(/\s+/g,' ').trim().slice(0,max);
 const valueFor=(key:string,defaultText:string)=>textEdits[key]??defaultText;
 const drawText=(selector:string,value:string)=>root.querySelectorAll<HTMLElement>(selector).forEach(el=>{if(document.activeElement!==el)el.textContent=value});

 const stage=root.querySelector<HTMLElement>('[data-adc-stage]');
 const view=root.querySelector<HTMLElement>('.adc-view');
 const pages=root.querySelector<HTMLElement>('[data-adc-pages]');
 const alignDesktopShell=()=>{
  const nav=document.querySelector<HTMLElement>('.cproto-shell');
  if(nav)document.documentElement.style.setProperty('--adc-nav-height',nav.getBoundingClientRect().bottom+'px');
 };
 alignDesktopShell();
 window.addEventListener('resize',alignDesktopShell);
 const fit=()=>{
  if(!stage||!view||!pages)return;
  const width=Math.max(200,view.clientWidth-6);
  const scale=Math.min(1,width/816);
  stage.style.height=(2140*scale)+'px';
  stage.style.width=(816*scale)+'px';
  pages.style.setProperty('--adc-scale',String(scale));
 };
 fit();
 if(view&&typeof ResizeObserver!=='undefined')new ResizeObserver(fit).observe(view);
 window.addEventListener('resize',fit);
 const eligible=(role:Role,m:Member)=>{
  if(m.archived)return false;
  const age=m.kind==='child'?ageInMonth(m.birthYear??2027,m.birthMonth,'2027-04'):99;
  if(role==='cook'||role==='captain')return m.kind==='adult';
  if(role==='checker')return age>=7;
  return age>=3;
 };
 const suggested=(role:Role)=>{
  const adults=members.filter(m=>m.kind==='adult'&&!m.archived);
  const kids=members.filter(m=>m.kind==='child'&&!m.archived);
  if(role==='captain')return adults.find(m=>!m.isAccountHolder)?.id??adults[0]?.id??'';
  if(role==='cook')return adults.find(m=>m.id!==assignments.captain)?.id??adults[0]?.id??'';
  if(role==='checker')return kids.find(m=>eligible(role,m))?.id??adults[0]?.id??'';
  if(role==='table')return kids.filter(m=>eligible(role,m)).find(m=>m.id!==assignments.checker)?.id??kids.find(m=>eligible(role,m))?.id??adults[0]?.id??'';
  return '';
 };
 // Child-facing roles use family titles for parents; saved assignments remain member IDs.
 // The profile currently has no preferred-address field, so these are editable defaults.
 const displayName=(member:Member)=>{
  if(member.kind==='child')return member.firstName;
  const parents=members.filter(m=>m.kind==='adult'&&(m.role==='parent'||m.role==='partner'));
  const index=parents.findIndex(m=>m.id===member.id);
  return index===0?'Mom':index===1?'Dad':member.firstName;
 };
 const save=()=>{try{storage.setItem(key,JSON.stringify({profile,effort,category,meal,assignments,customized:[...customized],textEdits}))}catch{}};
 const dinnerDialog=root.querySelector<HTMLDialogElement>('[data-dinner-dialog]');
 const teamDialog=root.querySelector<HTMLDialogElement>('[data-team-dialog]');
 root.querySelectorAll('[data-open-dinner]').forEach(button=>button.addEventListener('click',()=>dinnerDialog?.showModal()));
 root.querySelector('[data-open-team]')?.addEventListener('click',()=>teamDialog?.showModal());
 root.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach(button=>button.addEventListener('click',()=>button.closest('dialog')?.close()));
 for(const dialog of [dinnerDialog,teamDialog])dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});
 const draw=()=>{
  const filtered=choices.filter(m=>m.category===category&&m.effort===effort);
  const selection=filtered.find(m=>m.id===meal)??filtered[0]??choices[0];
  meal=selection.id;
  const effortSelect=root.querySelector<HTMLSelectElement>('[data-effort]');if(effortSelect)effortSelect.value=effort;
  const categorySelect=root.querySelector<HTMLSelectElement>('[data-category]');if(categorySelect)categorySelect.value=category;
  const mealSelect=root.querySelector<HTMLSelectElement>('[data-meal]');
  if(mealSelect){mealSelect.replaceChildren();for(const option of filtered){const el=document.createElement('option');el.value=option.id;el.textContent=option.name;mealSelect.append(el)}mealSelect.value=meal;}
  const count=root.querySelector<HTMLElement>('[data-filter-count]');
  if(count)count.textContent=filtered.length+' ready-to-lead '+(effort==='minimal'?'minimal-effort':effort)+' dinner option'+(filtered.length===1?'':'s')+' in this family. Each prints as one complete dinner plan.';
  const mealText=root.querySelector<HTMLElement>('[data-out-meal]');if(mealText&&document.activeElement!==mealText)mealText.textContent=valueFor('meal',selection.name);
  const timeText=root.querySelector<HTMLElement>('[data-out-time]');if(timeText&&document.activeElement!==timeText)timeText.textContent=valueFor('time',selection.time);
  const servings=root.querySelector<HTMLElement>('[data-out-servings]');if(servings&&document.activeElement!==servings)servings.textContent=valueFor('servings',selection.servings);
  const summaryMeal=root.querySelector<HTMLElement>('[data-summary-meal]');if(summaryMeal)summaryMeal.textContent=valueFor('meal',selection.name);
  const summaryTime=root.querySelector<HTMLElement>('[data-summary-time]');if(summaryTime)summaryTime.textContent=valueFor('time',selection.time)+' · '+valueFor('servings',selection.servings);
  const backTitle=root.querySelector<HTMLElement>('[data-out-recipe-title]');if(backTitle&&document.activeElement!==backTitle)backTitle.textContent=valueFor('meal',selection.name);
  const backTime=root.querySelector<HTMLElement>('[data-out-recipe-time]');if(backTime&&document.activeElement!==backTime)backTime.textContent=valueFor('time',selection.time);
  root.querySelectorAll<HTMLElement>('[data-out-instruction]').forEach((el,i)=>{if(document.activeElement!==el)el.textContent=valueFor('instruction:'+i,selection.instructions[i]??'')});
  root.querySelectorAll<HTMLElement>('[data-ingredient]').forEach((span,i)=>{if(document.activeElement!==span)span.textContent=valueFor('ingredient:'+i,selection.ingredients[i]??'')});
  root.querySelectorAll<HTMLElement>('[data-out-plan-step]').forEach((el,i)=>{if(document.activeElement!==el)el.textContent=valueFor('step:'+i,defaultPlan[i]??'')});
  drawText('[data-out-rule]',valueFor('rule',defaultRule));
  drawText('[data-out-intro]',valueFor('intro',defaultIntro));
  for(const role of roles){
   const select=root.querySelector<HTMLSelectElement>('[data-role="'+role+'"]');
   const text=root.querySelector<HTMLElement>('[data-out-role="'+role+'"]');
   if(!select||!text)continue;
   const chosen=assignments[role];
   select.replaceChildren();
   const blank=document.createElement('option');blank.value='';blank.textContent='Choose a family member';select.append(blank);
   for(const m of members.filter(x=>eligible(role,x))){
    const opt=document.createElement('option');opt.value=m.id;opt.textContent=displayName(m);select.append(opt);
   }
   select.value=members.some(m=>m.id===chosen&&eligible(role,m))?chosen:'';
   if(document.activeElement!==text)text.textContent=members.find(m=>m.id===select.value)?displayName(members.find(m=>m.id===select.value)!):'Our family';
   const summaryRole=root.querySelector<HTMLElement>('[data-summary-role="'+role+'"]');if(summaryRole)summaryRole.textContent=members.find(m=>m.id===select.value)?displayName(members.find(m=>m.id===select.value)!):'Our family';
  }
 };

 // Same interaction as June: contenteditable text stays on the printable page.
 const editingKey=(el:HTMLElement):string=>{
  if(el.hasAttribute('data-out-meal')||el.hasAttribute('data-out-recipe-title'))return 'meal';
  if(el.hasAttribute('data-out-time')||el.hasAttribute('data-out-recipe-time'))return 'time';
  if(el.hasAttribute('data-out-servings'))return 'servings';
  if(el.hasAttribute('data-out-rule'))return 'rule';
  if(el.hasAttribute('data-out-intro'))return 'intro';
  if(el.hasAttribute('data-ingredient'))return 'ingredient:'+Array.from(root.querySelectorAll('[data-ingredient]')).indexOf(el);
  if(el.hasAttribute('data-out-instruction'))return 'instruction:'+el.dataset.outInstruction;
  if(el.hasAttribute('data-out-plan-step'))return 'step:'+el.dataset.outPlanStep;
  return '';
 };
 root.querySelectorAll<HTMLElement>('[contenteditable="true"]:not([data-out-role])').forEach(el=>{
  const editKey=editingKey(el);if(!editKey)return;
  const limit=editKey.startsWith('instruction:')?260:editKey.startsWith('ingredient:')?95:editKey==='meal'?90:180;
  const capture=()=>{textEdits[editKey]=clean(el,limit);save()};
  el.addEventListener('input',capture);
  el.addEventListener('blur',()=>{capture();draw()});
  el.addEventListener('keydown',(e:KeyboardEvent)=>{if(e.key==='Enter'){e.preventDefault();el.blur()}});
 });
 root.querySelectorAll<HTMLElement>('[data-out-role]').forEach(el=>{
  const role=el.dataset.outRole as Role;
  el.addEventListener('blur',()=>{
   const typed=clean(el,36).toLowerCase();
   const person=members.find(m=>eligible(role,m)&&(displayName(m).toLowerCase()===typed||m.firstName.toLowerCase()===typed));
   if(person){assignments[role]=person.id;customized.add(role);save()}
   draw();
  });
  el.addEventListener('keydown',(e:KeyboardEvent)=>{if(e.key==='Enter'){e.preventDefault();el.blur()}});
 });
 root.querySelector<HTMLSelectElement>('[data-effort]')?.addEventListener('change',e=>{effort=(e.target as HTMLSelectElement).value as DinnerEffort;textEdits={};const first=choices.find(m=>m.category===category&&m.effort===effort);meal=first?.id??'tacos-b';save();draw()});
 root.querySelector<HTMLSelectElement>('[data-category]')?.addEventListener('change',e=>{category=(e.target as HTMLSelectElement).value;textEdits={};const first=choices.find(m=>m.category===category&&m.effort===effort);meal=first?.id??'tacos-b';save();draw()});
 root.querySelector<HTMLSelectElement>('[data-meal]')?.addEventListener('change',e=>{meal=(e.target as HTMLSelectElement).value;textEdits={};save();draw()});
 for(const role of roles)root.querySelector<HTMLSelectElement>('[data-role="'+role+'"]')?.addEventListener('change',e=>{assignments[role]=(e.target as HTMLSelectElement).value;customized.add(role);save();draw()});
 root.querySelector('[data-reset]')?.addEventListener('click',()=>{
   effort='quick';category='tacos';meal='tacos-b';textEdits={};customized.clear();
   for(const role of roles)assignments[role]=suggested(role);
   save();draw();
 });
 root.querySelector('[data-print]')?.addEventListener('click',()=>{(document.activeElement as HTMLElement|null)?.blur();window.print()});
 const applyHousehold=(detail:{household:{id:string;members:Member[]}|null;sample?:string})=>{
  if(!detail?.household)return;
  const nextProfile=(detail.sample??'account')+':'+detail.household.id;
  const switched=nextProfile!==profile;
  profile=nextProfile;members=detail.household.members.filter(m=>!m.archived);
  if(switched){
   effort='quick';category='tacos';meal='tacos-b';textEdits={};customized.clear();assignments={captain:'',checker:'',table:'',cook:''};
   try{const saved=JSON.parse(storage.getItem(key)??'null');if(saved?.profile===profile){
     const savedMeal=choices.find(x=>x.id===saved.meal);
     if(savedMeal){effort=savedMeal.effort;category=savedMeal.category;meal=savedMeal.id}
     else {effort='quick';category='tacos';meal='tacos-b'}
     customized=new Set(roles.filter(r=>saved.customized?.includes(r)));
     textEdits=saved.textEdits&&typeof saved.textEdits==='object'?saved.textEdits:{};
     for(const role of roles)assignments[role]=typeof saved.assignments?.[role]==='string'?saved.assignments[role]:'';
   }}catch{}
  }
  for(const role of roles){if(!customized.has(role)||!members.some(m=>m.id===assignments[role]&&eligible(role,m)))assignments[role]=suggested(role)}
  save();draw();
 };
 window.addEventListener('omc:club-preview-household',(event:Event)=>applyHousehold((event as CustomEvent<{household:{id:string;members:Member[]}|null;sample?:string}>).detail));
 const cached=(window as Window & {__ofcPreviewHousehold?:{household:{id:string;members:Member[]}|null;sample?:string}}).__ofcPreviewHousehold;
 if(cached)applyHousehold(cached);
 draw();
}
</script>

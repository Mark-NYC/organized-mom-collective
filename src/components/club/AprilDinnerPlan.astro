---
/** April 2027: one fully prepared family dinner; two-sided US Letter deliverable. */
import {monthColors} from '../../theme';
import {aprilDinners,dinnerCategories} from '../../data/club/april-dinners';
interface Props { storageKey?:string }
const {storageKey='omc:club:april-dinner:v1'}=Astro.props;
const meals=aprilDinners;
const initial=meals.find(m=>m.id==='tacos-b')!;
const initialMeals=meals.filter(m=>m.effort==='quick'&&m.category==='tacos');
const steps=['Check ingredients & assign helpers','Cook safely using the directions on the back','Set out the food and call the family','Eat together; captain leads the cleanup'];
const stepIcons=['grocery-bag-with-produce','cooking-pot','place-setting','washing-dishes'];
---
<div class="adc" data-adc-key={storageKey} style={'--adc-accent:'+monthColors[3].hex}>
 <header class="adc-intro"><a href="/club">← Organized Family Club</a><p class="adc-eyebrow">ORGANIZED FAMILY CLUB · APRIL 2027</p><h1>Tonight, <em>we've got dinner.</em></h1><p>One fully prepared dinner for tonight, plus a reusable four-role Dinner Team your family can use again and again.</p></header>
 <div class="adc-layout">
 <section class="adc-controls" aria-label="Your prepared April dinner plan">
  <div class="adc-controls-head">
   <p class="adc-eyebrow">ORGANIZED FAMILY CLUB · APRIL</p>
   <h2>Tonight, <em>we've got dinner.</em></h2>
   <p class="adc-vision">Dinner shouldn't depend on Mom to plan, assign, cook, and clean up. This meal is already planned. Everyone gets a part, and your Dinner Team can use the same four jobs again next time.</p>
  </div>
  <div class="adc-prepared" id="april-edit-controls">
   <div class="adc-summary-block">
    <span class="adc-summary-label">TONIGHT'S PREPARED MEAL</span>
    <strong data-summary-meal>{initial.name}</strong>
    <p data-summary-time>{initial.time} · About 4 servings</p>
    <button type="button" class="adc-edit-link" data-open-dinner>Change dinner <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></button>
   </div>
   <div class="adc-summary-block adc-summary-team">
    <span class="adc-summary-label">YOUR DINNER TEAM</span>
    <div class="adc-summary-row"><span>Dinner captain</span><strong data-summary-role="captain">Dad</strong></div>
    <div class="adc-summary-row"><span>Ingredients checker</span><strong data-summary-role="checker">Sofia</strong></div>
    <div class="adc-summary-row"><span>Table captain</span><strong data-summary-role="table">Mateo</strong></div>
    <div class="adc-summary-row"><span>Cooking lead</span><strong data-summary-role="cook">Mom</strong></div>
    <button type="button" class="adc-edit-link" data-open-team>Edit team <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></button>
   </div>
  </div>
  <div class="adc-actions"><div class="adc-primary-actions"><a class="adc-jump-edit" href="#april-edit-controls">Make changes <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg></a><button type="button" data-print class="adc-button">Print / Save PDF</button></div><button type="button" data-reset class="adc-reset">Restore prepared plan</button></div>
 </section>
 <dialog class="adc-dialog" data-dinner-dialog aria-labelledby="adc-dinner-dialog-title">
  <div class="adc-dialog-top"><div><span class="adc-eyebrow">MAKE IT YOURS · APRIL</span><h2 id="adc-dinner-dialog-title">Choose your dinner</h2></div><button type="button" class="adc-dialog-close" data-close-dialog aria-label="Close dinner editor">×</button></div>
  <p>Every meal comes ready to cook, with ingredients, directions, and the same four family roles. Choose what fits tonight.</p>
  <div class="adc-dialog-fields">
   <label>What kind of night is it?<select data-effort>
    <option value="full">Full night · time to prepare</option>
    <option value="quick" selected>Quick night · around 15–20 minutes</option>
    <option value="minimal">Minimal-effort · almost no prep</option>
   </select></label>
   <label>Choose a dinner family<select data-category>{dinnerCategories.map(c=><option value={c.id}>{c.name}</option>)}</select></label>
   <label>Choose tonight's recipe<select data-meal>{initialMeals.map(m=><option value={m.id}>{m.name}</option>)}</select></label>
   <p class="adc-filter-count" data-filter-count>Choose an effort and dinner family to explore all 48 recipes.</p>
  </div>
  <p class="adc-dialog-help">Recipes serve approximately four. Check ingredients for allergies and preferences. An adult handles heat, knives, and food safety.</p>
  <button type="button" class="adc-dialog-done" data-close-dialog>Done · See my plan</button>
 </dialog>
 <dialog class="adc-dialog" data-team-dialog aria-labelledby="adc-team-dialog-title">
  <div class="adc-dialog-top"><div><span class="adc-eyebrow">SHARE THE LOAD · APRIL</span><h2 id="adc-team-dialog-title">Your Dinner Team</h2></div><button type="button" class="adc-dialog-close" data-close-dialog aria-label="Close team editor">×</button></div>
  <p>The captain owns the whole meal: chooses, gathers helpers, makes it happen, and checks that cleanup is done. Other family members have clear jobs.</p>
  <div class="adc-roles-editor">
   <label>Dinner captain <small>Owns the whole job, not just one step.</small><select data-role="captain"></select></label>
   <label>Ingredients checker <small>Checks the pantry and gathers food.</small><select data-role="checker"></select></label>
   <label>Table captain <small>Sets dishes and toppings, then clears.</small><select data-role="table"></select></label>
   <label>Cooking lead <small>An adult handles stove use and knives.</small><select data-role="cook"></select></label>
  </div>
  <button type="button" class="adc-dialog-done" data-close-dialog>Done · See my plan</button>
 </dialog>
 <section class="adc-view" aria-label="Two-page April printable preview">
   <button type="button" class="adc-floating-edit" data-open-dinner aria-label="Make changes to your plan"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 4 4M4 20l4-.8L19 8.2a2.1 2.1 0 0 0-3-3L5 16.2 4 20Z"/></svg><span>MAKE CHANGES</span></button>
  
  <div class="adc-stage" data-adc-stage>
  <div class="adc-pages" data-adc-pages>
   <article class="adc-sheet adc-front">
    <div class="adc-sheet-head"><p>ORGANIZED FAMILY CLUB · APRIL 2027</p><h2>Tonight, <em>we've got dinner.</em></h2><span>ONE DINNER PLANNED. EVERYONE HAS A PART.</span></div>
    <div class="adc-sheet-inner">
     <div class="adc-meal-head"><div><span class="adc-tiny">TONIGHT'S DINNER</span><h3 data-out-meal contenteditable="true" role="textbox" aria-label="Edit dinner name">{initial.name}</h3></div><div class="adc-time"><span data-out-time contenteditable="true" role="textbox" aria-label="Edit dinner time">{initial.time}</span><small data-out-servings contenteditable="true" role="textbox" aria-label="Edit servings">{initial.servings}</small></div></div>
     <div class="adc-section-label">OUR DINNER TEAM</div>
     <div class="adc-team-grid">
      <div><span>DINNER CAPTAIN</span><strong data-out-role="captain" contenteditable="true" role="textbox" aria-label="Edit captain assignment">Dad</strong><p>Owns the whole plan</p></div>
      <div><span>INGREDIENTS CHECKER</span><strong data-out-role="checker" contenteditable="true" role="textbox" aria-label="Edit checker assignment">Sofia</strong><p>Checks and gathers</p></div>
      <div><span>TABLE CAPTAIN</span><strong data-out-role="table" contenteditable="true" role="textbox" aria-label="Edit table assignment">Mateo</strong><p>Gets the table ready</p></div>
      <div><span>COOKING LEAD</span><strong data-out-role="cook" contenteditable="true" role="textbox" aria-label="Edit cook assignment">Mom</strong><p>Handles adult cooking</p></div>
     </div>
     <div class="adc-section-label">CHECK THE INGREDIENTS · ABOUT FOUR SERVINGS</div>
     <div class="adc-ingredients">{initial.ingredients.map(x=><div class="adc-ingredient"><i></i><span data-ingredient contenteditable="true" role="textbox" aria-label="Edit ingredient">{x}</span></div>)}</div>
     <div class="adc-section-label">OUR DINNER PLAN</div>
     <div class="adc-steps">
      {steps.map((step,i)=><div class="adc-step"><span>{String(i+1).padStart(2,'0')}</span><img src={"/images/club/icon-library/"+stepIcons[i]+".png"} width="30" height="30" alt="" class="adc-step-icon"/><strong data-out-plan-step={i} contenteditable="true" role="textbox" aria-label={`Edit plan step ${i+1}`}>{step}</strong><i></i></div>)}
     </div>
     <div class="adc-rule"><span>OUR FAMILY RULE</span><p data-out-rule contenteditable="true" role="textbox" aria-label="Edit family dinner rule">Ask the Dinner Captain what’s next, not Mom. The captain leads the plan and finishes with the team.</p></div>
    </div>
    <footer class="adc-foot">ORGANIZED FAMILY CLUB <span>· APRIL · FRONT</span></footer>
   </article>
   <article class="adc-sheet adc-back">
    <div class="adc-sheet-head adc-back-head"><p>ORGANIZED FAMILY CLUB · APRIL 2027</p><h2>Tonight's dinner. <em>Tomorrow's team.</em></h2><span>COOK THIS MEAL. KEEP THE TEAM FOR NEXT TIME.</span></div>
    <div class="adc-sheet-inner adc-back-inner">
      <div class="adc-recipe-top"><div><span class="adc-tiny">TONIGHT'S COOKING GUIDE</span><h3 data-out-recipe-title contenteditable="true" role="textbox" aria-label="Edit recipe name">{initial.name}</h3></div><span data-out-recipe-time contenteditable="true" role="textbox" aria-label="Edit recipe time">{initial.time}</span></div>
      <p class="adc-recipe-intro" data-out-intro contenteditable="true" role="textbox" aria-label="Edit cooking introduction">Follow these directions for tonight’s meal. The Cooking Lead handles hot or sharp tasks; everyone else does their part.</p>
      <div class="adc-recipe-steps">
        {initial.instructions.map((instruction,i)=><div class="adc-recipe-step"><span>{String(i+1).padStart(2,'0')}</span><p data-out-instruction={i} contenteditable="true" role="textbox" aria-label={`Edit recipe instruction ${i+1}`}>{instruction}</p></div>)}
      </div>
      <section class="adc-repeat" aria-label="Reusable family dinner team guide">
        <div class="adc-repeat-heading"><div><span class="adc-tiny">SAVE THIS FOR ANOTHER NIGHT</span><h3>Our Dinner Team</h3></div><span class="adc-repeat-tag">USE AGAIN</span></div>
        <p class="adc-repeat-intro">Different dinner, same four jobs. Each person knows how to help without waiting for Mom to assign every step.</p>
        <div class="adc-repeat-roles">
          <div><strong>DINNER CAPTAIN</strong><span>Chooses with the family, invites helpers, and sees the whole job through.</span></div>
          <div><strong>INGREDIENTS CHECKER</strong><span>Checks what we have and gathers what we need.</span></div>
          <div><strong>TABLE CAPTAIN</strong><span>Sets the table, then helps clear it.</span></div>
          <div><strong>COOKING LEAD</strong><span>Leads the recipe. An adult handles heat, knives, and food safety.</span></div>
        </div>
        <div class="adc-repeat-sequence"><span>THE CAPTAIN'S FOUR STEPS</span><div><b>1 <strong>Choose</strong><small>Pick dinner</small></b><b>2 <strong>Gather</strong><small>Check food &amp; helpers</small></b><b>3 <strong>Make</strong><small>Lead the team</small></b><b>4 <strong>Reset</strong><small>Finish together</small></b></div></div>
        <div class="adc-repeat-next"><strong>Next time, choose another dinner and use the same team.</strong><span>Swap people if you want. Keep the four jobs and the four steps.</span></div>
      </section>
    </div>
    <footer class="adc-foot">ORGANIZED FAMILY CLUB <span>· APRIL · BACK</span></footer>
   </article>
  </div>
  </div>
  <p class="adc-preview-note">Working product preview. Print double-sided on US Letter at actual size. Check your printer's duplex orientation before printing.</p>
 </section>
 </div>
</div>
<style is:global>
.adc,.adc *{box-sizing:border-box}.adc{max-width:1450px;margin:0 auto;padding:28px clamp(18px,3.5vw,52px) 75px;color:#454545;font-family:Montserrat,Arial,sans-serif}.adc-intro{max-width:780px;margin:0 0 42px}.adc-intro>a{font-size:12px;text-decoration:underline;display:inline-block;margin-bottom:30px}.adc-eyebrow{font-size:10px;font-weight:700;letter-spacing:.16em}.adc-intro h1{font:400 clamp(38px,4.5vw,62px)/1.1 Georgia,serif;margin:14px 0 18px}.adc-intro h1 em{color:#786c91}.adc-intro>p:last-child{font-size:15px;line-height:1.75}.adc-layout{display:grid;grid-template-columns:minmax(280px,360px) minmax(0,1fr);gap:clamp(22px,4vw,60px);align-items:start}.adc-controls,.adc-view{min-width:0}.adc-controls-head{border-top:9px solid var(--adc-accent);padding:20px 0 24px}.adc-controls-head h2{font:italic 27px Georgia,serif;color:#786c91;margin:12px 0}.adc-controls-head p:last-child{font-size:13px;line-height:1.65}.adc-controls label{display:block;border-top:1px solid #ddd8e8;padding-top:15px;margin-bottom:18px;font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}.adc-controls label small{display:block;font-size:11px;line-height:1.5;font-weight:400;letter-spacing:0;text-transform:none;margin-top:5px}.adc-controls select{display:block;width:100%;min-height:45px;border:1px solid #b9b3be;background:white;color:#454545;font:13px Montserrat,Arial,sans-serif;padding:9px 10px;margin-top:8px}.adc-filter-count{font-size:11px;color:#6c6374;line-height:1.55;margin:-2px 0 20px}.adc-explainer{border-top:3px solid #ddd8e8;padding:19px 0}.adc-explainer h3{font:400 22px Georgia,serif;margin:0 0 10px}.adc-explainer p{font-size:12px;line-height:1.7;margin:0 0 13px}.adc-button{background:#454545;color:#fff;border:0;width:100%;min-height:52px;padding:12px;cursor:pointer;font-weight:700;font-size:12px}.adc-reset{display:block;border:0;background:none;cursor:pointer;text-decoration:underline;color:#454545;min-height:44px;margin:8px auto;font-size:12px}.adc-status,.adc-preview-note{font-size:11px;line-height:1.6;color:#666}.adc-view-title{display:flex;justify-content:space-between;align-items:baseline;gap:15px;flex-wrap:wrap;border-bottom:1px solid #ddd8e8;padding-bottom:14px;margin-bottom:20px}.adc-view-title h2{font:400 25px Georgia,serif}.adc-view-title span{font-size:12px}.adc-stage{width:100%;position:relative}.adc-pages{position:absolute;top:0;left:0;transform:scale(var(--adc-scale,.78));transform-origin:top left;display:flex;flex-direction:column;gap:28px;width:816px}.adc-sheet{width:816px;height:1056px;background:white;border:1px solid #ebe6e9;box-shadow:0 8px 30px #0002;display:flex;flex-direction:column;overflow:hidden;color:#4a4450;padding:38px 46px 24px}.adc-sheet-head{background:#f1eef8;border-top:10px solid #ddd8e8;padding:21px 27px 24px;min-height:172px}.adc-sheet-head>p{font-size:9px;letter-spacing:.16em;font-weight:700;margin:0}.adc-sheet-head h2{font:400 41px/1.14 Georgia,serif;color:#635877;margin:17px 0 13px}.adc-sheet-head h2 em{font-style:italic;font-weight:700}.adc-sheet-head>span{font-size:9px;letter-spacing:.09em;font-weight:700}.adc-sheet-inner{flex:1;min-height:0;display:flex;flex-direction:column}.adc-meal-head{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:21px 0 15px;border-bottom:1px solid #ddd8e8}.adc-meal-head h3{font:400 27px Georgia,serif;margin:9px 0 0}.adc-tiny{font-size:10px;font-weight:700;letter-spacing:.13em;color:#756c87}.adc-time{white-space:nowrap;padding:12px;background:#f4f1f8;font-size:11px}.adc-section-label{font-size:10px;font-weight:700;letter-spacing:.14em;margin:18px 0 12px}.adc-team-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.adc-team-grid>div{background:#f6f3fa;padding:12px 16px;min-height:79px}.adc-team-grid span{display:block;font-size:8px;font-weight:700;letter-spacing:.11em}.adc-team-grid strong{font:400 20px Georgia,serif;display:block;color:#66587d;margin:4px 0}.adc-team-grid p{font-size:10px;margin:0}.adc-ingredients{display:grid;grid-template-columns:1fr 1fr;gap:9px 25px}.adc-ingredient{display:flex;align-items:center;gap:10px;font-size:12px}.adc-ingredient i,.adc-step i,.adc-back-check i{width:14px;height:14px;flex:0 0 14px;border:1px solid #827b90;display:inline-block}.adc-steps{border-top:1px solid #ddd8e8}.adc-step{border-bottom:1px solid #ddd8e8;display:grid;grid-template-columns:25px 1fr 14px;gap:13px;align-items:center;min-height:40px;font-size:12px}.adc-step>span{color:#786c91;font-weight:700;font-size:10px}.adc-step strong{font-weight:500}.adc-rule{background:#f4f1f8;padding:12px 18px;display:grid;grid-template-columns:125px 1fr;gap:15px;margin-top:auto}.adc-rule span{font-size:9px;font-weight:700;letter-spacing:.08em}.adc-rule p{font:italic 15px/1.4 Georgia,serif;margin:0}.adc-foot{display:flex;justify-content:space-between;border-top:1px solid #ddd8e8;padding-top:11px;font-size:9px;letter-spacing:.1em;font-weight:700;margin-top:17px}.adc-back-head{background:#f1eef8}.adc-back-inner{padding-top:20px}.adc-back-section{border-bottom:1px solid #ddd8e8;padding:0 5px 22px;margin-bottom:22px}.adc-back-section h3{font:400 25px Georgia,serif;color:#635877;margin:10px 0 13px}.adc-back-section>p{font-size:13px;line-height:1.7;margin:0 0 11px}.adc-back-check{font-size:13px;display:flex;gap:12px;align-items:center;padding:8px 0}.adc-captain-box{background:#f4f1f8;padding:21px 23px}.adc-captain-box span{font-size:10px;font-weight:700;letter-spacing:.13em}.adc-captain-box p{font:italic 17px/1.5 Georgia,serif;margin:12px 0 0}.adc-back-note{margin-top:auto;text-align:center;font-size:10px;letter-spacing:.12em;color:#716583;font-weight:700;padding-top:24px}

/* Print refinement: fewer decorative gaps, more usable cooking content. */
.adc-sheet{padding:30px 44px 22px}
.adc-sheet-head{min-height:145px;padding:16px 25px 17px;border-top-width:8px}
.adc-sheet-head h2{font-size:37px;margin:11px 0 9px}
.adc-meal-head{padding:14px 0 10px}.adc-meal-head h3{font-size:24px}
.adc-time{text-align:center;display:flex;flex-direction:column;gap:4px;align-items:center;padding:10px 12px;font-size:11px;font-weight:700}
.adc-time small{font-size:9px;font-weight:400}
.adc-section-label{margin:12px 0 8px}
.adc-team-grid{gap:8px}.adc-team-grid>div{padding:9px 12px;min-height:68px}
.adc-team-grid strong{font-size:19px;margin:3px 0}
.adc-ingredients{row-gap:8px}.adc-ingredient{font-size:11px}
.adc-step{min-height:35px;font-size:11px;display:flex;align-items:center;gap:9px}.adc-step-icon{width:30px;height:30px;object-fit:contain;flex-shrink:0}
.adc-rule{padding:10px 14px;grid-template-columns:120px 1fr}
.adc-rule p{font-size:13px}
.adc-foot{margin-top:12px;padding-top:8px}
.adc-back-inner{padding-top:15px}
.adc-recipe-top{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;border-bottom:1px solid #ddd8e8;padding:4px 0 16px}
.adc-recipe-top h3{font:400 26px Georgia,serif;color:#635877;margin:8px 0 0}
.adc-recipe-top>span{font-size:11px;white-space:nowrap;margin-top:12px}
.adc-recipe-intro{font:13px/1.55 Montserrat,Arial,sans-serif;margin:13px 0 18px}
.adc-recipe-steps{border-top:1px solid #ddd8e8;display:grid;gap:0}
.adc-recipe-step{display:grid;grid-template-columns:34px 1fr;gap:13px;border-bottom:1px solid #ddd8e8;padding:17px 0;align-items:start}
.adc-recipe-step>span{color:#766b90;font:700 11px Montserrat,Arial,sans-serif}
.adc-recipe-step p{font:13px/1.6 Montserrat,Arial,sans-serif;margin:0}
.adc-captain-check{margin-top:18px;padding:16px 20px;background:#faf8fc;display:grid;gap:9px}
.adc-captain-check>span{font-size:10px;letter-spacing:.13em;font-weight:700;color:#66587d;margin-bottom:4px}
.adc-captain-check>div{display:flex;align-items:center;gap:12px;font-size:11px}
.adc-captain-check i{width:13px;height:13px;flex:0 0 13px;border:1px solid #8d8794}
.adc-captain-box{padding:16px 20px;margin-top:14px}
.adc-captain-box p{font:italic 14px/1.5 Georgia,serif;margin:8px 0 0}
.adc-back-note{font-size:9px;padding-top:13px}
/* April reusable dinner system: compact enough to share the back with a full recipe. */
.adc-back-head h2{font-size:34px}
.adc-back-inner{padding-top:11px}
.adc-recipe-top{padding:2px 0 9px}
.adc-recipe-top h3{font-size:22px;margin:5px 0 0}
.adc-recipe-intro{font-size:11px;line-height:1.4;margin:9px 0 10px}
.adc-recipe-step{padding:9px 0;grid-template-columns:26px 1fr;gap:9px}
.adc-recipe-step p{font-size:11px;line-height:1.4}
.adc-repeat{margin-top:13px;border-top:3px solid #ddd8e8;padding-top:11px}
.adc-repeat-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}
.adc-repeat-heading h3{font:400 25px Georgia,serif;color:#635877;margin:4px 0}
.adc-repeat-tag{font-size:8px;font-weight:700;letter-spacing:.1em;background:#f1eef8;padding:7px 9px;white-space:nowrap}
.adc-repeat-intro{font-size:10px;line-height:1.4;margin:4px 0 10px}
.adc-repeat-roles{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.adc-repeat-roles>div{background:#f8f6fb;padding:9px 11px;min-height:59px}
.adc-repeat-roles strong{font-size:9px;letter-spacing:.06em;display:block;margin-bottom:4px}
.adc-repeat-roles span{font-size:10px;line-height:1.35;display:block}
.adc-repeat-sequence{margin-top:12px}
.adc-repeat-sequence>span{font-size:9px;font-weight:700;letter-spacing:.12em}
.adc-repeat-sequence>div{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin-top:7px}

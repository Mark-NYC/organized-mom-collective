---
/**
 * March 2027, Our Family Rhythm: one Letter sheet (8.5 × 11 in) for the whole family. Two or three moments the family
 * already shares (Cue → the moment), and under each, who owns which part, with their January family color as a narrow
 * bar and their name ("each" when several do their own, "together" when they share one); a finish line written from
 * those jobs; "This week, we're practicing" with the one or two new habits. No rewards, points, tracking or
 * checkboxes. Rules: src/lib/club/engines/march-family-rhythm.ts; editor: src/lib/club/march-rhythm-editor.ts; icons:
 * src/data/club/march-chore-icons.ts.
 *
 * On the Club plan page (/app/club/march) the page brings the layout, rail and phone screen; this keeps the desktop
 * editor dialog and the sheet (data-plan-sheet="front"), and publishes the plan as `clubPlan`
 * (docs/club/PLAN_ARCHITECTURE.md). The sheet is a fixed 816 × 1056 px page. Its sizes come from how much the plan
 * holds (five steps, set by the script): a small plan prints larger, as one centered composition with the footer
 * right after it; a large one tighter, never clipped (the script measures and steps down if the words run long).
 */
import '../../styles/club-marks.css';
interface Props {
  storageKey: string;
  /** 'welcome': the permanent Welcome resource (ages from the month she first opens it, priority-led habit). */
  context?: 'march' | 'welcome';
  /** The editor's kicker. */
  kicker?: string;
}
const { storageKey, context = 'march', kicker = 'Make it yours · March' } = Astro.props;
---
<div class="mfr" data-mfr data-mfr-key={storageKey} data-mfr-context={context === 'welcome' ? 'welcome' : undefined}>
  <dialog class="mfr-dialog" data-mfr-editor aria-labelledby="mfr-editor-title">
    <div class="mfr-dialog-head">
      <div><p class="mfr-dialog-kicker">{kicker}</p><h2 id="mfr-editor-title">Our family rhythm</h2></div>
      <button type="button" class="mfr-close" data-mfr-close aria-label="Close">×</button>
    </div>
    <div class="mfr-steps" role="tablist" aria-label="What to change" data-mfr-steps></div>
    <div class="mfr-dialog-body" data-mfr-editor-body></div>
    <div class="mfr-dialog-actions"><span data-mfr-restore></span><button type="button" class="mfr-done" data-mfr-close>Done · See our rhythm</button></div>
  </dialog>
  <div class="mfr-sheets" data-mfr-pages></div>
  <p class="mfr-empty" data-mfr-empty hidden>Add your family to your family profile and your rhythm is prepared here.</p>
</div>

<style is:global>
.mfr{--mfr-ink:#3F3B39;--mfr-soft:#6E6461;--mfr-rule:#E4DDD6;--mfr-wash:#EEF4F1;--mfr-accent:#3F6B5A}
.mfr-sheets{display:flex;flex-direction:column;align-items:center}
.mfr-stage{position:relative;margin:0 auto;flex:none}
.mfr-sheet{position:absolute;left:0;top:0;width:816px;height:1056px;transform:scale(var(--mfr-scale,1));transform-origin:top left;overflow:hidden;background:#fff;box-shadow:0 10px 30px #3d38311f}
.mfr-empty{max-width:520px;margin:40px auto;text-align:center;font-size:15px;line-height:1.7;color:#7d726c}
.mfr-empty[hidden]{display:none}

/* The sheet. Sizes (--mfr-*) come from how much the plan holds: set by the script. Header, moments, practice and
   footer are one composition, centered on the page: a short plan has even margins and stays together; a full one
   fills the page edge to edge. */
.mfr-paper{position:absolute;inset:0;box-sizing:border-box;display:flex;flex-direction:column;padding:var(--mfr-top,56px) 64px var(--mfr-bottom,44px);font-family:Montserrat,var(--font-sans),Arial,sans-serif;color:var(--mfr-ink);-webkit-print-color-adjust:exact;print-color-adjust:exact}
.mfr-paper *{box-sizing:border-box}
.mfr-head{flex:none;margin-top:auto;text-align:center}
.mfr-kicker{margin:0;font:700 12px/1 Montserrat,Arial,sans-serif;letter-spacing:.26em;text-transform:uppercase;color:var(--mfr-accent)}
.mfr-family{margin:12px 0 0;font:400 var(--mfr-h1,38px)/1.1 Georgia,'Georgia Pro',serif;overflow-wrap:anywhere}
.mfr-motto{margin:8px 0 0;font:italic 400 var(--mfr-motto,17px)/1.3 Georgia,serif;color:var(--mfr-soft)}
.mfr-legend{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 18px;margin:calc(var(--mfr-gap,30px) / 2) 0 0}
.mfr-legend .mc-owner{font-size:10.5px}
.mfr-main{flex:none;display:flex;flex-direction:column;gap:var(--mfr-gap,30px);padding:calc(var(--mfr-gap,30px) + 4px) 0 0}
.mfr-moment{flex:none}
.mfr-moment-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding-bottom:8px;border-bottom:2px solid var(--mfr-base,#C7DED3)}
.mfr-moment-title{margin:0;font:400 var(--mfr-h2,26px)/1.15 Georgia,serif;overflow-wrap:anywhere}
.mfr-cue{flex:none;margin:0;font:500 12px/1.3 Montserrat,Arial,sans-serif;color:var(--mfr-soft);text-align:right}
.mfr-cue b{font-weight:700;letter-spacing:.16em;text-transform:uppercase;font-size:10px;color:var(--mfr-ink);margin-right:5px}
.mfr-rows{list-style:none;margin:0;padding:0}
.mfr-row{display:grid;grid-template-columns:5px var(--mfr-who,124px) var(--mfr-icon,40px) minmax(0,1fr) auto;column-gap:14px;align-items:center;padding:var(--mfr-pad,9px) 0;border-bottom:1px solid var(--mfr-rule)}
.mfr-bar{align-self:stretch;width:5px;border-radius:3px;background:var(--mfr-member,#9A918B)}
/* Names: one per line when they fit, wrapping inside their column (never under the job). */
.mfr-who{min-width:0;display:flex;flex-wrap:wrap;column-gap:6px;font:700 var(--mfr-name,12px)/1.3 Montserrat,Arial,sans-serif;letter-spacing:.07em;text-transform:uppercase;overflow-wrap:anywhere}
.mfr-who .mfr-name{color:var(--mfr-member-ink,var(--mfr-ink))}
.mfr-who .mfr-amp{color:var(--mfr-soft)}
.mfr-mode{flex-basis:100%;font:600 8.5px/1.4 Montserrat,Arial,sans-serif;letter-spacing:.14em;color:var(--mfr-soft)}
.mfr-slot{width:var(--mfr-icon,40px);height:var(--mfr-icon,40px)}
.mfr-slot img{display:block;width:100%;height:100%;object-fit:contain}
.mfr-job{min-width:0;font:500 var(--mfr-text,17px)/1.3 Montserrat,Arial,sans-serif;overflow-wrap:break-word}
.mfr-tag{font:700 9px/1 Montserrat,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--mfr-accent);padding:5px 8px;border:1.5px solid var(--mfr-accent);border-radius:999px;white-space:nowrap}
/* A new habit: a pale wash, the job in bold and a "New habit" tag. Everything else is context and stays plain. */
.mfr-row.is-habit{background:var(--mfr-wash)}
.mfr-row.is-habit .mfr-job{font-weight:700}
.mfr-finish{margin:8px 0 0 19px;font:italic 400 var(--mfr-fin,14px)/1.4 Georgia,serif;color:var(--mfr-soft)}
.mfr-finish b{font:700 10px/1 Montserrat,Arial,sans-serif;font-style:normal;letter-spacing:.16em;text-transform:uppercase;color:var(--mfr-ink);margin-right:6px}
/* This week, we're practicing: the family's focus, in sentences. */
.mfr-habits{flex:none;padding:calc(var(--mfr-pad,9px) + 8px) 22px;border:1.5px solid var(--mfr-base,#C7DED3);border-radius:10px}
.mfr-habits-title{margin:0 0 8px;font:700 11px/1 Montserrat,Arial,sans-serif;letter-spacing:.22em;text-transform:uppercase;color:var(--mfr-accent)}
.mfr-habits ul{list-style:none;margin:0;padding:0;display:grid;gap:5px}
.mfr-habits li{font:400 var(--mfr-fin-lg,16px)/1.4 Georgia,serif}
.mfr-habits li .mfr-name{font-weight:700;color:var(--mfr-member-ink,var(--mfr-ink))}
.mfr-habits-note{margin:8px 0 0;font:italic 400 13px/1.4 Georgia,serif;color:var(--mfr-soft)}
.mfr-foot{flex:none;margin:calc(var(--mfr-gap,30px) + 6px) 0 auto;font:italic 400 15px/1.4 Georgia,serif;text-align:center;color:var(--mfr-soft)}
@media print{.mfr-dialog,.mfr-empty{display:none!important}}

/* The editor dialog (desktop) and the edit sheets (phones) share these. */
.mfr-dialog{position:fixed;inset:0;margin:auto;box-sizing:border-box;width:min(640px,calc(100vw - 32px));max-height:calc(100dvh - 48px);overflow-y:auto;overscroll-behavior:contain;padding:24px 26px;background:var(--color-ivory,#fffdfa);border:1px solid var(--color-warm-rule,#e7ddd4);border-radius:3px;box-shadow:0 20px 65px #0003;color:var(--color-warm-ink,#4d4544);z-index:100}
.mfr-dialog::backdrop{background:rgba(33,30,29,.5)}
.mfr-dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}
.mfr-dialog-head h2{margin:6px 0 0;font:400 28px/1.15 var(--font-serif,Georgia,serif)}
.mfr-dialog-kicker{margin:0;font-size:.7rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--color-warm-soft,#6e6461)}
.mfr-close{width:44px;height:44px;flex:none;border:0;background:none;font-size:28px;cursor:pointer;color:var(--color-warm-ink,#4d4544)}
.mfr-steps{display:flex;flex-wrap:wrap;gap:4px 22px;margin:14px 0 6px;border-bottom:1px solid var(--color-warm-rule,#e7ddd4)}
.mfr-steps button{min-height:44px;margin-bottom:-1px;padding:8px 2px;border:0;border-bottom:2px solid transparent;background:none;color:var(--color-warm-soft,#6e6461);font:600 .75rem var(--font-sans);letter-spacing:.14em;text-transform:uppercase;cursor:pointer}
.mfr-steps button[aria-selected="true"]{color:var(--color-warm-ink,#4d4544);border-bottom-color:var(--color-warm-button,#4a3f3e)}
.mfr-dialog-actions{display:grid;gap:10px;margin-top:20px}
.mfr-dialog-actions[hidden]{display:none}
.mfr-done{width:100%;min-height:48px;border:0;border-radius:3px;background:var(--color-warm-button,#4a3f3e);color:#fff;font:600 .75rem var(--font-sans);letter-spacing:.14em;text-transform:uppercase;cursor:pointer}
.mre-section{display:grid;gap:14px;padding-top:10px}
.mre-intro{margin:0;font-size:.9rem;line-height:1.5;color:var(--color-warm-soft,#6e6461)}
.mre-kicker{margin:0;font-size:.7rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--color-warm-soft,#6e6461)}
.mre-card{display:grid;gap:10px;padding:14px 16px;border:1px solid var(--color-warm-rule,#e7ddd4);border-radius:6px;background:#fff}
.mre-card.is-off{background:transparent}
.mre-card-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.mre-card-title{margin:0;font:400 1.2rem/1.2 var(--font-serif,Georgia,serif);color:var(--color-warm-ink,#4d4544)}
.mre-count{font-size:.8rem;color:var(--color-warm-soft,#6e6461);white-space:nowrap}
.mre-summary{list-style:none;margin:0;padding:0;display:grid;gap:4px;font-size:.88rem}
.mre-summary li{display:grid;grid-template-columns:minmax(0,11em) minmax(0,1fr);gap:10px}
.mre-summary-who{display:inline-flex;align-items:center;gap:4px;font-weight:600;overflow-wrap:anywhere}
.mre-field{display:grid;gap:5px}
.mre-fieldset{display:grid;gap:8px;margin:0;padding:0;border:0;min-width:0}
.mre-label{padding:0;font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--color-warm-soft,#6e6461)}
.mre-hint{font-size:.8rem;line-height:1.4;color:var(--color-warm-soft,#6e6461);margin:0;font-weight:400}
.mre-input,.mre-select{width:100%;min-height:44px;box-sizing:border-box;padding:9px 12px;border:1px solid #d7d3cc;border-radius:3px;background:#fff;font:400 1rem var(--font-sans);color:var(--color-warm-ink,#4d4544)}
.mre-check{display:flex;align-items:center;gap:10px;min-height:44px;font-size:.95rem;cursor:pointer}
.mre-check input{width:20px;height:20px;flex:none;accent-color:var(--color-warm-button,#4a3f3e)}
.mre-habit{padding:4px 0;border-bottom:1px solid var(--color-warm-rule,#e7ddd4)}
.mre-rows{list-style:none;margin:0;padding:0;display:grid;border-top:1px solid var(--color-warm-rule,#e7ddd4)}
.mre-row{display:grid;grid-template-columns:36px minmax(0,1fr) auto;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--color-warm-rule,#e7ddd4)}
.mre-row.is-habit{background:var(--mfr-wash,#EEF4F1);margin:0 -8px;padding:10px 8px}
.mre-row.mre-confirm{grid-template-columns:1fr;background:#FBF7F1;margin:0 -8px;padding:10px 8px}
.mre-icon{width:36px;height:36px}
.mre-icon img{display:block;width:100%;height:100%;object-fit:contain}
.mre-row-text{display:grid;gap:3px;min-width:0}
.mre-row-title{font-weight:600;overflow-wrap:anywhere}
.mre-tag{margin-left:8px;font-size:.62rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--mfr-accent,#3F6B5A);border:1.5px solid currentColor;border-radius:999px;padding:2px 6px;white-space:nowrap;vertical-align:2px}
.mre-owners{display:flex;flex-wrap:wrap;align-items:center;gap:2px 8px;font-size:.82rem}
.mre-owner{display:inline-flex;align-items:center;gap:5px}
.mre-amp{color:var(--color-warm-soft,#6e6461)}
.mre-mode{font-size:.72rem;color:var(--color-warm-soft,#6e6461);font-style:italic}
.mre-row-actions{display:flex;gap:6px}
.mre-finish{margin:0;font:italic 400 .9rem/1.45 var(--font-serif,Georgia,serif);color:var(--color-warm-soft,#6e6461)}
.mre-finish b{font:700 .66rem var(--font-sans);font-style:normal;letter-spacing:.14em;text-transform:uppercase;color:var(--color-warm-ink,#4d4544)}
.mre-chips{display:flex;flex-wrap:wrap;gap:6px}
.mre-chip{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:6px 12px;border:1px solid var(--color-warm-rule,#e7ddd4);border-radius:999px;background:#fff;color:var(--color-warm-ink,#4d4544);font:500 .88rem var(--font-sans);cursor:pointer;text-align:left}
.mre-chip--job{border-radius:6px}
.mre-chip[aria-pressed="true"]{border-color:var(--color-warm-button,#4a3f3e);box-shadow:inset 0 0 0 1px var(--color-warm-button,#4a3f3e);font-weight:700}
.mre-dot{width:10px;height:10px;border-radius:50%;flex:none;box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)}
.mre-chip[aria-pressed="false"] .mre-dot{opacity:.45}
.mre-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.mre-actions--end{padding-top:6px;border-top:1px solid var(--color-warm-rule,#e7ddd4)}
.mre-btn{min-height:44px;padding:0 18px;border:1px solid var(--color-warm-button,#4a3f3e);border-radius:3px;background:#fff;color:var(--color-warm-ink,#4d4544);font:600 .78rem var(--font-sans);letter-spacing:.1em;text-transform:uppercase;cursor:pointer;justify-self:start}
.mre-btn--dark{background:var(--color-warm-button,#4a3f3e);color:#fff}
.mre-text-btn,.mre-back{min-height:44px;padding:0 6px;border:0;background:none;color:var(--color-warm-soft,#6e6461);font-size:.85rem;font-weight:600;text-decoration:underline;text-underline-offset:4px;cursor:pointer;justify-self:start}
.mre-back{padding:0;text-decoration:none;color:var(--color-warm-ink,#4d4544)}
.mre-remove{margin-left:auto;color:#8c514c}
.mre-text-btn:disabled,.mre-btn:disabled,.mre-chip:disabled{opacity:.45;cursor:not-allowed}
.mre-confirm{display:grid;gap:8px;padding:12px 14px;border-radius:6px;background:#FBF7F1}
.mre-confirm p{margin:0}
.mre-warn{margin:0;padding:8px 10px;border-left:3px solid #B5654F;background:#FBF1EC;font-size:.88rem;line-height:1.4;color:#7A3B2B}
.mre-warn-inline{font-size:.78rem;color:#7A3B2B}
.mre-status{margin:0;min-height:0;font-size:.85rem;color:var(--color-warm-soft,#6e6461)}
.mre-status:empty{display:none}
.mfr-dialog :focus-visible,.cp-sheet .mre-section :focus-visible{outline:2px solid var(--color-warm-button,#4a3f3e);outline-offset:2px}
@media (max-width:560px){.mre-summary li{grid-template-columns:1fr;gap:0}.mre-row{grid-template-columns:30px minmax(0,1fr)}.mre-row-actions{grid-column:2}.mre-icon{width:30px;height:30px}}
</style>

<script>
import {
  applyFamily, freshState, fromLegacy, isRhythmState, rhythmFingerprint, rhythmView, welcomeMonth,
  type RhythmMember, type RhythmPlanResource, type RhythmState, type RhythmView,
} from '../../lib/club/engines/family-rhythm';
import { marchIconArt } from '../../data/club/march-chore-icons';
import { rhythmEditor, restoreButton, type RhythmSection } from '../../lib/club/march-rhythm-editor';
import { ownerTag } from '../../lib/club/personalize/marks';
import { familySnapshot, settledSnapshot, type FamilySnapshot } from '../../lib/club/personalize/family';
import type { ContextPrefs } from '../../lib/club/personalize/family';
import type { FamilyProfile } from '../../lib/club/family-profile';
import { el } from '../../lib/club/plan/dom';
import { PLAN_CHANGE } from '../../lib/club/plan/resource';
import { planKey, readScoped, tabStorage } from '../../lib/club/plan/storage';
import { monthTints } from '../../lib/club/month-tints';
import { familyTitle } from '../../lib/club/meeting-guide/generate';

type Detail = { household: { id: string; displayName?: string; members?: RhythmMember[]; preferences?: ContextPrefs } | null; sample?: string | null; profile?: FamilyProfile | null };
const root = document.querySelector<HTMLElement & { clubPlan?: RhythmPlanResource }>('[data-mfr]');
if (root) {
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const key = root.dataset.mfrKey ?? 'omc:club:march-chore-charts:v2';
  let current = '', members: RhythmMember[] = [], prefs: ContextPrefs = {}, family = 'Our Family', state: RhythmState = freshState(), persist = true, locked = false;
  // Her newest profile answers: used when the plan has none saved yet, or after "Start over".
  let latest: FamilySnapshot | undefined;
  // The Welcome resource: ages from the month she first opens it (kept with the plan), her priority leading.
  const welcome = root.dataset.mfrContext === 'welcome';
  const settle = () => {
    const p = settledSnapshot(state.profile, latest); if (p) state.profile = p; else delete state.profile;
    if (welcome) { state.context = 'welcome'; state.month ??= welcomeMonth(); }
  };
  const upgrade = (x: unknown) => (welcome ? null : fromLegacy(x, members, prefs, latest));
  const save = () => { if (persist && current) tabStorage.set(key, JSON.stringify({ current, state })); };
  const view = () => rhythmView(state, members, prefs);

  const tints = monthTints('2027-03');
  root.style.setProperty('--mfr-base', tints.base);
  root.style.setProperty('--mfr-wash', tints.wash);
  root.style.setProperty('--mfr-accent', tints.accent);

  const fit = () => root.querySelectorAll<HTMLElement>('.mfr-stage').forEach((stage) => {
    const scale = Math.min(1, Math.max(240, (q('[data-mfr-pages]').clientWidth || 816) - 4) / 816);
    stage.style.width = `${816 * scale}px`;
    stage.style.height = `${1056 * scale}px`;
    stage.querySelector<HTMLElement>('.mfr-sheet')?.style.setProperty('--mfr-scale', String(scale));
  });
  if (typeof ResizeObserver !== 'undefined') new ResizeObserver(fit).observe(q('[data-mfr-pages]'));
  window.addEventListener('resize', fit);

  // Sizes by how much the sheet holds (rows, moments, the practice box, long names): roomy and larger for a small plan,
  // tighter only when a large family needs it. Text never goes below 13px.
  const TIERS = [
    { gap: 44, pad: 15, icon: 54, text: 21, h2: 32, h1: 48, name: 13, fin: 16, 'fin-lg': 18, motto: 19 },
    { gap: 32, pad: 11, icon: 44, text: 18, h2: 27, h1: 40, name: 12, fin: 14, 'fin-lg': 16, motto: 17 },
    { gap: 24, pad: 8, icon: 38, text: 16, h2: 24, h1: 36, name: 12, fin: 13.5, 'fin-lg': 15, motto: 17 },
    { gap: 16, pad: 6, icon: 32, text: 15, h2: 21, h1: 32, name: 11.5, fin: 13, 'fin-lg': 14, motto: 16 },
    { gap: 10, pad: 4, icon: 26, text: 13.5, h2: 19, h1: 28, name: 11, fin: 12.5, 'fin-lg': 13.5, motto: 15, top: 36, bottom: 28 },
  ];
  const tierFor = (v: RhythmView) => {
    const rows = v.printed.flatMap((m) => m.rows);
    const weight = rows.length + v.printed.length * 2.2 + (v.habits.length ? 2.5 + v.habits.length * 0.5 : 0)
      + rows.filter((r) => r.owners.length > 2 || r.title.length > 30).length * 0.5 + (v.people.length > 5 ? 1 : 0);
    return weight <= 11.5 ? 0 : weight <= 15 ? 1 : weight <= 19 ? 2 : weight <= 23 ? 3 : 4;
  };
  const setTier = (paper: HTMLElement, i: number) => {
    paper.dataset.tier = String(i);
    Object.entries({ top: 56, bottom: 44, ...TIERS[i] }).forEach(([k, val]) => paper.style.setProperty(`--mfr-${k}`, `${val}px`));
  };

  const icon = (name: RhythmView['printed'][number]['rows'][number]['icon']) => {
    const art = name ? marchIconArt(name) : null;
    const slot = el('span', { class: 'mfr-slot', 'aria-hidden': 'true' });
    if (art) {
      const img = el('img', { src: art.src, alt: '', decoding: 'async' });
      img.dataset.icon = art.name;
      img.addEventListener('error', () => img.remove(), { once: true });
      slot.append(img);
    }
    return slot;
  };
  const named = (o: { name: string; color: { ink: string } }) => { const s = el('span', { class: 'mfr-name' }, o.name); s.style.color = o.color.ink; return s; };
  const sheet = (v: RhythmView) => {
    const page = el('article', { class: 'mfr-sheet' });
    page.dataset.planSheet = 'front';
    page.setAttribute('data-plan-sheet-end', '');
    page.setAttribute('aria-label', `${family}: our family rhythm`);
    const moments = v.printed.map((m) => el('section', { class: 'mfr-moment' },
      el('div', { class: 'mfr-moment-head' },
        el('h2', { class: 'mfr-moment-title' }, m.title),
        el('p', { class: 'mfr-cue' }, el('b', {}, 'Cue'), `${m.cue} → ${m.reset}`)),
      el('ul', { class: 'mfr-rows' }, ...m.rows.map((r) => {
        const names = r.owners.flatMap((o, i) => (i ? [el('span', { class: 'mfr-amp' }, r.mode === 'together' ? '+' : '·'), named(o)] : [named(o)]));
        const li = el('li', { class: `mfr-row${r.habit ? ' is-habit' : ''}` },
          el('span', { class: 'mfr-bar', 'aria-hidden': 'true' }),
          el('span', { class: 'mfr-who' }, ...names, ...(r.mode === 'one' ? [] : [el('span', { class: 'mfr-mode' }, r.mode === 'each' ? 'EACH THEIR OWN' : 'TOGETHER')])),
          icon(r.icon),
          el('span', { class: 'mfr-job' }, r.title),
          r.habit ? el('span', { class: 'mfr-tag' }, 'New habit') : el('span'));
        li.style.setProperty('--mfr-member', r.owners[0].color.hex);
        // Shared: the bar in equal bands of each owner's color, in the order their names read.
        if (r.owners.length > 1) li.querySelector<HTMLElement>('.mfr-bar')!.style.background = `linear-gradient(${r.owners.map((o, i, a) => `${o.color.hex} ${(i / a.length) * 100}% ${((i + 1) / a.length) * 100}%`).join(',')})`;
        return li;
      })),
      ...(m.finish ? [el('p', { class: 'mfr-finish' }, el('b', {}, 'Finished when'), m.finish)] : [])));
    // The family's focus for the week, in plain sentences, from the actual jobs.
    const habits = v.habits.length ? [el('section', { class: 'mfr-habits' },
      el('p', { class: 'mfr-habits-title' }, 'This week, we’re practicing'),
      el('ul', {}, ...v.habits.map((h) => {
        const names = h.owners.map((o) => o.name);
        const li = el('li', {});
        let rest = h.sentence;
        for (const o of h.owners) {
          const at = rest.indexOf(o.name);
          if (at < 0) continue;
          li.append(rest.slice(0, at), named(o));
          rest = rest.slice(at + o.name.length);
        }
        li.append(rest);
        if (!names.length) li.textContent = h.sentence;
        return li;
      })),
      el('p', { class: 'mfr-habits-note' }, 'Practice together at first. Then let them take the lead.'))] : [];
    const paper = el('div', { class: 'mfr-paper' },
      el('header', { class: 'mfr-head' },
        el('p', { class: 'mfr-kicker' }, 'Our Family Rhythm'),
        el('h1', { class: 'mfr-family' }, family),
        el('p', { class: 'mfr-motto' }, 'Same moments. Everyone has a part.'),
        el('div', { class: 'mfr-legend' }, ...v.people.map((p) => ownerTag(p.name, p.color)))),
      el('div', { class: 'mfr-main' }, ...moments, ...habits),
      el('p', { class: 'mfr-foot' }, 'When the moment comes, we each know our part.'));
    setTier(paper, tierFor(v));
    page.append(paper);
    return { stage: el('div', { class: 'mfr-stage' }, page), paper };
  };
  // Measured on an off-screen copy at full size, so it works whether or not the sheet is showing (phones, the print
  // view, before the page is ready): a plan whose words run long steps down a size rather than clip.
  const measure = (paper: HTMLElement) => {
    const probe = el('div', { 'aria-hidden': 'true' });
    probe.style.cssText = 'position:absolute;left:-10000px;top:0;width:816px;height:1056px;visibility:hidden;overflow:hidden';
    const copy = paper.cloneNode(true) as HTMLElement;
    probe.append(copy);
    document.body.append(probe);
    const foot = copy.querySelector<HTMLElement>('.mfr-foot')!;
    const runsOver = () => foot.offsetTop + foot.offsetHeight > copy.clientHeight - parseFloat(getComputedStyle(copy).paddingBottom) + 1;
    let t = Number(paper.dataset.tier);
    while (t < TIERS.length - 1 && runsOver()) setTier(copy, ++t);
    probe.remove();
    if (t !== Number(paper.dataset.tier)) setTier(paper, t);
  };
  const draw = () => {
    const v = view();
    const has = v.printed.length > 0;
    q('[data-mfr-empty]').hidden = has;
    if (!has) { q('[data-mfr-pages]').replaceChildren(); return; }
    const { stage, paper } = sheet(v);
    q('[data-mfr-pages]').replaceChildren(stage);
    measure(paper);
    fit();
  };

  // The desktop editor: three steps as tabs; "Who owns what" opens one moment, then one job, at a time.
  const dialog = q<HTMLDialogElement>('[data-mfr-editor]');
  let section: RhythmSection = 'owners';
  const STEPS: [RhythmSection, string][] = [['moments', '1 · Our moments'], ['owners', '2 · Who owns what'], ['habits', '3 · New habits']];
  const drawEditor = () => {
    if (!dialog.open) return;
    q('[data-mfr-steps]').replaceChildren(...STEPS.map(([id, label]) => {
      const b = el('button', { type: 'button', role: 'tab' }, label);
      b.setAttribute('aria-selected', String(id === section));
      b.addEventListener('click', () => { if (editor.dirty()) { editor.warn(); return; } section = id; editor.focus(); drawEditor(); });
      return b;
    }));
    const scroll = dialog.scrollTop;
    q('[data-mfr-editor-body]').replaceChildren(editor.section(section));
    q('[data-mfr-restore]').replaceChildren(restoreButton(plan, { locked, redraw: drawEditor }));
    // One job open: it has its own Done and Cancel, so the dialog's own buttons step aside.
    q('.mfr-dialog-actions').hidden = editor.editingRow();
    dialog.scrollTop = editor.editingRow() ? 0 : scroll;
  };
  // Never closes over a job she's still editing: Done or Cancel first.
  const close = () => { if (editor.dirty()) { editor.warn(); dialog.scrollTop = 0; return; } editor.reset(); dialog.close(); };
  root.querySelectorAll('[data-mfr-close]').forEach((b) => b.addEventListener('click', close));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
  dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); });

  const changed = () => { save(); draw(); if (current) root.dispatchEvent(new Event(PLAN_CHANGE, { bubbles: true })); };
  const update = (change: (s: RhythmState) => void) => { if (locked) return; change(state); applyFamily(state, members, prefs); settle(); changed(); };

  const applyHousehold = (detail: Detail) => {
    if (!detail?.household) return;
    const next = planKey(detail.sample ?? null, detail.household.id);
    members = detail.household.members ?? [];
    prefs = detail.household.preferences ?? {};
    family = familyTitle({ displayName: detail.household.displayName } as Parameters<typeof familyTitle>[0]);
    // The owner's print view has no profile (null): the plan comes from the snapshot saved with it.
    if (detail.profile !== undefined && detail.profile !== null) latest = familySnapshot(detail.profile);
    if (next !== current) {
      current = next;
      // This key held the earlier per-person chore charts: a family that changed them keeps who-does-what.
      const saved = readScoped(tabStorage.get(key), current, (x): x is unknown => x !== null && typeof x === 'object');
      state = isRhythmState(saved) ? saved : upgrade(saved) ?? freshState();
    }
    applyFamily(state, members, prefs);
    settle();
    changed();
  };

  const plan: RhythmPlanResource = {
    ready: () => Boolean(current),
    state: () => state,
    update,
    // A saved version from her account, or from before this page changed: upgraded the same way.
    replace: (s) => { state = isRhythmState(s) ? structuredClone(s) : upgrade(s) ?? freshState(); applyFamily(state, members, prefs); settle(); changed(); },
    setPersist: (on) => { persist = on; if (on) save(); },
    fingerprint: () => rhythmFingerprint(state, members, prefs),
    view,
    members: () => members,
    prefs: () => prefs,
    familyName: () => family,
    setLocked: (on) => { locked = on; if (on) { editor.reset(); dialog.close(); } },
    openEditor: (s, momentId) => {
      if (locked) return;
      section = s ?? 'owners';
      editor.focus(momentId);
      if (!dialog.open) dialog.showModal();
      drawEditor();
    },
  };
  const editor = rhythmEditor({ plan: () => plan, locked: () => locked, redraw: drawEditor });
  root.clubPlan = plan;
  // Georgia and Montserrat can arrive after the first draw and make the words longer: measure again once they have,
  // and right before printing.
  document.fonts?.ready.then(() => { if (current) draw(); });
  window.addEventListener('beforeprint', () => { if (current) draw(); });
  window.addEventListener('omc:club-preview-household', (e) => applyHousehold((e as CustomEvent<Detail>).detail));
  const cached = (window as Window & { __ofcPreviewHousehold?: Detail }).__ofcPreviewHousehold;
  if (cached) applyHousehold(cached);
}
</script>

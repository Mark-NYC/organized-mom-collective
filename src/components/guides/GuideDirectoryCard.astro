---
/** Reusable editorial card for a *published* practical guide. */
import type { Guide } from '../../data/guides/guide-directory';
import { guideUrl } from '../../data/guides/guide-directory';
interface Props { guide:Guide; featured?:boolean }
const {guide,featured=false}=Astro.props;
---
<article class:list={['group flex h-full flex-col overflow-hidden border border-[#e2dbd4] bg-white', featured && 'md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.12fr)] md:items-center']}>
  <a href={guideUrl(guide)} class:list={['block overflow-hidden bg-[#FBF7F1]',featured?'md:order-2':'']} aria-label={`Read ${guide.title}`}>
    <div class:list={['flex items-center justify-center bg-[#FBF7F1] p-6',featured?'min-h-[310px] sm:p-10':'min-h-[245px]']}>
      <img src={guide.image} alt={guide.imageAlt} loading={featured?'eager':'lazy'} decoding="async" width="850" height="1100" class:list={['block h-auto max-h-[370px] w-auto max-w-full object-contain shadow-[0_5px_20px_rgba(55,50,48,.12)] transition-transform duration-300 group-hover:scale-[1.015]',featured?'max-h-[440px]':'']} />
    </div>
  </a>
  <div class:list={['flex flex-1 flex-col p-6 sm:p-8',featured&&'sm:p-10']}>
    <p class="label text-[#6f6a65]">{guide.area}</p>
    {featured ? <h3 class="mt-3 font-serif text-[2rem] leading-tight sm:text-[2.35rem]"><a class="hover:underline hover:underline-offset-4" href={guideUrl(guide)}>{guide.title}</a></h3> : <h3 class="mt-3 font-serif text-[1.45rem] leading-tight"><a class="hover:underline hover:underline-offset-4" href={guideUrl(guide)}>{guide.title}</a></h3>}
    <p class="mt-3 text-[0.97rem] leading-[1.75] text-[#5c5550]">{guide.teaser}</p>
    <p class="mt-4 text-[0.77rem] font-semibold leading-relaxed text-[#6f6a65]">{guide.kicker}</p>
    <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-6">
      <a href={guideUrl(guide)} class="btn-primary">Read the guide</a>
      {guide.pdf && <span class="text-xs font-medium text-[#6f6a65]">Free {guide.pages}-page PDF included</span>}
    </div>
  </div>
</article>

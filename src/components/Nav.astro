---
import { CalendarEdge, Wordmark } from './marks';

const items = [
  { href: '/', label: 'Today' },
  { href: '/tidy', label: 'Tidy' },
  { href: '/reorder', label: 'Reorder' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const settingsActive = path.startsWith('/settings');
---

<header data-chrome>
  <CalendarEdge />
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-5 sm:h-16 sm:px-8">
    <a href="/" aria-label="Organized Mom — Today"><Wordmark /></a>
    <nav aria-label="Main" class="hidden sm:block">
      <ul class="flex items-center gap-8">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center border-b-2 text-[0.72rem] font-semibold tracking-[0.18em] uppercase transition-colors',
                  isActive(item.href) ? 'border-ink text-ink' : 'border-transparent text-faint hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      href="/settings"
      aria-current={settingsActive ? 'page' : undefined}
      class:list={[
        '-mr-2 inline-flex min-h-11 items-center px-2 text-[0.66rem] font-semibold tracking-[0.18em] uppercase transition-colors',
        settingsActive ? 'text-ink' : 'text-faint hover:text-ink',
      ]}
    >
      Settings
    </a>
  </div>
  <div class="mx-auto max-w-5xl px-5 sm:px-8"><div class="h-px bg-rule"></div></div>
</header>

<!-- Phone: thin ruled bottom navigation -->
<nav
  data-chrome
  aria-label="Main"
  class="fixed inset-x-0 bottom-0 z-30 border-t border-rule bg-paper pb-[env(safe-area-inset-bottom)] sm:hidden"
>
  <ul class="grid grid-cols-3">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative flex h-14 items-center justify-center text-[0.7rem] font-semibold tracking-[0.2em] uppercase transition-colors',
              isActive(item.href) ? 'text-ink' : 'text-faint',
            ]}
          >
            {isActive(item.href) && <span aria-hidden="true" class="absolute inset-x-6 -top-px h-0.5 bg-ink" />}
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

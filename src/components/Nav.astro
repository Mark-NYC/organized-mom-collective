---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
import { calendarPath } from '../lib/companion';
const calendar = calendarPath(path);
const isClubApp = path === '/app/club' || path.startsWith('/app/club/');
const items = calendar ? [
  { href: '/app/calendar', label: 'Today', glyph: '✓' },
  { href: '/app/calendar/week', label: 'Week', glyph: '▦' },
  { href: '/app/calendar/reorder', label: 'Calendar', glyph: '⌂' },
  { href: '/app/calendar/settings', label: 'Settings', glyph: '◯' },
] : [
  { href: '/app', label: 'Home', glyph: '⌂' },
  { href: '/app/cleaning', label: 'Cleaning', glyph: '✓' },
  { href: '/app/club', label: 'Club', glyph: '▦' },
  { href: '/app/account', label: 'Account', glyph: '◯' },
];
const active = (href: string) => href === '/app' ? path === href : path === href || (href !== '/app/calendar' && path.startsWith(href + '/'));
---
<header data-chrome class="border-b border-warm-rule bg-ivory">
  <div class="mx-auto flex min-h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
    {isClubApp ? (
      <a href="/app/club/" class="inline-flex min-w-0 items-center" aria-label="Organized Family Club home">
        <img src="/images/club/organized-family-club-logo.png" alt="Organized Family Club" width="403" height="91" class="block h-auto w-[93px] max-w-[45vw] object-contain object-left sm:w-[117px]" />
      </a>
    ) : (
      <a href={calendar ? "/app/calendar" : "/app"} class="font-serif text-[1.1rem] font-semibold tracking-tight text-warm-ink" aria-label="Organized Family home">organized <span class="italic text-[#71866c]">family.</span></a>
    )}
    <nav aria-label="Desktop app navigation" class="hidden sm:block"><ul class="flex items-center gap-6">
      {items.map(item => <li data-calendar-feature={!calendar && item.href === "/app/cleaning" ? "" : undefined} hidden={!calendar && item.href === "/app/cleaning"}><a href={item.href} aria-current={active(item.href) ? 'page' : undefined} class:list={['inline-flex min-h-12 items-center border-b-2 px-1 text-[0.8rem] font-semibold',active(item.href) ? 'border-sage text-warm-ink' : 'border-transparent text-warm-soft hover:text-warm-ink']}>{item.label}</a></li>)}
    </ul></nav>
  </div>
</header>
<nav data-chrome aria-label="App navigation" class="fixed inset-x-0 bottom-0 z-40 border-t border-warm-rule bg-ivory/95 shadow-[0_-8px_25px_rgba(67,65,55,0.05)] backdrop-blur-md pb-[env(safe-area-inset-bottom)] sm:hidden">
  <ul class="grid grid-flow-col auto-cols-fr">
    {items.map(item => <li data-calendar-feature={!calendar && item.href === "/app/cleaning" ? "" : undefined} hidden={!calendar && item.href === "/app/cleaning"}><a href={item.href} aria-current={active(item.href) ? 'page' : undefined} class:list={['flex min-h-[64px] flex-col items-center justify-center gap-1 px-1 text-[0.65rem] font-semibold tracking-wide transition-colors', active(item.href) ? 'text-[#536e4e]' : 'text-warm-soft']}>
      <span aria-hidden="true" class:list={['flex h-7 w-10 items-center justify-center rounded-full text-[1.4rem] leading-none',active(item.href) ? 'bg-sage-wash' : '']}>{item.glyph}</span><span>{item.label}</span>
    </a></li>)}
  </ul>
</nav>

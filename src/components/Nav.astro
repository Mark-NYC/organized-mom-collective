---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
import { calendarPath } from '../lib/companion';
import AppTabBar from './AppTabBar.astro';
import { Icon } from './app/ui';
import { PRIMARY_TABS, tabFor } from '../data/app/tabs';
// Organized Family is one unified app on the website and on the iPhone (AppTabBar.astro). Only the printed calendar's
// QR copy (/app/calendar…, website only) keeps its own tabs, with its links in the header on wider screens.
const appShell = import.meta.env.PUBLIC_APP_SHELL === 'ios';
const calendar = !appShell && calendarPath(path);
// The Family Meeting Club lives inside Organized Family: its pages keep this header (ClubNav is the bar under it).
const { club = false } = Astro.props as { club?: boolean };
const items = calendar ? [
  { href: '/app/calendar', label: 'Today', glyph: '✓' },
  { href: '/app/calendar/week', label: 'Week', glyph: '▦' },
  { href: '/app/calendar/reorder', label: 'Calendar', glyph: '⌂' },
  { href: '/app/calendar/settings', label: 'Settings', glyph: '◯' },
] : [];
const active = (href: string) => href === '/app' ? path === href : path === href || (href !== '/app/calendar' && path.startsWith(href + '/'));
// Wide screens (desktop, iPad): the four tabs live in the header instead of the bottom bar (AppTabBar.astro).
// Two tabs (src/data/app/tabs.ts): the meeting is its own tab; every other app screen belongs to Today.
const tabActive = (href: string) => tabFor(club ? '/app/club' : path) === href;
---
<header data-chrome class="border-b border-warm-rule bg-ivory">
  <div class="mx-auto flex min-h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
    <a href={calendar ? "/app/calendar" : "/app"} class="inline-flex min-h-11 items-center font-serif text-[1.1rem] font-semibold tracking-tight text-warm-ink" aria-label="Organized Family home">organized&nbsp;<span class="italic text-[#536b4e]">family.</span></a>
    {!calendar && (
      <nav aria-label="Organized Family" class="hidden lg:block" data-app-topnav><ul class="flex items-center gap-1">
        {PRIMARY_TABS.map(t => <li><a href={t.href} aria-current={tabActive(t.href) ? 'page' : undefined} class:list={['inline-flex min-h-11 items-center gap-2 rounded-[9px] px-3.5 text-[0.82rem] font-semibold', tabActive(t.href) ? 'bg-[var(--of-month-wash)] text-warm-ink' : 'text-warm-soft hover:text-warm-ink']}><Icon name={t.icon} size={19} />{t.label}</a></li>)}
      </ul></nav>
    )}
    {!calendar && (
      <a href="/app/account" aria-label="Account and settings" aria-current={path === '/app/account' || path === '/app/settings' ? 'page' : undefined} data-profile-link
         class="inline-flex size-11 items-center justify-center rounded-full border border-warm-rule bg-white text-warm-ink hover:bg-[#f3f6f1]">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
      </a>
    )}
    {calendar && <nav aria-label="Desktop app navigation" class="hidden sm:block"><ul class="flex items-center gap-6">
      {items.map(item => <li><a href={item.href} aria-current={active(item.href) ? 'page' : undefined} class:list={['inline-flex min-h-12 items-center border-b-2 px-1 text-[0.8rem] font-semibold',active(item.href) ? 'border-sage text-warm-ink' : 'border-transparent text-warm-soft hover:text-warm-ink']}>{item.label}</a></li>)}
    </ul></nav>}
  </div>
</header>
<AppTabBar club={club} />

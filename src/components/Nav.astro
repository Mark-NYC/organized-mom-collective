---
import Icon from './Icon.astro';

const items = [
  { href: '/', label: 'Today', icon: 'today' },
  { href: '/tidy', label: 'Tidy', icon: 'tidy' },
  { href: '/reorder', label: 'Reorder', icon: 'reorder' },
] as const;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!-- Desktop / tablet: small top navigation -->
<header data-chrome class="border-b border-line/70 bg-paper/90 backdrop-blur-sm sm:sticky sm:top-0 sm:z-30">
  <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-5">
    <a href="/" class="font-serif text-[1.35rem] font-semibold tracking-tight text-ink">
      Organized <span class="italic font-medium">Mom</span>
    </a>
    <nav aria-label="Main" class="hidden sm:block">
      <ul class="flex items-center gap-1">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-4 py-2 text-sm font-medium transition-colors',
                  isActive(item.href) ? 'bg-ink text-white' : 'text-muted hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      href="/settings"
      aria-label="Settings"
      aria-current={path.startsWith('/settings') ? 'page' : undefined}
      class="-mr-2 grid size-11 place-items-center rounded-full text-muted transition-colors hover:text-ink"
    >
      <Icon name="settings" class="size-[22px]" />
    </a>
  </div>
</header>

<!-- Phone: fixed bottom navigation -->
<nav
  data-chrome
  aria-label="Main"
  class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-card/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-sm sm:hidden"
>
  <ul class="mx-auto grid max-w-md grid-cols-3">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex min-h-16 flex-col items-center justify-center gap-1 text-[0.72rem] font-medium tracking-wide transition-colors',
              isActive(item.href) ? 'text-ink' : 'text-faint',
            ]}
          >
            <Icon name={item.icon} class="size-[22px]" />
            <span class:list={[isActive(item.href) && 'underline decoration-1 underline-offset-4']}>{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

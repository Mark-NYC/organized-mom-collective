---
/**
 * Organized Family's bottom tab bar: Today · Calendar · Cleaning · Family, with Account behind the profile icon in the
 * header (Nav.astro). The same on the website's /app and in the iPhone app (owner decision 2026-11-17), at every
 * width. Shared by Nav.astro (every /app page) and, in the iPhone app bundle, ClubLayout (/club/login, /club/family…),
 * so no screen in the app is a dead end: the app has no back button (docs/ios/OMC_APP_ROADMAP.md).
 *
 * One exception, website only: the printed calendar's QR copy (/app/calendar…) keeps its own four phone tabs (its
 * "Calendar" tab is the reorder page, which stays on the website).
 */
import { calendarPath } from '../lib/companion';
import { Icon } from './app/ui';
import { PRIMARY_TABS } from '../data/app/tabs';

interface Props {
  /** Render in ClubLayout: Club pages count as the Club tab, and the bar needs room reserved below the page. */
  club?: boolean;
}
const { club = false } = Astro.props;
const appShell = import.meta.env.PUBLIC_APP_SHELL === 'ios';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const calendar = !appShell && calendarPath(path);
const items = calendar ? [
  { href: '/app/calendar', label: 'Today', glyph: '✓' },
  { href: '/app/calendar/week', label: 'Week', glyph: '▦' },
  { href: '/app/calendar/reorder', label: 'Calendar', glyph: '⌂' },
  { href: '/app/calendar/settings', label: 'Settings', glyph: '◯' },
] : PRIMARY_TABS;
const active = (href: string) => {
  if (href === '/app') return path === '/app';
  if (href === '/app/club' && (club || path.startsWith('/club/'))) return true;
  // The Club, its meeting pages and the family pages all live under the app's Family tab.
  if (href === '/app/family') return club || path === '/app/family' || /^\/(app\/family|app\/club|club)(\/|$)/.test(path);
  if (!calendar && href === '/app/cleaning') return path === '/app/cleaning' || /^\/app\/(week|settings|calendar)(\/|$)/.test(path);
  return path === href || (href !== '/app/calendar' && path.startsWith(href + '/'));
};
---
<nav
  data-chrome
  data-app-tabbar
  aria-label="App navigation"
  class:list={[
    'fixed inset-x-0 bottom-0 z-40 border-t border-warm-rule bg-ivory/95 shadow-[0_-8px_25px_rgba(67,65,55,0.05)] backdrop-blur-md pb-[env(safe-area-inset-bottom)]',
    // Wide screens get the tabs in the header (Nav.astro), except on the app's Club pages, whose header is the Club's.
    calendar ? 'sm:hidden' : club ? 'print:hidden' : 'print:hidden lg:hidden',
  ]}
>
  <ul class:list={['grid grid-flow-col auto-cols-fr', !calendar && 'mx-auto max-w-xl']}>
    {items.map(item => <li><a href={item.href} aria-current={active(item.href) ? 'page' : undefined} class:list={['flex min-h-[64px] flex-col items-center justify-center gap-1 px-1 text-[0.65rem] font-semibold tracking-wide transition-colors', active(item.href) ? 'text-warm-ink' : 'text-warm-soft']}>
      <span aria-hidden="true" class:list={['flex h-8 w-12 items-center justify-center rounded-[9px] text-[1.4rem] leading-none', active(item.href) ? 'bg-[var(--of-month-wash)] text-warm-ink' : '']}>{'icon' in item ? <Icon name={item.icon} size={22} /> : item.glyph}</span><span>{item.label}</span>
    </a></li>)}
  </ul>
</nav>
{club && (
  <>
    <style is:global>
      /* Room for the fixed tab bar under a Club page (the app bundle only renders this). */
      body { padding-bottom: calc(4.5rem + env(safe-area-inset-bottom)); }
      @media print { body { padding-bottom: 0; } }
    </style>
    <script>
      // Show the Cleaning tab when this device or account has the wall calendar (same rule as every /app page).
      import { initCompanionAccess } from '../lib/companion-access';
      void initCompanionAccess();
    </script>
  </>
)}

---
/**
 * A routine chart (the design, autosave and PNG export): pick a type (morning, after-school, bedtime,
 * weekend, summer, custom) to load starter steps and times, edit any line on the sheet, add steps from suggestion
 * chips, download as a PNG (US Letter portrait, 8.5 × 11 in at 96 px/in, drawn at 2×).
 * Used by /routine-chart (free) and the upgraded chart for Take Back Control and Essential Routines buyers (ROUTINE_PLUS_PATH),
 * which passes `notes`: a reminder line under each step, with starter notes. Starter routines:
 * src/data/routines.ts. Saves in this browser under `storageKey`. Classes are prefixed `mr-`.
 * Illustrated steps come from the shared responsibility library (ResponsibilityPicker): a step's illustration id
 * saves as `icon-{i}`; lines matching a library job get its illustration. Arrows reorder steps on screen (times stay put).
 * The Summer type (src/data/summer-rhythm.ts) shows three quick questions above the chart and a part of the day
 * (`anchor-{i}`: Morning, Midday…) heading each group of steps, in the time column when a step has no time.
 * Slots: `picker-note` (under the picker), `after-sheet` (under the chart), `footnote`.
 * Behavior: src/components/site/routine-chart.ts (shared by every page that shows this chart, the Club's included).
 */
import '@fontsource/kalam/latin-700.css';
import { defaultToolPalette } from '../../data/tool-palettes';
import { BRAND_NAME } from '../../config';
import { routineTypes, ROUTINE_ROWS } from '../../data/routines';
import { dayOptions, focusOptions, stageOptions, structureOptions } from '../../data/summer-rhythm';
import ResponsibilityPicker from './ResponsibilityPicker.astro';

interface Props {
  /** A reminder line under each step (the upgraded chart). */
  notes?: boolean;
  storageKey: string;
  /**
   * Opened for someone by another page (src/lib/tool-handoff.ts; the Organized Family Club): their own saved chart,
   * their name in the title, age-suited jobs first. Public pages never set it.
   */
  handoff?: boolean;
  /** The line at the foot of the chart (default: the brand name). */
  brand?: string;
}

const { notes = false, storageKey, handoff = false, brand = BRAND_NAME } = Astro.props;
const start = routineTypes.morning;
const rows = Array.from({ length: ROUTINE_ROWS }, (_, i) => start.steps[i] ?? ['', '', '']);
---

<div class:list={['mr-container', notes && 'mr-with-notes']} data-mr-key={storageKey} data-mr-notes={notes ? '' : undefined} data-mr-handoff={handoff ? '' : undefined}>
  <div class="mr-builder-heading"><span class="mr-builder-kicker">MAKE IT YOURS</span><h2>Build your child’s routine</h2><p>Choose a starting routine, then customize the steps and download your chart.</p></div>
  <div class="mr-workspace">
  <div class="mr-controls">
  <p class="mr-mobile-field-label">1. Choose a routine</p>
  <div class="mr-types" role="group" aria-label="Routine">
    {
      Object.entries(routineTypes).map(([id, t]) => (
        <button type="button" class="mr-type" data-mr-type={id} aria-pressed={id === 'morning' ? 'true' : 'false'}>
          <span class="mr-type-label">{t.label}</span>
          <span class="mr-type-blurb">{t.blurb}</span>
        </button>
      ))
    }
  </div>

  <div class="mr-icon-style" role="group" aria-label="Illustration style">
    <span class="mr-icon-style-label">Illustration style</span>
    <button type="button" data-mr-icon-style="hand-drawn" aria-pressed="true">Hand-drawn</button>
    <button type="button" data-mr-icon-style="soft-color" aria-pressed="false">Soft color</button>
    <span class="mr-icon-style-note">Soft color is a preview. Activities without a color icon keep their hand-drawn artwork.</span>
  </div>

  <div class="mr-mobile-controls" aria-label="Customize your routine">
    <button type="button" data-mr-mobile-open="pick">+ Choose activities</button>
    <button type="button" data-mr-mobile-open="edit">Edit details</button>
  </div>

  <section class="mr-summer" data-mr-summer hidden aria-labelledby="mr-summer-h">
    <h2 id="mr-summer-h" class="mr-summer-title">Shape your summer rhythm</h2>
    <p class="mr-summer-note">A few anchors for ordinary summer days, not a schedule. Camps, trips and plans go on the family calendar.</p>
    <div class="mr-summer-q" role="group" aria-label="Who’s it for?"><span>Who’s it for?</span>
      {stageOptions.map((o) => <button type="button" class="mr-opt" data-mr-summer-stage={o.id} aria-pressed={o.id === 'school' ? 'true' : 'false'}>{o.label}</button>)}
    </div>
    <div class="mr-summer-q" role="group" aria-label="Their days"><span>Their days</span>
      {dayOptions.map((o) => <button type="button" class="mr-opt" data-mr-summer-days={o.id} aria-pressed={o.id === 'home' ? 'true' : 'false'}>{o.label}</button>)}
    </div>
    <div class="mr-summer-q" role="group" aria-label="How much structure?"><span>How much structure?</span>
      {structureOptions.map((o) => <button type="button" class="mr-opt" data-mr-summer-structure={o.id} aria-pressed={o.id === 'balanced' ? 'true' : 'false'} title={o.hint}>{o.label}</button>)}
    </div>
    <div class="mr-summer-q" role="group" aria-label="What needs the most attention? (optional)"><span>What needs the most attention? <em>Optional</em></span>
      {focusOptions.map((o) => <button type="button" class="mr-opt" data-mr-summer-focus={o.id} aria-pressed="false">{o.label}</button>)}
    </div>
    <p class="mr-summer-status" data-mr-summer-status role="status" aria-live="polite"></p>
  </section>

  <ResponsibilityPicker monochrome routineExtras hint="Tap an illustration to add it. The exact same artwork appears on your printable.">
    <slot name="picker-note" />
  </ResponsibilityPicker>

  <section class="mr-editor" aria-label="Edit your routine steps">
    <div class="mr-editor-head"><h3>Edit your routine</h3><p>Rename, clear, or move activities here. Your preview updates as you go.</p></div>
    <div class="mr-editor-list">
      {rows.map(([time,step],i) => (
        <div class="mr-editor-row">
          <span class="mr-editor-num">{i+1}</span>
          <input type="text" data-mr-editor-step={i} value={step} placeholder="Add an activity" aria-label={`Edit activity ${i+1}`} />
           <input class="mr-editor-time" type="time" data-mr-editor-time={i} value={time} aria-label={`Time for activity ${i+1}`} />
          <button type="button" class="mr-editor-remove" data-mr-editor-clear={i} aria-label={`Clear activity ${i+1}`} title="Clear activity">×</button>
          <span class="mr-editor-moves">
            <button type="button" data-mr-editor-move={i} data-mr-dir="-1" aria-label={`Move activity ${i+1} up`} disabled={i===0}>↑</button>
            <button type="button" data-mr-editor-move={i} data-mr-dir="1" aria-label={`Move activity ${i+1} down`} disabled={i===ROUTINE_ROWS-1}>↓</button>
          </span>
        </div>
      ))}
    </div>
  </section>

  <div class="mr-reset-area"><button type="button" class="mr-btn" data-mr-reset>Reset to starter routine</button></div>

  <div class="mr-ideas">
    <span class="mr-ideas-label">Add a step</span>
    <span class="mr-chips" data-mr-chips>
      {start.ideas.map((idea) => <button type="button" class="mr-chip" data-idea={idea}>+ {idea}</button>)}
    </span>
    <p class="mr-hint">Or tap any line on the chart to type your own.</p>
  </div>

  </div><!-- /mr-controls -->
  <div class="mr-preview">
    <div class="mr-mobile-preview-title"><strong>2. Your routine chart</strong><button type="button" data-mr-mobile-zoom-open>⤢ Enlarge</button></div>
    <div class="mr-preview-label"><span>LIVE PREVIEW</span><p>Tap the title, times, or steps to edit right on the chart.</p></div>
  <div class="mr-mobile-print-frame" data-mr-mobile-print-frame>
  <div class="mr-sheet" id="routine-chart">
    <input type="hidden" data-field="palette" value={defaultToolPalette} />
    <input type="hidden" data-field="type" value="morning" data-mr-type-field />
    <input type="hidden" data-field="summer" value="" data-mr-summer-field />
    <div class="mr-head">
      <input class="mr-title" type="text" data-field="title" value={start.title} aria-label="Chart title" />
      <input class="mr-subtitle" type="text" data-field="subtitle" value={start.subtitle} aria-label="Subtitle" />
    </div>

    <ol class="mr-steps">
      {
        rows.map(([time, step, note], i) => (
          <li class="mr-step">
            <input type="hidden" data-field={`icon-${i}`} data-mr-icon-field />
            <span class="mr-num" aria-hidden="true">{i + 1}</span>
            <span class="mr-when">
              <input class="mr-anchor" type="text" data-field={`anchor-${i}`} data-mr-anchor maxlength="14" aria-label={`Step ${i + 1} part of the day`} />
              <input class="mr-time" type="time" data-field={`time-${i}`} value={time} aria-label={`Step ${i + 1} time`} />
            </span>
            <span class="mr-icon" data-mr-icon><img alt="" width="52" height="52" decoding="async" /></span>
            <span class="mr-what">
              <input class="mr-text" type="text" data-field={`step-${i}`} data-mr-step value={step} aria-label={`Step ${i + 1}`} />
              {notes && (
                <input class="mr-note" type="text" data-field={`note-${i}`} value={note} placeholder="Add a reminder" aria-label={`Step ${i + 1} note`} />
              )}
            </span>
            <span class="mr-box" aria-hidden="true" />
            <span class="mr-move">
              <button type="button" data-mr-move={-1} aria-label={`Move step ${i + 1} up`} disabled={i === 0}>↑</button>
              <button type="button" data-mr-move={1} aria-label={`Move step ${i + 1} down`} disabled={i === ROUTINE_ROWS - 1}>↓</button>
            </span>
          </li>
        ))
      }
    </ol>

    <div class="mr-done">
      <input class="mr-end-label" type="text" data-field="end-label" value={start.endLabel} aria-label="Finish line label" />
      <input class="mr-time" type="time" data-field="end-time" value={start.endTime} aria-label="Finish time" />
    </div>

    <div class="mr-foot">{brand}</div>
  </div>
  </div><!-- /mr-mobile-print-frame -->
  <div class="mr-actions">
    <button type="button" class="mr-btn mr-btn-primary" data-mr-download>Download My Routine Chart</button>
  </div>
  </div><!-- /mr-preview -->
  </div><!-- /mr-workspace -->

  <dialog class="mr-mobile-zoom" data-mr-mobile-zoom aria-label="Enlarged routine chart preview">
    <div class="mr-mobile-zoom-head"><strong>Full-size preview</strong><button type="button" data-mr-mobile-zoom-close aria-label="Close enlarged preview">✕ Close</button></div>
    <div class="mr-mobile-zoom-scroll" data-mr-mobile-zoom-scroll></div>
    <p>Swipe sideways to inspect your printable.</p>
  </dialog>
  <dialog class="mr-mobile-dialog" data-mr-mobile-dialog="pick" aria-label="Choose routine activities">
    <div class="mr-mobile-dialog-head"><h2>Choose activities</h2><button type="button" data-mr-mobile-close aria-label="Close activity picker">✕</button></div>
    <div class="mr-mobile-dialog-body" data-mr-mobile-target="pick"></div>
    <div class="mr-mobile-dialog-foot"><button type="button" data-mr-mobile-close>Done adding activities</button></div>
  </dialog>
  <dialog class="mr-mobile-dialog" data-mr-mobile-dialog="edit" aria-label="Edit routine">
    <div class="mr-mobile-dialog-head"><h2>Edit your routine</h2><button type="button" data-mr-mobile-close aria-label="Close routine editor">✕</button></div>
    <div class="mr-mobile-dialog-body">
      <div class="mr-mobile-details">
        <label>Chart title<input type="text" data-mr-mobile-field="title" maxlength="80" autocomplete="off" /></label>
        <label>Subtitle<input type="text" data-mr-mobile-field="subtitle" maxlength="110" autocomplete="off" /></label>
      </div>
      <div data-mr-mobile-target="edit"></div>
      <div class="mr-mobile-details">
        <label>Finish line<input type="text" data-mr-mobile-field="end-label" maxlength="80" autocomplete="off" /></label>
        <label>Finish time<input type="time" data-mr-mobile-field="end-time" /></label>
      </div>
    </div>
    <div class="mr-mobile-dialog-foot"><button type="button" data-mr-mobile-close>Save and view chart</button></div>
  </dialog>

  <div class="mr-after"><slot name="after-sheet" /></div>

  <slot name="footnote" />
</div>


<style is:global>
  .mr-icon-style { display:flex; align-items:center; flex-wrap:wrap; gap:8px; max-width:816px; margin:0 auto 20px; font-family:var(--font-sans); }
  .mr-icon-style-label { margin-right:6px; font-size:.85rem; font-weight:600; }
  .mr-icon-style button { cursor:pointer; background:#fff; color:#545454; border:1px solid #d5c5b8; border-radius:999px; padding:8px 16px; font:inherit; font-size:.85rem; }
  .mr-icon-style button[aria-pressed="true"] { background:#d4dfc4; border-color:#545454; font-weight:700; }
  .mr-icon-style button:focus-visible { outline:2px solid #545454; outline-offset:2px; }
  .mr-icon-style-note { flex-basis:100%; color:#76706b; font-size:.75rem; }
  .mr-container {
    --mr-ink: var(--color-warm-ink);
    --mr-soft: var(--color-warm-soft);
    --mr-rule: var(--color-warm-rule);
    --mr-rose: var(--color-rose);
    --mr-rose-deep: var(--color-rose-deep);
    --mr-rose-wash: var(--color-rose-wash);
    --mr-sage: var(--color-sage);
    --mr-sage-wash: var(--color-sage-wash);
    background-color: var(--color-ivory);
    padding: 28px 20px 56px;
    color: var(--mr-ink);
  }
  .mr-container *,
  .mr-container *::before,
  .mr-container *::after {
    box-sizing: border-box;
  }

  @media (max-width:768px) {
    .mr-types { display:flex !important; gap:8px; overflow-x:auto; scroll-snap-type:x proximity; padding:0 2px 10px; -webkit-overflow-scrolling:touch; }
    .mr-types .mr-type { flex:0 0 auto; min-width:115px; min-height:52px; border-radius:12px; scroll-snap-align:start; }
    .mr-type-blurb { display:none; }
    .mr-actions { display:grid; grid-template-columns:1fr auto; gap:12px; }
    .mr-actions .mr-btn-primary { border-radius:12px; letter-spacing:0; text-transform:none; font-size:.9rem; }
    .mr-actions .mr-btn:not(.mr-btn-primary) { min-width:72px; }
  }
  .mr-types {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    max-width: 816px;
    margin: 0 auto 20px;
  }
  .mr-type {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 10px;
    border: 1px solid var(--mr-rule);
    border-radius: 6px;
    background: #fff;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .mr-type:hover {
    border-color: var(--mr-rose);
  }
  .mr-type[aria-pressed='true'] {
    border-color: var(--mr-rose-deep);
    background: var(--mr-rose-wash);
    box-shadow: inset 0 0 0 1px var(--mr-rose-deep);
  }
  .mr-type-label {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--mr-ink);
  }
  .mr-type-blurb {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--mr-soft);
  }
  .mr-chips {
    display: contents;
  }
  .mr-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0 auto 20px;
  }
  .mr-btn {
    min-height: 48px;
    padding: 0 24px;
    border: 1px solid var(--color-warm-button);
    border-radius: 3px;
    background: #fff;
    color: var(--color-warm-button);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .mr-btn:hover {
    background: var(--mr-rose-wash);
  }
  .mr-btn-primary {
    background: var(--color-warm-button);
    color: #fff;
  }
  .mr-btn-primary:hover {
    background: #362e2d;
  }
  .mr-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .mr-ideas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 816px;
    margin: 0 auto 24px;
  }
  .mr-ideas-label {
    margin-right: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mr-soft);
  }
  .mr-chip {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--mr-rule);
    border-radius: 999px;
    background: #fff;
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: var(--mr-ink);
    cursor: pointer;
  }
  .mr-chip:hover {
    border-color: var(--mr-rose);
    background: var(--mr-rose-wash);
  }
  .mr-hint {
    flex-basis: 100%;
    font-size: 0.9rem;
    color: var(--mr-soft);
  }

  /* The sheet: US Letter portrait (8.5 × 11 in at 96 px/in). */
  .mr-sheet {
    display: flex;
    flex-direction: column;
    width: 816px;
    max-width: 100%;
    min-height: 1056px;
    margin: 0 auto;
    padding: 44px 52px 28px;
    background: var(--color-ivory);
    border: 1px solid var(--mr-rule);
    border-radius: 6px;
    box-shadow: 0 6px 24px rgba(77, 69, 68, 0.08);
    font-family: var(--font-serif);
  }
  .mr-sheet input {
    min-width: 0;
    border: none;
    border-radius: 3px;
    background: transparent;
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--mr-ink);
  }
  .mr-sheet input:focus {
    outline: none;
    background: var(--mr-rose-wash);
  }
  .mr-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 16px;
    margin-bottom: 22px;
    border-bottom: 2px solid var(--mr-rose);
  }
  .mr-sheet .mr-title {
    width: 100%;
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-align: center;
  }
  .mr-sheet .mr-subtitle {
    width: 100%;
    margin-top: 2px;
    font-size: 22px;
    font-style: italic;
    text-align: center;
    color: var(--mr-rose-deep);
  }
  .mr-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mr-step {
    display: grid;
    grid-template-columns: 40px 138px minmax(0, 1fr) 40px;
    gap: 14px;
    align-items: center;
    min-height: 74px;
    padding: 0 18px 0 14px;
    border: 1px solid var(--mr-rule);
    border-radius: 6px;
    background: #fff;
  }
  .mr-num {
    font-size: 30px;
    line-height: 1;
    text-align: center;
    color: var(--mr-rose);
  }
  .mr-sheet .mr-time {
    height: 40px;
    padding: 0 8px;
    background: var(--mr-sage-wash);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #5d6b55;
  }
  .mr-sheet .mr-text {
    height: 44px;
    padding: 0 6px;
    font-size: 22px;
  }
  .mr-what {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .mr-sheet .mr-note {
    height: 26px;
    padding: 0 6px;
    font-size: 15px;
    font-style: italic;
    color: var(--mr-soft);
  }
  .mr-sheet .mr-note::placeholder {
    color: #c4b8b2;
  }
  .mr-with-notes .mr-steps {
    gap: 9px;
  }
  .mr-with-notes .mr-step {
    min-height: 78px;
  }
  .mr-with-notes .mr-sheet .mr-text {
    height: 36px;
    font-size: 21px;
  }
  .mr-box {
    width: 36px;
    height: 36px;
    border: 2px solid var(--mr-rose);
    border-radius: 4px;
  }
  .mr-done {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 22px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .mr-done .mr-time {
    width: 140px;
  }
  .mr-sheet .mr-end-label {
    width: 240px;
    height: 40px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-align: right;
    text-transform: uppercase;
  }
  .mr-foot {
    margin-top: 18px;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
    color: #b3a7a1;
  }
  .mr-footnote {
    margin: 28px auto 0;
    text-align: center;
    font-size: 0.95rem;
    line-height: 2;
    color: var(--mr-soft);
  }

  @media (max-width:768px) {
    .mr-container:not(.mr-exporting) { display:flex; flex-direction:column; }
    .mr-container:not(.mr-exporting) .mr-types { order:1; }
    .mr-container:not(.mr-exporting) .mr-sheet { order:2; }
    .mr-container:not(.mr-exporting) .mr-actions { order:3; width:100%; margin-top:16px; }
    .mr-container:not(.mr-exporting) .mr-actions [data-mr-download] { width:100%; min-height:52px; }
    .mr-container:not(.mr-exporting) .mr-actions [data-mr-reset] { display:none; }
    .mr-container:not(.mr-exporting) .mr-ideas { order:6; }
    .mr-container:not(.mr-exporting) .mr-ideas:not(.mr-ideas-open) { display:none; }
    .mr-container:not(.mr-exporting) .mr-footnote { order:7; }
  }
  /* Phones: smaller type, time above the step. The PNG is always the Letter layout. */
  @media (max-width: 768px) {
    .mr-types {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .mr-container:not(.mr-exporting) .mr-end-label {
      width: 150px;
      font-size: 11px;
    }
    .mr-container:not(.mr-exporting) .mr-sheet {
      min-height: 0;
      padding: 22px 12px;
    }
    .mr-container:not(.mr-exporting) .mr-title {
      font-size: 34px;
    }
    .mr-container:not(.mr-exporting) .mr-subtitle {
      font-size: 18px;
    }
    .mr-container:not(.mr-exporting) .mr-steps {
      gap: 8px;
    }
    .mr-container:not(.mr-exporting) .mr-step {
      grid-template-columns: 24px minmax(0, 1fr) 30px;
      grid-template-areas: 'num time box' 'num what box';
      gap: 2px 10px;
      padding: 8px 10px;

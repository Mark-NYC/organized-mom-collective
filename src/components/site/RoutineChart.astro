---
/**
 * A routine chart (the design, autosave and PNG export): pick a type (morning, after-school, bedtime,
 * weekend, custom) to load starter steps and times, edit any line on the sheet, add steps from suggestion
 * chips, download as a PNG (US Letter portrait, 8.5 × 11 in at 96 px/in, drawn at 2×).
 * Used by /routine-chart (free) and the upgraded chart for Take Back Control and Essential Routines buyers (ROUTINE_PLUS_PATH),
 * which passes `notes`: a reminder line under each step, with starter notes. Starter routines:
 * src/data/routines.ts. Saves in this browser under `storageKey`. Classes are prefixed `mr-`.
 * Illustrated steps come from the shared responsibility library (ResponsibilityPicker): a step's illustration id
 * saves as `icon-{i}`; lines matching a library job get its illustration. Arrows reorder steps on screen (times stay put).
 * Slots: `picker-note` (under the picker), `after-sheet` (under the chart), `footnote`.
 * Behavior: src/components/site/routine-chart.ts (shared by every page that shows this chart, the Club's included).
 */
import '@fontsource/kalam/latin-700.css';
import { toolPalettes, defaultToolPalette } from '../../data/tool-palettes';
import { BRAND_NAME } from '../../config';
import { routineTypes, ROUTINE_ROWS } from '../../data/routines';
import ResponsibilityPicker from './ResponsibilityPicker.astro';

interface Props {
  /** A reminder line under each step (the upgraded chart). */
  notes?: boolean;
  storageKey: string;
  /**
   * Opened for someone by another page (src/lib/tool-handoff.ts; the Organized Family Club): their own saved chart,
   * their name in the title, age-suited jobs first. Public pages never set it.
   */
  handoff?: boolean;
  /** The line at the foot of the chart (default: the brand name). */
  brand?: string;
}

const { notes = false, storageKey, handoff = false, brand = BRAND_NAME } = Astro.props;
const start = routineTypes.morning;
const rows = Array.from({ length: ROUTINE_ROWS }, (_, i) => start.steps[i] ?? ['', '', '']);
---

<div class:list={['mr-container', notes && 'mr-with-notes']} data-mr-key={storageKey} data-mr-notes={notes ? '' : undefined} data-mr-handoff={handoff ? '' : undefined}>
  <div class="mr-types" role="group" aria-label="Routine">
    {
      Object.entries(routineTypes).map(([id, t]) => (
        <button type="button" class="mr-type" data-mr-type={id} aria-pressed={id === 'morning' ? 'true' : 'false'}>
          <span class="mr-type-label">{t.label}</span>
          <span class="mr-type-blurb">{t.blurb}</span>
        </button>
      ))
    }
  </div>

  <ResponsibilityPicker hint="Tap one to add it to the next open step. Use the arrows on the chart to change the order.">
    <slot name="picker-note" />
  </ResponsibilityPicker>

  <fieldset class="mr-palette-picker" data-mr-advanced>
    <legend>Choose your colors</legend>
    <div class="mr-palette-options">
      {Object.entries(toolPalettes).map(([id, palette]) => (
        <button type="button" class="mr-palette-option" data-mr-palette={id} aria-pressed={id === defaultToolPalette}>
          <span class="mr-swatches" aria-hidden="true">{palette.colors.map(color => <span style={{ backgroundColor: color }} />)}</span>
          <span>{palette.label}</span>
        </button>
      ))}
    </div>
  </fieldset>
  <div class="mr-actions">
    <button type="button" class="mr-btn mr-btn-primary" data-mr-download>Download routine</button>
    <button type="button" class="mr-btn" data-mr-reset>Reset routine</button>
  </div>

  <button type="button" class="mr-customize-link" data-mr-customize aria-expanded="false">Customize steps and colors</button>
  <div class="mr-ideas">
    <span class="mr-ideas-label">Add a step</span>
    <span class="mr-chips" data-mr-chips>
      {start.ideas.map((idea) => <button type="button" class="mr-chip" data-idea={idea}>+ {idea}</button>)}
    </span>
    <p class="mr-hint">Or tap any line on the chart to type your own.</p>
  </div>

  <div class="mr-sheet" id="routine-chart">
    <input type="hidden" data-field="palette" value={defaultToolPalette} />
    <input type="hidden" data-field="type" value="morning" data-mr-type-field />
    <div class="mr-head">
      <input class="mr-title" type="text" data-field="title" value={start.title} aria-label="Chart title" />
      <input class="mr-subtitle" type="text" data-field="subtitle" value={start.subtitle} aria-label="Subtitle" />
    </div>

    <ol class="mr-steps">
      {
        rows.map(([time, step, note], i) => (
          <li class="mr-step">
            <input type="hidden" data-field={`icon-${i}`} data-mr-icon-field />
            <span class="mr-num" aria-hidden="true">{i + 1}</span>
            <input class="mr-time" type="time" data-field={`time-${i}`} value={time} aria-label={`Step ${i + 1} time`} />
            <span class="mr-icon" data-mr-icon><img alt="" width="52" height="52" decoding="async" /></span>
            <span class="mr-what">
              <input class="mr-text" type="text" data-field={`step-${i}`} data-mr-step value={step} aria-label={`Step ${i + 1}`} />
              {notes && (
                <input class="mr-note" type="text" data-field={`note-${i}`} value={note} placeholder="Add a reminder" aria-label={`Step ${i + 1} note`} />
              )}
            </span>
            <span class="mr-box" aria-hidden="true" />
            <span class="mr-move">
              <button type="button" data-mr-move={-1} aria-label={`Move step ${i + 1} up`} disabled={i === 0}>↑</button>
              <button type="button" data-mr-move={1} aria-label={`Move step ${i + 1} down`} disabled={i === ROUTINE_ROWS - 1}>↓</button>
            </span>
          </li>
        ))
      }
    </ol>

    <div class="mr-done">
      <input class="mr-end-label" type="text" data-field="end-label" value={start.endLabel} aria-label="Finish line label" />
      <input class="mr-time" type="time" data-field="end-time" value={start.endTime} aria-label="Finish time" />
    </div>

    <div class="mr-foot">{brand}</div>
  </div>

  <div class="mr-after"><slot name="after-sheet" /></div>

  <slot name="footnote" />
</div>


<style is:global>
  .mr-container {
    --mr-ink: var(--color-warm-ink);
    --mr-soft: var(--color-warm-soft);
    --mr-rule: var(--color-warm-rule);
    --mr-rose: var(--color-rose);
    --mr-rose-deep: var(--color-rose-deep);
    --mr-rose-wash: var(--color-rose-wash);
    --mr-sage: var(--color-sage);
    --mr-sage-wash: var(--color-sage-wash);
    background-color: var(--color-ivory);
    padding: 28px 20px 56px;
    color: var(--mr-ink);
  }
  .mr-container *,
  .mr-container *::before,
  .mr-container *::after {
    box-sizing: border-box;
  }

  @media (max-width:768px) {
    .mr-types { display:flex !important; gap:8px; overflow-x:auto; scroll-snap-type:x proximity; padding:0 2px 10px; -webkit-overflow-scrolling:touch; }
    .mr-types .mr-type { flex:0 0 auto; min-width:115px; min-height:52px; border-radius:12px; scroll-snap-align:start; }
    .mr-type-blurb { display:none; }
    .mr-actions { display:grid; grid-template-columns:1fr auto; gap:12px; }
    .mr-actions .mr-btn-primary { border-radius:12px; letter-spacing:0; text-transform:none; font-size:.9rem; }
    .mr-actions .mr-btn:not(.mr-btn-primary) { min-width:72px; }
  }
  .mr-types {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    max-width: 816px;
    margin: 0 auto 20px;
  }
  .mr-type {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 10px;
    border: 1px solid var(--mr-rule);
    border-radius: 6px;
    background: #fff;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .mr-type:hover {
    border-color: var(--mr-rose);
  }
  .mr-type[aria-pressed='true'] {
    border-color: var(--mr-rose-deep);
    background: var(--mr-rose-wash);
    box-shadow: inset 0 0 0 1px var(--mr-rose-deep);
  }
  .mr-type-label {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--mr-ink);
  }
  .mr-type-blurb {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--mr-soft);
  }
  .mr-chips {
    display: contents;
  }
  .mr-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0 auto 20px;
  }
  .mr-btn {
    min-height: 48px;
    padding: 0 24px;
    border: 1px solid var(--color-warm-button);
    border-radius: 3px;
    background: #fff;
    color: var(--color-warm-button);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .mr-btn:hover {
    background: var(--mr-rose-wash);
  }
  .mr-btn-primary {
    background: var(--color-warm-button);
    color: #fff;
  }
  .mr-btn-primary:hover {
    background: #362e2d;
  }
  .mr-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .mr-ideas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: 816px;
    margin: 0 auto 24px;
  }
  .mr-ideas-label {
    margin-right: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mr-soft);
  }
  .mr-chip {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--mr-rule);
    border-radius: 999px;
    background: #fff;
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: var(--mr-ink);
    cursor: pointer;
  }
  .mr-chip:hover {
    border-color: var(--mr-rose);
    background: var(--mr-rose-wash);
  }
  .mr-hint {
    flex-basis: 100%;
    font-size: 0.9rem;
    color: var(--mr-soft);
  }

  /* The sheet: US Letter portrait (8.5 × 11 in at 96 px/in). */
  .mr-sheet {
    display: flex;
    flex-direction: column;
    width: 816px;
    max-width: 100%;
    min-height: 1056px;
    margin: 0 auto;
    padding: 44px 52px 28px;
    background: var(--color-ivory);
    border: 1px solid var(--mr-rule);
    border-radius: 6px;
    box-shadow: 0 6px 24px rgba(77, 69, 68, 0.08);
    font-family: var(--font-serif);
  }
  .mr-sheet input {
    min-width: 0;
    border: none;
    border-radius: 3px;
    background: transparent;
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--mr-ink);
  }
  .mr-sheet input:focus {
    outline: none;
    background: var(--mr-rose-wash);
  }
  .mr-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 16px;
    margin-bottom: 22px;
    border-bottom: 2px solid var(--mr-rose);
  }
  .mr-sheet .mr-title {
    width: 100%;
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-align: center;
  }
  .mr-sheet .mr-subtitle {
    width: 100%;
    margin-top: 2px;
    font-size: 22px;
    font-style: italic;
    text-align: center;
    color: var(--mr-rose-deep);
  }
  .mr-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mr-step {
    display: grid;
    grid-template-columns: 40px 138px minmax(0, 1fr) 40px;
    gap: 14px;
    align-items: center;
    min-height: 74px;
    padding: 0 18px 0 14px;
    border: 1px solid var(--mr-rule);
    border-radius: 6px;
    background: #fff;
  }
  .mr-num {
    font-size: 30px;
    line-height: 1;
    text-align: center;
    color: var(--mr-rose);
  }
  .mr-sheet .mr-time {
    height: 40px;
    padding: 0 8px;
    background: var(--mr-sage-wash);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #5d6b55;
  }
  .mr-sheet .mr-text {
    height: 44px;
    padding: 0 6px;
    font-size: 22px;
  }
  .mr-what {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .mr-sheet .mr-note {
    height: 26px;
    padding: 0 6px;
    font-size: 15px;
    font-style: italic;
    color: var(--mr-soft);
  }
  .mr-sheet .mr-note::placeholder {
    color: #c4b8b2;
  }
  .mr-with-notes .mr-steps {
    gap: 9px;
  }
  .mr-with-notes .mr-step {
    min-height: 78px;
  }
  .mr-with-notes .mr-sheet .mr-text {
    height: 36px;
    font-size: 21px;
  }
  .mr-box {
    width: 36px;
    height: 36px;
    border: 2px solid var(--mr-rose);
    border-radius: 4px;
  }
  .mr-done {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 22px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .mr-done .mr-time {
    width: 140px;
  }
  .mr-sheet .mr-end-label {
    width: 240px;
    height: 40px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-align: right;
    text-transform: uppercase;
  }
  .mr-foot {
    margin-top: 18px;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
    color: #b3a7a1;
  }
  .mr-footnote {
    margin: 28px auto 0;
    text-align: center;
    font-size: 0.95rem;
    line-height: 2;
    color: var(--mr-soft);
  }

  .mr-customize-link { display:none; }
  @media (max-width:768px) {
    .mr-container:not(.mr-exporting) { display:flex; flex-direction:column; }
    .mr-container:not(.mr-exporting) .mr-types { order:1; }
    .mr-container:not(.mr-exporting) .mr-sheet { order:2; }
    .mr-container:not(.mr-exporting) .mr-actions { order:3; width:100%; margin-top:16px; }
    .mr-container:not(.mr-exporting) .mr-actions [data-mr-download] { width:100%; min-height:52px; }
    .mr-container:not(.mr-exporting) .mr-actions [data-mr-reset] { display:none; }
    .mr-container:not(.mr-exporting) .mr-customize-link { order:4; display:block; align-self:center; min-height:44px; background:transparent; border:0; text-decoration:underline; padding:8px 12px; color:var(--mr-ink); }
    .mr-container:not(.mr-exporting) .mr-palette-picker { order:5; display:none; }
    .mr-container:not(.mr-exporting) .mr-palette-picker.mr-advanced-open { display:block; }
    .mr-container:not(.mr-exporting) .mr-ideas { order:6; }
    .mr-container:not(.mr-exporting) .mr-ideas:not(.mr-ideas-open) { display:none; }
    .mr-container:not(.mr-exporting) .mr-footnote { order:7; }
  }
  /* Phones: smaller type, time above the step. The PNG is always the Letter layout. */
  @media (max-width: 768px) {
    .mr-types {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .mr-container:not(.mr-exporting) .mr-end-label {
      width: 150px;
      font-size: 11px;
    }
    .mr-container:not(.mr-exporting) .mr-sheet {
      min-height: 0;
      padding: 22px 12px;
    }
    .mr-container:not(.mr-exporting) .mr-title {
      font-size: 34px;
    }
    .mr-container:not(.mr-exporting) .mr-subtitle {
      font-size: 18px;
    }
    .mr-container:not(.mr-exporting) .mr-steps {
      gap: 8px;
    }
    .mr-container:not(.mr-exporting) .mr-step {
      grid-template-columns: 24px minmax(0, 1fr) 30px;
      grid-template-areas: 'num time box' 'num what box';
      gap: 2px 10px;
      padding: 8px 10px;
    }
    .mr-container:not(.mr-exporting) .mr-num {
      grid-area: num;
      font-size: 22px;
    }
    .mr-container:not(.mr-exporting) .mr-step .mr-time {
      grid-area: time;
      justify-self: start;
      height: 32px;
    }
    .mr-container:not(.mr-exporting) .mr-what {
      grid-area: what;
    }
    .mr-container:not(.mr-exporting) .mr-text {
      height: 36px;
      font-size: 18px;
    }
    .mr-container:not(.mr-exporting) .mr-box {
      grid-area: box;
      width: 28px;
      height: 28px;
    }
  }

  /* Same poster language as lunch station and chore chart. */
  .mr-sheet { --mr-accent-1: #EFEBE7; --mr-accent-2: #E6EEEA; --mr-accent-3: #F6F1E7; background: #fff; }
  .mr-head { border-bottom: 0; }
  .mr-sheet .mr-title { font-family: 'Kalam', var(--font-serif); font-weight: 700; letter-spacing: .04em; }
  .mr-step { border: 2px solid var(--mr-accent-1); border-radius: 14px; }
  .mr-step:nth-child(3n + 2) { border-color: var(--mr-accent-2); }
  .mr-step:nth-child(3n) { border-color: var(--mr-accent-3); }
  .mr-num { font-family: 'Kalam', var(--font-serif); font-weight: 700; color: var(--mr-ink); }
  .mr-sheet .mr-text { font-family: var(--font-sans); font-size: 20px; border-radius: 999px; background: linear-gradient(transparent 22%, var(--mr-accent-1) 22%, var(--mr-accent-1) 86%, transparent 86%); }
  .mr-step:nth-child(3n + 2) .mr-text { background: linear-gradient(transparent 22%, var(--mr-accent-2) 22%, var(--mr-accent-2) 86%, transparent 86%); }
  .mr-step:nth-child(3n) .mr-text { background: linear-gradient(transparent 22%, var(--mr-accent-3) 22%, var(--mr-accent-3) 86%, transparent 86%); }
  .mr-sheet .mr-time { background: var(--mr-accent-2); color: var(--mr-ink); border-radius: 8px; }
  .mr-box { border-color: #b6aaa4; border-radius: 6px; }
  .mr-sheet .mr-end-label { font-family: 'Kalam', var(--font-serif); font-size: 22px; font-weight: 700; text-transform: none; letter-spacing: .02em; }
  .mr-palette-picker { border: 0; padding: 0; margin: 0 auto 20px; text-align: center; }
  .mr-palette-picker legend { width: 100%; margin-bottom: 10px; font-size: .85rem; color: var(--mr-soft); }
  .mr-palette-options { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; }
  .mr-palette-option { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 10px 14px; border: 1px solid var(--mr-rule); border-radius: 10px; background: #fff; color: var(--mr-ink); font-size: .8rem; cursor: pointer; }
  .mr-palette-option[aria-pressed="true"] { border: 2px solid var(--mr-ink); padding: 9px 13px; background: var(--color-ivory); }
  .mr-palette-option:focus-visible { outline: 2px solid var(--mr-ink); outline-offset: 3px; }
  .mr-swatches { display: flex; gap: 3px; }
  .mr-swatches span { width: 15px; height: 15px; border: 1px solid #b8ada6; border-radius: 50%; }
  @media (max-width: 768px) {
    .mr-container:not(.mr-exporting) .mr-sheet .mr-text { font-size: 17px; }
    .mr-container:not(.mr-exporting) .mr-sheet .mr-end-label { font-size: 18px; }
  }

  /* Quiet editorial controls, distinct from the printed poster. */
  .mr-types { display: flex; flex-wrap: wrap; gap: 0 24px; border-bottom: 1px solid var(--mr-rule); padding-bottom: 0; }
  .mr-type { flex: 0 1 auto; min-height: 48px; padding: 10px 0 12px; border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; box-shadow: none; text-align: left; }
  .mr-type:hover { border-color: var(--mr-soft); }
  .mr-type[aria-pressed='true'] { border-color: var(--mr-ink); background: transparent; box-shadow: none; }
  .mr-type-label { font-size: 1rem; }
  .mr-type[aria-pressed='true'] .mr-type-label { font-weight: 700; }
  .mr-type-blurb { display: none; }
  .mr-palette-picker { text-align: left; max-width: 816px; margin-bottom: 24px; }
  .mr-palette-picker legend { font-size: .8rem; margin-bottom: 2px; }
  .mr-palette-options { justify-content: flex-start; gap: 6px 24px; }
  .mr-palette-option { padding: 8px 0; border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; }
  .mr-palette-option[aria-pressed='true'] { padding: 8px 0; border: 0; border-bottom: 2px solid var(--mr-ink); background: transparent; }
  .mr-palette-option:hover { color: #211b19; }
  .mr-palette-option[aria-pressed='true'] > span:last-child { font-weight: 600; }
  .mr-actions { justify-content: flex-start; align-items: center; max-width: 816px; margin-left: auto; margin-right: auto; gap: 24px; }
  .mr-btn { border: 0; border-radius: 3px; background: transparent; font-size: .9rem; letter-spacing: 0; text-transform: none; }
  .mr-btn:not(.mr-btn-primary) { padding: 0; text-decoration: underline; text-underline-offset: 4px; }
  .mr-btn-primary { background: var(--color-warm-button); }
  .mr-btn:not(.mr-btn-primary):hover { background: transparent; color: #211b19; }
  .mr-chip { min-height: 44px; padding: 6px 0; margin-right: 12px; border: 0; border-radius: 0; background: transparent; font-family: var(--font-sans); font-size: .8rem; text-decoration: underline; text-decoration-color: var(--mr-rule); text-underline-offset: 4px; }
  .mr-chip:hover { background: transparent; text-decoration-color: var(--mr-ink); }
  .mr-type:focus-visible, .mr-chip:focus-visible, .mr-btn:focus-visible { outline: 2px solid var(--mr-ink); outline-offset: 4px; }

  /* Illustrated steps from the responsibility library: an icon column once any step has one, tinted by category.
     Reorder arrows show on screen only, never in the PNG. */
  .mr-step { grid-template-columns: 40px 138px minmax(0, 1fr) 40px 32px; }
  .mr-sheet.mr-has-icons .mr-step { grid-template-columns: 40px 138px 60px minmax(0, 1fr) 40px 32px; }

---
/**
 * Top bar on every public page with chrome, linking to the calendar's buy section. Copy and
 * phases (announce, Christmas order cutoff, days to the new year, gone) are in src/lib/countdown.ts.
 * The site is static, so the copy is set at build time and refreshed in the browser on load.
 */
import { routes } from '../../routes';
import { countdownCopy } from '../../lib/countdown';

const copy = countdownCopy(new Date());
---

{
  copy && (
    <a
      href={routes.buy}
      data-cta="countdown-bar"
      data-countdown
      class="flex min-h-10 items-center justify-center gap-2 bg-warm-button px-4 py-2 text-center text-[0.68rem] font-semibold tracking-[0.18em] text-paper uppercase hover:underline"
    >
      <span data-countdown-count hidden={!copy.count} class="text-[0.9rem] tracking-normal tabular-nums">{copy.count}</span>
      <span data-countdown-text>{copy.text}</span>
    </a>
  )
}

<script>
  import { countdownCopy } from '../../lib/countdown';

  const bar = document.querySelector<HTMLElement>('[data-countdown]');
  if (bar) {
    const copy = countdownCopy(new Date());
    if (!copy) bar.remove();
    else {
      const count = bar.querySelector<HTMLElement>('[data-countdown-count]')!;
      count.textContent = copy.count ?? '';
      count.hidden = !copy.count;
      bar.querySelector('[data-countdown-text]')!.textContent = copy.text;
    }
  }
</script>

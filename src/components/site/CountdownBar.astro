---
import { clubPrintMessages } from '../../lib/club-print-deadline';
const onClub = Astro.url.pathname.replace(/\/$/, '') === '/club';
const href = onClub ? '#offer' : '/club';
const messages = clubPrintMessages();
---
<div class="club-announcement" data-club-announcement>
 <a href={href} data-cta="club-deadline-bar"><span data-club-announcement-text>{messages[0]}</span></a>
</div>
<script>
 import { clubPrintMessages } from '../../lib/club-print-deadline';
 document.querySelectorAll<HTMLElement>('[data-club-announcement]').forEach(bar => {
  const label = bar.querySelector<HTMLElement>('[data-club-announcement-text]')!;
  let index = 0, hovering = false, focused = false;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const render = () => { label.textContent = clubPrintMessages()[index]; };
  render();
  bar.addEventListener('mouseenter', () => { hovering = true; });
  bar.addEventListener('mouseleave', () => { hovering = false; });
  bar.addEventListener('focusin', () => { focused = true; });
  bar.addEventListener('focusout', event => { focused = bar.contains(event.relatedTarget as Node); });
  const rotation = window.setInterval(() => {
   if (hovering || focused || document.hidden || reducedMotion.matches) return;
   index = 1 - index; render();
  }, 8000);
  const refresh = window.setInterval(render, 30000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) render(); });
  document.addEventListener('astro:before-swap', () => { clearInterval(rotation); clearInterval(refresh); }, { once: true });
 });
</script>
<style>
.club-announcement { display: flex; align-items: center; justify-content: center; background: #545454; color: #fff; min-height: 44px; padding: 0 12px; }
.club-announcement a { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 12px; text-align: center; font-size: .76rem; font-weight: 600; line-height: 1.5; letter-spacing: .02em; color: inherit; text-decoration: none; }
.club-announcement a:hover { text-decoration: underline; text-underline-offset: 3px; }
.club-announcement :focus-visible { outline: 2px solid #fff; outline-offset: -3px; }
@media(max-width:600px) { .club-announcement { padding: 0 6px; } .club-announcement a { font-size: .66rem; padding-inline: 4px; } }
</style>

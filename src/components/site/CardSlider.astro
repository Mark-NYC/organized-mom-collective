---
/**
 * A swipeable row of photo cards, each with its caption underneath. Native scroll-snap
 * does the sliding (touch, trackpad, keyboard); the script only adds the extras: arrows
 * that show on hover from md up, and dots under the slider below md. Without JS it's
 * still a scrollable, snapping row.
 */
interface Item {
  src: string;
  srcset: string;
  /** Opened by a tap on the photo. */
  largest: string;
  width: number;
  height: number;
  alt: string;
  title: string;
  body: string;
  /** Short feature tags shown under the caption. */
  points?: string[];
}
interface Props {
  items: Item[];
  /** Accessible name for the carousel. */
  label: string;
  class?: string;
}
const { items, label, class: className } = Astro.props;
const arrow = { prev: 'M12.5 4.5 7 10l5.5 5.5', next: 'M7.5 4.5 13 10l-5.5 5.5' };
---

<div class:list={['group/slider relative', className]} data-card-slider>
  <ul
    class="-mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto overscroll-x-contain px-5 pb-1 [scrollbar-width:none] sm:mx-0 sm:scroll-px-0 sm:gap-6 sm:px-0 [&::-webkit-scrollbar]:hidden"
    aria-roledescription="carousel"
    aria-label={label}
    tabindex="0"
    data-track
  >
    {
      items.map((item, i) => (
        <li
          class="flex w-[86%] shrink-0 snap-start flex-col sm:w-[calc((100%-1.5rem)/2)]"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${items.length}: ${item.title}`}
          data-slide
        >
          <a href={item.largest} class="block overflow-hidden border border-rule bg-band" aria-label={`Open larger photo: ${item.alt}`} data-media>
            <img
              src={item.src}
              srcset={item.srcset}
              sizes="(min-width: 1152px) 532px, (min-width: 640px) 46vw, 86vw"
              width={item.width}
              height={item.height}
              loading="lazy"
              decoding="async"
              alt={item.alt}
              draggable="false"
              class="block aspect-square h-auto w-full object-cover"
            />
          </a>
          <div class="pt-5 pr-2">
            <h3 class="text-[1.125rem] leading-snug font-bold sm:text-[1.2rem]">{item.title}</h3>
            <p class="mt-1.5 text-[1rem] leading-snug text-soft">{item.body}</p>
            {item.points && (
              <ul class="mt-3.5 flex flex-wrap gap-1.5" aria-label="Features">
                {item.points.map((pt) => (
                  <li class="rounded-full border border-rule px-2.5 py-1 text-[0.72rem] leading-none font-semibold tracking-[0.08em] text-muted uppercase">{pt}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  {
    (['prev', 'next'] as const).map((dir) => (
      <button
        type="button"
        class:list={[
          'absolute top-[var(--arrow-top,40%)] z-10 hidden size-11 -translate-y-1/2 place-items-center rounded-full border border-rule bg-paper text-ink shadow-sm transition-opacity duration-200 hover:border-ink focus-visible:opacity-100 disabled:pointer-events-none disabled:!opacity-0 md:grid md:opacity-0 md:group-hover/slider:opacity-100',
          dir === 'prev' ? '-left-5' : '-right-5',
        ]}
        aria-label={dir === 'prev' ? 'Previous photo' : 'Next photo'}
        data-dir={dir}
      >
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d={arrow[dir]} />
        </svg>
      </button>
    ))
  }

  <div class="mt-5 flex justify-center gap-1 md:hidden" data-dots>
    {
      items.map((item, i) => (
        <button type="button" class="group/dot grid size-6 place-items-center" aria-label={`Go to ${item.title}`} aria-current={i === 0 ? 'true' : undefined} data-dot={i}>
          <span class="block size-2 rounded-full bg-rule transition-colors group-aria-[current=true]/dot:bg-ink" />
        </button>
      ))
    }
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-card-slider]')) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.querySelectorAll<HTMLElement>('[data-slide]')];
    const media = track.querySelector<HTMLElement>('[data-media]');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-dir="prev"]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-dir="next"]')!;

    const step = () => (slides[1]?.offsetLeft ?? 0) - slides[0].offsetLeft || track.clientWidth;
    const go = (left: number) => track.scrollTo({ left, behavior: reduce.matches ? 'auto' : 'smooth' });

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      // At the far end the last slide may never reach the snap start, so the end counts as the last dot.
      const index = track.scrollLeft >= max - 2 ? slides.length - 1 : Math.round(track.scrollLeft / step());
      dots.forEach((d, i) => (i === index ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
      // Center the arrows on the photos, not on photo + caption.
      if (media) root.style.setProperty('--arrow-top', `${media.offsetHeight / 2}px`);
    };

    prev.addEventListener('click', () => go(track.scrollLeft - step()));
    next.addEventListener('click', () => go(track.scrollLeft + step()));
    dots.forEach((d, i) => d.addEventListener('click', () => go(slides[i].offsetLeft - slides[0].offsetLeft)));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

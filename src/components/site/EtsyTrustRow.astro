---
/**
 * The Weekly Reset pages' trust row: the Etsy shop's figures (src/data/weekly-reset.ts → etsyStats),
 * linking to the shop.
 */
import { etsyStats } from '../../data/weekly-reset';
import { ETSY_SHOP_URL } from '../../data/reviews';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a
  href={ETSY_SHOP_URL}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'inline-grid max-w-full grid-cols-3 items-center divide-x divide-warm-rule border-y border-warm-rule py-3 text-warm-ink',
    className,
  ]}
>
  <span class="min-w-0 px-2 text-center leading-tight sm:px-6">
    <strong class="block font-serif text-[1.6rem] font-normal">{etsyStats.sales}</strong>
    <span class="text-[0.72rem] sm:text-[0.85rem]">Shop sales</span>
  </span>
  <span class="min-w-0 px-2 text-center leading-tight sm:px-6">
    <strong class="block font-serif text-[1.6rem] font-normal"><span aria-hidden="true" class="text-[0.8em] text-[#e8a33d]">★</span> {etsyStats.rating}</strong>
    <span class="text-[0.72rem] sm:text-[0.85rem]">({etsyStats.reviews}) Shop reviews</span>
  </span>
  <span class="min-w-0 px-2 text-center leading-tight sm:px-6">
    <strong class="block font-serif text-[1.6rem] font-normal text-[#f1641e]">Etsy</strong>
    <span class="text-[0.72rem] sm:text-[0.85rem]">{etsyStats.badge}</span>
  </span>
  <span class="sr-only"> (opens our Etsy shop; figures reflect earlier calendar editions, not this bundle)</span>
</a>

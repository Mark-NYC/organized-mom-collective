---
/**
 * The Family Packing & Independence Builder (markup, styles, printouts): where you're going, who's going, how long
 * (and, only when they matter, a few details); then a list for each person ("I can pack myself" and "A grown-up helps
 * with" for children), a short shared list with owners, and Pack, Check, Unpack. Everything can be changed: reword,
 * reorder, move between sections, remove, add, reassign. Lists can be saved on this device and opened again. Prints
 * on US Letter (8.5 × 11 in at 96 px/in, drawn at 2×): one page per person and one for the shared list, everyone's
 * or one at a time. Not a trip planner: where and when go on the wall calendar. Items and rules: src/data/packing.ts.
 * Behavior: packing-builder.ts beside it (today the Club's /club/tools/packing; a public page can host the same
 * component without a handoff). Classes are prefixed `pk-`. Saves in this browser under `storageKey`.
 */
import '@fontsource/kalam/latin-700.css';
import { toolPalettes, defaultToolPalette } from '../../data/tool-palettes';
import { lengthOptions, outingOptions, prefOptions } from '../../data/packing';
import HelpersEditor from './HelpersEditor.astro';

interface Props {
  storageKey: string;
  /** Opened for a family by another page (src/lib/tool-handoff.ts): its own saved lists, the family as people, the outing she chose. */
  handoff?: boolean;
  brand?: string;
}
const { storageKey, handoff = false, brand = 'Organized Mom Collective' } = Astro.props;

/** Fine-line marks for the outing buttons (24 × 24), in the site's line style. */
const outingIcon: Record<string, string> = {
  camp: '<path d="M3 20 12 5l9 15Z"/><path d="M12 5v15M9 20l3-5 3 5"/>',
  pool: '<path d="M2 15c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 19c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"/><circle cx="17" cy="6" r="2.5"/>',
  roadtrip: '<path d="M4 15V11l2-5h12l2 5v4Z"/><circle cx="8" cy="16" r="1.8"/><circle cx="16" cy="16" r="1.8"/><path d="M4 11h16"/>',
  vacation: '<rect x="4" y="7" width="16" height="12" rx="2"/><path d="M9 7V5h6v2M4 12h16"/>',
  day: '<circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>',
  sleepover: '<path d="M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5Z"/>',
  custom: '<circle cx="12" cy="12" r="8"/><path d="M12 8v8M8 12h8"/>',
};
---

<div class="pk" data-pk-key={storageKey} data-pk-handoff={handoff ? '' : undefined} data-pk-brand={brand}>
  <div class="pk-saved" data-pk-saved-box>
    <label class="pk-field pk-saved-pick"><span>Your saved lists</span><select data-pk-saved></select></label>
    <button type="button" class="pk-link" data-pk-open>Open</button>
    <p class="pk-q-note">Saved on this device only, in this browser.</p>
  </div>

  <form class="pk-form">
    <fieldset class="pk-q">
      <legend><span class="pk-n">1</span> Where are you going?</legend>
      <div class="pk-outings">
        {outingOptions.map((o) => (
          <button type="button" class="pk-outing" data-pk-outing={o.id} aria-pressed={o.id === 'pool' ? 'true' : 'false'}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={outingIcon[o.id]} />
            <span>{o.label}</span>
          </button>
        ))}
      </div>
    </fieldset>
    <fieldset class="pk-q">
      <legend><span class="pk-n">2</span> Who’s going?</legend>
      <p class="pk-q-note" data-pk-people-note>Add everyone going on this outing. Remove anyone who’s staying home.</p>
      <HelpersEditor />
    </fieldset>
    <fieldset class="pk-q">
      <legend><span class="pk-n">3</span> How long?</legend>
      <div class="pk-options">
        {lengthOptions.map((l) => <button type="button" class="pk-option" data-pk-length={l.id} aria-pressed={l.id === 'hours' ? 'true' : 'false'}>{l.label}</button>)}
      </div>
      <label class="pk-field pk-nights" data-pk-nights-box hidden><span>How many nights?</span><input type="number" min="1" max="21" value="3" data-pk-nights /></label>
      <div class="pk-prefs" data-pk-prefs-box>
        <span class="pk-prefs-label">Only if it applies</span>
        {prefOptions.map((p) => <label class="pk-check" data-pk-pref-box={p.id}><input type="checkbox" data-pk-pref={p.id} /> {p.label}</label>)}
      </div>
    </fieldset>
  </form>

  <section class="pk-plan" aria-labelledby="pk-plan-h">
    <h2 id="pk-plan-h" class="pk-title">Your packing lists</h2>
    <ol class="pk-pcu" aria-label="Pack, Check, Unpack">
      <li><strong>Pack</strong> Gather your things.</li>
      <li><strong>Check</strong> Make sure you have what you need.</li>
      <li><strong>Unpack</strong> Put everything away when you get home.</li>
    </ol>
    <div data-pk-lists></div>
    <div class="pk-plan-tools">
      <button type="button" class="pk-link" data-pk-fresh>New suggestions (keeps your changes)</button>
    </div>
    <div class="pk-save">
      <label class="pk-field"><span>Save this list to use again</span><input type="text" data-pk-save-name maxlength="40" /></label>
      <button type="button" class="pk-btn" data-pk-save>Save list</button>
    </div>
    <p class="pk-status" data-pk-status role="status" aria-live="polite"></p>
  </section>

  <section class="pk-out" aria-labelledby="pk-out-h">
    <h2 id="pk-out-h" class="pk-title">Print the lists</h2>
    <p class="pk-q-note">One page each, so everyone can carry their own while they pack.</p>
    <label class="pk-field"><span>Print</span><select data-pk-print-for></select></label>
    <fieldset class="pk-palette">
      <legend>Choose your colors</legend>
      <div class="pk-palette-options">
        {Object.entries(toolPalettes).map(([id, palette]) => (
          <button type="button" class="pk-palette-option" data-pk-palette={id} aria-pressed={id === defaultToolPalette ? 'true' : 'false'}>
            <span class="pk-swatches" aria-hidden="true">{palette.colors.map((color) => <span style={{ backgroundColor: color }} />)}</span>
            <span>{palette.label}</span>
          </button>
        ))}
      </div>
    </fieldset>
    <div class="pk-buttons">
      <button type="button" class="pk-btn pk-btn-primary" data-pk-download>Download</button>
      <button type="button" class="pk-btn" data-pk-copy>Copy as text</button>
    </div>
    <textarea class="pk-copy-fallback" data-pk-copy-fallback readonly rows="12" hidden aria-label="Your lists as text"></textarea>
    <div class="pk-sheets" data-pk-sheets></div>
  </section>
  <slot name="footnote" />
</div>

<style is:global>
  .pk {
    --pk-ink: var(--color-warm-ink);
    --pk-soft: var(--color-warm-soft);
    --pk-rule: var(--color-warm-rule);
    --pk-a1: #EFEBE7; --pk-a2: #E6EEEA; --pk-a3: #F6F1E7;
    max-width: 816px;
    margin: 0 auto;
    padding: 8px 20px 40px;
    color: var(--pk-ink);
  }
  .pk *, .pk *::before, .pk *::after { box-sizing: border-box; }
  .pk [hidden] { display: none !important; }
  .pk-saved { display: flex; flex-wrap: wrap; align-items: end; gap: 4px 14px; margin-bottom: 18px; padding: 10px 14px; background: #fff; border: 1px solid var(--pk-rule); }
  .pk-saved .pk-q-note { flex-basis: 100%; margin: 0; }
  .pk-form { display: grid; gap: 22px; }
  .pk-q { margin: 0; padding: 0; border: 0; min-width: 0; }
  .pk-q legend { padding: 0; font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.3; }
  .pk-n { display: inline-grid; place-items: center; width: 26px; height: 26px; margin-right: 6px; border-radius: 50%; background: #eaf0f4; box-shadow: inset 0 0 0 1px #8fa7b8; font-size: 0.9rem; vertical-align: 2px; }
  .pk-q-note { margin: 4px 0 0; font-size: 0.88rem; color: var(--pk-soft); }
  .pk-outings { display: grid; grid-template-columns: repeat(auto-fill, minmax(7.4rem, 1fr)); gap: 8px; margin-top: 8px; }
  .pk-outing { display: grid; justify-items: center; gap: 4px; min-height: 76px; padding: 10px 6px; border: 1px solid var(--pk-rule); border-radius: 8px; background: #fff; font-family: var(--font-serif); font-size: 0.92rem; line-height: 1.2; color: var(--pk-soft); cursor: pointer; }
  .pk-outing svg { width: 26px; height: 26px; color: #6f8a72; }
  .pk-outing[aria-pressed='true'] { border: 2px solid var(--pk-ink); padding: 9px 5px; color: var(--pk-ink); font-weight: 600; background: #fbf7f2; }
  .pk-options { display: flex; flex-wrap: wrap; gap: 0 20px; margin-top: 4px; }
  .pk-option { min-height: 44px; padding: 8px 0; border: 0; border-bottom: 2px solid transparent; background: transparent; font-family: var(--font-serif); font-size: 1rem; color: var(--pk-soft); cursor: pointer; }
  .pk-option[aria-pressed='true'] { border-bottom-color: var(--pk-ink); color: var(--pk-ink); font-weight: 600; }
  .pk-field { display: grid; gap: 6px; max-width: 360px; margin-top: 10px; }
  .pk-field > span, .pk-palette legend, .pk-prefs-label, .pk-person h4, .pk-shared h4 { font-family: var(--font-sans); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--pk-soft); }
  .pk-field input, .pk-field select, .pk-row input[type='text'], .pk-row select, .pk-add input, .pk-add select { min-width: 0; min-height: 44px; padding: 0 10px; border: 1px solid var(--pk-rule); border-radius: 3px; background: #fff; font-family: var(--font-serif); font-size: 1rem; color: var(--pk-ink); }
  .pk-nights { max-width: 180px; }
  .pk-prefs { display: flex; flex-wrap: wrap; gap: 0 18px; margin-top: 10px; }
  .pk-prefs-label { flex-basis: 100%; }
  .pk-check { display: flex; align-items: center; gap: 10px; min-height: 44px; font-size: 0.95rem; }
  .pk-check input { flex: none; width: 20px; height: 20px; accent-color: #7d917c; }
  .pk-link { min-height: 44px; padding: 0; border: 0; background: none; font-size: 0.9rem; font-weight: 600; color: var(--pk-ink); text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .pk-x, .pk-mv { width: 40px; min-height: 40px; border: 0; background: none; font-size: 1.2rem; line-height: 1; color: var(--pk-soft); cursor: pointer; }
  .pk-x { font-size: 1.4rem; }
  .pk-mv:disabled { opacity: 0.25; cursor: default; }
  .pk-swap { min-height: 40px; padding: 0 2px; border: 0; background: none; font-size: 0.78rem; font-weight: 600; color: #5d7383; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; white-space: nowrap; }
  .pk-outing:focus-visible, .pk-option:focus-visible, .pk-link:focus-visible, .pk-x:focus-visible, .pk-mv:focus-visible, .pk-swap:focus-visible, .pk-btn:focus-visible, .pk-palette-option:focus-visible { outline: 2px solid var(--pk-ink); outline-offset: 3px; }

  .pk-plan, .pk-out { margin-top: 30px; }
  .pk-title { font-family: var(--font-serif); font-size: 1.45rem; font-weight: 400; line-height: 1.2; }
  .pk-pcu { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 10px 0 0; padding: 0; list-style: none; }
  .pk-pcu li { padding: 10px 12px; background: #eef3f6; font-size: 0.86rem; line-height: 1.35; }
  .pk-pcu li:nth-child(2) { background: #eef1eb; }
  .pk-pcu li:nth-child(3) { background: #f8eee5; }
  .pk-pcu strong { display: block; font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .pk-person, .pk-shared { margin-top: 16px; background: #fff; border: 1px solid var(--pk-rule); border-top: 3px solid #9aab8f; padding: 12px 14px; }
  .pk-shared { border-top-color: #8fa7b8; }
  .pk-person h3, .pk-shared h3 { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 400; }
  .pk-person h4, .pk-shared h4 { margin-top: 12px; }
  .pk-person-note { margin-top: 2px; font-size: 0.84rem; color: var(--pk-soft); }
  .pk-rows { display: grid; gap: 4px; margin: 6px 0 0; padding: 0; list-style: none; }
  .pk-row { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto 40px 40px 40px; gap: 4px; align-items: center; }
  .pk-shared .pk-row { grid-template-columns: 26px minmax(0, 1fr) minmax(7rem, 10rem) 40px; }
  .pk-row > input[type='checkbox'] { width: 20px; height: 20px; accent-color: #7d917c; }
  .pk-row.is-done input[type='text'] { color: var(--pk-soft); text-decoration: line-through; }
  .pk-row-note { grid-column: 2 / -1; margin-top: -2px; font-size: 0.78rem; color: var(--pk-soft); }
  .pk-add { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px; margin-top: 8px; }
  .pk-shared .pk-add { grid-template-columns: minmax(0, 1fr) minmax(7rem, 10rem) auto; }
  @media (max-width: 600px) {
    .pk-pcu { grid-template-columns: 1fr; }
    .pk-row { grid-template-columns: 26px minmax(0, 1fr) 30px 30px 34px; gap: 2px 4px; }
    .pk-row > input[type='checkbox'] { grid-row: 1; grid-column: 1; }
    .pk-row > input[type='text'] { grid-row: 1; grid-column: 2; }
    .pk-row > .pk-mv, .pk-row > .pk-x { grid-row: 1; width: 30px; }
    .pk-row > span:empty { display: none; }
    .pk-row > .pk-swap { grid-column: 2; grid-row: 2; justify-self: start; min-height: 32px; }
    .pk-shared .pk-row { grid-template-columns: 26px minmax(0, 1fr) 40px; }
    .pk-shared .pk-row > input[type='text'] { grid-column: 2; }
    .pk-shared .pk-row > select { grid-column: 2; grid-row: 2; }
    .pk-shared .pk-row > .pk-x { grid-column: 3; grid-row: 1; }
    .pk-shared .pk-add { grid-template-columns: minmax(0, 1fr) auto; }
    .pk-shared .pk-add input { grid-column: 1 / -1; }
  }
  .pk-plan-tools { margin-top: 10px; }
  .pk-save { display: flex; flex-wrap: wrap; align-items: end; gap: 10px; margin-top: 8px; }
  .pk-status { min-height: 1.4em; margin-top: 6px; font-size: 0.92rem; color: var(--pk-soft); }

  .pk-palette { margin: 14px 0 0; padding: 0; border: 0; }
  .pk-palette-options { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .pk-palette-option { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 0; border: 0; border-bottom: 2px solid transparent; background: transparent; font-size: 0.85rem; color: var(--pk-ink); cursor: pointer; }
  .pk-palette-option[aria-pressed='true'] { border-bottom-color: var(--pk-ink); font-weight: 600; }
  .pk-swatches { display: flex; }
  .pk-swatches span { width: 16px; height: 16px; margin-right: -4px; border: 1px solid rgba(77, 69, 68, 0.15); border-radius: 50%; }
  .pk-buttons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 14px; }
  .pk-btn { min-height: 48px; padding: 0 22px; border: 1px solid var(--color-warm-button); border-radius: 3px; background: #fff; color: var(--color-warm-button); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; }
  .pk-btn-primary { background: var(--color-warm-button); color: #fff; }
  .pk-btn:disabled { opacity: 0.6; cursor: wait; }
  .pk-copy-fallback { display: block; width: 100%; margin-top: 10px; padding: 8px; border: 1px solid var(--pk-rule); font-family: ui-monospace, monospace; font-size: 0.82rem; }

  /* The printouts: US Letter portrait, one per person and one shared, scaled to fit a phone on screen. Grayscale-safe:
     every box and line has a dark edge, never color alone. */
  .pk-sheets { display: grid; gap: 16px; margin-top: 16px; }
  .pk-sheet-wrap { overflow: hidden; }
  .pk-sheet { display: flex; flex-direction: column; width: 816px; height: 1056px; padding: 48px 60px 36px; background: #fff; border: 1px solid var(--pk-rule); box-shadow: 0 6px 24px rgba(77, 69, 68, 0.08); font-family: var(--font-serif); color: #3d3834; transform-origin: top left; }
  .pk-sheet-kicker { text-align: center; font-family: var(--font-sans); font-size: 12px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: #6b625c; }
  .pk-sheet-title { margin-top: 4px; text-align: center; font-family: 'Kalam', var(--font-serif); font-size: 42px; font-weight: 700; line-height: 1.1; }
  .pk-swipe { padding: 0 14px; background: linear-gradient(transparent 52%, var(--pk-a1) 52%, var(--pk-a1) 92%, transparent 92%); }
  .pk-sheet-pcu { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 16px; }
  .pk-sheet-pcu div { padding: 8px 12px; border: 1.5px solid #8a807a; border-radius: 8px; font-size: 13px; line-height: 1.3; }
  .pk-sheet-pcu strong { display: block; font-family: var(--font-sans); font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; }
  .pk-sheet-head { margin-top: 18px; padding: 6px 12px; background: var(--pk-a2); border-radius: 8px; font-family: var(--font-sans); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .pk-sheet-head.is-help { background: var(--pk-a3); }
  .pk-sheet-row { display: grid; grid-template-columns: 30px 36px 1fr; gap: 12px; align-items: center; padding: 7px 8px; border-bottom: 1px solid #ddd5cd; font-size: 17px; line-height: 1.25; }
  .pk-sheet-box { width: 26px; height: 26px; border: 2px solid #6b625c; border-radius: 5px; background: #fff; }
  .pk-sheet-art { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
  .pk-sheet-dot { display: block; width: 36px; height: 36px; }
  .pk-sheet.is-young .pk-sheet-row { grid-template-columns: 38px 64px 1fr; padding: 9px 8px; font-size: 24px; font-family: var(--font-sans); }
  .pk-sheet.is-young .pk-sheet-box { width: 34px; height: 34px; border-width: 2.5px; }
  .pk-sheet.is-young .pk-sheet-art, .pk-sheet.is-young .pk-sheet-dot { width: 64px; height: 64px; }
  .pk-sheet-owner { font-family: 'Kalam', var(--font-serif); font-size: 18px; font-weight: 700; text-align: right; }
  .pk-sheet-row.has-owner { grid-template-columns: 30px 1fr 180px; }
  .pk-sheet-notes { margin-top: 18px; font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #6b625c; }
  .pk-sheet-line { height: 30px; border-bottom: 1px solid #b9b0a8; }
  .pk-sheet-foot { margin-top: auto; padding-top: 14px; text-align: center; }
  .pk-sheet-cal { font-size: 14px; font-style: italic; color: #5c5550; }
  .pk-sheet-brand { margin-top: 10px; font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #8a807a; }
  .pk-sheets.is-compact .pk-sheet-row { padding: 4px 8px; font-size: 15.5px; }
  .pk-exporting .pk-sheet { transform: none !important; box-shadow: none; border: 0; }
</style>

<script>
  import { initPackingBuilder } from './packing-builder';
  import { readToolHandoff } from '../../lib/tool-handoff';

  for (const host of document.querySelectorAll<HTMLElement>('.pk')) {
    initPackingBuilder(host, host.hasAttribute('data-pk-handoff') ? readToolHandoff('packing') : null);
  }
</script>

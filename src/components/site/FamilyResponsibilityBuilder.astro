---
import { responsibilities } from '../../data/responsibilities';
import { choreLineIcon } from '../../data/chore-line-icons';
import { routineIconChoices, routineIconById } from '../../data/routine-line-icons';
const library = [
  ...responsibilities.map(r => ({id:r.id,title:r.title,minAge:r.minAge,category:r.category,src:choreLineIcon(r.id)})),
  ...routineIconChoices.map(r => ({id:r.id,title:r.title,minAge:3,category:'routine',src:routineIconById(r.id)})),
];
---
<div class="frb" data-frb>
  <div class="frb-intro"><span class="frb-kicker">MAKE IT YOURS</span><h2>Build your family responsibility chart</h2><p>Add your family, assign real ownership, and print one chart everyone can see.</p></div>
  <div class="frb-workspace">
    <div class="frb-controls">
      <section class="frb-panel" aria-labelledby="frb-family-heading">
        <div class="frb-panel-heading"><span class="frb-step">01</span><div><h3 id="frb-family-heading">Who's on your team?</h3><p>Include parents, too. Edit the names and ages.</p></div></div>
        <div class="frb-members" data-frb-members></div>
        <button type="button" class="frb-add" data-frb-add-person>+ Add family member</button>
      </section>
      <section class="frb-panel" aria-labelledby="frb-assign-heading">
        <div class="frb-panel-heading"><span class="frb-step">02</span><div><h3 id="frb-assign-heading">Give every job an owner</h3><p>Choose one person who makes sure it gets done.</p></div></div>
        <div class="frb-assignments" data-frb-assignments></div>
        <div class="frb-task-add"><input type="text" data-frb-custom placeholder="Add a custom responsibility" aria-label="Custom responsibility" maxlength="56"/><button type="button" data-frb-add-custom>Add</button></div>
        <div class="frb-library-heading">Or choose an illustrated responsibility</div>
        <div class="frb-library" data-frb-library>
          {library.map(item=><button type="button" data-frb-library-item={item.id} data-frb-title={item.title} data-frb-age={item.minAge} title={item.title} class="frb-library-item">
            {item.src ? <img src={item.src} width="52" height="52" alt="" loading="lazy" decoding="async"/>:<span aria-hidden="true" class="frb-library-placeholder">✓</span>}
            <span>{item.title}</span>
          </button>)}
        </div>
        <p class="frb-message" data-frb-message role="status" aria-live="polite"></p>
      </section>
      <section class="frb-panel frb-summary-panel" aria-labelledby="frb-summary-heading">
        <div class="frb-panel-heading"><span class="frb-step">03</span><div><h3 id="frb-summary-heading">Check the ownership</h3><p>Spot unassigned jobs before you print.</p></div></div>
        <div data-frb-summary class="frb-summary"></div>
        <button type="button" data-frb-reset class="frb-reset">Reset to example family</button>
      </section>
    </div>
    <div class="frb-preview-wrap">
      <div class="frb-preview-label"><span>LIVE PREVIEW</span><p>Letter-size, ready for your fridge or family command center.</p></div>
      <div class="frb-paper-viewport">
        <div class="frb-paper" data-frb-paper>
          <div class="frb-paper-kicker">ORGANIZED MOM COLLECTIVE</div>
          <h2>Our Family, Our Team</h2>
          <p class="frb-paper-subtitle">Everyone has a part to play.</p>
          <div class="frb-paper-head"><span>RESPONSIBILITY</span><span>OWNER</span><span>WHEN</span></div>
          <div class="frb-paper-list" data-frb-print-rows></div>
          <div class="frb-paper-footer"><strong>We all help because this is our home.</strong><span>Organized moms raise organized families.</span></div>
        </div>
      </div>
      <button type="button" class="frb-download" data-frb-download>Download My Family Chart</button>
      <p class="frb-small">Saved automatically in this browser. Free printable PNG, US Letter size.</p>
    </div>
  </div>
</div>

<style is:global>
.frb{background:#FBF7F1;color:#545454;padding:28px 20px 56px;font-family:Montserrat,sans-serif}.frb *{box-sizing:border-box}
.frb-intro{max-width:1300px;margin:0 auto 24px}.frb-kicker,.frb-preview-label span{display:block;font-size:11px;font-weight:700;letter-spacing:.14em;color:#777}.frb-intro h2{font:400 clamp(25px,3vw,34px)/1.2 Georgia,serif;margin:8px 0}.frb-intro p{font-size:14px;color:#6c6c6c}
.frb-workspace{max-width:1370px;margin:0 auto;display:grid;grid-template-columns:minmax(330px,440px) minmax(0,816px);gap:24px;align-items:start;justify-content:center}
.frb-controls{display:grid;gap:16px;min-width:0}.frb-panel{background:#fff;border:1px solid #E6E0D7;border-radius:14px;padding:18px}.frb-panel-heading{display:flex;align-items:flex-start;gap:12px;margin-bottom:14px}.frb-step{background:#D4DFC4;color:#545454;border-radius:9px;padding:8px;font-size:12px;font-weight:700}.frb-panel h3{font:400 21px Georgia,serif;margin:0 0 5px}.frb-panel p{font-size:12px;color:#777;margin:0;line-height:1.5}
.frb-members,.frb-assignments{display:grid;gap:8px}.frb-member,.frb-assignment{display:grid;grid-template-columns:1fr 83px 27px;gap:6px;align-items:center}.frb-assignment{grid-template-columns:minmax(0,1fr) 105px 30px}.frb-member input,.frb-member select,.frb-assignment input,.frb-assignment select,.frb-task-add input{min-width:0;width:100%;height:39px;border:1px solid #E2DDD5;border-radius:8px;background:#FBF7F1;padding:7px;font:500 12px Montserrat,sans-serif;color:#545454}
.frb-member button,.frb-assignment button{border:0;background:transparent;color:#777;font-size:20px;cursor:pointer}.frb-add,.frb-task-add button{border:1px solid #C8D5BA;background:#D4DFC4;color:#545454;border-radius:9px;font:700 12px Montserrat,sans-serif;padding:11px 13px;cursor:pointer}.frb-add{margin-top:12px}
.frb-task-add{display:flex;gap:8px;margin:14px 0}.frb-task-add button{white-space:nowrap}.frb-library-heading{font-size:12px;font-weight:700;margin:16px 0 9px}.frb-library{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;max-height:330px;overflow-y:auto}.frb-library-item{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:5px;border:1px solid #E7E1D8;border-radius:9px;background:#fff;padding:8px 3px;cursor:pointer;color:#545454;min-height:100px}.frb-library-item:hover{background:#FBF7F1;border-color:#BBCBAB}.frb-library-item img{width:54px;height:54px;object-fit:contain;mix-blend-mode:multiply}.frb-library-item[data-frb-library-item="grocery-shopping"] img,.frb-library-item[data-frb-library-item="wake-up"] img{transform:scale(.7)}.frb-library-item span:last-child{text-align:center;font-size:10px;line-height:1.25}
.frb-message{min-height:1.5em;margin-top:8px!important}.frb-summary{display:grid;gap:7px}.frb-summary-line{display:flex;justify-content:space-between;gap:10px;font-size:12px;padding:7px 0;border-bottom:1px solid #EEEAE4}.frb-reset{margin-top:15px;border:0;background:transparent;color:#777;text-decoration:underline;cursor:pointer;font:500 12px Montserrat,sans-serif}
.frb-preview-wrap{min-width:0}.frb-preview-label{margin-bottom:12px}.frb-preview-label p{font-size:12px;color:#777;margin:4px 0}.frb-paper-viewport{width:100%;overflow:hidden}.frb-paper{width:816px;min-width:816px;height:1056px;margin:0;background:#fff;padding:51px 54px 40px;display:flex;flex-direction:column;box-shadow:0 8px 28px #3c352a16;border:1px solid #E6E0D7;border-radius:11px;font-family:Montserrat,sans-serif}
.frb-paper-kicker{text-align:center;font-size:10px;letter-spacing:.2em;font-weight:700;color:#87847e}.frb-paper h2{font:400 39px/1.2 Georgia,serif;text-align:center;margin:18px 0 7px;color:#545454}.frb-paper-subtitle{text-align:center;margin:0 0 28px;color:#777;font-size:15px}.frb-paper-head,.frb-print-row{display:grid;grid-template-columns:minmax(0,1fr) 145px 120px;gap:12px;align-items:center}.frb-paper-head{padding:12px 16px;border-bottom:2px solid #D4DFC4;color:#747474;font-size:11px;letter-spacing:.09em;font-weight:700}.frb-paper-list{display:flex;flex-direction:column;gap:9px;flex:1;margin-top:10px;justify-content:center}.frb-print-row{flex:1 1 0;max-height:98px;min-height:56px;border:1px solid #E6E0D7;background:#fff;border-radius:9px;padding:7px 12px}.frb-print-task{display:flex;align-items:center;gap:12px;min-width:0;font-size:16px;font-weight:500}.frb-print-task img{width:46px;height:46px;object-fit:contain;mix-blend-mode:multiply;flex:0 0 46px}.frb-print-task img[data-frb-small-art]{transform:scale(.7)}.frb-print-task span{overflow-wrap:anywhere}.frb-print-owner,.frb-print-when{font-size:13px;overflow-wrap:anywhere}.frb-print-owner{font-weight:700}.frb-print-unassigned{color:#A36D56}.frb-paper-footer{text-align:center;display:flex;flex-direction:column;gap:8px;margin-top:23px;color:#545454}.frb-paper-footer strong{font:italic 20px Georgia,serif}.frb-paper-footer span{font-size:10px;letter-spacing:.06em;color:#888}
.frb-download{display:block;margin:17px auto 0;border:0;border-radius:10px;min-height:53px;width:min(100%,390px);background:#545454;color:#fff;font:700 14px Montserrat,sans-serif;cursor:pointer}.frb-download:disabled{opacity:.6}.frb-small{text-align:center;font-size:11px;color:#777}
.frb input:focus-visible,.frb select:focus-visible,.frb button:focus-visible{outline:2px solid #9AB184;outline-offset:2px}
@media(max-width:1330px){.frb-workspace{grid-template-columns:minmax(300px,400px) minmax(0,1fr)}.frb-paper-viewport{height:900px}.frb-paper{transform:scale(.83);transform-origin:top left}}
@media(max-width:1070px){.frb-workspace{display:flex;flex-direction:column;align-items:stretch;max-width:816px}.frb-paper-viewport{height:1056px}.frb-paper{transform:none}}
@media(max-width:850px){.frb{padding:20px 12px 40px}.frb-panel{padding:13px}.frb-library{grid-template-columns:repeat(4,minmax(0,1fr))}.frb-paper-viewport{height:auto;aspect-ratio:816/1056}.frb-paper{transform:scale(var(--frb-scale,.65));transform-origin:top left}.frb-member{grid-template-columns:1fr 80px 27px}.frb-assignment{grid-template-columns:minmax(0,1fr) 90px 25px}.frb-intro h2{font-size:26px}}
.frb.frb-exporting .frb-paper{transform:none!important;border-radius:0;box-shadow:none}.frb.frb-exporting .frb-print-row{min-height:56px}
</style>

<script>
import { downloadPng } from '../../lib/printable';
type Person = {id:string;name:string;age:number|null};
type Task = {id:string;title:string;owner:string;when:string;icon:string};
type State = {people:Person[];tasks:Task[]};
const KEY='omc:family-responsibility-builder:v1';
const defaultState=():State=>({people:[{id:'mom',name:'Mom',age:null},{id:'dad',name:'Dad',age:null},{id:'child1',name:'Child 1',age:8},{id:'child2',name:'Child 2',age:6}],tasks:[
{id:'t1',title:'Wipe the Counters',owner:'mom',when:'Daily',icon:'wipe-the-counters'},
{id:'t2',title:'Take Out the Trash',owner:'dad',when:'Weekly',icon:'take-out-the-trash'},
{id:'t3',title:'Set the Table',owner:'child1',when:'Daily',icon:'set-the-table'},
{id:'t4',title:'Put Toys Away',owner:'child2',when:'Daily',icon:'put-toys-away'},
{id:'t5',title:'Plan the Week',owner:'',when:'Sunday',icon:'plan-the-week'}
]});
const icons: Record<string,string> = {
  ...Object.fromEntries([
    ...[...document.querySelectorAll<HTMLButtonElement>('[data-frb-library-item]')].map(el=>[el.dataset.frbLibraryItem!,el.querySelector('img')?.src??''])
  ])
};
let counter=0;
const nextId=()=>`frb-${Date.now().toString(36)}-${++counter}`;
const escapeText=(s:string)=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]??c));
for(const host of document.querySelectorAll<HTMLElement>('[data-frb]')){
  const memberNode=host.querySelector<HTMLElement>('[data-frb-members]')!;
  const taskNode=host.querySelector<HTMLElement>('[data-frb-assignments]')!;
  const printNode=host.querySelector<HTMLElement>('[data-frb-print-rows]')!;
  const summaryNode=host.querySelector<HTMLElement>('[data-frb-summary]')!;
  const message=host.querySelector<HTMLElement>('[data-frb-message]')!;
  const custom=host.querySelector<HTMLInputElement>('[data-frb-custom]')!;
  const paper=host.querySelector<HTMLElement>('[data-frb-paper]')!;
  let state:State=defaultState();
  try {
    const saved=JSON.parse(localStorage.getItem(KEY)??'null');
    if(saved && Array.isArray(saved.people) && Array.isArray(saved.tasks)) state={people:saved.people.slice(0,8),tasks:saved.tasks.slice(0,12)};
  } catch{}
  const persist=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch{}};
  const personName=(id:string)=>state.people.find(p=>p.id===id)?.name.trim()||'Unassigned';
  function renderMembers(){
    memberNode.innerHTML=state.people.map((p,i)=>`<div class="frb-member"><input data-frb-person-name="${escapeText(p.id)}" aria-label="Family member ${i+1} name" value="${escapeText(p.name)}" maxlength="22"/><select aria-label="Family member ${i+1} age" data-frb-person-age="${escapeText(p.id)}"><option value="">Adult</option>${Array.from({length:17},(_,n)=>`<option value="${n+2}" ${p.age===n+2?'selected':''}>${n+2}</option>`).join('')}</select><button type="button" data-frb-remove-person="${escapeText(p.id)}" aria-label="Remove family member">${state.people.length>1?'×':''}</button></div>`).join('');
  }
  function renderTasks(){
    taskNode.innerHTML=state.tasks.map((t,i)=>`<div class="frb-assignment"><input aria-label="Responsibility ${i+1}" maxlength="56" data-frb-task-title="${escapeText(t.id)}" value="${escapeText(t.title)}"/><select aria-label="Responsibility ${i+1} owner" data-frb-task-owner="${escapeText(t.id)}"><option value="">No owner</option>${state.people.map(p=>`<option value="${escapeText(p.id)}" ${t.owner===p.id?'selected':''}>${escapeText(p.name||'Unnamed')}</option>`).join('')}</select><button type="button" data-frb-remove-task="${escapeText(t.id)}" aria-label="Remove responsibility">×</button></div>`).join('');
  }
  function renderPaper(){
    printNode.innerHTML=state.tasks.filter(t=>t.title.trim()).map(t=>{
      const icon=icons[t.icon] || '';
      return `<div class="frb-print-row"><div class="frb-print-task">${icon?`<img src="${escapeText(icon)}" alt="" ${['grocery-shopping','wake-up'].includes(t.icon)?'data-frb-small-art':''}/>`:''}<span>${escapeText(t.title)}</span></div><span class="frb-print-owner ${t.owner?'':'frb-print-unassigned'}">${escapeText(personName(t.owner))}</span><span class="frb-print-when">${escapeText(t.when)}</span></div>`;
    }).join('');
    const count=state.tasks.filter(t=>t.title.trim()).length;
    const unassigned=state.tasks.filter(t=>t.title.trim()&&!state.people.some(p=>p.id===t.owner)).length;
    summaryNode.innerHTML=state.people.map(p=>`<div class="frb-summary-line"><span>${escapeText(p.name)}</span><strong>${state.tasks.filter(t=>t.title.trim()&&t.owner===p.id).length} owned</strong></div>`).join('')+
      `<div class="frb-summary-line"><span>Unassigned responsibilities</span><strong>${unassigned}</strong></div><div class="frb-summary-line"><span>Total responsibilities</span><strong>${count} / 12</strong></div>`;
  }
  const render=()=>{renderMembers();renderTasks();renderPaper();persist()};
  const redraw=()=>{renderPaper();persist()};
  memberNode.addEventListener('input',e=>{const el=e.target as HTMLInputElement;if(el.dataset.frbPersonName){const p=state.people.find(x=>x.id===el.dataset.frbPersonName);if(p){p.name=el.value;renderTasks();redraw()}}});
  memberNode.addEventListener('change',e=>{const el=e.target as HTMLSelectElement;if(el.dataset.frbPersonAge){const p=state.people.find(x=>x.id===el.dataset.frbPersonAge);if(p){p.age=el.value?Number(el.value):null;redraw()}}});
  memberNode.addEventListener('click',e=>{const b=(e.target as HTMLElement).closest<HTMLButtonElement>('[data-frb-remove-person]');if(!b||state.people.length===1)return;state.people=state.people.filter(p=>p.id!==b.dataset.frbRemovePerson);state.tasks.forEach(t=>{if(t.owner===b.dataset.frbRemovePerson)t.owner=''});render()});
  taskNode.addEventListener('input',e=>{const el=e.target as HTMLInputElement;if(el.dataset.frbTaskTitle){const t=state.tasks.find(x=>x.id===el.dataset.frbTaskTitle);if(t){t.title=el.value;redraw()}}});
  taskNode.addEventListener('change',e=>{const el=e.target as HTMLSelectElement;if(el.dataset.frbTaskOwner){const t=state.tasks.find(x=>x.id===el.dataset.frbTaskOwner);if(t){t.owner=el.value;redraw()}}});
  taskNode.addEventListener('click',e=>{const b=(e.target as HTMLElement).closest<HTMLButtonElement>('[data-frb-remove-task]');if(!b)return;state.tasks=state.tasks.filter(t=>t.id!==b.dataset.frbRemoveTask);render()});
  host.querySelector('[data-frb-add-person]')!.addEventListener('click',()=>{if(state.people.length>=8){message.textContent='Up to eight family members per chart.';return}state.people.push({id:nextId(),name:'',age:8});render();memberNode.querySelectorAll('input')[state.people.length-1]?.focus()});
  function addTask(id:string,title:string){
    if(state.tasks.length>=12){message.textContent='Your page is full. Remove a responsibility to add another.';return}
    const owner=state.people.find(p=>p.age!==null && p.age>=3)?.id??'';
    state.tasks.push({id:nextId(),title,owner,when:'Daily',icon:id});
    message.textContent=`Added ${title}. Choose an owner in the list above.`;
    render();
  }
  const addCustom=()=>{const title=custom.value.trim();if(!title)return;addTask('',title);custom.value=''};
  host.querySelector('[data-frb-add-custom]')!.addEventListener('click',addCustom);
  custom.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();addCustom()}});
  host.querySelector('[data-frb-library]')!.addEventListener('click',e=>{const b=(e.target as HTMLElement).closest<HTMLButtonElement>('[data-frb-library-item]');if(!b)return;const minAge=Number(b.dataset.frbAge??'3');addTask(b.dataset.frbLibraryItem!,b.dataset.frbTitle!);const owner=state.people.find(p=>p.id===state.tasks[state.tasks.length-1]?.owner);if(owner?.age!==null&&owner?.age!==undefined&&owner.age<minAge)message.textContent=`Added ${b.dataset.frbTitle}. This activity is usually suggested from age ${minAge}; choose the right owner for your family.`});
  host.querySelector('[data-frb-reset]')!.addEventListener('click',()=>{if(!confirm('Reset your family chart? This replaces your saved changes.'))return;state=defaultState();render();message.textContent='Example chart restored.'});
  const download=host.querySelector<HTMLButtonElement>('[data-frb-download]')!;
  download.addEventListener('click',async()=>{if(!state.tasks.some(t=>t.title.trim())){message.textContent='Add at least one responsibility first.';return}await downloadPng(paper,{filename:'our-family-our-team.png',width:816,height:1056,layoutHost:host,exportClass:'frb-exporting',button:download})});
  // Keep preview letter proportions without changing capture dimensions.
  const viewport=host.querySelector<HTMLElement>('.frb-paper-viewport')!;
  const resize=()=>{const width=Math.min(816,viewport.clientWidth);const scale=width/816;paper.style.transform=scale<1?`scale(${scale})`:'';viewport.style.height=`${1056*scale}px`;};
  new ResizeObserver(resize).observe(viewport);
  render();resize();
}
</script>

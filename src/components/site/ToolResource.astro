---
import type { DirectoryPresentation } from '../../data/tools-directory';
interface Props { href: string; resource: DirectoryPresentation; seasonal?: boolean; popular?: boolean; priority?: boolean; }
const { href, resource, seasonal = false, popular = false, priority = false } = Astro.props;
---
<article
  class:list={['resource', seasonal && 'resource-seasonal']}
  data-resource-item={!seasonal || undefined}
  data-resource-category={!seasonal ? resource.category : undefined}
  data-resource-popular={!seasonal ? String(popular) : undefined}
  data-resource-search={!seasonal ? `${resource.title} ${resource.description}`.toLocaleLowerCase() : undefined}
  hidden={!seasonal && !popular}
>
  <a class="resource-preview" href={href} tabindex="-1" aria-hidden="true">
    <img src={`/images/tools/previews/${resource.slug}.webp`} alt={`Preview of ${resource.title}${resource.onScreen ? ', an on-screen checklist' : ''}.`} width="900" height="720" loading={priority ? 'eager' : 'lazy'} decoding="async" />
  </a>
  <div class="resource-copy">
    <h3>{resource.title}</h3>
    <p>{resource.description}</p>
    {resource.onScreen && <span class="resource-format">Use on screen</span>}
    <a class="resource-action" href={href}>{resource.action}</a>
  </div>
</article>
<style>
  .resource { min-width:0; display:flex; flex-direction:column; }
  .resource[hidden] { display:none !important; }
  .resource-preview { display:block; aspect-ratio:5 / 4; overflow:hidden; background:#f6f7f5; }
  .resource-preview img { display:block; width:100%; height:100%; object-fit:contain; transition:transform .2s ease; }
  .resource-preview:hover img { transform:scale(1.025); }
  .resource-copy { padding-top:20px; display:flex; flex:1; flex-direction:column; align-items:flex-start; }
  .resource h3 { margin:0; font-family:var(--font-sans); font-size:1.17rem; line-height:1.35; font-weight:700; letter-spacing:-.025em; color:#414641; }
  .resource p { margin:10px 0 22px; font-size:.9rem; line-height:1.7; color:#5c625c; }
  .resource-format { display:block; margin:-12px 0 16px; font-size:.7rem; letter-spacing:.055em; color:#5c625c; }
  .resource-action { display:inline-flex; align-items:center; justify-content:center; padding:12px 17px; min-height:46px; margin-top:auto; color:#343a34; background:var(--resource-accent,#CDDDE1); border:1px solid transparent; border-radius:0; font-size:.77rem; font-weight:600; text-decoration:none; line-height:1.5; transition:background .15s ease; }
  .resource-action:hover { background:#e7ece5; text-decoration:underline; text-underline-offset:4px; }
  .resource-action:focus-visible { outline:2px solid #414641; outline-offset:4px; }
  .resource-seasonal .resource-preview { height:170px; aspect-ratio:auto; }
  .resource-seasonal .resource-copy { padding-top:16px; }
  .resource-seasonal h3 { font-size:1.02rem; }
  .resource-seasonal p { font-size:.82rem; margin-top:8px; margin-bottom:16px; }
  .resource-seasonal .resource-format { margin-top:-7px; }
  @media (max-width:639px) {
    .resource-preview { aspect-ratio:5 / 4; }
    .resource-copy { padding-top:18px; }
    .resource h3 { font-size:1.2rem; }
    .resource p { font-size:.91rem; }
    .resource-seasonal { display:grid; grid-template-columns:112px minmax(0,1fr); gap:18px; align-items:center; }
    .resource-seasonal .resource-preview { height:auto; aspect-ratio:1; }
    .resource-seasonal .resource-copy { padding:0; }
    .resource-seasonal h3 { font-size:.96rem; }
    .resource-seasonal p, .resource-seasonal .resource-format { display:none; }
    .resource-seasonal .resource-action { padding:9px 0 0; background:transparent; min-height:44px; text-decoration:underline; text-underline-offset:5px; font-size:.72rem; margin:0; justify-content:flex-start; }
  }
  @media (prefers-reduced-motion:reduce) { .resource-preview img { transition:none; } }
</style>

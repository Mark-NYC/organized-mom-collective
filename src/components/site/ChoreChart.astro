---
import { choreAreas, choreChoices } from '../../data/chore-recommendations';
interface Props { storageKey: string; handoff?: boolean }
const { storageKey, handoff = false } = Astro.props;
---
<div class="chore-builder" data-chore-builder data-storage-key={storageKey} data-handoff={handoff ? '' : undefined}>
  <div class="cb-control-panel" data-cb-panel>
  <section class="cb-setup" aria-label="Customize your child's chore chart">
    
    <div class="cb-inputs">
      <label>Child's first name<input data-cb-name type="text" maxlength="24" placeholder="e.g. Emma" autocomplete="off" /></label>
      <label>Child's age<select data-cb-age><option value="">Choose age</option>{Array.from({length:17},(_,i)=>i+2).map(n=><option value={n}>{n}{n===18?'+' : ''}</option>)}</select></label>
    </div>
    <fieldset class="cb-level"><legend>Experience with chores</legend><label><input type="radio" name="cb-level" value="beginner" checked /> Just getting started</label><label><input type="radio" name="cb-level" value="experienced" /> Already doing some jobs independently</label></fieldset>
    <details class="cb-areas-details"><summary><strong>Customize household areas</strong><span>Bedroom, kitchen, common spaces, laundry</span></summary>
      <fieldset class="cb-areas"><legend>Where could your child help?</legend><p>Uncheck anything that doesn't fit your household.</p><div class="cb-area-grid">{Object.entries(choreAreas).map(([id,label])=><label><input type="checkbox" data-cb-area value={id} checked={id!=='pets' && id!=='outdoors'}/><span>{label}</span></label>)}</div></fieldset>
    </details>
    <div class="cb-setup-actions"><button type="button" class="cb-primary" data-cb-generate>Create my chore chart</button><button type="button" data-cb-apply hidden>Save child details</button><button type="button" data-cb-regenerate hidden>Get new chore suggestions</button><span data-cb-setup-help>Start small. You can always add jobs later.</span></div>
  </section>
    <div class="cb-toolbar cb-toolbar-new" data-cb-toolbar hidden>
      <div class="cb-toolbar-title"><h2><span data-cb-ready-name>Your</span> chart</h2><p data-cb-status role="status" aria-live="polite">Edit chores directly on the chart below.</p></div>
      <div class="cb-toolbar-settings">
        <label class="cb-weekly-day-control">Weekly jobs day<select data-cb-weekly-day><option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option><option selected>Saturday</option><option>Sunday</option></select></label>
        <fieldset class="cb-style-switch" aria-label="Print style"><legend>Print style</legend><label><input type="radio" name="cb-style" value="color" checked /><span>Color</span></label><label><input type="radio" name="cb-style" value="bw" /><span>Black & White</span></label></fieldset>
      </div>
      <div class="cb-toolbar-actions"><button type="button" data-cb-back class="cb-edit-details">Edit details</button><div class="cb-buttons"><button type="button" data-cb-add>+ Add a chore</button></div></div>
      <p class="cb-save-note">✓ Changes save automatically on this device.</p>
    </div>
    <div class="cb-picker" data-cb-picker hidden><div class="cb-picker-head"><strong>Add a household chore</strong><button type="button" data-cb-picker-close aria-label="Close chore picker">×</button></div><div class="cb-picker-fields"><div class="cb-frequency-tabs" role="group" aria-label="Add to"><span>Add to</span><div><button type="button" data-cb-frequency-tab="daily" aria-pressed="true">Daily</button><button type="button" data-cb-frequency-tab="weekly" aria-pressed="false">Weekly</button></div><select data-cb-frequency aria-label="Chore frequency" hidden><option value="daily">Daily jobs</option><option value="weekly">Weekly jobs</option></select></div><label>Area<select data-cb-filter><option value="">All areas</option>{Object.entries(choreAreas).map(([id,label])=><option value={id}>{label}</option>)}</select></label></div><label class="cb-chore-search-label">Search chores<input type="search" data-cb-search placeholder="e.g. dishes, laundry, bed"/></label><p class="cb-picker-limit">Up to 4 daily and 4 weekly jobs.</p><div class="cb-choice-list" data-cb-choices>{choreChoices.map(choice=><button type="button" data-cb-choice={choice.id} data-area={choice.area} data-frequency={choice.frequency} data-age={choice.minAge}><span>{choice.label}</span><small>{choreAreas[choice.area]}</small></button>)}</div><label class="cb-custom">Or write your own chore<input data-cb-custom maxlength="65" placeholder="e.g. Put away shoes"/></label><button type="button" data-cb-custom-add>Add custom chore</button></div>
  </div>
  <section class="cb-results" data-cb-results hidden>
    <div class="cb-preview-wrap">
      <button type="button" class="cb-preview-download cb-primary" data-cb-download aria-label="Download chore chart">↓ Download chart</button>
    <div class="cb-sheet" data-cb-sheet>
      <header class="cb-sheet-head"><h2 class="cb-sheet-title"><span data-cb-sheet-name>My</span> Chore Chart</h2><p class="cb-sheet-subtitle">My jobs. Start to finish.</p></header>
      <div class="cb-sheet-sections"><section class="cb-daily-section"><h3>My daily jobs</h3><div class="cb-day-head"><span></span>{['M','T','W','T','F','S','S'].map(day=><span>{day}</span>)}</div><div data-cb-daily></div></section><section class="cb-weekly-section"><h3>My weekly jobs on <span data-cb-weekly-day-label>Saturday</span></h3><div class="cb-weekly-grid" data-cb-weekly></div></section></div>
      <footer class="cb-brand-footer">ORGANIZED MOM COLLECTIVE</footer>
    </div>
    </div>

    
    
  </section>
  <slot name="footnote"/>
</div>
<style is:global>
.chore-builder{--cb-ink:#545454;--cb-leaf:#D4DFC4;--cb-frost:#CDDDE1;color:var(--cb-ink);background:#FBF7F1;padding:30px 20px 60px}.chore-builder *{box-sizing:border-box}.cb-setup,.cb-results{max-width:1080px;margin:auto}.cb-intro{text-align:center;max-width:640px;margin:0 auto 28px}.cb-intro h2,.cb-toolbar h2{font-family:Georgia,serif;font-size:clamp(25px,3vw,36px);margin:6px 0 10px}.cb-intro p,.cb-toolbar p,.cb-areas p{color:#68635f}.cb-eyebrow{font-size:11px;letter-spacing:.15em;font-weight:700}.cb-inputs{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:740px;margin:auto}.cb-inputs label,.cb-picker-fields label,.cb-custom{display:grid;gap:7px;font-size:13px;font-weight:700}.chore-builder input[type=text],.chore-builder select{width:100%;padding:13px;background:white;border:1px solid #ccc5bc;border-radius:8px;font:inherit;color:#333}.cb-level,.cb-areas{border:0;max-width:740px;margin:25px auto;padding:0}.cb-level legend,.cb-areas legend{font-weight:700;margin-bottom:12px}.cb-level label{display:inline-flex;gap:8px;margin:0 20px 10px 0;align-items:center}.cb-area-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.cb-area-grid label{display:flex;gap:10px;align-items:center;padding:14px;border:1px solid #dad5cc;border-radius:10px;background:white}.cb-setup-actions{display:grid;justify-items:center;gap:10px;margin:30px auto}.chore-builder button{cursor:pointer;padding:11px 16px;border:1px solid #aaa198;border-radius:8px;background:#fff;color:#545454;font-weight:600}.chore-builder button:hover{border-color:#545454}.chore-builder .cb-primary{background:#545454;color:white;border-color:#545454}.cb-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:0 0 20px}.cb-toolbar h2{margin:3px 0}.cb-buttons{display:flex;gap:8px;flex-wrap:wrap}.cb-picker{border:1px solid #d8d0c7;border-radius:14px;background:white;padding:18px;margin-bottom:22px}.cb-picker-head{display:flex;justify-content:space-between;align-items:center}.cb-picker-fields{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin:12px 0}.cb-choice-list{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;max-height:270px;overflow:auto}.cb-choice-list button{text-align:left;display:grid;gap:4px}.cb-choice-list small{font-size:11px;color:#777}.cb-custom{margin:15px 0 8px}.cb-sheet{background:#fff;border:1px solid #ddd5cb;border-radius:5px;padding:35px;min-height:660px;width:1056px;max-width:100%;margin:auto}.cb-sheet-head{text-align:center;padding:8px 0 27px}.cb-sheet-head>span{font:700 11px Montserrat,sans-serif;letter-spacing:.2em}.cb-sheet-head h2{font:700 36px Montserrat,sans-serif;letter-spacing:.08em;margin:4px}.cb-sheet-head p{margin:6px}.cb-sheet-name{font:700 26px Georgia,serif!important}.cb-sheet-sections{display:grid;grid-template-columns:1.25fr 1fr;gap:20px;align-items:start}.cb-sheet-sections section{border:2px solid #D4DFC4;border-radius:14px;padding:16px}.cb-weekly-section{border-color:#CDDDE1!important}.cb-sheet-sections h3{font:700 25px Georgia,serif;text-align:center;margin:0 0 16px}.cb-weekly-section>p{text-align:center;font-size:12px;margin:-7px 0 14px}.cb-day-head,.cb-daily-row{display:grid;grid-template-columns:minmax(0,1fr) repeat(7,26px);gap:5px;align-items:center;margin-bottom:9px}.cb-day-head span{text-align:center;font-size:12px;font-weight:700}.cb-daily-row,.cb-weekly-row{min-height:48px}.cb-job{display:flex;align-items:center;gap:7px;min-width:0}.cb-job img{width:33px;height:33px;object-fit:contain}.cb-job input{min-width:0;width:100%;border:0;border-bottom:1px solid #ede9e3;font:500 12px Montserrat,sans-serif;color:#545454;background:transparent;padding:6px 0}.cb-day-check{width:24px;height:24px;border:1.5px solid #bcb7b1;border-radius:5px;display:block}.cb-weekly-row{display:flex;gap:9px;justify-content:space-between;align-items:center;border-bottom:1px solid #eee8e0;margin-bottom:9px}.cb-weekly-row .cb-job{flex:1}.cb-weekly-row .cb-day-check{flex:none}.cb-remove{font-size:14px!important;padding:3px 6px!important;border:0!important;color:#9a8780!important;display:none}.cb-results:not(.cb-exporting) .cb-job:hover .cb-remove,.cb-results:not(.cb-exporting) .cb-job:focus-within .cb-remove{display:inline}.cb-weekly-row select{width:auto!important;max-width:92px;border:0!important;padding:4px!important;font-size:11px!important;background:transparent!important}.cb-sheet-footer{text-align:center;padding-top:25px;font:italic 15px Georgia,serif}.cb-print-note{font-size:13px;text-align:center;margin:16px auto;color:#777}.cb-results[hidden],.cb-picker[hidden]{display:none!important}@media(max-width:800px){.cb-inputs,.cb-area-grid,.cb-sheet-sections,.cb-picker-fields{grid-template-columns:1fr}.cb-toolbar{display:block}.cb-buttons{margin-top:14px}.cb-choice-list{grid-template-columns:repeat(2,1fr)}.cb-sheet{padding:18px 10px;min-height:auto}.cb-sheet-sections{gap:12px}.cb-day-head,.cb-daily-row{grid-template-columns:minmax(0,1fr) repeat(7,19px);gap:3px}.cb-day-check{width:18px;height:18px}.cb-job img{width:25px;height:25px}.cb-job input{font-size:11px}.cb-sheet-head h2{font-size:26px}}@media print{.cb-setup,.cb-toolbar,.cb-picker,.cb-print-note,.cb-remove,.cb-weekly-row select{display:none!important}.cb-sheet{border:0;box-shadow:none;width:100%;}.cb-sheet-sections{grid-template-columns:1.25fr 1fr}}
</style>

<style is:global>
/* Monochromatic sage tints, or ink-only grayscale for economical printing. */
.chore-builder .cb-icon-tile{width:70px;height:70px;min-width:70px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:#EAF0E9}
.chore-builder .cb-icon-tile[data-tone="frost"]{background:#EFF3EE}
.chore-builder .cb-icon-tile[data-tone="apricot"]{background:#E4EBE2}
.chore-builder .cb-icon-tile[data-tone="blush"]{background:#DCE7DE}
.chore-builder .cb-icon-tile[data-tone="evergreen"]{background:#D4E1D8}
.chore-builder .cb-icon-tile[data-tone="mushroom"]{background:#E8EEE7}
.chore-builder .cb-results[data-style="bw"] .cb-icon-tile,
.chore-builder .cb-results[data-style="bw"] .cb-icon-tile[data-tone]{background:#F3F3F3!important}
.chore-builder .cb-results[data-style="bw"] .cb-daily-section,
.chore-builder .cb-results[data-style="bw"] .cb-weekly-section{border-color:#C4C4C4!important}
.chore-builder .cb-style-switch{border:0;padding:0;margin:0;display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.chore-builder .cb-style-switch legend{font-size:12px;font-weight:700;margin-bottom:4px}
.chore-builder .cb-style-switch label{cursor:pointer;position:relative}
.chore-builder .cb-style-switch input{position:absolute;opacity:0;width:1px;height:1px}
.chore-builder .cb-style-switch span{display:inline-block;border:1px solid #BCB6AE;border-radius:8px;background:white;padding:10px 13px;font-size:12px;font-weight:700}
.chore-builder .cb-style-switch input:checked+span{background:#D4E1D8;border-color:#7F9B8B;color:#283E32}
.chore-builder .cb-style-switch input:focus-visible+span{outline:2px solid #545454;outline-offset:2px}
.chore-builder .cb-results[data-style="bw"] .cb-style-switch input:checked+span{background:#E6E6E6;border-color:#666;color:#222}
.chore-builder .cb-icon-tile img{width:62px;height:62px;object-fit:contain}
.chore-builder .cb-daily-row,.chore-builder .cb-weekly-row{min-height:78px;margin-bottom:7px}
.chore-builder .cb-job{gap:10px}
.chore-builder .cb-job input{font-size:13px;line-height:1.35}
.chore-builder .cb-sheet{padding:22px 25px;min-height:816px}
.chore-builder .cb-sheet-head{padding:0 0 14px}
.chore-builder .cb-sheet-head h2{font-size:31px}
.chore-builder .cb-sheet-sections{grid-template-columns:1.22fr 1fr;gap:14px}
.chore-builder .cb-sheet-sections section{padding:11px}
.chore-builder .cb-sheet-sections h3{font-size:22px;margin-bottom:10px}
.chore-builder .cb-sheet-footer{padding-top:12px}
@media(max-width:800px){
 .chore-builder .cb-sheet{padding:16px 10px}
 .chore-builder .cb-icon-tile{width:58px;height:58px;min-width:58px}
 .chore-builder .cb-icon-tile img{width:52px;height:52px}
 .chore-builder .cb-daily-row,.chore-builder .cb-weekly-row{min-height:66px}
 .chore-builder .cb-job input{font-size:11px}
}
.cb-results.cb-exporting .cb-sheet{padding:22px 25px!important;min-height:816px!important}
.cb-results.cb-exporting .cb-icon-tile{width:70px!important;height:70px!important;min-width:70px!important}
.cb-results.cb-exporting .cb-icon-tile img{width:62px!important;height:62px!important}
.cb-results.cb-exporting .cb-daily-row,.cb-results.cb-exporting .cb-weekly-row{min-height:78px!important}
.cb-results.cb-exporting .cb-sheet-sections{grid-template-columns:1.22fr 1fr!important;gap:14px!important}
.cb-results.cb-exporting .cb-job input{font-size:13px!important}
@media print{
 .chore-builder .cb-icon-tile{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>

<style is:global>
/* Chore chart printable polish: editorial title, quiet lines, clean printed controls. */
.chore-builder .cb-sheet-head{padding:2px 0 20px;text-align:center}
.chore-builder .cb-sheet-title{font:700 32px/1.2 Georgia,serif;letter-spacing:-.025em;margin:10px 0 6px;color:#545454}
.chore-builder .cb-sheet-subtitle{margin:0;font:500 14px/1.4 Montserrat,sans-serif;color:#66615e}
.chore-builder .cb-sheet-sections section{border-width:1.5px;border-color:#C9D5CB;border-radius:14px}
.chore-builder .cb-results[data-style="bw"] .cb-sheet-sections section{border-color:#C9C9C9}
.chore-builder .cb-job input{font-size:14px;line-height:1.35;border-bottom:0!important}
.chore-builder .cb-weekly-section>p{display:none}
.chore-builder .cb-weekday-wrap{min-width:78px;flex:0 0 auto;display:flex;justify-content:flex-end;align-items:center}
.chore-builder .cb-weekday-wrap select{font-size:11px!important;padding:4px!important;border:0!important;max-width:90px!important;background:transparent!important}
.chore-builder .cb-weekday-print{display:none;font:500 11px Montserrat,sans-serif;color:#68635f}
.chore-builder .cb-results.cb-exporting .cb-weekday-wrap select{display:none!important}
.chore-builder .cb-results.cb-exporting .cb-weekday-print{display:inline!important}
.chore-builder .cb-results.cb-exporting .cb-job input{border:0!important;box-shadow:none!important;outline:0!important}
.chore-builder .cb-results.cb-exporting .cb-remove{display:none!important}
@media print{
 .chore-builder .cb-weekday-wrap select{display:none!important}
 .chore-builder .cb-weekday-print{display:inline!important}
 .chore-builder .cb-job input{border:0!important;outline:0!important}
 .chore-builder .cb-remove{display:none!important}
}
@media(max-width:800px){.chore-builder .cb-sheet-title{font-size:26px}.chore-builder .cb-job input{font-size:12px}}
</style>

<style is:global>
/* Single-column chart with large daily rows and compact weekly job cards. */
.chore-builder .cb-sheet-sections,.chore-builder .cb-results.cb-exporting .cb-sheet-sections{display:flex!important;flex-direction:column!important;gap:20px!important}
.chore-builder .cb-sheet-sections section{width:100%;border:0!important;border-radius:0!important;padding:0!important}
.chore-builder .cb-daily-section{padding-top:10px!important;border-top:2px solid #D4E1D8!important}
.chore-builder .cb-weekly-section{padding-top:12px!important;border-top:1px solid #C6D7CA!important}
.chore-builder .cb-sheet-sections h3{text-align:left!important;font:700 22px/1.2 Georgia,serif!important;margin:0 0 12px!important}
.chore-builder .cb-day-head,.chore-builder .cb-daily-row{grid-template-columns:minmax(0,44%) repeat(7,minmax(0,1fr))!important;gap:5px!important}
.chore-builder .cb-daily-row{min-height:84px!important;border-bottom:1px solid #EBEEE9;align-items:center;margin:0!important;padding:4px 0}
.chore-builder .cb-daily-row .cb-day-check{justify-self:center}
.chore-builder .cb-job{gap:13px!important}
.chore-builder .cb-job input{font-size:15px!important}
.chore-builder .cb-icon-tile{position:relative;width:72px!important;height:72px!important;min-width:72px!important;background:transparent!important;overflow:visible!important;isolation:isolate;border-radius:0!important}
.chore-builder .cb-icon-tile::before{content:"";position:absolute;width:62px;height:62px;left:1px;top:5px;border-radius:50%;background:linear-gradient(135deg,#F5F8F3 0%,#DCE7DE 100%);z-index:-1}
.chore-builder .cb-icon-tile[data-tone="frost"]::before{background:linear-gradient(135deg,#F7F9F5,#E0E9E1)}
.chore-builder .cb-icon-tile[data-tone="apricot"]::before{background:linear-gradient(135deg,#F3F7F0,#D7E4D9)}
.chore-builder .cb-icon-tile[data-tone="blush"]::before{background:linear-gradient(135deg,#EFF5ED,#D4E1D8)}
.chore-builder .cb-icon-tile[data-tone="evergreen"]::before{background:linear-gradient(135deg,#EDF4EA,#CDDED1)}
.chore-builder .cb-icon-tile[data-tone="mushroom"]::before{background:linear-gradient(135deg,#F5F8F2,#DFE9DF)}
.chore-builder .cb-icon-tile img{position:relative;width:64px!important;height:64px!important;transform:translate(8px,-6px);object-fit:contain;z-index:1}
.chore-builder .cb-weekly-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.chore-builder .cb-weekly-grid:has(> :only-child){grid-template-columns:minmax(0,1fr);max-width:310px}
.chore-builder .cb-weekly-grid:has(> :nth-child(2):last-child){grid-template-columns:repeat(2,minmax(0,1fr))}
.chore-builder .cb-weekly-row{display:flex!important;flex-direction:column;justify-content:center;gap:5px!important;min-height:155px!important;border:0!important;background:#F8FAF7;padding:10px!important;border-radius:8px}
.chore-builder .cb-weekly-row .cb-job{display:flex;flex-direction:column;justify-content:center;text-align:center;gap:4px!important;width:100%}
.chore-builder .cb-weekly-row .cb-job input{text-align:center;font-size:13px!important;min-height:36px}
.chore-builder .cb-weekly-row .cb-weekday-wrap{justify-content:center;min-height:20px}
.chore-builder .cb-weekly-row .cb-day-check{width:23px!important;height:23px!important;min-height:23px;align-self:center}
.chore-builder .cb-results[data-style="bw"] .cb-icon-tile::before{background:linear-gradient(135deg,#FFFFFF,#E8E8E8)!important}
.chore-builder .cb-results[data-style="bw"] .cb-weekly-row{background:#F8F8F8}
.chore-builder .cb-results.cb-exporting .cb-sheet{min-height:816px!important}
.chore-builder .cb-results.cb-exporting .cb-icon-tile{width:72px!important;height:72px!important;min-width:72px!important}
.chore-builder .cb-results.cb-exporting .cb-icon-tile img{width:64px!important;height:64px!important}
.chore-builder .cb-results.cb-exporting .cb-daily-row{min-height:84px!important}
.chore-builder .cb-results.cb-exporting .cb-weekly-row{min-height:155px!important}
@media(max-width:800px){
 .chore-builder .cb-day-head,.chore-builder .cb-daily-row{grid-template-columns:minmax(0,44%) repeat(7,minmax(0,1fr))!important;gap:2px!important}
 .chore-builder .cb-daily-row .cb-day-check{width:17px!important;height:17px!important}
 .chore-builder .cb-weekly-grid{gap:7px}
 .chore-builder .cb-weekly-row{padding:8px 4px!important}
 .chore-builder .cb-job{gap:5px!important}
 .chore-builder .cb-job input{font-size:11px!important}
 .chore-builder .cb-icon-tile{width:52px!important;height:52px!important;min-width:52px!important}
 .chore-builder .cb-icon-tile::before{width:45px;height:45px;top:3px}
 .chore-builder .cb-icon-tile img{width:48px!important;height:48px!important;transform:translate(5px,-4px)}
}
.cb-results.cb-exporting .cb-day-head,.cb-results.cb-exporting .cb-daily-row{grid-template-columns:minmax(0,44%) repeat(7,minmax(0,1fr))!important;gap:5px!important}
.cb-results.cb-exporting .cb-daily-row .cb-day-check{width:24px!important;height:24px!important}
.cb-results.cb-exporting .cb-job input{font-size:15px!important}
@media print{.chore-builder .cb-icon-tile::before,.chore-builder .cb-weekly-row{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>

<style is:global>
/* Original softer gradient, retaining the smaller circle size. */
.chore-builder .cb-icon-tile::before{width:46.5px!important;height:46.5px!important;left:8px!important;top:12px!important;background:linear-gradient(135deg,#F5F8F3 0%,#DCE7DE 100%)!important}
.chore-builder .cb-icon-tile[data-tone="frost"]::before{background:linear-gradient(135deg,#F7F9F5,#E0E9E1)!important}
.chore-builder .cb-icon-tile[data-tone="apricot"]::before{background:linear-gradient(135deg,#F3F7F0,#D7E4D9)!important}

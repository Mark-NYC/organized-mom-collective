---
/** Records clicks on any [data-cta] link on public pages. Logic and vendors: src/lib/analytics.ts. */
---

<script>
  import { ctaEvent, send } from '../../lib/analytics';

  document.addEventListener(
    'click',
    (e) => {
      const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[data-cta]');
      if (!link) return;
      send(
        ctaEvent(
          { placement: link.dataset.cta ?? '', label: link.textContent ?? '', href: link.href },
          { origin: location.origin, path: location.pathname, width: window.innerWidth },
        ),
      );
    },
    { capture: true },
  );
</script>

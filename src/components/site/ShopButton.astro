---
/**
 * "Shop" call to action. Goes to the website checkout when the calendar is sold there
 * (CALENDAR_OPTIONS → websiteProduct, shop-enabled builds), else straight to the Etsy listing
 * once one is set (etsyUrl), else to the options on /calendar. Never a dead link.
 * `to` keeps the visit on the product page instead (the homepage always does), and
 * `cta` names the placement in a data-cta attribute for analytics to hook into.
 */
import { shopCheckoutUrl, shopUrl } from '../../lib/reorder';
import { routes } from '../../routes';

interface Props {
  label: string;
  /** Link to /calendar ('product') or its options (#buy, 'options') instead of Etsy, e.g. from the homepage. */
  to?: 'product' | 'options';
  /** Placement name for analytics, e.g. "home-hero". */
  cta?: string;
  class?: string;
}
const { label: requestedLabel, to, cta, class: className } = Astro.props;
const label = requestedLabel === 'Get the Calendar' && !shopUrl() && !shopCheckoutUrl() ? 'See the Calendar' : requestedLabel;
const internal = to === 'options' ? routes.buy : to === 'product' ? routes.calendar : shopCheckoutUrl();
const etsy = internal ? null : shopUrl();
---

{
  etsy ? (
    <a href={etsy} target="_blank" rel="noopener noreferrer" data-cta={cta} class:list={['btn-primary gap-2', className]} aria-label={`${label} on Etsy (opens Etsy)`}>
      {label} <span aria-hidden="true">↗</span>
    </a>
  ) : (
    <a href={internal ?? routes.buy} data-cta={cta} class:list={['btn-primary', className]}>
      {label}
    </a>
  )
}

---
/**
 * "Shop" call to action. Goes straight to the Etsy listing once one is set in
 * src/config.ts (CALENDAR_OPTIONS → etsyUrl); until then it goes to the options on
 * /calendar, where each option shows "coming soon to Etsy". Never a dead link.
 * `to` keeps the visit on the product page instead (the homepage always does), and
 * `cta` names the placement in a data-cta attribute for analytics to hook into.
 */
import { shopUrl } from '../../lib/reorder';
import { routes } from '../../routes';

interface Props {
  label: string;
  /** Link to /calendar ('product') or its options (#buy, 'options') instead of Etsy, e.g. from the homepage. */
  to?: 'product' | 'options';
  /** Placement name for analytics, e.g. "home-hero". */
  cta?: string;
  class?: string;
}
const { label, to, cta, class: className } = Astro.props;
const internal = to === 'options' ? routes.buy : to === 'product' ? routes.calendar : null;
const etsy = internal ? null : shopUrl();
---

{
  etsy ? (
    <a href={etsy} target="_blank" rel="noopener noreferrer" data-cta={cta} class:list={['btn-primary gap-2', className]} aria-label={`${label} on Etsy (opens Etsy)`}>
      {label} <span aria-hidden="true">↗</span>
    </a>
  ) : (
    <a href={internal ?? routes.buy} data-cta={cta} class:list={['btn-primary', className]}>
      {label}
    </a>
  )
}

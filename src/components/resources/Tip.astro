---
/**
 * A practical tip or aside, lightly tinted. Use sparingly: one or two per article,
 * for something useful that sits beside the main thread.
 */
interface Props {
  title?: string;
  label?: string;
}
const { title, label = 'Good to know' } = Astro.props;
---

<aside class="my-12 rounded-[6px] bg-sage-wash px-5 py-6 sm:px-8 sm:py-7" aria-label={title ?? label}>
  <p class="label text-soft">{label}</p>
  {title && <p class="mt-2 text-[1.25rem] leading-snug font-bold" style="font-family: var(--font-editorial)">{title}</p>}
  <div class="article-callout mt-3 text-[1rem] leading-[1.7] sm:text-[1.0625rem]"><slot /></div>
</aside>

---
/**
 * A short checklist drawn like the printed calendar: empty boxes on ruled lines,
 * on a softly outlined card. Static on purpose; it's for reading, printing or
 * copying onto paper. Put several in a <ChecklistGrid> to show them side by side.
 */
interface Props {
  items: string[];
  title?: string;
  /** Optional time stamp, e.g. "15 min". */
  time?: string;
  /** Optional zone icon, e.g. from src/data/cleaning.ts. */
  icon?: string;
  /** Include this card in CleaningWeek's "Print the schedule". */
  print?: boolean;
}
const { items, title, time, icon, print = false } = Astro.props;
---

<div class="checklist-block my-6 rounded-[6px] border border-rule bg-paper px-4 pt-3.5 pb-2 sm:px-5" data-print-schedule={print || undefined}>
  {
    (title || time) && (
      <div class="flex items-center justify-between gap-3 border-b border-ink pb-2.5">
        <p class="flex min-w-0 items-center gap-2.5">
          {icon && (
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-month/35">
              <img src={icon} alt="" width="192" height="192" class="size-7" />
            </span>
          )}
          {title && <span class="label min-w-0 leading-snug [overflow-wrap:anywhere]">{title}</span>}
        </p>
        {time && (
          <span class="inline-flex shrink-0 items-center border border-ink px-1.5 py-[3px] text-[0.64rem] leading-none font-semibold tracking-[0.16em] whitespace-nowrap uppercase">
            {time}
          </span>
        )}
      </div>
    )
  }
  <ul class="checklist">
    {
      items.map((item) => (
        <li class="flex items-start gap-3 border-b border-rule py-2.5 text-[0.98rem] leading-snug last:border-b-0">
          <span aria-hidden="true" class="mt-[1px] size-[1.05rem] shrink-0 rounded-[3px] border-[1.5px] border-ink bg-paper" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</div>

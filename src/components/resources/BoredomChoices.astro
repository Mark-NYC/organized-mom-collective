---
const choices = [
  ['Build something', 'Blocks, bricks, or a cardboard box.', 'blocks'],
  ['Make something', 'Paper, crayons, and your imagination.', 'paintbrush'],
  ['Read something', 'Pick a book. Find a cozy spot.', 'book'],
  ['Move your body', 'Try ten jumps and a silly dance.', 'move-play'],
  ['Solve something', 'Choose a puzzle or brain teaser.', 'puzzle-piece'],
  ['Play pretend', 'Open a shop for your stuffed animals.', 'stuffed-animal'],
];
const iconUrls = import.meta.glob('../../../assets/icons/ofc/updatedicons/svg/*.svg', { eager: true, query: '?url', import: 'default' });
const iconUrl = (name: string) => iconUrls[`../../../assets/icons/ofc/updatedicons/svg/${name}.svg`] as string;
---
<section id="pick-one" class="boredom-choices" aria-labelledby="boredom-title" data-print-schedule>
  <p class="label">Six ideas to keep</p>
  <h2 id="boredom-title">Bored? Pick one.</h2>
  <p>Choose an idea. Gather what you need. Put it away when you finish.</p>
  <ul>
    {choices.map(([title, body, icon]) => <li><img src={iconUrl(icon)} alt="" width="64" height="64" loading="lazy" decoding="async" /><div><h3>{title}</h3><p>{body}</p></div></li>)}
  </ul>
  <p class="boredom-brand">ORGANIZED MOM COLLECTIVE</p>
  <a class="boredom-print text-link print:hidden" href="/downloads/boredom-busters-choice-card.pdf" target="_blank" rel="noopener" data-print-boredom>Print the choice card (PDF)</a>
</section>
<style>
  .boredom-choices { margin: 2rem 0; padding: 24px; border: 1px solid #BBCBC4; background: #FBF7F1; }
  .boredom-choices h2 { margin: 8px 0 12px; font: bold clamp(28px, 5vw, 36px)/1.2 Georgia, serif; }
  .boredom-choices ul { list-style: none; padding: 0; margin: 24px 0; display: grid; gap: 20px; }
  .boredom-choices li { display: flex; align-items: flex-start; gap: 14px; margin: 0; padding-top: 14px; border-top: 1px solid #BBCBC4; }
  .boredom-choices li img { flex: 0 0 56px; width: 56px; height: 64px; object-fit: contain; }
  .boredom-choices li div { min-width: 0; }
  .boredom-choices h3 { font: bold 21px/1.3 Georgia, serif; margin: 0 0 8px; }
  .boredom-choices li p { margin: 0; }
  .boredom-brand { font-size: 10px; letter-spacing: .12em; }
  .boredom-print { display: inline-flex; align-items: center; margin-top: 18px; min-height: 44px; }
  @media (min-width: 600px) { .boredom-choices ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media print {
    .boredom-choices { break-inside: avoid; padding: 20px; }
    .boredom-choices ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .boredom-print { display: none; }
  }
</style>
<script>
  import { elementEvent } from '../../lib/element-events';
  document.querySelectorAll<HTMLAnchorElement>('[data-print-boredom]').forEach(link => {
    link.addEventListener('click', () => {
      elementEvent('element_print', 'reference-chart', 'boredom-choices');
    });
  });
</script>

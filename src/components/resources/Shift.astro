---
/** The Shift: the change in perspective the article turns on. Use once per article. */
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<aside class="my-10 border-y-2 border-ink py-6" aria-label="The Shift">
  <p class="label flex items-center gap-2"><span aria-hidden="true" class="inline-block h-[3px] w-6 bg-month"></span>The Shift</p>
  {title && <p class="mt-3 text-[1.35rem] leading-snug font-bold text-balance">{title}</p>}
  <div class="article-callout mt-3"><slot /></div>
</aside>

---
/**
 * The Shift: the change in perspective the article turns on. Set as a pull quote:
 * the title is the line a skimmer remembers. Use once per article.
 */
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<aside class="my-10 border-t-2 border-b border-t-month border-b-rule py-7" aria-label="The Shift">
  <p class="label text-soft">The Shift</p>
  {
    title && (
      <p class="mt-3 text-[1.55rem] leading-[1.25] text-balance italic sm:text-[1.85rem]" style="font-family: var(--font-editorial)">
        {title}
      </p>
    )
  }
  <div class="article-callout mt-4"><slot /></div>
</aside>

---
/** Your Next Small Win: one action the reader can do in the next few minutes. Ends the article body. */
interface Props {
  id?: string;
}
const { id = 'your-next-small-win' } = Astro.props;
---

<section id={id} class="my-12 scroll-mt-6 rounded-[6px] bg-blush-wash px-6 py-7 sm:px-8" aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`} class="label text-soft">Your Next Small Win</h2>
  <div class="article-callout mt-3 text-[1.0625rem] sm:text-[1.125rem]"><slot /></div>
</section>

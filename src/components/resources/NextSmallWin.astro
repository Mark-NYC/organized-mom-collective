---
/** Your Next Small Win: one action the reader can do in the next few minutes. Ends the article body. */
interface Props {
  id?: string;
}
const { id = 'your-next-small-win' } = Astro.props;
---

<section id={id} class="my-10 scroll-mt-6 rounded-[4px] border-2 border-ink px-5 py-6 sm:px-7" aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`} class="label">Your Next Small Win</h2>
  <div class="article-callout mt-3 text-[1.0625rem]"><slot /></div>
</section>

---
/**
 * Footer for every public page. Links only to pages that exist: the calendar, the
 * companion explainer, the shop, the library and each topic that has articles.
 * The Help column points to /support (topics, FAQs, the contact form) and /returns.
 * No privacy page exists yet; add it here once it's real.
 * Column labels are <p>, not headings, so the footer stays out of each page's heading outline;
 * the brand line is BRAND_DEFINITION, the plain description of what we make.
 */
import { Wordmark } from '../marks';
import { pillars } from '../../data/pillars';
import { routes } from '../../routes';
import { BRAND_DEFINITION, BRAND_NAME } from '../../config';
import { getArticles } from '../../lib/articles';

// Only topics that have articles get a page, so only those are linked.
const used = new Set((await getArticles()).map((a) => a.data.pillar));
const live = pillars.filter((p) => used.has(p.id));

const site = [
  { href: routes.calendar, label: 'Family Wall Calendar' },
  { href: routes.resources, label: 'Free Resources' },
  { href: routes.freeTools, label: 'Free Tools' },
  { href: routes.planner, label: 'Free Weekly Planner' },
  { href: routes.shop, label: 'Shop' },
  { href: routes.companion, label: 'Cleaning Companion' },
];
const help = [
  { href: routes.support, label: 'Help & Support' },
  { href: routes.returns, label: 'Returns & Refunds' },
  { href: routes.supportContact, label: 'Contact Us' },
];
const link = 'text-[0.95rem] underline decoration-rule underline-offset-4 hover:decoration-ink';
---

<footer class="border-t border-rule bg-band">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 sm:px-8 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <a href={routes.home} aria-label="Organized Mom Collective home" class="inline-block"><Wordmark /></a>
      <p class="mt-4 max-w-xs text-[0.95rem] leading-relaxed text-soft">{BRAND_DEFINITION}</p>
    </div>
    <nav aria-labelledby="footer-site-h">
      <p id="footer-site-h" class="label text-muted">Organized Mom Collective</p>
      <ul class="mt-4 space-y-2.5">
        {
          site.map((l) => (
            <li>
              <a href={l.href} class={link}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-labelledby="footer-help-h">
      <p id="footer-help-h" class="label text-muted">Help</p>
      <ul class="mt-4 space-y-2.5">
        {
          help.map((l) => (
            <li>
              <a href={l.href} class={link}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      live.length > 0 && (
        <nav aria-labelledby="footer-topics-h">
          <p id="footer-topics-h" class="label text-muted">
            Home organization guide
          </p>
          <ul class="mt-4 space-y-2.5">
            {live.map((p) => (
              <li>
                <a href={routes.pillar(p.id)} class={link}>
                  {p.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
  <div class="mx-auto max-w-6xl border-t border-rule px-5 py-5 sm:px-8">
    <p class="text-[0.8rem] text-muted">© {new Date().getFullYear()} {BRAND_NAME}</p>
  </div>
</footer>

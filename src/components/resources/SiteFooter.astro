---
/** Footer for public resource pages: every pillar, so any page leads into the library. */
import { pillars } from '../../data/pillars';
import { routes } from '../../routes';
import { BRAND_NAME } from '../../config';
import { getArticles } from '../../lib/articles';

// Only topics that have articles get a page, so only those are linked.
const used = new Set((await getArticles()).map((a) => a.data.pillar));
const live = pillars.filter((p) => used.has(p.id));
---

<footer class="mt-16 border-t border-rule bg-band">
  <div class="mx-auto max-w-5xl px-5 py-10 sm:px-8">
    <p class="label text-muted">Home organization guide</p>
    <ul class="mt-4 grid gap-x-8 gap-y-2 sm:grid-cols-3">
      {
        live.map((p) => (
          <li>
            <a href={routes.pillar(p.id)} class="text-[0.95rem] font-semibold underline decoration-rule underline-offset-4 hover:decoration-ink">
              {p.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[0.85rem] text-muted">
      <a href={routes.resources} class="hover:text-ink">All resources</a>
      <a href={routes.reorder} class="hover:text-ink">The family wall calendar</a>
      <a href={routes.today} class="hover:text-ink">Cleaning companion website</a>
    </p>
    <p class="mt-6 text-[0.8rem] text-muted">© {new Date().getFullYear()} {BRAND_NAME}</p>
  </div>
</footer>

---
import type { InspirationGallery as Gallery } from '../../data/inspiration-galleries';
interface Props { gallery: Gallery; }
const { gallery } = Astro.props;
const origin = Astro.site?.origin ?? 'https://www.organizedmomcollective.com';
const canonical = new URL('/resources/'+gallery.slug,origin).href;
const hasAllImages = gallery.ideas.every(idea=>Boolean(idea.image));
const isLive = gallery.published && hasAllImages;
const hasTwoTips = gallery.ideas.some(idea => Boolean(idea.secondTitle));
const totalIdeas = gallery.ideas.reduce((count, idea) => count + (idea.secondTitle ? 2 : 1), 0);
const isMudroom = gallery.slug === 'small-mudroom-ideas';
const isLivingRoom = gallery.slug === 'cozy-living-room-ideas-for-families-with-kids';
const isCloset = gallery.slug === 'closet-organization-ideas-small-closets';
const photoTopic = isMudroom ? 'mudroom' : isLivingRoom ? 'living room' : isCloset ? 'closet' : 'toy storage';
---
<article class="inspo">
  <header class="inspo-header">
    <p class="inspo-eyebrow">HOME ORGANIZATION / INSPIRATION</p>
    <h1>{gallery.title}</h1>
    <p class="inspo-deck">{gallery.deck}</p>
    {!isLive && <p class="inspo-notice" role="status">This gallery is being prepared for publication.</p>}
  </header>
  <div class="inspo-content">
    {gallery.coverImage && <figure class="inspo-cover">
      <img src={gallery.coverImage} width="1000" height="1500" alt={`Illustrated overview of ${gallery.title.toLowerCase()}`} loading="eager" decoding="async" />
      <figcaption>Explore all {gallery.ideas.length} ideas below.</figcaption>
    </figure>}
    <section class="inspo-ideas" aria-label={gallery.title}>
      {gallery.ideas.map((idea,index)=>(
        <div class="inspo-item" id={idea.id}>
          {gallery.sections?.find(section => section.start === index) && <header class="inspo-section-heading">
            <p class="inspo-eyebrow">IDEAS {String(index + 1).padStart(2,"0")}–{String(index + (gallery.sections?.find((section) => section.start > index)?.start ?? gallery.ideas.length) - index).padStart(2,"0")}</p>
            <h2>{gallery.sections.find(section => section.start === index)?.title}</h2>
            <p>{gallery.sections.find(section => section.start === index)?.intro}</p>
          </header>}
          <div class="inspo-image-frame">
            {idea.image ? <img src={idea.image} width="1000" height="1500" alt={idea.alt} loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':undefined} decoding="async" /> :
            <div class="inspo-missing" role="note"><span>PHOTO {String(index+1).padStart(2,'0')} / {gallery.ideas.length}</span><small>Image coming soon</small></div>}
          </div>
          <div class="inspo-item-copy">
            <p class="inspo-counter">PHOTO {String(index+1).padStart(2,'0')} OF {gallery.ideas.length}</p>
            <h2 class="inspo-photo-title">{idea.navLabel}</h2>
            <div class="inspo-tips">
              <section class="inspo-tip-item" aria-labelledby={idea.id+'-tip-one'}>
                <h3 class="inspo-tip-heading" id={idea.id+'-tip-one'}>
                  <span class="inspo-number-circle" aria-hidden="true">{hasTwoTips ? index*2+1 : index+1}</span>
                  <span>{idea.title}</span>
                </h3>
                <p>{idea.tip}</p>
                {idea.tryThis && <p class="inspo-tip"><strong>Try this:</strong> {idea.tryThis}</p>}
              </section>
              {idea.secondTitle && <section class="inspo-tip-item" aria-labelledby={idea.id+'-tip-two'}>
                <h3 class="inspo-tip-heading" id={idea.id+'-tip-two'}>
                  <span class="inspo-number-circle" aria-hidden="true">{index*2+2}</span>
                  <span>{idea.secondTitle}</span>
                </h3>
                <p>{idea.secondTip}</p>
              </section>}
            </div>
            {isLive && idea.image && <a class="inspo-save" data-inspo-save data-idea={idea.id}
              href={'https://www.pinterest.com/pin/create/button/?'+new URLSearchParams({url:canonical+'#'+idea.id,media:new URL(idea.image,origin).href,description:idea.pinDescription}).toString()}
              target="_blank" rel="noopener noreferrer" aria-label={'Save '+idea.title+' to Pinterest'}>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.6 19.33 9.4 9.4 0 0 1 .04-2.88l1.27-5.41s-.32-.63-.32-1.57c0-1.47.85-2.56 1.9-2.56.9 0 1.33.68 1.33 1.49 0 .91-.58 2.27-.87 3.53-.25 1.05.53 1.91 1.56 1.91 1.87 0 3.32-1.97 3.32-4.82 0-2.52-1.81-4.28-4.39-4.28-3.02 0-4.79 2.26-4.79 4.6 0 .91.35 1.89.8 2.42.09.11.11.2.08.31l-.3 1.25c-.05.2-.16.24-.36.15-1.35-.63-2.19-2.6-2.19-4.19 0-3.4 2.47-6.51 7.12-6.51 3.74 0 6.65 2.67 6.65 6.25 0 3.73-2.35 6.73-5.61 6.73-1.09 0-2.12-.57-2.48-1.25l-.67 2.55c-.25.98-.95 2.21-1.42 3.04A10 10 0 1 0 12 2Z"/></svg>
              Save to Pinterest
            </a>}
          </div>
          {index===0 && <nav class="inspo-jump" aria-label={`Jump to a ${photoTopic} photo`}><details><summary><span><strong>Jump to a photo</strong><small>{gallery.ideas.length} spaces to explore</small></span><span class="inspo-jump-chevron" aria-hidden="true">⌄</span></summary><div class="inspo-jump-links">{gallery.ideas.map((x,j)=><a href={'#'+x.id}><span class="inspo-jump-number">{String(j+1).padStart(2,'0')}</span><span class="inspo-jump-label">{x.navLabel}</span></a>)}</div></details></nav>}
          {index === Math.floor(gallery.ideas.length/2)-1 && <aside class="inspo-aside"><h3>{isCloset ? "Love the ideas? Start with the closet you already have" : isMudroom ? "Make the after-school routine stick" : isLivingRoom ? "Make the room work for everyone" : "Make toy cleanup a family habit"}</h3><p>{isCloset ? "Before buying baskets or building shelves, sort what you actually use. Our free Closet Reset checklist walks you through what to keep, donate and store." : isMudroom ? "A tidy drop zone works best when everyone knows where their things go." : isLivingRoom ? "The coziest family rooms leave room for everyday life. Give books, blankets, and games a place everyone can reach and return them to." : "Storage works better when kids know what belongs where. Turn the end-of-day reset into a small, shared routine."}</p><a href={isCloset ? "/closet-reset" : "/routine-chart"}>{isCloset ? "Use the free Closet Reset checklist →" : "Create a free family routine chart →"}</a></aside>}
        </div>
      ))}
    </section>
    <section class="inspo-finish" aria-label="Put these ideas to work">
      <h2>{isCloset ? "Make one closet work better this week" : isMudroom ? "Start with the doorway you have" : isLivingRoom ? "Make one cozy change this week" : "Start with one toy storage zone"}</h2>
      <p>{isCloset ? "Start small: clear one shelf, choose what belongs there, and give each item a place you can reach. You can always add the beautiful finishing touches later." : isMudroom ? "Pick one change: somewhere for shoes, somewhere for bags, or one hook your child can reach. That is enough to begin." : isLivingRoom ? "You don’t need a new sofa or a perfect house. Try moving a chair, adding a lamp, or making space for family games. The best room is the one your family actually uses." : "Pick the toys that are used most often, give them a home your child can reach, and leave enough room to put everything away without rearranging the room."}</p>
      <p>Want a simple follow-through plan? <a href={isCloset ? "/closet-reset" : "/routine-chart"}>{isCloset ? "Open the free Closet Reset checklist →" : "Make a free family routine chart →"}</a></p>
    </section>
    <p class="inspo-disclosure">{gallery.disclosure}</p>
  </div>
</article>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-inspo-save]').forEach(link=>{
    link.addEventListener('click',()=>{
      const w=window as Window & {dataLayer?: Record<string,string>[]};
      w.dataLayer?.push({event:'inspiration_save_click',idea_id:link.dataset.idea??'',gallery:location.pathname});
    });
  });
</script>
<style>
  .inspo{font-family:Montserrat,Arial,sans-serif;color:#3d3834}
  .inspo-header{background:#f1f2f2;padding:24px 16px 28px;margin:0 auto 28px;max-width:1100px}
  .inspo-eyebrow,.inspo-counter{font-size:11px;letter-spacing:.13em;font-weight:700;color:#67655f}
  .inspo-header h1{font:700 clamp(2.1rem,5vw,3.65rem)/1.12 Georgia,serif;max-width:780px;margin:14px 0}
  .inspo-deck{font-size:1.05rem;line-height:1.55;max-width:640px}
  .inspo-notice{border-left:3px solid #756d5b;padding:10px 14px;font-size:.87rem;background:#fff}
  .inspo-content{max-width:800px;margin:auto}
  .inspo-cover{margin:0 0 35px}
  .inspo-cover img{display:block;width:100%;height:auto;object-fit:cover}
  .inspo-cover figcaption{padding:10px 16px;font-size:.8rem;color:#67655f}
  .inspo-item{scroll-margin-top:80px;margin-bottom:44px}
  .inspo-section-heading{padding:42px 16px 22px;margin-top:22px;border-top:1px solid #d8d8d4}
  .inspo-section-heading h2{font:700 clamp(1.85rem,4vw,2.6rem)/1.18 Georgia,serif;margin:12px 0}
  .inspo-section-heading>p:last-child{max-width:650px;font-size:1rem;line-height:1.65;color:#55534e}
  .inspo-image-frame{width:100%;background:#f1f2f2}
  .inspo-image-frame img{display:block;width:100%;height:auto;aspect-ratio:2/3;object-fit:cover}
  .inspo-missing{aspect-ratio:2/3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:#67655f;background:linear-gradient(135deg,#eeeae4,#e0e6dc);font-size:.92rem}
  .inspo-missing small{font-size:.8rem;opacity:.75}
  .inspo-item-copy{padding:18px 16px 6px}
  .inspo-photo-title,.inspo-finish h2{font:700 clamp(1.6rem,3.3vw,2.15rem)/1.2 Georgia,serif;margin:8px 0 18px}
  .inspo-item-copy p{line-height:1.65;margin:8px 0}
  .inspo-tips{border-top:1px solid #dedfd9}
  .inspo-tip-item{padding:18px 0 16px;scroll-margin-top:85px}
  .inspo-tip-item + .inspo-tip-item{border-top:1px solid #e5e5e0}
  .inspo-tip-heading{display:flex;align-items:center;gap:12px;font:700 clamp(1.08rem,2.8vw,1.22rem)/1.35 Georgia,serif;margin:0 0 10px}
  .inspo-number-circle{display:inline-flex;align-items:center;justify-content:center;flex:0 0 36px;width:36px;height:36px;border-radius:50%;background:#d4dfc4;color:#374539;font:700 .85rem/1 Montserrat,Arial,sans-serif}
  .inspo-tip-item p{margin-left:48px}
  .inspo-tip{font-size:.94rem}
  .inspo-save{min-height:48px;display:inline-flex;align-items:center;gap:9px;background:#a31d26;color:#fff;padding:12px 18px;margin-top:13px;font-weight:700;text-decoration:none}
  .inspo-save:focus-visible,.inspo-jump a:focus-visible{outline:3px solid #3d3834;outline-offset:3px}
  .inspo-jump{padding:0 16px 15px}
  .inspo-jump summary{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 0;border-top:1px solid #d8d8d4;border-bottom:1px solid #d8d8d4;cursor:pointer;list-style:none}
  .inspo-jump summary::-webkit-details-marker{display:none}
  .inspo-jump summary strong{display:block;font-size:1rem}
  .inspo-jump summary small{display:block;font-size:.78rem;color:#67655f;margin-top:3px}
  .inspo-jump-chevron{font-size:1.4rem;line-height:1;transition:transform .15s}
  .inspo-jump details[open] .inspo-jump-chevron{transform:rotate(180deg)}
  .inspo-jump-links{padding:15px 0 20px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .inspo-jump-links a{display:flex;align-items:center;gap:9px;min-height:54px;padding:10px;background:#f1f2f2;color:inherit;text-decoration:none;line-height:1.3;font-size:.82rem;font-weight:600;overflow-wrap:normal}
  .inspo-jump-links a:hover{background:#e7ece5}
  .inspo-jump-number{font-size:.7rem;letter-spacing:.04em;color:#67655f;flex-shrink:0}
  .inspo-jump-label{min-width:0}
  @media(min-width:640px){.inspo-jump-links{grid-template-columns:repeat(3,minmax(0,1fr))}.inspo-jump-links a{font-size:.9rem;padding:12px}}
  .inspo-aside{padding:22px 20px;background:#e7ece5;margin:24px 16px}
  .inspo-aside h3{font:700 1.45rem Georgia,serif;margin-bottom:8px}
  .inspo-aside p{line-height:1.5}.inspo-aside a,.inspo-finish a{font-weight:700;text-decoration:underline;text-underline-offset:4px}
  .inspo-finish{padding:28px 16px;border-top:1px solid #d8d8d4}
  .inspo-finish p{line-height:1.65}.inspo-finish ol{padding-left:22px;line-height:1.65}
  .inspo-finish li{margin-bottom:13px}
  .inspo-disclosure{font-size:.78rem;color:#67655f;padding:0 16px 36px;line-height:1.6}
  @media(min-width:768px){.inspo-section-heading{padding:55px 0 28px}.inspo-header{padding:48px 54px;margin-bottom:48px}.inspo-item-copy{padding:24px 0 10px}.inspo-jump{padding:0 0 18px}.inspo-aside{margin:30px 0;padding:30px}.inspo-finish{padding:32px 0}.inspo-disclosure{padding-left:0}}
  @media(prefers-reduced-motion:no-preference){:global(html){scroll-behavior:smooth}}
</style>

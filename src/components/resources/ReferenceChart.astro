---
/**
 * A two-column reference chart she screenshots and comes back to: pairs that follow one pattern
 * ("After we… / We…", "Usual / Busy-day version", "Problem / Fix"). Sage card, second column in
 * charcoal with an arrow, wraps on phones instead of scrolling. An optional slot below the rows
 * holds the formula or one-line rule. Reference: IF-10. Rules: docs/editorial/SAVEABLE_ELEMENTS.md.
 */
interface Props {
  /** Serif title, e.g. "After we…, we…". */
  title: string;
  /** Small label above the title. */
  kicker?: string;
  /** Column headings. */
  columns: [string, string];
  rows: [string, string][];
}
const { title, kicker, columns, rows } = Astro.props;
const hasNote = Astro.slots.has('default');
---

<div class="ref-chart">
  {kicker && <p class="label text-soft">{kicker}</p>}
  <p class="ref-title">{title}</p>
  <table>
    <thead>
      <tr><th scope="col">{columns[0]}</th><th scope="col">{columns[1]}</th></tr>
    </thead>
    <tbody>
      {rows.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}
    </tbody>
  </table>
  {hasNote && <div class="ref-note article-callout"><slot /></div>}
</div>

<style>
  .ref-chart { margin-block: 2rem 1rem; border-radius: 6px; background: var(--color-sage-wash); padding: 28px 20px; }
  .ref-title { margin-top: 8px; font-family: var(--font-editorial); font-size: 1.5rem; line-height: 1.2; font-weight: 700; font-style: italic; }
  table { display: table; margin-top: 20px; width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 0.98rem; line-height: 1.4; }
  th { padding: 0 1rem 10px 0; border-bottom: 2px solid var(--color-prose); text-align: left; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; white-space: normal; }
  td { min-width: 0; padding: 14px 1rem 14px 0; border-bottom: 1px solid #d5ddcc; vertical-align: top; color: var(--color-prose-soft); }
  tr:last-child td { border-bottom: 0; }
  th:last-child, td:last-child { position: relative; padding-right: 0; padding-left: 1.5rem; }
  td:last-child { font-weight: 600; color: var(--color-prose); }
  td:last-child::before { content: '→'; position: absolute; left: 0.25rem; font-weight: 400; color: #55684b; }
  .ref-note { margin-top: 20px; border-top: 1px solid #d5ddcc; padding-top: 20px; font-size: 0.98rem; line-height: 1.65; }
  @media (min-width: 640px) {
    .ref-chart { padding: 36px 36px; }
    .ref-title { font-size: 1.85rem; }
    table, .ref-note { font-size: 1.05rem; }
    th:last-child, td:last-child { padding-left: 1.75rem; }
  }
</style>

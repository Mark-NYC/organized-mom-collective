---
/**
 * One product in a roundup article: the seller's own product photo, what it's best for,
 * three or four facts from the seller's page, the price and a dated source link.
 * Facts must come from the seller's page (docs/editorial/SEO_STRATEGY.md → comparison
 * standards); `ours` marks the Organized Mom Collective calendar so the disclosure is visible.
 * Photos are shown whole (object-contain) on the band color, so covers and screens of
 * different shapes line up.
 */
import { imageAttrs, type ArticleImageName } from '../../data/images';

interface Props {
  name: string;
  /** The use case, e.g. "Big families". */
  bestFor: string;
  image: ArticleImageName;
  alt: string;
  facts: string[];
  price: string;
  /** Where the facts and price come from. */
  source?: { label: string; href: string };
  /** Who the photo belongs to, e.g. "Andrews McMeel Publishing". */
  credit?: string;
  ours?: boolean;
}
const { name, bestFor, image, alt, facts, price, source, credit, ours = false } = Astro.props;
const attrs = imageAttrs(image);
---

<section class="product-snapshot my-10 border-t-2 border-ink pt-5 sm:grid sm:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] sm:gap-7">
  <figure class="m-0">
    <div class="flex aspect-[4/3] items-center justify-center bg-band p-3">
      <img {...attrs} sizes="(min-width: 640px) 240px, 100vw" alt={alt} loading="lazy" decoding="async" class="block h-full w-full object-contain" />
    </div>
    {credit && <figcaption class="mt-1.5 text-[0.75rem] leading-snug text-soft">Image: {credit}</figcaption>}
  </figure>
  <div class="mt-4 sm:mt-0">
    <p class="label text-soft">Best for: {bestFor}{ours && ' · Made by us'}</p>
    <h3 class="mt-1.5 text-[1.3rem] leading-tight font-bold" style="font-family: var(--font-editorial)">{name}</h3>
    <ul class="mt-2">
      {
        facts.map((fact) => (
          <li class="flex items-start gap-3 border-b border-dotted border-[#cfc9c2] py-2 text-[1rem] leading-snug">
            <span aria-hidden="true" class="mt-[0.55em] h-[2px] w-3 shrink-0 bg-ink" />
            <span>{fact}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-[1rem] leading-snug"><strong>{price}</strong>{source && <> · <a class="text-link" href={source.href}>{source.label}</a></>}</p>
  </div>
</section>

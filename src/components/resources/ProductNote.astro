---
/**
 * A short, secondary product mention inside an article. Describe only what the
 * product actually does (see src/data/cleaning.ts and the Etsy listing images in
 * design/etsy-listing/). The slot is the article-specific sentence; the link is fixed.
 */
import { routes } from '../../routes';

interface Props {
  product: 'calendar' | 'companion';
}
const { product } = Astro.props;
const link =
  product === 'calendar'
    ? { href: routes.calendar, label: 'See the weekly family calendar' }
    : { href: routes.companion, label: 'See how the cleaning companion works' };
---

<aside class="my-8 flex gap-4 border-t border-b border-rule py-5" aria-label="From Organized Mom Collective">
  <img src="/brand/omc-badge-160.png" alt="" width="160" height="160" class="size-10 shrink-0" />
  <div>
    <div class="article-callout text-[0.97rem]"><slot /></div>
    <a href={link.href} class="text-link mt-2 inline-block">{link.label}</a>
  </div>
</aside>

---
/**
 * Header for every public page (/, /calendar, /companion, /resources/…). Never used in the
 * companion app, which keeps its own Nav. Matches the app header's ruled, spaced-caps style.
 * The menu is a <details> disclosure, so it works without JavaScript. Below 1280px it holds every
 * link; from 1280px Free Tools, Articles and the shop button sit in the bar and the menu drops
 * down with the rest. The shop button says "Get the Calendar", the same words as the homepage
 * CTA, goes to /calendar#buy and carries data-cta for click tracking.
 */
import { Wordmark } from '../marks';
import { routes } from '../../routes';
import { shopUrl } from '../../lib/reorder';

const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
/** `primary` links stay in the bar on desktop, beside the shop button; the rest live in the menu. */
const items = [
  { href: routes.calendar, label: 'Calendar' },
  { href: routes.freeTools, label: 'Free Tools', primary: true },
  { href: routes.shop, label: 'Shop' },
  { href: routes.resources, label: 'Articles', primary: true },
  { href: routes.companion, label: 'Cleaning Companion' },
  { href: routes.ourStory, label: 'Our Story' },
];
/** Same words as the homepage's one call to action. */
const shopLabel = shopUrl() ? 'Get the Calendar' : 'See the Calendar';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:border focus:border-ink focus:bg-paper focus:px-4 focus:py-2"
  >Skip to content</a
>
<header class="relative z-20 border-b border-rule bg-paper">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href={routes.home} aria-label="Organized Mom Collective home" class="-my-1 py-1"><Wordmark badge="size-9 sm:size-10" /></a>

    <div class="flex items-center gap-4 xl:gap-5">
    <nav aria-label="Site" class="hidden items-center gap-5 xl:flex">
      <ul class="flex items-center gap-4">
        {
          items.filter((item) => item.primary).map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative inline-flex min-h-11 items-center whitespace-nowrap text-[0.7rem] font-semibold tracking-[0.18em] uppercase transition-colors',
                  isActive(item.href) ? 'text-ink' : 'text-muted hover:text-ink',
                ]}
              >
                {item.label}
                {isActive(item.href) && <span aria-hidden="true" class="absolute inset-x-0 bottom-1 h-[3px] bg-month" />}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={routes.buy} data-cta="header" class="btn-primary min-h-11 px-5 text-[0.68rem] whitespace-nowrap">{shopLabel}</a>
    </nav>

    <a href={routes.buy} data-cta="header" class="btn-primary hidden min-h-11 px-5 text-[0.68rem] whitespace-nowrap sm:inline-flex xl:hidden">{shopLabel}</a>

    <details class="site-menu xl:relative">
      <summary
        class="-mr-2 flex min-h-11 cursor-pointer list-none items-center gap-2 px-2 text-[0.7rem] font-semibold tracking-[0.18em] uppercase [&::-webkit-details-marker]:hidden"
      >
        <span class="site-menu-open">Menu</span><span class="site-menu-close">Close</span>
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path class="site-menu-open" d="M3 6h14M3 10h14M3 14h14"></path>
          <path class="site-menu-close" d="M5 5l10 10M15 5L5 15"></path>
        </svg>
      </summary>
      <nav
        aria-label="Site menu"
        class="absolute inset-x-0 top-full border-b border-rule bg-paper px-5 pt-2 pb-6 shadow-[0_12px_24px_-16px_rgba(0,0,0,0.25)] sm:px-8 xl:inset-x-auto xl:right-0 xl:mt-2 xl:w-72 xl:border xl:px-6 xl:pb-2"
      >
        <ul class="border-t border-rule">
          {
            items.map((item) => (
              <li class:list={['border-b border-rule xl:last:border-b-0', item.primary && 'xl:hidden']}>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="flex min-h-14 items-center justify-between text-[0.8rem] font-semibold tracking-[0.18em] uppercase"
                >
                  {item.label}
                  <span aria-hidden="true" class="text-muted">›</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href={routes.buy} data-cta="header-menu" class="btn-primary mt-5 w-full xl:hidden">{shopLabel}</a>
      </nav>
    </details>
    </div>
  </div>
</header>

<script>
  // Close the menu on Escape or a click outside it (a bare <details> stays open).
  const menu = document.querySelector<HTMLDetailsElement>('.site-menu');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .site-menu:not([open]) .site-menu-close,
  .site-menu[open] .site-menu-open {
    display: none;
  }
</style>

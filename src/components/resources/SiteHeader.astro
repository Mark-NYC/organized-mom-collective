---
/**
 * Header for every public page (/, /calendar, /companion, /resources/…). Never used in the
 * companion app, which keeps its own Nav. Matches the app header's ruled, spaced-caps style.
 * The phone menu is a <details> disclosure, so it works without JavaScript.
 */
import { Wordmark } from '../marks';
import { routes } from '../../routes';

const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const items = [
  { href: routes.calendar, label: 'Calendar' },
  { href: routes.resources, label: 'Free Resources' },
  { href: routes.companion, label: 'Get Started' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:border focus:border-ink focus:bg-paper focus:px-4 focus:py-2"
  >Skip to content</a
>
<header class="relative z-20 border-b border-rule bg-paper">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href={routes.home} aria-label="Organized Mom Collective home" class="-my-1 py-1"><Wordmark badge="size-9 sm:size-10" /></a>

    <nav aria-label="Site" class="hidden items-center gap-8 md:flex">
      <ul class="flex items-center gap-7">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative inline-flex min-h-11 items-center text-[0.7rem] font-semibold tracking-[0.18em] uppercase transition-colors',
                  isActive(item.href) ? 'text-ink' : 'text-muted hover:text-ink',
                ]}
              >
                {item.label}
                {isActive(item.href) && <span aria-hidden="true" class="absolute inset-x-0 bottom-1 h-[3px] bg-month" />}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={routes.buy} class="btn-primary min-h-11 px-5 text-[0.68rem]">Shop the Calendar</a>
    </nav>

    <details class="site-menu md:hidden">
      <summary
        class="-mr-2 flex min-h-11 cursor-pointer list-none items-center gap-2 px-2 text-[0.7rem] font-semibold tracking-[0.18em] uppercase [&::-webkit-details-marker]:hidden"
      >
        <span class="site-menu-open">Menu</span><span class="site-menu-close">Close</span>
        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path class="site-menu-open" d="M3 6h14M3 10h14M3 14h14"></path>
          <path class="site-menu-close" d="M5 5l10 10M15 5L5 15"></path>
        </svg>
      </summary>
      <nav aria-label="Site" class="absolute inset-x-0 top-full border-b border-rule bg-paper px-5 pt-2 pb-6 shadow-[0_12px_24px_-16px_rgba(0,0,0,0.25)] sm:px-8">
        <ul class="border-t border-rule">
          {
            items.map((item) => (
              <li class="border-b border-rule">
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="flex min-h-14 items-center justify-between text-[0.8rem] font-semibold tracking-[0.18em] uppercase"
                >
                  {item.label}
                  <span aria-hidden="true" class="text-muted">›</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href={routes.buy} class="btn-primary mt-5 w-full">Shop the Calendar</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-menu:not([open]) .site-menu-close,
  .site-menu[open] .site-menu-open {
    display: none;
  }
</style>

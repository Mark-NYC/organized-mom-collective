---
/** Public marketing navigation. Member/app navigation stays separate. */
import { Wordmark } from '../marks';
import { routes } from '../../routes';

const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const groups = [
  {
    label: 'Free Resources',
    href: routes.guides,
    links: [
      { href: routes.guides, label: 'Practical Guides', description: 'Step-by-step help and printable downloads' },
      { href: routes.freeTools, label: 'Free Tools', description: 'Charts, checklists, and planners' },
      { href: routes.resources, label: 'Articles & Ideas', description: 'Helpful ideas for family life' },
    ],
  },
  {
    label: 'Shop',
    href: routes.shop,
    links: [
      { href: routes.calendar, label: 'Family Wall Calendars', description: 'See the printed calendars' },
      { href: routes.shop, label: 'All Products', description: 'Browse the shop' },
    ],
  },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const groupActive = (links: { href: string }[]) => links.some(link => isActive(link.href));
---

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:border focus:border-ink focus:bg-paper focus:px-4 focus:py-2">Skip to content</a>
<header class="relative z-30 border-b border-rule bg-paper">
  <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-3 px-5 sm:px-8">
    <a href={routes.home} aria-label="Organized Mom Collective home" class="-my-1 shrink-0 py-1"><Wordmark badge="size-9 sm:size-10" /></a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-5 lg:flex">
      {groups.map(group => (
        <details class="site-nav-group relative">
          <summary class:list={['flex min-h-11 cursor-pointer list-none items-center gap-1.5 whitespace-nowrap text-[0.7rem] font-semibold uppercase tracking-[0.12em] hover:text-ink [&::-webkit-details-marker]:hidden', groupActive(group.links) ? 'text-ink' : 'text-muted']}>
            {group.label}
            <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m3.5 6 4.5 4 4.5-4" /></svg>
          </summary>
          <div class="absolute left-0 top-full z-40 w-72 border border-rule bg-paper p-3 shadow-lg">
            <a href={group.href} class="mb-2 block border-b border-rule px-3 py-2 text-[0.72rem] font-semibold uppercase tracking-wider text-muted hover:text-ink">View all {group.label}</a>
            {group.links.map(link => (
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class="block rounded-sm px-3 py-3 hover:bg-band focus-visible:outline focus-visible:outline-2 focus-visible:outline-ink">
                <span class="block text-[0.82rem] font-semibold text-ink">{link.label}</span>
                <span class="mt-1 block text-[0.77rem] leading-snug text-muted">{link.description}</span>
              </a>
            ))}
          </div>
        </details>
      ))}
      <a href="/club" aria-current={isActive('/club') ? 'page' : undefined} class:list={['inline-flex min-h-11 items-center whitespace-nowrap text-[0.7rem] font-semibold uppercase tracking-[0.12em] hover:text-ink', isActive('/club') ? 'text-ink' : 'text-muted']}>Family Club</a>
      <a href={routes.ourStory} aria-current={isActive(routes.ourStory) ? 'page' : undefined} class:list={['inline-flex min-h-11 items-center whitespace-nowrap text-[0.7rem] font-semibold uppercase tracking-[0.12em] hover:text-ink', isActive(routes.ourStory) ? 'text-ink' : 'text-muted']}>Our Story</a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href="/club" data-cta="header-club" class="btn-primary inline-flex min-h-11 items-center justify-center px-3 text-center text-[0.65rem] sm:px-5 sm:text-[0.7rem]">Explore the Club</a>

      <details class="site-menu relative lg:hidden">
        <summary aria-label="Toggle site menu" class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center gap-1 px-1 text-[0.7rem] font-semibold uppercase tracking-wide [&::-webkit-details-marker]:hidden">
          <span class="site-menu-open">Menu</span><span class="site-menu-close">Close</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <path class="site-menu-open" d="M3 6h14M3 10h14M3 14h14"></path>
            <path class="site-menu-close" d="M5 5l10 10M15 5L5 15"></path>
          </svg>
        </summary>
        <nav aria-label="Mobile site navigation" class="absolute right-0 top-full z-50 mt-2 max-h-[calc(100dvh-5rem)] w-[min(90vw,22rem)] overflow-y-auto border border-rule bg-paper p-4 shadow-lg">
          {groups.map(group => (
            <details class="site-mobile-group border-b border-rule">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between text-[0.82rem] font-semibold [&::-webkit-details-marker]:hidden">
                {group.label}
                <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m3.5 6 4.5 4 4.5-4" /></svg>
              </summary>
              <div class="pb-3 pl-3">
                {group.links.map(link => <a href={link.href} class="block min-h-11 py-2 text-[0.82rem] text-ink">{link.label}</a>)}
              </div>
            </details>
          ))}
          <a href="/club" class="flex min-h-12 items-center border-b border-rule text-[0.82rem] font-semibold">Family Club</a>
          <a href={routes.ourStory} class="flex min-h-12 items-center border-b border-rule text-[0.82rem] font-semibold">Our Story</a>
          <a href="/club" data-cta="header-menu-club" class="btn-primary mt-4 flex min-h-11 w-full items-center justify-center">Explore the Club</a>
          <a href={routes.account} class="mt-3 block py-2 text-center text-[0.8rem] text-muted">Already have an account? Sign in</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const disclosures = Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-menu, .site-nav-group'));
  const closeDisclosures = (except?: HTMLDetailsElement) => {
    disclosures.forEach(item => { if (item !== except) item.open = false; });
  };
  disclosures.forEach(item => item.addEventListener('toggle', () => { if (item.open) closeDisclosures(item); }));
  document.addEventListener('click', event => {
    disclosures.forEach(item => { if (item.open && !item.contains(event.target as Node)) item.open = false; });
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      const opened = disclosures.find(item => item.open);
      if (opened) { opened.open = false; opened.querySelector('summary')?.focus(); }
    }
  });
</script>
<style>
  .site-menu:not([open]) .site-menu-close, .site-menu[open] .site-menu-open { display: none; }
  .site-mobile-group[open] > summary svg, .site-nav-group[open] > summary svg { transform: rotate(180deg); }
</style>

---
/**
 * The document shell shared by every page. Indexing is decided by the layout
 * that wraps this one:
 *   PublicLayout → indexable, canonical URL (future marketing / SEO pages)
 *   AppLayout    → noindex, follow (the companion app is a customer utility)
 */
import '../styles/global.css';
import { monthColors } from '../theme';

interface Props {
  title: string;
  description: string;
  /** 'index' for public pages; 'noindex' for the app and the QR redirect */
  robots: 'index' | 'noindex';
  /** Absolute canonical URL (public pages only) */
  canonical?: string;
  /** Open Graph type: 'website' by default, 'article' for resource articles. */
  ogType?: 'website' | 'article';
  /** Share image, site-relative or absolute. */
  ogImage?: string;
  /** Structured data (schema.org JSON-LD) objects for this page. */
  jsonLd?: object[];
}

const { title, description, robots, canonical, ogType = 'website', ogImage = '/icons/icon-512.png', jsonLd = [] } = Astro.props;
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
const monthHexes = monthColors.map((m) => m.hex);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="p:domain_verify" content="c61c0bdfeba35d4767e8bcd4fcded887" />
    {robots === 'noindex' && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <script is:inline define:vars={{ monthHexes }}>
      // The current month's color (from src/theme.ts) is the accent.
      document.documentElement.style.setProperty('--month', monthHexes[new Date().getMonth()]);
    </script>
    <!-- Pinterest Tag -->
    <script is:inline>
      !function(e){if(!window.pintrk){window.pintrk = function () {
      window.pintrk.queue.push(Array.prototype.slice.call(arguments))};var
        n=window.pintrk;n.queue=[],n.version="3.0";var
        t=document.createElement("script");t.async=!0,t.src=e;var
        r=document.getElementsByTagName("script")[0];
        r.parentNode.insertBefore(t,r)}}("https://s.pinimg.com/ct/core.js");
      pintrk('load', '2613936771748');
      pintrk('page');
    </script>
    <!-- end Pinterest Tag -->
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <noscript>
      <img height="1" width="1" style="display:none;" alt=""
        src="https://ct.pinterest.com/v3/?event=init&amp;tid=2613936771748&amp;noscript=1" />
    </noscript>
    <slot />
  </body>
</html>

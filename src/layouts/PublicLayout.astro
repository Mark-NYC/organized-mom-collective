---
/**
 * Public pages (/, /calendar, /companion, /resources/…): the site header and footer,
 * canonical URL, social sharing tags and structured data. Indexable unless
 * `indexable={false}`. The companion app never uses this layout (see AppLayout).
 */
import '../styles/public-design.css';
import BaseLayout from './BaseLayout.astro';
import { existsSync } from 'node:fs';
import SiteHeader from '../components/resources/SiteHeader.astro';
import SiteFooter from '../components/resources/SiteFooter.astro';
import CtaTracking from '../components/site/CtaTracking.astro';
import SaveNudge from '../components/account/SaveNudge.astro';
import { accountsEnabled } from '../lib/account';
import { BRAND_NAME } from '../config';
import { pageUpdated } from '../data/page-updated';

interface Props {
  title?: string;
  /** Exact <title>, used as-is (articles set their own SEO title). */
  fullTitle?: string;
  description: string;
  /** Set false for utility pages like the 404, or an empty hub (noindex, no canonical). */
  indexable?: boolean;
  /** Show the site header and footer. */
  chrome?: boolean;
  /** Content width: 'text' for reading pages, 'wide' for the hub, 'full' when sections set their own width. */
  width?: 'text' | 'wide' | 'full';
  ogType?: 'website' | 'article';
  /** Share image (site-relative). Defaults to the calendar photo, sized 1200 × 630. */
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: object[];
}

const DEFAULT_OG = '/images/site/og-calendar.jpg';
const {
  title,
  description,
  indexable = true,
  chrome = true,
  width = 'text',
  ogType,
  ogImage = DEFAULT_OG,
  ogImageAlt = `The ${BRAND_NAME} family wall calendar, filled in for the week, on a kitchen counter.`,
  jsonLd: pageJsonLd,
} = Astro.props;
const fullTitle = Astro.props.fullTitle ?? (title ? `${title} · ${BRAND_NAME}` : BRAND_NAME);
// Internal links never use a trailing slash (see src/routes.ts), so canonicals don't either.
const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const canonical = indexable && Astro.site ? new URL(path, Astro.site).href : undefined;
// Tool and checklist pages get a visible "Updated" date and WebPage dateModified (src/data/page-updated.ts).
const updated = indexable ? pageUpdated[path] : undefined;
const updatedLabel = updated && new Date(updated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const jsonLd =
  updated && canonical
    ? [...(pageJsonLd ?? []), { '@context': 'https://schema.org', '@type': 'WebPage', url: canonical, name: fullTitle, dateModified: updated }]
    : pageJsonLd;
const founderPhoto = existsSync('public/images/site/mark-megan-family-story-1200.webp');
const mainClass =
  width === 'full' ? '' : ['mx-auto px-5 sm:px-8', width === 'wide' ? 'max-w-5xl' : 'max-w-3xl', chrome ? 'py-8 sm:py-14' : 'py-12 sm:py-20'].join(' ');
---

<BaseLayout
  title={fullTitle}
  description={description}
  robots={indexable ? 'index' : 'noindex'}
  canonical={canonical}
  ogType={ogType}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:locale" content="en_US" />
    {ogImage === DEFAULT_OG && <meta property="og:image:width" content="1200" />}
    {ogImage === DEFAULT_OG && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </Fragment>
  {chrome && <SiteHeader />}
  <main id="main" class:list={['omc-public', mainClass]}>
    <slot />
    {
      updated && (
        <p class="mx-auto max-w-6xl px-5 pt-6 pb-8 text-[0.85rem] text-muted sm:px-8">
          Updated <time datetime={updated}>{updatedLabel}</time>
        </p>
      )
    }
  </main>
  {chrome && path === '/' && (
    <section aria-labelledby="founder-story-h" class="mx-4 my-9 bg-[#f1f2f2] px-6 py-12 sm:mx-9 sm:px-10 sm:py-16">
      <div class="mx-auto grid max-w-5xl items-center gap-8 md:grid-cols-2 md:gap-14">
        <div class="relative aspect-[5/4] overflow-hidden bg-[#e7ece5]">
          {founderPhoto && <img src="/images/site/mark-megan-family-story-1200.webp" srcset="/images/site/mark-megan-family-story-720.webp 720w, /images/site/mark-megan-family-story-1200.webp 1200w" sizes="(min-width: 768px) 480px, 100vw" alt="Mark and Megan with their two sons outdoors in autumn" width="1200" height="1200" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-center" />}
          {!founderPhoto && <div class="flex h-full flex-col justify-end p-8 sm:p-10">
          <p class="font-serif text-[2rem] leading-tight text-warm-ink">Built for our family.<br />Shared with yours.</p>
          <p class="label mt-7 text-warm-soft">Mark & Megan · Founders</p></div>}
        </div>
        <div>
          <p class="label text-warm-soft">Our story</p>
          <h2 id="founder-story-h" class="mt-3 font-serif text-[2.2rem] leading-tight text-warm-ink">We didn’t start with an organized home.</h2>
          <p class="mt-5 text-[1.05rem] leading-relaxed text-warm-ink">We started because we needed something to change. Too much of the planning, remembering and managing was falling on one person.</p>
          <p class="mt-4 text-[1.05rem] leading-relaxed text-warm-ink">So we began creating tools to help our family see the plan, build better habits and share responsibility. We’re still learning, but we believe everyone can play a part.</p>
          <a href="/our-story" data-cta="home-our-story" class="text-link mt-6 inline-flex min-h-11 items-center">Read our story <span aria-hidden="true" class="ml-2">→</span></a>
        </div>
      </div>
    </section>
  )}
  {chrome && <SiteFooter />}
  <CtaTracking />
  {accountsEnabled() && <SaveNudge />}
</BaseLayout>

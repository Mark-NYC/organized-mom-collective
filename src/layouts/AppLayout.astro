---
/** Companion app pages (/app/…): noindex, installable, app navigation. */
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import FamilyNavigation from '../components/v20/FamilyNavigation.astro';
import '../styles/family-app-brand.css';
import '../styles/v16.css';
import '../styles/v17.css';
import '../styles/v18.css';
import '../styles/v21.css';
import '@fontsource-variable/figtree';
import { calendarPath } from '../lib/companion';
const calendar = calendarPath(Astro.url.pathname);
const cleaningOnly = !calendar && /^\/app\/(cleaning|week|reorder|settings)\/?$/.test(Astro.url.pathname);
import { SITE_NAME } from '../config';
import { monthTints } from '../lib/club/month-tints';
// This month's approved calendar color (src/theme.ts) as the app's accent, chosen on the device (the page is static).
// Tiles use the month's lightest step (the same steps its Club printables use); the accent carries labels and progress.
const MONTH_THEME = Array.from({ length: 12 }, (_, i) => { const t = monthTints(i); return [t.base, t.weeks[0], t.accent]; });
// iPhone app bundle only (npm run build:app; docs/ios/OMC_APP_ROADMAP.md): native links, durable storage, lifecycle.
const appShell = import.meta.env.PUBLIC_APP_SHELL === 'ios';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Your Organized Mom Collective companion: the Daily Reset, today’s zone from your calendar, and a monthly home project.',
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---

<BaseLayout title={fullTitle} description={description} robots="noindex">
  <style is:global>[data-calendar-feature][hidden] { display: none !important; } body { background: var(--of-bg, #fbf7f1); color: #4d4544; }</style>
  <Fragment slot="head">
    <link rel="manifest" href={calendar ? "/calendar.webmanifest" : "/manifest.webmanifest"} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <script is:inline>
      // Android browsers offer their own install dialog once; keep it for the "Install" button.
      window.__omcInstallPrompt = null;
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        window.__omcInstallPrompt = e;
        window.dispatchEvent(new Event('omc:installable'));
      });
    </script>
    <script is:inline define:vars={{ MONTH_THEME }}>
      try {
        const t = MONTH_THEME[new Date().getMonth()], r = document.documentElement.style;
        r.setProperty('--of-month', t[0]); r.setProperty('--of-month-wash', t[1]); r.setProperty('--of-month-accent', t[2]);
      } catch (e) {}
    </script>
  </Fragment>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:border focus:border-ink focus:bg-paper focus:px-4 focus:py-2"
    >Skip to content</a
  >
  <div class={calendar ? undefined : "v16 v17 v18 v21 family-brand"} data-look={calendar ? undefined : "v21"} data-theme={calendar ? undefined : "brown"}>
  {calendar ? <Nav /> : <FamilyNavigation />}
  <script>
    import { initCompanionAccess } from '../lib/companion-access';
    import { track } from '../lib/app/events';
    void initCompanionAccess();
    track('app_open'); // once a day, signed in only (docs/pilot/ANALYTICS.md)
  </script>
  <script>
    // Shared cleaning progress for a signed-in household (does nothing while accounts are off or she has no family).
    import { startCleaningSync } from '../lib/cleaning-sync/client';
    void startCleaningSync();
  </script>
  <main data-calendar-feature={cleaningOnly ? "" : undefined} hidden={cleaningOnly} id="main" class={calendar ? "mx-auto max-w-5xl px-5 pt-7 pb-[calc(7rem+env(safe-area-inset-bottom))] sm:px-8 sm:pt-12 sm:pb-20" : "v16-main"}>
    <slot />
  </main>
  </div>
  {appShell && <script>import '../lib/native/init';</script>}
  {appShell && <style is:global>html.omc-native body { padding-top: env(safe-area-inset-top); } html.omc-native body::before { content: ''; position: fixed; inset: 0 0 auto 0; height: env(safe-area-inset-top); background-color: inherit; z-index: 1000; pointer-events: none; }</style>}
  <script is:inline>
    // Offline support for the app only; the future public site stays SW-free.
    if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js', { scope: '/app' }).catch(() => {}));
    }
  </script>
</BaseLayout>

# Copy to .env for local builds and set the same variables in your host's build settings.
# Everything here is PUBLIC by design (it ends up in the browser). NEVER put the Supabase
# service_role / secret key, the Stripe secret key or the webhook secret here: those are
# Edge Function secrets (supabase/SHOP.md).

# Supabase (survey + shop). The anon key can only call the functions the migrations allow.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Direct website shop (/checkout). Leave false until launch is approved; the site's buy
# buttons go to Etsy either way. Use the TEST publishable key until live payments are approved.
# This only shows or hides the page; the server-side launch gate is in supabase/SHOP.md.
PUBLIC_SHOP_ENABLED=false
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Enable only AFTER applying the tool email migration and testing its RPC.
PUBLIC_TOOL_EMAIL_GATE_ENABLED=false
# The free responsibility chart in /resources/chores-for-kids-by-age (needs the flag above too).
# Enable only AFTER applying 20261021000000_tool_email_responsibility_chart.sql.
PUBLIC_RESPONSIBILITY_CHART_GATE_ENABLED=false

# Customer accounts (supabase/ACCOUNTS.md): sign in with an emailed code, saved tools, purchases.
# Leave false until the migration is run, Auth email codes and SMTP are set up, and /privacy is live.
PUBLIC_ACCOUNTS_ENABLED=false

# Organized Family Club member pages (/club/…; docs/club/IMPLEMENTATION_PLAN.md). Leave false in production: off, the
# pages are a "not available" notice. On a Preview deployment, true shows them with the sample households
# (?sample=rivera); real sign-in also needs PUBLIC_ACCOUNTS_ENABLED and the Club migration on that project.
PUBLIC_CLUB_ENABLED=false
# Shows the Club's plans on /club/join and the landing page's join button (docs/club/MEMBERSHIP.md). Whether anyone can
# actually pay is decided on the server: club_settings.checkout_mode (/admin/club) and the Club's own Stripe key.
PUBLIC_CLUB_CHECKOUT_ENABLED=false

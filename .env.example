# Customer survey (/survey) → Supabase. Copy to .env for local builds and set the
# same variables in your host's build settings. Both values are public by design:
# the anon key can only call survey_track / survey_submit (see supabase/README.md).
# NEVER put the service_role / secret key here.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
